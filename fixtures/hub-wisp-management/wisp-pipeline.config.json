{
  "kind": "chrysalis.wisp.pipeline-config",
  "schemaVersion": 1,
  "wispRootEnv": [
    "CHRYSALIS_WISP_ROOT",
    "WISP_MODULE_DIR"
  ],
  "defaultWispRoot": "../../products/wisptools/Module_Manager",
  "fixtureDir": "fixtures/hub-wisp-management",
  "reportPath": "reports/wisp/wisp-cwl-pipeline.json",
  "gce": {
    "project": "chrysalis-dev-f5x6qv",
    "zone": "us-central1-a",
    "instance": "chrysalis-test-vm",
    "port": 19100,
    "backendUrl": "https://hss.wisptools.io",
    "svelteFallback": "",
    "svelteSidecar": false,
    "cwlNativePrefixes": "*",
    "apiMode": "runtime-cwl-native",
    "nativeApi": true,
    "liveApi": true,
    "operatorUi": "cwl-native"
  },
  "firebase": {
    "hostingTarget": "hosting:management",
    "project": "wisptools-production",
    "clientBuildTarget": "firebase",
    "cwlStaticExportDir": "fixtures/hub-wisp-management/cwl-static-export",
    "apiMode": "cwl-static-export"
  },
  "deployTargets": {
    "gce": {
      "clientBuild": "gce",
      "npmScript": "build:single-use",
      "apiMode": "runtime-cwl-native"
    },
    "firebase": {
      "clientBuild": "firebase",
      "npmScript": "build",
      "apiMode": "cwl-static-export"
    }
  }
}
