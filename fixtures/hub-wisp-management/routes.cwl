@page GET "/modules/customers/portal/tickets/:id"
page modules_customers_portal_tickets_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/customers/portal/tickets/:id", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-customers-portal-tickets-:id\" data-wisp-path=\"/modules/customers/portal/tickets/:id\" data-cwl-island=\"client\"><div class=\"ticket-details-page\">\n    <div class=\"page-header\">\n      <a href=\"/modules/customers/portal/tickets\" class=\"back-link\">← Back to Tickets</a>\n      <h1>Ticket Details</h1>\n    </div>\n    \n    <div class=\"ticket-details\">\n      <div class=\"ticket-header\">\n        <div>\n          <span class=\"ticket-number\">N/A</span>\n          <span \n            class=\"ticket-status\" \n            style=\"background:\"\n          >\n            \n          </span>\n        </div>\n        <div class=\"ticket-meta\">\n          <span>Priority: </span>\n          <span>Created: </span>\n        </div>\n      </div>\n      \n      <div class=\"ticket-content\">\n        <h2></h2>\n        <p class=\"ticket-description\">No description</p>\n      </div>\n      \n      \n      \n      <div class=\"add-comment\">\n        <h3>Add Comment</h3>\n        <form>\n          <textarea\n            placeholder=\"Add a comment or update...\"\n            rows=\"4\"\n          ></textarea>\n          <button type=\"submit\" class=\"btn-primary\">\n            Add Comment\n          </button>\n        </form>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/customers/portal/tickets/new"
page modules_customers_portal_tickets_new_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/customers/portal/tickets/new", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-customers-portal-tickets-new\" data-wisp-path=\"/modules/customers/portal/tickets/new\" data-cwl-island=\"client\"><div class=\"create-ticket-page\">\n  <div class=\"page-header\">\n    <h1>Create New Ticket</h1>\n    <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Back to Tickets</a>\n  </div>\n  \n  <form class=\"ticket-form\">\n    \n    \n    <div class=\"form-group\">\n      <label for=\"title\">Title *</label>\n      <input\n        id=\"title\"\n        type=\"text\"\n        placeholder=\"Brief description of the issue\"\n        required\n      />\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"category\">Category</label>\n      <select id=\"category\">\n        <option value=\"slow-speed\">Slow Speed</option>\n        <option value=\"no-connection\">No Connection</option>\n        <option value=\"intermittent\">Intermittent Connection</option>\n        <option value=\"equipment-failure\">Equipment Failure</option>\n        <option value=\"billing-issue\">Billing Issue</option>\n        <option value=\"other\">Other</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"priority\">Priority</label>\n      <select id=\"priority\">\n        <option value=\"low\">Low</option>\n        <option value=\"medium\">Medium</option>\n        <option value=\"high\">High</option>\n        <option value=\"critical\">Critical</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"description\">Description *</label>\n      <textarea\n        id=\"description\"\n        placeholder=\"Please provide detailed information about the issue...\"\n        rows=\"6\"\n        required\n      ></textarea>\n    </div>\n    \n    <div class=\"form-actions\">\n      <button type=\"submit\" class=\"btn-primary\">\n        Create Ticket\n      </button>\n      <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Cancel</a>\n    </div>\n  </form>\n</div></div>";
}

@page GET "/modules/deploy"
page modules_deploy_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "deploy", apiPath: "/api/deploy", api_ok: true, api_surface: "wisp-api-native", api_resource: "deploy", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-deploy-app\" data-wisp-page=\"deploy\" data-cwl-island=\"client\">\n  <div class=\"map-fullscreen\">\n    <iframe id=\"deploy-map-iframe\" class=\"plan-map-iframe\" title=\"Deploy map\" src=\"/modules/coverage-map?mode=deploy&hideStats=true&deployMode=true\"></iframe>\n  </div>\n  <div class=\"wisp-header-overlay\">\n    <div class=\"wisp-header-left\">\n      <button type=\"button\" class=\"wisp-back-btn\" data-action=\"back\" title=\"Back to Dashboard\" aria-label=\"Back to Dashboard\">←</button>\n      <h1>🚀 Deploy</h1>\n    </div>\n    <div class=\"wisp-header-controls\">\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"help\" title=\"Help\"><span class=\"control-icon\">❓</span><span class=\"control-label\">Help</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"approved\" title=\"Approved projects ready for deployment\"><span class=\"control-icon\">🔍</span><span class=\"control-label\">Approved</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"projects\" title=\"Projects\"><span class=\"control-icon\">📋</span><span class=\"control-label\">Projects</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"deployed\" title=\"Deployed projects\"><span class=\"control-icon\">✅</span><span class=\"control-label\">Deployed</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"pci\" title=\"PCI Planner\"><span class=\"control-icon\">📊</span><span class=\"control-label\">PCI</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"frequency\" title=\"Frequency Planner\"><span class=\"control-icon\">📡</span><span class=\"control-label\">Frequency</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"hardware\" title=\"Deployed hardware\"><span class=\"control-icon\">🔧</span><span class=\"control-label\">Hardware</span></button>\n      <button type=\"button\" class=\"wisp-control-btn deploy-btn\" data-action=\"deploy-plan\" title=\"Push active plan to field\"><span class=\"control-icon\">🚀</span><span class=\"control-label\">Deploy Plan</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"layers\" title=\"Layers\"><span class=\"control-icon\">🎛️</span><span class=\"control-label\">Layers</span></button>\n    </div>\n  </div>\n  <aside id=\"plan-projects-panel\" class=\"plan-side-panel\" hidden aria-label=\"Deploy projects\">\n    <div class=\"plan-panel-header\">\n      <h2>Deploy projects</h2>\n      <button type=\"button\" class=\"plan-panel-close\" data-action=\"close-projects\" aria-label=\"Close\">✕</button>\n    </div>\n    <div id=\"plan-projects-list\" class=\"plan-projects-list\"><p class=\"plan-panel-loading\">Loading projects…</p></div>\n  </aside>\n  <div id=\"plan-active-summary\" class=\"plan-summary\" hidden></div>\n</div>";
}

@page GET "/modules/hardware"
page modules_hardware_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "hardware", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"hardware-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>🔧 Hardware Management</h1>\n      <p class=\"subtitle\">Comprehensive equipment and hardware management system</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Check In\n      </button>\n      <button class=\"btn-secondary\">\n        📤 Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 Reports\n      </button>\n      <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n      <!-- Add Hardware Dropdown -->\n      <div class=\"dropdown-container\">\n        <button class=\"btn-primary dropdown-toggle\">\n          ➕ Add Hardware ▼\n        </button>\n        \n      </div>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔧</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Hardware</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card clickable\">\n      <div class=\"stat-icon\">📡</div>\n      <div>\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">EPC/SNMP Devices</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\">12</div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Deployed/Online</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🏗️</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">In Maintenance</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Hardware Type Tabs -->\n  <div class=\"hardware-tabs\">\n    <button class=\"tab-btn\">\n      📋 All Hardware ()\n    </button>\n    <button class=\"tab-btn\">\n      📦 Inventory (3)\n    </button>\n    <button class=\"tab-btn\">\n      📡 EPC/SNMP Devices (1)\n    </button>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer, asset tag...\"\n        />\n        <button class=\"search-btn\">Search</button>\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        \n      </select>\n      \n      \n      \n      <button class=\"btn-clear\">\n        Clear Filters\n      </button>\n    </div>\n    \n    <!-- Category Quick Filters -->\n    <div class=\"category-filters\">\n      \n        \n        \n        \n        \n    </div>\n  </div>\n  \n  <!-- Hardware Content -->\n  \n    <!-- EPC/SNMP Devices Section -->\n    \n  \n  \n  <!-- Inventory Items Section -->\n  \n</div>\n\n<!-- Scan Modal -->\n\n\n<!-- EPC Deployment Wizard -->\n\n\n<!-- EPC Edit Modal -->\n";
}

@page GET "/modules/help-desk"
page modules_help_desk_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "help-desk", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"help-desk-container\">\n  <div class=\"header\">\n    <button class=\"btn-back\">\n      ← Back to Modules\n    </button>\n    \n    <div class=\"title-section\">\n      <h1>🎧 Help Desk</h1>\n      <p class=\"subtitle\">Customer support and ticket management for Demo Tenant</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button \n        class=\"btn btn-secondary btn-reports\"\n        title=\"View Ticket Reports and Analytics\"\n      >\n        📊 Reports\n      </button>\n      <button class=\"btn btn-secondary\">\n        🔍 Customer Lookup\n      </button>\n      <button class=\"btn btn-primary\">\n        ➕ Create Ticket\n      </button>\n    </div>\n  </div>\n  \n  \n  \n  <div class=\"stats-grid\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon open\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Open Tickets</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon in-progress\">⚙️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">In Progress</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon resolved\">✅</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Resolved</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon time\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n  \n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search tickets, customers...\"\n      />\n    </div>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"open\">Open</option>\n      <option value=\"assigned\">Assigned</option>\n      <option value=\"in-progress\">In Progress</option>\n      <option value=\"waiting-parts\">Waiting Parts</option>\n      <option value=\"resolved\">Resolved</option>\n      <option value=\"closed\">Closed</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Priority</option>\n      <option value=\"critical\">Critical</option>\n      <option value=\"high\">High</option>\n      <option value=\"medium\">Medium</option>\n      <option value=\"low\">Low</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Categories</option>\n      <option value=\"customer-facing\">Customer-Facing</option>\n      <option value=\"infrastructure\">Infrastructure</option>\n    </select>\n    \n    <div class=\"results-count\">\n       of 1 tickets\n    </div>\n  </div>\n  \n  \n    <div class=\"tickets-grid\">\n      \n    </div>\n  \n</div>\n\n\n\n";
}

@page GET "/modules/help-desk/reports"
page modules_help_desk_reports_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/help-desk/reports", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-help-desk-reports\" data-wisp-path=\"/modules/help-desk/reports\" data-cwl-island=\"client\"><div class=\"reports-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Help Desk\n      </button>\n      <h1>📊 Ticket Reports & Analytics</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn btn-primary\">\n        🖨️ Print PDF\n      </button>\n    </div>\n  </div>\n\n  \n    <!-- Summary Cards -->\n    <div class=\"summary-grid\">\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">🎧</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">10</div>\n          <div class=\"card-label\">Total Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card open\">\n        <div class=\"card-icon\">📋</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Open Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card resolved\">\n        <div class=\"card-icon\">✅</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Resolved Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">⏱️</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Avg Resolution Time</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Alerts -->\n    \n\n    \n\n    <!-- Charts -->\n    <div class=\"charts-grid\">\n      <!-- Status Distribution -->\n      <div class=\"chart-card\">\n        <h3>Status Distribution</h3>\n        \n      </div>\n\n      <!-- Priority Distribution -->\n      <div class=\"chart-card\">\n        <h3>Priority Distribution</h3>\n        \n      </div>\n\n      <!-- Category Distribution -->\n      <div class=\"chart-card\">\n        <h3>Category Distribution</h3>\n        \n      </div>\n\n      <!-- Type Distribution -->\n      <div class=\"chart-card\">\n        <h3>Type Distribution</h3>\n        \n      </div>\n    </div>\n\n    <!-- Detailed Tables -->\n    <div class=\"table-section\">\n      <h3>By Status</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Priority</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Priority</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Category</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Category</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Assigned To</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Assigned To</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>SLA Compliance</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>On Time</td>\n            <td>8</td>\n            <td>%</td>\n          </tr>\n          <tr>\n            <td>Breached</td>\n            <td>2</td>\n            <td>%</td>\n          </tr>\n          <tr>\n            <td>No SLA</td>\n            <td></td>\n            <td>-</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  \n</div></div>";
}

@page GET "/modules/hss-management"
page modules_hss_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "hss-management", apiPath: "/api/hss", api_ok: true, api_surface: "wisp-api-native", api_resource: "hss", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"hss-management\">\n  <!-- Header -->\n  <div class=\"header\">\n    <div class=\"header-content\">\n      <div class=\"header-main\">\n        <div class=\"header-row\">\n          <button class=\"back-button\">\n            ← Back to Dashboard\n          </button>\n          <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n        </div>\n        <div>\n          <h1>🔐 HSS & Subscriber Management</h1>\n          <p class=\"subtitle\">Home Subscriber Server - Authentication & User Management</p>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Help Button - Fixed Position -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n  \n  \n    <!-- Navigation Tabs -->\n    <div class=\"tabs\">\n      <button\n      >\n        📊 Dashboard\n      </button>\n      <button\n      >\n        📦 Groups\n      </button>\n      <button\n      >\n        🚀 Bandwidth Plans\n      </button>\n      <button\n      >\n        🌐 MME Connections\n      </button>\n      <button\n      >\n        📥 Bulk Import\n      </button>\n      <button\n      >\n        🌐 Remote EPCs\n      </button>\n    </div>\n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      \n    </div>\n  \n  \n  <!-- Help Modal -->\n  <div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"help-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      \n      <div class=\"help-body\">\n        \n      </div>\n    </div>\n  </div></div>\n\n  <!-- Subscriber Creation Wizard -->\n  <div data-cwl-component=\"SubscriberCreationWizard\" data-cwl-lifted-component=\"SubscriberCreationWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n\n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div></div>\n  <div data-cwl-component=\"BandwidthPlanWizard\" data-cwl-lifted-component=\"BandwidthPlanWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n\n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div></div>\n  <div data-cwl-component=\"SubscriberGroupWizard\" data-cwl-lifted-component=\"SubscriberGroupWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n\n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div></div>\n</div>";
}

@page GET "/modules/inventory"
page modules_inventory_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "inventory", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"inventory-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n        <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📦 Inventory Management</h1>\n      <p class=\"subtitle\">Centralized asset tracking and management</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Scan Check In\n      </button>\n      <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n      <button class=\"btn-secondary\">\n        📤 Scan Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        🔍 Manual Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 View Reports\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn-primary\">\n        ➕ Add Item\n      </button>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📦</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Items</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\">\n          12\n        </div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\">\n          \n        </div>\n        <div class=\"stat-label\">Deployed</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer...\"\n        />\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        \n      </select>\n      \n      <button class=\"btn-primary\">Apply</button>\n      <button class=\"btn-secondary\">Clear</button>\n    </div>\n  </div>\n  \n  <!-- Loading State -->\n  \n    <!-- Inventory Table -->\n    <div class=\"table-container\">\n      <table class=\"inventory-table\">\n        <thead>\n          <tr>\n            <th>Asset Tag</th>\n            <th>Category</th>\n            <th>Type</th>\n            <th>Manufacturer</th>\n            <th>Model</th>\n            <th>Serial Number</th>\n            <th>Status</th>\n            <th>Condition</th>\n            <th>Location</th>\n            <th>Last Updated</th>\n            <th>Actions</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n    \n    <!-- Pagination -->\n    <div class=\"pagination\">\n        <button \n          class=\"btn-secondary\"\n        >\n          ← Previous\n        </button>\n        \n        <span class=\"pagination-info\">\n          Page 1 of 2 \n          (24 items)\n        </span>\n        \n        <button \n          class=\"btn-secondary\"\n        >\n          Next →\n        </button>\n      </div>\n  \n  \n  <!-- Manual Barcode Entry Modal -->\n  \n\n  <!-- Asset Tag Viewer -->\n  \n  \n  <!-- Scan Modal -->\n  \n  \n  <!-- Check-in Wizard -->\n  <div data-cwl-component=\"InventoryCheckInWizard\" data-cwl-lifted-component=\"InventoryCheckInWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n  \n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div></div>\n  <!-- RMA Tracking Wizard -->\n  <div data-cwl-component=\"RMATrackingWizard\" data-cwl-lifted-component=\"RMATrackingWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n\n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div></div>\n</div>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"></div>\n\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"help-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      \n      <div class=\"help-body\">\n        \n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"TransferModal\" data-cwl-lifted-component=\"TransferModal\" data-cwl-orphan-modal=\"1\"></div>\n<div data-cwl-component=\"BundleDetailsModal\" data-cwl-lifted-component=\"BundleDetailsModal\" data-cwl-orphan-modal=\"1\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\" on:click|stopPropagation>\n      <div class=\"modal-header\">\n        <div class=\"header-left\">\n          <span class=\"bundle-icon\"></span>\n          <div>\n            <h2></h2>\n            <p class=\"bundle-type\"></p>\n          </div>\n        </div>\n        <button class=\"close-btn\">✕</button>\n      </div>\n      \n      <div class=\"modal-body\">\n        \n        \n        \n        \n        <div class=\"section\">\n          <h3>Bundle Statistics</h3>\n          <div class=\"stats-grid\">\n            <div class=\"stat\">\n              <span class=\"stat-label\">Items</span>\n              <span class=\"stat-value\"></span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat-label\">Total Cost</span>\n              <span class=\"stat-value\"></span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat-label\">Status</span>\n              <span class=\"stat-value badge badge-\"></span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat-label\">Used</span>\n              <span class=\"stat-value\"> times</span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat-label\">Last Used</span>\n              <span class=\"stat-value\"></span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat-label\">Updated</span>\n              <span class=\"stat-value\"></span>\n            </div>\n          </div>\n        </div>\n        \n        \n        \n        \n        \n        \n      </div>\n      \n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\">\n          Close\n        </button>\n        \n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"CreateBundleModal\" data-cwl-lifted-component=\"CreateBundleModal\" data-cwl-orphan-modal=\"1\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\" on:click|stopPropagation>\n      <div class=\"modal-header\">\n        <h2>➕ Create Hardware Bundle</h2>\n        <button class=\"close-btn\">✕</button>\n      </div>\n      \n      <div class=\"modal-body\">\n        \n        \n        <div class=\"form-section\">\n          <h3>Basic Information</h3>\n          \n          <div class=\"form-group\">\n            <label>Bundle Name *</label>\n            <input \n              type=\"text\"\n              placeholder=\"e.g., Standard Site Deployment Kit\"\n              required\n            />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Description</label>\n            <textarea\n              placeholder=\"Describe this bundle and when to use it...\"\n              rows=\"3\"\n            ></textarea>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Bundle Type</label>\n            <select>\n              \n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Tags</label>\n            <div class=\"tag-input-group\">\n              <input \n                id=\"tag-input\"\n                type=\"text\" \n                placeholder=\"Add a tag...\"\n              />\n              <button class=\"btn-sm\">Add</button>\n            </div>\n            \n          </div>\n        </div>\n        \n        <div class=\"form-section\">\n          <h3>Bundle Items</h3>\n          \n          <div class=\"add-item-form\">\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label>Category</label>\n                <select>\n                  <option></option><option></option><option></option><option></option>\n                </select>\n              </div>\n              \n              <div class=\"form-group\">\n                <label>Equipment Type *</label>\n                <select required>\n                  <option>Select type...</option>\n                  <option></option><option></option><option></option><option></option>\n                </select>\n              </div>\n            </div>\n            \n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label>Quantity *</label>\n                <input \n                  type=\"number\"\n                  min=\"1\"\n                  required\n                />\n              </div>\n              \n              <div class=\"form-group\">\n                <label>Manufacturer</label>\n                <input \n                  type=\"text\"\n                  placeholder=\"e.g., Ubiquiti\"\n                />\n              </div>\n              \n              <div class=\"form-group\">\n                <label>Model</label>\n                <input \n                  type=\"text\"\n                  placeholder=\"e.g., AirFiber 5X\"\n                />\n              </div>\n              \n              <div class=\"form-group\">\n                <label>Estimated Cost per Unit</label>\n                <input \n                  type=\"number\"\n                  min=\"0\"\n                  step=\"0.01\"\n                  placeholder=\"0.00\"\n                />\n              </div>\n            </div>\n            \n            <button class=\"btn-add\" type=\"button\">\n              ➕ Add Item\n            </button>\n          </div>\n          \n          \n        </div>\n        \n        <div class=\"form-section\">\n          <h3>Notes</h3>\n          <textarea\n            placeholder=\"Additional notes about this bundle...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n      \n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\">\n          Cancel\n        </button>\n        <button class=\"btn-primary\">\n          Create Bundle\n        </button>\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div \n    class=\"auth-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"auth-modal\" \n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          \n        </h2>\n        <button class=\"close-btn\">×</button>\n      </div>\n      \n      <div class=\"auth-body\">\n        \n        \n        \n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/inventory/:id"
page modules_inventory_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/inventory/:id", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-inventory-:id\" data-wisp-path=\"/modules/inventory/:id\" data-cwl-island=\"client\"><div class=\"item-detail-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Inventory\n      </button>\n      <h1>📦 Equipment Details</h1>\n      \n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        📱 View QR Code\n      </button>\n      <button class=\"btn btn-secondary\">\n        🖨️ Print Tag\n      </button>\n      <button class=\"btn btn-primary\">\n        ✏️ Edit\n      </button>\n      <button class=\"btn btn-primary\">\n        📦 Transfer\n      </button>\n    </div>\n  </div>\n\n  \n    <div class=\"content-grid\">\n      <!-- Basic Information -->\n      <div class=\"info-card\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Asset Tag</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Serial Number</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Category</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Equipment Type</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Manufacturer</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Model</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Status</label>\n            <span class=\"status-badge\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Condition</label>\n            <span class=\"condition-badge\"></span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Current Location -->\n      <div class=\"info-card\">\n        <h3>📍 Current Location</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Location Type</label>\n            <span class=\"value\"></span>\n          </div>\n          \n          \n          \n        </div>\n      </div>\n\n      <!-- Purchase Information -->\n      \n\n      <!-- Warranty Information -->\n      \n\n      <!-- Technical Specifications -->\n      \n\n      <!-- Module Integration -->\n      \n\n      <!-- Notes -->\n      \n\n      <!-- Metadata -->\n      <div class=\"info-card full-width\">\n        <h3>📊 Metadata</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Created</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Last Updated</label>\n            <span class=\"value\"></span>\n          </div>\n        </div>\n      </div>\n    </div>\n  \n</div>\n\n<!-- QR Code Modal -->\n</div>";
}

@page GET "/modules/inventory/:id/edit"
page modules_inventory_id_edit_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/inventory/:id/edit", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-inventory-:id-edit\" data-wisp-path=\"/modules/inventory/:id/edit\" data-cwl-island=\"client\"><div class=\"edit-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Details\n      </button>\n      <h1>✏️ Edit Equipment</h1>\n      \n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        Cancel\n      </button>\n      <button class=\"btn btn-primary\">\n        Save Changes\n      </button>\n    </div>\n  </div>\n\n  \n    <form class=\"edit-form\">\n      <div class=\"form-sections\">\n        <!-- Basic Information -->\n        <div class=\"form-section\">\n          <h3>📋 Basic Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"assetTag\">Asset Tag</label>\n              <input \n                id=\"assetTag\"\n                type=\"text\" \n                placeholder=\"Enter asset tag\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"serialNumber\">Serial Number *</label>\n              <input \n                id=\"serialNumber\"\n                type=\"text\" \n                placeholder=\"Enter serial number\"\n                required\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"category\">Category *</label>\n              <select id=\"category\" required>\n                <option>Select category...</option>\n                <option value=\"radio\">Radio Equipment</option>\n                <option value=\"antenna\">Antenna</option>\n                <option value=\"cpe\">CPE Device</option>\n                <option value=\"backhaul\">Backhaul Equipment</option>\n                <option value=\"power\">Power Equipment</option>\n                <option value=\"network\">Network Equipment</option>\n                <option value=\"test\">Test Equipment</option>\n                <option value=\"other\">Other</option>\n              </select>\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"equipmentType\">Equipment Type *</label>\n              <input \n                id=\"equipmentType\"\n                type=\"text\" \n                placeholder=\"e.g., Sector Antenna, CPE Router\"\n                required\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"manufacturer\">Manufacturer</label>\n              <input \n                id=\"manufacturer\"\n                type=\"text\" \n                placeholder=\"Enter manufacturer\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"model\">Model</label>\n              <input \n                id=\"model\"\n                type=\"text\" \n                placeholder=\"Enter model\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"status\">Status *</label>\n              <select id=\"status\" required>\n                <option value=\"available\">Available</option>\n                <option value=\"deployed\">Deployed</option>\n                <option value=\"reserved\">Reserved</option>\n                <option value=\"in-transit\">In Transit</option>\n                <option value=\"maintenance\">Maintenance</option>\n                <option value=\"rma\">RMA</option>\n                <option value=\"retired\">Retired</option>\n                <option value=\"lost\">Lost</option>\n                <option value=\"sold\">Sold</option>\n              </select>\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"condition\">Condition *</label>\n              <select id=\"condition\" required>\n                <option value=\"new\">New</option>\n                <option value=\"excellent\">Excellent</option>\n                <option value=\"good\">Good</option>\n                <option value=\"fair\">Fair</option>\n                <option value=\"poor\">Poor</option>\n                <option value=\"damaged\">Damaged</option>\n                <option value=\"refurbished\">Refurbished</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <!-- Current Location (optional; assign during deploy if unassigned) -->\n        <div class=\"form-section\">\n          <h3>📍 Current Location</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"locationType\">Location Type</label>\n              <select id=\"locationType\">\n                <option value=\"unassigned\">Unassigned (assign during deploy)</option>\n                <option value=\"warehouse\">Warehouse</option>\n                <option value=\"tower\">Tower Site</option>\n                <option value=\"noc\">NOC</option>\n                <option value=\"vehicle\">Vehicle</option>\n                <option value=\"customer\">Customer Site</option>\n                <option value=\"rma\">RMA</option>\n                <option value=\"vendor\">Vendor</option>\n                <option value=\"other\">Other</option>\n              </select>\n            </div>\n            \n            \n          </div>\n        </div>\n\n        <!-- Purchase Information -->\n        <div class=\"form-section\">\n          <h3>💰 Purchase Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"vendor\">Vendor</label>\n              <input \n                id=\"vendor\"\n                type=\"text\" \n                placeholder=\"Enter vendor name\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchaseDate\">Purchase Date</label>\n              <input \n                id=\"purchaseDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchasePrice\">Purchase Price</label>\n              <input \n                id=\"purchasePrice\"\n                type=\"number\" \n                step=\"0.01\" \n                placeholder=\"0.00\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchaseOrderNumber\">PO Number</label>\n              <input \n                id=\"purchaseOrderNumber\"\n                type=\"text\" \n                placeholder=\"Enter PO number\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Warranty Information -->\n        <div class=\"form-section\">\n          <h3>🛡️ Warranty Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"warrantyProvider\">Provider</label>\n              <input \n                id=\"warrantyProvider\"\n                type=\"text\" \n                placeholder=\"Enter warranty provider\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyStartDate\">Start Date</label>\n              <input \n                id=\"warrantyStartDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyEndDate\">End Date</label>\n              <input \n                id=\"warrantyEndDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyType\">Type</label>\n              <input \n                id=\"warrantyType\"\n                type=\"text\" \n                placeholder=\"e.g., Manufacturer, Extended\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Technical Specifications -->\n        <div class=\"form-section\">\n          <h3>⚙️ Technical Specifications</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"powerRequirements\">Power Requirements</label>\n              <input \n                id=\"powerRequirements\"\n                type=\"text\" \n                placeholder=\"e.g., 24V DC, 2A\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"ipAddress\">IP Address</label>\n              <input \n                id=\"ipAddress\"\n                type=\"text\" \n                placeholder=\"192.168.1.100\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"managementUrl\">Management URL</label>\n              <input \n                id=\"managementUrl\"\n                type=\"url\" \n                placeholder=\"http://192.168.1.100\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Notes -->\n        <div class=\"form-section\">\n          <h3>📝 Notes</h3>\n          <div class=\"form-group\">\n            <label for=\"notes\">Additional Notes</label>\n            <textarea \n              id=\"notes\" \n              placeholder=\"Enter any additional notes or comments...\"\n              rows=\"4\"\n            ></textarea>\n          </div>\n        </div>\n      </div>\n    </form>\n  \n</div></div>";
}

@page GET "/modules/inventory/add"
page modules_inventory_add_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/inventory/add", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-inventory-add\" data-wisp-path=\"/modules/inventory/add\" data-cwl-island=\"client\"><div class=\"add-inventory-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Inventory\n      </button>\n      <h1>➕ Add Inventory Item</h1>\n    </div>\n  </div>\n  \n  \n  \n  <div class=\"form-container\">\n    <form>\n      \n      <!-- Classification -->\n      <div class=\"section\">\n        <h3>🏷️ Equipment Classification</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Category *</label>\n            <select required>\n              <option></option><option></option><option></option><option></option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Equipment Type *</label>\n            <select required>\n              <option>-- Select Type --</option>\n              <option></option><option></option><option></option><option></option>\n              <option value=\"Other/Custom\">Other/Custom</option>\n            </select>\n          </div>\n        </div>\n        \n        \n      </div>\n      \n      <!-- Manufacturer Info -->\n      <div class=\"section\">\n        <h3>🏭 Manufacturer Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Manufacturer</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Model</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Part Number</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Serial Number *</label>\n            <input type=\"text\" required />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Firmware Version</label>\n          <input type=\"text\" />\n        </div>\n      </div>\n      \n      <!-- Location (optional; assign during deploy if left unassigned) -->\n      <div class=\"section\">\n        <h3>📍 Location</h3>\n        <p class=\"help-text\" style=\"margin-bottom: 1rem;\">Optional. Leave unassigned to assign a location during the deploy step.</p>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Location Type</label>\n            <select>\n              <option value=\"unassigned\">Unassigned (assign during deploy)</option>\n              <option value=\"warehouse\">Warehouse</option>\n              <option value=\"tower\">Tower Site</option>\n              <option value=\"noc\">NOC</option>\n              <option value=\"vehicle\">Service Vehicle</option>\n              <option value=\"rma\">RMA/Repair Center</option>\n              <option value=\"customer\">Customer Premises</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n              <label>Select Location</label>\n              <select>\n                <option>-- Select from map --</option>\n                \n              </select>\n              \n            </div>\n        </div>\n        \n        <!-- Specific location details based on type -->\n        \n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Status *</label>\n            <select required>\n              <option value=\"available\">Available</option>\n              <option value=\"deployed\">Deployed</option>\n              <option value=\"reserved\">Reserved</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"rma\">RMA</option>\n              <option value=\"retired\">Retired</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Condition *</label>\n            <select required>\n              <option value=\"new\">New</option>\n              <option value=\"excellent\">Excellent</option>\n              <option value=\"good\">Good</option>\n              <option value=\"fair\">Fair</option>\n              <option value=\"poor\">Poor</option>\n              <option value=\"refurbished\">Refurbished</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Purchase Info -->\n      <div class=\"section\">\n        <h3>💰 Purchase Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Vendor</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Purchase Date</label>\n            <input type=\"date\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Purchase Price ($)</label>\n            <input type=\"number\" step=\"0.01\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>PO Number</label>\n            <input type=\"text\" />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Book Value ($)</label>\n          <input type=\"number\" step=\"0.01\" />\n        </div>\n      </div>\n      \n      <!-- Warranty -->\n      <div class=\"section\">\n        <h3>🛡️ Warranty Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Warranty Provider</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Start Date</label>\n            <input type=\"date\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>End Date</label>\n            <input type=\"date\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Technical Details -->\n      <div class=\"section\">\n        <h3>⚙️ Technical Specifications</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Power Requirements</label>\n            <input type=\"text\" placeholder=\"48V DC, 100-240V AC\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>IP Address</label>\n            <input type=\"text\" placeholder=\"192.168.1.100\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Notes -->\n      <div class=\"section\">\n        <h3>📝 Additional Notes</h3>\n        <div class=\"form-group\">\n          <textarea rows=\"4\" placeholder=\"Configuration notes, special instructions...\"></textarea>\n        </div>\n      </div>\n      \n      <!-- Actions -->\n      <div class=\"form-actions\">\n        <button type=\"button\" class=\"btn-secondary\">\n          Cancel\n        </button>\n        <button type=\"submit\" class=\"btn-primary\">\n          ✅ Add to Inventory\n        </button>\n      </div>\n    </form>\n  </div>\n</div></div>";
}

@page GET "/modules/inventory/bundles"
page modules_inventory_bundles_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/inventory/bundles", apiPath: "/api/bundles", api_ok: true, api_surface: "wisp-api-native", api_resource: "bundles", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-inventory-bundles\" data-wisp-path=\"/modules/inventory/bundles\" data-cwl-island=\"client\"><div class=\"bundles-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Inventory\n      </button>\n      <h1>📦 Hardware Bundles</h1>\n      <p class=\"subtitle\">Create and manage hardware bundles for easy planning and deployment</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-primary\">\n        ➕ Create Bundle\n      </button>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Filters -->\n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search bundles...\"\n      />\n    </div>\n    \n    <select>\n      \n    </select>\n    \n    <select>\n      <option></option><option></option><option></option><option></option><option></option>\n    </select>\n    \n    <div class=\"results-count\">\n       of 24 bundles\n    </div>\n  </div>\n  \n  <!-- Bundles List -->\n  \n    <div class=\"bundles-grid\">\n      \n    </div>\n    \n    <!-- Pagination -->\n    <div class=\"pagination\">\n        <button \n          class=\"btn-page\"\n        >\n          ← Previous\n        </button>\n        <span class=\"pagination-info\">\n          Page 1 of 2\n        </span>\n        <button \n          class=\"btn-page\"\n        >\n          Next →\n        </button>\n      </div>\n  \n</div>\n\n<!-- Modals -->\n\n</div>";
}

@page GET "/modules/inventory/reports"
page modules_inventory_reports_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/inventory/reports", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-inventory-reports\" data-wisp-path=\"/modules/inventory/reports\" data-cwl-island=\"client\"><div class=\"reports-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Inventory\n      </button>\n      <h1>📊 Inventory Reports & Analytics</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn btn-primary\">\n        🖨️ Print PDF\n      </button>\n    </div>\n  </div>\n\n  \n    <!-- Summary Cards -->\n    <div class=\"summary-grid\">\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">📦</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">10</div>\n          <div class=\"card-label\">Total Items</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">💰</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">$</div>\n          <div class=\"card-label\">Total Value</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">📍</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Locations</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">🏭</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Manufacturers</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Alerts -->\n    \n\n    <!-- Charts -->\n    <div class=\"charts-grid\">\n      <!-- Status Distribution -->\n      <div class=\"chart-card\">\n        <h3>Status Distribution</h3>\n        \n      </div>\n\n      <!-- Category Distribution -->\n      <div class=\"chart-card\">\n        <h3>Category Distribution</h3>\n        \n      </div>\n\n      <!-- Location Distribution -->\n      <div class=\"chart-card full-width\">\n        <h3>Location Distribution</h3>\n        \n      </div>\n    </div>\n\n    <!-- Detailed Tables -->\n    <div class=\"table-section\">\n      <h3>By Status</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Category</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Category</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n  \n</div></div>";
}

@page GET "/modules/maintain"
page modules_maintain_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/maintain", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-maintain\" data-wisp-path=\"/modules/maintain\" data-cwl-island=\"client\"><div class=\"maintain-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-top\">\n        <button class=\"back-btn\">\n          <span>←</span> Back\n        </button>\n        <h1>Maintain Module</h1>\n        <div class=\"header-actions\">\n          <button \n            class=\"btn btn-secondary btn-reports\"\n            title=\"View Ticket Reports and Analytics\"\n          >\n            Reports\n          </button>\n          \n        </div>\n      </div>\n      \n      <!-- Tabs -->\n      <div class=\"tabs\">\n        <button \n          class=\"tab\">\n          Help Desk\n        </button>\n        <button \n          class=\"tab\">\n          Tickets\n        </button>\n        <button \n          class=\"tab\">\n          Maintenance\n        </button>\n        <button \n          class=\"tab\">\n          Customers\n        </button>\n        <button \n          class=\"tab\">\n          Incidents\n        </button>\n      </div>\n    </div>\n    \n    <!-- Content -->\n    <div class=\"module-content\">\n      \n    </div>\n  </div>\n  \n  <!-- Modals -->\n  \n  \n  \n  \n  \n  \n  \n\n  <!-- Tips Modal -->\n  <div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"></div></div>";
}

@page GET "/modules/monitor"
page modules_monitor_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/monitor", apiPath: "/api/monitoring", api_ok: true, api_surface: "wisp-api-native", api_resource: "monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-monitor\" data-wisp-path=\"/modules/monitor\" data-cwl-island=\"client\"><!-- This page redirects to /modules/monitoring -->\n<div style=\"display: flex; align-items: center; justify-content: center; height: 100vh;\">\n  <p>Redirecting to Monitoring...</p>\n</div></div>";
}

@page GET "/modules/monitoring"
page modules_monitoring_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "monitoring", apiPath: "/api/monitoring/graphs", api_ok: true, api_surface: "wisp-api-native", api_resource: "monitoring-graphs", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- Monitoring Setup Wizard -->\n  \n\n  <div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      \n        \n      \n    </div>\n\n    <!-- Floating Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-success);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\" title=\"Back to Modules\">\n          ←\n        </button>\n        <h1>🗺️ Monitor</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n        <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n        <button class=\"module-control-btn\" title=\"Configuration\">\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Config</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"Geographic View\"\n        >\n          <span class=\"control-icon\">🗺️</span>\n          <span class=\"control-label\">Geographic</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"Topology View\"\n        >\n          <span class=\"control-icon\">🕸️</span>\n          <span class=\"control-label\">Topology</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"EPC Devices\"\n        >\n          <span class=\"control-icon\">📡</span>\n          <span class=\"control-label\">EPC (1)</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"SNMP Graphs\"\n        >\n          <span class=\"control-icon\">📈</span>\n          <span class=\"control-label\">Graphs</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"Mikrotik Devices\"\n        >\n          <span class=\"control-icon\">🖥️</span>\n          <span class=\"control-label\">Mikrotik</span>\n        </button>\n      </div>\n    </div>\n  </div>\n  \n  <!-- SNMP Graphs View -->\n  \n  \n  <!-- Mikrotik Devices View -->\n  \n  \n  <!-- EPC Devices View -->\n  \n\n<!-- Mikrotik Credentials Modal -->\n<div data-cwl-component=\"MikrotikCredentialsModal\" data-cwl-lifted-component=\"MikrotikCredentialsModal\"></div>\n\n  <!-- Help Modal -->\n  <div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"help-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      \n      <div class=\"help-body\">\n        \n      </div>\n    </div>\n  </div></div>\n\n  <!-- Tips Modal -->\n  <div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"></div>\n\n\n<!-- SNMP Configuration Modal -->\n<div data-cwl-component=\"SNMPConfigurationPanel\" data-cwl-lifted-component=\"SNMPConfigurationPanel\"><div class=\"modal-backdrop\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔧 SNMP Configuration</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    <div class=\"modal-body\">\n      <!-- Tab Navigation -->\n      <div class=\"tabs\">\n        <button \n          class=\"tab\"\n        >\n          🔑 Community Strings\n        </button>\n        <button \n          class=\"tab\"\n        >\n          👤 SNMPv3 Users\n        </button>\n        <button \n          class=\"tab\"\n        >\n          🌐 Network Subnets\n        </button>\n        <button \n          class=\"tab\"\n        >\n          📱 Device Overrides\n        </button>\n        <button \n          class=\"tab\"\n        >\n          🔍 Auto-Discovery\n        </button>\n      </div>\n      \n      <!-- Community Strings Tab -->\n      \n      \n      <!-- SNMPv3 Users Tab -->\n      \n      \n      <!-- Network Subnets Tab -->\n      \n      \n      <!-- Device Overrides Tab -->\n      \n      \n      <!-- Auto-Discovery Tab -->\n      \n      \n      <!-- Test Results -->\n      \n    </div>\n    \n    <div class=\"modal-footer\">\n      <button type=\"button\" class=\"btn btn-secondary\">\n        Cancel\n      </button>\n      <button type=\"button\" class=\"btn btn-primary\">\n        \n          💾 Save Configuration\n        \n      </button>\n    </div>\n  </div>\n</div></div>\n\n<!-- EPC Deployment Modal -->\n<div data-cwl-component=\"EPCDeploymentModal\" data-cwl-lifted-component=\"EPCDeploymentModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content epc-deployment-modal\">\n      <div class=\"modal-header\">\n        <h2>🚀 Server Deployment</h2>\n        <button class=\"close-btn\">✕</button>\n      </div>\n\n      \n\n      \n\n      <div class=\"modal-body\">\n        <!-- Step Progress Indicator -->\n        <div class=\"step-indicator\">\n          \n        </div>\n\n        <!-- Step Content -->\n        <div class=\"step-content\">\n          <!-- Step 1: Deployment Type -->\n          \n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"modal-actions\">\n          \n          \n          \n        </div>\n      </div>\n    </div>\n  </div></div>\n\n<!-- Alert Details Modal -->\n\n\n<!-- Create Ticket from Alert Modal -->\n\n\n<!-- Monitoring Site Details Modal (right-click on sites) -->\n<!-- Monitoring Site Details Modal (right-click on sites) -->\n";
}

@page GET "/modules/pci-resolution"
page modules_pci_resolution_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "pci-resolution", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- Full Screen Map -->\n<!-- Note: Auth check removed - Module_Manager dashboard handles authentication -->\n<div class=\"app\">\n  <!-- Map Background -->\n  <div class=\"map-fullscreen\">\n    \n  </div>\n\n  <!-- New UI Layout: Separate Positioned Elements -->\n  \n  <!-- Top Left: Brand -->\n  <div data-cwl-component=\"TopBrand\" data-cwl-lifted-component=\"TopBrand\"><div class=\"top-brand\">\n  <div class=\"brand-content\">\n    <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"brand-icon\">\n      <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n      <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n    </svg>\n    <h1 class=\"app-title\">LTE PCI Mapper</h1>\n  </div>\n</div></div>\n  \n  <!-- Top Right: Basemap Switcher -->\n  <div data-cwl-component=\"BasemapSwitcher\" data-cwl-lifted-component=\"BasemapSwitcher\"><div class=\"basemap-switcher\">\n  \n</div></div>\n  \n  <!-- Right Side: PCI Status Widget -->\n  <div data-cwl-component=\"PCIStatusWidget\" data-cwl-lifted-component=\"PCIStatusWidget\"><div class=\"pci-status-widget\">\n  <div class=\"status-header\">\n    <h2 class=\"status-title\">PCI Status</h2>\n    <div class=\"cell-count\"> Cells</div>\n  </div>\n  \n  <div class=\"status-grid\">\n    <div class=\"status-item total\">\n      <span class=\"status-value\"></span>\n      <span class=\"status-label\">Total</span>\n    </div>\n    \n    <div class=\"status-item critical\">\n      <span class=\"status-value\"></span>\n      <span class=\"status-label\">Critical</span>\n    </div>\n    \n    <div class=\"status-item high\">\n      <span class=\"status-value\"></span>\n      <span class=\"status-label\">High</span>\n    </div>\n    \n    <div class=\"status-item medium\">\n      <span class=\"status-value\"></span>\n      <span class=\"status-label\">Medium</span>\n    </div>\n    \n    <div class=\"status-item low\">\n      <span class=\"status-value\"></span>\n      <span class=\"status-label\">Low</span>\n    </div>\n  </div>\n</div></div>\n  \n  <!-- Left Sidebar: Vertical Menu -->\n  <div data-cwl-component=\"VerticalMenu\" data-cwl-lifted-component=\"VerticalMenu\"><div class=\"vertical-menu\">\n  <div class=\"menu-items\">\n    <!-- Back to Dashboard Button at Top -->\n    \n    \n    <div class=\"menu-divider\"></div>\n    \n    <!-- Network Selector -->\n    \n    \n    <div class=\"menu-divider\"></div>\n    <button class=\"menu-item\" title=\"Import cell data\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n        <polyline points=\"7 10 12 15 17 10\"></polyline>\n        <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"></line>\n      </svg>\n      <span class=\"menu-label\">Import</span>\n    </button>\n    \n    <button class=\"menu-item\" title=\"Manage towers and cell sites\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n        <polyline points=\"2 17 12 22 22 17\"></polyline>\n        <polyline points=\"2 12 12 17 22 12\"></polyline>\n      </svg>\n      <span class=\"menu-label\">Towers</span>\n    </button>\n    \n    <div class=\"menu-divider\"></div>\n    \n    <button class=\"menu-item\" title=\"Run PCI analysis\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n        <path d=\"m21 21-4.35-4.35\"></path>\n      </svg>\n      <span class=\"menu-label\">Analyze</span>\n    </button>\n    \n    <button class=\"menu-item\" title=\"Optimize PCI assignments\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n        <path d=\"M12 6v6l4 2\"></path>\n      </svg>\n      <span class=\"menu-label\">Optimize</span>\n    </button>\n    \n    \n    \n    <div class=\"menu-divider\"></div>\n    \n    <button class=\"menu-item\" title=\"View detailed analysis\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line>\n        <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line>\n        <line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"></line>\n      </svg>\n      <span class=\"menu-label\">Analysis</span>\n    </button>\n    \n    <button class=\"menu-item\" title=\"View PCI conflicts\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"></path>\n        <line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line>\n        <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n      </svg>\n      <span class=\"menu-label\">Conflicts</span>\n    </button>\n    \n    <button class=\"menu-item\" title=\"AI recommendations\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n        <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n        <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n      </svg>\n      <span class=\"menu-label\">AI Suggest</span>\n    </button>\n    \n    <button class=\"menu-item\" title=\"Export reports and configurations\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n        <polyline points=\"17 8 12 3 7 8\"></polyline>\n        <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n      </svg>\n      <span class=\"menu-label\">Export</span>\n    </button>\n    \n  </div>\n</div></div>\n  \n  <!-- Bottom Right: Settings Gear Menu -->\n  <div data-cwl-component=\"SettingsMenu\" data-cwl-lifted-component=\"SettingsMenu\"><div class=\"settings-menu\">\n  <button class=\"settings-trigger\" title=\"Settings\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n      <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path>\n    </svg>\n  </button>\n  \n  \n</div></div>\n  \n  <!-- Help Button -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n  <!-- Modular Components - Isolated and reusable -->\n  <div data-cwl-component=\"NetworkManager\" data-cwl-lifted-component=\"NetworkManager\"><div \n    class=\"network-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"network-modal\" \n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"network-manager-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"network-header\">\n        <h2 id=\"network-manager-modal-title\">\n          \n        </h2>\n        <button class=\"close-btn\">×</button>\n      </div>\n      \n      <div class=\"network-body\">\n        \n      </div>\n    </div>\n  </div></div>\n  \n  <div data-cwl-component=\"ImportWizard\" data-cwl-lifted-component=\"ImportWizard\"><div \n    class=\"wizard-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\" \n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"import-wizard-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"wizard-header\">\n        <h2 id=\"import-wizard-modal-title\">Import Data</h2>\n        <button class=\"close-btn\">×</button>\n      </div>\n      \n      <div class=\"wizard-body\">\n        <!-- Step 1: Choose Import Method -->\n          <div class=\"wizard-intro\">\n            <p class=\"intro-text\">Choose how you'd like to import cell data:</p>\n          </div>\n          \n          <div class=\"method-grid\">\n            <button class=\"method-card\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path>\n                  <polyline points=\"14 2 14 8 20 8\"></polyline>\n                  <line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"12\"></line>\n                  <line x1=\"9\" y1=\"15\" x2=\"15\" y2=\"15\"></line>\n                </svg>\n              </div>\n              <h3>CSV File</h3>\n              <p>Upload a CSV file with cell tower data</p>\n            </button>\n            \n            <button class=\"method-card\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n              </div>\n              <h3>KML File</h3>\n              <p>Import from Google Earth or GIS software</p>\n            </button>\n            \n            <button class=\"method-card\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path>\n                  <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path>\n                </svg>\n              </div>\n              <h3>Manual Entry</h3>\n              <p>Add cell data manually one by one</p>\n            </button>\n          </div>\n        \n          <!-- Step 2: CSV Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\">← Back</button>\n            \n            <h3>📄 CSV Import</h3>\n            <p class=\"help-text\">Upload a CSV file with tower/cell data. Leave PCI blank for auto-assignment.</p>\n            \n            <div class=\"file-upload-zone\">\n              <input \n                type=\"file\" \n                accept=\".csv\"\n                id=\"csv-upload\"\n              />\n              <label for=\"csv-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n                  <polyline points=\"17 8 12 3 7 8\"></polyline>\n                  <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n                </svg>\n                <span>Choose CSV file or drag & drop</span>\n              </label>\n            </div>\n            \n            <button class=\"template-btn\">\n              📥 Download CSV Template\n            </button>\n          </div>\n        \n          <!-- Step 2: KML Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\">← Back</button>\n            \n            <h3>🗺️ KML Import</h3>\n            <p class=\"help-text\">Upload a KML file from Google Earth or GIS software.</p>\n            \n            <div class=\"file-upload-zone\">\n              <input \n                type=\"file\" \n                accept=\".kml,.kmz\"\n                id=\"kml-upload\"\n              />\n              <label for=\"kml-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n                <span>Choose KML/KMZ file or drag & drop</span>\n              </label>\n            </div>\n            \n            <button class=\"template-btn\">\n              📥 Download KML Template\n            </button>\n            \n            <div class=\"info-box\">\n              <strong>Supported Data:</strong> The KML parser will extract coordinates, name, and cell parameters from ExtendedData or description fields (PCI, eNodeB, Sector, Frequency, etc.).\n            </div>\n          </div>\n      </div>\n    </div>\n  </div>\n\n<!-- Nested Site Editor for Manual Import -->\n<div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"></div></div>\n  \n  <div data-cwl-component=\"AnalysisModal\" data-cwl-lifted-component=\"AnalysisModal\"></div>\n  \n  <div data-cwl-component=\"ConflictsModal\" data-cwl-lifted-component=\"ConflictsModal\"><div \n    class=\"modal-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"modal modal-large\" \n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"conflicts-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"modal-header\">\n        <h2 id=\"conflicts-modal-title\">Conflicts ()</h2>\n        <button class=\"close-btn\">×</button>\n      </div>\n      <div class=\"modal-body scrollable\">\n        \n      </div>\n    </div>\n  </div></div>\n  \n  <div data-cwl-component=\"RecommendationsModal\" data-cwl-lifted-component=\"RecommendationsModal\"></div>\n  \n  <div data-cwl-component=\"OptimizationResultModal\" data-cwl-lifted-component=\"OptimizationResultModal\"></div>\n  \n  <div data-cwl-component=\"CellEditor\" data-cwl-lifted-component=\"CellEditor\"></div>\n  \n  <div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"></div>\n  \n  <div data-cwl-component=\"ContextMenu\" data-cwl-lifted-component=\"ContextMenu\"><div hidden aria-hidden=\"true\"><!-- Invisible backdrop to close menu -->\n  <div \n    class=\"context-backdrop\" \n    role=\"presentation\"\n  ></div>\n  \n  <!-- Context menu -->\n  <div class=\"context-menu\" style=\"left: px; top: px;\">\n    \n    \n    <!-- Always show add options -->\n    <button class=\"menu-item primary\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n        <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n        <line x1=\"12\" y1=\"7\" x2=\"12\" y2=\"13\"></line>\n        <line x1=\"9\" y1=\"10\" x2=\"15\" y2=\"10\"></line>\n      </svg>\n      Add Cell Site Manually\n    </button>\n    \n    <button class=\"menu-item\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n        <polyline points=\"17 8 12 3 7 8\"></polyline>\n        <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n      </svg>\n      Import from CSV/KML\n    </button>\n  </div></div></div>\n  \n  <div data-cwl-component=\"TowerManager\" data-cwl-lifted-component=\"TowerManager\"><div \n    class=\"tower-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"tower-modal\" \n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"tower-manager-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"tower-header\">\n        <div class=\"header-title\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n            <polyline points=\"2 17 12 22 22 17\"></polyline>\n            <polyline points=\"2 12 12 17 22 12\"></polyline>\n          </svg>\n          <h2 id=\"tower-manager-modal-title\">Tower Management</h2>\n          \n        </div>\n        <button class=\"close-btn\">×</button>\n      </div>\n      \n      <div class=\"tower-body\">\n        <!-- Search and Actions Bar -->\n        <div class=\"actions-bar\">\n          <div class=\"search-box\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n              <path d=\"m21 21-4.35-4.35\"></path>\n            </svg>\n            <input \n              type=\"text\" \n              placeholder=\"Search towers by eNodeB or sector ID...\"\n            />\n          </div>\n          <button class=\"add-tower-btn\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n            Add Tower\n          </button>\n        </div>\n        \n        <!-- Tower Stats -->\n        <div class=\"tower-stats\">\n          <div class=\"stat-card\">\n            <span class=\"stat-value\">1</span>\n            <span class=\"stat-label\">Towers</span>\n          </div>\n          <div class=\"stat-card\">\n            <span class=\"stat-value\"></span>\n            <span class=\"stat-label\">Sectors</span>\n          </div>\n          <div class=\"stat-card\">\n            <span class=\"stat-value\"></span>\n            <span class=\"stat-label\">Carriers</span>\n          </div>\n        </div>\n        \n        <!-- Tower List -->\n        <div class=\"tower-list\">\n          \n        </div>\n      </div>\n    </div>\n  </div>\n\n<!-- Site Editor Modal -->\n<div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"></div>\n\n<!-- Import Wizard Modal -->\n<div data-cwl-component=\"ImportWizard\" data-cwl-lifted-component=\"ImportWizard\"><div \n    class=\"wizard-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\" \n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"import-wizard-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"wizard-header\">\n        <h2 id=\"import-wizard-modal-title\">Import Data</h2>\n        <button class=\"close-btn\">×</button>\n      </div>\n      \n      <div class=\"wizard-body\">\n        <!-- Step 1: Choose Import Method -->\n          <div class=\"wizard-intro\">\n            <p class=\"intro-text\">Choose how you'd like to import cell data:</p>\n          </div>\n          \n          <div class=\"method-grid\">\n            <button class=\"method-card\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path>\n                  <polyline points=\"14 2 14 8 20 8\"></polyline>\n                  <line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"12\"></line>\n                  <line x1=\"9\" y1=\"15\" x2=\"15\" y2=\"15\"></line>\n                </svg>\n              </div>\n              <h3>CSV File</h3>\n              <p>Upload a CSV file with cell tower data</p>\n            </button>\n            \n            <button class=\"method-card\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n              </div>\n              <h3>KML File</h3>\n              <p>Import from Google Earth or GIS software</p>\n            </button>\n            \n            <button class=\"method-card\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path>\n                  <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path>\n                </svg>\n              </div>\n              <h3>Manual Entry</h3>\n              <p>Add cell data manually one by one</p>\n            </button>\n          </div>\n        \n          <!-- Step 2: CSV Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\">← Back</button>\n            \n            <h3>📄 CSV Import</h3>\n            <p class=\"help-text\">Upload a CSV file with tower/cell data. Leave PCI blank for auto-assignment.</p>\n            \n            <div class=\"file-upload-zone\">\n              <input \n                type=\"file\" \n                accept=\".csv\"\n                id=\"csv-upload\"\n              />\n              <label for=\"csv-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n                  <polyline points=\"17 8 12 3 7 8\"></polyline>\n                  <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n                </svg>\n                <span>Choose CSV file or drag & drop</span>\n              </label>\n            </div>\n            \n            <button class=\"template-btn\">\n              📥 Download CSV Template\n            </button>\n          </div>\n        \n          <!-- Step 2: KML Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\">← Back</button>\n            \n            <h3>🗺️ KML Import</h3>\n            <p class=\"help-text\">Upload a KML file from Google Earth or GIS software.</p>\n            \n            <div class=\"file-upload-zone\">\n              <input \n                type=\"file\" \n                accept=\".kml,.kmz\"\n                id=\"kml-upload\"\n              />\n              <label for=\"kml-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n                <span>Choose KML/KMZ file or drag & drop</span>\n              </label>\n            </div>\n            \n            <button class=\"template-btn\">\n              📥 Download KML Template\n            </button>\n            \n            <div class=\"info-box\">\n              <strong>Supported Data:</strong> The KML parser will extract coordinates, name, and cell parameters from ExtendedData or description fields (PCI, eNodeB, Sector, Frequency, etc.).\n            </div>\n          </div>\n      </div>\n    </div>\n  </div>\n\n<!-- Nested Site Editor for Manual Import -->\n<div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"></div></div></div>\n  \n  <!-- Export Modal -->\n  \n  \n  <!-- Help Modal -->\n  <div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"help-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      \n      <div class=\"help-body\">\n        \n      </div>\n    </div>\n  </div></div>\n  \n  <div data-cwl-component=\"ConflictResolutionWizard\" data-cwl-lifted-component=\"ConflictResolutionWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n\n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div></div>\n  \n        </div>";
}

@page GET "/modules/plan"
page modules_plan_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "plan", apiPath: "/api/plans", api_ok: true, api_surface: "wisp-api-native", api_resource: "plans", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-plan-app\" data-wisp-page=\"plan\" data-cwl-island=\"client\">\n  <div class=\"map-fullscreen\">\n    <iframe id=\"plan-map-iframe\" class=\"plan-map-iframe\" title=\"Plan map\" src=\"/modules/coverage-map?mode=plan&hideStats=true&planMode=true\"></iframe>\n  </div>\n  <div class=\"wisp-header-overlay\">\n    <div class=\"wisp-header-left\">\n      <button type=\"button\" class=\"wisp-back-btn\" data-action=\"back\" title=\"Back to Dashboard\" aria-label=\"Back to Dashboard\">←</button>\n      <h1>📋 Plan</h1>\n    </div>\n    <div class=\"wisp-header-controls\">\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"help\" title=\"Help\"><span class=\"control-icon\">❓</span><span class=\"control-label\">Help</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"hardware\" title=\"View hardware on map context\"><span class=\"control-icon\">🔧</span><span class=\"control-label\">Hardware</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"projects\" title=\"Project list\"><span class=\"control-icon\">📁</span><span class=\"control-label\">Projects</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"create-project\" title=\"Create plan project\"><span class=\"control-icon\">➕</span><span class=\"control-label\">Create</span></button>\n      <button type=\"button\" class=\"wisp-control-btn\" data-action=\"layers\" title=\"Layer filters\"><span class=\"control-icon\">🎛️</span><span class=\"control-label\">Layers</span></button>\n      <button type=\"button\" class=\"wisp-control-btn marketing-btn\" data-action=\"marketing\" title=\"Find addresses\"><span class=\"control-icon\">🔍</span><span class=\"control-label\">Find Addresses</span></button>\n    </div>\n  </div>\n  <aside id=\"plan-projects-panel\" class=\"plan-side-panel\" hidden aria-label=\"Plan projects\">\n    <div class=\"plan-panel-header\">\n      <h2>Plan projects</h2>\n      <button type=\"button\" class=\"plan-panel-close\" data-action=\"close-projects\" aria-label=\"Close\">✕</button>\n    </div>\n    <div id=\"plan-projects-list\" class=\"plan-projects-list\"><p class=\"plan-panel-loading\">Loading projects…</p></div>\n  </aside>\n  <div id=\"plan-active-summary\" class=\"plan-summary\" hidden></div>\n</div>";
}

@page GET "/modules/sites"
page modules_sites_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/sites", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-sites\" data-wisp-path=\"/modules/sites\" data-cwl-island=\"client\"><div class=\"sites-page\">\n    <div class=\"page-header\">\n      <div>\n        <h1>🏢 Site Management</h1>\n        <p class=\"subtitle\">Manage all network sites, towers, buildings, and facilities</p>\n      </div>\n      <div class=\"header-actions\">\n        <button class=\"btn-primary\">\n          ➕ Create New Site\n        </button>\n        <button class=\"btn-secondary\" title=\"Refresh\">\n          🔄 Refresh\n        </button>\n      </div>\n    </div>\n    \n    \n    \n    <!-- Filters and Search -->\n    <div class=\"filters-section\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"Search sites by name, address, or city...\"\n          class=\"search-input\"\n        />\n        <span class=\"search-icon\">🔍</span>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Type:</label>\n        <select>\n          <option value=\"all\">All Types</option>\n          <option value=\"tower\">📡 Tower</option>\n          <option value=\"building\">🏢 Building</option>\n          <option value=\"noc\">🖥️ NOC</option>\n          <option value=\"warehouse\">🏭 Warehouse</option>\n          <option value=\"pole\">📡 Pole</option>\n          <option value=\"other\">📍 Other</option>\n        </select>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Status:</label>\n        <select>\n          <option value=\"all\">All Statuses</option>\n          <option value=\"active\">✅ Active</option>\n          <option value=\"inactive\">❌ Inactive</option>\n          <option value=\"maintenance\">🔧 Maintenance</option>\n          <option value=\"planned\">📅 Planned</option>\n        </select>\n      </div>\n    </div>\n    \n    <!-- Summary Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">3</div>\n        <div class=\"stat-label\">Total Sites</div>\n      </div>\n      <div class=\"stat-card active\">\n        <div class=\"stat-value\">3</div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">3</div>\n        <div class=\"stat-label\">Towers</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">3</div>\n        <div class=\"stat-label\">Buildings</div>\n      </div>\n    </div>\n    \n    <!-- Sites Table -->\n    \n      <div class=\"sites-table-container\">\n        <table class=\"sites-table\">\n          <thead>\n            <tr>\n              <th>Site Name</th>\n              <th>Type</th>\n              <th>Status</th>\n              <th>Location</th>\n              <th>Contact</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            \n          </tbody>\n        </table>\n      </div>\n    \n  </div>\n  \n  <!-- Site Edit Modal -->\n  <div data-cwl-component=\"SiteEditModal\" data-cwl-lifted-component=\"SiteEditModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>\n        \n      </h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Find Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter address to search...\"\n          />\n          <button \n            class=\"btn-secondary\"\n          >\n            Search\n          </button>\n        </div>\n        <p class=\"help-text\">Or enter GPS coordinates below</p>\n      </div>\n      \n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Site Name *</label>\n            <input type=\"text\" placeholder=\"Main Tower Site\" required />\n          </div>\n          \n          <div class=\"form-group\" style=\"grid-column: 1 / -1;\">\n            <label>Site Types * (Select all that apply)</label>\n            <div class=\"type-checkboxes\">\n              \n            </div>\n            <p class=\"help-text\">Small operators can select multiple types (e.g., NOC + Tower, HQ + NOC)</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">✅ Active</option>\n              <option value=\"inactive\">❌ Inactive</option>\n              <option value=\"maintenance\">🔧 Maintenance</option>\n              <option value=\"planned\">📅 Planned</option>\n            </select>\n          </div>\n          \n          \n          \n          <div class=\"form-group\">\n            <label>Owner</label>\n            <input type=\"text\" placeholder=\"Tower Company LLC\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>FCC ID</label>\n            <input type=\"text\" placeholder=\"FCC-12345\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 GPS Coordinates</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Tower Rd\" />\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Country</label>\n            <input type=\"text\" placeholder=\"US\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Tower Contact (for tower/pole sites) -->\n      \n      \n      <!-- Building Contact (for building sites) -->\n      \n      \n      <!-- Site Contact (for all site types) -->\n      <div class=\"section\">\n        <h3>👷 On-Site Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Jane Smith\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Role</label>\n            <input type=\"text\" placeholder=\"Site Manager\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-5678\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"manager@site.com\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- General Contact (fallback) -->\n      <div class=\"section\">\n        <h3>📞 General Contact (Fallback)</h3>\n        <p class=\"help-text\">Used if no specific contact types are provided</p>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Contact Name\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-0000\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@example.com\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Access Information -->\n      <div class=\"section\">\n        <h3>🔐 Site Access</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Gate Code</label>\n            <input type=\"text\" placeholder=\"1234#\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Access Hours</label>\n            <input type=\"text\" placeholder=\"24/7 or Mon-Fri 8am-5pm\" />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Access Instructions</label>\n          <textarea \n            placeholder=\"Call 30 minutes before arrival. Gate code required. Enter through main gate.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Safety Notes</label>\n          <textarea \n            placeholder=\"High voltage equipment. PPE required. Confined space. Lockout/tagout required.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        \n      </button>\n    </div>\n  </div>\n</div></div>\n  \n  <!-- EPC Deployment Modal -->\n  \n  \n  <!-- Sector Deployment Modal -->\n  \n  \n  <!-- CPE/FWA Deployment Modal -->\n  \n  \n  <!-- Backhaul Deployment Modal -->\n  \n\n  <!-- Tips Modal -->\n  <div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"></div></div>";
}

@page GET "/modules/tenant-management"
page modules_tenant_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "tenant-management", apiPath: "/api/tenants", api_ok: true, api_surface: "wisp-api-native", api_resource: "tenants", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"tenant-management-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to Dashboard\n      </button>\n      <h1>🏢 Tenant Management</h1>\n      <p class=\"subtitle\">Manage all organizations and customer accounts</p>\n      <div class=\"admin-badge\">\n        <span>🔐</span>\n        <span>Platform Admin Access</span>\n      </div>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔑 CBRS Platform Keys\n      </button>\n      <button class=\"btn-primary\">\n        ➕ Create New Tenant\n      </button>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Create Tenant Form -->\n  \n\n  <!-- Tenants List -->\n  <div class=\"tenants-section\">\n    <h2>All Tenants (2)</h2>\n    \n    \n      <div class=\"tenants-grid\">\n        <div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <div class=\"tenant-icon\">🏢</div>\n              <div class=\"tenant-status\">\n                <span class=\"status-badge status-\">\n                  \n                </span>\n              </div>\n            </div>\n\n            <h3 class=\"tenant-name\"></h3>\n            <p class=\"tenant-id\"></p>\n\n            <div class=\"tenant-info\">\n              <div class=\"info-row\">\n                <span class=\"label\">Contact:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">CWMP URL:</span>\n                <span class=\"value url\"></span>\n              </div>\n            </div>\n\n            <div class=\"tenant-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Users</span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Devices</span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-small\">\n                ⚙️ Manage\n              </button>\n              <button class=\"btn-small\">\n                📊 Settings\n              </button>\n              <button class=\"btn-small btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div><div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <div class=\"tenant-icon\">🏢</div>\n              <div class=\"tenant-status\">\n                <span class=\"status-badge status-\">\n                  \n                </span>\n              </div>\n            </div>\n\n            <h3 class=\"tenant-name\"></h3>\n            <p class=\"tenant-id\"></p>\n\n            <div class=\"tenant-info\">\n              <div class=\"info-row\">\n                <span class=\"label\">Contact:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">CWMP URL:</span>\n                <span class=\"value url\"></span>\n              </div>\n            </div>\n\n            <div class=\"tenant-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Users</span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Devices</span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-small\">\n                ⚙️ Manage\n              </button>\n              <button class=\"btn-small\">\n                📊 Settings\n              </button>\n              <button class=\"btn-small btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div>\n      </div>\n    \n  </div>\n</div>\n\n<!-- Edit Tenant Modal -->\n\n\n<!-- Delete Confirmation Dialog -->\n";
}

