@page GET "/help"
page help_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/help" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"help\" data-wisp-path=\"/help\" data-cwl-island=\"client\"><div class=\"help-container\">\n  <div class=\"help-header\">\n    <button type=\"button\" class=\"help-back-link\" title=\"Back to main app\">← Back to main app</button>\n    <div class=\"help-header-brand\">\n      <div class=\"help-logo-section\">\n        <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"help-logo\" />\n        <div class=\"help-branding\">\n          <h1 class=\"help-app-title\">WISP Management</h1>\n          <p class=\"help-app-subtitle\">Documentation</p>\n        </div>\n      </div>\n    </div>\n    <p class=\"help-header-desc\">Complete guide to using the platform. Use the Help button in each module for context-specific tips.</p>\n    <p class=\"help-docs-link\"><a href=\"/docs\">Reference &amp; Project Status → /docs</a></p>\n  </div>\n  \n  <div class=\"help-layout\">\n    <aside class=\"help-sidebar\">\n      <nav>\n        <button\n            class=\"topic-btn\">\n            <span class=\"topic-title\"></span>\n          </button>\n      </nav>\n    </aside>\n    \n    <main class=\"help-content\">\n      <article>\n          <h2>Welcome to WISP Multitool</h2>\n          <p class=\"lead\">Your complete wireless ISP management platform.</p>\n          \n          <section>\n            <h3>What is WISP Multitool?</h3>\n            <p><strong>WISP Multitool</strong> is an all-in-one platform designed for wireless Internet service providers (WISPs) to manage every aspect of their operations:</p>\n            \n            <ul>\n              <li><strong>Network Planning</strong> - PCI resolution, CBRS spectrum, coverage mapping</li>\n              <li><strong>Field Operations</strong> - Mobile app for technicians, work orders, inventory</li>\n              <li><strong>Customer Support</strong> - Help desk ticketing, subscriber management</li>\n              <li><strong>Customers & Portal</strong> - Customer records, branded customer portal, billing, support tickets</li>\n              <li><strong>Device Management</strong> - ACS/TR-069 CPE management, HSS subscriber auth</li>\n              <li><strong>Team Management</strong> - Role-based access, user invitations, permissions</li>\n              <li><strong>Wizards & Quick Tips</strong> - Guided wizards (site deployment, subscribers, RMA, onboarding) and in-module help</li>\n            </ul>\n          </section>\n          \n          <section>\n            <h3>Platform Components</h3>\n            \n            <div class=\"component-grid\">\n              <div class=\"component-card\">\n                <div class=\"component-icon\">🌐</div>\n                <h4>Web Platform</h4>\n                <p>Browser-based management console for administrators, engineers, and support staff.</p>\n              </div>\n              \n              <div class=\"component-card\">\n                <div class=\"component-icon\">📱</div>\n                <h4>Mobile App</h4>\n                <p>Android app for field technicians with work orders, equipment scanning, and GPS navigation.</p>\n              </div>\n              \n              <div class=\"component-card\">\n                <div class=\"component-icon\">☁️</div>\n                <h4>Cloud Backend</h4>\n                <p>Scalable cloud backend for APIs, push notifications, and data storage.</p>\n              </div>\n            </div>\n          </section>\n          \n          <section>\n            <h3>Who Uses WISP Multitool?</h3>\n            \n            <div class=\"role-cards\">\n              <div class=\"role-card\">\n                <h4>🏢 Owner / Admin</h4>\n                <p>Manage users, configure system, view all modules, control organization settings.</p>\n              </div>\n              \n              <div class=\"role-card\">\n                <h4>👷 Network Engineer</h4>\n                <p>Plan network coverage, configure CBRS, manage HSS subscribers, optimize PCI.</p>\n              </div>\n              \n              <div class=\"role-card\">\n                <h4>🔧 Field Technician</h4>\n                <p>Use mobile app for work orders, equipment deployment, inventory checkout, site visits.</p>\n              </div>\n              \n              <div class=\"role-card\">\n                <h4>🎧 Help Desk</h4>\n                <p>Create support tickets, assist customers, lookup subscribers, troubleshoot CPE devices.</p>\n              </div>\n            </div>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🚀 Getting Started</h2>\n          \n          <section>\n            <h3>1. First Login</h3>\n            <ol>\n              <li>Navigate to the platform URL</li>\n              <li>Click <strong>\"Sign in with Google\"</strong></li>\n              <li>Authorize with your Google account</li>\n              <li>Select or create your organization (tenant)</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>2. Dashboard Overview</h3>\n            <p>After login, you'll see the main dashboard with module cards and a header with:</p>\n            <ul>\n              <li><strong>Docs</strong> (top right) - Opens this help page</li>\n              <li><strong>Settings</strong> - Theme (light/dark), branding, module access, tenant options</li>\n              <li><strong>Notifications</strong> - In-app and optional browser notifications (enable in the panel)</li>\n              <li><strong>Quick access</strong> dropdown - Jump to wizards (Plan, Deploy, CBRS, Customers, HSS, Inventory, etc.)</li>\n            </ul>\n            <p>Module cards include: <strong>PCI Resolution</strong>, <strong>CBRS Management</strong>, <strong>ACS CPE Management</strong>, <strong>HSS Management</strong>, <strong>Coverage Map</strong>, <strong>Inventory</strong>, <strong>Work Orders</strong>, <strong>Help Desk</strong>, <strong>Customers</strong>, <strong>User Management</strong>, and more.</p>\n            <p><em>Note: Available modules depend on your user role and tenant configuration. First-time visitors see quick tips (Field App, Docs, Quick access).</em></p>\n          </section>\n          \n          <section>\n            <h3>3. Inviting Team Members</h3>\n            <ol>\n              <li>Go to <strong>User Management</strong> module</li>\n              <li>Click <strong>\"Invite User\"</strong></li>\n              <li>Enter email address</li>\n              <li>Select role (Admin, Engineer, Installer, Help Desk, Viewer)</li>\n              <li>Click <strong>\"Send Invitation\"</strong></li>\n              <li>User receives email and can accept invitation</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>4. Mobile App Setup</h3>\n            <p><strong>For Field Technicians:</strong></p>\n            <ol>\n              <li>Install <strong>WISP Multitool</strong> APK on Android device</li>\n              <li>Open app and grant permissions (Camera, Location, Notifications)</li>\n              <li>Login with same Google account as web platform</li>\n              <li>Select your organization</li>\n              <li>Start receiving work orders!</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>👥 User Management</h2>\n          <p class=\"lead\">Manage your team members, roles, and permissions.</p>\n          \n          <section>\n            <h3>Inviting Users</h3>\n            <ol>\n              <li>Navigate to <code>/modules/user-management</code></li>\n              <li>Click <strong>\"Invite User\"</strong> button</li>\n              <li>Enter user's email address</li>\n              <li>Select appropriate role:\n                <ul>\n                  <li><strong>Admin</strong> - Can manage users and configure modules</li>\n                  <li><strong>Engineer</strong> - Access to technical/network modules</li>\n                  <li><strong>Field Technician</strong> - Mobile app and field operations</li>\n                  <li><strong>Help Desk</strong> - Customer support and ticketing</li>\n                  <li><strong>Viewer</strong> - Read-only access to reports</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Send Invitation\"</strong></li>\n            </ol>\n            <p class=\"tip\">💡 <strong>Tip:</strong> Invited users will appear with \"Pending\" status until they accept the invitation and login.</p>\n          </section>\n          \n          <section>\n            <h3>Editing User Roles</h3>\n            <ol>\n              <li>In User Management, click <strong>\"Edit\"</strong> next to a user</li>\n              <li>Select new role from dropdown</li>\n              <li>Click <strong>\"Update Role\"</strong></li>\n              <li>Changes take effect immediately</li>\n            </ol>\n            <p class=\"warning\">⚠️ <strong>Note:</strong> Owner role cannot be changed. Only one owner per organization.</p>\n          </section>\n          \n          <section>\n            <h3>Suspending Users</h3>\n            <p>Temporarily disable a user's access without removing them:</p>\n            <ol>\n              <li>Click <strong>\"Edit\"</strong> on the user</li>\n              <li>Click <strong>\"Suspend User\"</strong></li>\n              <li>User can still login but API calls will fail</li>\n              <li>To re-enable, click <strong>\"Activate User\"</strong></li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Removing Users</h3>\n            <ol>\n              <li>Click <strong>\"Edit\"</strong> on the user</li>\n              <li>Click <strong>\"Remove from Organization\"</strong></li>\n              <li>Confirm deletion</li>\n              <li>User is removed from tenant (cannot be undone)</li>\n            </ol>\n            <p class=\"warning\">⚠️ <strong>Warning:</strong> Cannot remove the owner. Transfer ownership first.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🎧 Help Desk Module</h2>\n          <p class=\"lead\">Customer support ticketing and equipment troubleshooting.</p>\n          \n          <section>\n            <h3>Creating Support Tickets</h3>\n            <ol>\n              <li>Go to <strong>Help Desk</strong> module</li>\n              <li>Click <strong>\"Create Ticket\"</strong></li>\n              <li>Enter ticket information:\n                <ul>\n                  <li><strong>Title</strong> - Brief description</li>\n                  <li><strong>Type</strong> - Troubleshoot, Repair, Installation, Other</li>\n                  <li><strong>Priority</strong> - Critical, High, Medium, Low</li>\n                  <li><strong>Description</strong> - Detailed issue description</li>\n                  <li><strong>Customer</strong> - Name and phone (optional)</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Create Ticket\"</strong></li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Assigning Tickets</h3>\n            <p>Help desk staff can assign tickets to field technicians:</p>\n            <ol>\n              <li>Click on a ticket card to open details</li>\n              <li>Click <strong>\"Assign\"</strong> button</li>\n              <li>Select field technician from dropdown</li>\n              <li>Technician receives push notification on mobile app</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Filtering Tickets</h3>\n            <p>Use filters to find specific tickets:</p>\n            <ul>\n              <li><strong>Status</strong> - Open, Assigned, In Progress, Resolved, Closed</li>\n              <li><strong>Priority</strong> - Critical, High, Medium, Low</li>\n              <li><strong>Search</strong> - Search by ticket number, title, or customer name</li>\n            </ul>\n          </section>\n          \n          <section>\n            <h3>Customer Lookup</h3>\n            <ol>\n              <li>Click <strong>\"Customer Lookup\"</strong> button</li>\n              <li>Search by phone, email, or IMSI</li>\n              <li>View customer information and service status</li>\n              <li>See active equipment and recent tickets</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🔐 User Roles & Permissions</h2>\n          <p class=\"lead\">Understanding the role-based access control system.</p>\n          \n          <section>\n            <h3>Role Hierarchy</h3>\n            \n            <div class=\"role-detail\">\n              <h4>🏢 Platform Admin</h4>\n              <p><strong>Who:</strong> System administrator (admin@wisptools.io)</p>\n              <p><strong>Access:</strong> ALL tenants, ALL modules, ALL permissions</p>\n              <p><strong>Can:</strong> Manage all tenants, create owners, override any permission</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>👑 Owner</h4>\n              <p><strong>Who:</strong> Organization creator</p>\n              <p><strong>Access:</strong> ALL modules in their tenant</p>\n              <p><strong>Can:</strong> Manage users, configure modules, full administrative control</p>\n              <p><strong>Cannot:</strong> Be changed or removed (permanent role)</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>⚙️ Admin</h4>\n              <p><strong>Who:</strong> Assistant administrators</p>\n              <p><strong>Access:</strong> Configurable module access</p>\n              <p><strong>Can:</strong> Manage users, configure permissions, access enabled modules</p>\n              <p><strong>Cannot:</strong> Change owner role, delete organization</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>👷 Engineer</h4>\n              <p><strong>Who:</strong> Network engineers</p>\n              <p><strong>Access:</strong> Technical modules only (PCI, CBRS, HSS, ACS, Distributed EPC)</p>\n              <p><strong>Can:</strong> Configure network, manage subscribers, view all work orders</p>\n              <p><strong>Cannot:</strong> Manage users, access help desk</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>🔧 Field Technician (Installer)</h4>\n              <p><strong>Who:</strong> Field workers</p>\n              <p><strong>Access:</strong> Mobile app, assigned work orders, inventory checkout</p>\n              <p><strong>Can:</strong> Deploy equipment, complete tickets, checkout inventory</p>\n              <p><strong>Cannot:</strong> View other techs' tickets, configure network</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>🎧 Help Desk</h4>\n              <p><strong>Who:</strong> Customer support staff</p>\n              <p><strong>Access:</strong> Help desk, work orders, ACS troubleshooting</p>\n              <p><strong>Can:</strong> Create tickets, assign to techs, troubleshoot CPE</p>\n              <p><strong>Cannot:</strong> Manage users, configure network</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>👁️ Viewer</h4>\n              <p><strong>Who:</strong> Read-only users, auditors</p>\n              <p><strong>Access:</strong> View-only access to all modules</p>\n              <p><strong>Can:</strong> View dashboards, reports, export data</p>\n              <p><strong>Cannot:</strong> Make any changes</p>\n            </div>\n          </section>\n          \n          <section>\n            <h3>Configuring Module Access</h3>\n            <ol>\n              <li>Go to <strong>Settings</strong> → <strong>Module Access</strong></li>\n              <li>See matrix of roles vs. modules</li>\n              <li>Check/uncheck boxes to enable/disable modules per role</li>\n              <li>Click <strong>\"Save Configuration\"</strong></li>\n              <li>Changes apply immediately to all users</li>\n            </ol>\n            <p class=\"tip\">💡 <strong>Tip:</strong> Use the reset button to restore default permissions for a role.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>Customers & Customer Portal</h2>\n          <p class=\"lead\">Customer records, branded portal, billing, and support tickets.</p>\n          \n          <section>\n            <h3>Customers Module</h3>\n            <p>Manage customer records with service type (4G/5G, FWA, WiFi, Fiber), LTE auth (IMSI, Ki, OPc), MAC address, and QoS. Use the <strong>Customer Onboarding</strong> wizard from Quick access or the Customers module for guided setup.</p>\n          </section>\n          \n          <section>\n            <h3>Customer Portal Setup</h3>\n            <p>Enable a branded customer portal so customers can sign in and access:</p>\n            <ul>\n              <li><strong>Dashboard</strong> - Overview and quick links</li>\n              <li><strong>Billing</strong> - View account and billing information</li>\n              <li><strong>Tickets</strong> - Open and track support tickets</li>\n              <li><strong>Knowledge base / FAQ</strong> - Self-service help</li>\n            </ul>\n            <p>Configure portal branding (logo, colors) and enable the portal in <strong>Customers → Portal setup</strong>. Use <strong>Settings</strong> for organization-wide branding if needed.</p>\n          </section>\n          \n          <section>\n            <h3>Billing</h3>\n            <p>Customer billing is available from the Customers module (billing modal per customer) and in the customer portal. Billing cycles and invoicing can be extended when prioritized.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>Wizards & Quick Actions</h2>\n          <p class=\"lead\">Guided flows and in-module quick tips.</p>\n          \n          <section>\n            <h3>Available Wizards</h3>\n            <p>Open wizards from the dashboard <strong>Quick access</strong> dropdown or from the <strong>Wizards</strong> page:</p>\n            <ul>\n              <li><strong>Site Deployment</strong> - Deploy and configure sites</li>\n              <li><strong>Subscriber Creation / Group / Bandwidth Plan</strong> - HSS subscriber management</li>\n              <li><strong>RMA Tracking</strong> - Inventory returns and tracking</li>\n              <li><strong>Customer Onboarding</strong> - Guided customer setup</li>\n              <li><strong>Device Onboarding / Registration</strong> - ACS and CBRS device registration</li>\n              <li><strong>Conflict Resolution</strong> - PCI conflict resolution</li>\n              <li><strong>Work Order Creation</strong> - Create work orders</li>\n              <li><strong>Troubleshooting (ACS)</strong> - CPE diagnostics and steps</li>\n              <li><strong>First-time / Organization / Initial Configuration</strong> - Setup and tenant wizards</li>\n            </ul>\n          </section>\n          \n          <section>\n            <h3>Quick Tips in Modules</h3>\n            <p>Each module can show a <strong>Help</strong> button that opens context-specific tips (e.g. Monitoring, Deploy, CBRS, Plan, Inventory). Use it for step-by-step guidance without leaving the module.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>📋 Work Orders & Field Operations</h2>\n          \n          <section>\n            <h3>Creating Work Orders</h3>\n            <ol>\n              <li>Go to <strong>Work Orders</strong> or <strong>Help Desk</strong> module</li>\n              <li>Click <strong>\"Create Work Order\"</strong></li>\n              <li>Fill in details:\n                <ul>\n                  <li><strong>Title</strong> - Brief description</li>\n                  <li><strong>Type</strong> - Installation, Repair, Maintenance, etc.</li>\n                  <li><strong>Priority</strong> - Critical to Low</li>\n                  <li><strong>Site</strong> - Affected tower site (optional)</li>\n                  <li><strong>Customer</strong> - Customer details (optional)</li>\n                  <li><strong>Description</strong> - Full details</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Create\"</strong></li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Assigning Work Orders</h3>\n            <ol>\n              <li>Open work order details</li>\n              <li>Click <strong>\"Assign\"</strong></li>\n              <li>Select field technician</li>\n              <li>Technician receives push notification on mobile app</li>\n              <li>Status changes to \"Assigned\"</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Mobile App Workflow</h3>\n            <p><strong>Field Technician receives notification:</strong></p>\n            <ol>\n              <li>Push notification appears on phone</li>\n              <li>Tap notification to open app</li>\n              <li>View work order details</li>\n              <li>Navigate to site using GPS</li>\n              <li>Complete work</li>\n              <li>Update status to \"Resolved\"</li>\n              <li>Add notes and photos</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🔧 Troubleshooting</h2>\n          \n          <section>\n            <h3>Common Issues</h3>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Can't see a module on dashboard</h4>\n              <p><strong>Cause:</strong> Module not enabled for your role</p>\n              <p><strong>Solution:</strong> Ask your administrator to enable the module in Settings → Module Access</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ API calls fail with 403 Forbidden</h4>\n              <p><strong>Cause:</strong> Insufficient permissions for the action</p>\n              <p><strong>Solution:</strong> Contact your administrator to update your role or permissions</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Mobile app not receiving notifications</h4>\n              <p><strong>Solutions:</strong></p>\n              <ul>\n                <li>Check app has notification permissions granted</li>\n                <li>Check user is logged in</li>\n                <li>Restart app to re-register FCM token</li>\n                <li>Check system notification settings</li>\n              </ul>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Browser notifications not showing</h4>\n              <p><strong>Solution:</strong> Open the <strong>Notifications</strong> panel (bell icon on dashboard), click <strong>Enable notifications</strong>, and allow when the browser prompts. Notifications then appear for new unread items.</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Want to change light/dark theme</h4>\n              <p><strong>Solution:</strong> Click the <strong>Settings</strong> (gear) icon on the dashboard header and choose theme in the settings modal.</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Work order not appearing in mobile app</h4>\n              <p><strong>Cause:</strong> Work order not assigned to your user</p>\n              <p><strong>Solution:</strong> Field technicians only see tickets assigned to them. Ask help desk to assign the ticket.</p>\n            </div>\n          </section>\n          \n          <section>\n            <h3>Getting Help</h3>\n            <p>If you encounter issues:</p>\n            <ol>\n              <li>Check this documentation first</li>\n              <li>Contact your organization administrator</li>\n              <li>Check browser console for errors (F12)</li>\n              <li>Clear browser cache and cookies</li>\n              <li>Try logging out and back in</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n    </main>\n  </div>\n</div></div>";
}

@page GET "/login"
page login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/login", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"login-page\" data-wisp-page=\"login\" data-cwl-island=\"client\">\n  <div class=\"login-container\">\n    <div class=\"login-brand\">\n      <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"brand-logo\" width=\"120\" height=\"120\" />\n      <h1>WISP Management</h1>\n    </div>\n    <div class=\"login-card\">\n      <h2>Sign in</h2>\n      <div class=\"demo-credentials-panel\" role=\"note\">\n        <p class=\"demo-credentials-title\">Demo login</p>\n        <p><strong>Email:</strong> demo@wisptools.io</p>\n        <p><strong>Password:</strong> WisptoolsDemo2026!</p>\n        <p class=\"demo-credentials-hint\">On management.wisptools.io uses Firebase Auth; on the GCE demo uses native CWL session.</p>\n      </div>\n      <p class=\"subtitle\">Use your email and password to access WISP Management.</p>\n      <div id=\"wisp-cwl-status\" class=\"wisp-status\" hidden aria-live=\"polite\"></div>\n      <form id=\"login-form\" autocomplete=\"on\">\n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input id=\"email\" name=\"email\" type=\"email\" value=\"demo@wisptools.io\" placeholder=\"you@example.com\" required />\n        </div>\n        <div class=\"form-group\">\n          <label for=\"password\">Password</label>\n          <input id=\"password\" name=\"password\" type=\"password\" placeholder=\"Enter your password\" required />\n        </div>\n        <button type=\"submit\" class=\"btn-primary\" id=\"sign-in\">Sign In</button>\n      </form>\n      <p class=\"form-footer simple-only-hint\">Access is managed by your administrator.</p>\n    </div>\n  </div>\n</div>";
}

@route POST "/login"
handler login_post {
  effects: session.write;
  use auth session;
  header X-Tenant-ID;
  body email;
  body password;
  return { ok: true, email: "demo@wisptools.io", surface: "wisp-auth-native" };
}

@route GET "/api/me"
handler session_me {
  effects: session.read;
  use auth session;
  return { ok: true, authenticated: true, email: "preview@wisptools.local", surface: "wisp-auth-native" };
}

@page GET "/modules"
page modules_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules\" data-wisp-path=\"/modules\" data-cwl-island=\"client\">\n\n<div class=\"redirect-message\">\n  Redirecting to dashboard...\n</div></div>";
}

@page GET "/modules/backend-management"
page modules_backend_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "backend-management", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "\n\n\n  <div class=\"access-denied\">\n    <div class=\"denied-icon\">🔒</div>\n    <h2>Access Denied</h2>\n    <p>This module is restricted to platform administrators only.</p>\n    <a href=\"/dashboard\" class=\"btn-primary\">← Back to Dashboard</a>\n  </div>";
}

@page GET "/modules/billing"
page modules_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/billing", apiPath: "/api/customer-billing", api_ok: true, api_surface: "wisp-api-native", api_resource: "customer-billing", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-billing\" data-wisp-path=\"/modules/billing\" data-cwl-island=\"client\"><div class=\"billing-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-content\">\n        <button class=\"back-btn\">\n          <span class=\"back-icon\">←</span>\n          Back to Dashboard\n        </button>\n        <div class=\"module-title\">\n          <h1>💳 Billing & Subscriptions</h1>\n          <p>Manage your subscription and billing information</p>\n        </div>\n        <div class=\"tenant-info\">\n          <span class=\"tenant-name\">Demo Tenant</span>\n            <span class=\"tenant-subdomain\">demo</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n      \n\n      \n        <!-- Current Subscription -->\n        <div class=\"current-subscription\">\n          <h2>Current Subscription</h2>\n          \n        </div>\n\n        <!-- Available Plans -->\n        <div class=\"plans-section\">\n          <h2>Available Plans</h2>\n          <div class=\"plans-grid\">\n            <div class=\"plan-card \">\n                \n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <li>✓ </li><li>✓ </li>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button \n                  class=\"select-plan-btn\">\n                  \n                </button>\n              </div><div class=\"plan-card \">\n                \n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <li>✓ </li><li>✓ </li><li>✓ </li>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button \n                  class=\"select-plan-btn\">\n                  \n                </button>\n              </div>\n          </div>\n        </div>\n\n        <!-- Payment Methods -->\n        <div class=\"payment-methods-section\">\n          <h2>Payment Methods</h2>\n          \n        </div>\n\n        <!-- Recent Invoices -->\n        <div class=\"invoices-section\">\n          <h2>Recent Invoices</h2>\n          \n        </div>\n      \n    </div>\n\n    <!-- Edit Payment Method Modal -->\n    \n  </div></div>";
}

@page GET "/modules/cbrs-management"
page modules_cbrs_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "cbrs-management", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- CBRS Setup Wizard -->\n\n<!-- CBRS Device Registration Wizard -->\n<div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"CBRSDeviceRegistrationWizard\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cbrs-module\">\n  <!-- Header -->\n  <div class=\"module-header\">\n    <div class=\"header-content\">\n      <div class=\"header-left\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          Back to Dashboard\n        </a>\n        <h1 class=\"module-title\">\n          <span class=\"module-icon\">📡</span>\n          CBRS Management\n        </h1>\n        <p class=\"module-description\">Citizens Broadband Radio Service spectrum management</p>\n        \n        <div class=\"tenant-badge\">\n            <span class=\"tenant-icon\">🏢</span>\n            <span class=\"tenant-text\">Demo Tenant</span>\n          </div>\n      </div>\n      \n      <div class=\"header-actions\">\n        \n        <button class=\"btn btn-secondary\" title=\"Configure SAS providers\">\n          ⚙️ Settings\n        </button>\n        <button class=\"btn btn-primary\">\n          + Add CBSD Device\n        </button>\n        <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n      </div>\n    </div>\n  </div>\n\n  \n  \n  <div class=\"error-banner\">\n      <span class=\"error-icon\">⚠️</span>\n      <span class=\"error-message\">\n        No tenant selected. Please return to the \n        <a href=\"/dashboard\" class=\"inline-link\">dashboard</a> \n        and select a tenant first.\n      </span>\n    </div>\n\n  <!-- Main Content -->\n  <div class=\"module-content\">\n    <!-- Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📡</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Total Devices</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">✅</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Registered</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📊</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Active Grants</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🌐</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"> MHz</div>\n          <div class=\"stat-label\">CBRS Band</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Map -->\n    <div class=\"map-section\">\n      <div class=\"map-header\">\n        <h3>CBSD Device Map</h3>\n        <div class=\"legend\">\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #10b981;\"></span>\n            <span>Active</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #3b82f6;\"></span>\n            <span>Registered</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #6b7280;\"></span>\n            <span>Unregistered</span>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"map-container\">\n        <div class=\"arcgis-map\"></div>\n        \n        \n      </div>\n    </div>\n\n    <!-- Device List and Grant Status -->\n    <div class=\"content-grid\">\n      <div class=\"device-list-section\">\n        <h3>CBSD Devices</h3>\n        <div data-cwl-component=\"DeviceList\" data-cwl-lifted-component=\"DeviceList\"><div class=\"device-list\">\n  <div class=\"list-header\">\n    <div class=\"search-section\">\n      <input\n        type=\"text\"\n        class=\"search-input\"\n        placeholder=\"Search devices...\"\n      />\n      <select class=\"filter-select\">\n        <option value=\"all\">All States</option>\n        <option value=\"UNREGISTERED\">Unregistered</option>\n        <option value=\"REGISTERED\">Registered</option>\n        <option value=\"GRANTED\">Granted</option>\n        <option value=\"AUTHORIZED\">Authorized</option>\n        <option value=\"SUSPENDED\">Suspended</option>\n        <option value=\"DEREGISTERED\">Deregistered</option>\n      </select>\n    </div>\n    <div class=\"device-count\">\n      1 device\n    </div>\n  </div>\n  \n  <div class=\"device-table-container\">\n    <table class=\"device-table\">\n      <thead>\n        <tr>\n          <th>Serial Number</th>\n          <th>FCC ID</th>\n          <th>Category</th>\n          <th>Provider</th>\n          <th>State</th>\n          <th>Active Grants</th>\n          <th>Location</th>\n          <th>Actions</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr class=\"device-row\">\n            <td class=\"serial-number\"></td>\n            <td class=\"fcc-id\"></td>\n            <td class=\"category\">\n              <span class=\"category-badge category-\">\n                \n              </span>\n            </td>\n            <td class=\"provider\">\n              <span class=\"provider-badge\">\n                \n              </span>\n            </td>\n            <td class=\"state\">\n              <span class=\"state-badge\" style=\"--state-color: \">\n                \n              </span>\n            </td>\n            <td class=\"grants\">\n              \n            </td>\n            <td class=\"location\">\n              📍 , \n            </td>\n            <td class=\"actions\" on:click|stopPropagation>\n              \n            </td>\n          </tr>\n      </tbody>\n    </table>\n    \n    \n  </div>\n</div></div>\n      </div>\n      \n      \n    </div>\n  </div>\n</div>\n\n<!-- Add Device Modal -->\n\n\n<!-- Grant Request Modal -->\n\n\n<!-- Settings Modal -->\n  <div data-cwl-component=\"SettingsModal\" data-cwl-lifted-component=\"SettingsModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content settings-modal\" on:click|stopPropagation>\n      <div class=\"modal-header\">\n        <h3>⚙️ CBRS Configuration</h3>\n        <button class=\"modal-close\">✕</button>\n      </div>\n      \n      <div class=\"modal-body\">\n        <form>\n          <!-- Info Banner -->\n          <div class=\"info-banner\">\n            <span class=\"info-icon\">ℹ️</span>\n            <div class=\"info-content\">\n              <strong>Optional Security Configuration</strong>\n              <p>Upload a PFX certificate for enhanced mTLS security with Google SAS. This is optional but recommended for production deployments.</p>\n            </div>\n          </div>\n          \n          <!-- PFX Certificate Section -->\n          <div class=\"form-section\">\n            <h4>🔒 Client Certificate (Optional)</h4>\n            \n            <div class=\"form-group\">\n              <label>PFX Certificate (.pfx or .p12)</label>\n              <input \n                type=\"file\" \n                accept=\".pfx,.p12\"\n                class=\"file-input\"\n              />\n              \n              <span class=\"form-hint\">\n                PFX/PKCS#12 file containing both certificate and private key\n              </span>\n            </div>\n            \n            <div class=\"form-group\">\n              <label>PFX Password</label>\n              <input \n                type=\"password\"\n                placeholder=\"Enter PFX password\"\n                autocomplete=\"off\"\n              />\n              <span class=\"form-hint\">\n                Password to decrypt the PFX certificate file\n              </span>\n            </div>\n          </div>\n          \n          <!-- Enhanced Features -->\n          <div class=\"form-section enhancement-section\">\n            <h4>Enhanced Features</h4>\n            \n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Advanced Analytics</span>\n              </label>\n              <p class=\"checkbox-hint\">Get detailed performance metrics and insights</p>\n            </div>\n            \n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Automated Optimization</span>\n              </label>\n              <p class=\"checkbox-hint\">Let SAS automatically optimize spectrum assignments</p>\n            </div>\n            \n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Multi-Site Coordination</span>\n              </label>\n              <p class=\"checkbox-hint\">Coordinate spectrum across multiple sites</p>\n            </div>\n            \n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Interference Monitoring</span>\n              </label>\n              <p class=\"checkbox-hint\">Real-time interference detection and alerts</p>\n            </div>\n          </div>\n          \n          <!-- Security Notice -->\n          <div class=\"security-notice\">\n            <div class=\"notice-icon\">🔒</div>\n            <div class=\"notice-content\">\n              <strong>Security:</strong> All certificates and passwords are encrypted and stored securely in Firestore.\n              Your configuration is isolated to your tenant account.\n            </div>\n          </div>\n          \n          <!-- Actions -->\n          <div class=\"form-actions\">\n            <button \n              type=\"button\" \n              class=\"btn btn-secondary\"\n            >\n              Cancel\n            </button>\n            <button \n              type=\"submit\" \n              class=\"btn btn-primary\"\n            >\n              \n                💾 Save Settings\n              \n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div></div>\n\n<!-- User ID / Network Selector Modal (includes Google login) -->\n<div data-cwl-component=\"UserIDSelector\" data-cwl-lifted-component=\"UserIDSelector\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\" on:click|stopPropagation>\n      <div class=\"modal-header\">\n        <h3>🆔 Select Network / Customer</h3>\n        <button class=\"modal-close\">✕</button>\n      </div>\n      \n      <div class=\"modal-body\">\n        \n        \n        \n      </div>\n    </div>\n  </div></div>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"help-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      \n      <div class=\"help-body\">\n        \n      </div>\n    </div>\n  </div></div>\n\n<!-- Quick Tips Modal -->\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"></div>";
}

@page GET "/modules/coverage-map"
page modules_coverage_map_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "coverage-map", apiPath: "/api/coverage", api_ok: true, itemCount: 1, tracedApiStatus: 200 };
  return html "<div class=\"fullscreen-map wisp-coverage-map\" data-wisp-page=\"coverage-map\" data-cwl-island=\"client\">\n  <!-- Full Screen Map -->\n  \n    <div class=\"coverage-map-container\" data-cwl-map-shell=\"CoverageMapView\"><div id=\"arcgis-map-view\" class=\"map-container\" role=\"application\" aria-label=\"Coverage map\"></div></div>\n  <div id=\"map-loading\" class=\"map-loading\" hidden>Loading map…</div>\n  \n\n  \n    <div\n      class=\"plan-draft-menu\"\n      style=\"left: px; top: px\"\n     hidden aria-hidden=\"true\">\n      <div class=\"menu-header\">\n        <strong></strong>\n        <small>Status: </small>\n      </div>\n      <div class=\"menu-body\">\n        <p>Drag the marker to refine this deployment location.</p>\n        <p class=\"coords\">\n          📍\n          ,\n          \n        </p>\n      </div>\n      <button class=\"menu-item\">\n        ✏️ Edit Draft Details\n      </button>\n      <button class=\"menu-item\">\n        📶 Add Sector\n      </button>\n      <button class=\"menu-item\">\n        🔗 Add Backhaul Link\n      </button>\n      <button class=\"menu-item\">\n        📦 Add Equipment\n      </button>\n      <div class=\"menu-divider\"></div>\n      <button class=\"menu-item deploy-hardware\">\n        📡 Deploy EPC/SNMP Server\n      </button>\n      <button class=\"menu-item\">\n        🔧 Deploy Other Hardware\n      </button>\n      <div class=\"menu-divider\"></div>\n      <button class=\"menu-item danger\">\n        🗑️ Remove From Plan\n      </button>\n      <button class=\"menu-item\">\n        ✕ Close\n      </button>\n    </div>\n  \n\n  <!-- Floating Control Panel -->\n  <div class=\"floating-controls\">\n    <button class=\"control-btn\" title=\"Toggle Filters\">\n        🔍\n      </button>\n    <button class=\"control-btn\" title=\"Toggle Statistics\">\n        📊\n      </button>\n    <button \n      class=\"control-btn\" \n      title=\"Device Management (SNMP, TR-069, MikroTik, EPC)\"\n    >\n      📱\n    </button>\n    \n    <!-- Map Type Toggle -->\n    <div class=\"control-group\">\n      <button class=\"control-btn map-control-btn\" title=\"Toggle Map Type\">\n        🗺️\n      </button>\n      <div class=\"control-dropdown\">\n        <div class=\"dropdown-section\">\n          <div class=\"dropdown-label\">Map View</div>\n          <div class=\"basemap-switcher-inline\">\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Streets\"\n            >\n              🛣️\n            </button>\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Satellite\"\n            >\n              🛰️\n            </button>\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Topographic\"\n            >\n              🗺️\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Help Button - Fixed Position -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n  \n\n\n\n  <!-- Filters Modal -->\n  \n  <div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content filters-modal\">\n      <div class=\"modal-header\">\n        <h3>🔍 Map Filters</h3>\n        <button class=\"close-btn\">✕</button>\n      </div>\n      <div class=\"modal-body\">\n        <div data-cwl-component=\"FilterPanel\" data-cwl-lifted-component=\"FilterPanel\"><div class=\"filter-panel\">\n  <h3>🔍 Map Filters</h3>\n  \n  <!-- Asset Type Filters -->\n  <div class=\"filter-section\">\n    <button \n      class=\"section-header\"\n    >\n      <h4>Asset Types</h4>\n      \n    </button>\n    <div class=\"filter-options\">\n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\"\n        />\n        <span class=\"filter-icon\">📡</span>\n        <span>Tower Sites</span>\n      </label>\n      \n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\"\n        />\n        <span class=\"filter-icon\">📶</span>\n        <span>Sectors</span>\n      </label>\n      \n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\"\n        />\n        <span class=\"filter-icon\">📱</span>\n        <span>CPE Devices</span>\n      </label>\n      \n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\"\n        />\n        <span class=\"filter-icon\">📍</span>\n        <span>Marketing Leads</span>\n      </label>\n      \n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\"\n        />\n        <span class=\"filter-icon\">🔧</span>\n        <span>Equipment</span>\n      </label>\n      \n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\"\n        />\n        <span class=\"filter-icon\">🔗</span>\n        <span>Backhaul Links</span>\n      </label>\n    </div>\n  </div>\n  \n  <!-- Backhaul Type Filters -->\n  <div class=\"filter-section\" hidden aria-hidden=\"true\">\n      <button \n        class=\"section-header\"\n      >\n        <h4>Backhaul Types</h4>\n        \n      </button>\n      <div class=\"filter-options\">\n        <label class=\"filter-checkbox\">\n          <input \n            type=\"checkbox\"\n          />\n          <span class=\"filter-icon\">🌐</span>\n          <span>Fiber</span>\n        </label>\n        \n        <label class=\"filter-checkbox\">\n          <input \n            type=\"checkbox\"\n          />\n          <span class=\"filter-icon\">📡</span>\n          <span>Licensed Wireless</span>\n        </label>\n        \n        <label class=\"filter-checkbox\">\n          <input \n            type=\"checkbox\"\n          />\n          <span class=\"filter-icon\">📻</span>\n          <span>Unlicensed Wireless</span>\n        </label>\n      </div>\n    </div>\n  \n  <!-- Band/Technology Filters -->\n  <div class=\"filter-section\">\n    <div\n      class=\"section-header\"\n      role=\"button\"\n      tabindex=\"0\"\n      }}\n    >\n      <div class=\"filter-header\">\n        <h4>Bands / Technology</h4>\n        <div class=\"filter-actions\">\n            <button class=\"btn-link\">All</button>\n            <button class=\"btn-link\">None</button>\n          </div>\n      </div>\n      \n    </div>\n    <div class=\"filter-options\">\n      \n      \n    </div>\n    <p class=\"filter-note\">\n      \n    </p>\n  </div>\n  \n  <!-- Status Filters -->\n  <div class=\"filter-section\">\n    <button \n      class=\"section-header\"\n    >\n      <h4>Status</h4>\n      \n    </button>\n    <div class=\"filter-options\">\n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\" else \n            dispatch('change', filters);\n          }}\n        />\n        <span class=\"status-dot active\"></span>\n        <span>Active</span>\n      </label>\n      \n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\" else \n            dispatch('change', filters);\n          }}\n        />\n        <span class=\"status-dot inactive\"></span>\n        <span>Inactive</span>\n      </label>\n      \n      <label class=\"filter-checkbox\">\n        <input \n          type=\"checkbox\" else \n            dispatch('change', filters);\n          }}\n        />\n        <span class=\"status-dot maintenance\"></span>\n        <span>Maintenance</span>\n      </label>\n    </div>\n  </div>\n</div></div>\n      </div>\n    </div>\n  </div>\n  \n\n  <!-- Statistics Modal -->\n  \n  <div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content stats-modal\">\n      <div class=\"modal-header\">\n        <h3>📊 Network Statistics</h3>\n        <button class=\"close-btn\">✕</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"stats-grid\">\n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">📡</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\"></div>\n              <div class=\"stat-label\">Tower Sites</div>\n            </div>\n          </div>\n          \n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">📶</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\"></div>\n              <div class=\"stat-label\">Sectors</div>\n            </div>\n          </div>\n          \n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">📱</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\">2</div>\n              <div class=\"stat-label\">CPE Devices</div>\n            </div>\n          </div>\n          \n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">🔧</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\"></div>\n              <div class=\"stat-label\">Equipment</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n\n  <!-- Messages -->\n  \n  \n  \n</div>\n\n<!-- Unified Device Management -->\n<div data-cwl-component=\"DeviceManagementPanel\" data-cwl-lifted-component=\"DeviceManagementPanel\"><div class=\"device-panel\" hidden aria-hidden=\"true\">\n    <div class=\"panel-header\">\n      <h2>Device Management</h2>\n      <button class=\"close-button\" aria-label=\"Close\">×</button>\n    </div>\n    \n    <div class=\"panel-controls\">\n      <!-- Search -->\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"Search devices...\"\n          class=\"search-input\"\n        />\n      </div>\n      \n      <!-- Filters -->\n      <div class=\"filters\">\n        <select class=\"filter-select\">\n          <option value=\"all\">All Types</option>\n          <option value=\"snmp\">SNMP</option>\n          <option value=\"mikrotik\">MikroTik</option>\n          <option value=\"epc\">EPC</option>\n          <option value=\"network-equipment\">Network Equipment</option>\n        </select>\n        \n        <select class=\"filter-select\">\n          <option value=\"all\">All Status</option>\n          <option value=\"online\">Online</option>\n          <option value=\"offline\">Offline</option>\n        </select>\n        \n        <button class=\"refresh-button\" title=\"Refresh\">\n          🔄\n        </button>\n      </div>\n    </div>\n    \n    <div class=\"panel-body\">\n      \n        <div class=\"devices-list\">\n          \n            \n            \n            \n            <div \n              class=\"device-card\">\n              <div class=\"device-header\">\n                <span class=\"device-icon\"></span>\n                <div class=\"device-info\">\n                  <h3 class=\"device-name\"></h3>\n                  <div class=\"device-meta\">\n                    <span class=\"device-type-badge\"></span>\n                    <span class=\"status-badge \"></span>\n                  </div>\n                </div>\n              </div>\n              \n              <div class=\"device-details\">\n                \n                \n                \n                \n                \n              </div>\n            </div>\n        </div>\n      \n    </div>\n    \n    <div class=\"panel-footer\">\n      <div class=\"device-count\">\n        1 device\n      </div>\n    </div>\n  </div></div>\n\n<div data-cwl-component=\"UnifiedDeviceDetailsModal\" data-cwl-lifted-component=\"UnifiedDeviceDetailsModal\"></div>\n\n<!-- Modals -->\n<div data-cwl-component=\"AddSiteModal\" data-cwl-lifted-component=\"AddSiteModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📡 Add Tower Site</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Find Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter address to search...\"\n          />\n          <button \n            class=\"btn-secondary\"\n          >\n            Search\n          </button>\n        </div>\n        <p class=\"help-text\">Or enter GPS coordinates below</p>\n      </div>\n      \n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Site Name *</label>\n            <input type=\"text\" placeholder=\"Main Tower Site\" required />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Type</label>\n          <select>\n            <option value=\"tower\">📡 Tower</option>\n            <option value=\"noc\">🖥️ NOC (Network Operations Center)</option>\n            <option value=\"warehouse\">🏭 Warehouse / Storage</option>\n            <option value=\"other\">📍 Other Site</option>\n          </select>\n          </div>\n          \n          \n          \n          <div class=\"form-group\">\n            <label>FCC ID</label>\n            <input type=\"text\" placeholder=\"FCC-12345\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 GPS Coordinates</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Tower Rd\" />\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Tower-Specific Sections (only for actual towers) -->\n      \n      \n      <!-- General Notes (for all types) -->\n      <div class=\"section\">\n        <h3>📝 Additional Notes</h3>\n        <div class=\"form-group\">\n          <label>Notes</label>\n          <textarea\n            placeholder=\"General notes about this location...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Create Site\n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddNOCModal\" data-cwl-lifted-component=\"AddNOCModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🏢 Add NOC (Network Operations Center)</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-group\">\n          <label>NOC Name *</label>\n          <input type=\"text\" placeholder=\"Main NOC\" required />\n        </div>\n      </div>\n      \n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 Location</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Data Center Dr\" />\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Contact Info -->\n      <div class=\"section\">\n        <h3>👤 NOC Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Contact Name</label>\n            <input type=\"text\" placeholder=\"NOC Manager\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"noc@company.com\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Notes -->\n      <div class=\"section\">\n        <h3>📝 Notes</h3>\n        <div class=\"form-group\">\n          <textarea \n            placeholder=\"Building access, parking, special instructions...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Create NOC\n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddWarehouseModal\" data-cwl-lifted-component=\"AddWarehouseModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🏭 Add Warehouse / Storage Location</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>Warehouse Name *</label>\n        <input type=\"text\" placeholder=\"Main Warehouse\" required />\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Latitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Longitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n      </div>\n      \n      <div class=\"form-group\">\n        <label>Address</label>\n        <input type=\"text\" placeholder=\"456 Storage Ave\" />\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>City</label>\n          <input type=\"text\" />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>State</label>\n          <input type=\"text\" />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>ZIP</label>\n          <input type=\"text\" />\n        </div>\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Contact Name</label>\n          <input type=\"text\" />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Phone</label>\n          <input type=\"tel\" />\n        </div>\n      </div>\n      \n      <div class=\"form-group\">\n        <label>Notes</label>\n        <textarea rows=\"2\" placeholder=\"Access instructions, hours, etc.\"></textarea>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Create Warehouse\n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddVehicleModal\" data-cwl-lifted-component=\"AddVehicleModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🚚 Add Service Vehicle</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>Vehicle Name *</label>\n        <input type=\"text\" placeholder=\"Service Truck #1\" required />\n      </div>\n      \n      <div class=\"form-group\">\n        <label>Vehicle Number</label>\n        <input type=\"text\" placeholder=\"VEH-001\" />\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Current Latitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Current Longitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Driver Name</label>\n          <input type=\"text\" placeholder=\"John Doe\" />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Driver Phone</label>\n          <input type=\"tel\" placeholder=\"555-1234\" />\n        </div>\n      </div>\n      \n      <div class=\"form-group\">\n        <label>Notes</label>\n        <textarea rows=\"2\" placeholder=\"Mobile inventory location\"></textarea>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Add Vehicle\n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddRMAModal\" data-cwl-lifted-component=\"AddRMAModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔧 Add RMA / Repair Center</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>RMA Center Name *</label>\n        <input type=\"text\" placeholder=\"Repair Center\" required />\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Latitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Longitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n      </div>\n      \n      <div class=\"form-group\">\n        <label>Address</label>\n        <input type=\"text\" placeholder=\"789 Repair Blvd\" />\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>City</label>\n          <input type=\"text\" />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>State</label>\n          <input type=\"text\" />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>ZIP</label>\n          <input type=\"text\" />\n        </div>\n      </div>\n      \n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Contact Name</label>\n          <input type=\"text\" />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Phone</label>\n          <input type=\"tel\" />\n        </div>\n      </div>\n      \n      <div class=\"form-group\">\n        <label>Notes</label>\n        <textarea rows=\"2\" placeholder=\"RMA procedures, shipping address...\"></textarea>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Create RMA Center\n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddSectorModal\" data-cwl-lifted-component=\"AddSectorModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📶 Add Sector</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Site Selection -->\n      <div class=\"section\">\n        <h3>📡 Tower Site</h3>\n        <div class=\"form-group\">\n          <label>Select Site *</label>\n          <select>\n            <option>-- Select a tower site --</option>\n            \n          </select>\n          \n          \n        </div>\n      </div>\n      \n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Sector Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Sector Name *</label>\n            <input type=\"text\" placeholder=\"Alpha Sector\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Technology *</label>\n            <select>\n              <option value=\"LTE\">LTE</option>\n              <option value=\"CBRS\">CBRS</option>\n              <option value=\"FWA\">Fixed Wireless (FWA)</option>\n              <option value=\"5G\">5G NR</option>\n              <option value=\"WiFi\">WiFi</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">Active</option>\n              <option value=\"inactive\">Inactive</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"planned\">Planned</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <!-- RF Configuration -->\n      <div class=\"section\">\n        <h3>📡 RF Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Azimuth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">0° = North, 90° = East, 180° = South, 270° = West</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Beamwidth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">Typical: 65° (LTE), 90° (CBRS), 30° (FWA)</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Mechanical Tilt (degrees)</label>\n            <input type=\"number\" min=\"-90\" max=\"90\" />\n            <p class=\"help-text\">Downtilt angle (negative = down)</p>\n          </div>\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Band / Frequency Name</label>\n            <input type=\"text\" placeholder=\"Band 71 (600MHz)\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Center Frequency (MHz)</label>\n            <input type=\"number\" placeholder=\"617\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Bandwidth (MHz)</label>\n            <input type=\"number\" placeholder=\"10\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Equipment -->\n      <div class=\"section\">\n        <h3>📻 Equipment Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Antenna Manufacturer</label>\n            <input type=\"text\" placeholder=\"Commscope\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Antenna Model</label>\n            <input type=\"text\" placeholder=\"SBNHH-1D65C\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Antenna Serial Number</label>\n            <input type=\"text\" placeholder=\"SN123456\" />\n          </div>\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Radio Manufacturer</label>\n            <input type=\"text\" placeholder=\"Nokia\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Radio Model</label>\n            <input type=\"text\" placeholder=\"AEQE\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Radio Serial Number</label>\n            <input type=\"text\" placeholder=\"RN789012\" />\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button \n        class=\"btn-primary\");\n          e.preventDefault();\n          e.stopPropagation();\n          handleSave();\n        }}\n      >\n        \n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddCPEModal\" data-cwl-lifted-component=\"AddCPEModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📱 Add CPE Device</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Customer Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter customer address...\"\n          />\n          <button class=\"btn-secondary\">\n            Search\n          </button>\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Address</label>\n          <input type=\"text\" placeholder=\"123 Main St, City, State\" />\n        </div>\n      </div>\n      \n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Equipment Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Device Name *</label>\n            <input type=\"text\" placeholder=\"Smith Residence FWA\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Manufacturer *</label>\n            <input type=\"text\" placeholder=\"Telrad\" />\n          </div>\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Model *</label>\n            <input type=\"text\" placeholder=\"CPE7000\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Serial Number *</label>\n            <input type=\"text\" placeholder=\"CPE-123456\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>MAC Address</label>\n            <input type=\"text\" placeholder=\"00:11:22:33:44:55\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Installation -->\n      <div class=\"section\">\n        <h3>📡 Installation Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Pointing Azimuth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">Direction CPE antenna is pointed</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Beamwidth (degrees)</label>\n            <input type=\"number\" />\n            <p class=\"help-text\">Default: 30° for FWA CPE</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Height Above Ground (feet)</label>\n            <input type=\"number\" placeholder=\"25\" />\n          </div>\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Technology</label>\n            <select>\n              <option value=\"FWA\">Fixed Wireless (FWA)</option>\n              <option value=\"LTE\">LTE</option>\n              <option value=\"CBRS\">CBRS</option>\n              <option value=\"5G\">5G NR</option>\n              <option value=\"WiFi\">WiFi</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Band / Frequency</label>\n            <input type=\"text\" placeholder=\"5GHz\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Connected to Site</label>\n            <select>\n              <option>None / Unknown</option>\n              \n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Subscriber Info -->\n      <div class=\"section\">\n        <h3>👤 Subscriber Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Subscriber Name</label>\n            <input type=\"text\" placeholder=\"John Smith\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"customer@example.com\" />\n          </div>\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Account Number</label>\n            <input type=\"text\" placeholder=\"ACCT-1001\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Service Type</label>\n            <select>\n              <option value=\"residential\">Residential</option>\n              <option value=\"business\">Business</option>\n              <option value=\"temporary\">Temporary</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"online\">Online</option>\n              <option value=\"offline\">Offline</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"inventory\">Inventory</option>\n            </select>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Create CPE\n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddBackhaulLinkModal\" data-cwl-lifted-component=\"AddBackhaulLinkModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔗 Add Backhaul Link</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"warning-banner\">\n        ⚠️ Need at least 2 sites to create backhaul. Add more tower sites or NOC first.\n      </div>\n    \n    <div class=\"modal-body\">\n      <!-- Link Endpoints -->\n      <div class=\"section\">\n        <h3>🔗 Link Endpoints</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>From Site (A) *</label>\n            <select>\n              <option>-- Select site --</option>\n              \n            </select>\n            \n          </div>\n          \n          <div class=\"form-group\">\n            <label>To Site (B) *</label>\n            <select>\n              <option>-- Select site --</option>\n              \n            </select>\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Link Name *</label>\n          <input \n            type=\"text\" \n            placeholder=\"↔\"\n          />\n        </div>\n      </div>\n      \n      <!-- Backhaul Type -->\n      <div class=\"section\">\n        <h3>📡 Backhaul Type</h3>\n        <div class=\"form-group\">\n          <select>\n            <option value=\"fiber\">🌐 Fiber Optic</option>\n            <option value=\"fixed-wireless-licensed\">📡 Fixed Wireless (Licensed Spectrum)</option>\n            <option value=\"fixed-wireless-unlicensed\">📡 Fixed Wireless (Unlicensed WiFi/60GHz)</option>\n          </select>\n        </div>\n      </div>\n      \n      <!-- Wireless Configuration -->\n      \n      \n      <!-- Fiber Configuration -->\n      \n      \n      <!-- Common Fields -->\n      \n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        \n      </button>\n    </div>\n  </div>\n</div></div>\n\n<div data-cwl-component=\"AddInventoryModal\" data-cwl-lifted-component=\"AddInventoryModal\"></div>\n\n<!-- Context Menus -->\n<div data-cwl-component=\"MapContextMenu\" data-cwl-lifted-component=\"MapContextMenu\"></div>\n\n<div data-cwl-component=\"TowerActionsMenu\" data-cwl-lifted-component=\"TowerActionsMenu\"></div>\n\n<div data-cwl-component=\"SectorActionsMenu\" data-cwl-lifted-component=\"SectorActionsMenu\"></div>\n\n<div data-cwl-component=\"BackhaulActionsMenu\" data-cwl-lifted-component=\"BackhaulActionsMenu\"></div>\n\n<!-- EPC Deployment Modal -->\n<div data-cwl-component=\"EPCDeploymentModal\" data-cwl-lifted-component=\"EPCDeploymentModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content epc-deployment-modal\">\n      <div class=\"modal-header\">\n        <h2>🚀 Server Deployment</h2>\n        <button class=\"close-btn\">✕</button>\n      </div>\n\n      \n\n      \n\n      <div class=\"modal-body\">\n        <!-- Step Progress Indicator -->\n        <div class=\"step-indicator\">\n          \n        </div>\n\n        <!-- Step Content -->\n        <div class=\"step-content\">\n          <!-- Step 1: Deployment Type -->\n          \n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"modal-actions\">\n          \n          \n          \n        </div>\n      </div>\n    </div>\n  </div></div>\n\n<!-- HSS Registration Modal -->\n<div data-cwl-component=\"HSSRegistrationModal\" data-cwl-lifted-component=\"HSSRegistrationModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content hss-registration-modal\">\n      <div class=\"modal-header\">\n        <h2>🏠 Register Site with HSS</h2>\n        <button class=\"close-btn\">✕</button>\n      </div>\n\n      \n\n      \n\n      <div class=\"modal-body\">\n        <div class=\"registration-form\">\n          <div class=\"form-section\">\n            <h4>📍 Site Information</h4>\n            <div class=\"form-group\">\n              <label for=\"siteName\">Site Name *</label>\n              <input \n                id=\"siteName\" \n                type=\"text\" \n                placeholder=\"Enter site name\"\n                required\n              />\n            </div>\n            <div class=\"form-group\">\n              <label for=\"siteId\">Site ID</label>\n              <input \n                id=\"siteId\" \n                type=\"text\" \n                placeholder=\"Auto-generated from site\"\n                readonly\n              />\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>🌐 Network Configuration</h4>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"mcc\">MCC *</label>\n                <input \n                  id=\"mcc\" \n                  type=\"text\" \n                  placeholder=\"001\"\n                  required\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"mnc\">MNC *</label>\n                <input \n                  id=\"mnc\" \n                  type=\"text\" \n                  placeholder=\"01\"\n                  required\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"tac\">TAC *</label>\n                <input \n                  id=\"tac\" \n                  type=\"text\" \n                  placeholder=\"1\"\n                  required\n                />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>📍 Location</h4>\n            <div class=\"form-group\">\n              <label for=\"address\">Address *</label>\n              <input \n                id=\"address\" \n                type=\"text\" \n                placeholder=\"Enter address\"\n                required\n              />\n            </div>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"city\">City</label>\n                <input \n                  id=\"city\" \n                  type=\"text\" \n                  placeholder=\"Enter city\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"state\">State</label>\n                <input \n                  id=\"state\" \n                  type=\"text\" \n                  placeholder=\"Enter state\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"country\">Country</label>\n                <input \n                  id=\"country\" \n                  type=\"text\" \n                  placeholder=\"Enter country\"\n                />\n              </div>\n            </div>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"latitude\">Latitude</label>\n                <input \n                  id=\"latitude\" \n                  type=\"number\" \n                  step=\"0.000001\" \n                  placeholder=\"0.000000\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"longitude\">Longitude</label>\n                <input \n                  id=\"longitude\" \n                  type=\"number\" \n                  step=\"0.000001\" \n                  placeholder=\"0.000000\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>📞 Contact Information</h4>\n            <div class=\"form-group\">\n              <label for=\"contactName\">Contact Name *</label>\n              <input \n                id=\"contactName\" \n                type=\"text\" \n                placeholder=\"Enter contact name\"\n                required\n              />\n            </div>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"contactEmail\">Email *</label>\n                <input \n                  id=\"contactEmail\" \n                  type=\"email\" \n                  placeholder=\"Enter email\"\n                  required\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"contactPhone\">Phone</label>\n                <input \n                  id=\"contactPhone\" \n                  type=\"tel\" \n                  placeholder=\"Enter phone\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>🏠 HSS Configuration</h4>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"hssHost\">HSS Host</label>\n                <input \n                  id=\"hssHost\" \n                  type=\"text\" \n                  placeholder=\"HSS host\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"hssPort\">HSS Port</label>\n                <input \n                  id=\"hssPort\" \n                  type=\"text\" \n                  placeholder=\"3868\"\n                />\n              </div>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"diameterRealm\">Diameter Realm</label>\n              <input \n                id=\"diameterRealm\" \n                type=\"text\" \n                placeholder=\"example.com\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Registration Info -->\n        <div class=\"registration-info\">\n          <h4>ℹ️ Registration Information</h4>\n          <p>This will register the site with the HSS (Home Subscriber Server) to enable:</p>\n          <ul>\n            <li>Subscriber authentication and authorization</li>\n            <li>Network access control</li>\n            <li>QoS management</li>\n            <li>Billing and usage tracking</li>\n            <li>MME connection management</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- Navigation -->\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\">\n          Cancel\n        </button>\n        <button \n          class=\"btn-primary\"\n        >\n          \n            🏠 Register with HSS\n          \n        </button>\n      </div>\n    </div>\n  </div></div>\n\n<!-- Hardware Deployment Modal -->\n<div data-cwl-component=\"HardwareDeploymentModal\" data-cwl-lifted-component=\"HardwareDeploymentModal\"></div>\n\n<!-- Help Modal -->\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"></div>\n\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"help-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      \n      <div class=\"help-body\">\n        \n      </div>\n    </div>\n  </div></div>\n\n<!-- Site Edit Modal -->\n<div data-cwl-component=\"SiteEditModal\" data-cwl-lifted-component=\"SiteEditModal\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>\n        \n      </h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Find Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter address to search...\"\n          />\n          <button \n            class=\"btn-secondary\"\n          >\n            Search\n          </button>\n        </div>\n        <p class=\"help-text\">Or enter GPS coordinates below</p>\n      </div>\n      \n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Site Name *</label>\n            <input type=\"text\" placeholder=\"Main Tower Site\" required />\n          </div>\n          \n          <div class=\"form-group\" style=\"grid-column: 1 / -1;\">\n            <label>Site Types * (Select all that apply)</label>\n            <div class=\"type-checkboxes\">\n              \n            </div>\n            <p class=\"help-text\">Small operators can select multiple types (e.g., NOC + Tower, HQ + NOC)</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">✅ Active</option>\n              <option value=\"inactive\">❌ Inactive</option>\n              <option value=\"maintenance\">🔧 Maintenance</option>\n              <option value=\"planned\">📅 Planned</option>\n            </select>\n          </div>\n          \n          \n          \n          <div class=\"form-group\">\n            <label>Owner</label>\n            <input type=\"text\" placeholder=\"Tower Company LLC\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>FCC ID</label>\n            <input type=\"text\" placeholder=\"FCC-12345\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 GPS Coordinates</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Tower Rd\" />\n        </div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Country</label>\n            <input type=\"text\" placeholder=\"US\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Tower Contact (for tower/pole sites) -->\n      \n      \n      <!-- Building Contact (for building sites) -->\n      \n      \n      <!-- Site Contact (for all site types) -->\n      <div class=\"section\">\n        <h3>👷 On-Site Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Jane Smith\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Role</label>\n            <input type=\"text\" placeholder=\"Site Manager\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-5678\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"manager@site.com\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- General Contact (fallback) -->\n      <div class=\"section\">\n        <h3>📞 General Contact (Fallback)</h3>\n        <p class=\"help-text\">Used if no specific contact types are provided</p>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Contact Name\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-0000\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@example.com\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Access Information -->\n      <div class=\"section\">\n        <h3>🔐 Site Access</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Gate Code</label>\n            <input type=\"text\" placeholder=\"1234#\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Access Hours</label>\n            <input type=\"text\" placeholder=\"24/7 or Mon-Fri 8am-5pm\" />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Access Instructions</label>\n          <textarea \n            placeholder=\"Call 30 minutes before arrival. Gate code required. Enter through main gate.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Safety Notes</label>\n          <textarea \n            placeholder=\"High voltage equipment. PPE required. Confined space. Lockout/tagout required.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        \n      </button>\n    </div>\n  </div>\n</div></div>\n\n<!-- Global Settings Button - Removed from modules -->\n<div data-cwl-component=\"AddBackhaulModal\" data-cwl-lifted-component=\"AddBackhaulModal\" data-cwl-orphan-modal=\"1\"><div class=\"modal-overlay\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔗 Add Backhaul Link</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Site Selection -->\n      <div class=\"section\">\n        <h3>📡 Tower Site</h3>\n        <div class=\"form-group\">\n          <label>Select Site *</label>\n          <select>\n            <option>-- Select a tower site --</option>\n            \n          </select>\n        </div>\n      </div>\n      \n      <!-- Backhaul Type -->\n      <div class=\"section\">\n        <h3>🔗 Backhaul Type</h3>\n        <div class=\"form-group\">\n          <label>Type *</label>\n          <select>\n            <option value=\"fiber\">🌐 Fiber Optic</option>\n            <option value=\"fixed-wireless-licensed\">📡 Fixed Wireless (Licensed Spectrum)</option>\n            <option value=\"fixed-wireless-unlicensed\">📡 Fixed Wireless (Unlicensed - WiFi/60GHz)</option>\n          </select>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Link Name *</label>\n          <input type=\"text\" placeholder=\"Main Fiber Link\" />\n        </div>\n      </div>\n      \n      <!-- Fiber Specific Fields -->\n      \n      \n      <!-- Fixed Wireless Specific Fields -->\n      \n      \n      <!-- Common Fields -->\n      <div class=\"section\">\n        <h3>⚙️ Link Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Link Capacity (Mbps) *</label>\n            <input type=\"number\" placeholder=\"1000\" />\n            <p class=\"help-text\">Expected/guaranteed throughput</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Connects to (Upstream Site)</label>\n            <select>\n              <option>-- Select upstream site --</option>\n              \n            </select>\n            <p class=\"help-text\">Network topology - which site this connects to</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">Active</option>\n              <option value=\"inactive\">Inactive</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"planned\">Planned</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Equipment Details -->\n      <div class=\"section\">\n        <h3>🔧 Equipment Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Equipment Manufacturer</label>\n            <input \n              type=\"text\" \n            />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Equipment Model</label>\n            <input \n              type=\"text\" \n            />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Serial Number</label>\n            <input type=\"text\" placeholder=\"SN-123456789\" />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Install Date</label>\n          <input type=\"date\" />\n        </div>\n      </div>\n      \n      <!-- Financial/Contract -->\n      <div class=\"section\">\n        <h3>💰 Financial Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Monthly Recurring Cost ($)</label>\n            <input type=\"number\" />\n            <p class=\"help-text\">Maintenance/licensing costs</p>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Contract Term (months)</label>\n            <input type=\"number\" placeholder=\"12\" />\n            <p class=\"help-text\">Length of service agreement</p>\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Notes</label>\n          <textarea \n            placeholder=\"Installation notes, special requirements, escalation contacts...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Create Backhaul\n      </button>\n    </div>\n  </div>\n</div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div \n    class=\"auth-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"auth-modal\" \n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          \n        </h2>\n        <button class=\"close-btn\">×</button>\n      </div>\n      \n      <div class=\"auth-body\">\n        \n        \n        \n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/customers"
page modules_customers_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "customers", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"customers-page\">\n    <div class=\"page-header\">\n      <div class=\"header-content\">\n        <div class=\"header-top\">\n          <button class=\"back-btn\" title=\"Back to Module Manager\">\n            ←\n          </button>\n          <h1>👥 Customer Management</h1>\n        </div>\n        <p class=\"subtitle\">Manage your tenant's customers, service plans, and customer groups</p>\n      </div>\n      <div class=\"header-actions\">\n        <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n          <button class=\"btn-primary\">\n            ➕ Add Customer\n          </button>\n      </div>\n    </div>\n    \n    <!-- Navigation Tabs -->\n    <div class=\"tabs\">\n      <button\n      >\n        👥 Customers\n      </button>\n      <button\n      >\n        📡 Service Plans\n      </button>\n      <button\n      >\n        📦 Customer Groups\n      </button>\n      <button\n      >\n        🌐 Portal\n      </button>\n    </div>\n    \n    \n    \n    \n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      <!-- Customers Tab -->\n        <!-- Stats Cards -->\n        <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">3</div>\n        <div class=\"stat-label\">Total Customers</div>\n      </div>\n      <div class=\"stat-card stat-active\">\n        <div class=\"stat-value\">2</div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card stat-pending\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Pending</div>\n      </div>\n      <div class=\"stat-card stat-suspended\">\n        <div class=\"stat-value\">0</div>\n        <div class=\"stat-label\">Suspended</div>\n      </div>\n    </div>\n    \n    <!-- Search and Filters -->\n    <div class=\"filters-section\">\n      <div class=\"search-bar\">\n        <input\n          type=\"text\"\n          placeholder=\"Search by name, phone, email, or customer ID...\"\n          class=\"search-input\"\n        />\n      </div>\n      \n      <div class=\"filter-controls\">\n        <select>\n          <option>All Statuses</option>\n          <option value=\"active\">Active</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"suspended\">Suspended</option>\n          <option value=\"cancelled\">Cancelled</option>\n          <option value=\"trial\">Trial</option>\n        </select>\n        \n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" />\n          Show Inactive\n        </label>\n      </div>\n    </div>\n    \n    <!-- Customer List -->\n    <div class=\"customers-list\">\n      \n        <div class=\"customer-grid\">\n          <div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> $`}</h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n                  \n                </span>\n              </div>\n              \n              <div class=\"customer-details\">\n                \n                \n                <div class=\"detail-row\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n                \n                \n                \n                \n                \n                \n                \n                \n              </div>\n              \n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a \n                  href=\"/modules/customers/portal/login\" \n                  target=\"_blank\" \n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div><div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> $`}</h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n                  \n                </span>\n              </div>\n              \n              <div class=\"customer-details\">\n                \n                \n                <div class=\"detail-row\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n                \n                \n                \n                \n                \n                \n                \n                \n              </div>\n              \n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a \n                  href=\"/modules/customers/portal/login\" \n                  target=\"_blank\" \n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div><div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> $`}</h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n                  \n                </span>\n              </div>\n              \n              <div class=\"customer-details\">\n                \n                \n                <div class=\"detail-row\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n                \n                \n                \n                \n                \n                \n                \n                \n              </div>\n              \n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a \n                  href=\"/modules/customers/portal/login\" \n                  target=\"_blank\" \n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div>\n        </div>\n      \n    </div>\n      \n        <!-- Service Plans Tab -->\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"BandwidthPlans\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>p1</td><td>active</td></tr><tr><td>p2</td><td>active</td></tr></tbody></table></div>\n      \n        <!-- Customer Groups Tab -->\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"GroupManagement\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>c1</td><td>active</td></tr><tr><td>c2</td><td>pending</td></tr><tr><td>c3</td><td>active</td></tr></tbody></table></div>\n    </div>\n  </div>\n  \n  \n  \n  \n\n  <div data-cwl-component=\"CustomerOnboardingWizard\" data-cwl-lifted-component=\"CustomerOnboardingWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n\n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div></div>\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\" data-cwl-orphan-modal=\"1\"><div class=\"help-overlay\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      \n      <div class=\"help-body\">\n        \n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"></div>\n<div data-cwl-component=\"CustomerBillingModal\" data-cwl-lifted-component=\"CustomerBillingModal\" data-cwl-orphan-modal=\"1\"><div class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" hidden aria-hidden=\"true\">\n    <div class=\"modal\" on:click|stopPropagation>\n      <div class=\"modal-header\">\n        <h2>Billing – </h2>\n        <button type=\"button\" class=\"close-btn\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"modal-body\">\n        \n      </div>\n      <div class=\"modal-footer\">\n        <button type=\"button\" class=\"btn-secondary\">Cancel</button>\n        <button type=\"button\" class=\"btn-primary\">Save</button>\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div \n    class=\"auth-overlay\" \n    role=\"presentation\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"auth-modal\" \n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n      on:click|stopPropagation\n      on:keydown|stopPropagation\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          \n        </h2>\n        <button class=\"close-btn\">×</button>\n      </div>\n      \n      <div class=\"auth-body\">\n        \n        \n        \n      </div>\n    </div>\n  </div></div>";
}

