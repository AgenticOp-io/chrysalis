# Chrysalis Web Language — hub emit from svelte
module hub;

@page GET "/"
page root_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"auth-redirect\" data-wisp-path=\"/\"><div class=\"loading-page\"><div class=\"spinner\"></div><p>Checking authentication...</p></div><script>(function(){function go(p){location.replace(p);}try{var a=window.firebase&&firebase.auth&&firebase.auth();if(a&&a.onAuthStateChanged){a.onAuthStateChanged(function(u){go(u?\"/dashboard\":\"/login\");});return;}var u=localStorage.getItem(\"firebase:authUser\")||sessionStorage.getItem(\"wisp-demo-user\")||localStorage.getItem(\"wisp-customer-session\")||sessionStorage.getItem(\"wisp-customer-session\");go(u?\"/dashboard\":\"/login\");}catch(e){go(\"/login\");}})();</script><noscript><a href=\"/login\">Continue to login</a></noscript></div>";
}

@page GET "/admin/billing"
page admin_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/admin/billing" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"admin-billing\" data-wisp-path=\"/admin/billing\" data-cwl-island=\"client\"><div class=\"billing-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div data-cwl-component=\"AdminBreadcrumb\" data-cwl-lifted-component=\"AdminBreadcrumb\"><nav class=\"breadcrumb\">\n  <ol class=\"breadcrumb-list\">\n    <!-- Home/Admin Management link -->\n    <li class=\"breadcrumb-item\">\n      <a\n        class=\"breadcrumb-link\" data-cwl-action=\"handleClick\" data-cwl-action-args=\"homeItem.path\"\n      >\n        <span class=\"breadcrumb-icon\">⚙️</span>\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"homeItem.label\"></span>\n      </a>\n    </li>\n\n    <!-- Additional breadcrumb items -->\n    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"items as item, index\"><li class=\"breadcrumb-separator\">/</li>\n      <li class=\"breadcrumb-item\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"item.path && index < items.length - 1\"><a class=\"breadcrumb-link\" data-cwl-action=\"handleClick\" data-cwl-action-args=\"item.path\"\n          >\n\n          </a></div>\n          <span class=\"breadcrumb-current\"></span>\n\n      </li></div>\n  </ol>\n</nav></div>\n      <div class=\"header-content\">\n        <div class=\"module-title\">\n          <h1>💳 Billing Management</h1>\n          <p>Manage subscriptions, payments, and billing analytics</p>\n        </div>\n        <div class=\"user-info\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentUser\"><span class=\"user-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentUser.email\"></span></span>\n            <span class=\"user-role\">Platform Admin</span></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n\n        <div class=\"error-banner\" hidden aria-hidden=\"true\">\n          <p>⚠️ </p>\n          <button class=\"retry-btn\" data-cwl-action=\"loadBillingData\" aria-label=\"Load Billing Data\">Retry</button>\n        </div>\n\n      <!-- Billing Analytics -->\n      <div class=\"analytics-section\">\n        <h2>Billing Analytics</h2>\n        <div class=\"analytics-grid\">\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">💰</div>\n            <div class=\"analytics-info\">\n              <h4>Total Revenue</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(analytics.totalRevenue)\"></span></p>\n            </div>\n          </div>\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📈</div>\n            <div class=\"analytics-info\">\n              <h4>Monthly Recurring Revenue</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(analytics.monthlyRecurringRevenue)\"></span></p>\n            </div>\n          </div>\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">👥</div>\n            <div class=\"analytics-info\">\n              <h4>Active Subscriptions</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"analytics.activeSubscriptions\"></span></p>\n            </div>\n          </div>\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📊</div>\n            <div class=\"analytics-info\">\n              <h4>Average Revenue Per User</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(analytics.averageRevenuePerUser)\"></span></p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Subscription Plans -->\n      <div class=\"plans-section\">\n        <h2>Subscription Plans</h2>\n        <div class=\"plans-grid\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"plans as plan\" data-cwl-each-item=\"plan\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-card%20%7Bplan.isPopular%20%3F%20'popular'%20%3A%20''%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20plan.isPopular%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22popular-badge%22%3EMost%20Popular%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bplan.name%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-price%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22price%22%3E%7BformatCurrency(plan.price)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22interval%22%3E%2F%7Bplan.interval%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22plan-description%22%3E%7Bplan.description%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cul%20class%3D%22plan-features%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20plan.features%20as%20feature%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%E2%9C%93%20%7Bfeature%7D%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ful%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-limits%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EUp%20to%20%7Bplan.maxUsers%7D%20users%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20plan.maxTenants%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EUp%20to%20%7Bplan.maxTenants%7D%20tenants%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20\"><div class=\"plan-card \">\n\n                <div class=\"popular-badge\" hidden aria-hidden=\"true\">Most Popular</div>\n\n              <div class=\"plan-header\">\n                <h3></h3>\n                <div class=\"plan-price\">\n                  <span class=\"price\"></span>\n                  <span class=\"interval\">/</span>\n                </div>\n              </div>\n              <p class=\"plan-description\"></p>\n              <ul class=\"plan-features\">\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"plan.features as feature\"><li>✓ </li></div>\n              </ul>\n              <div class=\"plan-limits\">\n                <span>Up to  users</span>\n\n                  <div hidden aria-hidden=\"true\"><span>Up to  tenants</span>\n                </div>\n              </div>\n            </div></div>\n        </div>\n      </div>\n\n      <!-- Failed Payment Alerts -->\n\n        <div class=\"alerts-section\">\n          <h2>⚠️ Failed Payment Alerts</h2>\n          <div class=\"failed-payments-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"getFailedPayments() as invoice\"><div class=\"alert-card alert-error\">\n                <div class=\"alert-icon\">⚠️</div>\n                <div class=\"alert-content\">\n                  <strong>Failed Payment</strong>\n                  <p>Tenant: </p>\n                  <p>Amount:  </p>\n                  <p>Invoice ID: </p>\n                  <p class=\"alert-date\">Date: </p>\n                </div>\n              </div></div>\n          </div>\n        </div>\n\n      <!-- Payment History Section -->\n      <div class=\"payments-section\">\n        <h2>💳 Payment History</h2>\n\n          <div class=\"payments-table\">\n            <div class=\"table-header\">\n              <div class=\"col-invoice\">Invoice ID</div>\n              <div class=\"col-tenant\">Tenant</div>\n              <div class=\"col-amount\">Amount</div>\n              <div class=\"col-status\">Status</div>\n              <div class=\"col-date\">Date</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"invoices as invoice\" data-cwl-each-item=\"invoice\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22table-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-invoice%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22invoice-id%22%3E%7Binvoice.id%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-tenant%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22tenant-name%22%3E%7BgetTenantName(invoice.tenantId)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-amount%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22amount%22%3E%7BformatCurrency(invoice.amount)%7D%20%7Binvoice.currency%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-status%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7BgetStatusBadgeClass(invoice.status)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Binvoice.status%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-date%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22date%22%3E%7BformatDate(invoice.createdAt)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20invoice.paidAt%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22paid-date%22%3EPaid%3A%20%7BformatDate(invoice.paidAt)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"table-row\">\n                <div class=\"col-invoice\">\n                  <span class=\"invoice-id\"></span>\n                </div>\n                <div class=\"col-tenant\">\n                  <span class=\"tenant-name\"></span>\n                </div>\n                <div class=\"col-amount\">\n                  <span class=\"amount\"> </span>\n                </div>\n                <div class=\"col-status\">\n                  <span class=\"badge \">\n\n                  </span>\n                </div>\n                <div class=\"col-date\">\n                  <span class=\"date\"></span>\n\n                    <div hidden aria-hidden=\"true\"><span class=\"paid-date\">Paid: </span>\n                  </div>\n                </div>\n              </div></div>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No payment transactions found</p>\n          </div>\n\n      </div>\n\n      <!-- Payment Methods Section -->\n      <div class=\"payment-methods-section\">\n        <h2>💳 Payment Methods & Billing Details</h2>\n\n          <div class=\"payment-methods-grid\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"paymentMethods as method\" data-cwl-each-item=\"method\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22payment-method-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22method-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22method-type%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22method-icon%22%3E%F0%9F%92%B3%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bmethod.type%20%3D%3D%3D%20'paypal'%20%3F%20'PayPal'%20%3A%20'Credit%20Card'%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20method.isDefault%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22default-badge%22%3EDefault%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22method-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%3E%3Cstrong%3ETenant%3A%3C%2Fstrong%3E%20%7BgetTenantName(method.tenantId)%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%3E%3Cstrong%3EEmail%3A%3C%2Fstrong%3E%20%7Bmethod.paypalEmail%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%3E%3Cstrong%3EAdded%3A%3C%2Fstrong%3E%20%7BformatDate(method.createdAt)%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"payment-method-card\">\n                <div class=\"method-header\">\n                  <div class=\"method-type\">\n                    <span class=\"method-icon\">💳</span>\n                    <strong></strong>\n                  </div>\n\n                    <div hidden aria-hidden=\"true\"><span class=\"default-badge\">Default</span>\n                  </div>\n                </div>\n                <div class=\"method-details\">\n                  <p><strong>Tenant:</strong> </p>\n                  <p><strong>Email:</strong> </p>\n                  <p><strong>Added:</strong> </p>\n                </div>\n              </div></div>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No payment methods found</p>\n          </div>\n\n      </div>\n\n      <!-- Active Subscriptions -->\n      <div class=\"subscriptions-section\">\n        <h2>Active Subscriptions</h2>\n\n          <div class=\"subscriptions-table\">\n            <div class=\"table-header\">\n              <div class=\"col-tenant\">Tenant</div>\n              <div class=\"col-plan\">Plan</div>\n              <div class=\"col-status\">Status</div>\n              <div class=\"col-period\">Current Period</div>\n              <div class=\"col-actions\">Actions</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"subscriptions as subscription\" data-cwl-each-item=\"subscription\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22table-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-tenant%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22tenant-name%22%3E%7Bsubscription.tenantId%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-plan%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22plan-name%22%3E%7Bsubscription.planId%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-status%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7BgetStatusBadgeClass(subscription.status)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bsubscription.status%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-period%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22period-dates%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatDate(subscription.currentPeriodStart)%7D%20-%20%7BformatDate(subscription.currentPeriodEnd)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%22%20data-cwl-nav%3D%22%2Fadmin%2Fbilling%2Fsubscription%2F%7Bsubscription.id%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20View%20Details%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"table-row\">\n                <div class=\"col-tenant\">\n                  <span class=\"tenant-name\"></span>\n                </div>\n                <div class=\"col-plan\">\n                  <span class=\"plan-name\"></span>\n                </div>\n                <div class=\"col-status\">\n                  <span class=\"badge \">\n\n                  </span>\n                </div>\n                <div class=\"col-period\">\n                  <span class=\"period-dates\">\n                     -\n                  </span>\n                </div>\n                <div class=\"col-actions\">\n                  <button class=\"action-btn\">\n                    View Details\n                  </button>\n                </div>\n              </div></div>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No subscriptions found</p>\n          </div>\n\n      </div>\n      </div>\n    </div></div>";
}

@page GET "/admin/management"
page admin_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/admin/management" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"admin-management\" data-wisp-path=\"/admin/management\" data-cwl-island=\"client\"><div class=\"admin-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-content\">\n        <div class=\"module-title\">\n          <h1>⚙️ Admin Management</h1>\n          <p>User and tenant management for owners and administrators</p>\n        </div>\n        <div class=\"user-info\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentUser\"><span class=\"user-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentUser.email\"></span></span>\n            <span class=\"user-role\">Platform Admin</span>\n            <button class=\"logout-btn\" data-cwl-action=\"handleLogout\" title=\"Logout\">\n              🚪 Logout\n            </button></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n      <!-- Overview -->\n      <div class=\"overview-section\">\n        <h2>Administration Overview</h2>\n        <p>The Admin Management module provides comprehensive tools for managing users, tenants, system settings, and billing. This module is only accessible to platform owners and administrators.</p>\n      </div>\n\n      <!-- Features Grid -->\n      <div class=\"features-section\">\n        <h2>Administration Features</h2>\n        <div class=\"features-grid\">\n\n            <div\n              class=\"feature-card\" data-cwl-action=\"handleFeatureClick\" data-cwl-action-args=\"feature\" data-cwl-on-keydown=\"action:handleFeatureClick\" data-cwl-on-keydown-args=\"feature\"\n              role=\"button\"\n              tabindex=\"0\"\n            >\n              <div class=\"feature-icon\">🏢</div>\n              <div class=\"feature-info\">\n                <h3 class=\"feature-name\">Tenant Management</h3>\n                <p class=\"feature-description\">Create, configure, and manage organization tenants</p>\n              </div>\n              <div class=\"feature-arrow\">→</div>\n            </div>\n\n            <div\n              class=\"feature-card\" data-cwl-action=\"handleFeatureClick\" data-cwl-action-args=\"feature\" data-cwl-on-keydown=\"action:handleFeatureClick\" data-cwl-on-keydown-args=\"feature\"\n              role=\"button\"\n              tabindex=\"0\"\n            >\n              <div class=\"feature-icon\">⚙️</div>\n              <div class=\"feature-info\">\n                <h3 class=\"feature-name\">System Settings</h3>\n                <p class=\"feature-description\">Configure system-wide settings and preferences</p>\n              </div>\n              <div class=\"feature-arrow\">→</div>\n            </div>\n\n        </div>\n      </div>\n\n      <!-- System Status -->\n      <div class=\"system-status\">\n        <h2>System Status</h2>\n\n        <div class=\"status-grid\">\n          <div class=\"status-card\">\n            <div class=\"status-icon\">\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"systemStatus.health === 'operational'\">🟢</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"systemStatus.health === 'error'\">🔴</div>\n                🟡\n\n            </div>\n            <div class=\"status-info\">\n              <h4>System Health</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemStatus.healthMessage\"></span></p>\n            </div>\n          </div>\n          <div class=\"status-card\">\n            <div class=\"status-icon\">📊</div>\n            <div class=\"status-info\">\n              <h4>Active Tenants</h4>\n              <p>\n\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemStatus.activeTenants\"></span> tenant<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemStatus.activeTenants !== 1 ? 's' : ''\"></span> active\n\n              </p>\n            </div>\n          </div>\n          <div class=\"status-card\">\n            <div class=\"status-icon\">👥</div>\n            <div class=\"status-info\">\n              <h4>Total Users</h4>\n              <p>\n\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemStatus.totalUsers\"></span> users across all tenants\n\n              </p>\n            </div>\n          </div>\n          <div class=\"status-card\">\n            <div class=\"status-icon\">\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"systemStatus.databaseStatus === 'connected'\">💾</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"systemStatus.databaseStatus === 'error'\">⚠️</div>\n                🔄\n\n            </div>\n            <div class=\"status-info\">\n              <h4>Database</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemStatus.databaseMessage\"></span></p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Remote Agents Status Section -->\n      <div class=\"remote-agents-section\">\n        <div class=\"section-header\">\n          <h2>📡 Remote Agents Status</h2>\n          <button class=\"refresh-btn\" data-cwl-action=\"loadAllRemoteAgents\" data-cwl-attr-disabled=\"loadingAgents\" aria-label=\"Load All Remote Agents\">\n            🔄 Refresh\n          </button>\n        </div>\n\n          <div class=\"agents-summary\">\n            <p><strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"remoteAgents.length\"></span></strong> remote agent<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"remoteAgents.length !== 1 ? 's' : ''\"></span> checking in system-wide</p>\n          </div>\n          <div class=\"agents-table-container\">\n            <table class=\"agents-table\">\n              <thead>\n                <tr>\n                  <th>Tenant</th>\n                  <th>Type</th>\n                  <th>ID</th>\n                  <th>Name/Code</th>\n                  <th>First Check-in</th>\n                  <th>Last Check-in</th>\n                  <th>Status</th>\n                  <th>Hardware Linked</th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"remoteAgents as agent (agent.epc_id || agent.device_id)\" data-cwl-each-item=\"agent\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bagent.tenant_name%20%7C%7C%20agent.tenant_id%20%7C%7C%20'Unknown'%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22agent-type-badge%20type-%7Bagent.type%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%3F%20'EPC'%20%3A%20'SNMP'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccode%3E%7Bagent.epc_id%20%7C%7C%20agent.device_id%20%7C%7C%20'N%2FA'%7D%3C%2Fcode%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3F%20(agent.device_code%20%7C%7C%20agent.site_name%20%7C%7C%20'N%2FA')%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3A%20(agent.name%20%7C%7C%20agent.ip_address%20%7C%7C%20'N%2FA')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7BgetFirstCheckin(agent)%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3F%20(agent.last_checkin%20%3F%20formatDate(agent.last_checkin)%20%3A%20'Never')%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3A%20(agent.discovered_at%20%3F%20formatDate(agent.discovered_at)%20%3A%20'N%2FA')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20agent.time_since_checkin%20!%3D%3D%20null%20%26%26%20agent.time_since_checkin%20!%3D%3D%20undefined%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csmall%20class%3D%22time-ago%22%3E%7BformatTimeAgo(agent.time_since_checkin)%7D%3C%2Fsmall%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-%7Bagent.checkin_status%20%7C%7C%20agent.status%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3F%20(agent.checkin_status%20%7C%7C%20agent.status%20%7C%7C%20'unknown')%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3A%20(agent.status%20%7C%7C%20'discovered')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20agent.hardware_linked%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22linked-badge%20linked%22%3E%E2%9C%93%20Linked%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20agent.hardware_link_type%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbr%3E%3Csmall%3E(%7Bagent.hardware_link_type%7D)%3C%2Fsmall%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22linked-badge%20unlinked%22%3E%E2%9C%97%20Unlinked%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                    <td>\n                      <strong></strong>\n                    </td>\n                    <td>\n                      <span class=\"agent-type-badge type-\">\n\n                      </span>\n                    </td>\n                    <td>\n                      <code></code>\n                    </td>\n                    <td>\n\n                    </td>\n                    <td></td>\n                    <td>\n\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"agent.time_since_checkin !== null && agent.time_since_checkin !== undefined\"><br>\n                        <small class=\"time-ago\"></small></div>\n                    </td>\n                    <td>\n                      <span class=\"status-badge status-\">\n\n                      </span>\n                    </td>\n                    <td>\n\n                        <span class=\"linked-badge unlinked\">✗ Unlinked</span>\n\n                        <div hidden aria-hidden=\"true\"><span class=\"linked-badge linked\">✓ Linked</span>\n\n                          <div hidden aria-hidden=\"true\"><br><small>()</small>\n                        </div>\n                      </div>\n                    </td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No remote agents found across all tenants.</p>\n          </div>\n\n          <div class=\"loading-state\" hidden aria-hidden=\"true\">\n            <p>Loading remote agents...</p>\n          </div>\n\n      </div>\n      </div>\n    </div></div>";
}

@page GET "/admin/system-management"
page admin_system_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/admin/system-management" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"admin-system-management\" data-wisp-path=\"/admin/system-management\" data-cwl-island=\"client\"><div class=\"system-admin-page\">\n    <div data-cwl-component=\"AdminBreadcrumb\" data-cwl-lifted-component=\"AdminBreadcrumb\"><nav class=\"breadcrumb\">\n  <ol class=\"breadcrumb-list\">\n    <!-- Home/Admin Management link -->\n    <li class=\"breadcrumb-item\">\n      <a\n        class=\"breadcrumb-link\" data-cwl-action=\"handleClick\" data-cwl-action-args=\"homeItem.path\"\n      >\n        <span class=\"breadcrumb-icon\">⚙️</span>\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"homeItem.label\"></span>\n      </a>\n    </li>\n\n    <!-- Additional breadcrumb items -->\n    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"items as item, index\"><li class=\"breadcrumb-separator\">/</li>\n      <li class=\"breadcrumb-item\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"item.path && index < items.length - 1\"><a class=\"breadcrumb-link\" data-cwl-action=\"handleClick\" data-cwl-action-args=\"item.path\"\n          >\n\n          </a></div>\n          <span class=\"breadcrumb-current\"></span>\n\n      </li></div>\n  </ol>\n</nav></div>\n    <div class=\"admin-header\">\n      <h1>🔧 System Administration</h1>\n      <p>Manage all tenants and system settings</p>\n    </div>\n\n      <div class=\"success-message\" hidden aria-hidden=\"true\">\n        <span class=\"success-icon\">✅</span>\n\n      </div>\n\n      <div class=\"error-message\" hidden aria-hidden=\"true\">\n        <span class=\"error-icon\">⚠️</span>\n\n      </div>\n\n      <div class=\"loading\" hidden aria-hidden=\"true\">\n        <p>Loading tenants...</p>\n      </div>\n\n    <div class=\"admin-content\">\n      <div class=\"tenants-list\">\n        <h2>All Tenants (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenants.length\"></span>)</h2>\n\n          <div class=\"tenants-table\">\n            <table>\n              <thead>\n                <tr>\n                  <th>Organization</th>\n                  <th>Subdomain</th>\n                  <th>Contact Email</th>\n                  <th>Users</th>\n                  <th>Status</th>\n                  <th>Created</th>\n                  <th>Actions</th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"tenants as tenant (tenant.id)\" data-cwl-each-item=\"tenant\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%20class%3Aselected%3D%7BselectedTenant%3F.id%20%3D%3D%3D%20tenant.id%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Btenant.displayName%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csmall%3E%7Btenant.name%7D%3C%2Fsmall%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Btenant.subdomain%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Btenant.contactEmail%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Btenant.userCount%20%7C%7C%200%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-%7Btenant.status%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Btenant.status%20%7C%7C%20'active'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7BformatDate(tenant.createdAt)%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn%20btn-sm%20btn-secondary%22%20data-cwl-action%3D%22selectTenant%22%20data-cwl-action-args%3D%22tenant%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22View%20Details%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20View%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn%20btn-sm%20btn-warning%22%20data-cwl-action%3D%22suspendTenant%22%20data-cwl-action-args%3D%22tenant%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7BisLoading%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%7Btenant.status%20%3D%3D%3D%20'suspended'%20%3F%20'Activate%20Tenant'%20%3A%20'Suspend%20Tenant'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Btenant.status%20%3D%3D%3D%20'suspended'%20%3F%20'Activate'%20%3A%20'Suspend'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn%20btn-sm%20btn-danger%22%20data-cwl-action%3D%22showDeleteDialog%22%20data-cwl-action-args%3D%22tenant%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7BisLoading%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Delete%20Tenant%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Delete%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                    <td>\n                      <strong></strong>\n                      <br>\n                      <small></small>\n                    </td>\n                    <td></td>\n                    <td></td>\n                    <td></td>\n                    <td>\n                      <span class=\"status-badge status-\">\n\n                      </span>\n                    </td>\n                    <td></td>\n                    <td class=\"actions\">\n            <button\n              class=\"btn btn-sm btn-secondary\" data-cwl-action=\"selectTenant\" data-cwl-action-args=\"tenant\"\n              title=\"View Details\"\n            >\n              View\n            </button>\n                      <button\n                        class=\"btn btn-sm btn-warning\" data-cwl-action=\"suspendTenant\" data-cwl-action-args=\"tenant\" aria-label=\"Suspend Tenant\">\n\n                      </button>\n                      <button\n                        class=\"btn btn-sm btn-danger\" data-cwl-action=\"showDeleteDialog\" data-cwl-action-args=\"tenant\" title=\"Delete Tenant\"\n                      >\n                        Delete\n                      </button>\n                    </td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No tenants found.</p>\n          </div>\n\n      </div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTenant\"><div class=\"tenant-details\">\n          <h2>Tenant Details</h2>\n          <div class=\"details-card\">\n            <div class=\"detail-row\">\n              <strong>Organization Name:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.name\"></span></span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>Display Name:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.displayName\"></span></span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>Subdomain:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.subdomain\"></span></span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>Contact Email:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.contactEmail\"></span></span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>CWMP URL:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.cwmpUrl\"></span></span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>Status:</strong>\n              <span class=\"status-badge status-\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.status || 'active'\"></span>\n              </span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>User Count:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.userCount || 0\"></span></span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>Created:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDate(selectedTenant.createdAt)\"></span></span>\n            </div>\n            <div class=\"detail-row\">\n              <strong>Last Updated:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDate(selectedTenant.updatedAt)\"></span></span>\n            </div>\n          </div>\n\n          <div class=\"details-actions\">\n            <button\n              class=\"btn btn-warning\" data-cwl-action=\"suspendTenant\" data-cwl-action-args=\"selectedTenant!\" data-cwl-attr-disabled=\"isLoading\"\n             aria-label=\"Suspend Tenant\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.status === 'suspended' ? 'Activate Tenant' : 'Suspend Tenant'\"></span>\n            </button>\n            <button\n              class=\"btn btn-danger\" data-cwl-action=\"showDeleteDialog\" data-cwl-action-args=\"selectedTenant!\" data-cwl-attr-disabled=\"isLoading\"\n             aria-label=\"Show Delete Dialog\">\n              Delete Tenant\n            </button>\n            <button\n              class=\"btn btn-secondary\" data-cwl-set=\"selectedTenant:\"\n            >\n              Close\n            </button>\n          </div>\n        </div></div>\n    </div>\n\n    <!-- Remote Agents Status Section (Global/System-wide) -->\n    <div class=\"remote-agents-section\">\n      <div class=\"section-header\">\n        <h2>📡 Remote Agents Status (System-wide)</h2>\n        <button class=\"btn btn-secondary\" data-cwl-action=\"loadAllRemoteAgents\" data-cwl-attr-disabled=\"loadingAgents\" aria-label=\"Load All Remote Agents\">\n          Refresh\n        </button>\n      </div>\n\n          <div class=\"agents-table-container\">\n            <table class=\"agents-table\">\n              <thead>\n                <tr>\n                  <th>Tenant</th>\n                  <th>Type</th>\n                  <th>ID</th>\n                  <th>Name/Code</th>\n                  <th>First Check-in</th>\n                  <th>Last Check-in</th>\n                  <th>Status</th>\n                  <th>Hardware Linked</th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"remoteAgents as agent (agent.epc_id || agent.device_id)\" data-cwl-each-item=\"agent\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bagent.tenant_name%20%7C%7C%20agent.tenant_id%20%7C%7C%20'Unknown'%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22agent-type-badge%20type-%7Bagent.type%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%3F%20'EPC'%20%3A%20'SNMP'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccode%3E%7Bagent.epc_id%20%7C%7C%20agent.device_id%20%7C%7C%20'N%2FA'%7D%3C%2Fcode%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3F%20(agent.device_code%20%7C%7C%20agent.site_name%20%7C%7C%20'N%2FA')%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3A%20(agent.name%20%7C%7C%20agent.ip_address%20%7C%7C%20'N%2FA')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7BgetFirstCheckin(agent)%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3F%20(agent.last_checkin%20%3F%20formatDate(agent.last_checkin)%20%3A%20'Never')%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3A%20(agent.discovered_at%20%3F%20formatDate(agent.discovered_at)%20%3A%20'N%2FA')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20agent.time_since_checkin%20!%3D%3D%20null%20%26%26%20agent.time_since_checkin%20!%3D%3D%20undefined%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csmall%20class%3D%22time-ago%22%3E%7BformatTimeAgo(agent.time_since_checkin)%7D%3C%2Fsmall%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-%7Bagent.checkin_status%20%7C%7C%20agent.status%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bagent.type%20%3D%3D%3D%20'epc_agent'%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3F%20(agent.checkin_status%20%7C%7C%20agent.status%20%7C%7C%20'unknown')%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3A%20(agent.status%20%7C%7C%20'discovered')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20agent.hardware_linked%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22linked-badge%20linked%22%3E%E2%9C%93%20Linked%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20agent.hardware_link_type%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbr%3E%3Csmall%3E(%7Bagent.hardware_link_type%7D)%3C%2Fsmall%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22linked-badge%20unlinked%22%3E%E2%9C%97%20Unlinked%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                    <td>\n                      <strong></strong>\n                    </td>\n                    <td>\n                      <span class=\"agent-type-badge type-\">\n\n                      </span>\n                    </td>\n                    <td>\n                      <code></code>\n                    </td>\n                    <td>\n\n                    </td>\n                    <td></td>\n                    <td>\n\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"agent.time_since_checkin !== null && agent.time_since_checkin !== undefined\"><br>\n                        <small class=\"time-ago\"></small></div>\n                    </td>\n                    <td>\n                      <span class=\"status-badge status-\">\n\n                      </span>\n                    </td>\n                    <td>\n\n                        <span class=\"linked-badge unlinked\">✗ Unlinked</span>\n\n                        <div hidden aria-hidden=\"true\"><span class=\"linked-badge linked\">✓ Linked</span>\n\n                          <div hidden aria-hidden=\"true\"><br><small>()</small>\n                        </div>\n                      </div>\n                    </td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No remote agents found across all tenants.</p>\n          </div>\n\n          <div class=\"loading\" hidden aria-hidden=\"true\">\n            <p>Loading remote agents...</p>\n          </div>\n\n      </div>\n\n      <div class=\"modal-overlay\" data-cwl-toggle=\"showDeleteConfirm:false\" data-cwl-shell-key=\"showDeleteConfirm\" hidden aria-hidden=\"true\">\n        <div class=\"modal\">\n          <h2>⚠️ Confirm Deletion</h2>\n          <p>\n            Are you sure you want to delete the tenant <strong>\"<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenantToDelete.displayName\"></span>\"</strong>?\n          </p>\n          <p class=\"warning-text\">\n            This action cannot be undone. All data associated with this tenant will be permanently deleted,\n            including:\n          </p>\n          <ul>\n            <li>All user associations</li>\n            <li>All customers</li>\n            <li>All work orders</li>\n            <li>All inventory</li>\n            <li>All network configurations</li>\n          </ul>\n          <div class=\"modal-actions\">\n            <button\n              class=\"btn btn-danger\" data-cwl-action=\"deleteTenant\" data-cwl-attr-disabled=\"isLoading\"\n             aria-label=\"Delete Tenant\">\n              Yes, Delete Tenant\n            </button>\n            <button\n              class=\"btn btn-secondary\" data-cwl-toggle=\"showDeleteConfirm:false\" data-cwl-attr-disabled=\"isLoading\"\n             aria-label=\"Show Delete Confirm\">\n              Cancel\n            </button>\n          </div>\n        </div>\n      </div>\n\n  </div></div>";
}

@page GET "/admin/tenant-management"
page admin_tenant_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/admin/tenant-management" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"admin-tenant-management\" data-wisp-path=\"/admin/tenant-management\" data-cwl-island=\"client\"><div class=\"admin-page\">\n  <header>\n    <div data-cwl-component=\"AdminBreadcrumb\" data-cwl-lifted-component=\"AdminBreadcrumb\"><nav class=\"breadcrumb\">\n  <ol class=\"breadcrumb-list\">\n    <!-- Home/Admin Management link -->\n    <li class=\"breadcrumb-item\">\n      <a\n        class=\"breadcrumb-link\" data-cwl-action=\"handleClick\" data-cwl-action-args=\"homeItem.path\"\n      >\n        <span class=\"breadcrumb-icon\">⚙️</span>\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"homeItem.label\"></span>\n      </a>\n    </li>\n\n    <!-- Additional breadcrumb items -->\n    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"items as item, index\"><li class=\"breadcrumb-separator\">/</li>\n      <li class=\"breadcrumb-item\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"item.path && index < items.length - 1\"><a class=\"breadcrumb-link\" data-cwl-action=\"handleClick\" data-cwl-action-args=\"item.path\"\n          >\n\n          </a></div>\n          <span class=\"breadcrumb-current\"></span>\n\n      </li></div>\n  </ol>\n</nav></div>\n    <div class=\"header-content\">\n      <div class=\"header-title\">\n        <h1>🏢 Platform Admin - Tenant Management</h1>\n        <p>Create and manage organization tenants</p>\n      </div>\n      <button class=\"btn-create\" data-cwl-toggle=\"showCreateModal:true\" aria-label=\"Show Create Modal\">\n        ➕ Create New Tenant\n      </button>\n    </div>\n  </header>\n\n  <main>\n\n      <div class=\"tenants-grid\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"tenants as tenant\" data-cwl-each-item=\"tenant\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Btenant.displayName%20%7C%7C%20tenant.name%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22tenant-status%22%20class%3Aactive%3D%7Btenant.status%20%3D%3D%3D%20'active'%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Btenant.status%20%7C%7C%20'active'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EOrganization%20Name%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Btenant.name%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3ESubdomain%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%20monospace%22%3E%7Btenant.subdomain%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EContact%20Email%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Btenant.contactEmail%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3ECreated%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bnew%20Date(tenant.createdAt).toLocaleDateString()%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EUsers%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Btenant.userCount%20%7C%7C%200%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EStatus%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Clabel%20class%3D%22status-toggle%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cinput%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22checkbox%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20checked%3D%7Btenant.status%20%3D%3D%3D%20'active'%7D%20data-cwl-on-change%3D%22action%3AtoggleTenantStatus%22%20data-cwl-on-change-args%3D%22tenant%2C%20e.currentTarget.checked%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7Bprocessing%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22toggle-slider%22%3E%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22toggle-label%22%3E%7Btenant.status%20%3D%3D%3D%20'active'%20%3F%20'Active'%20%3A%20'Suspended'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Flabel%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-action%20btn-users%22%20data-cwl-action%3D%22openUsersModal%22%20data-cwl-action-args%3D%22tenant%22%20aria-label%3D%22Open%20Users%20Modal%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%91%A5%20View%20Users%20(%7Btenant.userCount%20%7C%7C%200%7D)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-action%20btn-owner%22%20data-cwl-action%3D%22openAssignOwnerModal%22%20data-cwl-action-args%3D%22tenant%22%20aria-label%3D%22Open%20Assign%20Owner%20Modal%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%91%A4%20Assign%20Owner%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-action%20btn-edit%22%20data-cwl-action%3D%22openEditModal%22%20data-cwl-action-args%3D%22tenant%22%20aria-label%3D%22Open%20Edit%20Modal%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9C%8F%EF%B8%8F%20Edit%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-action%20btn-delete%22%20data-cwl-action%3D%22openDeleteModal%22%20data-cwl-action-args%3D%22tenant%22%20aria-label%3D%22Open%20Delete%20Modal%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%97%91%EF%B8%8F%20Delete%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20\"><div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <h3></h3>\n              <span class=\"tenant-status\">\n\n              </span>\n            </div>\n\n            <div class=\"tenant-details\">\n              <div class=\"detail-row\">\n                <span class=\"label\">Organization Name:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Subdomain:</span>\n                <span class=\"value monospace\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Contact Email:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Users:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Status:</span>\n                <span class=\"value\">\n                  <label class=\"status-toggle\">\n                    <input\n                      type=\"checkbox\" data-cwl-on-change=\"action:toggleTenantStatus\" data-cwl-on-change-args=\"tenant, e.currentTarget.checked\" />\n                    <span class=\"toggle-slider\"></span>\n                    <span class=\"toggle-label\"></span>\n                  </label>\n                </span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-action btn-users\" data-cwl-action=\"openUsersModal\" data-cwl-action-args=\"tenant\" aria-label=\"Open Users Modal\">\n                👥 View Users ()\n              </button>\n              <button class=\"btn-action btn-owner\" data-cwl-action=\"openAssignOwnerModal\" data-cwl-action-args=\"tenant\" aria-label=\"Open Assign Owner Modal\">\n                👤 Assign Owner\n              </button>\n              <button class=\"btn-action btn-edit\" data-cwl-action=\"openEditModal\" data-cwl-action-args=\"tenant\" aria-label=\"Open Edit Modal\">\n                ✏️ Edit\n              </button>\n              <button class=\"btn-action btn-delete\" data-cwl-action=\"openDeleteModal\" data-cwl-action-args=\"tenant\" aria-label=\"Open Delete Modal\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div></div>\n      </div>\n\n      <div class=\"empty-state\" hidden aria-hidden=\"true\">\n        <p>📭 No tenants found</p>\n        <button class=\"btn-primary\" data-cwl-toggle=\"showCreateModal:true\" aria-label=\"Show Create Modal\">Create First Tenant</button>\n      </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\">\n        ❌\n      </div>\n\n  </main>\n</div>\n\n<!-- Create/Edit Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showUsersModal:false\" data-cwl-shell-key=\"showCreateModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h2>✏️ Edit Tenant</h2>\n        <button class=\"close-btn\" data-cwl-toggle=\"showUsersModal:false\" aria-label=\"Show Users Modal\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n        <div class=\"form-group\">\n          <label>Organization Name <span class=\"required\">*</span></label>\n          <input\n            type=\"text\"\n            placeholder=\"e.g., acme-wireless\" data-cwl-attr-disabled=\"processing\"\n          />\n          <small>Used internally, lowercase with hyphens</small>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Display Name <span class=\"required\">*</span></label>\n          <input\n            type=\"text\"\n            placeholder=\"e.g., Acme Wireless Corp\" data-cwl-attr-disabled=\"processing\"\n          />\n          <small>Friendly name shown in the UI</small>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Contact Email (Owner) <span class=\"required\">*</span></label>\n          <input\n            type=\"email\"\n            placeholder=\"admin@example.com\" data-cwl-attr-disabled=\"processing\"\n          />\n          <small>This person will be assigned as the tenant owner</small>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Subdomain</label>\n          <input\n            type=\"text\"\n            placeholder=\"Auto-generated from name\" data-cwl-attr-disabled=\"processing\"\n          />\n          <small>Leave blank to auto-generate</small>\n        </div>\n      </div>\n\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showUsersModal:false\" data-cwl-attr-disabled=\"processing\" aria-label=\"Show Users Modal\">\n          Cancel\n        </button>\n        <button\n          class=\"btn-primary\" data-cwl-action=\"updateTenant\" data-cwl-action-true=\"createTenant\" data-cwl-action-state=\"showCreateModal:false\" data-cwl-attr-disabled=\"processing || !formData.name || !formData.displayName || !formData.contactEmail\"\n         aria-label=\"Update Tenant\">\n          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"processing ? 'Processing...' : (showCreateModal ? 'Create Tenant' : 'Update Tena\"></span>\n        </button>\n      </div>\n    </div>\n  </div>\n\n<!-- Delete Confirmation Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showUsersModal:false\" data-cwl-shell-key=\"showDeleteModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content modal-danger\">\n      <div class=\"modal-header\">\n        <h2>🗑️ Delete Tenant</h2>\n        <button class=\"close-btn\" data-cwl-toggle=\"showUsersModal:false\" aria-label=\"Show Users Modal\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n        <p><strong>⚠️ Warning:</strong> This action cannot be undone!</p>\n        <p>Are you sure you want to delete the tenant:</p>\n        <p class=\"tenant-name-delete\"><strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.displayName\"></span></strong></p>\n        <p>All associated users, data, and configurations will be removed.</p>\n      </div>\n\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showUsersModal:false\" data-cwl-attr-disabled=\"processing\" aria-label=\"Show Users Modal\">\n          Cancel\n        </button>\n        <button class=\"btn-danger\" data-cwl-action=\"deleteTenant\" data-cwl-attr-disabled=\"processing\" aria-label=\"Delete Tenant\">\n          Delete Tenant\n        </button>\n      </div>\n    </div>\n  </div>\n\n<!-- Assign Owner Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showUsersModal:false\" data-cwl-shell-key=\"showAssignOwnerModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h2>👤 Assign/Change Owner</h2>\n        <button class=\"close-btn\" data-cwl-toggle=\"showUsersModal:false\" aria-label=\"Show Users Modal\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n        <p><strong>Tenant:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.displayName\"></span></p>\n        <p class=\"help-text\">\n          Enter the email address of the user who should be the owner of this tenant.\n          The user must already have a Firebase account.\n        </p>\n\n        <div class=\"form-group\">\n          <label>Owner Email Address <span class=\"required\">*</span></label>\n          <input\n            type=\"email\"\n            placeholder=\"user@example.com\" data-cwl-attr-disabled=\"processing\"\n          />\n        </div>\n      </div>\n\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showUsersModal:false\" data-cwl-attr-disabled=\"processing\" aria-label=\"Show Users Modal\">\n          Cancel\n        </button>\n        <button\n          class=\"btn-primary\" data-cwl-action=\"assignOwner\" data-cwl-attr-disabled=\"processing || !newOwnerEmail.trim()\"\n         aria-label=\"Assign Owner\">\n          Assign Owner\n        </button>\n      </div>\n    </div>\n  </div>\n\n<!-- Users Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showUsersModal:false\" data-cwl-shell-key=\"showUsersModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content modal-large\">\n      <div class=\"modal-header\">\n        <h2>👥 Users in <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.displayName\"></span></h2>\n        <button class=\"close-btn\" data-cwl-toggle=\"showUsersModal:false\" aria-label=\"Show Users Modal\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n\n          <div class=\"users-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"tenantUsers as user\" data-cwl-each-item=\"user\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-name%22%3E%7Buser.displayName%20%7C%7C%20'No%20name'%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-email%22%3E%7Buser.email%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-role-badge%20badge-%7Buser.role%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Buser.role%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-status-badge%20badge-%7Buser.status%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Buser.status%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"user-item\">\n                <div class=\"user-info\">\n                  <div class=\"user-name\"></div>\n                  <div class=\"user-email\"></div>\n                </div>\n                <div class=\"user-role-badge badge-\">\n\n                </div>\n                <div class=\"user-status-badge badge-\">\n\n                </div>\n              </div></div>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No users found for this tenant</p>\n          </div>\n\n          <div class=\"loading\" hidden aria-hidden=\"true\">\n            <div class=\"spinner\"></div>\n            <p>Loading users...</p>\n          </div>\n\n      </div>\n\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showUsersModal:false\" aria-label=\"Show Users Modal\">\n          Close\n        </button>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/admin/tenants/:tenantId/modules"
page admin_tenants_tenantId_modules_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/admin/tenants/:tenantId/modules" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"admin-tenants-:tenantId-modules\" data-wisp-path=\"/admin/tenants/:tenantId/modules\" data-cwl-island=\"client\"><div class=\"admin-page\">\n  <div class=\"page-header\">\n    <button class=\"back-button\" data-cwl-nav=\"/admin/tenant-management\" type=\"button\">\n      ← Back to Tenants\n    </button>\n    <h1>Module Configuration</h1>\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tenantData\"><p class=\"subtitle\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenantData.displayName || tenantData.name\"></span> ()\n      </p></div>\n  </div>\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      ⚠️\n      <button class=\"dismiss-btn\" data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n      ✅\n      <button class=\"dismiss-btn\" data-cwl-set=\"success:\">✕</button>\n    </div>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tenantData\"><div class=\"config-container\">\n\n      <!-- Subscription Tier -->\n      <div class=\"section\">\n        <h2>📋 Subscription Tier</h2>\n        <div class=\"tier-selector\">\n          <select data-cwl-on-change=\"action:applyTierDefaults\">\n\n              <option value=free>Free</option>\n\n              <option value=basic>Basic</option>\n\n              <option value=professional>Professional</option>\n\n              <option value=enterprise>Enterprise</option>\n\n              <option value=custom>Custom</option>\n\n          </select>\n          <button class=\"btn-secondary\" data-cwl-action=\"applyTierDefaults\" aria-label=\"Apply Tier Defaults\">\n            Apply Tier Defaults\n          </button>\n        </div>\n      </div>\n\n      <!-- Enabled Modules -->\n      <div class=\"section\">\n        <h2>🎛️ Enabled Modules</h2>\n        <div class=\"module-toggles\">\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📊</span>\n              <span>PCI Resolution & Network Optimization</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📡</span>\n              <span>CBRS Management</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🔐</span>\n              <span>HSS & Subscriber Management</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🗺️</span>\n              <span>Coverage Map</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📦</span>\n              <span>Inventory Management</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🌐</span>\n              <span>Distributed EPC (Advanced)</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🔍</span>\n              <span>Monitoring & Alerts</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📞</span>\n              <span>Voice / SIP & UC</span>\n            </span>\n          </label>\n        </div>\n      </div>\n\n      <!-- Usage Limits -->\n      <div class=\"section\">\n        <h2>📊 Usage Limits</h2>\n        <div class=\"limits-grid\">\n          <div class=\"limit-item\">\n            <label>Max Tower Sites</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n\n          <div class=\"limit-item\">\n            <label>Max Subscribers</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n\n          <div class=\"limit-item\">\n            <label>Max CPE Devices</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n\n          <div class=\"limit-item\">\n            <label>Max Users</label>\n            <input type=\"number\" min=\"1\" />\n          </div>\n\n          <div class=\"limit-item\">\n            <label>Max Inventory Items</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n        </div>\n        <p class=\"help-text\">Set to 999999 for unlimited</p>\n      </div>\n\n      <!-- Feature Flags -->\n      <div class=\"section\">\n        <h2>⭐ Feature Flags</h2>\n        <div class=\"feature-toggles\">\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>Advanced Reporting</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>API Access</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>White Label</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>Custom Integrations</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>Priority Support</span>\n            </span>\n          </label>\n        </div>\n      </div>\n\n      <!-- Save Button -->\n      <div class=\"actions\">\n        <button class=\"btn-secondary\" data-cwl-nav=\"/admin/tenant-management\">\n          Cancel\n        </button>\n        <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n          💾 Save Configuration\n        </button>\n      </div>\n    </div></div>\n    <div class=\"loading\" hidden aria-hidden=\"true\">Loading...</div>\n\n</div></div>";
}

@page GET "/auth/google/callback"
page auth_google_callback_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/auth/google/callback" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"auth-google-callback\" data-wisp-path=\"/auth/google/callback\" data-cwl-island=\"client\"><div class=\"callback-page\">\n  <div class=\"callback-card\">\n    <div class=\"callback-icon\">\n\n        🔄\n\n        <div hidden aria-hidden=\"true\">❌\n      </div>\n    </div>\n\n    <h2>Processing Google Sign-In...</h2>\n\n      <div class=\"loading-spinner\"></div>\n\n      <div hidden aria-hidden=\"true\"><p class=\"error-message\"></p>\n      <p class=\"help-text\">Redirecting to login page...</p>\n    </div>\n  </div>\n</div></div>";
}

@page GET "/dashboard"
page dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/dashboard" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"dashboard\" data-wisp-path=\"/dashboard\" data-cwl-island=\"client\"><!-- First-Time Setup Wizard -->\n\n    <div data-cwl-shell-key=\"showOnboardingWizard\" hidden aria-hidden=\"true\"><div data-cwl-component=\"FirstTimeSetupWizard\" data-cwl-lifted-component=\"FirstTimeSetupWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showOnboardingWizard\" hidden aria-hidden=\"true\"><div class=\"wizard-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"wizard-title\" hidden aria-hidden=\"true\">\n    <div class=\"wizard-modal\">\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\">🚀 Welcome to WISP Tools</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <!-- Progress Steps -->\n      <nav class=\"wizard-steps\" aria-label=\"Setup steps\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"steps as step, index\"><button\n            type=\"button\"\n            class=\"wizard-step\" data-cwl-action=\"goToStep\" data-cwl-action-args=\"index\" aria-label=\"Go To Step\">\n            <span class=\"step-icon\"></span>\n            <span class=\"step-title\"></span>\n          </button></div>\n      </nav>\n\n      <!-- Step Content -->\n      <div class=\"wizard-content\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><!-- Welcome Step -->\n          <div class=\"wizard-panel\">\n            <div class=\"welcome-content\">\n              <h3>Welcome to WISP Tools! 🎉</h3>\n              <p>Let's get your wireless ISP set up and running in just a few minutes.</p>\n\n              <div class=\"features-preview\">\n                <div class=\"feature-item\">\n                  <span class=\"icon\">🗺️</span>\n                  <div>\n                    <strong>Coverage Map</strong>\n                    <p>Plan and visualize your network coverage</p>\n                  </div>\n                </div>\n                <div class=\"feature-item\">\n                  <span class=\"icon\">📡</span>\n                  <div>\n                    <strong>CBRS Management</strong>\n                    <p>Manage spectrum and device registration</p>\n                  </div>\n                </div>\n                <div class=\"feature-item\">\n                  <span class=\"icon\">⚙️</span>\n                  <div>\n                    <strong>CPE Management</strong>\n                    <p>Configure and monitor customer equipment</p>\n                  </div>\n                </div>\n                <div class=\"feature-item\">\n                  <span class=\"icon\">📊</span>\n                  <div>\n                    <strong>Monitoring & Analytics</strong>\n                    <p>Track performance and network health</p>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"setup-time\">\n                <strong>⏱️ Estimated time:</strong> 5-10 minutes\n              </div>\n            </div>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 1\"><!-- Organization Setup Step -->\n          <div class=\"wizard-panel\">\n            <h3>Organization Setup</h3>\n            <p>Your organization is already created! Let's verify the details.</p>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$currentTenant\"><div class=\"info-card\">\n                <div class=\"info-row\">\n                  <span class=\"label\">Organization Name:</span>\n                  <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.displayName\"></span></span>\n                </div>\n                <div class=\"info-row\">\n                  <span class=\"label\">Contact Email:</span>\n                  <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.contactEmail\"></span></span>\n                </div>\n              </div></div>\n\n            <p class=\"hint\">✅ Organization setup complete! You can edit these details later in Settings.</p>\n            <button type=\"button\" class=\"btn-link\" data-cwl-toggle=\"showOrgWizard:true\" aria-label=\"Show Org Wizard\">Open full Organization Setup wizard</button>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><!-- Add First Tower Step -->\n          <div class=\"wizard-panel\">\n            <h3>Add Your First Tower Site</h3>\n            <p>Let's add your first network tower to get started with coverage planning.</p>\n\n            <div class=\"action-card\">\n              <p><strong>Option 1: Quick Setup</strong></p>\n              <p>Add a tower site now through the Coverage Map module.</p>\n              <button class=\"btn-primary\" data-cwl-action=\"add-tower\" aria-label=\"Add tower\">\n                Open Coverage Map\n              </button>\n            </div>\n\n            <div class=\"action-card\">\n              <p><strong>Option 2: Skip for Now</strong></p>\n              <p>You can add tower sites later from the Coverage Map module.</p>\n            </div>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 3\"><!-- Configure Modules Step -->\n          <div class=\"wizard-panel\">\n            <h3>Configure Modules (Optional)</h3>\n            <p>Set up the modules you'll use for your operations.</p>\n\n            <div class=\"modules-grid\">\n              <div class=\"module-card\">\n                <span class=\"icon\">📡</span>\n                <h4>CBRS Management</h4>\n                <p>Configure Google SAS and Federated Wireless API keys</p>\n                <button class=\"btn-secondary\" data-cwl-action=\"setup-cbrs\" aria-label=\"Setup cbrs\">\n                  Setup CBRS\n                </button>\n              </div>\n\n              <div class=\"module-card\">\n                <span class=\"icon\">⚙️</span>\n                <h4>ACS/TR-069</h4>\n                <p>Configure monitoring and alerts</p>\n                <button class=\"btn-secondary\" data-cwl-action=\"setup-monitoring\" aria-label=\"Setup monitoring\">\n                  Setup ACS\n                </button>\n              </div>\n\n              <div class=\"module-card\">\n                <span class=\"icon\">📊</span>\n                <h4>Monitoring</h4>\n                <p>Configure SNMP and network monitoring</p>\n                <button class=\"btn-secondary\" data-cwl-action=\"setup-monitoring\" aria-label=\"Setup monitoring\">\n                  Setup Monitoring\n                </button>\n              </div>\n            </div>\n\n            <p class=\"hint\">💡 You can configure these modules later from the Dashboard.</p>\n            <button type=\"button\" class=\"btn-link\" data-cwl-toggle=\"showConfigWizard:true\" aria-label=\"Show Config Wizard\">Open full Initial Configuration wizard</button>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 4\"><!-- Complete Step -->\n          <div class=\"wizard-panel\">\n            <h3>🎉 Setup Complete!</h3>\n            <p>You're all set! Here's what you can do next:</p>\n\n            <div class=\"next-steps\">\n              <a href=\"/modules/coverage-map\" class=\"next-step-item\">\n                <span class=\"icon\">🗺️</span>\n                <div>\n                  <strong>Explore Coverage Map</strong>\n                  <p>Add tower sites and plan your network coverage</p>\n                </div>\n              </a>\n              <a href=\"/modules/customers\" class=\"next-step-item\">\n                <span class=\"icon\">👥</span>\n                <div>\n                  <strong>Add Customers</strong>\n                  <p>Start managing your customer base</p>\n                </div>\n              </a>\n              <a href=\"/modules/work-orders\" class=\"next-step-item\">\n                <span class=\"icon\">📋</span>\n                <div>\n                  <strong>Create Work Orders</strong>\n                  <p>Manage installations and service requests</p>\n                </div>\n              </a>\n              <a href=\"/modules/voice-telephony\" class=\"next-step-item\">\n                <span class=\"icon\">📞</span>\n                <div>\n                  <strong>Voice / SIP &amp; UC</strong>\n                  <p>Link numbers, E911, and porting to customers</p>\n                </div>\n              </a>\n            </div>\n          </div></div>\n      </div>\n\n      <!-- Wizard Footer -->\n      <div class=\"wizard-footer\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 0\"><button class=\"btn-secondary\" data-cwl-action=\"prevStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Prev Step\">\n            ← Previous\n          </button></div>\n          <button class=\"btn-secondary\" data-cwl-action=\"skipToDashboard\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Skip To Dashboard\">\n            Skip Setup\n          </button>\n\n        <div class=\"footer-actions\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep < steps.length - 1\"><button class=\"btn-primary\" data-cwl-action=\"nextStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Next Step\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentStep === 0 ? 'Get Started →' : 'Next →'\"></span>\n            </button></div>\n            <button class=\"btn-primary\" data-cwl-action=\"completeSetup\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Complete Setup\">\n              Go to Dashboard →\n            </button>\n\n        </div>\n      </div>\n    </div>\n  </div>\n  <div data-cwl-component=\"OrganizationSetupWizard\" data-cwl-lifted-component=\"OrganizationSetupWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showOrgWizard\" hidden aria-hidden=\"true\"><div class=\"wizard-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"org-wizard-title\" hidden aria-hidden=\"true\">\n    <div class=\"wizard-modal\">\n      <div class=\"wizard-header\">\n        <h2 id=\"org-wizard-title\">🏢 Organization Setup</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n      <div class=\"wizard-content\">\n        <div class=\"wizard-panel\">\n          <p>Verify your organization details. You can edit these later in Settings.</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$currentTenant\"><div class=\"info-card\">\n              <div class=\"info-row\">\n                <span class=\"label\">Organization Name:</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.displayName\"></span></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Contact Email:</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.contactEmail ?? '—'\"></span></span>\n              </div>\n            </div></div>\n            <p class=\"hint\">No tenant selected. Select a tenant from the dashboard or complete tenant setup first.</p>\n\n          <div class=\"actions\">\n            <button type=\"button\" class=\"btn-primary\" data-cwl-nav=\"/dashboard?panel=settings\">Edit in Settings</button>\n            <button type=\"button\" class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Done</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div></div>\n  <div data-cwl-component=\"InitialConfigurationWizard\" data-cwl-lifted-component=\"InitialConfigurationWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showConfigWizard\" hidden aria-hidden=\"true\"><div class=\"wizard-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"config-wizard-title\" hidden aria-hidden=\"true\">\n    <div class=\"wizard-modal\">\n      <div class=\"wizard-header\">\n        <h2 id=\"config-wizard-title\">⚙️ Initial Configuration</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n      <div class=\"wizard-content\">\n        <div class=\"wizard-panel\">\n          <p>Add your first tower and configure the modules you'll use. You can do these later from the Dashboard.</p>\n\n          <div class=\"section\">\n            <h3>Add First Tower</h3>\n            <p class=\"section-desc\">Add a tower site for coverage planning.</p>\n            <button type=\"button\" class=\"btn-primary\" data-cwl-nav=\"/modules/coverage-map\">Open Coverage Map</button>\n          </div>\n\n          <div class=\"section\">\n            <h3>Configure Modules</h3>\n            <div class=\"modules-grid\">\n              <div class=\"module-card\">\n                <span class=\"icon\">📡</span>\n                <h4>CBRS Management</h4>\n                <p>Configure SAS API keys</p>\n                <button type=\"button\" class=\"btn-secondary\" data-cwl-nav=\"/modules/cbrs-management\">Setup CBRS</button>\n              </div>\n              <div class=\"module-card\">\n                <span class=\"icon\">⚙️</span>\n                <h4>ACS/TR-069</h4>\n                <p>Configure network monitoring</p>\n                <button type=\"button\" class=\"btn-secondary\" data-cwl-nav=\"/modules/monitoring\">Setup ACS</button>\n              </div>\n              <div class=\"module-card\">\n                <span class=\"icon\">📊</span>\n                <h4>Monitoring</h4>\n                <p>Configure SNMP and monitoring</p>\n                <button type=\"button\" class=\"btn-secondary\" data-cwl-nav=\"/modules/monitoring\">Setup Monitoring</button>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"actions\">\n            <button type=\"button\" class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Done</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div></div></div></div>\n  </div>\n\n  <div class=\"dashboard-container\">\n    <!-- Header: centered logo + text, icons directly below -->\n    <div class=\"header\">\n      <div class=\"header-content\">\n        <div class=\"header-brand\">\n          <div class=\"logo-section\">\n            <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"dashboard-logo\" />\n            <div class=\"branding\">\n              <h1 class=\"app-title\">WISP Management</h1>\n              <p class=\"app-subtitle\">wisptools.io</p>\n            <p class=\"poc-notice\">wisptools.io · Source code: <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">github.com/theorem6/WISP-Management</a></p>\n            </div>\n          </div>\n          <div class=\"header-icons\">\n            <a class=\"icon-btn apk-btn\" title=\"Download Field App\" aria-label=\"Download WISP Field App (APK)\" download>\n              <span class=\"apk-icon\">📱</span>\n            </a>\n            <a href=\"/help\" class=\"icon-btn doc-btn\" title=\"Help\" aria-label=\"Open help\">\n              <span class=\"doc-icon\">📖</span>\n            </a>\n            <button class=\"icon-btn gear-btn\" data-cwl-toggle=\"showSettings:true\" title=\"Settings\" aria-label=\"Open settings\">\n              <svg class=\"gear-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n                <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path>\n              </svg>\n            </button>\n\n              <div hidden aria-hidden=\"true\"><div data-cwl-component=\"NotificationCenter\" data-cwl-lifted-component=\"NotificationCenter\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showNotificationCenter\" hidden aria-hidden=\"true\"><div class=\"notification-center\">\n  <button\n    type=\"button\"\n    class=\"bell-btn\" data-cwl-action=\"toggle\"\n    aria-label=\"Notifications\"\n    title=\"Notifications\"\n  >\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n      <path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\" />\n      <path d=\"M13.73 21a2 2 0 0 1-3.46 0\" />\n    </svg>\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$unreadCount > 0\"><span class=\"badge\" aria-label=\"unread\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$unreadCount > 99 ? '99+' : $unreadCount\"></span></span></div>\n  </button>\n\n    <div class=\"panel\" role=\"dialog\" aria-label=\"Notifications panel\">\n      <div class=\"panel-header\">\n        <h3>Notifications</h3>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$unreadCount > 0\"><span class=\"unread-label\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$unreadCount\"></span> unread</span></div>\n      </div>\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"browser && typeof Notification !== 'undefined' && browserPermission === 'default'\"><div class=\"panel-browser-prompt\">\n          <p class=\"browser-prompt-text\">Enable browser notifications to get alerts even when the tab is in the background.</p>\n          <button type=\"button\" class=\"browser-prompt-btn\" data-cwl-action=\"requestBrowserNotifications\" aria-label=\"Request Browser Notifications\">Enable notifications</button>\n        </div></div>\n      <div class=\"panel-body\">\n\n          <div class=\"empty\" hidden aria-hidden=\"true\">Loading…</div>\n\n      </div>\n    </div>\n\n</div></div></div>\n\n                <span class=\"admin-badge\" title=\"Administrator\">Admin</span>\n\n              <button class=\"icon-btn power-btn\" data-cwl-action=\"handleLogout\" title=\"Logout\" aria-label=\"Logout\">\n                <svg class=\"power-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M18.36 6.64a9 9 0 1 1-12.73 0\"></path>\n                  <line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"12\"></line>\n                </svg>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div data-cwl-component=\"GlobalSettings\" data-cwl-lifted-component=\"GlobalSettings\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSettings\" hidden aria-hidden=\"true\"><div class=\"settings-overlay\" data-cwl-action=\"handleClose\" role=\"presentation\" hidden aria-hidden=\"true\">\n    <div\n      class=\"settings-panel\" data-cwl-on-keydown=\"action:handlePanelKeydown\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"settings-title\"\n    >\n      <div class=\"settings-header\">\n        <h2 id=\"settings-title\">⚙️ Settings</h2>\n        <div class=\"header-actions\">\n          <button class=\"close-btn\" data-cwl-action=\"handleClose\" title=\"Close\">✕</button>\n        </div>\n      </div>\n\n      <div class=\"settings-tabs\">\n        <button\n          class=\"tab\" data-cwl-set=\"activeTab:appearance\"\n        >\n          🎨 Appearance\n        </button>\n        <button\n          class=\"tab\" data-cwl-set=\"activeTab:info\"\n        >\n          ℹ️ Company Info\n        </button>\n        <button\n          class=\"tab\" data-cwl-set=\"activeTab:import\"\n        >\n          📥 Import Data\n        </button>\n        <button\n          class=\"tab\" data-cwl-set=\"activeTab:users\"\n        >\n          👤 User Management\n        </button>\n        <button\n          class=\"tab\" data-cwl-set=\"activeTab:branding\"\n        >\n          🎨 Customer Portal Branding\n        </button>\n        <button\n          class=\"tab\" data-cwl-set=\"activeTab:debug\"\n        >\n          🐛 Debug Mode\n        </button>\n      </div>\n\n      <div class=\"settings-content\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'appearance'\">\n          <div class=\"tab-content\">\n            <h3>Theme</h3>\n            <p class=\"description\">Choose your preferred color scheme</p>\n\n            <div class=\"theme-options\">\n              <button\n                class=\"theme-option\" data-cwl-action=\"applyTheme\" data-cwl-action-args=\"'light'\"\n               aria-label=\"Apply Theme\">\n                <span class=\"icon\">☀️</span>\n                <span class=\"label\">Light</span>\n              </button>\n\n              <button\n                class=\"theme-option\" data-cwl-action=\"applyTheme\" data-cwl-action-args=\"'dark'\"\n               aria-label=\"Apply Theme\">\n                <span class=\"icon\">🌙</span>\n                <span class=\"label\">Dark</span>\n              </button>\n\n              <button\n                class=\"theme-option\" data-cwl-action=\"applyTheme\" data-cwl-action-args=\"'system'\"\n               aria-label=\"Apply Theme\">\n                <span class=\"icon\">💻</span>\n                <span class=\"label\">System</span>\n              </button>\n            </div>\n          </div>\n\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'info'\" hidden aria-hidden=\"true\">\n          <div class=\"tab-content\">\n            <h3>Company Information</h3>\n            <p class=\"description\">Your company details for reports and documentation</p>\n\n            <div class=\"form-group\">\n              <label>Company Name</label>\n              <input\n                type=\"text\"\n                placeholder=\"ACME Networks Inc.\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Street Address</label>\n              <input\n                type=\"text\"\n                placeholder=\"123 Main Street\"\n              />\n            </div>\n\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label>City</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"New York\"\n                />\n              </div>\n\n              <div class=\"form-group\">\n                <label>State</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"NY\"\n                  maxlength=\"2\"\n                />\n              </div>\n\n              <div class=\"form-group\">\n                <label>ZIP Code</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"10001\"\n                  maxlength=\"10\"\n                />\n              </div>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Phone</label>\n              <input\n                type=\"tel\"\n                placeholder=\"(555) 123-4567\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Email</label>\n              <input\n                type=\"email\"\n                placeholder=\"contact@company.com\"\n              />\n            </div>\n\n            <button class=\"btn-save\" data-cwl-action=\"saveCompanyInfo\" data-cwl-attr-disabled=\"loading\" aria-label=\"Save Company Info\">\n              Save Company Info\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'import'\" hidden aria-hidden=\"true\">\n          <div class=\"tab-content\">\n            <h3>Data Import</h3>\n            <p class=\"description\">Import data from CSV files for all database objects </p>\n\n            <div class=\"import-info\">\n              <p>Use the import system to bulk import:</p>\n              <ul>\n                <li>📦 Inventory Items</li>\n                <li>👥 Customers</li>\n                <li>🗺️ Plans/Projects</li>\n                <li>🏗️ Sites/Towers</li>\n                <li>📡 Network Equipment</li>\n                <li>📋 Work Orders</li>\n                <li>👤 Users</li>\n                <li>📚 Hardware Bundles</li>\n              </ul>\n            </div>\n\n            <button class=\"btn-save\" data-cwl-toggle=\"showImportSystem:true\" aria-label=\"Show Import System\">\n              📥 Open Import System\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'users'\" hidden aria-hidden=\"true\">\n          <div class=\"tab-content full-height\">\n            <div data-cwl-component=\"UserManagementEmbedded\" data-cwl-lifted-component=\"UserManagementEmbedded\"><div class=\"user-management-embedded\">\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      <span>❌</span>\n      <span></span>\n      <button data-cwl-set=\"error:\">✕</button>\n    </div>\n\n  <div class=\"header-section\">\n\n      <div class=\"header-actions\">\n        <button class=\"btn btn-link\" data-cwl-nav=\"/modules/user-management/roles\">\n          👥 Role Management\n        </button>\n        <button class=\"btn btn-link\" data-cwl-nav=\"/modules/user-management/permissions\">\n          🔐 User Permissions\n        </button>\n        <button class=\"btn btn-primary\" data-cwl-toggle=\"showInviteModal:true\" aria-label=\"Show Invite Modal\">\n          ➕ Add User\n        </button>\n      </div>\n\n  </div>\n\n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search by name or email...\" data-cwl-on-input=\"action:handleSearch\"\n      />\n    </div>\n\n    <select data-cwl-on-change=\"action:handleRoleFilterChange\" class=\"select\">\n      <option value=\"all\">All Roles</option>\n      <option value=\"owner\">Owner</option>\n      <option value=\"admin\">Admin</option>\n      <option value=\"engineer\">Engineer</option>\n      <option value=\"installer\">Field Technician</option>\n      <option value=\"helpdesk\">Help Desk</option>\n      <option value=\"viewer\">Viewer</option>\n    </select>\n\n    <select data-cwl-on-change=\"action:handleStatusFilterChange\" class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"active\">Active</option>\n      <option value=\"suspended\">Suspended</option>\n      <option value=\"pending_invitation\">Pending</option>\n    </select>\n\n    <div class=\"results-count\">\n      <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filteredUsers.length\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"users.length\"></span> users\n    </div>\n  </div>\n\n    <div class=\"table-container\">\n      <table class=\"user-table\">\n        <thead>\n          <tr>\n            <th>User</th>\n            <th>Role</th>\n            <th>Status</th>\n            <th>Last Login</th>\n\n              <th>Actions</th>\n\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredUsers as user (user.uid)\" data-cwl-each-item=\"user\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-cell%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20user.photoURL%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cimg%20src%3D%7Buser.photoURL%7D%20alt%3D%7Buser.displayName%7D%20class%3D%22user-avatar%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-avatar-placeholder%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Buser.displayName%3F.charAt(0)%20%7C%7C%20user.email.charAt(0).toUpperCase()%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-name%22%3E%7Buser.displayName%20%7C%7C%20'No%20name'%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-email%22%3E%7Buser.email%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7BgetRoleBadgeClass(user.role)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BROLE_NAMES%5Buser.role%5D%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7BgetStatusBadgeClass(user.status)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Buser.status.replace('_'%2C%20'%20')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22time-cell%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatTimeAgo(user.lastLoginAt)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20canManageUsers%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn%20btn-sm%20btn-ghost%22%20data-cwl-action%3D%22openEditModal%22%20data-cwl-action-args%3D%22user%22%20aria-label%3D%22Open%20Edit%20Modal%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9C%8F%EF%B8%8F%20Edit%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20\"><tr>\n              <td>\n                <div class=\"user-cell\">\n\n                    <div class=\"user-avatar-placeholder\">\n\n                    </div>\n\n                    <div hidden aria-hidden=\"true\"><img class=\"user-avatar\" />\n                  </div>\n                  <div class=\"user-info\">\n                    <div class=\"user-name\"></div>\n                    <div class=\"user-email\"></div>\n                  </div>\n                </div>\n              </td>\n              <td>\n                <span class=\"badge \">\n\n                </span>\n              </td>\n              <td>\n                <span class=\"badge \">\n\n                </span>\n              </td>\n              <td class=\"time-cell\">\n\n              </td>\n\n                <td>\n                  <button class=\"btn btn-sm btn-ghost\" data-cwl-action=\"openEditModal\" data-cwl-action-args=\"user\" aria-label=\"Open Edit Modal\">\n                    ✏️ Edit\n                  </button>\n                </td>\n\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"empty-state\" hidden aria-hidden=\"true\">\n      <span class=\"empty-icon\">👤</span>\n      <h3>No users found</h3>\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"searchQuery || roleFilter !== 'all' || statusFilter !== 'all'\"><p>Try adjusting your filters</p>\n        <button class=\"btn btn-secondary\" data-cwl-action=\"applyFilters\" aria-label=\"Apply Filters\">\n          Clear Filters\n        </button></div>\n        <p>Invite your first user to get started</p>\n        <button class=\"btn btn-primary\" data-cwl-toggle=\"showInviteModal:true\" aria-label=\"Show Invite Modal\">\n          Invite User\n        </button>\n\n    </div>\n\n</div>\n\n  <div data-cwl-shell-key=\"showInviteModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"InviteUserModal\" data-cwl-lifted-component=\"InviteUserModal\"><div\n  class=\"modal-backdrop\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  tabindex=\"0\"\n  aria-label=\"Add user dialog\" data-cwl-action=\"handleBackdropClick\" data-cwl-on-keydown=\"action:handleBackdropKeydown\"\n>\n  <div class=\"modal-content\" role=\"document\">\n    <div class=\"modal-header\">\n      <h2>➕ Add Team Member</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"loading\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <form data-cwl-on-submit=\"action:handleSubmit\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n            <span>❌</span>\n            <span></span>\n          </div>\n\n        <div class=\"form-group\">\n          <label for=\"email\">Email Address *</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"user@example.com\"\n            required data-cwl-attr-disabled=\"loading\"\n          />\n          <p class=\"hint\">They'll receive login instructions at this email</p>\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"displayName\">Display Name (optional)</label>\n          <input\n            id=\"displayName\"\n            type=\"text\"\n            placeholder=\"John Smith\" data-cwl-attr-disabled=\"loading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"role\">Role *</label>\n          <select id=\"role\" data-cwl-attr-disabled=\"loading\">\n\n              <option value=\"admin\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['admin']\"></span>\n              </option>\n\n              <option value=\"engineer\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['engineer']\"></span>\n              </option>\n\n              <option value=\"installer\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['installer']\"></span>\n              </option>\n\n              <option value=\"helpdesk\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['helpdesk']\"></span>\n              </option>\n\n              <option value=\"support\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['support']\"></span>\n              </option>\n\n              <option value=\"viewer\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['viewer']\"></span>\n              </option>\n\n          </select>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"role\"><p class=\"role-description\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_DESCRIPTIONS[role]\"></span></p></div>\n        </div>\n\n        <div class=\"info-box\">\n          <span class=\"info-icon\">ℹ️</span>\n          <div class=\"info-content\">\n            <p><strong>What happens next:</strong></p>\n            <ul>\n              <li>User receives a welcome email at <strong>wisptools.io</strong></li>\n              <li>They can sign in with Google or create a password</li>\n              <li>Once signed in, they'll have access to your organization</li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"modal-actions\">\n          <button type=\"button\" class=\"btn btn-secondary\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"loading\" aria-label=\"Close\">\n            Cancel\n          </button>\n          <button type=\"submit\" class=\"btn btn-primary\" data-cwl-attr-disabled=\"loading\">\n\n              Add User\n\n          </button>\n        </div>\n      </form>\n\n      <div class=\"success-message\" hidden aria-hidden=\"true\">\n        <span class=\"success-icon\">✅</span>\n        <h3>User Added!</h3>\n        <p>\n          <strong></strong> has been added to your team.\n        </p>\n        <p class=\"email-note\">\n          📧 A welcome email with login instructions has been sent.\n        </p>\n      </div>\n\n  </div>\n</div></div>\n</div>\n\n  <div data-cwl-shell-key=\"showEditModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"EditUserModal\" data-cwl-lifted-component=\"EditUserModal\"><div\n  class=\"modal-backdrop\"\n  role=\"presentation\"\n  aria-hidden=\"true\"\n  tabindex=\"-1\" data-cwl-action=\"handleBackdropClick\"\n>\n  <div\n    class=\"modal-content\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"Edit user dialog\"\n    tabindex=\"0\" data-cwl-on-keydown=\"action:handleBackdropKeydown\"\n  >\n    <div class=\"modal-header\">\n      <h2>Edit User</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"loading\" aria-label=\"Close\">✕</button>\n    </div>\n\n    <div class=\"modal-body\">\n\n        <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n          <span>❌</span>\n          <span></span>\n        </div>\n\n      <div class=\"user-info-section\">\n        <div class=\"user-avatar-large\">\n\n            <div class=\"avatar-placeholder\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.displayName?.charAt(0) || user.email.charAt(0).toUpperCase()\"></span>\n            </div>\n\n            <div hidden aria-hidden=\"true\"><img />\n          </div>\n        </div>\n        <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.displayName || 'No name'\"></span></h3>\n        <p class=\"user-email\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.email\"></span></p>\n        <span class=\"status-badge status-\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.status.replace('_', ' ')\"></span></span>\n      </div>\n\n        <div class=\"form-section\">\n          <label for=\"role\">Role</label>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isOwner\"><div class=\"role-locked\">\n              <span class=\"lock-icon\">🔒</span>\n              <div>\n                <div class=\"role-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES.owner\"></span></div>\n                <div class=\"role-hint\">Owner role cannot be changed</div>\n              </div>\n            </div></div>\n            <select\n              id=\"role\" data-cwl-attr-disabled=\"loading\"\n            >\n\n                <option value=\"admin\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['admin']\"></span>\n                </option>\n\n                <option value=\"engineer\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['engineer']\"></span>\n                </option>\n\n                <option value=\"installer\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['installer']\"></span>\n                </option>\n\n                <option value=\"helpdesk\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['helpdesk']\"></span>\n                </option>\n\n                <option value=\"support\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['support']\"></span>\n                </option>\n\n                <option value=\"viewer\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['viewer']\"></span>\n                </option>\n\n            </select>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedRole !== user.role\"><button class=\"btn btn-primary btn-sm mt-2\" data-cwl-action=\"handleUpdateRole\" data-cwl-attr-disabled=\"loading\" aria-label=\"Update Role\">\n\n                  Update Role\n\n              </button></div>\n\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!isOwner\"><div class=\"actions-section\">\n            <h4>Actions</h4>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"user.status === 'active'\"><button class=\"btn btn-warning btn-block\" data-cwl-action=\"handleSuspend\" data-cwl-attr-disabled=\"loading\" aria-label=\"Suspend\">\n                🚫 Suspend User\n              </button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"user.status === 'suspended'\"><button class=\"btn btn-success btn-block\" data-cwl-action=\"handleActivate\" data-cwl-attr-disabled=\"loading\" aria-label=\"Activate\">\n                ✅ Activate User\n              </button></div>\n\n            <button class=\"btn btn-danger btn-block\" data-cwl-toggle=\"showDeleteConfirm:true\" data-cwl-attr-disabled=\"loading\" aria-label=\"Show Delete Confirm\">\n              🗑️ Remove from Organization\n            </button>\n          </div></div>\n\n        <div class=\"confirm-delete\" data-cwl-shell-key=\"showDeleteConfirm\" hidden aria-hidden=\"true\">\n          <span class=\"warning-icon\">⚠️</span>\n          <h3>Remove User?</h3>\n          <p>Are you sure you want to remove <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.email\"></span></strong> from this organization?</p>\n          <p class=\"warning-text\">This action cannot be undone.</p>\n\n          <div class=\"confirm-actions\">\n            <button class=\"btn btn-secondary\" data-cwl-toggle=\"showDeleteConfirm:false\" data-cwl-attr-disabled=\"loading\" aria-label=\"Show Delete Confirm\">\n              Cancel\n            </button>\n            <button class=\"btn btn-danger\" data-cwl-action=\"handleDelete\" data-cwl-attr-disabled=\"loading\" aria-label=\"Delete\">\n\n                Yes, Remove User\n\n            </button>\n          </div>\n        </div>\n\n    </div>\n  </div>\n</div></div>\n</div></div>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'branding'\" hidden aria-hidden=\"true\">\n          <div class=\"tab-content\">\n            <div data-cwl-component=\"BrandingManagement\" data-cwl-lifted-component=\"BrandingManagement\"><div class=\"branding-management\">\n\n    <div class=\"branding-form\">\n      <h3>Customer Portal Branding</h3>\n      <p class=\"description\">Customize your customer portal appearance and messaging</p>\n\n        <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"alert alert-success\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"form-section\">\n        <h4>Logo</h4>\n        <div class=\"form-group\">\n          <label>Logo URL</label>\n          <input\n            type=\"url\"\n            placeholder=\"https://example.com/logo.png\"\n          />\n          <small>Enter the full URL to your logo image</small>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Logo Alt Text</label>\n          <input\n            type=\"text\"\n            placeholder=\"Company Logo\"\n          />\n        </div>\n      </div>\n\n      <div class=\"form-section\">\n        <h4>Colors</h4>\n        <div class=\"form-group\">\n          <label>Primary Color</label>\n          <div class=\"color-input-group\">\n            <input\n              type=\"color\"\n            />\n            <input\n              type=\"text\"\n              placeholder=\"#3b82f6\"\n            />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Secondary Color</label>\n          <div class=\"color-input-group\">\n            <input\n              type=\"color\"\n            />\n            <input\n              type=\"text\"\n              placeholder=\"#64748b\"\n            />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Accent Color</label>\n          <div class=\"color-input-group\">\n            <input\n              type=\"color\"\n            />\n            <input\n              type=\"text\"\n              placeholder=\"#10b981\"\n            />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"form-section\">\n        <h4>Support Information</h4>\n        <div class=\"form-group\">\n          <label>Support Email</label>\n          <input\n            type=\"email\"\n            placeholder=\"support@example.com\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Support Phone</label>\n          <input\n            type=\"tel\"\n            placeholder=\"(555) 123-4567\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Support Hours</label>\n          <input\n            type=\"text\"\n            placeholder=\"Mon-Fri 8am-5pm\"\n          />\n        </div>\n      </div>\n\n      <div class=\"form-section\">\n        <h4>Portal Messages</h4>\n        <div class=\"form-group\">\n          <label>Welcome Message</label>\n          <input\n            type=\"text\"\n            placeholder=\"Welcome to our Customer Portal\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Footer Text</label>\n          <textarea\n            placeholder=\"Copyright © 2024 Company Name\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n\n      <button class=\"btn-save\" data-cwl-action=\"saveBranding\" data-cwl-attr-disabled=\"saving\" aria-label=\"Save Branding\">\n        Save Branding\n      </button>\n    </div>\n\n</div></div>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'debug'\" hidden aria-hidden=\"true\">\n          <div class=\"tab-content\">\n            <h3>🐛 Debug Mode</h3>\n            <p class=\"description\">Advanced debugging for troubleshooting with wisptools.io engineers</p>\n\n              <div class=\"debug-warning\" data-cwl-shell-key=\"showDebugWarning\" hidden aria-hidden=\"true\">\n                <div class=\"warning-header\">\n                  <span class=\"warning-icon\">⚠️</span>\n                  <strong>Warning: Debug Mode Enabled</strong>\n                </div>\n                <p>Debug mode will:</p>\n                <ul>\n                  <li>Slow down web application responses</li>\n                  <li>Generate extensive console logging</li>\n                  <li>Expose detailed system information</li>\n                </ul>\n                <p><strong>This should only be enabled when working with a wisptools.io engineer.</strong></p>\n                <button class=\"btn-acknowledge\" data-cwl-toggle=\"showDebugWarning:false\" aria-label=\"Show Debug Warning\">\n                  I Understand\n                </button>\n              </div>\n\n            <div class=\"debug-setting\">\n              <div class=\"setting-item\">\n                <div class=\"setting-info\">\n                  <label>Enable Debug Logging</label>\n                  <p class=\"setting-description\">\n                    When enabled, detailed debug information will be logged to the browser console.\n                    This includes API calls, data transformations, state changes, and system metrics.\n                    <strong>Only enable this when troubleshooting with a wisptools.io engineer.</strong>\n                  </p>\n                </div>\n                <label class=\"toggle-switch\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"toggle:showDebugWarning:true\"\n                  />\n                  <span class=\"toggle-slider\"></span>\n                </label>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"saveError\"><div class=\"error-message\">\n            ❌\n          </div></div>\n      </div>\n    </div>\n  </div>\n\n<!-- Import System Modal -->\n\n  <div data-cwl-shell-key=\"showImportSystem\" hidden aria-hidden=\"true\"><div data-cwl-component=\"ImportSystem\" data-cwl-lifted-component=\"ImportSystem\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showImportSystem\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!tenantId || tenantId.trim() === ''\"><div class=\"import-overlay\" data-cwl-action=\"close\">\n      <div class=\"import-panel\">\n        <div class=\"import-header\">\n          <h2>📥 Import Data</h2>\n          <button class=\"close-btn\" data-cwl-action=\"close\" aria-label=\"Close\">✕</button>\n        </div>\n        <div class=\"import-content\">\n          <div class=\"alert alert-error\">\n            <span>❌</span>\n            <span>No tenant selected. Please select a tenant before importing data.</span>\n          </div>\n          <div class=\"import-actions\">\n            <button class=\"btn-primary\" data-cwl-action=\"close\" aria-label=\"Close\">Close</button>\n          </div>\n        </div>\n      </div>\n    </div></div>\n    <div class=\"import-overlay\" data-cwl-action=\"close\">\n      <div class=\"import-panel\">\n      <div class=\"import-header\">\n        <h2>📥 Import Data</h2>\n        <button class=\"close-btn\" data-cwl-action=\"close\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <div class=\"import-content\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n            <span>❌</span>\n            <span></span>\n            <button data-cwl-set=\"error:\">✕</button>\n          </div>\n\n          <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n            <span>✓</span>\n            <span></span>\n            <button data-cwl-set=\"success:\">✕</button>\n          </div>\n\n          <div data-cwl-shell-key=\"showPreview\" hidden aria-hidden=\"true\"><!-- Step 1: Select Import Type -->\n          <div class=\"import-step\">\n            <h3>1. Select Data Type to Import</h3>\n            <p class=\"step-description\">Choose the type of data you want to import</p>\n\n            <div class=\"import-types-grid\">\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:inventory\"\n                >\n                  <span class=\"icon\">📦</span>\n                  <span class=\"label\">Inventory Items</span>\n                  <span class=\"description\">Import hardware inventory items</span>\n                </button>\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:customers\"\n                >\n                  <span class=\"icon\">👥</span>\n                  <span class=\"label\">Customers</span>\n                  <span class=\"description\">Import customer records</span>\n                </button>\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:plans\"\n                >\n                  <span class=\"icon\">🗺️</span>\n                  <span class=\"label\">Plans/Projects</span>\n                  <span class=\"description\">Import deployment plans</span>\n                </button>\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:sites\"\n                >\n                  <span class=\"icon\">🏗️</span>\n                  <span class=\"label\">Sites/Towers</span>\n                  <span class=\"description\">Import tower sites</span>\n                </button>\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:network-equipment\"\n                >\n                  <span class=\"icon\">📡</span>\n                  <span class=\"label\">Network Equipment</span>\n                  <span class=\"description\">Import network equipment</span>\n                </button>\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:work-orders\"\n                >\n                  <span class=\"icon\">📋</span>\n                  <span class=\"label\">Work Orders</span>\n                  <span class=\"description\">Import work orders</span>\n                </button>\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:users\"\n                >\n                  <span class=\"icon\">👤</span>\n                  <span class=\"label\">Users</span>\n                  <span class=\"description\">Import user accounts</span>\n                </button>\n\n                <button\n                  class=\"import-type-card\" data-cwl-set=\"selectedImportType:bundles\"\n                >\n                  <span class=\"icon\">📚</span>\n                  <span class=\"label\">Hardware Bundles</span>\n                  <span class=\"description\">Import hardware bundles</span>\n                </button>\n\n            </div>\n          </div>\n\n          <!-- Step 2: Download Template or Upload File -->\n          <div class=\"import-step\">\n            <h3>2. Prepare Your Data</h3>\n            <p class=\"step-description\">Download a template or upload your CSV file</p>\n\n            <div class=\"template-actions\">\n              <button class=\"btn-download\" data-cwl-action=\"downloadTemplate\" aria-label=\"Download Template\">\n                📄 Download CSV Template\n              </button>\n            </div>\n\n            <div class=\"upload-section\">\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!uploadedFile\"><div class=\"dropzone\" data-cwl-action=\"handleFileSelect\">\n                  <div class=\"dropzone-content\">\n                    <span class=\"dropzone-icon\">📁</span>\n                    <p>Click to select CSV file</p>\n                    <p class=\"hint\">or drag and drop</p>\n                    <p class=\"file-types\">Supported: .csv</p>\n                  </div>\n                </div>\n                <input\n                  type=\"file\"\n                  accept=\".csv\" data-cwl-on-change=\"action:handleFileChange\"\n                  style=\"display: none;\"\n                /></div>\n                <div class=\"file-selected\">\n                  <span class=\"file-icon\">📄</span>\n                  <div class=\"file-info\">\n                    <span class=\"file-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"uploadedFile.name\"></span></span>\n                    <span class=\"file-size\">(<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"(uploadedFile.size / 1024).toFixed(2)\"></span> KB)</span>\n                  </div>\n                  <button class=\"btn-remove\" data-cwl-toggle=\"showPreview:false\" aria-label=\"Show Preview\">✕</button>\n                </div>\n\n            </div>\n          </div>\n        </div>\n\n        <!-- Step 3: Preview and Validate -->\n\n          <div class=\"import-step\" data-cwl-shell-key=\"showPreview\" hidden aria-hidden=\"true\">\n            <h3>3. Review & Import</h3>\n            <p class=\"step-description\">Review your data and fix any errors before importing</p>\n\n            <div class=\"preview-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-label\">Total Rows:</span>\n                <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"parsedData.length\"></span></span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-label\">Preview:</span>\n                <span class=\"stat-value\">First <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"previewData.length\"></span> rows</span>\n              </div>\n\n                <div class=\"stat error-stat\">\n                  <span class=\"stat-label\">Errors:</span>\n                  <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"validationErrors.length\"></span></span>\n                </div>\n\n            </div>\n\n              <div class=\"validation-errors\">\n                <h4>Validation Errors</h4>\n                <div class=\"errors-list\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"validationErrors.slice(0, 10) as err\"><div class=\"error-item\">\n                      <span class=\"error-row\">Row </span>\n                      <span class=\"error-field\">:</span>\n                      <span class=\"error-message\"></span>\n\n                        <div hidden aria-hidden=\"true\"><span class=\"error-value\">(Value: )</span>\n                      </div>\n                    </div></div>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"validationErrors.length > 10\"><p class=\"more-errors\">... and <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"validationErrors.length - 10\"></span> more errors</p></div>\n                </div>\n              </div>\n\n            <div class=\"preview-table\">\n              <div class=\"table-wrapper\">\n                <table>\n                  <thead>\n                    <tr>\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"getTableHeaders() as header\"><th></th></div>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"previewData as row\" data-cwl-each-item=\"row\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20getTableHeaders()%20as%20header%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Brow%5Bheader%5D%20%7C%7C%20'-'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"getTableHeaders() as header\"><td></td></div>\n                      </tr></div>\n                  </tbody>\n                </table>\n              </div>\n            </div>\n\n            <div class=\"import-actions\">\n              <button class=\"btn-secondary\" data-cwl-toggle=\"showPreview:false\" aria-label=\"Show Preview\">\n                Cancel\n              </button>\n              <button\n                class=\"btn-primary\" data-cwl-action=\"performImport\" data-cwl-attr-disabled=\"validationErrors.length  aria-label=&quot;Perform Import&quot;&gt; 0\"\n              >\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"validationErrors.length > 0\n                  ? `Fix  \"></span>\n              </button>\n            </div>\n          </div>\n\n        <!-- Step 4: Import Progress -->\n\n        <!-- Step 5: Import Results -->\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importResults && !importing\"><div class=\"import-step\">\n            <h3>5. Import Complete</h3>\n\n            <div class=\"import-results\">\n              <div class=\"result-stat success-stat\">\n                <span class=\"result-icon\">✓</span>\n                <span class=\"result-label\">Imported:</span>\n                <span class=\"result-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"importResults.imported\"></span></span>\n              </div>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importResults.failed > 0\"><div class=\"result-stat error-stat\">\n                  <span class=\"result-icon\">✕</span>\n                  <span class=\"result-label\">Failed:</span>\n                  <span class=\"result-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"importResults.failed\"></span></span>\n                </div></div>\n            </div>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importResults.errors && importResults.errors.length > 0\"><div class=\"import-errors\">\n                <h4>Import Errors</h4>\n                <div class=\"errors-list\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"importResults.errors.slice(0, 10) as err\"><div class=\"error-item\">\n                      <span class=\"error-row\">Row :</span>\n                      <span class=\"error-message\"></span>\n                    </div></div>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importResults.errors.length > 10\"><p class=\"more-errors\">... and <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"importResults.errors.length - 10\"></span> more errors</p></div>\n                </div>\n              </div></div>\n\n            <div class=\"import-actions\">\n              <button class=\"btn-primary\" data-cwl-action=\"close\" aria-label=\"Close\">\n                Close\n              </button>\n            </div>\n          </div></div>\n      </div>\n    </div>\n  </div></div></div>\n</div></div></div>\n    <div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showTipsModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div></div>\n\n    <!-- Main Content -->\n    <div class=\"main-content\">\n      <!-- Core Modules -->\n      <div class=\"modules-section\">\n        <div class=\"modules-grid\">\n\n            <div\n              class=\"module-card active\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n              role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open 📋 Plan. Interactive map-based planning tools for network expansion\"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\">📋 Plan</h3>\n              </div>\n\n              <div class=\"module-features\">\n                <ul>\n\n                    <li>Coverage Analysis</li>\n\n                    <li>Site Planning</li>\n\n                    <li>Inventory Check</li>\n\n                    <li>CBRS Spectrum</li>\n\n                    <li>Capacity Planning</li>\n\n                    <li>Cost Analysis</li>\n\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n\n                  <span class=\"status-badge active\">Active</span>\n\n              </div>\n            </div>\n\n            <div\n              class=\"module-card active\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n              role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open 🚀 Deploy. Interactive map-based deployment tools for network rollouts\"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\">🚀 Deploy</h3>\n              </div>\n\n              <div class=\"module-features\">\n                <ul>\n\n                    <li>PCI Resolution</li>\n\n                    <li>ACS CPE Management</li>\n\n                    <li>Work Orders</li>\n\n                    <li>Installation Management</li>\n\n                    <li>Equipment Configuration</li>\n\n                    <li>Quality Assurance</li>\n\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n\n                  <span class=\"status-badge active\">Active</span>\n\n              </div>\n            </div>\n\n            <div\n              class=\"module-card active\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n              role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open 📊 Monitor. Interactive map-based monitoring tools for network oversight\"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\">📊 Monitor</h3>\n              </div>\n\n              <div class=\"module-features\">\n                <ul>\n\n                    <li>Network Monitoring</li>\n\n                    <li>Device Health</li>\n\n                    <li>Traffic Analysis</li>\n\n                    <li>Performance Analytics</li>\n\n                    <li>Alert Management</li>\n\n                    <li>HSS Management</li>\n\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n\n                  <span class=\"status-badge active\">Active</span>\n\n              </div>\n            </div>\n\n            <div\n              class=\"module-card active\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n              role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open 🔧 Maintain. Traditional interface for ticketing and maintenance management\"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\">🔧 Maintain</h3>\n              </div>\n\n              <div class=\"module-features\">\n                <ul>\n\n                    <li>Ticketing System</li>\n\n                    <li>Preventive Maintenance</li>\n\n                    <li>Incident Management</li>\n\n                    <li>Customer Support</li>\n\n                    <li>Vendor Management</li>\n\n                    <li>Knowledge Base</li>\n\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n\n                  <span class=\"status-badge active\">Active</span>\n\n              </div>\n            </div>\n\n            <div\n              class=\"module-card active\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n              role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open 👥 Customers. Manage customers and the customer portal\"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\">👥 Customers</h3>\n              </div>\n\n              <div class=\"module-features\">\n                <ul>\n\n                    <li>Customer Database</li>\n\n                    <li>Customer Portal</li>\n\n                    <li>Service Management</li>\n\n                    <li>Installation History</li>\n\n                    <li>Customer Support</li>\n\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n\n                  <span class=\"status-badge active\">Active</span>\n\n              </div>\n            </div>\n\n            <div\n              class=\"module-card active\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n              role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open 🔧 Hardware. Comprehensive equipment and hardware management system\"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\">🔧 Hardware</h3>\n              </div>\n\n              <div class=\"module-features\">\n                <ul>\n\n                    <li>Equipment Inventory</li>\n\n                    <li>Asset Tracking</li>\n\n                    <li>Hardware Management</li>\n\n                    <li>Status Monitoring</li>\n\n                    <li>Location Tracking</li>\n\n                    <li>Maintenance Records</li>\n\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n\n                  <span class=\"status-badge active\">Active</span>\n\n              </div>\n            </div>\n\n            <div\n              class=\"module-card active\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n              role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open 📞 Voice / SIP. Telephone numbers, carrier linkage, E911, and number porting (LNP)\"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\">📞 Voice / SIP</h3>\n              </div>\n\n              <div class=\"module-features\">\n                <ul>\n\n                    <li>Provider accounts</li>\n\n                    <li>TN inventory</li>\n\n                    <li>E911 status</li>\n\n                    <li>Port orders</li>\n\n                    <li>Domain reference</li>\n\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n\n                  <span class=\"status-badge active\">Active</span>\n\n              </div>\n            </div>\n\n        </div>\n      </div>\n\n      <!-- Admin Modules -->\n\n        <div class=\"admin-section\">\n          <h2 class=\"section-title\">Administration</h2>\n          <div class=\"admin-modules\">\n\n              <div\n                class=\"admin-card\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n                role=\"button\"\n                tabindex=\"0\"\n                aria-label=\"Open ⚙️ Admin Management. User and tenant management for owners and administrators\"\n              >\n                <div class=\"admin-icon\" style=\"background-color: var(--text-secondary)20; color: var(--text-secondary)\">\n                  ⚙️\n                </div>\n                <div class=\"admin-info\">\n                  <h3 class=\"admin-name\">⚙️ Admin Management</h3>\n                  <p class=\"admin-description\">User and tenant management for owners and administrators</p>\n                </div>\n              </div>\n\n              <div\n                class=\"admin-card\" data-cwl-action=\"handleModuleClick\" data-cwl-action-args=\"module\" data-cwl-on-keydown=\"action:handleModuleClick\" data-cwl-on-keydown-args=\"module\"\n                role=\"button\"\n                tabindex=\"0\"\n                aria-label=\"Open 🔧 System Management. System-wide tenant management and deletion (Platform Admin Only)\"\n              >\n                <div class=\"admin-icon\" style=\"background-color: #f4433620; color: #f44336\">\n                  🔧\n                </div>\n                <div class=\"admin-info\">\n                  <h3 class=\"admin-name\">🔧 System Management</h3>\n                  <p class=\"admin-description\">System-wide tenant management and deletion (Platform Admin Only)</p>\n                </div>\n              </div>\n\n          </div>\n        </div>\n\n      <!-- Footer: License + GitHub -->\n      <footer class=\"app-footer\">\n        <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a>\n        <span class=\"sep\">·</span>\n        <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener noreferrer\">CC BY 4.0</a>\n      </footer>\n    </div>\n  </div></div>";
}

@page GET "/debug-tenants"
page debug_tenants_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/debug-tenants" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"debug-tenants\" data-wisp-path=\"/debug-tenants\" data-cwl-island=\"client\"><div class=\"debug-container\">\n  <h1>Tenant Debug Information</h1>\n\n  <div class=\"debug-section\">\n    <h2>Authentication Status</h2>\n    <p><strong>Is Authenticated:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"debugInfo.isAuthenticated\"></span></p>\n    <p><strong>User Email:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"debugInfo.currentUser?.email || 'None'\"></span></p>\n    <p><strong>User UID:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"debugInfo.currentUser?.uid || 'None'\"></span></p>\n  </div>\n\n  <div class=\"debug-section\">\n    <h2>Tenant Store State</h2>\n    <pre><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"JSON.stringify(debugInfo.tenantState, null, 2)\"></span></pre>\n  </div>\n\n  <div class=\"debug-section\">\n    <h2>User Tenants (Direct API Call)</h2>\n    <p><strong>Count:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"debugInfo.userTenants.length\"></span></p>\n    <pre><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"JSON.stringify(debugInfo.userTenants, null, 2)\"></span></pre>\n  </div>\n\n    <div class=\"debug-section error\" hidden aria-hidden=\"true\">\n      <h2>Error</h2>\n      <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"debugInfo.error\"></span></p>\n    </div>\n\n</div></div>";
}

@page GET "/demo"
page demo_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/demo" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"demo\" data-wisp-path=\"/demo\" data-cwl-island=\"client\"><div class=\"wrap\">\n    <header class=\"hero\">\n      <h1>Demo walkthrough</h1>\n      <p class=\"lead\">\n        Seeded records use prefixes <code>CUST-DEMO-*</code>, <code>TKT-DEMO-*</code>,\n        <code>INC-DEMO-*</code>, <code>DEMO-SN-*</code>. Prefer editing and resolving over deleting.\n        Use one pre-provisioned demo login — see the operator runbook in the repo.\n      </p>\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$currentTenant\"><p class=\"tenant\">\n          Organization: <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.displayName\"></span></strong>\n          <span class=\"muted\">(<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.id\"></span>)</span>\n        </p></div>\n    </header>\n\n    <div class=\"grid\">\n\n        <a class=\"card\" href=\"/modules/customers\">\n          <h2>Customers</h2>\n          <p>Browse Alex Rivera, Jordan Chen, and the sample lead.</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"'Try edit / search — data is real MongoDB.'\"><span class=\"hint\">Try edit / search — data is real MongoDB.</span></div>\n        </a>\n\n        <a class=\"card\" href=\"/modules/work-orders\">\n          <h2>Work orders</h2>\n          <p>Open TKT-DEMO-001 and TKT-DEMO-002.</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"'Status and assignment update through the API.'\"><span class=\"hint\">Status and assignment update through the API.</span></div>\n        </a>\n\n        <a class=\"card\" href=\"/modules/maintain\">\n          <h2>Maintain (incidents)</h2>\n          <p>INC-DEMO-001 and INC-DEMO-002 under Incidents.</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"'Switch to the Incidents tab after opening.'\"><span class=\"hint\">Switch to the Incidents tab after opening.</span></div>\n        </a>\n\n        <a class=\"card\" href=\"/modules/inventory\">\n          <h2>Inventory</h2>\n          <p>Warehouse spare and deployed CPE demo rows.</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"'Filter by serial DEMO-SN-*'\"><span class=\"hint\">Filter by serial DEMO-SN-*</span></div>\n        </a>\n\n        <a class=\"card\" href=\"/modules/monitoring\">\n          <h2>Monitoring</h2>\n          <p>Dashboard shell (live metrics may be empty on demo).</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"'Use after SNMP/ping agents if configured.'\"><span class=\"hint\">Use after SNMP/ping agents if configured.</span></div>\n        </a>\n\n        <a class=\"card\" href=\"/dashboard\">\n          <h2>Dashboard</h2>\n          <p>Return to the main module grid.</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"''\"><span class=\"hint\"></span></div>\n        </a>\n\n    </div>\n\n    <section class=\"doc\">\n      <h2>Documentation (repository)</h2>\n      <ul>\n        <li>\n          Demo visitor (IP login, limits, purge on logout):\n          <code>docs/deployment/DEMO_VISITOR.md</code>\n        </li>\n        <li>\n          Operator runbook (logins, isolation, feature matrix, reset policy):\n          <code>docs/deployment/DEMO_RUNBOOK.md</code>\n        </li>\n        <li>\n          Seed &amp; env:\n          <code>scripts/demo/README.md</code>\n        </li>\n        <li>\n          Deploy:\n          <code>docs/deployment/DEMO_SITE.md</code>\n        </li>\n      </ul>\n    </section>\n  </div></div>";
}

@page GET "/docs"
page docs_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/docs" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"docs\" data-wisp-path=\"/docs\" data-cwl-island=\"client\">\n\n<h1>WISP Management Documentation</h1>\n<p class=\"lead\">Documentation is integrated into the app. Use the sidebar or the links below.</p>\n\n<section class=\"doc-section\">\n  <h2>Quick links</h2>\n  <ul>\n    <li><a href=\"/help\">Getting Started</a> – New users and administrators.</li>\n    <li><a href=\"/help\">Using WISP Management</a> – For end users: dashboard, wizards, help.</li>\n    <li><a href=\"/help\">Project Status & Next Steps</a> – Current status and what to work on next.</li>\n    <li><a href=\"/help\">Help by topic</a> – Module-specific help (Inventory, ACS, Deploy, Plan, etc.).</li>\n    <li><a href=\"/wizards\">Wizards</a> – Guided flows (sites, subscribers, customers, RMA, plans, groups, troubleshooting).</li>\n  </ul>\n</section>\n\n<section class=\"doc-section\">\n  <h2>What is WISP Management?</h2>\n  <p>WISP Management is the main app on wisptools.io for LTE WISP operations:</p>\n  <ul>\n    <li><strong>Multi-tenant</strong> – Manage multiple organizations</li>\n    <li><strong>HSS</strong> – Home Subscriber Server for Open5GS</li>\n    <li><strong>Device management</strong> – network equipment and CPE inventory</li>\n    <li><strong>Network planning</strong> – Coverage mapping, PCI resolution</li>\n    <li><strong>Monitoring</strong> – SNMP and performance graphs</li>\n    <li><strong>CBRS/SAS</strong> – Spectrum Access System integration</li>\n  </ul>\n</section>\n\n<section class=\"doc-section\">\n  <h2>In-app help</h2>\n  <p>Each module (Inventory, Deploy, ACS CPE, HSS, Plan, Coverage Map, CBRS, PCI Resolution, Monitoring) has a <strong>Help</strong> button that opens module-specific documentation. The <a href=\"/help\">Help by topic</a> page lists all topics in one place. For reference and project status, use the sidebar or <a href=\"/docs/reference/project-status\">Project Status &amp; Next Steps</a>.</p>\n</section></div>";
}

@page GET "/docs/deployment"
page docs_deployment_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/docs/deployment" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"docs-deployment\" data-wisp-path=\"/docs/deployment\" data-cwl-island=\"client\">\n\n<h1>Using WISP Management</h1>\n<p class=\"lead\">Your organization’s WISP Management instance is set up and managed by your administrator. This page is for end users.</p>\n\n<section class=\"doc-section\">\n  <h2>What you can do</h2>\n  <ul>\n    <li><strong>Dashboard</strong> – Open modules (Plan, Deploy, Monitor, Maintain, Customers, Hardware) and use <strong>Wizards</strong> for guided flows.</li>\n    <li><strong>Wizards</strong> – Use the <strong>Wizards</strong> menu on the dashboard or go to <a href=\"/wizards\">/wizards</a> to see all guided flows (sites, subscribers, customers, RMA, plans, groups, troubleshooting).</li>\n    <li><strong>Documentation</strong> – Use <a href=\"/help\">Help</a> for getting started and project status.</li>\n    <li><strong>Help</strong> – Use <a href=\"/help\">Help by topic</a> for module-specific guidance.</li>\n  </ul>\n</section>\n\n<section class=\"doc-section\">\n  <h2>Need access or changes?</h2>\n  <p>For new accounts, access to modules, or platform changes, contact your WISP Management administrator.</p>\n  <p><a href=\"/help\">← Help & Documentation</a></p>\n</section></div>";
}

@page GET "/docs/getting-started"
page docs_getting_started_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/docs/getting-started" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"docs-getting-started\" data-wisp-path=\"/docs/getting-started\" data-cwl-island=\"client\">\n\n<h1>Getting Started</h1>\n<p class=\"lead\">Welcome to WISP Management. This guide helps you get started with the LTE WISP platform on wisptools.io.</p>\n\n<section class=\"doc-section\">\n  <h2>What is WISP Management?</h2>\n  <p>WISP Management is the main app on wisptools.io for LTE WISPs. It provides:</p>\n  <ul>\n    <li><strong>Multi-tenant architecture</strong> – Manage multiple organizations</li>\n    <li><strong>HSS management</strong> – Home Subscriber Server for Open5GS</li>\n    <li><strong>Device management</strong> – network equipment and CPE inventory</li>\n    <li><strong>Network planning</strong> – Coverage mapping and PCI collision prevention</li>\n    <li><strong>Monitoring</strong> – SNMP monitoring and performance graphs</li>\n    <li><strong>CBRS/SAS</strong> – Spectrum Access System integration</li>\n  </ul>\n</section>\n\n<section class=\"doc-section\">\n  <h2>Quick start</h2>\n  <h3>For new users</h3>\n  <ol>\n    <li><strong>Create an account</strong> – Complete registration and verify your email.</li>\n    <li><strong>Set up your first tenant</strong> – Configure organization details and subscription.</li>\n    <li><strong>Use the platform</strong> – Open the <a href=\"/dashboard\">dashboard</a>, explore modules, and start managing your network.</li>\n  </ol>\n  <h3>For administrators</h3>\n  <ol>\n    <li><strong>Deploy the platform</strong> – Follow the <a href=\"/help\">deployment guide</a>; set up backend and frontend.</li>\n    <li><strong>Configure HSS</strong> – Set up Open5GS and connect MMEs (see repo <code>docs/</code> for admin guides).</li>\n    <li><strong>Manage tenants</strong> – Use Admin Management from the dashboard; configure modules and user roles.</li>\n  </ol>\n</section>\n\n<section class=\"doc-section\">\n  <h2>Next steps</h2>\n  <ul>\n    <li><a href=\"/help\">Help & Documentation</a></li>\n    <li><a href=\"/help\">Deployment</a></li>\n    <li><a href=\"/help\">Project status & next steps</a></li>\n    <li><a href=\"/help\">Help by topic</a></li>\n    <li><a href=\"/wizards\">Wizards</a> – Guided flows for sites, subscribers, customers, RMA, plans, groups</li>\n  </ul>\n</section></div>";
}

@page GET "/docs/reference"
page docs_reference_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/docs/reference" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"docs-reference\" data-wisp-path=\"/docs/reference\" data-cwl-island=\"client\">\n\n<h1>Reference</h1>\n<p>Reference documentation for status, deployment, and planning.</p>\n\n<ul class=\"ref-list\">\n  <li><a href=\"/help\">Project Status & Next Steps</a> – Where the project stands and prioritized next items.</li>\n</ul></div>";
}

@page GET "/docs/reference/project-status"
page docs_reference_project_status_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/docs/reference/project-status" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"docs-reference-project-status\" data-wisp-path=\"/docs/reference/project-status\" data-cwl-island=\"client\"><article class=\"doc-article\">\n  <h1>Project Status & Next Steps</h1>\n  <p class=\"intro\">This page summarizes where the project stands and what to work on next. For the full lists, see the markdown files in the repository <code>docs/</code> folder.</p>\n  <div class=\"doc-body\">\n\n<h2>Where We Are</h2>\n<ul>\n  <li><strong>Frontend:</strong> Firebase Hosting. Deploy: <code>npm run build</code> in Module_Manager, then <code>firebase deploy --only hosting:app</code>.</li>\n  <li><strong>Backend:</strong> GCE VM. Deploy: <code>deploy-backend-to-gce.ps1</code> (Upload or Git).</li>\n  <li><strong>Functions:</strong> <code>firebase deploy --only functions</code>.</li>\n  <li><strong>Wizards:</strong> All 19+ wizards implemented and in-app (Site/Deployment, Subscriber/Plan/Group, RMA, Customer Onboarding, Conflict Resolution, CBRS Device Registration, Organization Setup, Initial Configuration, Troubleshooting, Device Onboarding, etc.). Access via <code>/wizards</code> or each module’s wizard menu.</li>\n  <li><strong>Customer form:</strong> Add/Edit Customer includes service type (4G/5G, FWA, WiFi, Fiber), LTE auth (IMSI, Ki, OPc), MAC address, and QoS.</li>\n  <li><strong>Customer Portal:</strong> Branding (Portal Setup), tickets, billing (Stripe/PayPal, invoices), FAQ, KB, service status, live-chat placeholder. Routes at <code>/modules/customers/portal/*</code>.</li>\n  <li><strong>Documentation:</strong> Integrated at <code>/help</code> and <code>/docs</code>; key repo docs have frontmatter. API_BASE_URL documented in <code>.env.example</code> and deployment docs.</li>\n</ul>\n\n<h2>Next Items (Optional / Polish)</h2>\n<ol>\n  <li><strong>Documentation:</strong> Add frontmatter to more <code>docs/</code> files; fix any broken links; optional code examples and diagrams.</li>\n  <li><strong>Customer Portal:</strong> Optional live chat integration, KB search enhancements.</li>\n  <li><strong>ACS:</strong> Optional alert email/SMS integration; device grouping/tags.</li>\n  <li><strong>Optional:</strong> Connection topology (ArcGIS), advanced alerting, field app branded icon.</li>\n</ol>\n\n<h2>Key Docs in Repository</h2>\n<p>In the repo <code>docs/</code> folder:</p>\n<ul>\n  <li><strong>docs/README.md</strong> – Master documentation index (status, operational setup, full index).</li>\n  <li><strong>docs/WHERE_WE_ARE_AND_NEXT_STEPS.md</strong> – Snapshot and prioritized next steps.</li>\n  <li><strong>docs/NEXT_ITEMS_TO_ADD.md</strong> – Full list: wizards, portal, billing, ACS, docs (all implemented or optional).</li>\n  <li><strong>docs/OPTIONAL_ITEMS.md</strong> – Optional work only (documentation, portal, ACS, monitoring, field app, reporting).</li>\n  <li><strong>docs/WHATS_MISSING_IN_APP.md</strong> – One-page checklist (done vs remaining).</li>\n  <li><strong>docs/PROJECT_WORKFLOW_STATUS.md</strong> – Plan/deploy/field app workflow status.</li>\n  <li><strong>docs/BILLING_CRON_AND_DUNNING_SCHEDULE.md</strong> – Billing automation (cron or Cloud Scheduler).</li>\n  <li><strong>docs/FIELD_APP_DOWNLOAD.md</strong> – Field App APK build and download URL.</li>\n</ul>\n<p>These are the single source of truth for planning, status, and operational setup.</p>\n\n  </div>\n</article></div>";
}

@page GET "/help"
page help_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/help" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"help\" data-wisp-path=\"/help\" data-cwl-island=\"client\"><div class=\"help-container\">\n  <div class=\"help-header\">\n    <button type=\"button\" class=\"help-back-link\" title=\"Back to main app\" data-cwl-nav=\"/dashboard\">← Back to main app</button>\n    <div class=\"help-header-brand\">\n      <div class=\"help-logo-section\">\n        <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"help-logo\" />\n        <div class=\"help-branding\">\n          <h1 class=\"help-app-title\">WISP Management</h1>\n          <p class=\"help-app-subtitle\">Documentation</p>\n        </div>\n      </div>\n    </div>\n    <p class=\"help-header-desc\">Complete guide to using the platform. Use the Help button in each module for context-specific tips.</p>\n    <p class=\"help-docs-link\"><a href=\"/docs\">Reference &amp; Project Status → /docs</a></p>\n  </div>\n\n  <div class=\"help-layout\">\n    <aside class=\"help-sidebar\">\n      <nav>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:overview\"\n          >\n            <span class=\"topic-title\">Overview</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:getting-started\"\n          >\n            <span class=\"topic-title\">Getting Started</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:user-management\"\n          >\n            <span class=\"topic-title\">User Management</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:help-desk\"\n          >\n            <span class=\"topic-title\">Help Desk</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:work-orders\"\n          >\n            <span class=\"topic-title\">Work Orders</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:customers-portal\"\n          >\n            <span class=\"topic-title\">Customers & Portal</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:inventory\"\n          >\n            <span class=\"topic-title\">Inventory</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:coverage-map\"\n          >\n            <span class=\"topic-title\">Coverage Map</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:hss-subscribers\"\n          >\n            <span class=\"topic-title\">HSS & Subscribers</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:pci-resolution\"\n          >\n            <span class=\"topic-title\">PCI Resolution</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:cbrs\"\n          >\n            <span class=\"topic-title\">CBRS Management</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:wizards\"\n          >\n            <span class=\"topic-title\">Wizards & Quick Actions</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:roles\"\n          >\n            <span class=\"topic-title\">User Roles</span>\n          </button>\n\n          <button\n            class=\"topic-btn\" data-cwl-set=\"selectedTopic:troubleshooting\"\n          >\n            <span class=\"topic-title\">Troubleshooting</span>\n          </button>\n\n      </nav>\n    </aside>\n\n    <main class=\"help-content\">\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'overview'\">\n        <article>\n          <h2>Welcome to WISP Multitool</h2>\n          <p class=\"lead\">Your complete wireless ISP management platform.</p>\n\n          <section>\n            <h3>What is WISP Multitool?</h3>\n            <p><strong>WISP Multitool</strong> is an all-in-one platform designed for wireless Internet service providers (WISPs) to manage every aspect of their operations:</p>\n\n            <ul>\n              <li><strong>Network Planning</strong> - PCI resolution, CBRS spectrum, coverage mapping</li>\n              <li><strong>Field Operations</strong> - Mobile app for technicians, work orders, inventory</li>\n              <li><strong>Customer Support</strong> - Help desk ticketing, subscriber management</li>\n              <li><strong>Customers & Portal</strong> - Customer records, branded customer portal, billing, support tickets</li>\n              <li><strong>Device Management</strong> - ACS/TR-069 CPE management, HSS subscriber auth</li>\n              <li><strong>Team Management</strong> - Role-based access, user invitations, permissions</li>\n              <li><strong>Wizards & Quick Tips</strong> - Guided wizards (site deployment, subscribers, RMA, onboarding) and in-module help</li>\n            </ul>\n          </section>\n\n          <section>\n            <h3>Platform Components</h3>\n\n            <div class=\"component-grid\">\n              <div class=\"component-card\">\n                <div class=\"component-icon\">🌐</div>\n                <h4>Web Platform</h4>\n                <p>Browser-based management console for administrators, engineers, and support staff.</p>\n              </div>\n\n              <div class=\"component-card\">\n                <div class=\"component-icon\">📱</div>\n                <h4>Mobile App</h4>\n                <p>Android app for field technicians with work orders, equipment scanning, and GPS navigation.</p>\n              </div>\n\n              <div class=\"component-card\">\n                <div class=\"component-icon\">☁️</div>\n                <h4>Cloud Backend</h4>\n                <p>Scalable cloud backend for APIs, push notifications, and data storage.</p>\n              </div>\n            </div>\n          </section>\n\n          <section>\n            <h3>Who Uses WISP Multitool?</h3>\n\n            <div class=\"role-cards\">\n              <div class=\"role-card\">\n                <h4>🏢 Owner / Admin</h4>\n                <p>Manage users, configure system, view all modules, control organization settings.</p>\n              </div>\n\n              <div class=\"role-card\">\n                <h4>👷 Network Engineer</h4>\n                <p>Plan network coverage, configure CBRS, manage HSS subscribers, optimize PCI.</p>\n              </div>\n\n              <div class=\"role-card\">\n                <h4>🔧 Field Technician</h4>\n                <p>Use mobile app for work orders, equipment deployment, inventory checkout, site visits.</p>\n              </div>\n\n              <div class=\"role-card\">\n                <h4>🎧 Help Desk</h4>\n                <p>Create support tickets, assist customers, lookup subscribers, troubleshoot CPE devices.</p>\n              </div>\n            </div>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'getting-started'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>🚀 Getting Started</h2>\n\n          <section>\n            <h3>1. First Login</h3>\n            <ol>\n              <li>Navigate to the platform URL</li>\n              <li>Click <strong>\"Sign in with Google\"</strong></li>\n              <li>Authorize with your Google account</li>\n              <li>Select or create your organization (tenant)</li>\n            </ol>\n          </section>\n\n          <section>\n            <h3>2. Dashboard Overview</h3>\n            <p>After login, you'll see the main dashboard with module cards and a header with:</p>\n            <ul>\n              <li><strong>Docs</strong> (top right) - Opens this help page</li>\n              <li><strong>Settings</strong> - Theme (light/dark), branding, module access, tenant options</li>\n              <li><strong>Notifications</strong> - In-app and optional browser notifications (enable in the panel)</li>\n              <li><strong>Quick access</strong> dropdown - Jump to wizards (Plan, Deploy, CBRS, Customers, HSS, Inventory, etc.)</li>\n            </ul>\n            <p>Module cards include: <strong>PCI Resolution</strong>, <strong>CBRS Management</strong>, <strong>ACS CPE Management</strong>, <strong>HSS Management</strong>, <strong>Coverage Map</strong>, <strong>Inventory</strong>, <strong>Work Orders</strong>, <strong>Help Desk</strong>, <strong>Customers</strong>, <strong>User Management</strong>, and more.</p>\n            <p><em>Note: Available modules depend on your user role and tenant configuration. First-time visitors see quick tips (Field App, Docs, Quick access).</em></p>\n          </section>\n\n          <section>\n            <h3>3. Inviting Team Members</h3>\n            <ol>\n              <li>Go to <strong>User Management</strong> module</li>\n              <li>Click <strong>\"Invite User\"</strong></li>\n              <li>Enter email address</li>\n              <li>Select role (Admin, Engineer, Installer, Help Desk, Viewer)</li>\n              <li>Click <strong>\"Send Invitation\"</strong></li>\n              <li>User receives email and can accept invitation</li>\n            </ol>\n          </section>\n\n          <section>\n            <h3>4. Mobile App Setup</h3>\n            <p><strong>For Field Technicians:</strong></p>\n            <ol>\n              <li>Install <strong>WISP Multitool</strong> APK on Android device</li>\n              <li>Open app and grant permissions (Camera, Location, Notifications)</li>\n              <li>Login with same Google account as web platform</li>\n              <li>Select your organization</li>\n              <li>Start receiving work orders!</li>\n            </ol>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'user-management'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>👥 User Management</h2>\n          <p class=\"lead\">Manage your team members, roles, and permissions.</p>\n\n          <section>\n            <h3>Inviting Users</h3>\n            <ol>\n              <li>Navigate to <code>/modules/user-management</code></li>\n              <li>Click <strong>\"Invite User\"</strong> button</li>\n              <li>Enter user's email address</li>\n              <li>Select appropriate role:\n                <ul>\n                  <li><strong>Admin</strong> - Can manage users and configure modules</li>\n                  <li><strong>Engineer</strong> - Access to technical/network modules</li>\n                  <li><strong>Field Technician</strong> - Mobile app and field operations</li>\n                  <li><strong>Help Desk</strong> - Customer support and ticketing</li>\n                  <li><strong>Viewer</strong> - Read-only access to reports</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Send Invitation\"</strong></li>\n            </ol>\n            <p class=\"tip\">💡 <strong>Tip:</strong> Invited users will appear with \"Pending\" status until they accept the invitation and login.</p>\n          </section>\n\n          <section>\n            <h3>Editing User Roles</h3>\n            <ol>\n              <li>In User Management, click <strong>\"Edit\"</strong> next to a user</li>\n              <li>Select new role from dropdown</li>\n              <li>Click <strong>\"Update Role\"</strong></li>\n              <li>Changes take effect immediately</li>\n            </ol>\n            <p class=\"warning\">⚠️ <strong>Note:</strong> Owner role cannot be changed. Only one owner per organization.</p>\n          </section>\n\n          <section>\n            <h3>Suspending Users</h3>\n            <p>Temporarily disable a user's access without removing them:</p>\n            <ol>\n              <li>Click <strong>\"Edit\"</strong> on the user</li>\n              <li>Click <strong>\"Suspend User\"</strong></li>\n              <li>User can still login but API calls will fail</li>\n              <li>To re-enable, click <strong>\"Activate User\"</strong></li>\n            </ol>\n          </section>\n\n          <section>\n            <h3>Removing Users</h3>\n            <ol>\n              <li>Click <strong>\"Edit\"</strong> on the user</li>\n              <li>Click <strong>\"Remove from Organization\"</strong></li>\n              <li>Confirm deletion</li>\n              <li>User is removed from tenant (cannot be undone)</li>\n            </ol>\n            <p class=\"warning\">⚠️ <strong>Warning:</strong> Cannot remove the owner. Transfer ownership first.</p>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'help-desk'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>🎧 Help Desk Module</h2>\n          <p class=\"lead\">Customer support ticketing and equipment troubleshooting.</p>\n\n          <section>\n            <h3>Creating Support Tickets</h3>\n            <ol>\n              <li>Go to <strong>Help Desk</strong> module</li>\n              <li>Click <strong>\"Create Ticket\"</strong></li>\n              <li>Enter ticket information:\n                <ul>\n                  <li><strong>Title</strong> - Brief description</li>\n                  <li><strong>Type</strong> - Troubleshoot, Repair, Installation, Other</li>\n                  <li><strong>Priority</strong> - Critical, High, Medium, Low</li>\n                  <li><strong>Description</strong> - Detailed issue description</li>\n                  <li><strong>Customer</strong> - Name and phone (optional)</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Create Ticket\"</strong></li>\n            </ol>\n          </section>\n\n          <section>\n            <h3>Assigning Tickets</h3>\n            <p>Help desk staff can assign tickets to field technicians:</p>\n            <ol>\n              <li>Click on a ticket card to open details</li>\n              <li>Click <strong>\"Assign\"</strong> button</li>\n              <li>Select field technician from dropdown</li>\n              <li>Technician receives push notification on mobile app</li>\n            </ol>\n          </section>\n\n          <section>\n            <h3>Filtering Tickets</h3>\n            <p>Use filters to find specific tickets:</p>\n            <ul>\n              <li><strong>Status</strong> - Open, Assigned, In Progress, Resolved, Closed</li>\n              <li><strong>Priority</strong> - Critical, High, Medium, Low</li>\n              <li><strong>Search</strong> - Search by ticket number, title, or customer name</li>\n            </ul>\n          </section>\n\n          <section>\n            <h3>Customer Lookup</h3>\n            <ol>\n              <li>Click <strong>\"Customer Lookup\"</strong> button</li>\n              <li>Search by phone, email, or IMSI</li>\n              <li>View customer information and service status</li>\n              <li>See active equipment and recent tickets</li>\n            </ol>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'roles'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>🔐 User Roles & Permissions</h2>\n          <p class=\"lead\">Understanding the role-based access control system.</p>\n\n          <section>\n            <h3>Role Hierarchy</h3>\n\n            <div class=\"role-detail\">\n              <h4>🏢 Platform Admin</h4>\n              <p><strong>Who:</strong> System administrator (admin@wisptools.io)</p>\n              <p><strong>Access:</strong> ALL tenants, ALL modules, ALL permissions</p>\n              <p><strong>Can:</strong> Manage all tenants, create owners, override any permission</p>\n            </div>\n\n            <div class=\"role-detail\">\n              <h4>👑 Owner</h4>\n              <p><strong>Who:</strong> Organization creator</p>\n              <p><strong>Access:</strong> ALL modules in their tenant</p>\n              <p><strong>Can:</strong> Manage users, configure modules, full administrative control</p>\n              <p><strong>Cannot:</strong> Be changed or removed (permanent role)</p>\n            </div>\n\n            <div class=\"role-detail\">\n              <h4>⚙️ Admin</h4>\n              <p><strong>Who:</strong> Assistant administrators</p>\n              <p><strong>Access:</strong> Configurable module access</p>\n              <p><strong>Can:</strong> Manage users, configure permissions, access enabled modules</p>\n              <p><strong>Cannot:</strong> Change owner role, delete organization</p>\n            </div>\n\n            <div class=\"role-detail\">\n              <h4>👷 Engineer</h4>\n              <p><strong>Who:</strong> Network engineers</p>\n              <p><strong>Access:</strong> Technical modules only (PCI, CBRS, HSS, ACS, Distributed EPC)</p>\n              <p><strong>Can:</strong> Configure network, manage subscribers, view all work orders</p>\n              <p><strong>Cannot:</strong> Manage users, access help desk</p>\n            </div>\n\n            <div class=\"role-detail\">\n              <h4>🔧 Field Technician (Installer)</h4>\n              <p><strong>Who:</strong> Field workers</p>\n              <p><strong>Access:</strong> Mobile app, assigned work orders, inventory checkout</p>\n              <p><strong>Can:</strong> Deploy equipment, complete tickets, checkout inventory</p>\n              <p><strong>Cannot:</strong> View other techs' tickets, configure network</p>\n            </div>\n\n            <div class=\"role-detail\">\n              <h4>🎧 Help Desk</h4>\n              <p><strong>Who:</strong> Customer support staff</p>\n              <p><strong>Access:</strong> Help desk, work orders, ACS troubleshooting</p>\n              <p><strong>Can:</strong> Create tickets, assign to techs, troubleshoot CPE</p>\n              <p><strong>Cannot:</strong> Manage users, configure network</p>\n            </div>\n\n            <div class=\"role-detail\">\n              <h4>👁️ Viewer</h4>\n              <p><strong>Who:</strong> Read-only users, auditors</p>\n              <p><strong>Access:</strong> View-only access to all modules</p>\n              <p><strong>Can:</strong> View dashboards, reports, export data</p>\n              <p><strong>Cannot:</strong> Make any changes</p>\n            </div>\n          </section>\n\n          <section>\n            <h3>Configuring Module Access</h3>\n            <ol>\n              <li>Go to <strong>Settings</strong> → <strong>Module Access</strong></li>\n              <li>See matrix of roles vs. modules</li>\n              <li>Check/uncheck boxes to enable/disable modules per role</li>\n              <li>Click <strong>\"Save Configuration\"</strong></li>\n              <li>Changes apply immediately to all users</li>\n            </ol>\n            <p class=\"tip\">💡 <strong>Tip:</strong> Use the reset button to restore default permissions for a role.</p>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'customers-portal'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>Customers & Customer Portal</h2>\n          <p class=\"lead\">Customer records, branded portal, billing, and support tickets.</p>\n\n          <section>\n            <h3>Customers Module</h3>\n            <p>Manage customer records with service type (4G/5G, FWA, WiFi, Fiber), LTE auth (IMSI, Ki, OPc), MAC address, and QoS. Use the <strong>Customer Onboarding</strong> wizard from Quick access or the Customers module for guided setup.</p>\n          </section>\n\n          <section>\n            <h3>Customer Portal Setup</h3>\n            <p>Enable a branded customer portal so customers can sign in and access:</p>\n            <ul>\n              <li><strong>Dashboard</strong> - Overview and quick links</li>\n              <li><strong>Billing</strong> - View account and billing information</li>\n              <li><strong>Tickets</strong> - Open and track support tickets</li>\n              <li><strong>Knowledge base / FAQ</strong> - Self-service help</li>\n            </ul>\n            <p>Configure portal branding (logo, colors) and enable the portal in <strong>Customers → Portal setup</strong>. Use <strong>Settings</strong> for organization-wide branding if needed.</p>\n          </section>\n\n          <section>\n            <h3>Billing</h3>\n            <p>Customer billing is available from the Customers module (billing modal per customer) and in the customer portal. Billing cycles and invoicing can be extended when prioritized.</p>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'wizards'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>Wizards & Quick Actions</h2>\n          <p class=\"lead\">Guided flows and in-module quick tips.</p>\n\n          <section>\n            <h3>Available Wizards</h3>\n            <p>Open wizards from the dashboard <strong>Quick access</strong> dropdown or from the <strong>Wizards</strong> page:</p>\n            <ul>\n              <li><strong>Site Deployment</strong> - Deploy and configure sites</li>\n              <li><strong>Subscriber Creation / Group / Bandwidth Plan</strong> - HSS subscriber management</li>\n              <li><strong>RMA Tracking</strong> - Inventory returns and tracking</li>\n              <li><strong>Customer Onboarding</strong> - Guided customer setup</li>\n              <li><strong>Device Onboarding / Registration</strong> - ACS and CBRS device registration</li>\n              <li><strong>Conflict Resolution</strong> - PCI conflict resolution</li>\n              <li><strong>Work Order Creation</strong> - Create work orders</li>\n              <li><strong>Troubleshooting (ACS)</strong> - CPE diagnostics and steps</li>\n              <li><strong>First-time / Organization / Initial Configuration</strong> - Setup and tenant wizards</li>\n            </ul>\n          </section>\n\n          <section>\n            <h3>Quick Tips in Modules</h3>\n            <p>Each module can show a <strong>Help</strong> button that opens context-specific tips (e.g. Monitoring, Deploy, CBRS, Plan, Inventory). Use it for step-by-step guidance without leaving the module.</p>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'work-orders'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>📋 Work Orders & Field Operations</h2>\n\n          <section>\n            <h3>Creating Work Orders</h3>\n            <ol>\n              <li>Go to <strong>Work Orders</strong> or <strong>Help Desk</strong> module</li>\n              <li>Click <strong>\"Create Work Order\"</strong></li>\n              <li>Fill in details:\n                <ul>\n                  <li><strong>Title</strong> - Brief description</li>\n                  <li><strong>Type</strong> - Installation, Repair, Maintenance, etc.</li>\n                  <li><strong>Priority</strong> - Critical to Low</li>\n                  <li><strong>Site</strong> - Affected tower site (optional)</li>\n                  <li><strong>Customer</strong> - Customer details (optional)</li>\n                  <li><strong>Description</strong> - Full details</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Create\"</strong></li>\n            </ol>\n          </section>\n\n          <section>\n            <h3>Assigning Work Orders</h3>\n            <ol>\n              <li>Open work order details</li>\n              <li>Click <strong>\"Assign\"</strong></li>\n              <li>Select field technician</li>\n              <li>Technician receives push notification on mobile app</li>\n              <li>Status changes to \"Assigned\"</li>\n            </ol>\n          </section>\n\n          <section>\n            <h3>Mobile App Workflow</h3>\n            <p><strong>Field Technician receives notification:</strong></p>\n            <ol>\n              <li>Push notification appears on phone</li>\n              <li>Tap notification to open app</li>\n              <li>View work order details</li>\n              <li>Navigate to site using GPS</li>\n              <li>Complete work</li>\n              <li>Update status to \"Resolved\"</li>\n              <li>Add notes and photos</li>\n            </ol>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'troubleshooting'\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>🔧 Troubleshooting</h2>\n\n          <section>\n            <h3>Common Issues</h3>\n\n            <div class=\"troubleshoot-item\">\n              <h4>❌ Can't see a module on dashboard</h4>\n              <p><strong>Cause:</strong> Module not enabled for your role</p>\n              <p><strong>Solution:</strong> Ask your administrator to enable the module in Settings → Module Access</p>\n            </div>\n\n            <div class=\"troubleshoot-item\">\n              <h4>❌ API calls fail with 403 Forbidden</h4>\n              <p><strong>Cause:</strong> Insufficient permissions for the action</p>\n              <p><strong>Solution:</strong> Contact your administrator to update your role or permissions</p>\n            </div>\n\n            <div class=\"troubleshoot-item\">\n              <h4>❌ Mobile app not receiving notifications</h4>\n              <p><strong>Solutions:</strong></p>\n              <ul>\n                <li>Check app has notification permissions granted</li>\n                <li>Check user is logged in</li>\n                <li>Restart app to re-register FCM token</li>\n                <li>Check system notification settings</li>\n              </ul>\n            </div>\n\n            <div class=\"troubleshoot-item\">\n              <h4>❌ Browser notifications not showing</h4>\n              <p><strong>Solution:</strong> Open the <strong>Notifications</strong> panel (bell icon on dashboard), click <strong>Enable notifications</strong>, and allow when the browser prompts. Notifications then appear for new unread items.</p>\n            </div>\n\n            <div class=\"troubleshoot-item\">\n              <h4>❌ Want to change light/dark theme</h4>\n              <p><strong>Solution:</strong> Click the <strong>Settings</strong> (gear) icon on the dashboard header and choose theme in the settings modal.</p>\n            </div>\n\n            <div class=\"troubleshoot-item\">\n              <h4>❌ Work order not appearing in mobile app</h4>\n              <p><strong>Cause:</strong> Work order not assigned to your user</p>\n              <p><strong>Solution:</strong> Field technicians only see tickets assigned to them. Ask help desk to assign the ticket.</p>\n            </div>\n          </section>\n\n          <section>\n            <h3>Getting Help</h3>\n            <p>If you encounter issues:</p>\n            <ol>\n              <li>Check this documentation first</li>\n              <li>Contact your organization administrator</li>\n              <li>Check browser console for errors (F12)</li>\n              <li>Clear browser cache and cookies</li>\n              <li>Try logging out and back in</li>\n            </ol>\n          </section>\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'pci-resolution'\" hidden aria-hidden=\"true\">\n        <article>\n\n<h3>📊 PCI Resolution & Network Optimization</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Detect and resolve Physical Cell ID (PCI) conflicts in LTE networks, optimize neighbor relationships, and implement Self-Organizing Network (SON) features.\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#getting-started\">🚀 Getting Started</a></li>\n    <li><a href=\"#map-features\">🗺️ Map Features</a></li>\n    <li><a href=\"#technical-details\">📐 Technical Details</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#network-management\">📞 Network Management</a></li>\n  </ul>\n</div>\n\n<h4 id=\"key-features\">🎯 Key Features</h4>\n<ul>\n  <li><strong>PCI Conflict Detection:</strong> Automatically identifies cells with conflicting PCIs</li>\n  <li><strong>Neighbor Analysis:</strong> Analyzes cell adjacency and interference</li>\n  <li><strong>AI-Powered Recommendations:</strong> Uses Google Gemini AI for optimization suggestions</li>\n  <li><strong>Visual Network Map:</strong> Interactive ArcGIS map showing cell sites and conflicts</li>\n  <li><strong>Export Capabilities:</strong> Generate reports and Nokia configuration scripts</li>\n</ul>\n\n<h4 id=\"getting-started\">🚀 Getting Started</h4>\n\n<h4>Step 1: Import Cell Data</h4>\n<p>Click the <strong>\"📊 Manage Towers\"</strong> button to:</p>\n<ul>\n  <li>Add cell sites manually</li>\n  <li>Import from CSV files</li>\n  <li>Import from KML files (Google Earth)</li>\n</ul>\n\n<p><strong>CSV Format Example:</strong></p>\n<pre><code>eNodeB,Cell ID,PCI,Latitude,Longitude,Azimuth,Height\n12345,0,150,40.7128,-74.0060,0,30\n12345,1,151,40.7128,-74.0060,120,30\n12345,2,152,40.7128,-74.0060,240,30</code></pre>\n\n<h4>Step 2: Analyze Network</h4>\n<p>Click <strong>\"🔍 Analyze Network\"</strong> to:</p>\n<ul>\n  <li>Detect PCI conflicts (same PCI within interference range)</li>\n  <li>Calculate neighbor relationships</li>\n  <li>Identify potential interference</li>\n  <li>Generate conflict severity ratings (High/Medium/Low)</li>\n</ul>\n\n<h4>Step 3: Review Conflicts</h4>\n<p>The conflict table shows:</p>\n<ul>\n  <li><strong>Severity:</strong> High (same PCI neighbors), Medium (mod3 conflicts), Low (mod6 conflicts)</li>\n  <li><strong>Affected Cells:</strong> Which cells are involved</li>\n  <li><strong>Distance:</strong> How far apart the conflicting cells are</li>\n  <li><strong>Recommendations:</strong> Suggested PCI changes</li>\n</ul>\n\n<h4>Step 4: Get AI Recommendations</h4>\n<p>Click <strong>\"🤖 Get AI Recommendations\"</strong> for:</p>\n<ul>\n  <li>Intelligent PCI reallocation suggestions</li>\n  <li>Network-wide optimization strategies</li>\n  <li>Prioritized conflict resolution</li>\n</ul>\n\n<h4>Step 5: Optimize Network</h4>\n<p>Click <strong>\"✨ Optimize Network\"</strong> to:</p>\n<ul>\n  <li>Automatically resolve all PCI conflicts</li>\n  <li>Reassign PCIs based on neighbor relationships</li>\n  <li>Maintain existing PCIs where possible</li>\n  <li>Generate before/after comparison</li>\n</ul>\n\n<h4>Step 6: Export Results</h4>\n<p>Click <strong>\"📤 Export\"</strong> for:</p>\n<ul>\n  <li><strong>Conflict Report (PDF):</strong> Detailed analysis and recommendations</li>\n  <li><strong>CSV Export:</strong> Updated cell data with new PCIs</li>\n  <li><strong>Nokia Configuration:</strong> Ready-to-use CLI commands for Nokia eNodeBs</li>\n</ul>\n\n<h4 id=\"map-features\">🗺️ Map Features</h4>\n<ul>\n  <li><strong>Color Coding:</strong> Cells colored by PCI conflict status</li>\n  <li><strong>Click Cells:</strong> View detailed cell information</li>\n  <li><strong>Right-Click:</strong> Add sites, edit sectors, delete sectors</li>\n  <li><strong>Neighbor Lines:</strong> Shows cell adjacency relationships</li>\n  <li><strong>Basemap Options:</strong> Streets, Satellite, Hybrid, Topographic</li>\n</ul>\n\n<h4 id=\"technical-details\">📐 Technical Details</h4>\n\n<h4>PCI Conflict Rules:</h4>\n<ul>\n  <li><strong>Mod3 Conflict:</strong> PCIs with same value mod 3 (can cause confusion)</li>\n  <li><strong>Mod6 Conflict:</strong> PCIs with same value mod 6 (can cause interference)</li>\n  <li><strong>Direct Conflict:</strong> Identical PCIs within range (must be fixed)</li>\n</ul>\n\n<h4>Interference Range Calculation:</h4>\n<ul>\n  <li>Based on cell height, azimuth, and distance</li>\n  <li>Typical range: 2-5 km for interference detection</li>\n  <li>Adjustable in analysis settings</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>No conflicts detected but cells are close:</h4>\n<p>Increase the interference range in analysis settings</p>\n\n<h4>Optimization changes too many PCIs:</h4>\n<p>Review AI recommendations first and apply selectively</p>\n\n<h4>Map not loading:</h4>\n<p>Check ArcGIS API key in environment variables</p>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n<ul>\n  <li>Import all cell data before analysis</li>\n  <li>Review AI recommendations before auto-optimization</li>\n  <li>Export backup before applying PCI changes</li>\n  <li>Test PCI changes on small clusters first</li>\n  <li>Coordinate with network operations before deployment</li>\n  <li>Use Nokia export for quick configuration deployment</li>\n</ul>\n\n<h4 id=\"network-management\">📞 Network Management</h4>\n<p>Use the <strong>\"🌐 Networks\"</strong> button to:</p>\n<ul>\n  <li>Create multiple isolated networks</li>\n  <li>Switch between different deployments</li>\n  <li>Keep production and staging separate</li>\n  <li>Manage different geographical areas</li>\n</ul>\n\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'cbrs'\" hidden aria-hidden=\"true\">\n        <article>\n\n<h3>📡 CBRS Management Module</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Manage Citizens Broadband Radio Service (CBRS) spectrum for the 3.5 GHz band (3550-3700 MHz) with integrated support for Google SAS and Federated Wireless.\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#overview\">Overview</a></li>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#cbrs-basics\">CBRS Basics</a></li>\n    <li><a href=\"#getting-started\">Getting Started</a></li>\n    <li><a href=\"#device-states\">Device States</a></li>\n    <li><a href=\"#grant-management\">Grant Management</a></li>\n    <li><a href=\"#api-integration\">API Integration</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#compliance\">Compliance & Regulations</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n    <li><a href=\"#support\">Support & Resources</a></li>\n  </ul>\n</div>\n\n<h4 id=\"overview\">Overview</h4>\n\nThe CBRS (Citizens Broadband Radio Service) Management module provides comprehensive spectrum management capabilities for the 3.5 GHz CBRS band (3550-3700 MHz) with integrated support for:\n\n- **Google SAS (Spectrum Access System)** - Google's commercial SAS platform\n- **Federated Wireless** - Enhanced SAS with advanced analytics and optimization\n\n<h4>🎯 Key Features</h4>\n<ul>\n  <li><strong>CBSD Device Management:</strong>\n    <ul>\n      <li>Register and manage Citizens Broadband Service Devices (CBSDs)</li>\n      <li>Support for both Category A (indoor) and Category B (outdoor) devices</li>\n      <li>Real-time device status monitoring</li>\n      <li>GPS-based device mapping with ArcGIS integration</li>\n    </ul>\n  </li>\n  <li><strong>Spectrum Authorization:</strong>\n    <ul>\n      <li>Request spectrum grants from SAS providers</li>\n      <li>Automated heartbeat management</li>\n      <li>Real-time grant status tracking</li>\n      <li>Grant relinquishment and renewal</li>\n    </ul>\n  </li>\n  <li><strong>Geographic Visualization:</strong>\n    <ul>\n      <li>Interactive ArcGIS map showing CBSD locations</li>\n      <li>Color-coded device status indicators</li>\n      <li>Multi-site coordination visualization</li>\n      <li>Coverage area analysis</li>\n    </ul>\n  </li>\n  <li><strong>Analytics & Monitoring:</strong>\n    <ul>\n      <li>Real-time device performance metrics</li>\n      <li>Spectrum utilization tracking</li>\n      <li>Interference detection and monitoring</li>\n      <li>Historical data analysis</li>\n    </ul>\n  </li>\n</ul>\n\n<h4 id=\"cbrs-basics\">CBRS Basics</h4>\n\n### What is CBRS?\n\nCitizens Broadband Radio Service (CBRS) is a 150 MHz wide broadcast radio frequency band in the United States (3550-3700 MHz). It operates under an innovative three-tiered spectrum sharing framework:\n\n1. **Incumbent Access** - Federal and fixed satellite service users (highest priority)\n2. **Priority Access License (PAL)** - Licensed users with protected spectrum\n3. **General Authorized Access (GAA)** - Unlicensed users on available spectrum\n\n### Spectrum Access System (SAS)\n\nThe SAS is a cloud-based database and spectrum management system that:\n- Protects incumbent users from harmful interference\n- Manages spectrum assignments for PAL and GAA users\n- Provides dynamic spectrum allocation\n- Enforces FCC rules and regulations\n\n<h4 id=\"getting-started\">Getting Started</h4>\n\n### 1. Add a CBSD Device\n\n<p>Click <strong>\"+ Add CBSD Device\"</strong> and provide:</p>\n<ul>\n  <li><strong>CBSD Serial Number</strong> - Unique device identifier</li>\n  <li><strong>FCC ID</strong> - FCC equipment authorization identifier</li>\n  <li><strong>Category</strong> - A (indoor, lower power) or B (outdoor, higher power)</li>\n  <li><strong>SAS Provider</strong> - Google SAS or Federated Wireless</li>\n  <li><strong>Installation Parameters:</strong>\n    <ul>\n      <li>Latitude and Longitude (decimal degrees)</li>\n      <li>Height above ground (meters)</li>\n      <li>Antenna gain (dBi)</li>\n    </ul>\n  </li>\n</ul>\n\n<h4>Step 2: Register with SAS</h4>\n\n<p>Once added, devices must be registered with the selected SAS provider:</p>\n<ol>\n  <li>Select device from the list</li>\n  <li>Click <strong>\"Register\"</strong> button</li>\n  <li>SAS validates device and installation parameters</li>\n  <li>Upon success, device receives a CBSD ID</li>\n</ol>\n\n<h4>Step 3: Request Spectrum Grant</h4>\n\n<p>After registration, request a spectrum grant:</p>\n<ol>\n  <li>Select registered device</li>\n  <li>Click <strong>\"Request New Grant\"</strong></li>\n  <li>Specify:\n    <ul>\n      <li>Maximum EIRP (Effective Isotropic Radiated Power)</li>\n      <li>Frequency range (within 3550-3700 MHz)</li>\n    </ul>\n  </li>\n  <li>SAS evaluates request and assigns available spectrum</li>\n</ol>\n\n<h4>Step 4: Automated Heartbeat</h4>\n\n<p>Once granted, the system automatically:</p>\n<ul>\n  <li>Sends periodic heartbeats to SAS</li>\n  <li>Maintains spectrum authorization</li>\n  <li>Updates transmit expiration times</li>\n  <li>Reports device status</li>\n</ul>\n\n<h4 id=\"device-states\">Device States</h4>\n\n<h4>UNREGISTERED</h4>\n<p>Device is created but not yet registered with SAS. Cannot transmit.</p>\n\n<h4>REGISTERED</h4>\n<p>Device is registered with SAS and can request spectrum grants.</p>\n\n<h4>GRANTED</h4>\n<p>Device has one or more active spectrum grants but is not authorized to transmit.</p>\n\n<h4>AUTHORIZED</h4>\n<p>Device is authorized to transmit on granted frequencies. Active heartbeat required.</p>\n\n<h4>SUSPENDED</h4>\n<p>Spectrum grant is temporarily suspended. Cannot transmit until restored.</p>\n\n<h4>DEREGISTERED</h4>\n<p>Device is removed from SAS registration. All grants are terminated.</p>\n\n<h4 id=\"grant-management\">Grant Management</h4>\n\n<h4>Requesting Grants</h4>\n\n<p>When requesting a grant, consider:</p>\n\n<p><strong>Frequency Range</strong></p>\n<ul>\n  <li>Must be within CBRS band (3550-3700 MHz)</li>\n  <li>Typically 10-20 MHz channels</li>\n  <li>Avoid incumbent protection zones</li>\n</ul>\n\n<p><strong>Maximum EIRP</strong></p>\n<ul>\n  <li>Category A: Up to 30 dBm/10MHz</li>\n  <li>Category B: Up to 47 dBm/10MHz</li>\n  <li>SAS may reduce based on interference analysis</li>\n</ul>\n\n<p><strong>Channel Type</strong></p>\n<ul>\n  <li><strong>PAL</strong> - Priority Access License (if you hold PAL)</li>\n  <li><strong>GAA</strong> - General Authorized Access (most common)</li>\n</ul>\n\n<h4>Heartbeat Requirements</h4>\n\n<p>SAS requires periodic heartbeats (typically 60-240 seconds) to:</p>\n<ul>\n  <li>Confirm device operational status</li>\n  <li>Renew transmit authorization</li>\n  <li>Update interference measurements</li>\n  <li>Receive SAS commands</li>\n</ul>\n\n<p><strong>Heartbeat Process:</strong></p>\n<ol>\n  <li>System automatically sends heartbeats</li>\n  <li>SAS responds with transmit authorization</li>\n  <li>Authorization expires if heartbeat missed</li>\n  <li>Device must stop transmitting if expired</li>\n</ol>\n\n<h4>Relinquishing Grants</h4>\n\n<p>Relinquish grants when:</p>\n<ul>\n  <li>Device is no longer transmitting</li>\n  <li>Spectrum is not needed</li>\n  <li>Preparing for deregistration</li>\n  <li>Changing frequency assignments</li>\n</ul>\n\n<h4 id=\"api-integration\">API Integration</h4>\n\n<h4>Google SAS</h4>\n\n<p><strong>Features:</strong></p>\n<ul>\n  <li>WinnForum compliant SAS implementation</li>\n  <li>Integration with Google Cloud Platform</li>\n  <li>Real-time spectrum coordination</li>\n  <li>Automated interference protection</li>\n</ul>\n\n<p><strong>Best For:</strong></p>\n<ul>\n  <li>Standard CBRS deployments</li>\n  <li>Cost-effective spectrum management</li>\n  <li>Google Cloud integration</li>\n  <li>Basic compliance requirements</li>\n</ul>\n\n<h4>Federated Wireless</h4>\n\n<p><strong>Features:</strong></p>\n<ul>\n  <li>Enhanced spectrum optimization</li>\n  <li>Advanced interference monitoring</li>\n  <li>Multi-site coordination</li>\n  <li>Real-time analytics and insights</li>\n  <li>Automated power optimization</li>\n</ul>\n\n<p><strong>Best For:</strong></p>\n<ul>\n  <li>Enterprise deployments</li>\n  <li>Multi-site networks</li>\n  <li>Advanced analytics needs</li>\n  <li>Maximum spectrum efficiency</li>\n</ul>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n\n<h4>Device Installation</h4>\n\n<ol>\n  <li><strong>Accurate GPS Coordinates</strong>\n    <ul>\n      <li>Use professional GPS equipment</li>\n      <li>Verify coordinates before registration</li>\n      <li>Update if device is relocated</li>\n    </ul>\n  </li>\n  <li><strong>Height Measurements</strong>\n    <ul>\n      <li>Measure from ground level (AGL)</li>\n      <li>Include antenna height</li>\n      <li>Account for building height for rooftop installations</li>\n    </ul>\n  </li>\n  <li><strong>Antenna Parameters</strong>\n    <ul>\n      <li>Accurate antenna gain critical for power calculations</li>\n      <li>Provide azimuth and downtilt if directional</li>\n      <li>Keep documentation updated</li>\n    </ul>\n  </li>\n</ol>\n\n<h4>Spectrum Management</h4>\n\n<ol>\n  <li><strong>Request Appropriate Bandwidth</strong>\n    <ul>\n      <li>Match to actual needs</li>\n      <li>Consider traffic patterns</li>\n      <li>Plan for growth</li>\n    </ul>\n  </li>\n  <li><strong>Monitor Grant Status</strong>\n    <ul>\n      <li>Check expiration times</li>\n      <li>Renew before expiration</li>\n      <li>Monitor heartbeat success rate</li>\n    </ul>\n  </li>\n  <li><strong>Handle Suspensions Gracefully</strong>\n    <ul>\n      <li>Implement immediate transmit stop</li>\n      <li>Wait for SAS clearance</li>\n      <li>Log suspension events</li>\n    </ul>\n  </li>\n</ol>\n\n<h4>Network Optimization</h4>\n\n<ol>\n  <li><strong>Use Available Spectrum Efficiently</strong>\n    <ul>\n      <li>Deploy only needed CBSDs</li>\n      <li>Use appropriate power levels</li>\n      <li>Avoid over-provisioning</li>\n    </ul>\n  </li>\n  <li><strong>Coordinate Multiple Sites</strong>\n    <ul>\n      <li>Use Federated Wireless multi-site coordination</li>\n      <li>Plan frequency reuse</li>\n      <li>Monitor inter-site interference</li>\n    </ul>\n  </li>\n  <li><strong>Regular Maintenance</strong>\n    <ul>\n      <li>Update device firmware</li>\n      <li>Verify GPS sync</li>\n      <li>Test emergency shutdown procedures</li>\n    </ul>\n  </li>\n</ol>\n\n<h4 id=\"compliance\">Compliance & Regulations</h4>\n\n<h4>FCC Requirements</h4>\n\n<p>All CBSD operations must comply with FCC Part 96 rules:</p>\n<ul>\n  <li>Use certified CBSD equipment (FCC ID required)</li>\n  <li>Register all devices with SAS</li>\n  <li>Respond to SAS commands immediately</li>\n  <li>Maintain accurate installation records</li>\n  <li>Stop transmitting when required</li>\n</ul>\n\n<h4>Incumbent Protection</h4>\n\n<p>SAS automatically protects:</p>\n<ul>\n  <li>Federal radar systems (Navy shipboard radar)</li>\n  <li>Fixed Satellite Service (FSS) earth stations</li>\n  <li>Grandfathered Fixed Service operations</li>\n</ul>\n\n<p><strong>Protection Zones:</strong></p>\n<ul>\n  <li>Coastal areas (0-80 km inland)</li>\n  <li>FSS earth station locations</li>\n  <li>Military installation perimeters</li>\n</ul>\n\n<h4>Record Keeping</h4>\n\n<p>Maintain records of:</p>\n<ul>\n  <li>Device registration details</li>\n  <li>Grant requests and approvals</li>\n  <li>Heartbeat logs</li>\n  <li>Suspension/termination events</li>\n  <li>Installation changes</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>Device Won't Register</h4>\n\n<p><strong>Check:</strong></p>\n<ul>\n  <li>FCC ID is valid and certified for CBRS</li>\n  <li>GPS coordinates are accurate</li>\n  <li>Device category matches equipment specs</li>\n  <li>No duplicate serial numbers</li>\n  <li>SAS API credentials are valid</li>\n</ul>\n\n<h4>Grant Request Denied</h4>\n\n<p><strong>Possible Causes:</strong></p>\n<ul>\n  <li>Requested frequency unavailable</li>\n  <li>Excessive interference predicted</li>\n  <li>In incumbent protection zone</li>\n  <li>Installation parameters invalid</li>\n  <li>Power level too high</li>\n</ul>\n\n<p><strong>Solutions:</strong></p>\n<ul>\n  <li>Request different frequency range</li>\n  <li>Reduce max EIRP</li>\n  <li>Verify installation parameters</li>\n  <li>Check for nearby PAL holders</li>\n  <li>Contact SAS provider support</li>\n</ul>\n\n<h4>Heartbeat Failures</h4>\n\n<p><strong>Check:</strong></p>\n<ul>\n  <li>Network connectivity</li>\n  <li>SAS API endpoint accessibility</li>\n  <li>System clock synchronization</li>\n  <li>Certificate validity (if using SSL)</li>\n  <li>Grant expiration status</li>\n</ul>\n\n<p><strong>Actions:</strong></p>\n<ul>\n  <li>Review error logs</li>\n  <li>Test network connection</li>\n  <li>Verify API credentials</li>\n  <li>Restart heartbeat service</li>\n  <li>Contact SAS support if persistent</li>\n</ul>\n\n<h4>Unexpected Suspension</h4>\n\n<p><strong>Causes:</strong></p>\n<ul>\n  <li>Incumbent activity detected</li>\n  <li>Interference reported</li>\n  <li>Missed heartbeats</li>\n  <li>SAS maintenance</li>\n  <li>Policy violation</li>\n</ul>\n\n<p><strong>Response:</strong></p>\n<ol>\n  <li>Immediately stop transmitting</li>\n  <li>Check SAS messages</li>\n  <li>Wait for AUTHORIZED state</li>\n  <li>Resume only when cleared</li>\n  <li>Investigate root cause</li>\n</ol>\n\n<h4 id=\"support\">Support & Resources</h4>\n\n<h4>Documentation</h4>\n<ul>\n  <li><a href=\"https://www.ecfr.gov/current/title-47/chapter-I/subchapter-B/part-96\" target=\"_blank\">FCC Part 96 Rules</a></li>\n  <li><a href=\"https://www.wirelessinnovation.org/cbrs-spectrum-access-system\" target=\"_blank\">WinnForum SAS Specifications</a></li>\n  <li><a href=\"https://cloud.google.com/spectrum-access-system\" target=\"_blank\">Google SAS Documentation</a></li>\n  <li><a href=\"https://www.federatedwireless.com/\" target=\"_blank\">Federated Wireless Portal</a></li>\n</ul>\n\n<h4>Getting Help</h4>\n<ul>\n  <li>Technical support: support@yourcompany.com</li>\n  <li>SAS Provider support links in module settings</li>\n  <li>Community forums and user groups</li>\n  <li>Professional services for deployment assistance</li>\n</ul>\n\n<h4>Additional Training</h4>\n<ul>\n  <li>CBRS fundamentals course</li>\n  <li>SAS integration workshop</li>\n  <li>Network planning services</li>\n  <li>Compliance training</li>\n</ul>\n\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'inventory'\" hidden aria-hidden=\"true\">\n        <article>\n\n<h3>📦 Inventory Management</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Centralized asset tracking with location management, maintenance history, and warranty tracking for all network equipment and hardware.\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#getting-started\">🚀 Getting Started</a></li>\n    <li><a href=\"#inventory-management\">📊 Inventory Management</a></li>\n    <li><a href=\"#maintenance-tracking\">🔧 Maintenance Tracking</a></li>\n    <li><a href=\"#bundles-kits\">📦 Bundles and Kits</a></li>\n    <li><a href=\"#checkin-wizard\">🧙 Check-in Wizard</a></li>\n    <li><a href=\"#reports\">📊 Reports</a></li>\n    <li><a href=\"#mobile-integration\">🔍 Mobile App Integration</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n  </ul>\n</div>\n\n<h4 id=\"key-features\">🎯 Key Features</h4>\n<ul>\n  <li><strong>Equipment Tracking:</strong> Track all network equipment, CPE devices, and hardware</li>\n  <li><strong>Location Management:</strong> Assign equipment to sites, vehicles, warehouses, or field technicians</li>\n  <li><strong>QR Code Scanning:</strong> Quick lookup and checkout using mobile app scanner</li>\n  <li><strong>Maintenance History:</strong> Track repairs, firmware updates, and service records</li>\n  <li><strong>Warranty Tracking:</strong> Monitor warranty expiration dates and service contracts</li>\n  <li><strong>Inventory Reports:</strong> Generate reports for audits, depreciation, and planning</li>\n</ul>\n\n<h4 id=\"getting-started\">🚀 Getting Started</h4>\n\n<h4>Step 1: Add Equipment to Inventory</h4>\n<ol>\n  <li>Navigate to <strong>Inventory</strong> module</li>\n  <li>Click <strong>\"Add Equipment\"</strong> button</li>\n  <li>Enter equipment details:\n    <ul>\n      <li><strong>Serial Number</strong> - Unique identifier (required)</li>\n      <li><strong>Model/Type</strong> - Equipment model and manufacturer</li>\n      <li><strong>Category</strong> - Router, Radio, Antenna, CPE, etc.</li>\n      <li><strong>Purchase Date</strong> - When equipment was acquired</li>\n      <li><strong>Warranty Expiration</strong> - Warranty end date</li>\n      <li><strong>Initial Location</strong> - Warehouse, vehicle, or site</li>\n    </ul>\n  </li>\n  <li>Click <strong>\"Save\"</strong> to add equipment</li>\n</ol>\n\n<h4>Step 2: Generate QR Codes</h4>\n<p>Each equipment item automatically gets a QR code:</p>\n<ul>\n  <li>QR code appears on equipment detail page</li>\n  <li>Print QR code labels for physical equipment</li>\n  <li>Use mobile app scanner to quickly lookup equipment</li>\n  <li>QR codes link directly to equipment records</li>\n</ul>\n\n<h4>Step 3: Check Out Equipment</h4>\n<p>When deploying equipment to field:</p>\n<ol>\n  <li>Select equipment from inventory list</li>\n  <li>Click <strong>\"Check Out\"</strong> button</li>\n  <li>Select destination:\n    <ul>\n      <li><strong>Field Technician</strong> - Assign to specific tech</li>\n      <li><strong>Vehicle</strong> - Assign to service vehicle</li>\n      <li><strong>Site</strong> - Deploy to tower site</li>\n    </ul>\n  </li>\n  <li>Add notes (optional)</li>\n  <li>Click <strong>\"Check Out\"</strong></li>\n</ol>\n\n<h4>Step 4: Deploy Equipment</h4>\n<p>When installing equipment at customer site:</p>\n<ol>\n  <li>Use mobile app to scan QR code</li>\n  <li>Select <strong>\"Deploy\"</strong> action</li>\n  <li>Enter deployment details:\n    <ul>\n      <li>Customer site location</li>\n      <li>Installation date</li>\n      <li>Installation notes</li>\n    </ul>\n  </li>\n  <li>Equipment status changes to \"Deployed\"</li>\n  <li>Location updates automatically</li>\n</ol>\n\n<h4 id=\"inventory-management\">📊 Inventory Management</h4>\n\n<h4>Viewing Inventory</h4>\n<p>The inventory list shows:</p>\n<ul>\n  <li><strong>Equipment Details:</strong> Serial number, model, category</li>\n  <li><strong>Current Location:</strong> Where equipment is currently located</li>\n  <li><strong>Status:</strong> Available, Checked Out, Deployed, Maintenance</li>\n  <li><strong>Last Updated:</strong> When location or status last changed</li>\n</ul>\n\n<h4>Filtering and Search</h4>\n<ul>\n  <li><strong>Search:</strong> Search by serial number, model, or location</li>\n  <li><strong>Filter by Status:</strong> Available, Checked Out, Deployed, Maintenance</li>\n  <li><strong>Filter by Category:</strong> Router, Radio, Antenna, CPE, etc.</li>\n  <li><strong>Filter by Location:</strong> Warehouse, Vehicle, Site, Technician</li>\n</ul>\n\n<h4>Equipment Actions</h4>\n<ul>\n  <li><strong>View Details:</strong> Click equipment row for full information</li>\n  <li><strong>Edit:</strong> Update equipment information</li>\n  <li><strong>Check Out:</strong> Assign to technician or vehicle</li>\n  <li><strong>Check In:</strong> Return equipment to warehouse</li>\n  <li><strong>Deploy:</strong> Install at customer site</li>\n  <li><strong>Maintenance:</strong> Mark for repair or service</li>\n  <li><strong>Delete:</strong> Remove from inventory (requires confirmation)</li>\n</ul>\n\n<h4 id=\"maintenance-tracking\">🔧 Maintenance Tracking</h4>\n\n<h4>Adding Maintenance Records</h4>\n<ol>\n  <li>Open equipment details</li>\n  <li>Click <strong>\"Add Maintenance Record\"</strong></li>\n  <li>Enter maintenance information:\n    <ul>\n      <li><strong>Type:</strong> Repair, Firmware Update, Inspection, etc.</li>\n      <li><strong>Date:</strong> When maintenance was performed</li>\n      <li><strong>Technician:</strong> Who performed the work</li>\n      <li><strong>Description:</strong> What was done</li>\n      <li><strong>Cost:</strong> Maintenance cost (optional)</li>\n    </ul>\n  </li>\n  <li>Save maintenance record</li>\n</ol>\n\n<h4>Maintenance History</h4>\n<p>View all maintenance records for equipment:</p>\n<ul>\n  <li>Chronological list of all maintenance</li>\n  <li>Filter by maintenance type</li>\n  <li>Export maintenance history for reporting</li>\n  <li>Track total maintenance costs</li>\n</ul>\n\n<h4 id=\"bundles-kits\">📦 Bundles and Kits</h4>\n\n<h4>Creating Equipment Bundles</h4>\n<p>Group related equipment for easier deployment:</p>\n<ol>\n  <li>Navigate to <strong>Bundles</strong> section</li>\n  <li>Click <strong>\"Create Bundle\"</strong></li>\n  <li>Enter bundle name and description</li>\n  <li>Add equipment items to bundle</li>\n  <li>Save bundle</li>\n</ol>\n\n<h4>Using Bundles</h4>\n<ul>\n  <li>Check out entire bundle at once</li>\n  <li>Deploy bundle to customer site</li>\n  <li>Track bundle as single unit</li>\n  <li>Individual items still tracked separately</li>\n</ul>\n\n<h4 id=\"checkin-wizard\">🧙 Check-in Wizard</h4>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Step-by-step guided workflow for checking in received inventory items with proper location assignment, verification, and labeling.\n</div>\n\n<h4>Accessing the Wizard</h4>\n<ol>\n  <li>Navigate to <strong>Inventory</strong> module</li>\n  <li>Click <strong>\"📦 Check-in Wizard\"</strong> button (primary action button)</li>\n  <li>Wizard opens with welcome screen</li>\n</ol>\n\n<h4>Wizard Overview</h4>\n<p>The Check-in Wizard guides you through:</p>\n<ul>\n  <li>Scanning or entering item serial number</li>\n  <li>Verifying item details</li>\n  <li>Setting storage location</li>\n  <li>Printing asset tag label</li>\n  <li>Completing check-in</li>\n</ul>\n\n<h4>Check-in Methods</h4>\n\n<h4>Barcode Scan</h4>\n<ul>\n  <li>Use camera to scan barcode/QR code</li>\n  <li>Automatic item lookup</li>\n  <li>Fastest method for bulk check-ins</li>\n</ul>\n\n<h4>Manual Entry</h4>\n<ul>\n  <li>Enter serial number manually</li>\n  <li>Enter purchase order ID (optional)</li>\n  <li>Lookup item in system</li>\n</ul>\n\n<h4>Bulk Check-in</h4>\n<ul>\n  <li>Check in multiple items at once</li>\n  <li>Streamlined workflow</li>\n  <li>Efficient for large shipments</li>\n</ul>\n\n<h4>Wizard Steps</h4>\n<ol>\n  <li><strong>Welcome:</strong> Overview of check-in process</li>\n  <li><strong>Scan Item:</strong> Identify item via scan or manual entry</li>\n  <li><strong>Verify:</strong> Review and update item details</li>\n  <li><strong>Set Location:</strong> Choose storage location (warehouse, tower, NOC, vehicle, other)</li>\n  <li><strong>Print Label:</strong> Preview and print asset tag</li>\n  <li><strong>Complete:</strong> Review summary and finish</li>\n</ol>\n\n<h4>Location Types</h4>\n<ul>\n  <li><strong>Warehouse:</strong> Section and shelf</li>\n  <li><strong>Tower Site:</strong> Site, rack, and rack unit</li>\n  <li><strong>NOC:</strong> Room and rack</li>\n  <li><strong>Vehicle:</strong> Vehicle ID and name</li>\n  <li><strong>Other:</strong> Custom description</li>\n</ul>\n\n<h4>Tips for Using the Wizard</h4>\n<ul>\n  <li>Have serial numbers or barcodes ready</li>\n  <li>Know storage location before starting</li>\n  <li>Print labels immediately for easy tracking</li>\n  <li>Link to purchase orders when available</li>\n  <li>Add notes for any special handling requirements</li>\n</ul>\n\n<div class=\"success\">\n  <strong>✅ Quick Access:</strong> The Check-in Wizard can also be accessed from the \"Scan Check In\" modal by selecting \"Wizard Mode\" option.\n</div>\n\n<h4 id=\"reports\">📊 Reports</h4>\n\n<h4>Available Reports</h4>\n<ul>\n  <li><strong>Inventory Summary:</strong> Total equipment by category and status</li>\n  <li><strong>Location Report:</strong> Equipment distribution by location</li>\n  <li><strong>Maintenance Report:</strong> Maintenance history and costs</li>\n  <li><strong>Warranty Report:</strong> Equipment with expiring warranties</li>\n  <li><strong>Deployment Report:</strong> Equipment deployed at customer sites</li>\n</ul>\n\n<h4>Exporting Reports</h4>\n<ul>\n  <li>Export to CSV for Excel analysis</li>\n  <li>Print PDF reports</li>\n  <li>Schedule automated reports</li>\n  <li>Email reports to stakeholders</li>\n</ul>\n\n<h4 id=\"mobile-integration\">🔍 Mobile App Integration</h4>\n\n<h4>QR Code Scanner</h4>\n<p>Field technicians can use mobile app to:</p>\n<ul>\n  <li>Scan QR codes on equipment</li>\n  <li>View equipment details instantly</li>\n  <li>Check out equipment to vehicle</li>\n  <li>Deploy equipment at customer sites</li>\n  <li>Add maintenance records</li>\n  <li>Update equipment status</li>\n</ul>\n\n<h4>Field Workflow</h4>\n<ol>\n  <li>Scan equipment QR code with mobile app</li>\n  <li>View equipment details and history</li>\n  <li>Check out equipment to vehicle</li>\n  <li>Navigate to customer site</li>\n  <li>Install equipment</li>\n  <li>Deploy equipment via mobile app</li>\n  <li>Add installation notes and photos</li>\n</ol>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n<ul>\n  <li><strong>Label Everything:</strong> Print and attach QR codes to all equipment</li>\n  <li><strong>Regular Audits:</strong> Periodically verify equipment locations</li>\n  <li><strong>Update Status:</strong> Keep equipment status current</li>\n  <li><strong>Track Maintenance:</strong> Record all repairs and updates</li>\n  <li><strong>Monitor Warranties:</strong> Review warranty expiration regularly</li>\n  <li><strong>Use Bundles:</strong> Group common equipment for faster deployment</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>Equipment not appearing in inventory:</h4>\n<ul>\n  <li>Verify equipment was added correctly</li>\n  <li>Check filters aren't hiding equipment</li>\n  <li>Ensure you have permission to view inventory</li>\n</ul>\n\n<h4>Can't check out equipment:</h4>\n<ul>\n  <li>Verify equipment status is \"Available\"</li>\n  <li>Check equipment isn't already checked out</li>\n  <li>Ensure you have checkout permissions</li>\n</ul>\n\n<h4>QR code not scanning:</h4>\n<ul>\n  <li>Verify QR code is printed clearly</li>\n  <li>Check mobile app has camera permissions</li>\n  <li>Ensure QR code hasn't been damaged</li>\n  <li>Try manual serial number lookup</li>\n</ul>\n\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'coverage-map'\" hidden aria-hidden=\"true\">\n        <article>\n\n<h3>🗺️ Coverage Map Module</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> The Coverage Map is a comprehensive network asset management and visualization system that consolidates all network equipment (towers, sectors, CPE devices, and inventory) into a single interactive ArcGIS-powered map interface. This module serves as the <strong>central hub</strong> for viewing and managing your entire network infrastructure across all modules (CBRS, ACS, PCI Resolution, etc.).\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#getting-started\">🚀 Getting Started</a></li>\n    <li><a href=\"#map-features\">🗺️ Map Features</a></li>\n    <li><a href=\"#site-management\">Site Management</a></li>\n    <li><a href=\"#sector-configuration\">Sector Configuration</a></li>\n    <li><a href=\"#cpe-management\">📡 CPE Management</a></li>\n    <li><a href=\"#backhaul-management\">🔗 Backhaul Management</a></li>\n    <li><a href=\"#equipment-inventory\">📦 Equipment Inventory</a></li>\n    <li><a href=\"#filtering-search\">🔍 Filtering and Search</a></li>\n    <li><a href=\"#reports-export\">📊 Reports and Export</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n  </ul>\n</div>\n\n<h4 id=\"key-features\">🎯 Key Features</h4>\n<ul>\n  <li><strong>Interactive Map:</strong> ArcGIS-powered map with satellite, street, and hybrid views</li>\n  <li><strong>Tower Site Management:</strong> Add, edit, and manage tower sites with GPS coordinates</li>\n  <li><strong>Sector Management:</strong> Configure sectors per tower with azimuth, tilt, and frequency</li>\n  <li><strong>CPE Device Mapping:</strong> View and manage customer premise equipment locations</li>\n  <li><strong>Backhaul Links:</strong> Visualize and manage point-to-point backhaul connections</li>\n  <li><strong>Equipment Inventory:</strong> Track equipment deployed at each site</li>\n  <li><strong>Coverage Visualization:</strong> View coverage areas and signal strength</li>\n</ul>\n\n<h4 id=\"getting-started\">🚀 Getting Started</h4>\n\n<h4>Step 1: Add a Tower Site</h4>\n<ol>\n  <li>Navigate to <strong>Coverage Map</strong> module</li>\n  <li>Click <strong>\"Add Site\"</strong> button</li>\n  <li>Enter site information:\n    <ul>\n      <li><strong>Site Name</strong> - Unique identifier</li>\n      <li><strong>Address</strong> - Physical location</li>\n      <li><strong>GPS Coordinates</strong> - Latitude and longitude (or click on map)</li>\n      <li><strong>Site Type</strong> - Tower, Building, Pole, etc.</li>\n      <li><strong>Height</strong> - Tower height in meters</li>\n    </ul>\n  </li>\n  <li>Click <strong>\"Save\"</strong> to create site</li>\n</ol>\n\n<h4>Step 2: Add Sectors</h4>\n<ol>\n  <li>Click on a tower site marker on the map</li>\n  <li>Click <strong>\"Add Sector\"</strong> from site popup</li>\n  <li>Enter sector details:\n    <ul>\n      <li><strong>Azimuth</strong> - Direction (0-360 degrees)</li>\n      <li><strong>Tilt</strong> - Antenna tilt angle</li>\n      <li><strong>Frequency</strong> - Operating frequency band</li>\n      <li><strong>Technology</strong> - LTE, 5G, WiMAX, etc.</li>\n      <li><strong>Power</strong> - Transmit power</li>\n    </ul>\n  </li>\n  <li>Save sector</li>\n</ol>\n\n<h4>Step 3: Add CPE Devices</h4>\n<ol>\n  <li>Click <strong>\"Add CPE\"</strong> button</li>\n  <li>Enter CPE information:\n    <ul>\n      <li><strong>Serial Number</strong> - Device identifier</li>\n      <li><strong>Customer</strong> - Associated customer</li>\n      <li><strong>Location</strong> - GPS coordinates or click on map</li>\n      <li><strong>Model</strong> - CPE device model</li>\n      <li><strong>Status</strong> - Active, Inactive, Maintenance</li>\n    </ul>\n  </li>\n  <li>Save CPE device</li>\n</ol>\n\n<h4 id=\"map-features\">🗺️ Map Features</h4>\n\n<h4>Map Controls</h4>\n<ul>\n  <li><strong>Zoom:</strong> Mouse wheel or +/- buttons</li>\n  <li><strong>Pan:</strong> Click and drag map</li>\n  <li><strong>Basemap:</strong> Switch between street, satellite, hybrid, topographic</li>\n  <li><strong>Search:</strong> Search for addresses or coordinates</li>\n  <li><strong>Measure:</strong> Measure distances between points</li>\n  <li><strong>Draw:</strong> Draw coverage areas and zones</li>\n</ul>\n\n<h4>Map Layers</h4>\n<ul>\n  <li><strong>Tower Sites:</strong> Network infrastructure sites</li>\n  <li><strong>Sectors:</strong> Antenna sectors with coverage arcs</li>\n  <li><strong>CPE Devices:</strong> Customer premise equipment</li>\n  <li><strong>Backhaul Links:</strong> Point-to-point connections</li>\n  <li><strong>Coverage Areas:</strong> Signal coverage visualization</li>\n  <li><strong>Equipment:</strong> Deployed equipment markers</li>\n</ul>\n\n<h4 id=\"site-management\">Site Management</h4>\n\n<h4>Viewing Site Details</h4>\n<p>Click on any site marker to see:</p>\n<ul>\n  <li>Site information and address</li>\n  <li>List of sectors configured</li>\n  <li>Deployed equipment inventory</li>\n  <li>Connected CPE devices</li>\n  <li>Backhaul links</li>\n  <li>Site actions menu</li>\n</ul>\n\n<h4>Editing Sites</h4>\n<ol>\n  <li>Click site marker</li>\n  <li>Click <strong>\"Edit Site\"</strong></li>\n  <li>Update site information</li>\n  <li>Move marker on map to update coordinates</li>\n  <li>Save changes</li>\n</ol>\n\n<h4 id=\"sector-configuration\">Sector Configuration</h4>\n\n<h4>Adding Sectors</h4>\n<p>Each tower can have multiple sectors:</p>\n<ul>\n  <li>Typically 3-6 sectors per tower</li>\n  <li>Each sector covers 60-120 degrees</li>\n  <li>Sectors can overlap for redundancy</li>\n  <li>Visual coverage arcs shown on map</li>\n</ul>\n\n<h4>Sector Parameters</h4>\n<ul>\n  <li><strong>Azimuth:</strong> Direction sector is pointing (0-360°)</li>\n  <li><strong>Tilt:</strong> Antenna downtilt angle</li>\n  <li><strong>Frequency:</strong> Operating frequency band</li>\n  <li><strong>Technology:</strong> LTE, 5G, WiMAX, etc.</li>\n  <li><strong>Power:</strong> Transmit power in dBm</li>\n  <li><strong>Height:</strong> Antenna height above ground</li>\n</ul>\n\n<h4 id=\"cpe-management\">📡 CPE Management</h4>\n\n<h4>Adding CPE Devices</h4>\n<p>CPE devices represent customer equipment:</p>\n<ul>\n  <li>Link to customer accounts</li>\n  <li>Track installation location</li>\n  <li>Monitor connection status</li>\n  <li>View signal strength</li>\n  <li>Manage firmware updates</li>\n</ul>\n\n<h4>CPE Status</h4>\n<ul>\n  <li><strong>Active:</strong> Device is online and operational</li>\n  <li><strong>Inactive:</strong> Device is offline or disconnected</li>\n  <li><strong>Maintenance:</strong> Device requires service</li>\n  <li><strong>Pending:</strong> Device awaiting installation</li>\n</ul>\n\n<h4 id=\"backhaul-management\">🔗 Backhaul Management</h4>\n\n<h4>Adding Backhaul Links</h4>\n<ol>\n  <li>Click <strong>\"Add Backhaul Link\"</strong></li>\n  <li>Select source site</li>\n  <li>Select destination site</li>\n  <li>Enter link details:\n    <ul>\n      <li><strong>Link Type:</strong> Point-to-point, Point-to-multipoint</li>\n      <li><strong>Frequency:</strong> Operating frequency</li>\n      <li><strong>Bandwidth:</strong> Link capacity</li>\n      <li><strong>Status:</strong> Active, Planned, Maintenance</li>\n    </ul>\n  </li>\n  <li>Save backhaul link</li>\n</ol>\n\n<h4>Visualizing Backhaul</h4>\n<ul>\n  <li>Lines connect source and destination sites</li>\n  <li>Color coding by status (green=active, red=down, yellow=maintenance)</li>\n  <li>Click link to view details</li>\n  <li>Monitor link utilization</li>\n</ul>\n\n<h4 id=\"equipment-inventory\">📦 Equipment Inventory</h4>\n\n<h4>Site Equipment</h4>\n<p>Track equipment deployed at each site:</p>\n<ul>\n  <li>Radios and antennas</li>\n  <li>Switches and routers</li>\n  <li>Power systems</li>\n  <li>Enclosures and mounting hardware</li>\n</ul>\n\n<h4>Adding Equipment</h4>\n<ol>\n  <li>Click site marker</li>\n  <li>Click <strong>\"Add Equipment\"</strong></li>\n  <li>Select equipment from inventory</li>\n  <li>Enter deployment date</li>\n  <li>Add notes</li>\n  <li>Save equipment assignment</li>\n</ol>\n\n<h4 id=\"filtering-search\">🔍 Filtering and Search</h4>\n\n<h4>Filter Panel</h4>\n<p>Use filters to focus on specific elements:</p>\n<ul>\n  <li><strong>Site Type:</strong> Filter by tower, building, pole</li>\n  <li><strong>Technology:</strong> Filter by LTE, 5G, WiMAX</li>\n  <li><strong>Status:</strong> Filter by active, inactive, maintenance</li>\n  <li><strong>Coverage Area:</strong> Show/hide coverage visualization</li>\n</ul>\n\n<h4>Search Functionality</h4>\n<ul>\n  <li>Search by site name</li>\n  <li>Search by address</li>\n  <li>Search by customer name</li>\n  <li>Search by equipment serial number</li>\n</ul>\n\n<h4 id=\"reports-export\">📊 Reports and Export</h4>\n\n<h4>Available Reports</h4>\n<ul>\n  <li><strong>Site Inventory:</strong> Equipment at each site</li>\n  <li><strong>Coverage Analysis:</strong> Coverage areas and gaps</li>\n  <li><strong>CPE Distribution:</strong> CPE devices by location</li>\n  <li><strong>Backhaul Network:</strong> Backhaul link topology</li>\n</ul>\n\n<h4>Export Options</h4>\n<ul>\n  <li>Export map as image (PNG, PDF)</li>\n  <li>Export site data to CSV</li>\n  <li>Export coverage data for analysis</li>\n  <li>Print map with annotations</li>\n</ul>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n<ul>\n  <li><strong>Accurate Coordinates:</strong> Use GPS for precise site locations</li>\n  <li><strong>Regular Updates:</strong> Keep site information current</li>\n  <li><strong>Documentation:</strong> Add notes and photos to sites</li>\n  <li><strong>Coverage Planning:</strong> Use coverage visualization for planning</li>\n  <li><strong>Equipment Tracking:</strong> Keep equipment inventory updated</li>\n  <li><strong>Backhaul Monitoring:</strong> Track backhaul link status</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>Map not loading:</h4>\n<ul>\n  <li>Check ArcGIS API key is configured</li>\n  <li>Verify internet connection</li>\n  <li>Clear browser cache</li>\n  <li>Check browser console for errors</li>\n</ul>\n\n<h4>Sites not appearing:</h4>\n<ul>\n  <li>Check filters aren't hiding sites</li>\n  <li>Verify site coordinates are valid</li>\n  <li>Zoom out to see all sites</li>\n  <li>Check site status filter</li>\n</ul>\n\n<h4>Can't add sectors:</h4>\n<ul>\n  <li>Verify site is selected</li>\n  <li>Check you have edit permissions</li>\n  <li>Ensure site exists and is saved</li>\n</ul>\n\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === 'hss-subscribers'\" hidden aria-hidden=\"true\">\n        <article>\n\n<h3>🔐 HSS & Subscriber Management</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Manage Home Subscriber Server (HSS) database for LTE/5G networks. Create, configure, and manage subscriber profiles, authentication credentials, and service access for mobile network subscribers.\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#getting-started\">🚀 Getting Started</a></li>\n    <li><a href=\"#subscriber-management\">📱 Subscriber Management</a></li>\n    <li><a href=\"#authentication\">🔐 Authentication</a></li>\n    <li><a href=\"#group-management\">👥 Group Management</a></li>\n    <li><a href=\"#epc-deployment\">🌐 EPC Deployment</a></li>\n    <li><a href=\"#mme-connection\">🔌 MME Connection</a></li>\n    <li><a href=\"#monitoring\">📊 Monitoring</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n    <li><a href=\"#technical-details\">📚 Technical Details</a></li>\n  </ul>\n</div>\n\n<h4 id=\"key-features\">🎯 Key Features</h4>\n<ul>\n  <li><strong>Subscriber Management:</strong> Create, edit, and delete subscriber profiles</li>\n  <li><strong>Authentication:</strong> Manage authentication vectors (AUTN, RAND, XRES, CK, IK)</li>\n  <li><strong>Service Profiles:</strong> Configure APN (Access Point Name) and service access</li>\n  <li><strong>Group Management:</strong> Organize subscribers into groups for bulk operations</li>\n  <li><strong>EPC Integration:</strong> Deploy and manage Evolved Packet Core (EPC) systems</li>\n  <li><strong>MME Connection:</strong> Connect Mobile Management Entities (MMEs) to HSS</li>\n  <li><strong>Monitoring:</strong> Track subscriber activity and authentication events</li>\n</ul>\n\n<h4 id=\"getting-started\">🚀 Getting Started</h4>\n\n<h4>Step 1: Add a Subscriber</h4>\n<ol>\n  <li>Navigate to <strong>HSS Management</strong> module</li>\n  <li>Click <strong>\"Add Subscriber\"</strong> button</li>\n  <li>Enter subscriber information:\n    <ul>\n      <li><strong>IMSI</strong> - International Mobile Subscriber Identity (15 digits, required)</li>\n      <li><strong>MSISDN</strong> - Mobile Station International Subscriber Directory Number (phone number, optional)</li>\n      <li><strong>Ki</strong> - Authentication key (128-bit hex, required)</li>\n      <li><strong>OP/OPc</strong> - Operator variant key (optional, for enhanced security)</li>\n      <li><strong>APN</strong> - Access Point Name (default: internet)</li>\n      <li><strong>QoS Profile</strong> - Quality of Service settings</li>\n    </ul>\n  </li>\n  <li>Click <strong>\"Create Subscriber\"</strong></li>\n</ol>\n\n<h4>Step 2: Configure APN</h4>\n<p>Access Point Names define network access:</p>\n<ul>\n  <li><strong>Default APN:</strong> Usually \"internet\" for data access</li>\n  <li><strong>Custom APNs:</strong> Create APNs for specific services</li>\n  <li><strong>APN Settings:</strong> Configure IP allocation, DNS, and routing</li>\n</ul>\n\n<h4>Step 3: Assign to Group</h4>\n<ol>\n  <li>Select subscriber from list</li>\n  <li>Click <strong>\"Edit\"</strong></li>\n  <li>Select subscriber group</li>\n  <li>Groups help organize subscribers for bulk operations</li>\n  <li>Save changes</li>\n</ol>\n\n<h4 id=\"subscriber-management\">📱 Subscriber Management</h4>\n\n<h4>Subscriber Fields</h4>\n<ul>\n  <li><strong>IMSI:</strong> Unique 15-digit identifier (MCC + MNC + MSIN)</li>\n  <li><strong>MSISDN:</strong> Phone number (E.164 format)</li>\n  <li><strong>Ki:</strong> 128-bit authentication key (hex format)</li>\n  <li><strong>OP/OPc:</strong> Operator variant key for enhanced security</li>\n  <li><strong>APN:</strong> Access Point Name for data services</li>\n  <li><strong>QoS:</strong> Quality of Service profile</li>\n  <li><strong>Status:</strong> Active, Suspended, Deleted</li>\n</ul>\n\n<h4>Editing Subscribers</h4>\n<ol>\n  <li>Click subscriber from list</li>\n  <li>Click <strong>\"Edit\"</strong> button</li>\n  <li>Update subscriber information</li>\n  <li><strong>Note:</strong> Changing Ki requires re-authentication</li>\n  <li>Save changes</li>\n</ol>\n\n<h4>Suspending Subscribers</h4>\n<p>Temporarily disable subscriber access:</p>\n<ol>\n  <li>Select subscriber</li>\n  <li>Click <strong>\"Suspend\"</strong></li>\n  <li>Subscriber cannot authenticate</li>\n  <li>Click <strong>\"Activate\"</strong> to restore access</li>\n</ol>\n\n<h4 id=\"authentication\">🔐 Authentication</h4>\n\n<h4>How Authentication Works</h4>\n<p>The HSS generates authentication vectors for MMEs:</p>\n<ol>\n  <li>MME requests authentication vector from HSS</li>\n  <li>HSS generates RAND (random challenge)</li>\n  <li>HSS calculates AUTN, XRES, CK, IK using Ki</li>\n  <li>HSS sends authentication vector to MME</li>\n  <li>MME challenges subscriber with RAND</li>\n  <li>Subscriber calculates RES using Ki</li>\n  <li>MME compares RES with XRES</li>\n  <li>If match, subscriber is authenticated</li>\n</ol>\n\n<h4>Security Best Practices</h4>\n<ul>\n  <li><strong>Secure Ki Storage:</strong> Encrypt Ki values in database</li>\n  <li><strong>Unique Ki:</strong> Each subscriber must have unique Ki</li>\n  <li><strong>OP/OPc:</strong> Use operator variant keys for enhanced security</li>\n  <li><strong>Regular Rotation:</strong> Consider rotating Ki periodically</li>\n  <li><strong>Access Control:</strong> Limit who can view/edit Ki values</li>\n</ul>\n\n<h4 id=\"group-management\">👥 Group Management</h4>\n\n<h4>Creating Groups</h4>\n<ol>\n  <li>Navigate to <strong>Groups</strong> section</li>\n  <li>Click <strong>\"Create Group\"</strong></li>\n  <li>Enter group name and description</li>\n  <li>Set group settings (APN, QoS, etc.)</li>\n  <li>Save group</li>\n</ol>\n\n<h4>Using Groups</h4>\n<ul>\n  <li>Assign subscribers to groups</li>\n  <li>Apply group settings to all members</li>\n  <li>Bulk operations on group members</li>\n  <li>Organize by service tier or location</li>\n</ul>\n\n<h4 id=\"epc-deployment\">🌐 EPC Deployment</h4>\n\n<h4>What is EPC?</h4>\n<p>Evolved Packet Core (EPC) is the core network for LTE:</p>\n<ul>\n  <li><strong>HSS:</strong> Home Subscriber Server (this module)</li>\n  <li><strong>MME:</strong> Mobility Management Entity</li>\n  <li><strong>SGW:</strong> Serving Gateway</li>\n  <li><strong>PGW:</strong> Packet Data Network Gateway</li>\n  <li><strong>PCRF:</strong> Policy and Charging Rules Function</li>\n</ul>\n\n<h4>Deploying EPC</h4>\n<ol>\n  <li>Navigate to <strong>EPC Deployment</strong> section</li>\n  <li>Select deployment type (Cloud, On-Premise, Hybrid)</li>\n  <li>Configure network settings</li>\n  <li>Deploy HSS component</li>\n  <li>Connect MMEs to HSS</li>\n  <li>Test authentication flow</li>\n</ol>\n\n<h4 id=\"mme-connection\">🔌 MME Connection</h4>\n\n<h4>Connecting MMEs</h4>\n<p>MMEs connect to HSS via S6a interface:</p>\n<ol>\n  <li>Configure MME with HSS address</li>\n  <li>Set up Diameter protocol connection</li>\n  <li>Configure TLS/SSL for security</li>\n  <li>Test connection</li>\n  <li>Monitor authentication requests</li>\n</ol>\n\n<h4>MME Configuration</h4>\n<ul>\n  <li><strong>HSS Address:</strong> IP address or hostname</li>\n  <li><strong>Port:</strong> Diameter port (usually 3868)</li>\n  <li><strong>Realm:</strong> Diameter realm</li>\n  <li><strong>TLS:</strong> Enable TLS for secure connection</li>\n  <li><strong>Heartbeat:</strong> Configure watchdog/heartbeat</li>\n</ul>\n\n<h4 id=\"monitoring\">📊 Monitoring</h4>\n\n<h4>Subscriber Activity</h4>\n<p>Monitor subscriber activity:</p>\n<ul>\n  <li>Authentication success/failure rates</li>\n  <li>Active sessions</li>\n  <li>Data usage</li>\n  <li>Location updates</li>\n</ul>\n\n<h4>HSS Performance</h4>\n<ul>\n  <li>Authentication request rate</li>\n  <li>Response times</li>\n  <li>Error rates</li>\n  <li>Database performance</li>\n</ul>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n<ul>\n  <li><strong>Unique IMSIs:</strong> Ensure each subscriber has unique IMSI</li>\n  <li><strong>Secure Ki:</strong> Protect authentication keys</li>\n  <li><strong>Regular Backups:</strong> Backup subscriber database regularly</li>\n  <li><strong>Monitor Activity:</strong> Track authentication events</li>\n  <li><strong>Group Organization:</strong> Use groups for easier management</li>\n  <li><strong>Documentation:</strong> Document APN configurations</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>Subscriber cannot authenticate:</h4>\n<ul>\n  <li>Verify Ki is correct</li>\n  <li>Check IMSI format (15 digits)</li>\n  <li>Verify subscriber status is Active</li>\n  <li>Check MME connection to HSS</li>\n  <li>Review authentication logs</li>\n</ul>\n\n<h4>MME connection failed:</h4>\n<ul>\n  <li>Verify HSS address and port</li>\n  <li>Check firewall rules</li>\n  <li>Test Diameter connection</li>\n  <li>Verify TLS certificates</li>\n  <li>Check HSS service status</li>\n</ul>\n\n<h4>Authentication failures:</h4>\n<ul>\n  <li>Verify Ki matches subscriber device</li>\n  <li>Check OP/OPc configuration</li>\n  <li>Review authentication algorithm</li>\n  <li>Check for Ki mismatch</li>\n  <li>Verify MME configuration</li>\n</ul>\n\n<h4 id=\"technical-details\">📚 Technical Details</h4>\n\n<h4>IMSI Format</h4>\n<p>IMSI consists of:</p>\n<ul>\n  <li><strong>MCC:</strong> Mobile Country Code (3 digits)</li>\n  <li><strong>MNC:</strong> Mobile Network Code (2-3 digits)</li>\n  <li><strong>MSIN:</strong> Mobile Subscriber Identification Number (9-10 digits)</li>\n</ul>\n<p>Example: 310150123456789 (MCC: 310, MNC: 150, MSIN: 123456789)</p>\n\n<h4>Authentication Algorithms</h4>\n<ul>\n  <li><strong>MILENAGE:</strong> Standard 3GPP authentication algorithm</li>\n  <li><strong>TUAK:</strong> Alternative authentication algorithm</li>\n  <li><strong>Custom:</strong> Proprietary algorithms (not recommended)</li>\n</ul>\n\n<h4>APN Configuration</h4>\n<ul>\n  <li><strong>APN Name:</strong> Access Point Name identifier</li>\n  <li><strong>IP Type:</strong> IPv4, IPv6, or both</li>\n  <li><strong>QoS:</strong> Quality of Service profile</li>\n  <li><strong>Charging:</strong> Charging characteristics</li>\n</ul>\n\n        </article>\n\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedTopic === '__fallback'\" data-cwl-state-fallback=\"selectedTopic\" hidden aria-hidden=\"true\">\n        <article>\n          <h2>Documentation Coming Soon</h2>\n          <p>Detailed documentation for <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"topics.find(t => t.id === selectedTopic)?.title || selectedTopic\"></span></strong> will be added here.</p>\n          <p>In the meantime, explore the module and use tooltips for guidance.</p>\n        </article>\n      </div>\n    </main>\n  </div>\n</div></div>";
}

@page GET "/login"
page login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/login" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"login\" data-wisp-path=\"/login\" data-cwl-island=\"client\"><div class=\"login-page\">\n  <div class=\"login-container\">\n    <!-- Branding Section -->\n    <div class=\"login-brand\">\n      <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"brand-logo\" />\n\n        <div class=\"demo-site-ribbon\" role=\"note\" data-cwl-shell-key=\"showDemoChrome\" hidden aria-hidden=\"true\">Demo site — not production data</div>\n\n      <h1>WISP Management</h1>\n\n        <p class=\"brand-tagline\">wisptools.io</p>\n        <p class=\"poc-notice\">Part of wisptools.io. Source code: <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a> · <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener noreferrer\">CC BY 4.0</a></p>\n\n    </div>\n\n    <!-- Login Form -->\n    <div class=\"login-card\">\n      <h2>Welcome Back</h2>\n      <div class=\"demo-credentials-panel\" role=\"note\">\n        <p class=\"demo-credentials-title\">Demo login</p>\n        <p><strong>Email:</strong> demo@wisptools.io</p>\n        <p><strong>Password:</strong> WisptoolsDemo2026!</p>\n        <p class=\"demo-credentials-hint\">Use these on the GCE test site. Firebase Auth on management.wisptools.io.</p>\n      </div>\n\n      <p class=\"subtitle\">\n\n          <div data-cwl-shell-key=\"showDemoChrome\" hidden aria-hidden=\"true\"><strong class=\"demo-login-lead\">Demo environment</strong> — explore with a temporary visitor identity or use your account below.\n        </div>\n      </p>\n\n        <div class=\"demo-visitor-panel\" data-cwl-shell-key=\"demoVisitorEnabled\" hidden aria-hidden=\"true\">\n          <h3 class=\"demo-visitor-title\">Try without an account</h3>\n          <p class=\"demo-visitor-copy\">\n            Continue as a <strong>demo visitor</strong>. Your user id is tied to your network address (hashed on the server).\n            Data you create is <strong>limited</strong> and is <strong>removed when you sign out</strong>. Seeded demo rows are not deleted.\n          </p>\n          <button\n            type=\"button\"\n            class=\"btn-demo-visitor\" data-cwl-attr-disabled=\"isLoading\" data-cwl-action=\"handleDemoVisitorLogin\"\n           aria-label=\"Demo Visitor Login\">\n\n              Continue as demo visitor\n\n              <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n              Starting demo…\n            </div>\n          </button>\n        </div>\n\n        <div class=\"error-message\" hidden aria-hidden=\"true\">\n          <span class=\"error-icon\">⚠️</span>\n\n        </div>\n\n        <div class=\"success-message\" style=\"background-color: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); color: #22c55e; padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;\" hidden aria-hidden=\"true\">\n          <span>✅</span>\n\n        </div>\n\n        <div class=\"password-reset-form\" style=\"background: rgba(0, 217, 255, 0.1); border: 1px solid rgba(0, 217, 255, 0.3); border-radius: 0.5rem; padding: 1.5rem; margin-bottom: 1.5rem;\" data-cwl-shell-key=\"showPasswordReset\" hidden aria-hidden=\"true\">\n          <h3 style=\"margin-top: 0; margin-bottom: 1rem; color: #00d9ff;\">Reset Password</h3>\n\n            <p style=\"color: #a0d9e8; margin-bottom: 1rem; font-size: 0.875rem;\">\n              Enter your email address and we'll send you a link to reset your password.\n            </p>\n            <div class=\"form-group\">\n              <label for=\"passwordResetEmail\">Email Address</label>\n              <input\n                id=\"passwordResetEmail\"\n                type=\"email\"\n                placeholder=\"your@email.com\" data-cwl-attr-disabled=\"isLoading\"\n                required\n              />\n            </div>\n            <div style=\"display: flex; gap: 0.75rem;\">\n              <button\n                type=\"button\"\n                class=\"btn-primary\" data-cwl-action=\"handlePasswordReset\" data-cwl-attr-disabled=\"isLoading || !passwordResetEmail\"\n                style=\"flex: 1;\"\n               aria-label=\"Password Reset\">\n\n                  Send Reset Link\n\n                  <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n                  Sending...\n                </div>\n              </button>\n              <button\n                type=\"button\"\n                class=\"link-btn\" data-cwl-set=\"passwordResetEmail:\" data-cwl-attr-disabled=\"isLoading\"\n                style=\"background: rgba(0, 217, 255, 0.2); border: 1px solid rgba(0, 217, 255, 0.3); color: #00d9ff; padding: 0.875rem 1rem; border-radius: 0.5rem;\"\n              >\n                Cancel\n              </button>\n            </div>\n\n            <div data-cwl-shell-key=\"passwordResetSent\" hidden aria-hidden=\"true\"><p style=\"color: #a0d9e8; margin-bottom: 1rem;\">\n              ✅ Password reset email sent! Please check your inbox and follow the instructions to reset your password.\n            </p>\n            <button\n              type=\"button\"\n              class=\"link-btn\" data-cwl-set=\"passwordResetEmail:\"\n              style=\"background: rgba(0, 217, 255, 0.2); border: 1px solid rgba(0, 217, 255, 0.3); color: #00d9ff; padding: 0.875rem 1rem; border-radius: 0.5rem; width: 100%;\"\n            >\n              Back to Sign In\n            </button>\n          </div>\n        </div>\n\n      <form data-cwl-on-submit=\"action:handleSubmit\">\n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input\n            id=\"email\" value=\"demo@wisptools.io\"\n            type=\"email\"\n            placeholder=\"you@example.com\" data-cwl-attr-disabled=\"isLoading\"\n            required\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;\">\n            <label for=\"password\">Password</label>\n            <button\n              type=\"button\"\n              class=\"link-btn\"\n              style=\"font-size: 0.875rem; padding: 0;\" data-cwl-toggle=\"showPasswordReset:true\"\n             aria-label=\"Show Password Reset\">\n              Forgot password?\n            </button>\n          </div>\n          <input\n            id=\"password\"\n            type=\"password\"\n            placeholder=\"WisptoolsDemo2026!\" data-cwl-attr-disabled=\"isLoading\"\n            required\n          />\n        </div>\n\n        <button type=\"submit\" class=\"btn-primary\" data-cwl-attr-disabled=\"isLoading\">\n\n            Sign In\n\n            <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n            Signing in...\n          </div>\n        </button>\n      </form>\n\n        <div class=\"form-footer\">\n          <span class=\"link-btn\" style=\"text-decoration: none; opacity: 0.8;\">\n            Contact your admin for access\n          </span>\n        </div>\n\n        <div class=\"login-divider\">\n          <span></span>\n          <p>or</p>\n          <span></span>\n        </div>\n\n        <button type=\"button\" class=\"btn-google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n          <svg aria-hidden=\"true\" viewBox=\"0 0 533.5 544.3\">\n            <path fill=\"#4285f4\" d=\"M533.5 278.4c0-17.4-1.4-34.1-4.1-50.2H272v95h147.5c-6.4 34-25 62.8-53.4 82v68h86.1c50.4-46.5 80.3-115.1 80.3-194.8z\"/>\n            <path fill=\"#34a853\" d=\"M272 544.3c72.2 0 132.8-23.9 177-64.7l-86.1-68c-23.9 16.1-54.5 25.7-90.9 25.7-69.9 0-129.2-47.2-150.4-110.5h-90.7v69.8c44 87.4 134.5 148.7 241.1 148.7z\"/>\n            <path fill=\"#fbbc04\" d=\"M121.6 326.8c-10.2-30-10.2-62.5 0-92.5v-69.8h-90.7c-37.3 74.6-37.3 158.4 0 233z\"/>\n            <path fill=\"#ea4335\" d=\"M272 107.7c39.2-.6 76.4 13.8 105 39.9l78.2-78.2C404.5 25.5 344 0 272 0 165.4 0 74.9 61.3 30.9 148.7l90.7 69.8C142.7 175 202.1 107.7 272 107.7z\"/>\n          </svg>\n          <span>Sign in with Google</span>\n        </button>\n\n    </div>\n\n    <!-- Features Section -->\n    <div class=\"features\">\n      <div class=\"feature\">\n        <span class=\"feature-icon\">📊</span>\n        <h3>PCI Resolution</h3>\n        <p>Automated conflict detection</p>\n      </div>\n      <div class=\"feature\">\n        <span class=\"feature-icon\">📡</span>\n        <h3>Coverage Planning</h3>\n        <p>RF analysis tools</p>\n      </div>\n      <div class=\"feature\">\n        <span class=\"feature-icon\">🌐</span>\n        <h3>Spectrum Management</h3>\n        <p>Frequency planning</p>\n      </div>\n    </div>\n\n    <footer class=\"login-footer\">\n      <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a>\n      <span class=\"sep\">·</span>\n      <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener noreferrer\">CC BY 4.0</a>\n    </footer>\n\n  </div>\n</div></div>";
}

@route POST "/login"
handler login_post {
  effects: session.write;
  use auth session;
  header X-Tenant-ID;
  body email;
  body password;
  return { ok: true, email: "demo@wisptools.io", surface: "wisp-auth-native" };
}

@route GET "/api/me"
handler session_me {
  effects: session.read;
  use auth session;
  return { ok: true, authenticated: true, email: "preview@wisptools.local", surface: "wisp-auth-native" };
}

@page GET "/modules"
page modules_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"redirect\" data-wisp-path=\"/modules\"><div class=\"redirect-message\">Redirecting…</div><script>location.replace(\"/dashboard\");</script><noscript><a href=\"/dashboard\">Continue</a></noscript></div>";
}

@page GET "/modules/backend-management"
page modules_backend_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "backend-management" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"backend-management\" data-wisp-path=\"/modules/backend-management\" data-cwl-island=\"client\"><div class=\"backend-management\">\n    <!-- Admin Banner -->\n    <div class=\"admin-banner\">\n      <span>🔐 Platform Administrator Mode</span>\n      <span class=\"admin-user\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user?.email\"></span></span>\n    </div>\n\n    <!-- Page Header -->\n    <div class=\"page-header\">\n      <div>\n        <h1>🖥️ Backend Server Management</h1>\n        <p class=\"subtitle\">Monitor and control backend services on 136.112.111.167</p>\n      </div>\n      <a href=\"/dashboard\" class=\"btn-back\">\n        ← Back to Dashboard\n      </a>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"content-grid\">\n      <!-- System Overview -->\n      <div class=\"section full-width\">\n        <h2>🌐 System Overview</h2>\n        <div class=\"systems-grid\">\n          <!-- Frontend -->\n          <div class=\"system-card frontend\">\n            <div class=\"system-header\">\n              <h3>🌐 Frontend</h3>\n              <span class=\"status-badge status-online\">🟢 Online</span>\n            </div>\n            <div class=\"system-details\">\n              <div class=\"detail-item\">\n                <span class=\"label\">Platform:</span>\n                <span class=\"value\">Firebase Hosting</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"label\">URL:</span>\n                <span class=\"value\"><a href=\"https://wisptools.io\" target=\"_blank\">wisptools.io</a></span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"label\">Status:</span>\n                <span class=\"value\">Deployed & Active</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Backend -->\n          <div class=\"system-card backend\">\n            <div class=\"system-header\">\n              <h3>🖥️ Backend API</h3>\n              <span class=\"status-badge status-online\">🟢 Online</span>\n            </div>\n            <div class=\"system-details\">\n              <div class=\"detail-item\">\n                <span class=\"label\">Platform:</span>\n                <span class=\"value\">Google Cloud Functions</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"label\">Region:</span>\n                <span class=\"value\">us-central1</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"label\">Status:</span>\n                <span class=\"value\">Running</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Services -->\n          <div class=\"system-card services\">\n            <div class=\"system-header\">\n              <h3>⚙️ Services</h3>\n              <span class=\"status-badge status-online\">🟢 Monitoring</span>\n            </div>\n            <div class=\"system-details\">\n              <div class=\"detail-item\">\n                <span class=\"label\">Backend Server:</span>\n                <span class=\"value\">136.112.111.167</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"label\">Services:</span>\n                <span class=\"value\">PM2 + systemd</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"label\">Status:</span>\n                <span class=\"value\">See below</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Service Status -->\n      <div class=\"section full-width\">\n        <div data-cwl-component=\"ServiceStatus\" data-cwl-lifted-component=\"ServiceStatus\"><div class=\"service-status\">\n  <div class=\"section-header\">\n    <h2>🔧 Service Status</h2>\n    <button class=\"btn-refresh\" data-cwl-action=\"loadServices\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Load Services\">\n      🔄 Refresh\n    </button>\n  </div>\n\n    <div class=\"error-message\" hidden aria-hidden=\"true\">⚠️ </div>\n\n  <div class=\"services-grid\">\n    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"services as service\" data-cwl-each-item=\"service\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%3Cdiv%20class%3D%22service-card%22%20class%3Aonline%3D%7Bservice.status%20%3D%3D%3D%20'online'%7D%20class%3Aoffline%3D%7Bservice.status%20%3D%3D%3D%20'offline'%7D%3E%0A%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22service-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bservice.displayName%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22service-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22port%22%3EPort%20%7Bservice.port%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20service.uptime%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22uptime%22%3EUptime%3A%20%7BformatUptime(service.uptime)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22status-badge%20status-%7Bservice.status%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7Bservice.status%20%3D%3D%3D%20'online'%20%3F%20'%F0%9F%9F%A2'%20%3A%20service.status%20%3D%3D%3D%20'offline'%20%3F%20'%F0%9F%94%B4'%20%3A%20'%E2%9A%AA'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%7Bservice.status.toUpperCase()%7D%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%7B%23if%20service.status%20%3D%3D%3D%20'online'%20%26%26%20(service.memory%20%7C%7C%20service.cpu%20!%3D%3D%20undefined)%7D%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22service-metrics%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20service.memory%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22metric%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EMemory%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7BformatBytes(service.memory)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20service.cpu%20!%3D%3D%20undefined%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22metric%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3ECPU%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bservice.cpu.toFixed(1)%7D%25%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20service.restarts%20!%3D%3D%20undefined%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22metric%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3ERestarts%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bservice.restarts%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%7B%23if%20service.canControl%7D%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22service-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-action%20btn-restart%22%20data-cwl-action%3D%22handleServiceAction%22%20data-cwl-action-args%3D%22service.name%2C%20'restart'%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Service%20Action%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%94%84%20Restart%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20service.status%20%3D%3D%3D%20'online'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-action%20btn-stop%22%20data-cwl-action%3D%22handleServiceAction%22%20data-cwl-action-args%3D%22service.name%2C%20'stop'%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Service%20Action%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%8F%B9%EF%B8%8F%20Stop%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-action%20btn-start%22%20data-cwl-action%3D%22handleServiceAction%22%20data-cwl-action-args%3D%22service.name%2C%20'start'%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Service%20Action%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%96%B6%EF%B8%8F%20Start%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22no-control%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Csmall%3E%E2%9A%A0%EF%B8%8F%20External%20service%20-%20no%20direct%20control%3C%2Fsmall%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20\"><div class=\"service-card\">\n        <div class=\"service-header\">\n          <div>\n            <h3></h3>\n            <div class=\"service-meta\">\n              <span class=\"port\">Port </span>\n\n                <div hidden aria-hidden=\"true\"><span class=\"uptime\">Uptime: </span>\n              </div>\n            </div>\n          </div>\n          <div class=\"status-badge status-\">\n\n          </div>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"service.status === 'online' && (service.memory || service.cpu !== undefined)\"><div class=\"service-metrics\">\n\n              <div class=\"metric\" hidden aria-hidden=\"true\">\n                <span class=\"label\">Memory:</span>\n                <span class=\"value\"></span>\n              </div>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"service.cpu !== undefined\"><div class=\"metric\">\n                <span class=\"label\">CPU:</span>\n                <span class=\"value\">%</span>\n              </div></div>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"service.restarts !== undefined\"><div class=\"metric\">\n                <span class=\"label\">Restarts:</span>\n                <span class=\"value\"></span>\n              </div></div>\n          </div></div>\n\n          <div class=\"no-control\">\n            <small>⚠️ External service - no direct control</small>\n          </div>\n\n          <div class=\"service-actions\" hidden aria-hidden=\"true\">\n            <button\n              class=\"btn-action btn-restart\" data-cwl-action=\"handleServiceAction\" data-cwl-action-args=\"service.name, 'restart'\"\n             aria-label=\"Service Action\">\n              🔄 Restart\n            </button>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"service.status === 'online'\"><button\n                class=\"btn-action btn-stop\" data-cwl-action=\"handleServiceAction\" data-cwl-action-args=\"service.name, 'stop'\"\n               aria-label=\"Service Action\">\n                ⏹️ Stop\n              </button></div>\n              <button\n                class=\"btn-action btn-start\" data-cwl-action=\"handleServiceAction\" data-cwl-action-args=\"service.name, 'start'\"\n               aria-label=\"Service Action\">\n                ▶️ Start\n              </button>\n\n          </div>\n\n      </div></div>\n  </div>\n</div></div>\n      </div>\n\n      <!-- System Resources -->\n      <div class=\"section\">\n        <div data-cwl-component=\"SystemResources\" data-cwl-lifted-component=\"SystemResources\"><div class=\"system-resources\">\n  <h2>📊 System Resources</h2>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"systemInfo\"><div class=\"metrics-grid\">\n      <div class=\"metric-card\">\n        <div class=\"metric-icon\">💾</div>\n        <div class=\"metric-content\">\n          <div class=\"metric-label\">Memory Usage</div>\n          <div class=\"metric-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemInfo.memory?.percent || 'N/A'\"></span>%</div>\n\n            <div class=\"metric-detail\" hidden aria-hidden=\"true\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatBytes(systemInfo.memory.used)\"></span> / <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatBytes(systemInfo.memory.total)\"></span>\n            </div>\n\n        </div>\n      </div>\n\n      <div class=\"metric-card\">\n        <div class=\"metric-icon\">⚡</div>\n        <div class=\"metric-content\">\n          <div class=\"metric-label\">CPU Usage</div>\n          <div class=\"metric-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemInfo.cpu?.percent || 'N/A'\"></span>%</div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"systemInfo.cpu?.cores\"><div class=\"metric-detail\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemInfo.cpu.cores\"></span> cores</div></div>\n        </div>\n      </div>\n\n      <div class=\"metric-card\">\n        <div class=\"metric-icon\">💿</div>\n        <div class=\"metric-content\">\n          <div class=\"metric-label\">Disk Usage</div>\n          <div class=\"metric-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemInfo.disk?.percent || 'N/A'\"></span>%</div>\n\n            <div class=\"metric-detail\" hidden aria-hidden=\"true\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatBytes(systemInfo.disk.used)\"></span> / <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatBytes(systemInfo.disk.total)\"></span>\n            </div>\n\n        </div>\n      </div>\n\n      <div class=\"metric-card\">\n        <div class=\"metric-icon\">⏱️</div>\n        <div class=\"metric-content\">\n          <div class=\"metric-label\">Uptime</div>\n          <div class=\"metric-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatUptime(systemInfo.uptime || 0)\"></span></div>\n\n            <div class=\"metric-detail\" hidden aria-hidden=\"true\">Load: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"systemInfo.loadAvg.join(', ')\"></span></div>\n\n        </div>\n      </div>\n    </div></div>\n    <div class=\"empty-state\">\n      <p>System information unavailable. Configure backend API endpoint.</p>\n    </div>\n\n    <div class=\"loading-state\" hidden aria-hidden=\"true\">\n      <div class=\"spinner\"></div>\n      <p>Loading system information...</p>\n    </div>\n\n</div></div>\n      </div>\n\n      <!-- Quick Actions -->\n      <div class=\"section\">\n        <div data-cwl-component=\"QuickActions\" data-cwl-lifted-component=\"QuickActions\"><div class=\"quick-actions\">\n  <h2>⚡ Quick Actions</h2>\n\n  <div class=\"actions-grid\">\n    <button\n      class=\"action-card action-warning\" data-cwl-action=\"handleRestartAll\" data-cwl-attr-disabled=\"isExecuting\"\n     aria-label=\"Restart All\">\n      <div class=\"action-icon\">🔄</div>\n      <div class=\"action-content\">\n        <div class=\"action-title\">Restart All Services</div>\n        <div class=\"action-description\">Restart all PM2 services</div>\n      </div>\n    </button>\n\n    <button\n      class=\"action-card action-danger\" data-cwl-action=\"handleRebootVM\" data-cwl-attr-disabled=\"isExecuting\"\n     aria-label=\"Reboot VM\">\n      <div class=\"action-icon\">🔴</div>\n      <div class=\"action-content\">\n        <div class=\"action-title\">Reboot VM</div>\n        <div class=\"action-description\">Full system reboot (1-2 min downtime)</div>\n      </div>\n    </button>\n\n    <button\n      class=\"action-card action-info\" data-cwl-action=\"handleViewLogs\" data-cwl-attr-disabled=\"isExecuting\"\n     aria-label=\"View Logs\">\n      <div class=\"action-icon\">📋</div>\n      <div class=\"action-content\">\n        <div class=\"action-title\">View Cloud Logs</div>\n        <div class=\"action-description\">Open Google Cloud Logging</div>\n      </div>\n    </button>\n  </div>\n\n  <div class=\"warning-box\">\n    <strong>⚠️ Important:</strong> These actions affect the entire backend server.\n    All users will be impacted. Use with caution during active operations.\n  </div>\n</div></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"loading\" hidden aria-hidden=\"true\">\n    <div class=\"spinner\"></div>\n    <p>Verifying admin access...</p>\n  </div></div>\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\" data-cwl-orphan-modal=\"1\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\" hidden aria-hidden=\"true\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/billing"
page modules_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/billing" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"billing\" data-wisp-path=\"/modules/billing\" data-cwl-island=\"client\"><div class=\"billing-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-content\">\n        <button class=\"back-btn\" data-cwl-nav=\"/dashboard\">\n          <span class=\"back-icon\">←</span>\n          Back to Dashboard\n        </button>\n        <div class=\"module-title\">\n          <h1>💳 Billing & Subscriptions</h1>\n          <p>Manage your subscription and billing information</p>\n        </div>\n        <div class=\"tenant-info\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$currentTenant\"><span class=\"tenant-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.name\"></span></span>\n            <span class=\"tenant-subdomain\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant.subdomain\"></span></span></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n\n        <div class=\"error-banner\" hidden aria-hidden=\"true\">\n          <p>⚠️ </p>\n          <button class=\"retry-btn\" data-cwl-action=\"loadBillingData\" aria-label=\"Load Billing Data\">Retry</button>\n        </div>\n\n        <!-- Current Subscription -->\n        <div class=\"current-subscription\">\n          <h2>Current Subscription</h2>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentSubscription\">\n            <div class=\"subscription-card\">\n              <div class=\"subscription-header\">\n                <div class=\"plan-info\">\n                  <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentPlan?.name || 'Unknown Plan'\"></span></h3>\n                  <p class=\"plan-description\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentPlan?.description || ''\"></span></p>\n                </div>\n                <div class=\"subscription-status\">\n                  <span class=\"badge\">\n                    <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentSubscription.status\"></span>\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"subscription-details\">\n                <div class=\"detail-item\">\n                  <span class=\"label\">Current Period:</span>\n                  <span class=\"value\">\n                    <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDate(currentSubscription.currentPeriodStart)\"></span> - <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDate(currentSubscription.currentPeriodEnd)\"></span>\n                  </span>\n                </div>\n                <div class=\"detail-item\">\n                  <span class=\"label\">Plan Price:</span>\n                  <span class=\"value\">\n                    <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentPlan ? formatCurrency(currentPlan.price) : 'N/A'\"></span> / <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentPlan?.interval || 'month'\"></span>\n                  </span>\n                </div>\n                <div class=\"detail-item\">\n                  <span class=\"label\">Auto-renewal:</span>\n                  <span class=\"value\">\n                    <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentSubscription.cancelAtPeriodEnd ? 'Cancelled' : 'Active'\"></span>\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"subscription-actions\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentSubscription.status === 'active' && !currentSubscription.cancelAtPeriodEnd\"><button class=\"cancel-btn\" data-cwl-action=\"handleCancelSubscription\" aria-label=\"Cancel Subscription\">\n                    Cancel Subscription\n                  </button></div>\n                <button class=\"upgrade-btn\" data-cwl-toggle=\"showUpgradeModal:true\" aria-label=\"Show Upgrade Modal\">\n                  Change Plan\n                </button>\n              </div>\n            </div></div>\n            <div class=\"no-subscription\">\n              <p>No active subscription found. Choose a plan to get started.</p>\n            </div>\n\n        </div>\n\n        <!-- Available Plans -->\n        <div class=\"plans-section\">\n          <h2>Available Plans</h2>\n          <div class=\"plans-grid\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"plans as plan\" data-cwl-each-item=\"plan\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-card%20%7Bplan.isPopular%20%3F%20'popular'%20%3A%20''%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20plan.isPopular%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22popular-badge%22%3EMost%20Popular%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bplan.name%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-price%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22price%22%3E%7BformatCurrency(plan.price)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22interval%22%3E%2F%7Bplan.interval%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22plan-description%22%3E%7Bplan.description%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cul%20class%3D%22plan-features%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20plan.features%20as%20feature%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%E2%9C%93%20%7Bfeature%7D%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ful%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-limits%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EUp%20to%20%7Bplan.maxUsers%7D%20users%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22select-plan-btn%22%20data-cwl-action%3D%22handleUpgrade%22%20data-cwl-action-args%3D%22plan%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7BcurrentSubscription%3F.planId%20%3D%3D%3D%20plan.id%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Upgrade%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BcurrentSubscription%3F.planId%20%3D%3D%3D%20plan.id%20%3F%20'Current%20Plan'%20%3A%20'Select%20Plan'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"plan-card \">\n\n                  <div class=\"popular-badge\" hidden aria-hidden=\"true\">Most Popular</div>\n\n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"plan.features as feature\"><li>✓ </li></div>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button\n                  class=\"select-plan-btn\" data-cwl-action=\"handleUpgrade\" data-cwl-action-args=\"plan\" aria-label=\"Upgrade\">\n\n                </button>\n              </div></div>\n          </div>\n        </div>\n\n        <!-- Payment Methods -->\n        <div class=\"payment-methods-section\">\n          <h2>Payment Methods</h2>\n\n            <div class=\"payment-methods-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"paymentMethods as method\" data-cwl-each-item=\"method\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22payment-method-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22method-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22method-type%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22method-icon%22%3E%F0%9F%92%B3%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22method-name%22%3EPayPal%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22method-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22method-email%22%3E%7Bmethod.paypalEmail%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20method.isDefault%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22default-badge%22%3EDefault%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22method-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22edit-btn%22%20data-cwl-action%3D%22openEditPaymentMethod%22%20data-cwl-action-args%3D%22method%22%20aria-label%3D%22Open%20Edit%20Payment%20Method%22%3EEdit%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"payment-method-card\">\n                  <div class=\"method-info\">\n                    <div class=\"method-type\">\n                      <span class=\"method-icon\">💳</span>\n                      <span class=\"method-name\">PayPal</span>\n                    </div>\n                    <div class=\"method-details\">\n                      <span class=\"method-email\"></span>\n\n                        <div hidden aria-hidden=\"true\"><span class=\"default-badge\">Default</span>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"method-actions\">\n                    <button class=\"edit-btn\" data-cwl-action=\"openEditPaymentMethod\" data-cwl-action-args=\"method\" aria-label=\"Open Edit Payment Method\">Edit</button>\n                  </div>\n                </div></div>\n            </div>\n\n            <div class=\"no-payment-methods\" hidden aria-hidden=\"true\">\n              <p>No payment methods found. Add a payment method to manage your subscription.</p>\n            </div>\n\n        </div>\n\n        <!-- Recent Invoices -->\n        <div class=\"invoices-section\">\n          <h2>Recent Invoices</h2>\n\n            <div class=\"invoices-table\">\n              <div class=\"table-header\">\n                <div class=\"col-date\">Date</div>\n                <div class=\"col-amount\">Amount</div>\n                <div class=\"col-status\">Status</div>\n                <div class=\"col-actions\">Actions</div>\n              </div>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"invoices as invoice\" data-cwl-each-item=\"invoice\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22table-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-date%22%3E%7BformatDate(invoice.createdAt)%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-amount%22%3E%7BformatCurrency(invoice.amount)%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-status%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7BgetStatusBadgeClass(invoice.status)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Binvoice.status%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22col-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20invoice.invoiceUrl%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ca%20href%3D%7Binvoice.invoiceUrl%7D%20target%3D%22_blank%22%20class%3D%22download-btn%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Download%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fa%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"table-row\">\n                  <div class=\"col-date\"></div>\n                  <div class=\"col-amount\"></div>\n                  <div class=\"col-status\">\n                    <span class=\"badge \">\n\n                    </span>\n                  </div>\n                  <div class=\"col-actions\">\n\n                      <div hidden aria-hidden=\"true\"><a target=\"_blank\" class=\"download-btn\">\n                        Download\n                      </a>\n                    </div>\n                  </div>\n                </div></div>\n            </div>\n\n            <div class=\"no-invoices\" hidden aria-hidden=\"true\">\n              <p>No invoices found.</p>\n            </div>\n\n        </div>\n\n    </div>\n\n    <!-- Edit Payment Method Modal -->\n\n      <div class=\"modal-overlay\" data-cwl-toggle=\"showEditPaymentModal:false\" data-cwl-shell-key=\"showEditPaymentModal\" hidden aria-hidden=\"true\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h3>Edit Payment Method</h3>\n            <button class=\"modal-close\" data-cwl-toggle=\"showEditPaymentModal:false\" aria-label=\"Show Edit Payment Modal\">✕</button>\n          </div>\n          <div class=\"modal-body\">\n            <div class=\"form-group\">\n              <label>PayPal Email</label>\n              <input\n                type=\"email\"\n                placeholder=\"paypal@example.com\"\n                required\n              />\n            </div>\n          </div>\n          <div class=\"modal-footer\">\n            <button class=\"btn-secondary\" data-cwl-toggle=\"showEditPaymentModal:false\" aria-label=\"Show Edit Payment Modal\">Cancel</button>\n            <button class=\"btn-primary\" data-cwl-action=\"handleSavePaymentMethod\" aria-label=\"Save Payment Method\">Save</button>\n          </div>\n        </div>\n      </div>\n\n  </div></div>";
}

@page GET "/modules/cbrs-management"
page modules_cbrs_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "cbrs-management" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"cbrs-management\" data-wisp-path=\"/modules/cbrs-management\" data-cwl-island=\"client\"><!-- CBRS Setup Wizard -->\n\n  <div data-cwl-shell-key=\"showSetupWizard\" hidden aria-hidden=\"true\"><div data-cwl-component=\"CBRSSetupWizard\" data-cwl-lifted-component=\"CBRSSetupWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSetupWizard\" hidden aria-hidden=\"true\"><div class=\"wizard-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"wizard-title\" hidden aria-hidden=\"true\">\n    <div class=\"wizard-modal\">\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\">📡 CBRS Setup Wizard</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <!-- Progress Steps -->\n      <nav class=\"wizard-steps\" aria-label=\"CBRS setup steps\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"steps as step, index\"><button\n            type=\"button\"\n            class=\"wizard-step\" aria-label=\"Wizard step\">\n            <span class=\"step-icon\"></span>\n            <span class=\"step-title\"></span>\n          </button></div>\n      </nav>\n\n      <!-- Step Content -->\n      <div class=\"wizard-content\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n          <div class=\"alert alert-success\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><!-- Welcome Step -->\n          <div class=\"wizard-panel\">\n            <div class=\"welcome-content\">\n              <h3>Welcome to CBRS Setup! 📡</h3>\n              <p>Let's configure your CBRS (Citizens Broadband Radio Service) integration with Google SAS.</p>\n\n              <div class=\"info-box\">\n                <h4>What is CBRS?</h4>\n                <p>CBRS allows you to use shared spectrum in the 3.5 GHz band for wireless broadband services. This setup will connect your system to Google's Spectrum Access System (SAS).</p>\n              </div>\n\n              <div class=\"setup-requirements\">\n                <h4>What You'll Need:</h4>\n                <ul>\n                  <li>✅ Google SAS account</li>\n                  <li>✅ Google User ID from your platform administrator</li>\n                  <li>✅ Access to your tenant settings</li>\n                </ul>\n              </div>\n\n              <div class=\"setup-time\">\n                <strong>⏱️ Estimated time:</strong> 2-3 minutes\n              </div>\n            </div>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 1\"><!-- Information Step -->\n          <div class=\"wizard-panel\">\n            <h3>How CBRS Works</h3>\n\n            <div class=\"info-section\">\n              <h4>📋 Shared Platform Mode</h4>\n              <p>Your organization uses a shared CBRS platform. The platform administrator manages API keys, and you only need to provide your Google User ID.</p>\n            </div>\n\n            <div class=\"info-section\">\n              <h4>🔑 Getting Your Google User ID</h4>\n              <ol>\n                <li>Contact your platform administrator</li>\n                <li>Request your Google SAS User ID</li>\n                <li>They will provide you with a User ID unique to your organization</li>\n              </ol>\n            </div>\n\n            <div class=\"info-section\">\n              <h4>✨ What This Enables</h4>\n              <ul>\n                <li>Register CBRS devices with Google SAS</li>\n                <li>Request spectrum grants</li>\n                <li>Monitor grant status</li>\n                <li>Manage device heartbeats</li>\n              </ul>\n            </div>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><!-- Google User ID Step -->\n          <div class=\"wizard-panel\">\n            <h3>Enter Google User ID</h3>\n            <p>Enter the Google User ID provided by your platform administrator.</p>\n\n            <div class=\"form-group\">\n              <label for=\"google-user-id\">\n                Google User ID <span class=\"required\">*</span>\n              </label>\n              <input\n                id=\"google-user-id\"\n                type=\"text\"\n                placeholder=\"e.g., user-123456\"\n                class=\"form-input\" data-cwl-attr-disabled=\"isLoading\"\n              />\n              <small class=\"form-hint\">This is the unique identifier for your organization in Google SAS.</small>\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"google-email\">\n                Google Account Email (Optional)\n              </label>\n              <input\n                id=\"google-email\"\n                type=\"email\"\n                placeholder=\"your-email@example.com\"\n                class=\"form-input\" data-cwl-attr-disabled=\"isLoading\"\n              />\n              <small class=\"form-hint\">Optional: Your Google account email for reference.</small>\n            </div>\n\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 3\"><!-- Test Connection Step -->\n          <div class=\"wizard-panel\">\n            <h3>Test Configuration</h3>\n            <p>Let's verify your configuration is correct.</p>\n\n            <div class=\"test-section\">\n              <h4>Configuration Summary</h4>\n              <div class=\"config-summary\">\n                <div class=\"summary-row\">\n                  <span class=\"label\">Google User ID:</span>\n                  <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"googleUserId || 'Not set'\"></span></span>\n                </div>\n                <div class=\"summary-row\">\n                  <span class=\"label\">Email:</span>\n                  <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"googleEmail || 'Not provided'\"></span></span>\n                </div>\n                <div class=\"summary-row\">\n                  <span class=\"label\">Deployment Model:</span>\n                  <span class=\"value\">Shared Platform</span>\n                </div>\n                <div class=\"summary-row\">\n                  <span class=\"label\">Provider:</span>\n                  <span class=\"value\">Google SAS</span>\n                </div>\n              </div>\n            </div>\n\n            <button class=\"btn-primary btn-test\" data-cwl-action=\"testConnection\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Test Connection\">\n              ✅ Test Connection\n            </button>\n\n            <div class=\"info-box\">\n              <p><strong>Note:</strong> The connection test validates your configuration format. Actual device registration and grant requests will be performed when you add devices in the CBRS Management module.</p>\n            </div>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 4\"><!-- Complete Step -->\n          <div class=\"wizard-panel\">\n            <h3>🎉 CBRS Setup Complete!</h3>\n            <p>Your CBRS configuration has been saved successfully.</p>\n\n            <div class=\"next-steps\">\n              <h4>What's Next?</h4>\n              <a href=\"/modules/cbrs-management\" class=\"next-step-item\">\n                <span class=\"icon\">📱</span>\n                <div>\n                  <strong>Add Your First Device</strong>\n                  <p>Register a CBRS device to start using spectrum</p>\n                </div>\n              </a>\n              <a href=\"/modules/cbrs-management\" class=\"next-step-item\">\n                <span class=\"icon\">📊</span>\n                <div>\n                  <strong>Request Spectrum Grants</strong>\n                  <p>Request spectrum grants for your devices</p>\n                </div>\n              </a>\n              <a href=\"/modules/cbrs-management\" class=\"next-step-item\">\n                <span class=\"icon\">🔍</span>\n                <div>\n                  <strong>Monitor Grant Status</strong>\n                  <p>Track your grant requests and device status</p>\n                </div>\n              </a>\n            </div>\n          </div></div>\n      </div>\n\n      <!-- Wizard Footer -->\n      <div class=\"wizard-footer\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 0\"><button class=\"btn-secondary\" data-cwl-action=\"prevStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Prev Step\">\n            ← Previous\n          </button></div>\n          <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Close\">\n            Cancel\n          </button>\n\n        <div class=\"footer-actions\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><button class=\"btn-primary\" data-cwl-action=\"saveConfiguration\" data-cwl-attr-disabled=\"isLoading || !googleUserId.trim()\" aria-label=\"Save Configuration\">\n              Save & Continue →\n            </button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 3\"><button class=\"btn-secondary\" data-cwl-action=\"prevStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Prev Step\">\n              ← Back\n            </button>\n            <button class=\"btn-primary\" data-cwl-action=\"nextStep\" data-cwl-attr-disabled=\"isLoading || !success\" aria-label=\"Next Step\">\n              Skip Test →\n            </button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep < steps.length - 1\"><button class=\"btn-primary\" data-cwl-action=\"nextStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Next Step\">\n              Next →\n            </button></div>\n            <button class=\"btn-primary\" data-cwl-action=\"completeSetup\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Complete Setup\">\n              Finish →\n            </button>\n\n        </div>\n      </div>\n    </div>\n  </div></div></div>\n</div>\n<!-- CBRS Device Registration Wizard -->\n<div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"CBRSDeviceRegistrationWizard\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cbrs-module\">\n  <!-- Header -->\n  <div class=\"module-header\">\n    <div class=\"header-content\">\n      <div class=\"header-left\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          Back to Dashboard\n        </a>\n        <h1 class=\"module-title\">\n          <span class=\"module-icon\">📡</span>\n          CBRS Management\n        </h1>\n        <p class=\"module-description\">Citizens Broadband Radio Service spectrum management</p>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tenantName\"><div class=\"tenant-badge\">\n            <span class=\"tenant-icon\">🏢</span>\n            <span class=\"tenant-text\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenantName\"></span></span>\n          </div></div>\n      </div>\n\n      <div class=\"header-actions\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentUserID\"><button\n              class=\"btn btn-network-selector active\" data-cwl-toggle=\"showUserIDSelector:true\"\n              title=\"Switch network/User ID\"\n            >\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n              <path d=\"M2 12h20\"/>\n              <path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/>\n            </svg>\n            <span class=\"network-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentUserIDDisplay\"></span></span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n              <path d=\"M6 9l6 6 6-6\"/>\n            </svg>\n          </button></div>\n          <button\n            class=\"btn btn-network-selector\" data-cwl-toggle=\"showUserIDSelector:true\"\n            title=\"Select network/User ID\"\n          >\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n              <path d=\"M2 12h20\"/>\n              <path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/>\n            </svg>\n            Select Network\n          </button>\n\n        <button class=\"btn btn-secondary\" data-cwl-toggle=\"showSettingsModal:true\" title=\"Configure SAS providers\">\n          ⚙️ Settings\n        </button>\n        <button class=\"btn btn-primary\" data-cwl-toggle=\"showAddDeviceModal:true\" aria-label=\"Show Add Device Modal\">\n          + Add CBSD Device\n        </button>\n        <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showModuleWizardMenu\" hidden aria-hidden=\"true\"><div class=\"module-wizard-menu\">\n    <button\n      type=\"button\"\n      class=\"wizard-trigger\" data-cwl-attr-disabled=\"disabled\" data-cwl-action=\"toggle\" data-cwl-on-blur=\"action:handleBlur\"\n      title=\"Wizards for this module\"\n      aria-haspopup=\"true\"\n    >\n      <span class=\"wizard-trigger-icon\">🧙</span>\n      <span class=\"wizard-trigger-label\">Wizards</span>\n      <span class=\"wizard-trigger-chevron\">▼</span>\n    </button>\n\n      <div class=\"wizard-dropdown\" role=\"menu\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"wizards as w\" data-cwl-each-item=\"w\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22menuitem%22%0A%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22wizard-item%22%20data-cwl-action%3D%22select%22%20data-cwl-action-args%3D%22w.id%22%0A%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20w.icon%7D%3Cspan%20class%3D%22wizard-item-icon%22%3E%7Bw.icon%7D%3C%2Fspan%3E%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22wizard-item-label%22%3E%7Bw.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20\"><button\n            type=\"button\"\n            role=\"menuitem\"\n            class=\"wizard-item\" data-cwl-action=\"select\" data-cwl-action-args=\"w.id\"\n           aria-label=\"Select\">\n            <div hidden aria-hidden=\"true\"><span class=\"wizard-item-icon\"></span></div>\n            <span class=\"wizard-item-label\"></span>\n          </button></div>\n      </div>\n\n  </div></div></div>\n      </div>\n    </div>\n  </div>\n\n    <div class=\"error-banner\" hidden aria-hidden=\"true\">\n      <span class=\"error-icon\">⚠️</span>\n      <span class=\"error-message\"></span>\n      <button class=\"btn btn-sm\" data-cwl-set=\"error:\">✕</button>\n    </div>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!tenantId\"><div class=\"error-banner\">\n      <span class=\"error-icon\">⚠️</span>\n      <span class=\"error-message\">\n        No tenant selected. Please return to the\n        <a href=\"/dashboard\" class=\"inline-link\">dashboard</a>\n        and select a tenant first.\n      </span>\n    </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"configStatus.status !== 'complete'\"><div class=\"warning-banner\">\n      <span class=\"warning-icon\">⚠️</span>\n      <span class=\"warning-message\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"configStatus.message\"></span>\n        <button class=\"btn btn-link\" data-cwl-toggle=\"showSetupWizard:true\" aria-label=\"Show Setup Wizard\">\n          Run Setup Wizard →\n        </button>\n        <button class=\"btn btn-link\" data-cwl-toggle=\"showSettingsModal:true\" aria-label=\"Show Settings Modal\">\n          Configure Manually →\n        </button>\n      </span>\n    </div></div>\n\n  <!-- Main Content -->\n  <div class=\"module-content\">\n    <!-- Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📡</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"devices.length\"></span></div>\n          <div class=\"stat-label\">Total Devices</div>\n        </div>\n      </div>\n\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">✅</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"devices.filter(d => d.state === 'REGISTERED' || d.state === 'GRANTED' || d.state\"></span></div>\n          <div class=\"stat-label\">Registered</div>\n        </div>\n      </div>\n\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📊</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"devices.reduce((sum, d) => sum + (d.activeGrants?.length || 0), 0)\"></span></div>\n          <div class=\"stat-label\">Active Grants</div>\n        </div>\n      </div>\n\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🌐</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"CBRS_BAND.BANDWIDTH / 1000000\"></span> MHz</div>\n          <div class=\"stat-label\">CBRS Band</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Map -->\n    <div class=\"map-section\">\n      <div class=\"map-header\">\n        <h3>CBSD Device Map</h3>\n        <div class=\"legend\">\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #10b981;\"></span>\n            <span>Active</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #3b82f6;\"></span>\n            <span>Registered</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #6b7280;\"></span>\n            <span>Unregistered</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"map-container\">\n        <div class=\"arcgis-map\"></div>\n\n          <div class=\"map-loading\" hidden aria-hidden=\"true\">\n            <div class=\"loading-spinner\"></div>\n            <p>Loading CBRS devices...</p>\n          </div>\n\n      </div>\n    </div>\n\n    <!-- Device List and Grant Status -->\n    <div class=\"content-grid\">\n      <div class=\"device-list-section\">\n        <h3>CBSD Devices</h3>\n        <div data-cwl-component=\"DeviceList\" data-cwl-lifted-component=\"DeviceList\"><div class=\"device-list\">\n  <div class=\"list-header\">\n    <div class=\"search-section\">\n      <input\n        type=\"text\"\n        class=\"search-input\"\n        placeholder=\"Search devices...\"\n      />\n      <select class=\"filter-select\">\n        <option value=\"all\">All States</option>\n        <option value=\"UNREGISTERED\">Unregistered</option>\n        <option value=\"REGISTERED\">Registered</option>\n        <option value=\"GRANTED\">Granted</option>\n        <option value=\"AUTHORIZED\">Authorized</option>\n        <option value=\"SUSPENDED\">Suspended</option>\n        <option value=\"DEREGISTERED\">Deregistered</option>\n      </select>\n    </div>\n    <div class=\"device-count\">\n      <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filteredDevices.length\"></span> device<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filteredDevices.length !== 1 ? 's' : ''\"></span>\n    </div>\n  </div>\n\n  <div class=\"device-table-container\">\n    <table class=\"device-table\">\n      <thead>\n        <tr>\n          <th>Serial Number</th>\n          <th>FCC ID</th>\n          <th>Category</th>\n          <th>Provider</th>\n          <th>State</th>\n          <th>Active Grants</th>\n          <th>Location</th>\n          <th>Actions</th>\n        </tr>\n      </thead>\n      <tbody>\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredDevices as device\" data-cwl-each-item=\"device\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Ctr%20class%3D%22device-row%22%20data-cwl-action%3D%22onDeviceSelect%22%20data-cwl-action-args%3D%22device%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22serial-number%22%3E%7Bdevice.cbsdSerialNumber%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22fcc-id%22%3E%7Bdevice.fccId%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22category-badge%20category-%7Bdevice.cbsdCategory.toLowerCase()%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bdevice.cbsdCategory%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22provider%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22provider-badge%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BgetProviderBadge(device.sasProviderId)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22state%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22state-badge%22%20style%3D%22--state-color%3A%20%7BgetStateColor(device.state)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bdevice.state%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22grants%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bdevice.activeGrants%3F.length%20%7C%7C%200%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22location%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%93%8D%20%7Bdevice.installationParam.latitude.toFixed(4)%7D%2C%20%7Bdevice.installationParam.longitude.toFixed(4)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22actions%22%20on%3Aclick%7CstopPropagation%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20device.state%20%3D%3D%3D%20'UNREGISTERED'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn%20btn-sm%20btn-primary%22%20data-cwl-action%3D%22onRegister%22%20data-cwl-action-args%3D%22device%22%20aria-label%3D%22Register%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Register%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%20if%20device.state%20%3D%3D%3D%20'REGISTERED'%20%7C%7C%20device.state%20%3D%3D%3D%20'GRANTED'%20%7C%7C%20device.state%20%3D%3D%3D%20'AUTHORIZED'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn%20btn-sm%20btn-danger%22%20data-cwl-action%3D%22onDeregister%22%20data-cwl-action-args%3D%22device%22%20aria-label%3D%22Deregister%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Deregister%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20\"><tr class=\"device-row\" data-cwl-action=\"onDeviceSelect\" data-cwl-action-args=\"device\">\n            <td class=\"serial-number\"></td>\n            <td class=\"fcc-id\"></td>\n            <td class=\"category\">\n              <span class=\"category-badge category-\">\n\n              </span>\n            </td>\n            <td class=\"provider\">\n              <span class=\"provider-badge\">\n\n              </span>\n            </td>\n            <td class=\"state\">\n              <span class=\"state-badge\" style=\"--state-color: \">\n\n              </span>\n            </td>\n            <td class=\"grants\">\n\n            </td>\n            <td class=\"location\">\n              📍 ,\n            </td>\n            <td class=\"actions\">\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.state === 'UNREGISTERED'\"><button class=\"btn btn-sm btn-primary\" data-cwl-action=\"onRegister\" data-cwl-action-args=\"device\" aria-label=\"Register\">\n                  Register\n                </button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.state === 'REGISTERED' || device.state === 'GRANTED' || device.state === 'AUTHORIZED'\"><button class=\"btn btn-sm btn-danger\" data-cwl-action=\"onDeregister\" data-cwl-action-args=\"device\" aria-label=\"Deregister\">\n                  Deregister\n                </button></div>\n            </td>\n          </tr></div>\n      </tbody>\n    </table>\n\n      <div class=\"empty-state\" hidden aria-hidden=\"true\">\n        <div class=\"empty-icon\">📡</div>\n        <p class=\"empty-text\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"devices.length === 0 ? 'No CBSD devices yet' : 'No devices match your filters'\"></span></p>\n        <p class=\"empty-subtext\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"devices.length === 0 ? 'Run the Setup Wizard or add your first CBSD device above\"></span></p>\n\n          <div hidden aria-hidden=\"true\"><button type=\"button\" class=\"btn-get-started\" data-cwl-action=\"getstarted\" aria-label=\"Getstarted\">\n            📡 Get Started with CBRS Setup\n          </button>\n        </div>\n      </div>\n\n  </div>\n</div></div>\n      </div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedDevice\"><div class=\"grant-status-section\">\n          <div data-cwl-component=\"GrantStatus\" data-cwl-lifted-component=\"GrantStatus\"><div class=\"grant-status\">\n  <div class=\"grant-header\">\n    <h3>Grant Status</h3>\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.state === 'REGISTERED' || device.state === 'GRANTED'\"><button class=\"btn btn-primary\" data-cwl-action=\"onRequestGrant\" data-cwl-action-args=\"device\" aria-label=\"Request Grant\">\n        + Request New Grant\n      </button></div>\n  </div>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"hasGrants\"><div class=\"grants-container\">\n      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"activeGrants as grant\" data-cwl-each-item=\"grant\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-card-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-id%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22grant-label%22%3EGrant%20ID%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22grant-value%22%3E%7Bgrant.grantId%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22grant-state-badge%22%20style%3D%22--state-color%3A%20%7BgetGrantStateColor(grant.grantState)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bgrant.grantState%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3EChannel%20Type%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%20channel-%7Bgrant.channelType.toLowerCase()%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bgrant.channelType%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3EMax%20EIRP%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%22%3E%7Bgrant.operationParam.maxEirp%7D%20dBm%2FMHz%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3EFrequency%20Range%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%20frequency%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatFrequency(grant.operationParam.operationFrequencyRange.lowFrequency)%7D%20-%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatFrequency(grant.operationParam.operationFrequencyRange.highFrequency)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3EGrant%20Expires%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%20time-remaining%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BgetTimeRemaining(grant.grantExpireTime)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3EHeartbeat%20Interval%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%22%3E%7Bgrant.heartbeatInterval%7Ds%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20grant.lastHeartbeat%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3ELast%20Heartbeat%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bnew%20Date(grant.lastHeartbeat).toLocaleString()%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22grant-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn%20btn-sm%20btn-danger%22%20data-cwl-action%3D%22onRelinquishGrant%22%20data-cwl-action-args%3D%22device%2C%20grant.grantId%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Relinquish%20Grant%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20Relinquish%20Grant%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20\"><div class=\"grant-card\">\n          <div class=\"grant-card-header\">\n            <div class=\"grant-id\">\n              <span class=\"grant-label\">Grant ID</span>\n              <span class=\"grant-value\"></span>\n            </div>\n            <span class=\"grant-state-badge\" style=\"--state-color: \">\n\n            </span>\n          </div>\n\n          <div class=\"grant-details\">\n            <div class=\"grant-detail-row\">\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">Channel Type</span>\n                <span class=\"detail-value channel-\">\n\n                </span>\n              </div>\n\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">Max EIRP</span>\n                <span class=\"detail-value\"> dBm/MHz</span>\n              </div>\n            </div>\n\n            <div class=\"grant-detail-row\">\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">Frequency Range</span>\n                <span class=\"detail-value frequency\">\n                   -\n\n                </span>\n              </div>\n            </div>\n\n            <div class=\"grant-detail-row\">\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">Grant Expires</span>\n                <span class=\"detail-value time-remaining\">\n\n                </span>\n              </div>\n\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">Heartbeat Interval</span>\n                <span class=\"detail-value\">s</span>\n              </div>\n            </div>\n\n              <div class=\"grant-detail-row\" hidden aria-hidden=\"true\">\n                <div class=\"detail-item\">\n                  <span class=\"detail-label\">Last Heartbeat</span>\n                  <span class=\"detail-value\">\n\n                  </span>\n                </div>\n              </div>\n\n          </div>\n\n          <div class=\"grant-actions\">\n            <button\n              class=\"btn btn-sm btn-danger\" data-cwl-action=\"onRelinquishGrant\" data-cwl-action-args=\"device, grant.grantId\"\n             aria-label=\"Relinquish Grant\">\n              Relinquish Grant\n            </button>\n          </div>\n        </div></div>\n    </div></div>\n    <div class=\"no-grants\">\n      <div class=\"no-grants-icon\">📊</div>\n      <p class=\"no-grants-text\">No Active Grants</p>\n      <p class=\"no-grants-subtext\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.state === 'REGISTERED'\">Request a grant to start transmitting</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.state === 'UNREGISTERED'\">Register the device first to request grants</div>\n          Device must be in REGISTERED or GRANTED state\n\n      </p>\n    </div>\n\n</div></div>\n        </div></div>\n    </div>\n  </div>\n</div>\n\n<!-- Add Device Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showAddDeviceModal:false\" data-cwl-shell-key=\"showAddDeviceModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>Add CBSD Device</h3>\n        <button class=\"modal-close\" data-cwl-toggle=\"showAddDeviceModal:false\" aria-label=\"Show Add Device Modal\">✕</button>\n      </div>\n      <div class=\"modal-body\">\n        <form data-cwl-on-submit=\"action:handleAddDevice\" data-cwl-on-submit-args=\"e\">\n          <div class=\"form-group\">\n            <label>CBSD Serial Number</label>\n            <input type=\"text\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>FCC ID</label>\n            <input type=\"text\" required />\n          </div>\n\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label>Category</label>\n              <select>\n                <option value=\"A\">Category A (Indoor)</option>\n                <option value=\"B\">Category B (Outdoor)</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>SAS Provider</label>\n              <div class=\"readonly-field\">\n                <span class=\"provider-badge\">🔵 Google SAS</span>\n                <span class=\"provider-note\">Shared Platform Mode</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label>Latitude</label>\n              <input type=\"number\" step=\"0.0001\" required />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Longitude</label>\n              <input type=\"number\" step=\"0.0001\" required />\n            </div>\n          </div>\n\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label>Height (m)</label>\n              <input type=\"number\" step=\"0.1\" required />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Antenna Gain (dBi)</label>\n              <input type=\"number\" step=\"0.1\" required />\n            </div>\n          </div>\n\n          <div class=\"form-actions\">\n            <button type=\"button\" class=\"btn btn-secondary\" data-cwl-toggle=\"showAddDeviceModal:false\" aria-label=\"Show Add Device Modal\">\n              Cancel\n            </button>\n            <button type=\"submit\" class=\"btn btn-primary\">\n              Add Device\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n\n<!-- Grant Request Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showGrantRequestModal:false\" data-cwl-shell-key=\"showGrantRequestModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>Request Spectrum Grant</h3>\n        <button class=\"modal-close\" data-cwl-toggle=\"showGrantRequestModal:false\" aria-label=\"Show Grant Request Modal\">✕</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"device-info-card\">\n          <p><strong>Device:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedDevice.cbsdSerialNumber\"></span></p>\n          <p><strong>FCC ID:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedDevice.fccId\"></span></p>\n          <p><strong>Category:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedDevice.cbsdCategory\"></span></p>\n        </div>\n\n        <form data-cwl-on-submit=\"action:handleSubmitGrantRequest\" data-cwl-on-submit-args=\"e\">\n          <div class=\"form-group\">\n            <label>Max EIRP (dBm/MHz)</label>\n            <input type=\"number\" step=\"0.1\" required />\n            <span class=\"form-hint\">Maximum Effective Isotropic Radiated Power</span>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Low Frequency (Hz)</label>\n            <input type=\"number\" required />\n            <span class=\"form-hint\">Must be between 3550 MHz and 3700 MHz</span>\n          </div>\n\n          <div class=\"form-group\">\n            <label>High Frequency (Hz)</label>\n            <input type=\"number\" required />\n            <span class=\"form-hint\">Must be between 3550 MHz and 3700 MHz</span>\n          </div>\n\n          <div class=\"form-actions\">\n            <button type=\"button\" class=\"btn btn-secondary\" data-cwl-toggle=\"showGrantRequestModal:false\" aria-label=\"Show Grant Request Modal\">\n              Cancel\n            </button>\n            <button type=\"submit\" class=\"btn btn-primary\">\n              Request Grant\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n\n<!-- Settings Modal -->\n  <div data-cwl-component=\"SettingsModal\" data-cwl-lifted-component=\"SettingsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSettingsModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content settings-modal\">\n      <div class=\"modal-header\">\n        <h3>⚙️ CBRS Configuration</h3>\n        <button class=\"modal-close\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n        <form data-cwl-on-submit=\"toggle:isSaving:false\">\n          <!-- Info Banner -->\n          <div class=\"info-banner\">\n            <span class=\"info-icon\">ℹ️</span>\n            <div class=\"info-content\">\n              <strong>Optional Security Configuration</strong>\n              <p>Upload a PFX certificate for enhanced mTLS security with Google SAS. This is optional but recommended for production deployments.</p>\n            </div>\n          </div>\n\n          <!-- PFX Certificate Section -->\n          <div class=\"form-section\">\n            <h4>🔒 Client Certificate (Optional)</h4>\n\n            <div class=\"form-group\">\n              <label>PFX Certificate (.pfx or .p12)</label>\n              <input\n                type=\"file\"\n                accept=\".pfx,.p12\" data-cwl-on-change=\"action:handlePFXUpload\"\n                class=\"file-input\"\n              />\n\n                <div hidden aria-hidden=\"true\"><span class=\"file-status\">✅ <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.pfxCertificateName\"></span></span>\n              </div>\n              <span class=\"form-hint\">\n                PFX/PKCS#12 file containing both certificate and private key\n              </span>\n            </div>\n\n            <div class=\"form-group\">\n              <label>PFX Password</label>\n              <input\n                type=\"password\"\n                placeholder=\"Enter PFX password\"\n                autocomplete=\"off\"\n              />\n              <span class=\"form-hint\">\n                Password to decrypt the PFX certificate file\n              </span>\n            </div>\n          </div>\n\n          <!-- Enhanced Features -->\n          <div class=\"form-section enhancement-section\">\n            <h4>Enhanced Features</h4>\n\n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Advanced Analytics</span>\n              </label>\n              <p class=\"checkbox-hint\">Get detailed performance metrics and insights</p>\n            </div>\n\n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Automated Optimization</span>\n              </label>\n              <p class=\"checkbox-hint\">Let SAS automatically optimize spectrum assignments</p>\n            </div>\n\n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Multi-Site Coordination</span>\n              </label>\n              <p class=\"checkbox-hint\">Coordinate spectrum across multiple sites</p>\n            </div>\n\n            <div class=\"checkbox-group\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Enable Interference Monitoring</span>\n              </label>\n              <p class=\"checkbox-hint\">Real-time interference detection and alerts</p>\n            </div>\n          </div>\n\n          <!-- Security Notice -->\n          <div class=\"security-notice\">\n            <div class=\"notice-icon\">🔒</div>\n            <div class=\"notice-content\">\n              <strong>Security:</strong> All certificates and passwords are encrypted and stored securely in Firestore.\n              Your configuration is isolated to your tenant account.\n            </div>\n          </div>\n\n          <!-- Actions -->\n          <div class=\"form-actions\">\n            <button\n              type=\"button\"\n              class=\"btn btn-secondary\" data-cwl-action=\"handleClose\"\n             aria-label=\"Close\">\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              class=\"btn btn-primary\" data-cwl-attr-disabled=\"isSaving\"\n            >\n\n                💾 Save Settings\n\n                <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n                Saving...\n              </div>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- User ID / Network Selector Modal (includes Google login) -->\n<div data-cwl-component=\"UserIDSelector\" data-cwl-lifted-component=\"UserIDSelector\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showUserIDSelector\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>🆔 Select Network / Customer</h3>\n        <button class=\"modal-close\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n\n          <div class=\"error-banner\" hidden aria-hidden=\"true\">\n            <span class=\"error-icon\">⚠️</span>\n            <div></div>\n          </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!googleAuthState?.isAuthenticated\"><!-- Google Sign-In Section -->\n          <div class=\"signin-section\">\n            <div class=\"signin-header\">\n              <h4>🔐 Sign in to Google SAS Portal</h4>\n              <p>Sign in with your Google account to access your CBRS networks</p>\n            </div>\n\n            <button\n              type=\"button\"\n              class=\"btn-google-signin\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isSigningIn\"\n             aria-label=\"Google Sign In\">\n\n                <svg class=\"google-icon\" viewBox=\"0 0 24 24\" width=\"18\" height=\"18\">\n                  <path fill=\"#4285F4\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n                  <path fill=\"#34A853\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n                  <path fill=\"#FBBC05\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n                  <path fill=\"#EA4335\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n                </svg>\n                Sign in with Google\n\n                <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n                Signing in...\n              </div>\n            </button>\n            <p class=\"signin-hint\">\n              Sign in with your Google account registered for CBRS SAS API access\n            </p>\n          </div></div>\n          <!-- Signed In - Show User ID Selection -->\n          <div class=\"signed-in-header\">\n            <div class=\"signin-info\">\n              <span class=\"info-icon\">✅</span>\n              <div>\n                <strong>Signed in as:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"googleAuthState.googleEmail\"></span>\n              </div>\n            </div>\n            <button class=\"btn-signout-small\" data-cwl-action=\"handleSignOut\" aria-label=\"Sign Out\">\n              Sign out\n            </button>\n          </div>\n\n            <p class=\"instruction\">\n              Select the network/customer you want to manage:\n            </p>\n\n            <div class=\"userids-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"userIds as userId\" data-cwl-each-item=\"userId\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22userid-card%22%20data-cwl-action%3D%22selectUserId%22%20data-cwl-action-args%3D%22userId%22%20aria-label%3D%22Select%20User%20Id%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22userid-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22userid-icon%22%3E%F0%9F%93%A1%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22userid-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7BuserId.displayName%20%7C%7C%20userId.userId%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20userId.displayName%20%26%26%20userId.userId%20!%3D%3D%20userId.displayName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22userid-number%22%3EID%3A%20%7BuserId.userId%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20userId.isPrimary%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22primary-badge%22%3EPrimary%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20userId.organizationName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22userid-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22meta-label%22%3EOrganization%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22meta-value%22%3E%7BuserId.organizationName%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><button class=\"userid-card\" data-cwl-action=\"selectUserId\" data-cwl-action-args=\"userId\" aria-label=\"Select User Id\">\n                  <div class=\"userid-header\">\n                    <span class=\"userid-icon\">📡</span>\n                    <div class=\"userid-info\">\n                      <h4></h4>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"userId.displayName && userId.userId !== userId.displayName\"><p class=\"userid-number\">ID: </p></div>\n                    </div>\n\n                      <div hidden aria-hidden=\"true\"><span class=\"primary-badge\">Primary</span>\n                    </div>\n                  </div>\n\n                    <div class=\"userid-meta\" hidden aria-hidden=\"true\">\n                      <span class=\"meta-label\">Organization:</span>\n                      <span class=\"meta-value\"></span>\n                    </div>\n\n                </button></div>\n            </div>\n\n            <div class=\"no-userids\" hidden aria-hidden=\"true\">\n              <p>No CBRS networks found for your Google account.</p>\n              <p class=\"hint\">Contact your SAS administrator to grant access.</p>\n            </div>\n\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" data-cwl-toggle=\"showHelpModal:true\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showHelpModal\" hidden aria-hidden=\"true\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">CBRS Management Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n<h3>📡 CBRS Management Module</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Manage Citizens Broadband Radio Service (CBRS) spectrum for the 3.5 GHz band (3550-3700 MHz) with integrated support for Google SAS and Federated Wireless.\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#overview\">Overview</a></li>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#cbrs-basics\">CBRS Basics</a></li>\n    <li><a href=\"#getting-started\">Getting Started</a></li>\n    <li><a href=\"#device-states\">Device States</a></li>\n    <li><a href=\"#grant-management\">Grant Management</a></li>\n    <li><a href=\"#api-integration\">API Integration</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#compliance\">Compliance & Regulations</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n    <li><a href=\"#support\">Support & Resources</a></li>\n  </ul>\n</div>\n\n<h4 id=\"overview\">Overview</h4>\n\nThe CBRS (Citizens Broadband Radio Service) Management module provides comprehensive spectrum management capabilities for the 3.5 GHz CBRS band (3550-3700 MHz) with integrated support for:\n\n- **Google SAS (Spectrum Access System)** - Google's commercial SAS platform\n- **Federated Wireless** - Enhanced SAS with advanced analytics and optimization\n\n<h4>🎯 Key Features</h4>\n<ul>\n  <li><strong>CBSD Device Management:</strong>\n    <ul>\n      <li>Register and manage Citizens Broadband Service Devices (CBSDs)</li>\n      <li>Support for both Category A (indoor) and Category B (outdoor) devices</li>\n      <li>Real-time device status monitoring</li>\n      <li>GPS-based device mapping with ArcGIS integration</li>\n    </ul>\n  </li>\n  <li><strong>Spectrum Authorization:</strong>\n    <ul>\n      <li>Request spectrum grants from SAS providers</li>\n      <li>Automated heartbeat management</li>\n      <li>Real-time grant status tracking</li>\n      <li>Grant relinquishment and renewal</li>\n    </ul>\n  </li>\n  <li><strong>Geographic Visualization:</strong>\n    <ul>\n      <li>Interactive ArcGIS map showing CBSD locations</li>\n      <li>Color-coded device status indicators</li>\n      <li>Multi-site coordination visualization</li>\n      <li>Coverage area analysis</li>\n    </ul>\n  </li>\n  <li><strong>Analytics & Monitoring:</strong>\n    <ul>\n      <li>Real-time device performance metrics</li>\n      <li>Spectrum utilization tracking</li>\n      <li>Interference detection and monitoring</li>\n      <li>Historical data analysis</li>\n    </ul>\n  </li>\n</ul>\n\n<h4 id=\"cbrs-basics\">CBRS Basics</h4>\n\n### What is CBRS?\n\nCitizens Broadband Radio Service (CBRS) is a 150 MHz wide broadcast radio frequency band in the United States (3550-3700 MHz). It operates under an innovative three-tiered spectrum sharing framework:\n\n1. **Incumbent Access** - Federal and fixed satellite service users (highest priority)\n2. **Priority Access License (PAL)** - Licensed users with protected spectrum\n3. **General Authorized Access (GAA)** - Unlicensed users on available spectrum\n\n### Spectrum Access System (SAS)\n\nThe SAS is a cloud-based database and spectrum management system that:\n- Protects incumbent users from harmful interference\n- Manages spectrum assignments for PAL and GAA users\n- Provides dynamic spectrum allocation\n- Enforces FCC rules and regulations\n\n<h4 id=\"getting-started\">Getting Started</h4>\n\n### 1. Add a CBSD Device\n\n<p>Click <strong>\"+ Add CBSD Device\"</strong> and provide:</p>\n<ul>\n  <li><strong>CBSD Serial Number</strong> - Unique device identifier</li>\n  <li><strong>FCC ID</strong> - FCC equipment authorization identifier</li>\n  <li><strong>Category</strong> - A (indoor, lower power) or B (outdoor, higher power)</li>\n  <li><strong>SAS Provider</strong> - Google SAS or Federated Wireless</li>\n  <li><strong>Installation Parameters:</strong>\n    <ul>\n      <li>Latitude and Longitude (decimal degrees)</li>\n      <li>Height above ground (meters)</li>\n      <li>Antenna gain (dBi)</li>\n    </ul>\n  </li>\n</ul>\n\n<h4>Step 2: Register with SAS</h4>\n\n<p>Once added, devices must be registered with the selected SAS provider:</p>\n<ol>\n  <li>Select device from the list</li>\n  <li>Click <strong>\"Register\"</strong> button</li>\n  <li>SAS validates device and installation parameters</li>\n  <li>Upon success, device receives a CBSD ID</li>\n</ol>\n\n<h4>Step 3: Request Spectrum Grant</h4>\n\n<p>After registration, request a spectrum grant:</p>\n<ol>\n  <li>Select registered device</li>\n  <li>Click <strong>\"Request New Grant\"</strong></li>\n  <li>Specify:\n    <ul>\n      <li>Maximum EIRP (Effective Isotropic Radiated Power)</li>\n      <li>Frequency range (within 3550-3700 MHz)</li>\n    </ul>\n  </li>\n  <li>SAS evaluates request and assigns available spectrum</li>\n</ol>\n\n<h4>Step 4: Automated Heartbeat</h4>\n\n<p>Once granted, the system automatically:</p>\n<ul>\n  <li>Sends periodic heartbeats to SAS</li>\n  <li>Maintains spectrum authorization</li>\n  <li>Updates transmit expiration times</li>\n  <li>Reports device status</li>\n</ul>\n\n<h4 id=\"device-states\">Device States</h4>\n\n<h4>UNREGISTERED</h4>\n<p>Device is created but not yet registered with SAS. Cannot transmit.</p>\n\n<h4>REGISTERED</h4>\n<p>Device is registered with SAS and can request spectrum grants.</p>\n\n<h4>GRANTED</h4>\n<p>Device has one or more active spectrum grants but is not authorized to transmit.</p>\n\n<h4>AUTHORIZED</h4>\n<p>Device is authorized to transmit on granted frequencies. Active heartbeat required.</p>\n\n<h4>SUSPENDED</h4>\n<p>Spectrum grant is temporarily suspended. Cannot transmit until restored.</p>\n\n<h4>DEREGISTERED</h4>\n<p>Device is removed from SAS registration. All grants are terminated.</p>\n\n<h4 id=\"grant-management\">Grant Management</h4>\n\n<h4>Requesting Grants</h4>\n\n<p>When requesting a grant, consider:</p>\n\n<p><strong>Frequency Range</strong></p>\n<ul>\n  <li>Must be within CBRS band (3550-3700 MHz)</li>\n  <li>Typically 10-20 MHz channels</li>\n  <li>Avoid incumbent protection zones</li>\n</ul>\n\n<p><strong>Maximum EIRP</strong></p>\n<ul>\n  <li>Category A: Up to 30 dBm/10MHz</li>\n  <li>Category B: Up to 47 dBm/10MHz</li>\n  <li>SAS may reduce based on interference analysis</li>\n</ul>\n\n<p><strong>Channel Type</strong></p>\n<ul>\n  <li><strong>PAL</strong> - Priority Access License (if you hold PAL)</li>\n  <li><strong>GAA</strong> - General Authorized Access (most common)</li>\n</ul>\n\n<h4>Heartbeat Requirements</h4>\n\n<p>SAS requires periodic heartbeats (typically 60-240 seconds) to:</p>\n<ul>\n  <li>Confirm device operational status</li>\n  <li>Renew transmit authorization</li>\n  <li>Update interference measurements</li>\n  <li>Receive SAS commands</li>\n</ul>\n\n<p><strong>Heartbeat Process:</strong></p>\n<ol>\n  <li>System automatically sends heartbeats</li>\n  <li>SAS responds with transmit authorization</li>\n  <li>Authorization expires if heartbeat missed</li>\n  <li>Device must stop transmitting if expired</li>\n</ol>\n\n<h4>Relinquishing Grants</h4>\n\n<p>Relinquish grants when:</p>\n<ul>\n  <li>Device is no longer transmitting</li>\n  <li>Spectrum is not needed</li>\n  <li>Preparing for deregistration</li>\n  <li>Changing frequency assignments</li>\n</ul>\n\n<h4 id=\"api-integration\">API Integration</h4>\n\n<h4>Google SAS</h4>\n\n<p><strong>Features:</strong></p>\n<ul>\n  <li>WinnForum compliant SAS implementation</li>\n  <li>Integration with Google Cloud Platform</li>\n  <li>Real-time spectrum coordination</li>\n  <li>Automated interference protection</li>\n</ul>\n\n<p><strong>Best For:</strong></p>\n<ul>\n  <li>Standard CBRS deployments</li>\n  <li>Cost-effective spectrum management</li>\n  <li>Google Cloud integration</li>\n  <li>Basic compliance requirements</li>\n</ul>\n\n<h4>Federated Wireless</h4>\n\n<p><strong>Features:</strong></p>\n<ul>\n  <li>Enhanced spectrum optimization</li>\n  <li>Advanced interference monitoring</li>\n  <li>Multi-site coordination</li>\n  <li>Real-time analytics and insights</li>\n  <li>Automated power optimization</li>\n</ul>\n\n<p><strong>Best For:</strong></p>\n<ul>\n  <li>Enterprise deployments</li>\n  <li>Multi-site networks</li>\n  <li>Advanced analytics needs</li>\n  <li>Maximum spectrum efficiency</li>\n</ul>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n\n<h4>Device Installation</h4>\n\n<ol>\n  <li><strong>Accurate GPS Coordinates</strong>\n    <ul>\n      <li>Use professional GPS equipment</li>\n      <li>Verify coordinates before registration</li>\n      <li>Update if device is relocated</li>\n    </ul>\n  </li>\n  <li><strong>Height Measurements</strong>\n    <ul>\n      <li>Measure from ground level (AGL)</li>\n      <li>Include antenna height</li>\n      <li>Account for building height for rooftop installations</li>\n    </ul>\n  </li>\n  <li><strong>Antenna Parameters</strong>\n    <ul>\n      <li>Accurate antenna gain critical for power calculations</li>\n      <li>Provide azimuth and downtilt if directional</li>\n      <li>Keep documentation updated</li>\n    </ul>\n  </li>\n</ol>\n\n<h4>Spectrum Management</h4>\n\n<ol>\n  <li><strong>Request Appropriate Bandwidth</strong>\n    <ul>\n      <li>Match to actual needs</li>\n      <li>Consider traffic patterns</li>\n      <li>Plan for growth</li>\n    </ul>\n  </li>\n  <li><strong>Monitor Grant Status</strong>\n    <ul>\n      <li>Check expiration times</li>\n      <li>Renew before expiration</li>\n      <li>Monitor heartbeat success rate</li>\n    </ul>\n  </li>\n  <li><strong>Handle Suspensions Gracefully</strong>\n    <ul>\n      <li>Implement immediate transmit stop</li>\n      <li>Wait for SAS clearance</li>\n      <li>Log suspension events</li>\n    </ul>\n  </li>\n</ol>\n\n<h4>Network Optimization</h4>\n\n<ol>\n  <li><strong>Use Available Spectrum Efficiently</strong>\n    <ul>\n      <li>Deploy only needed CBSDs</li>\n      <li>Use appropriate power levels</li>\n      <li>Avoid over-provisioning</li>\n    </ul>\n  </li>\n  <li><strong>Coordinate Multiple Sites</strong>\n    <ul>\n      <li>Use Federated Wireless multi-site coordination</li>\n      <li>Plan frequency reuse</li>\n      <li>Monitor inter-site interference</li>\n    </ul>\n  </li>\n  <li><strong>Regular Maintenance</strong>\n    <ul>\n      <li>Update device firmware</li>\n      <li>Verify GPS sync</li>\n      <li>Test emergency shutdown procedures</li>\n    </ul>\n  </li>\n</ol>\n\n<h4 id=\"compliance\">Compliance & Regulations</h4>\n\n<h4>FCC Requirements</h4>\n\n<p>All CBSD operations must comply with FCC Part 96 rules:</p>\n<ul>\n  <li>Use certified CBSD equipment (FCC ID required)</li>\n  <li>Register all devices with SAS</li>\n  <li>Respond to SAS commands immediately</li>\n  <li>Maintain accurate installation records</li>\n  <li>Stop transmitting when required</li>\n</ul>\n\n<h4>Incumbent Protection</h4>\n\n<p>SAS automatically protects:</p>\n<ul>\n  <li>Federal radar systems (Navy shipboard radar)</li>\n  <li>Fixed Satellite Service (FSS) earth stations</li>\n  <li>Grandfathered Fixed Service operations</li>\n</ul>\n\n<p><strong>Protection Zones:</strong></p>\n<ul>\n  <li>Coastal areas (0-80 km inland)</li>\n  <li>FSS earth station locations</li>\n  <li>Military installation perimeters</li>\n</ul>\n\n<h4>Record Keeping</h4>\n\n<p>Maintain records of:</p>\n<ul>\n  <li>Device registration details</li>\n  <li>Grant requests and approvals</li>\n  <li>Heartbeat logs</li>\n  <li>Suspension/termination events</li>\n  <li>Installation changes</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>Device Won't Register</h4>\n\n<p><strong>Check:</strong></p>\n<ul>\n  <li>FCC ID is valid and certified for CBRS</li>\n  <li>GPS coordinates are accurate</li>\n  <li>Device category matches equipment specs</li>\n  <li>No duplicate serial numbers</li>\n  <li>SAS API credentials are valid</li>\n</ul>\n\n<h4>Grant Request Denied</h4>\n\n<p><strong>Possible Causes:</strong></p>\n<ul>\n  <li>Requested frequency unavailable</li>\n  <li>Excessive interference predicted</li>\n  <li>In incumbent protection zone</li>\n  <li>Installation parameters invalid</li>\n  <li>Power level too high</li>\n</ul>\n\n<p><strong>Solutions:</strong></p>\n<ul>\n  <li>Request different frequency range</li>\n  <li>Reduce max EIRP</li>\n  <li>Verify installation parameters</li>\n  <li>Check for nearby PAL holders</li>\n  <li>Contact SAS provider support</li>\n</ul>\n\n<h4>Heartbeat Failures</h4>\n\n<p><strong>Check:</strong></p>\n<ul>\n  <li>Network connectivity</li>\n  <li>SAS API endpoint accessibility</li>\n  <li>System clock synchronization</li>\n  <li>Certificate validity (if using SSL)</li>\n  <li>Grant expiration status</li>\n</ul>\n\n<p><strong>Actions:</strong></p>\n<ul>\n  <li>Review error logs</li>\n  <li>Test network connection</li>\n  <li>Verify API credentials</li>\n  <li>Restart heartbeat service</li>\n  <li>Contact SAS support if persistent</li>\n</ul>\n\n<h4>Unexpected Suspension</h4>\n\n<p><strong>Causes:</strong></p>\n<ul>\n  <li>Incumbent activity detected</li>\n  <li>Interference reported</li>\n  <li>Missed heartbeats</li>\n  <li>SAS maintenance</li>\n  <li>Policy violation</li>\n</ul>\n\n<p><strong>Response:</strong></p>\n<ol>\n  <li>Immediately stop transmitting</li>\n  <li>Check SAS messages</li>\n  <li>Wait for AUTHORIZED state</li>\n  <li>Resume only when cleared</li>\n  <li>Investigate root cause</li>\n</ol>\n\n<h4 id=\"support\">Support & Resources</h4>\n\n<h4>Documentation</h4>\n<ul>\n  <li><a href=\"https://www.ecfr.gov/current/title-47/chapter-I/subchapter-B/part-96\" target=\"_blank\">FCC Part 96 Rules</a></li>\n  <li><a href=\"https://www.wirelessinnovation.org/cbrs-spectrum-access-system\" target=\"_blank\">WinnForum SAS Specifications</a></li>\n  <li><a href=\"https://cloud.google.com/spectrum-access-system\" target=\"_blank\">Google SAS Documentation</a></li>\n  <li><a href=\"https://www.federatedwireless.com/\" target=\"_blank\">Federated Wireless Portal</a></li>\n</ul>\n\n<h4>Getting Help</h4>\n<ul>\n  <li>Technical support: support@yourcompany.com</li>\n  <li>SAS Provider support links in module settings</li>\n  <li>Community forums and user groups</li>\n  <li>Professional services for deployment assistance</li>\n</ul>\n\n<h4>Additional Training</h4>\n<ul>\n  <li>CBRS fundamentals course</li>\n  <li>SAS integration workshop</li>\n  <li>Network planning services</li>\n  <li>Compliance training</li>\n</ul>\n\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- Quick Tips Modal -->\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showTipsModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div></div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/coverage-map"
page modules_coverage_map_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "coverage-map" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"coverage-map\" data-wisp-path=\"/modules/coverage-map\" data-cwl-island=\"client\"><div class=\"fullscreen-map\">\n  <!-- Full Screen Map -->\n\n    <div data-cwl-component=\"CoverageMapView\" data-cwl-lifted-component=\"CoverageMapView\"><div class=\"coverage-map-container\">\n  <div class=\"map-container\"></div>\n  <arcgis-basemap-toggle></arcgis-basemap-toggle>\n</div></div>\n\n    <div class=\"loading-overlay\" hidden aria-hidden=\"true\">\n      <div class=\"spinner\"></div>\n      <p>Loading network assets...</p>\n    </div>\n\n    <div\n      class=\"plan-draft-menu\"\n      style=\"left: px; top: px\"\n     data-cwl-shell-key=\"showPlanDraftMenu\" hidden aria-hidden=\"true\">\n      <div class=\"menu-header\">\n        <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedPlanDraft.properties?.name ?? selectedPlanDraft.featureType ?? 'Draft Ob\"></span></strong>\n        <small>Status: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedPlanDraft.status ?? 'draft'\"></span></small>\n      </div>\n      <div class=\"menu-body\">\n        <p>Drag the marker to refine this deployment location.</p>\n        <p class=\"coords\">\n          📍\n          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedPlanDraftCoords.latitude != null && typeof selectedPlanDraftCoords.latit\"></span>,\n          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedPlanDraftCoords.longitude != null && typeof selectedPlanDraftCoords.long\"></span>\n        </p>\n      </div>\n      <button class=\"menu-item\" data-cwl-action=\"handlePlanDraftMenuAction\" data-cwl-action-args=\"'edit-site'\" aria-label=\"Plan Draft Menu Action\">\n        ✏️ Edit Draft Details\n      </button>\n      <button class=\"menu-item\" data-cwl-action=\"handlePlanDraftMenuAction\" data-cwl-action-args=\"'add-sector'\" aria-label=\"Plan Draft Menu Action\">\n        📶 Add Sector\n      </button>\n      <button class=\"menu-item\" data-cwl-action=\"handlePlanDraftMenuAction\" data-cwl-action-args=\"'add-backhaul'\" aria-label=\"Plan Draft Menu Action\">\n        🔗 Add Backhaul Link\n      </button>\n      <button class=\"menu-item\" data-cwl-action=\"handlePlanDraftMenuAction\" data-cwl-action-args=\"'add-inventory'\" aria-label=\"Plan Draft Menu Action\">\n        📦 Add Equipment\n      </button>\n      <div class=\"menu-divider\"></div>\n      <button class=\"menu-item deploy-hardware\" data-cwl-action=\"handlePlanDraftMenuAction\" data-cwl-action-args=\"'deploy-epc'\" aria-label=\"Plan Draft Menu Action\">\n        📡 Deploy EPC/SNMP Server\n      </button>\n      <button class=\"menu-item\" data-cwl-action=\"handlePlanDraftMenuAction\" data-cwl-action-args=\"'deploy-hardware'\" aria-label=\"Plan Draft Menu Action\">\n        🔧 Deploy Other Hardware\n      </button>\n      <div class=\"menu-divider\"></div>\n      <button class=\"menu-item danger\" data-cwl-action=\"removePlanDraft\" aria-label=\"Remove Plan Draft\">\n        🗑️ Remove From Plan\n      </button>\n      <button class=\"menu-item\" data-cwl-toggle=\"showPlanDraftMenu:false\" aria-label=\"Show Plan Draft Menu\">\n        ✕ Close\n      </button>\n    </div>\n\n  <!-- Floating Control Panel -->\n  <div class=\"floating-controls\">\n\n      <button class=\"control-btn\" data-cwl-toggle=\"showFilters:flip\" title=\"Toggle Filters\">\n        🔍\n      </button>\n\n      <button class=\"control-btn\" data-cwl-toggle=\"showStats:flip\" title=\"Toggle Statistics\">\n        📊\n      </button>\n\n    <button\n      class=\"control-btn\" data-cwl-toggle=\"showDevicePanel:flip\"\n      title=\"Device Management (SNMP, TR-069, MikroTik, EPC)\"\n    >\n      📱\n    </button>\n\n    <!-- Map Type Toggle -->\n    <div class=\"control-group\">\n      <button class=\"control-btn map-control-btn\" title=\"Toggle Map Type\">\n        🗺️\n      </button>\n      <div class=\"control-dropdown\">\n        <div class=\"dropdown-section\">\n          <div class=\"dropdown-label\">Map View</div>\n          <div class=\"basemap-switcher-inline\">\n            <button\n              class=\"basemap-btn-inline\" data-cwl-action=\"changeBasemap\" data-cwl-action-args=\"'streets-vector'\"\n              title=\"Streets\"\n            >\n              🛣️\n            </button>\n            <button\n              class=\"basemap-btn-inline\" data-cwl-action=\"changeBasemap\" data-cwl-action-args=\"'hybrid'\"\n              title=\"Satellite\"\n            >\n              🛰️\n            </button>\n            <button\n              class=\"basemap-btn-inline\" data-cwl-action=\"changeBasemap\" data-cwl-action-args=\"'topo-vector'\"\n              title=\"Topographic\"\n            >\n              🗺️\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Help Button - Fixed Position -->\n  <button class=\"help-button\" data-cwl-toggle=\"showHelpModal:true\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n    <div class=\"plan-summary-card\" hidden aria-hidden=\"true\">\n      <div class=\"plan-summary-header\">\n        <span>Plan Drafts</span>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sharedMapStateTimestamp\"><small>Updated <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sharedMapStateTimestamp.toLocaleTimeString()\"></span></small></div>\n      </div>\n      <div class=\"plan-summary-total\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"displayPlanSummary.total\"></span> objects</div>\n      <div class=\"plan-summary-grid\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"Object.entries(displayPlanSummary.byType ?? ) as [type, count]\"><div class=\"plan-summary-item\">\n            <span class=\"label\"></span>\n            <span class=\"value\"></span>\n          </div></div>\n      </div>\n    </div>\n\n  <!-- Filters Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showFilters:false\" data-cwl-shell-key=\"showFilters\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content filters-modal\" hidden aria-hidden=\"true\">\n      <div class=\"modal-header\">\n        <h3>🔍 Map Filters</h3>\n        <button class=\"close-btn\" data-cwl-toggle=\"showFilters:false\" aria-label=\"Show Filters\">✕</button>\n      </div>\n      <div class=\"modal-body\">\n        <div data-cwl-component=\"FilterPanel\" data-cwl-lifted-component=\"FilterPanel\"><div class=\"filter-panel\">\n  <h3>🔍 Map Filters</h3>\n\n  <!-- Asset Type Filters -->\n  <div class=\"filter-section\">\n    <button\n      class=\"section-header\" data-cwl-action=\"toggleSection\" data-cwl-action-args=\"'assetTypes'\"\n     aria-label=\"Toggle Section\">\n      <h4>Asset Types</h4>\n\n    </button>\n    <div class=\"filter-options\">\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:toggleAssetType\" data-cwl-on-change-args=\"'towers'\"\n        />\n        <span class=\"filter-icon\">📡</span>\n        <span>Tower Sites</span>\n      </label>\n\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:toggleAssetType\" data-cwl-on-change-args=\"'sectors'\"\n        />\n        <span class=\"filter-icon\">📶</span>\n        <span>Sectors</span>\n      </label>\n\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:toggleAssetType\" data-cwl-on-change-args=\"'cpe'\"\n        />\n        <span class=\"filter-icon\">📱</span>\n        <span>CPE Devices</span>\n      </label>\n\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:toggleAssetType\" data-cwl-on-change-args=\"'marketing'\"\n        />\n        <span class=\"filter-icon\">📍</span>\n        <span>Marketing Leads</span>\n      </label>\n\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:toggleAssetType\" data-cwl-on-change-args=\"'equipment'\"\n        />\n        <span class=\"filter-icon\">🔧</span>\n        <span>Equipment</span>\n      </label>\n\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:toggleAssetType\" data-cwl-on-change-args=\"'backhaul'\"\n        />\n        <span class=\"filter-icon\">🔗</span>\n        <span>Backhaul Links</span>\n      </label>\n    </div>\n  </div>\n\n  <!-- Backhaul Type Filters -->\n\n    <div class=\"filter-section\" hidden aria-hidden=\"true\">\n      <button\n        class=\"section-header\" data-cwl-action=\"toggleSection\" data-cwl-action-args=\"'backhaulTypes'\"\n       aria-label=\"Toggle Section\">\n        <h4>Backhaul Types</h4>\n\n      </button>\n      <div class=\"filter-options\">\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:change\"\n          />\n          <span class=\"filter-icon\">🌐</span>\n          <span>Fiber</span>\n        </label>\n\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:change\"\n          />\n          <span class=\"filter-icon\">📡</span>\n          <span>Licensed Wireless</span>\n        </label>\n\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:change\"\n          />\n          <span class=\"filter-icon\">📻</span>\n          <span>Unlicensed Wireless</span>\n        </label>\n      </div>\n    </div>\n\n  <!-- Band/Technology Filters -->\n  <div class=\"filter-section\">\n    <div\n      class=\"section-header\"\n      role=\"button\"\n      tabindex=\"0\" data-cwl-action=\"toggleSection\" data-cwl-action-args=\"'bands'\" data-cwl-on-keydown=\"action:toggleSection\" data-cwl-on-keydown-args=\"'bands'\"\n    >\n      <div class=\"filter-header\">\n        <h4>Bands / Technology</h4>\n\n          <div class=\"filter-actions\">\n            <button class=\"btn-link\" data-cwl-action=\"showAllBands\" aria-label=\"Show All Bands\">All</button>\n            <button class=\"btn-link\" data-cwl-action=\"clearAllBandFilters\" aria-label=\"Clear All Band Filters\">None</button>\n          </div>\n\n      </div>\n\n    </div>\n    <div class=\"filter-options\">\n\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:toggleBandFilter\" data-cwl-on-change-args=\"&quot;LTE&quot;\"\n          />\n          <span class=\"band-indicator\" style=\"background-color: #ef4444\"></span>\n          <span>LTE</span>\n        </label>\n\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:toggleBandFilter\" data-cwl-on-change-args=\"&quot;CBRS&quot;\"\n          />\n          <span class=\"band-indicator\" style=\"background-color: #3b82f6\"></span>\n          <span>CBRS (3.5 GHz)</span>\n        </label>\n\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:toggleBandFilter\" data-cwl-on-change-args=\"&quot;FWA&quot;\"\n          />\n          <span class=\"band-indicator\" style=\"background-color: #10b981\"></span>\n          <span>FWA / Fixed Wireless</span>\n        </label>\n\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:toggleBandFilter\" data-cwl-on-change-args=\"&quot;5G&quot;\"\n          />\n          <span class=\"band-indicator\" style=\"background-color: #8b5cf6\"></span>\n          <span>5G NR</span>\n        </label>\n\n        <label class=\"filter-checkbox\">\n          <input\n            type=\"checkbox\" data-cwl-on-change=\"action:toggleBandFilter\" data-cwl-on-change-args=\"&quot;WiFi&quot;\"\n          />\n          <span class=\"band-indicator\" style=\"background-color: #f59e0b\"></span>\n          <span>WiFi</span>\n        </label>\n\n    </div>\n    <p class=\"filter-note\">\n\n        Showing <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filters.bandFilters.filter(f => f.enabled).length\"></span> band(s)\n\n        <div hidden aria-hidden=\"true\">Showing all bands\n      </div>\n    </p>\n  </div>\n\n  <!-- Status Filters -->\n  <div class=\"filter-section\">\n    <button\n      class=\"section-header\" data-cwl-action=\"toggleSection\" data-cwl-action-args=\"'status'\"\n     aria-label=\"Toggle Section\">\n      <h4>Status</h4>\n\n    </button>\n    <div class=\"filter-options\">\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:change\"\n        />\n        <span class=\"status-dot active\"></span>\n        <span>Active</span>\n      </label>\n\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:change\"\n        />\n        <span class=\"status-dot inactive\"></span>\n        <span>Inactive</span>\n      </label>\n\n      <label class=\"filter-checkbox\">\n        <input\n          type=\"checkbox\" data-cwl-on-change=\"action:change\"\n        />\n        <span class=\"status-dot maintenance\"></span>\n        <span>Maintenance</span>\n      </label>\n    </div>\n  </div>\n</div></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Statistics Modal -->\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showStats:false\" data-cwl-shell-key=\"showStats\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content stats-modal\">\n      <div class=\"modal-header\">\n        <h3>📊 Network Statistics</h3>\n        <button class=\"close-btn\" data-cwl-toggle=\"showStats:false\" aria-label=\"Show Stats\">✕</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"stats-grid\">\n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">📡</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"towers.length\"></span></div>\n              <div class=\"stat-label\">Tower Sites</div>\n            </div>\n          </div>\n\n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">📶</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sectors.length\"></span></div>\n              <div class=\"stat-label\">Sectors</div>\n            </div>\n          </div>\n\n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">📱</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"cpeDevices.length\"></span></div>\n              <div class=\"stat-label\">CPE Devices</div>\n            </div>\n          </div>\n\n          <div class=\"stat-card\">\n            <div class=\"stat-icon\">🔧</div>\n            <div class=\"stat-content\">\n              <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"equipment.length\"></span></div>\n              <div class=\"stat-label\">Equipment</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Messages -->\n\n    <div class=\"message-banner error\" hidden aria-hidden=\"true\">\n      <span>⚠️</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"message-banner success\" hidden aria-hidden=\"true\">\n      <span>✅</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"success:\">✕</button>\n    </div>\n\n</div>\n\n<!-- Unified Device Management -->\n<div data-cwl-component=\"DeviceManagementPanel\" data-cwl-lifted-component=\"DeviceManagementPanel\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showDevicePanel\" hidden aria-hidden=\"true\"><div class=\"device-panel\">\n    <div class=\"panel-header\">\n      <h2>Device Management</h2>\n      <button class=\"close-button\" data-cwl-action=\"close\" aria-label=\"Close\">×</button>\n    </div>\n\n    <div class=\"panel-controls\">\n      <!-- Search -->\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"Search devices...\"\n          class=\"search-input\"\n        />\n      </div>\n\n      <!-- Filters -->\n      <div class=\"filters\">\n        <select class=\"filter-select\">\n          <option value=\"all\">All Types</option>\n          <option value=\"snmp\">SNMP</option>\n          <option value=\"mikrotik\">MikroTik</option>\n          <option value=\"epc\">EPC</option>\n          <option value=\"network-equipment\">Network Equipment</option>\n        </select>\n\n        <select class=\"filter-select\">\n          <option value=\"all\">All Status</option>\n          <option value=\"online\">Online</option>\n          <option value=\"offline\">Offline</option>\n        </select>\n\n        <button class=\"refresh-button\" data-cwl-action=\"handleRefresh\" title=\"Refresh\">\n          🔄\n        </button>\n      </div>\n    </div>\n\n    <div class=\"panel-body\">\n\n        <div class=\"devices-list\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredDevices as device (device.id || device._id)\" data-cwl-each-item=\"device\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20deviceType%20%3D%20detectDeviceType(device)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20status%20%3D%20device.status%20%7C%7C%20'unknown'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20statusBadge%20%3D%20getStatusBadge(status)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22device-card%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3Adevice-online%3D%7Bstatus%20%3D%3D%3D%20'online'%20%7C%7C%20status%20%3D%3D%3D%20'active'%20%7C%7C%20status%20%3D%3D%3D%20'connected'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3Adevice-offline%3D%7Bstatus%20%3D%3D%3D%20'offline'%20%7C%7C%20status%20%3D%3D%3D%20'inactive'%20%7C%7C%20status%20%3D%3D%3D%20'disconnected'%7D%20data-cwl-action%3D%22handleDeviceClick%22%20data-cwl-action-args%3D%22device%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22device-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22device-icon%22%3E%7BgetDeviceTypeIcon(deviceType)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22device-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%20class%3D%22device-name%22%3E%7Bdevice.name%20%7C%7C%20device.id%20%7C%7C%20device._id%20%7C%7C%20'Unknown%20Device'%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22device-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22device-type-badge%22%3E%7BgetDeviceTypeLabel(deviceType)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20%7BstatusBadge.class%7D%22%3E%7BstatusBadge.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22device-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20device.manufacturer%20%7C%7C%20device.model%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-line%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3EDevice%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bdevice.manufacturer%20%7C%7C%20''%7D%20%7Bdevice.model%20%7C%7C%20''%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20device.ipAddress%20%7C%7C%20device.ip_address%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-line%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3EIP%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%20mono%22%3E%7Bdevice.ipAddress%20%7C%7C%20device.ip_address%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20device.location%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-line%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%3ELocation%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-value%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bdevice.location.latitude%3F.toFixed(4)%7D%2C%20%7Bdevice.location.longitude%3F.toFixed(4)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20\">\n\n            <div\n              class=\"device-card\" data-cwl-action=\"handleDeviceClick\" data-cwl-action-args=\"device\"\n            >\n              <div class=\"device-header\">\n                <span class=\"device-icon\"></span>\n                <div class=\"device-info\">\n                  <h3 class=\"device-name\"></h3>\n                  <div class=\"device-meta\">\n                    <span class=\"device-type-badge\"></span>\n                    <span class=\"status-badge \"></span>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"device-details\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.manufacturer || device.model\"><div class=\"detail-line\">\n                    <span class=\"detail-label\">Device:</span>\n                    <span class=\"detail-value\">\n\n                    </span>\n                  </div></div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.ipAddress || device.ip_address\"><div class=\"detail-line\">\n                    <span class=\"detail-label\">IP:</span>\n                    <span class=\"detail-value mono\"></span>\n                  </div></div>\n\n                  <div class=\"detail-line\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-label\">Location:</span>\n                    <span class=\"detail-value\">\n                      ,\n                    </span>\n                  </div>\n\n              </div>\n            </div></div>\n        </div>\n\n        <div class=\"empty-state\" hidden aria-hidden=\"true\">\n          <p>No devices found</p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"searchQuery || selectedDeviceType !== 'all' || selectedStatus !== 'all'\"><button class=\"btn-clear-filters\" data-cwl-set=\"searchQuery:\">\n              Clear Filters\n            </button></div>\n        </div>\n\n        <div class=\"loading-state\" hidden aria-hidden=\"true\">\n          <div class=\"spinner\"></div>\n          <p>Loading devices...</p>\n        </div>\n\n    </div>\n\n    <div class=\"panel-footer\">\n      <div class=\"device-count\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filteredDevices.length\"></span> device<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filteredDevices.length !== 1 ? 's' : ''\"></span>\n      </div>\n    </div>\n  </div></div></div>\n\n<div data-cwl-component=\"UnifiedDeviceDetailsModal\" data-cwl-lifted-component=\"UnifiedDeviceDetailsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showUnifiedDeviceModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && device\"><div class=\"modal-overlay\" data-cwl-action=\"handleBackdropClick\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content unified-device-modal\">\n      <div class=\"modal-header\">\n        <div class=\"header-left\">\n          <span class=\"device-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDeviceTypeIcon(deviceType)\"></span></span>\n          <div class=\"header-info\">\n            <h2><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"device.name || device.id || device._id || 'Unknown Device'\"></span></h2>\n            <div class=\"device-meta\">\n              <span class=\"device-type\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDeviceTypeLabel(deviceType)\"></span></span>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.status || device.status\"><span class=\"status-badge\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getStatusBadge(deviceDetails?.status || device.status).label\"></span>\n                </span></div>\n            </div>\n          </div>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"modal-body\">\n\n          <!-- Tab Navigation -->\n          <div class=\"tab-navigation\">\n            <button\n              class=\"tab-button\" data-cwl-set=\"activeTab:overview\"\n            >\n              Overview\n            </button>\n            <button\n              class=\"tab-button\" data-cwl-set=\"activeTab:metrics\"\n            >\n              Metrics\n            </button>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'snmp' || deviceType === 'mikrotik'\"><button\n                class=\"tab-button\" data-cwl-set=\"activeTab:configuration\"\n              >\n                Configuration\n              </button></div>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'mikrotik'\" hidden aria-hidden=\"true\">\n              <button\n                class=\"tab-button\" data-cwl-set=\"activeTab:actions\"\n              >\n                Actions\n              </button>\n            </div>\n          </div>\n\n          <!-- Tab Content -->\n          <div class=\"tab-content\">\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'overview'\">\n              <div class=\"overview-tab\">\n                <div class=\"details-grid\">\n                  <!-- Basic Information -->\n                  <div class=\"detail-section\">\n                    <h3>Basic Information</h3>\n                    <div class=\"detail-list\">\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.manufacturer || device.manufacturer\"><div class=\"detail-item\">\n                          <span class=\"label\">Manufacturer:</span>\n                          <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.manufacturer || device.manufacturer\"></span></span>\n                        </div></div>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.model || device.model\"><div class=\"detail-item\">\n                          <span class=\"label\">Model:</span>\n                          <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.model || device.model\"></span></span>\n                        </div></div>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.serialNumber || device.serialNumber\"><div class=\"detail-item\">\n                          <span class=\"label\">Serial Number:</span>\n                          <span class=\"value mono\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.serialNumber || device.serialNumber\"></span></span>\n                        </div></div>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.firmware || device.firmware || deviceDetails?.routerosVersion\"><div class=\"detail-item\">\n                          <span class=\"label\">Firmware:</span>\n                          <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.firmware || device.firmware || deviceDetails?.routerosVersion\"></span></span>\n                        </div></div>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.ipAddress || device.ipAddress\"><div class=\"detail-item\">\n                          <span class=\"label\">IP Address:</span>\n                          <span class=\"value mono\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.ipAddress || device.ipAddress\"></span></span>\n                        </div></div>\n                    </div>\n                  </div>\n\n                  <!-- Location -->\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.location || deviceDetails?.location\"><div class=\"detail-section\">\n                      <h3>Location</h3>\n                      <div class=\"detail-list\">\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.location?.latitude || deviceDetails?.location?.latitude\"><div class=\"detail-item\">\n                            <span class=\"label\">Coordinates:</span>\n                            <span class=\"value mono\">\n                              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"device.location?.latitude || deviceDetails?.location?.latitude\"></span>,\n                              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"device.location?.longitude || deviceDetails?.location?.longitude\"></span>\n                            </span>\n                          </div></div>\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device.location?.address || deviceDetails?.location?.address\"><div class=\"detail-item\">\n                            <span class=\"label\">Address:</span>\n                            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"device.location?.address || deviceDetails?.location?.address\"></span></span>\n                          </div></div>\n                      </div>\n                    </div></div>\n\n                  <!-- Type-Specific Information -->\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'snmp'\" hidden aria-hidden=\"true\">\n                    <div class=\"detail-section\">\n                      <h3>SNMP Configuration</h3>\n                      <div class=\"detail-list\">\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.snmpVersion || device.snmp_version\"><div class=\"detail-item\">\n                            <span class=\"label\">SNMP Version:</span>\n                            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.snmpVersion || device.snmp_version\"></span></span>\n                          </div></div>\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.community || device.community\"><div class=\"detail-item\">\n                            <span class=\"label\">Community:</span>\n                            <span class=\"value mono\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.community || device.community\"></span></span>\n                          </div></div>\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device._id || device.id\"><div class=\"detail-item\">\n                            <span class=\"label\">Device ID:</span>\n                            <span class=\"value mono\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"device._id || device.id\"></span></span>\n                          </div></div>\n                      </div>\n                    </div>\n                  </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'epc'\" hidden aria-hidden=\"true\">\n                    <div class=\"detail-section\">\n                      <h3>EPC Configuration</h3>\n                      <div class=\"detail-list\">\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.hssConfig?.mcc || device.hss_config?.mcc\"><div class=\"detail-item\">\n                            <span class=\"label\">MCC:</span>\n                            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.hssConfig?.mcc || device.hss_config?.mcc\"></span></span>\n                          </div></div>\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.hssConfig?.mnc || device.hss_config?.mnc\"><div class=\"detail-item\">\n                            <span class=\"label\">MNC:</span>\n                            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.hssConfig?.mnc || device.hss_config?.mnc\"></span></span>\n                          </div></div>\n                        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceDetails?.hssConfig?.apnName || device.hss_config?.apnName\"><div class=\"detail-item\">\n                            <span class=\"label\">APN:</span>\n                            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deviceDetails?.hssConfig?.apnName || device.hss_config?.apnName\"></span></span>\n                          </div></div>\n                      </div>\n                    </div>\n                  </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"device._id || device.id\"><div class=\"detail-section\">\n                      <h3>Device</h3>\n                      <div class=\"detail-list\">\n                        <div class=\"detail-item\">\n                          <span class=\"label\">Device ID:</span>\n                          <span class=\"value mono\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"device._id || device.id\"></span></span>\n                        </div>\n                      </div>\n                    </div></div>\n                </div>\n              </div>\n            </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'metrics'\" hidden aria-hidden=\"true\">\n              <div class=\"metrics-tab\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'snmp'\" hidden aria-hidden=\"true\">\n                  <div class=\"metrics-content\">\n                    <h3>SNMP Metrics (Last 24 Hours)</h3>\n\n                      <div class=\"metrics-grid\">\n                        <p>SNMP metrics visualization coming soon...</p>\n                      </div>\n\n                  </div>\n                </div>\n                  <div class=\"no-metrics\">\n                    <p>Metrics not available for this device type.</p>\n                  </div>\n\n              </div>\n            </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'configuration'\" hidden aria-hidden=\"true\">\n              <div class=\"configuration-tab\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'snmp'\" hidden aria-hidden=\"true\">\n                  <div class=\"config-content\">\n                    <h3>SNMP Configuration</h3>\n                    <p>SNMP configuration editing coming soon...</p>\n                  </div>\n                </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'mikrotik'\" hidden aria-hidden=\"true\">\n                  <div class=\"config-content\">\n                    <h3>MikroTik Configuration</h3>\n                    <p>MikroTik configuration editing coming soon...</p>\n                  </div>\n                </div>\n              </div>\n            </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'actions'\" hidden aria-hidden=\"true\">\n              <div class=\"actions-tab\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deviceType === 'mikrotik'\" hidden aria-hidden=\"true\">\n                  <div class=\"actions-content\">\n                    <h3>MikroTik Actions</h3>\n                    <p>MikroTik device actions coming soon...</p>\n                  </div>\n                </div>\n                  <div class=\"no-actions\">\n                    <p>Actions not available for this device type.</p>\n                  </div>\n\n              </div>\n            </div>\n          </div>\n\n          <div class=\"loading-state\" hidden aria-hidden=\"true\">\n            <div class=\"spinner\"></div>\n            <p>Loading device details...</p>\n          </div>\n\n      </div>\n    </div>\n  </div></div></div></div>\n\n<!-- Modals -->\n<div data-cwl-component=\"AddSiteModal\" data-cwl-lifted-component=\"AddSiteModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddSiteModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📡 Add Tower Site</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Find Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter address to search...\" data-cwl-on-keydown=\"action:handleSearchAddress\"\n          />\n          <button\n            class=\"btn-secondary\" data-cwl-action=\"handleSearchAddress\" data-cwl-attr-disabled=\"isSearching\"\n           aria-label=\"Search Address\">\n            Search\n          </button>\n        </div>\n        <p class=\"help-text\">Or enter GPS coordinates below</p>\n      </div>\n\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Site Name *</label>\n            <input type=\"text\" placeholder=\"Main Tower Site\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Type</label>\n          <select>\n            <option value=\"tower\">📡 Tower</option>\n            <option value=\"noc\">🖥️ NOC (Network Operations Center)</option>\n            <option value=\"warehouse\">🏭 Warehouse / Storage</option>\n            <option value=\"other\">📍 Other Site</option>\n          </select>\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.type === 'tower'\"><div class=\"form-group\">\n            <label>Height (feet)</label>\n            <input type=\"number\" placeholder=\"100\" />\n          </div></div>\n\n          <div class=\"form-group\">\n            <label>FCC ID</label>\n            <input type=\"text\" placeholder=\"FCC-12345\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 GPS Coordinates</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Tower Rd\" />\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Tower-Specific Sections (only for actual towers) -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.type === 'tower'\"><!-- Tower Contact -->\n      <div class=\"section\">\n        <h3>🏢 Tower Owner Contact</h3>\n        <div class=\"form-group\">\n          <label>Tower Owner</label>\n          <input type=\"text\" placeholder=\"Tower Company LLC\" />\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Contact Name</label>\n            <input type=\"text\" placeholder=\"John Doe\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@tower.com\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Site Contact -->\n      <div class=\"section\">\n        <h3>👷 On-Site Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Site Manager</label>\n            <input type=\"text\" placeholder=\"Jane Smith\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-5678\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"manager@site.com\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Access Info -->\n      <div class=\"section\">\n        <h3>🔐 Site Access</h3>\n        <div class=\"form-group\">\n          <label>Gate Code</label>\n          <input type=\"text\" placeholder=\"1234#\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Access Instructions</label>\n          <textarea\n            placeholder=\"Call 30 minutes before arrival. Gate code required.\"\n            rows=\"2\"\n          ></textarea>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Safety Notes</label>\n          <textarea\n            placeholder=\"High voltage equipment. PPE required. Confined space.\"\n            rows=\"2\"\n          ></textarea>\n        </div>\n      </div></div>\n\n      <!-- General Notes (for all types) -->\n      <div class=\"section\">\n        <h3>📝 Additional Notes</h3>\n        <div class=\"form-group\">\n          <label>Notes</label>\n          <textarea\n            placeholder=\"General notes about this location...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create Site\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddNOCModal\" data-cwl-lifted-component=\"AddNOCModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddNOCModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🏢 Add NOC (Network Operations Center)</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-group\">\n          <label>NOC Name *</label>\n          <input type=\"text\" placeholder=\"Main NOC\" required />\n        </div>\n      </div>\n\n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 Location</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Data Center Dr\" />\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Contact Info -->\n      <div class=\"section\">\n        <h3>👤 NOC Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Contact Name</label>\n            <input type=\"text\" placeholder=\"NOC Manager\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"noc@company.com\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Notes -->\n      <div class=\"section\">\n        <h3>📝 Notes</h3>\n        <div class=\"form-group\">\n          <textarea\n            placeholder=\"Building access, parking, special instructions...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create NOC\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddWarehouseModal\" data-cwl-lifted-component=\"AddWarehouseModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddWarehouseModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🏭 Add Warehouse / Storage Location</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>Warehouse Name *</label>\n        <input type=\"text\" placeholder=\"Main Warehouse\" required />\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Latitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Longitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n      </div>\n\n      <div class=\"form-group\">\n        <label>Address</label>\n        <input type=\"text\" placeholder=\"456 Storage Ave\" />\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>City</label>\n          <input type=\"text\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>State</label>\n          <input type=\"text\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>ZIP</label>\n          <input type=\"text\" />\n        </div>\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Contact Name</label>\n          <input type=\"text\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Phone</label>\n          <input type=\"tel\" />\n        </div>\n      </div>\n\n      <div class=\"form-group\">\n        <label>Notes</label>\n        <textarea rows=\"2\" placeholder=\"Access instructions, hours, etc.\"></textarea>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create Warehouse\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddVehicleModal\" data-cwl-lifted-component=\"AddVehicleModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddVehicleModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🚚 Add Service Vehicle</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n    <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>Vehicle Name *</label>\n        <input type=\"text\" placeholder=\"Service Truck #1\" required />\n      </div>\n\n      <div class=\"form-group\">\n        <label>Vehicle Number</label>\n        <input type=\"text\" placeholder=\"VEH-001\" />\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Current Latitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Current Longitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Driver Name</label>\n          <input type=\"text\" placeholder=\"John Doe\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Driver Phone</label>\n          <input type=\"tel\" placeholder=\"555-1234\" />\n        </div>\n      </div>\n\n      <div class=\"form-group\">\n        <label>Notes</label>\n        <textarea rows=\"2\" placeholder=\"Mobile inventory location\"></textarea>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Add Vehicle\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddRMAModal\" data-cwl-lifted-component=\"AddRMAModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddRMAModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔧 Add RMA / Repair Center</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n    <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>RMA Center Name *</label>\n        <input type=\"text\" placeholder=\"Repair Center\" required />\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Latitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Longitude *</label>\n          <input type=\"number\" step=\"0.000001\" required />\n        </div>\n      </div>\n\n      <div class=\"form-group\">\n        <label>Address</label>\n        <input type=\"text\" placeholder=\"789 Repair Blvd\" />\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>City</label>\n          <input type=\"text\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>State</label>\n          <input type=\"text\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>ZIP</label>\n          <input type=\"text\" />\n        </div>\n      </div>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label>Contact Name</label>\n          <input type=\"text\" />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Phone</label>\n          <input type=\"tel\" />\n        </div>\n      </div>\n\n      <div class=\"form-group\">\n        <label>Notes</label>\n        <textarea rows=\"2\" placeholder=\"RMA procedures, shipping address...\"></textarea>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create RMA Center\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddSectorModal\" data-cwl-lifted-component=\"AddSectorModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddSectorModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📶 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sectorToEdit ? 'Edit Sector' : 'Add Sector'\"></span></h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Site Selection -->\n      <div class=\"section\">\n        <h3>📡 Tower Site</h3>\n        <div class=\"form-group\">\n          <label>Select Site *</label>\n          <select data-cwl-attr-disabled=\"!!sectorToEdit\">\n            <option>-- Select a tower site --</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%20(%7Bsite.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n          </select>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sectorToEdit\"><p class=\"help-text\">⚠️ Site cannot be changed when editing</p></div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedSiteData\"><p class=\"help-text\">\n              📍 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedSiteData.location.latitude.toFixed(4)\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedSiteData.location.longitude.toFixed(4)\"></span>\n            </p></div>\n        </div>\n      </div>\n\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Sector Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Sector Name *</label>\n            <input type=\"text\" placeholder=\"Alpha Sector\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Technology *</label>\n            <select data-cwl-on-change=\"action:handleTechnologyChange\">\n              <option value=\"LTE\">LTE</option>\n              <option value=\"CBRS\">CBRS</option>\n              <option value=\"FWA\">Fixed Wireless (FWA)</option>\n              <option value=\"5G\">5G NR</option>\n              <option value=\"WiFi\">WiFi</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">Active</option>\n              <option value=\"inactive\">Inactive</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"planned\">Planned</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- RF Configuration -->\n      <div class=\"section\">\n        <h3>📡 RF Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Azimuth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">0° = North, 90° = East, 180° = South, 270° = West</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Beamwidth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">Typical: 65° (LTE), 90° (CBRS), 30° (FWA)</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Mechanical Tilt (degrees)</label>\n            <input type=\"number\" min=\"-90\" max=\"90\" />\n            <p class=\"help-text\">Downtilt angle (negative = down)</p>\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Band / Frequency Name</label>\n            <input type=\"text\" placeholder=\"Band 71 (600MHz)\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Center Frequency (MHz)</label>\n            <input type=\"number\" placeholder=\"617\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Bandwidth (MHz)</label>\n            <input type=\"number\" placeholder=\"10\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Equipment -->\n      <div class=\"section\">\n        <h3>📻 Equipment Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Antenna Manufacturer</label>\n            <input type=\"text\" placeholder=\"Commscope\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Antenna Model</label>\n            <input type=\"text\" placeholder=\"SBNHH-1D65C\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Antenna Serial Number</label>\n            <input type=\"text\" placeholder=\"SN123456\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Radio Manufacturer</label>\n            <input type=\"text\" placeholder=\"Nokia\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Radio Model</label>\n            <input type=\"text\" placeholder=\"AEQE\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Radio Serial Number</label>\n            <input type=\"text\" placeholder=\"RN789012\" />\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button\n        class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\"\n       aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (sectorToEdit ? '✅ Save Changes' : '✅ Create Sector')\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddCPEModal\" data-cwl-lifted-component=\"AddCPEModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddCPEModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📱 Add CPE Device</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Customer Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter customer address...\" data-cwl-on-keydown=\"action:handleSearchAddress\"\n          />\n          <button class=\"btn-secondary\" data-cwl-action=\"handleSearchAddress\" data-cwl-attr-disabled=\"isSearching\" aria-label=\"Search Address\">\n            Search\n          </button>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Address</label>\n          <input type=\"text\" placeholder=\"123 Main St, City, State\" />\n        </div>\n      </div>\n\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Equipment Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Device Name *</label>\n            <input type=\"text\" placeholder=\"Smith Residence FWA\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Manufacturer *</label>\n            <input type=\"text\" placeholder=\"Telrad\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Model *</label>\n            <input type=\"text\" placeholder=\"CPE7000\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Serial Number *</label>\n            <input type=\"text\" placeholder=\"CPE-123456\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>MAC Address</label>\n            <input type=\"text\" placeholder=\"00:11:22:33:44:55\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Installation -->\n      <div class=\"section\">\n        <h3>📡 Installation Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Pointing Azimuth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">Direction CPE antenna is pointed</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Beamwidth (degrees)</label>\n            <input type=\"number\" />\n            <p class=\"help-text\">Default: 30° for FWA CPE</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Height Above Ground (feet)</label>\n            <input type=\"number\" placeholder=\"25\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Technology</label>\n            <select>\n              <option value=\"FWA\">Fixed Wireless (FWA)</option>\n              <option value=\"LTE\">LTE</option>\n              <option value=\"CBRS\">CBRS</option>\n              <option value=\"5G\">5G NR</option>\n              <option value=\"WiFi\">WiFi</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Band / Frequency</label>\n            <input type=\"text\" placeholder=\"5GHz\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Connected to Site</label>\n            <select>\n              <option>None / Unknown</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- Subscriber Info -->\n      <div class=\"section\">\n        <h3>👤 Subscriber Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Subscriber Name</label>\n            <input type=\"text\" placeholder=\"John Smith\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"customer@example.com\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Account Number</label>\n            <input type=\"text\" placeholder=\"ACCT-1001\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Service Type</label>\n            <select>\n              <option value=\"residential\">Residential</option>\n              <option value=\"business\">Business</option>\n              <option value=\"temporary\">Temporary</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"online\">Online</option>\n              <option value=\"offline\">Offline</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"inventory\">Inventory</option>\n            </select>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create CPE\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddBackhaulLinkModal\" data-cwl-lifted-component=\"AddBackhaulLinkModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddBackhaulModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔗 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"backhaulToEdit ? 'Edit Backhaul Link' : 'Add Backhaul Link'\"></span></h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!canCreateBackhaul\"><div class=\"warning-banner\">\n        ⚠️ Need at least 2 sites to create backhaul. Add more tower sites or NOC first.\n      </div></div>\n\n    <div class=\"modal-body\">\n      <!-- Link Endpoints -->\n      <div class=\"section\">\n        <h3>🔗 Link Endpoints</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>From Site (A) *</label>\n            <select data-cwl-attr-disabled=\"!canCreateBackhaul || !!backhaulToEdit\">\n              <option>-- Select site --</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%20(%7Bsite.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n            </select>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"backhaulToEdit\"><p class=\"help-text\">⚠️ Sites cannot be changed when editing</p></div>\n          </div>\n\n          <div class=\"form-group\">\n            <label>To Site (B) *</label>\n            <select data-cwl-attr-disabled=\"!canCreateBackhaul || !!backhaulToEdit\">\n              <option>-- Select site --</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableToSites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%20(%7Bsite.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Link Name *</label>\n          <input\n            type=\"text\"\n            placeholder=\"↔\" data-cwl-attr-disabled=\"!canCreateBackhaul\"\n          />\n        </div>\n      </div>\n\n      <!-- Backhaul Type -->\n      <div class=\"section\">\n        <h3>📡 Backhaul Type</h3>\n        <div class=\"form-group\">\n          <select data-cwl-attr-disabled=\"!canCreateBackhaul\">\n            <option value=\"fiber\">🌐 Fiber Optic</option>\n            <option value=\"fixed-wireless-licensed\">📡 Fixed Wireless (Licensed Spectrum)</option>\n            <option value=\"fixed-wireless-unlicensed\">📡 Fixed Wireless (Unlicensed WiFi/60GHz)</option>\n          </select>\n        </div>\n      </div>\n\n      <!-- Wireless Configuration -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isWireless && canCreateBackhaul\"><div class=\"section wireless-section\">\n          <h3>📡 Fixed Wireless Configuration</h3>\n\n          <!-- Site A Configuration -->\n          <div class=\"site-config\">\n            <h4>📍 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"fromSiteName\"></span> (Site A)</h4>\n            <div class=\"form-grid\">\n              <div class=\"form-group\">\n                <label>Azimuth (auto-calculated)</label>\n                <input type=\"number\" min=\"0\" max=\"360\" />\n                <p class=\"help-text\">Pointing toward <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"toSiteName\"></span></p>\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Height (feet)</label>\n                <input type=\"number\" placeholder=\"150\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Gain (dBi)</label>\n                <input type=\"number\" placeholder=\"23\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>TX Power (dBm)</label>\n                <input type=\"number\" placeholder=\"20\" />\n              </div>\n            </div>\n          </div>\n\n          <!-- Site B Configuration -->\n          <div class=\"site-config\">\n            <h4>📍 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"toSiteName\"></span> (Site B)</h4>\n            <div class=\"form-grid\">\n              <div class=\"form-group\">\n                <label>Azimuth (auto-calculated)</label>\n                <input type=\"number\" min=\"0\" max=\"360\" />\n                <p class=\"help-text\">Pointing toward <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"fromSiteName\"></span></p>\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Height (feet)</label>\n                <input type=\"number\" placeholder=\"150\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Gain (dBi)</label>\n                <input type=\"number\" placeholder=\"23\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>TX Power (dBm)</label>\n                <input type=\"number\" placeholder=\"20\" />\n              </div>\n            </div>\n          </div>\n\n          <!-- RF Parameters -->\n          <h4>📻 RF Parameters</h4>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Frequency (MHz) *</label>\n              <input type=\"number\" placeholder=\"5800\" />\n              <p class=\"help-text\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.backhaulType === 'fixed-wireless-unlicensed'\">WiFi: 5150-5850 | 60GHz: 57000-71000</div>\n                  Licensed: 6, 11, 18, 23, 80 GHz\n\n              </p>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Channel Bandwidth (MHz)</label>\n              <input type=\"number\" placeholder=\"80\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Beamwidth (degrees)</label>\n              <input type=\"number\" placeholder=\"10\" />\n              <p class=\"help-text\">Antenna beamwidth (5-15° typical)</p>\n            </div>\n          </div>\n\n          <!-- Licensed Spectrum -->\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.backhaulType === 'fixed-wireless-licensed'\"><div class=\"license-section\">\n              <h4>📜 FCC Licensing Information</h4>\n              <p class=\"section-help\">Required FCC licensing details for licensed wireless backhaul links</p>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>License Type *</label>\n                  <select>\n                    <option>-- Select --</option>\n                    <option value=\"point-to-point\">Point-to-Point</option>\n                    <option value=\"point-to-multipoint\">Point-to-Multipoint</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>FCC Call Sign *</label>\n                  <input type=\"text\" placeholder=\"WXYZ123\" />\n                  <p class=\"help-text\">FCC-assigned call sign</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>FCC License Number</label>\n                  <input type=\"text\" placeholder=\"Additional license identifier\" />\n                  <p class=\"help-text\">Additional license number if different from call sign</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>FCC File Number</label>\n                  <input type=\"text\" placeholder=\"0000123456\" />\n                  <p class=\"help-text\">FCC application/file number</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>License Status</label>\n                  <select>\n                    <option value=\"active\">✅ Active</option>\n                    <option value=\"pending\">⏳ Pending</option>\n                    <option value=\"expired\">❌ Expired</option>\n                    <option value=\"suspended\">⚠️ Suspended</option>\n                    <option value=\"revoked\">🚫 Revoked</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Part Number</label>\n                  <select>\n                    <option>-- Select --</option>\n                    <option value=\"Part 101\">Part 101 - Fixed Microwave Services</option>\n                    <option value=\"Part 90\">Part 90 - Private Land Mobile Radio</option>\n                    <option value=\"Part 22\">Part 22 - Public Mobile Services</option>\n                    <option value=\"Part 24\">Part 24 - Personal Communications Services</option>\n                    <option value=\"Part 27\">Part 27 - Miscellaneous Wireless Services</option>\n                    <option value=\"Part 94\">Part 94 - Private Operational-Fixed Microwave Service</option>\n                    <option value=\"Part 97\">Part 97 - Amateur Radio Service</option>\n                  </select>\n                </div>\n              </div>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>Frequency Band</label>\n                  <input type=\"text\" placeholder=\"6 GHz, 11 GHz, 18 GHz, 23 GHz, 80 GHz\" />\n                  <p class=\"help-text\">Authorized frequency band (e.g., \"6 GHz\", \"18-23 GHz\")</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Authorized Bandwidth</label>\n                  <input type=\"text\" placeholder=\"50 MHz, 100 MHz\" />\n                  <p class=\"help-text\">Total authorized bandwidth for this license</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Emission Designator</label>\n                  <input type=\"text\" placeholder=\"8K00F1D\" />\n                  <p class=\"help-text\">FCC emission designator code</p>\n                </div>\n              </div>\n\n              <div class=\"form-group\">\n                <label>License Holder Name *</label>\n                <input type=\"text\" placeholder=\"Company Name\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>License Holder Address</label>\n                <textarea\n                  placeholder=\"123 Business St, City, State ZIP\"\n                  rows=\"2\"\n                ></textarea>\n                <p class=\"help-text\">Full address of license holder as registered with FCC</p>\n              </div>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>License Expiration Date</label>\n                  <input type=\"date\" />\n                  <p class=\"help-text\">When the license expires</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Renewal Date</label>\n                  <input type=\"date\" />\n                  <p class=\"help-text\">Recommended renewal date (before expiration)</p>\n                </div>\n              </div>\n            </div></div>\n        </div></div>\n\n      <!-- Fiber Configuration -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isFiber && canCreateBackhaul\"><div class=\"section fiber-section\">\n          <h3>🌐 Fiber Optic Details</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Provider *</label>\n              <input type=\"text\" placeholder=\"AT&T, Verizon, Zayo\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Circuit ID</label>\n              <input type=\"text\" placeholder=\"CIRCUIT-123456\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Speed</label>\n              <select>\n                <option value=\"100M\">100 Mbps</option>\n                <option value=\"1G\">1 Gbps</option>\n                <option value=\"10G\">10 Gbps</option>\n                <option value=\"100G\">100 Gbps</option>\n              </select>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Handoff Type</label>\n              <select>\n                <option value=\"single-mode\">Single-Mode Fiber</option>\n                <option value=\"multi-mode\">Multi-Mode Fiber</option>\n                <option value=\"ethernet\">Ethernet</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Connector</label>\n              <select>\n                <option value=\"LC\">LC</option>\n                <option value=\"SC\">SC</option>\n                <option value=\"ST\">ST</option>\n                <option value=\"RJ45\">RJ45</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Fiber Count</label>\n              <input type=\"number\" placeholder=\"2\" />\n            </div>\n          </div>\n        </div></div>\n\n      <!-- Common Fields -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"canCreateBackhaul\"><div class=\"section\">\n          <h3>⚙️ Link Details</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Capacity (Mbps) *</label>\n              <input type=\"number\" placeholder=\"1000\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Equipment Manufacturer</label>\n              <input type=\"text\" placeholder=\"Cisco, Ubiquiti\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Equipment Model</label>\n              <input type=\"text\" placeholder=\"ASR9000, AirFiber60\" />\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Monthly Cost ($)</label>\n              <input type=\"number\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Contract (months)</label>\n              <input type=\"number\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Status</label>\n              <select>\n                <option value=\"active\">Active</option>\n                <option value=\"inactive\">Inactive</option>\n                <option value=\"maintenance\">Maintenance</option>\n                <option value=\"planned\">Planned</option>\n              </select>\n            </div>\n          </div>\n        </div></div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving || !canCreateBackhaul\" aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (backhaulToEdit ? '✅ Save Changes' : '✅ Create Backhaul\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<div data-cwl-component=\"AddInventoryModal\" data-cwl-lifted-component=\"AddInventoryModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddInventoryModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && site\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <div>\n        <h2>📦 Add Equipment Inventory</h2>\n        <p class=\"site-name\">📡 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.name\"></span></p>\n      </div>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Equipment Category & Type -->\n      <div class=\"section\">\n        <h3>🏷️ Equipment Classification</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Equipment Category *</label>\n            <select>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"Object.keys(equipmentCategories) as category\"><option></option></div>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Equipment Type *</label>\n            <select>\n              <option>-- Select Type --</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableTypes as type\" data-cwl-each-item=\"type\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Btype%7D%3E%7Btype%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n              <option value=\"Other/Custom\">Other/Custom</option>\n            </select>\n          </div>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"useCustomType\"><div class=\"form-group\">\n            <label>Custom Equipment Type *</label>\n            <input type=\"text\" placeholder=\"Enter custom equipment type\" />\n          </div></div>\n      </div>\n\n      <!-- Manufacturer & Model Information -->\n      <div class=\"section\">\n        <h3>🏭 Manufacturer Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Manufacturer</label>\n            <input\n              type=\"text\"\n              placeholder=\"Nokia, Ericsson, Huawei, Cisco, etc.\"\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Model Number</label>\n            <input type=\"text\" placeholder=\"Model/SKU\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Serial Number *</label>\n            <input type=\"text\" placeholder=\"S/N\" required />\n            <p class=\"help-text\">Required for inventory tracking</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Part Number</label>\n            <input type=\"text\" placeholder=\"P/N\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Firmware Version</label>\n            <input type=\"text\" placeholder=\"FW version\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Hardware Version</label>\n            <input type=\"text\" placeholder=\"HW revision\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Physical Location -->\n      <div class=\"section\">\n        <h3>📍 Physical Location</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Rack/Cabinet Location</label>\n            <input type=\"text\" placeholder=\"Rack A, Cabinet 1, etc.\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Rack Unit (RU)</label>\n            <input type=\"text\" placeholder=\"RU 10-15\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Condition</label>\n            <select>\n              <option value=\"new\">New</option>\n              <option value=\"used\">Used</option>\n              <option value=\"refurbished\">Refurbished</option>\n              <option value=\"rma\">RMA</option>\n              <option value=\"retired\">Retired</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"deployed\">Deployed</option>\n              <option value=\"inventory\">In Inventory</option>\n              <option value=\"maintenance\">Under Maintenance</option>\n              <option value=\"rma\">RMA</option>\n              <option value=\"retired\">Retired</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- Dates & Warranty -->\n      <div class=\"section\">\n        <h3>📅 Installation & Warranty</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Install Date</label>\n            <input type=\"date\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Warranty Expiration</label>\n            <input type=\"date\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Purchase Information -->\n      <div class=\"section\">\n        <h3>💰 Purchase Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Purchase Date</label>\n            <input type=\"date\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Vendor</label>\n            <input type=\"text\" placeholder=\"Vendor/Supplier\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Purchase Order Number</label>\n            <input type=\"text\" placeholder=\"PO-######\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Purchase Price ($)</label>\n            <input type=\"number\" placeholder=\"0.00\" step=\"0.01\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Technical Details -->\n      <div class=\"section\">\n        <h3>⚙️ Technical Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Power Requirements</label>\n            <input type=\"text\" placeholder=\"48V DC, 100-240V AC, etc.\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>IP Address</label>\n            <input type=\"text\" placeholder=\"192.168.1.100\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>MAC Address</label>\n            <input type=\"text\" placeholder=\"00:1A:2B:3C:4D:5E\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Management URL</label>\n            <input type=\"url\" placeholder=\"https://...\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Additional Notes</label>\n          <textarea\n            placeholder=\"Configuration notes, maintenance history, special instructions...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Add to Inventory\n      </button>\n    </div>\n  </div>\n</div></div></div></div>\n\n<!-- Context Menus -->\n<div data-cwl-component=\"MapContextMenu\" data-cwl-lifted-component=\"MapContextMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showContextMenu\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && !disabled\"><div\n  class=\"context-menu\"\n  style=\"left: px; top: px\"\n>\n  <div class=\"menu-header\">\n    <span class=\"coords\">\n      📍 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"latitude != null && longitude != null ? `, $\"></span>\n    </span>\n\n  </div>\n\n  <div class=\"menu-section\">\n    <div class=\"section-label\">\n      Create Site\n    </div>\n    <button class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'create-site-tower'\" aria-label=\"Action\">\n      <span class=\"menu-icon\">📡</span>\n      <span>Add Tower Site</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'create-site-noc'\" aria-label=\"Action\">\n      <span class=\"menu-icon\">🖥️</span>\n      <span>Add NOC</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'create-site-warehouse'\" aria-label=\"Action\">\n      <span class=\"menu-icon\">🏭</span>\n      <span>Add Warehouse</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'create-site-other'\" aria-label=\"Action\">\n      <span class=\"menu-icon\">📍</span>\n      <span>Add Other Site</span>\n    </button>\n  </div>\n\n  <div class=\"menu-divider\"></div>\n\n  <button class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'copy-coords'\" aria-label=\"Action\">\n    <span class=\"menu-icon\">📋</span>\n    <span>Copy Coordinates</span>\n  </button>\n</div></div></div></div>\n\n<div data-cwl-component=\"TowerActionsMenu\" data-cwl-lifted-component=\"TowerActionsMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showTowerActionsMenu\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && tower\"><div\n  class=\"tower-menu\"\n  style=\"left: px; top: px\"\n>\n  <div class=\"menu-header\">\n    <span class=\"tower-name\">📡 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tower?.name || 'Unknown Site'\"></span></span>\n    <span class=\"tower-type\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"siteTypeLabel\"></span></span>\n\n      <div hidden aria-hidden=\"true\"><span class=\"readonly-indicator\">🔒</span>\n    </div>\n  </div>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'edit-site'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">✏️</span>\n    <span>Edit <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"siteTypeLabel\"></span></span>\n  </button>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'add-sector'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">📶</span>\n    <span>Add Sector</span>\n  </button>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'add-backhaul'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">🔗</span>\n    <span>Add Backhaul Link</span>\n  </button>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!shouldHideAddInventory\"><!-- Only show \"Add Equipment Inventory\" when NOT in deploy mode -->\n  <!-- In deploy mode, adding inventory should be done in the Inventory module -->\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'add-inventory'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">📦</span>\n    <span>Add Equipment Inventory</span>\n  </button></div>\n\n  <button class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'view-inventory'\" aria-label=\"Action\">\n    <span class=\"menu-icon\">📋</span>\n    <span>View All Equipment</span>\n  </button>\n\n  <div class=\"menu-divider\"></div>\n\n  <!-- Hardware Deployment -->\n  <button\n    class=\"menu-item epc-option\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'deploy-hardware'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">🔧</span>\n    <span>Deploy Hardware</span>\n  </button>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'change-site-type'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">🔄</span>\n    <span>Change Site Type</span>\n  </button>\n\n  <div class=\"menu-divider\"></div>\n\n  <button\n    class=\"menu-item danger\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'delete-site'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">🗑️</span>\n    <span>Delete Site</span>\n  </button>\n\n  <!-- Show object state info -->\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"objectPermissions\"><div class=\"menu-divider\"></div>\n    <div class=\"object-state-info\">\n      <div class=\"state-item\">\n        <span class=\"state-label\">Status:</span>\n        <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.status\"></span></span>\n      </div>\n      <div class=\"state-item\">\n        <span class=\"state-label\">Source:</span>\n        <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.source\"></span></span>\n      </div>\n\n        <div class=\"state-item\" hidden aria-hidden=\"true\">\n          <span class=\"state-label\">Project:</span>\n          <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.projectId\"></span></span>\n        </div>\n\n    </div></div>\n</div></div></div></div>\n\n<div data-cwl-component=\"SectorActionsMenu\" data-cwl-lifted-component=\"SectorActionsMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSectorActionsMenu\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && sector\"><div\n  class=\"sector-menu\"\n  style=\"left: px; top: px\"\n>\n  <div class=\"menu-header\">\n    <span class=\"sector-name\">📶 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sector?.name || 'Unknown Sector'\"></span></span>\n    <span class=\"sector-type\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sector?.technology || 'Unknown'\"></span></span>\n\n      <div hidden aria-hidden=\"true\"><span class=\"readonly-indicator\">🔒</span>\n    </div>\n  </div>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'add-sector'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">➕</span>\n    <span>Add Sector</span>\n  </button>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'edit-sector'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">✏️</span>\n    <span>Edit Sector</span>\n  </button>\n\n  <div class=\"menu-divider\"></div>\n\n  <button\n    class=\"menu-item danger\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'delete-sector'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">🗑️</span>\n    <span>Delete Sector</span>\n  </button>\n\n  <!-- Show object state info -->\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"objectPermissions\"><div class=\"menu-divider\"></div>\n    <div class=\"object-state-info\">\n      <div class=\"state-item\">\n        <span class=\"state-label\">Status:</span>\n        <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.status\"></span></span>\n      </div>\n      <div class=\"state-item\">\n        <span class=\"state-label\">Source:</span>\n        <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.source\"></span></span>\n      </div>\n\n        <div class=\"state-item\" hidden aria-hidden=\"true\">\n          <span class=\"state-label\">Project:</span>\n          <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.projectId\"></span></span>\n        </div>\n\n    </div></div>\n</div></div></div></div>\n\n<div data-cwl-component=\"BackhaulActionsMenu\" data-cwl-lifted-component=\"BackhaulActionsMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showBackhaulActionsMenu\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && backhaul\"><div\n  class=\"backhaul-menu\"\n  style=\"left: px; top: px\"\n>\n  <div class=\"menu-header\">\n    <span class=\"backhaul-name\">🔗 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"backhaul?.name || 'Unknown Backhaul'\"></span></span>\n    <span class=\"backhaul-type\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"backhaul?.backhaulType || 'Unknown'\"></span></span>\n\n      <div hidden aria-hidden=\"true\"><span class=\"readonly-indicator\">🔒</span>\n    </div>\n  </div>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'add-backhaul'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">➕</span>\n    <span>Add Backhaul</span>\n  </button>\n\n  <button\n    class=\"menu-item\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'edit-backhaul'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">✏️</span>\n    <span>Edit Backhaul</span>\n  </button>\n\n  <div class=\"menu-divider\"></div>\n\n  <button\n    class=\"menu-item danger\" data-cwl-action=\"handleAction\" data-cwl-action-args=\"'delete-backhaul'\"\n   aria-label=\"Action\">\n    <span class=\"menu-icon\">🗑️</span>\n    <span>Delete Backhaul</span>\n  </button>\n\n  <!-- Show object state info -->\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"objectPermissions\"><div class=\"menu-divider\"></div>\n    <div class=\"object-state-info\">\n      <div class=\"state-item\">\n        <span class=\"state-label\">Status:</span>\n        <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.status\"></span></span>\n      </div>\n      <div class=\"state-item\">\n        <span class=\"state-label\">Source:</span>\n        <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.source\"></span></span>\n      </div>\n\n        <div class=\"state-item\" hidden aria-hidden=\"true\">\n          <span class=\"state-label\">Project:</span>\n          <span class=\"state-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"objectPermissions.projectId\"></span></span>\n        </div>\n\n    </div></div>\n</div></div></div></div>\n\n<!-- EPC Deployment Modal -->\n<div data-cwl-component=\"EPCDeploymentModal\" data-cwl-lifted-component=\"EPCDeploymentModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showEPCDeploymentModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content epc-deployment-modal\">\n      <div class=\"modal-header\">\n        <h2>🚀 Server Deployment</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n        <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"success-banner\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"modal-body\">\n        <!-- Step Progress Indicator -->\n        <div class=\"step-indicator\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"Array(totalSteps) as _, i\">\n            <div class=\"step-indicator-item\">\n              <div class=\"step-indicator-number\"></div>\n              <div class=\"step-indicator-line\"></div>\n            </div></div>\n        </div>\n\n        <!-- Step Content -->\n        <div class=\"step-content\">\n          <!-- Step 1: Deployment Type -->\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 1\"><div class=\"step-panel\">\n              <h3>Step 1: Select Deployment Type</h3>\n              <p class=\"step-description\">Choose what components to deploy on the server</p>\n              <div class=\"deployment-type-options\">\n                <label class=\"deployment-option\">\n                  <input type=\"radio\" name=\"deploymentType\" value=\"epc\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">📡</div>\n                    <div class=\"option-info\">\n                      <strong>EPC Core Only</strong>\n                      <p>Deploy Open5GS EPC components (MME, SGW, PGW, PCRF)</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"deployment-option\">\n                  <input type=\"radio\" name=\"deploymentType\" value=\"snmp\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">📊</div>\n                    <div class=\"option-info\">\n                      <strong>SNMP/Mikrotik Agent Only</strong>\n                      <p>Deploy SNMP agent and Mikrotik monitoring modules</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"deployment-option\">\n                  <input type=\"radio\" name=\"deploymentType\" value=\"both\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">🔄</div>\n                    <div class=\"option-info\">\n                      <strong>Both EPC + SNMP</strong>\n                      <p>Deploy both EPC Core and SNMP/Mikrotik monitoring agents</p>\n                    </div>\n                  </div>\n                </label>\n              </div>\n            </div>\n\n          <!-- Step 2: Site Information --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><div class=\"step-panel\">\n              <h3>Step 2: Site Information</h3>\n              <p class=\"step-description\">Select a site to deploy the remote EPC/SNMP agent. Site selection is required to link device codes.</p>\n              <div class=\"form-section\">\n                <div class=\"form-group\">\n                  <label for=\"siteSelect\">Select Site *</label>\n\n                    <select id=\"siteSelect\" required>\n                      <option>-- Select a site --</option>\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%20%7C%7C%20site._id%7D%3E%7Bsite.name%20%7C%7C%20'Unnamed%20Site'%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n                    </select>\n\n                    <div hidden aria-hidden=\"true\"><select id=\"siteSelect\" disabled>\n                      <option>No sites available. Please create a site first.</option>\n                    </select>\n                    <p class=\"form-hint\" style=\"color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.5rem;\">\n                      You need to create a site in the Coverage Map module before deploying remotes.\n                    </p>\n                  </div>\n                    <div hidden aria-hidden=\"true\"><select id=\"siteSelect\" disabled>\n                      <option>Loading sites...</option>\n                    </select>\n                  </div>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedSiteId && selectedSite\"><div class=\"form-group\">\n                    <label>Site Name</label>\n                    <input type=\"text\" data-cwl-attr-value=\"epcConfig.siteName\" readonly />\n                  </div>\n                  <div class=\"form-group\">\n                    <label>Location</label>\n                    <input type=\"text\" data-cwl-attr-value=\"epcConfig.location.address || 'N/A'\" readonly />\n                  </div>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"epcConfig.contact.name || epcConfig.contact.email\"><div class=\"form-group\">\n                      <label>Contact</label>\n                      <input type=\"text\" data-cwl-attr-value=\"epcConfig.contact.name || 'N/A'\" readonly />\n                    </div>\n                    <div class=\"form-group\">\n                      <label>Email</label>\n                      <input type=\"text\" data-cwl-attr-value=\"epcConfig.contact.email || 'N/A'\" readonly />\n                    </div></div></div>\n                  <p class=\"form-hint\" style=\"color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.5rem;\">\n                    Select a site above to auto-fill site information.\n                  </p>\n\n              </div>\n            </div>\n\n          <!-- Step 3: EPC Network Configuration (if EPC selected) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('network')\"><div class=\"step-panel\">\n              <h3>Step 3: EPC Network Configuration</h3>\n              <p class=\"step-description\">Configure network parameters for EPC</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"mcc\">MCC *</label>\n                    <input id=\"mcc\" type=\"text\" placeholder=\"001\" required />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"mnc\">MNC *</label>\n                    <input id=\"mnc\" type=\"text\" placeholder=\"01\" required />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"tac\">TAC *</label>\n                    <input id=\"tac\" type=\"text\" placeholder=\"1\" required />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          <!-- Step 4: HSS Configuration (if EPC selected) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('hss')\"><div class=\"step-panel\">\n              <h3>Step 4: HSS Configuration</h3>\n              <p class=\"step-description\">Configure HSS connection settings</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"hssHost\">HSS Host</label>\n                    <input id=\"hssHost\" type=\"text\" placeholder=\"HSS host\" />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"hssPort\">HSS Port</label>\n                    <input id=\"hssPort\" type=\"text\" placeholder=\"3868\" />\n                  </div>\n                </div>\n                <div class=\"form-group\">\n                  <label for=\"diameterRealm\">Diameter Realm</label>\n                  <input id=\"diameterRealm\" type=\"text\" placeholder=\"example.com\" />\n                </div>\n              </div>\n            </div>\n\n          <!-- SNMP Configuration (if SNMP selected) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('snmp')\"><div class=\"step-panel\">\n              <h3>Step 1: SNMP/Mikrotik Configuration</h3>\n              <p class=\"step-description\">Configure SNMP agent and monitoring</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"snmpVersion\">SNMP Version</label>\n                    <select id=\"snmpVersion\">\n                      <option value=\"2c\">SNMPv2c (Recommended)</option>\n                      <option value=\"1\">SNMPv1</option>\n                      <option value=\"3\">SNMPv3 (Secure)</option>\n                    </select>\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"snmpCommunity\">Community String</label>\n                    <input id=\"snmpCommunity\" type=\"text\" placeholder=\"public\" />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"snmpPort\">SNMP Port</label>\n                    <input id=\"snmpPort\" type=\"number\" placeholder=\"161\" />\n                  </div>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"epcConfig.snmpConfig.version === '3'\"><div class=\"form-row\">\n                    <div class=\"form-group\">\n                      <label for=\"snmpUsername\">SNMPv3 Username</label>\n                      <input id=\"snmpUsername\" type=\"text\" placeholder=\"Enter username\" />\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"snmpAuthProtocol\">Auth Protocol</label>\n                      <select id=\"snmpAuthProtocol\">\n                        <option value=\"SHA\">SHA</option>\n                        <option value=\"MD5\">MD5</option>\n                      </select>\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"snmpAuthKey\">Auth Key</label>\n                      <input id=\"snmpAuthKey\" type=\"password\" placeholder=\"Enter auth key\" />\n                    </div>\n                  </div>\n                  <div class=\"form-row\">\n                    <div class=\"form-group\">\n                      <label for=\"snmpPrivProtocol\">Privacy Protocol</label>\n                      <select id=\"snmpPrivProtocol\">\n                        <option value=\"AES\">AES</option>\n                        <option value=\"DES\">DES</option>\n                      </select>\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"snmpPrivKey\">Privacy Key</label>\n                      <input id=\"snmpPrivKey\" type=\"password\" placeholder=\"Enter privacy key\" />\n                    </div>\n                  </div></div>\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"snmpReportingInterval\">Reporting Interval (seconds)</label>\n                    <input id=\"snmpReportingInterval\" type=\"number\" placeholder=\"60\" />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"snmpCloudApiUrl\">Cloud API URL</label>\n                    <input id=\"snmpCloudApiUrl\" type=\"text\" placeholder=\"https://hss.wisptools.io:3003\" />\n                  </div>\n                  <div class=\"form-group checkbox-group\">\n                    <label>\n                      <input type=\"checkbox\" />\n                      Enable SNMP Traps\n                    </label>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          <!-- APT Repository Configuration --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('apt')\"><div class=\"step-panel\">\n              <h3>Step 1: APT Repository Configuration</h3>\n              <p class=\"step-description\">Configure remote updates repository</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"aptRepositoryUrl\">Repository URL</label>\n                    <input id=\"aptRepositoryUrl\" type=\"text\" placeholder=\"https://hss.wisptools.io/apt\" />\n                  </div>\n                  <div class=\"form-group checkbox-group\">\n                    <label>\n                      <input type=\"checkbox\" />\n                      Enable APT Repository\n                    </label>\n                  </div>\n                  <div class=\"form-group checkbox-group\">\n                    <label>\n                      <input type=\"checkbox\" />\n                      Auto-update Enabled\n                    </label>\n                  </div>\n                </div>\n\n                  <div class=\"form-row\" hidden aria-hidden=\"true\">\n                    <div class=\"form-group\">\n                      <label for=\"aptUpdateSchedule\">Update Schedule</label>\n                      <select id=\"aptUpdateSchedule\">\n                        <option value=\"hourly\">Hourly</option>\n                        <option value=\"daily\">Daily</option>\n                        <option value=\"weekly\">Weekly</option>\n                      </select>\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"aptUpdateTime\">Update Time (HH:MM)</label>\n                      <input id=\"aptUpdateTime\" type=\"text\" placeholder=\"02:00\" pattern=\"[0-9]:[0-9]\" />\n                    </div>\n                    <div class=\"form-group checkbox-group\">\n                      <label>\n                        <input type=\"checkbox\" />\n                        Security Updates Only\n                      </label>\n                    </div>\n                  </div>\n\n              </div>\n            </div>\n\n          <!-- Review Step --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('review')\"><div class=\"step-panel\">\n              <h3>Step 1: Review Configuration</h3>\n              <p class=\"step-description\">Review your deployment configuration</p>\n              <div class=\"review-section\">\n                <div class=\"review-item\">\n                  <strong>Deployment Type:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deploymentType === 'both' ? 'EPC + SNMP' : deploymentType.toUpperCase()\"></span></span>\n                </div>\n                <div class=\"review-item\">\n                  <strong>Site Name:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.siteName\"></span></span>\n                </div>\n                <div class=\"review-item\">\n                  <strong>Device Code:</strong>\n                  <span style=\"color: #999; font-style: italic;\">Will be entered in device configuration after hardware boots</span>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentType === 'epc' || deploymentType === 'both'\"><div class=\"review-item\">\n                    <strong>EPC Network:</strong>\n                    <span>MCC: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.networkConfig.mcc\"></span>, MNC: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.networkConfig.mnc\"></span>, TAC: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.networkConfig.tac\"></span></span>\n                  </div>\n                  <div class=\"review-item\">\n                    <strong>HSS:</strong>\n                    <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.hssConfig.hssHost\"></span>:<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.hssConfig.hssPort\"></span></span>\n                  </div></div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentType === 'snmp' || deploymentType === 'both'\"><div class=\"review-item\">\n                    <strong>SNMP Version:</strong>\n                    <span>SNMPv<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.snmpConfig.version\"></span></span>\n                  </div>\n                  <div class=\"review-item\">\n                    <strong>SNMP Community:</strong>\n                    <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.snmpConfig.community\"></span></span>\n                  </div></div>\n                <div class=\"review-item\">\n                  <strong>Location:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.location.address\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.location.city\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.location.state\"></span></span>\n                </div>\n                <div class=\"review-item\">\n                  <strong>Contact:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.contact.name\"></span> (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.contact.email\"></span>)</span>\n                </div>\n\n                  <div class=\"review-item\" hidden aria-hidden=\"true\">\n                    <strong>APT Repository:</strong>\n                    <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.aptConfig.repositoryUrl\"></span></span>\n                  </div>\n\n              </div>\n            </div>\n\n          <!-- Final Step: Download (Script/ISO Selection) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('download')\"><div class=\"step-panel\">\n              <h3>Step 1: Deploy Hardware</h3>\n              <p class=\"step-description\">Choose your deployment method</p>\n              <div class=\"download-options\">\n                <label class=\"download-option\">\n                  <input type=\"radio\" name=\"deploymentOption\" value=\"link\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">🔗</div>\n                    <div class=\"option-info\">\n                      <strong>Link Existing Device</strong>\n                      <p>Enter the 8-character device code shown on your hardware's screen</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"download-option\">\n                  <input type=\"radio\" name=\"deploymentOption\" value=\"iso\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">💿</div>\n                    <div class=\"option-info\">\n                      <strong>Download ISO Image</strong>\n                      <p>Download a bootable ISO to install on new hardware</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"download-option\">\n                  <input type=\"radio\" name=\"deploymentOption\" value=\"script\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">📜</div>\n                    <div class=\"option-info\">\n                      <strong>Download Script</strong>\n                      <p>Download a bash script to run on an existing Ubuntu server</p>\n                    </div>\n                  </div>\n                </label>\n              </div>\n\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'link'\"><div class=\"device-code-entry\">\n                  <h4>Enter Device Code</h4>\n                  <p class=\"hint\">The device code is displayed on the hardware's screen after booting from the ISO.</p>\n                  <div class=\"code-input-group\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"e.g., AB12CD34\"\n                      maxlength=\"8\"\n                      class=\"device-code-input\"\n                      style=\"text-transform: uppercase; font-family: monospace; font-size: 24px; letter-spacing: 4px; text-align: center;\"\n                    />\n                  </div>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"linkedDeviceInfo\"><div class=\"link-success\">\n                      <span class=\"success-icon\">✅</span>\n                      <div>\n                        <strong>Device Linked Successfully!</strong>\n                        <p>EPC ID: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"linkedDeviceInfo.epc_id\"></span></p>\n                        <p>The device will automatically configure itself.</p>\n                      </div>\n                    </div></div>\n                </div></div>\n\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'script' && deploymentScript\"><div class=\"script-preview\">\n                  <h5>Script Preview:</h5>\n                  <pre><code><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deploymentScript.substring(0, 300)\"></span>...</code></pre>\n                </div></div>\n            </div></div>\n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"modal-actions\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 1\"><button class=\"btn btn-secondary\" data-cwl-action=\"prevStep\" aria-label=\"Prev Step\">\n              ← Previous\n            </button></div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep < totalSteps\"><button class=\"btn btn-primary\" data-cwl-action=\"handleNextClick\" data-cwl-attr-disabled=\"loading\" aria-label=\"Next Click\">\n\n                Next →\n\n            </button></div>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'link'\"><button class=\"btn btn-primary\" data-cwl-action=\"linkDeviceByCode\" data-cwl-attr-disabled=\"linkingDevice || !deviceCode || deviceCode.length !== 8 || linkedDeviceInfo\" aria-label=\"Link Device By Code\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"linkedDeviceInfo\">✅ Device Linked</div>\n                  🔗 Link Device\n\n              </button></div>\n              <button class=\"btn btn-primary\" data-cwl-action=\"downloadDeployment\" data-cwl-attr-disabled=\"loading || !deploymentOption\" aria-label=\"Download Deployment\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'script'\">📥 Download Script</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'iso'\">💿 Download ISO</div>\n                  Select an Option\n\n              </button>\n\n        </div>\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- HSS Registration Modal -->\n<div data-cwl-component=\"HSSRegistrationModal\" data-cwl-lifted-component=\"HSSRegistrationModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showHSSRegistrationModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content hss-registration-modal\">\n      <div class=\"modal-header\">\n        <h2>🏠 Register Site with HSS</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n        <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"success-banner\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"modal-body\">\n        <div class=\"registration-form\">\n          <div class=\"form-section\">\n            <h4>📍 Site Information</h4>\n            <div class=\"form-group\">\n              <label for=\"siteName\">Site Name *</label>\n              <input\n                id=\"siteName\"\n                type=\"text\"\n                placeholder=\"Enter site name\"\n                required\n              />\n            </div>\n            <div class=\"form-group\">\n              <label for=\"siteId\">Site ID</label>\n              <input\n                id=\"siteId\"\n                type=\"text\"\n                placeholder=\"Auto-generated from site\"\n                readonly\n              />\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>🌐 Network Configuration</h4>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"mcc\">MCC *</label>\n                <input\n                  id=\"mcc\"\n                  type=\"text\"\n                  placeholder=\"001\"\n                  required\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"mnc\">MNC *</label>\n                <input\n                  id=\"mnc\"\n                  type=\"text\"\n                  placeholder=\"01\"\n                  required\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"tac\">TAC *</label>\n                <input\n                  id=\"tac\"\n                  type=\"text\"\n                  placeholder=\"1\"\n                  required\n                />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>📍 Location</h4>\n            <div class=\"form-group\">\n              <label for=\"address\">Address *</label>\n              <input\n                id=\"address\"\n                type=\"text\"\n                placeholder=\"Enter address\"\n                required\n              />\n            </div>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"city\">City</label>\n                <input\n                  id=\"city\"\n                  type=\"text\"\n                  placeholder=\"Enter city\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"state\">State</label>\n                <input\n                  id=\"state\"\n                  type=\"text\"\n                  placeholder=\"Enter state\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"country\">Country</label>\n                <input\n                  id=\"country\"\n                  type=\"text\"\n                  placeholder=\"Enter country\"\n                />\n              </div>\n            </div>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"latitude\">Latitude</label>\n                <input\n                  id=\"latitude\"\n                  type=\"number\"\n                  step=\"0.000001\"\n                  placeholder=\"0.000000\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"longitude\">Longitude</label>\n                <input\n                  id=\"longitude\"\n                  type=\"number\"\n                  step=\"0.000001\"\n                  placeholder=\"0.000000\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>📞 Contact Information</h4>\n            <div class=\"form-group\">\n              <label for=\"contactName\">Contact Name *</label>\n              <input\n                id=\"contactName\"\n                type=\"text\"\n                placeholder=\"Enter contact name\"\n                required\n              />\n            </div>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"contactEmail\">Email *</label>\n                <input\n                  id=\"contactEmail\"\n                  type=\"email\"\n                  placeholder=\"Enter email\"\n                  required\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"contactPhone\">Phone</label>\n                <input\n                  id=\"contactPhone\"\n                  type=\"tel\"\n                  placeholder=\"Enter phone\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-section\">\n            <h4>🏠 HSS Configuration</h4>\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"hssHost\">HSS Host</label>\n                <input\n                  id=\"hssHost\"\n                  type=\"text\"\n                  placeholder=\"HSS host\"\n                />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"hssPort\">HSS Port</label>\n                <input\n                  id=\"hssPort\"\n                  type=\"text\"\n                  placeholder=\"3868\"\n                />\n              </div>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"diameterRealm\">Diameter Realm</label>\n              <input\n                id=\"diameterRealm\"\n                type=\"text\"\n                placeholder=\"example.com\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Registration Info -->\n        <div class=\"registration-info\">\n          <h4>ℹ️ Registration Information</h4>\n          <p>This will register the site with the HSS (Home Subscriber Server) to enable:</p>\n          <ul>\n            <li>Subscriber authentication and authorization</li>\n            <li>Network access control</li>\n            <li>QoS management</li>\n            <li>Billing and usage tracking</li>\n            <li>MME connection management</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- Navigation -->\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">\n          Cancel\n        </button>\n        <button\n          class=\"btn-primary\" data-cwl-action=\"registerWithHSS\" data-cwl-attr-disabled=\"loading || !validateConfig()\"\n         aria-label=\"Register With HSS\">\n\n            🏠 Register with HSS\n\n        </button>\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- Hardware Deployment Modal -->\n<div data-cwl-component=\"HardwareDeploymentModal\" data-cwl-lifted-component=\"HardwareDeploymentModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showHardwareDeploymentModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && tower\"><div class=\"modal-overlay\" data-cwl-toggle=\"isLoadingInventory:false\" hidden aria-hidden=\"true\">\n  <div class=\"modal\">\n    <div class=\"modal-header\">\n      <h2>🔧 Deploy Hardware to <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tower?.name || 'Selected Site'\"></span></h2>\n      <button class=\"close-btn\" data-cwl-toggle=\"isLoadingInventory:false\" aria-label=\"Is Loading Inventory\">✕</button>\n    </div>\n\n    <div class=\"modal-content\">\n      <p class=\"info-text\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tower\">Deploy hardware to <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tower.name\"></span></strong> located at <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tower.location?.address || `, $\"></span></strong></div>\n          Deploy hardware to selected location\n\n      </p>\n\n      <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n        ⚠️\n      </div>\n\n      <!-- Site Selector -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"availableSites.length > 1\"><div class=\"form-group\">\n          <label for=\"siteSelect\">Select Site:</label>\n          <select id=\"siteSelect\" class=\"form-control\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableSites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n          </select>\n        </div></div>\n\n        <div class=\"button-group\">\n          <button class=\"btn btn-primary\" data-cwl-action=\"handleEPCDeployment\" aria-label=\"EPCDeployment\">\n            🚀 Deploy EPC to Site\n          </button>\n\n          <button\n            class=\"btn btn-primary\" data-cwl-action=\"handleDeploy\" data-cwl-action-args=\"e\"\n            type=\"button\"\n           aria-label=\"Deploy\">\n            📦 Select Hardware from Inventory\n          </button>\n\n          <button class=\"btn btn-secondary\" data-cwl-action=\"handleInventory\" aria-label=\"Inventory\">\n            📋 View Current Inventory\n          </button>\n        </div>\n\n        <div class=\"info-section\">\n          <h3>Available Hardware Types:</h3>\n          <ul>\n            <li>📡 Radio Equipment (eNodeB, gNodeB, RRH)</li>\n            <li>🛰️ Antennas (Sector, Panel, MIMO)</li>\n            <li>🔌 Power Systems (Batteries, UPS, Solar)</li>\n            <li>🌐 Networking Equipment (Routers, Switches)</li>\n            <li>📡 EPC Equipment (MME, SGW, PGW)</li>\n            <li>🔧 Test Equipment</li>\n            <li>📦 Other Equipment</li>\n          </ul>\n        </div>\n      <div data-cwl-shell-key=\"showInventoryList\" hidden aria-hidden=\"true\">\n        <div data-cwl-shell-key=\"showInventoryList\" hidden aria-hidden=\"true\"><!-- Inventory Selection View -->\n        <div class=\"inventory-selection\">\n          <p style=\"color: var(--text-secondary); margin-bottom: 1rem;\">\n            Select hardware from your inventory to deploy to <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tower?.name\"></span></strong>\n          </p>\n          <button class=\"btn btn-secondary\" data-cwl-toggle=\"showInventoryList:false\" style=\"margin-bottom: 1rem;\" aria-label=\"Show Inventory List\">\n            ← Back to Options\n          </button>\n\n          <div class=\"form-group\">\n            <label for=\"searchInventory\">Search Inventory:</label>\n            <input\n              id=\"searchInventory\"\n              type=\"text\"\n              class=\"form-control\"\n              placeholder=\"Search by manufacturer, model, serial number...\"\n            />\n          </div>\n\n            <div class=\"inventory-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredInventoryItems as item\" data-cwl-each-item=\"item\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22inventory-item%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3Aselected%3D%7BselectedInventoryItem%3F._id%20%3D%3D%3D%20item._id%7D%20data-cwl-action%3D%22handleSelectInventoryItem%22%20data-cwl-action-args%3D%22item%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bitem.model%20%7C%7C%20item.equipmentType%20%7C%7C%20'Unknown'%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22item-status%20status-%7Bitem.status%7D%22%3E%7Bitem.status%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20item.manufacturer%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EManufacturer%3A%20%7Bitem.manufacturer%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20item.serialNumber%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3ESerial%3A%20%7Bitem.serialNumber%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20item.category%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3ECategory%3A%20%7Bitem.category%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div\n                  class=\"inventory-item\" data-cwl-action=\"handleSelectInventoryItem\" data-cwl-action-args=\"item\"\n                >\n                  <div class=\"item-header\">\n                    <strong></strong>\n                    <span class=\"item-status status-\"></span>\n                  </div>\n                  <div class=\"item-details\">\n\n                      <div hidden aria-hidden=\"true\"><span>Manufacturer: </span>\n                    </div>\n\n                      <div hidden aria-hidden=\"true\"><span>Serial: </span>\n                    </div>\n\n                      <div hidden aria-hidden=\"true\"><span>Category: </span>\n                    </div>\n                  </div>\n                </div></div>\n            </div>\n\n            <div class=\"empty-state\" hidden aria-hidden=\"true\">\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"searchQuery\"><p>No inventory items found matching \"\"</p></div>\n                <div class=\"help-message\">\n                  <h3>📦 No Hardware Available</h3>\n                  <p>You need to add hardware to your inventory before you can deploy it.</p>\n                  <p><strong>To add hardware:</strong></p>\n                  <ol>\n                    <li>Go to the <strong>Inventory</strong> module</li>\n                    <li>Click <strong>\"Add Item\"</strong> or scan hardware</li>\n                    <li>Add hardware details (manufacturer, model, serial number)</li>\n                    <li>Set status to <strong>\"Available\"</strong></li>\n                    <li>Return here to deploy it to this site</li>\n                  </ol>\n                  <button class=\"btn btn-primary\" data-cwl-set=\"href:/modules/inventory\">\n                    ➕ Go to Inventory Module\n                  </button>\n                </div>\n\n            </div>\n\n        </div>\n      </div></div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn btn-secondary\" data-cwl-toggle=\"isLoadingInventory:false\" aria-label=\"Is Loading Inventory\">Cancel</button>\n    </div>\n  </div>\n</div></div></div></div>\n\n<!-- Help Modal -->\n<div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!isEmbedded\"><div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showTipsModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div></div></div>\n\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showHelpModal\" hidden aria-hidden=\"true\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">Coverage Map Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n<h3>🗺️ Coverage Map Module</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> The Coverage Map is a comprehensive network asset management and visualization system that consolidates all network equipment (towers, sectors, CPE devices, and inventory) into a single interactive ArcGIS-powered map interface. This module serves as the <strong>central hub</strong> for viewing and managing your entire network infrastructure across all modules (CBRS, ACS, PCI Resolution, etc.).\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#getting-started\">🚀 Getting Started</a></li>\n    <li><a href=\"#map-features\">🗺️ Map Features</a></li>\n    <li><a href=\"#site-management\">Site Management</a></li>\n    <li><a href=\"#sector-configuration\">Sector Configuration</a></li>\n    <li><a href=\"#cpe-management\">📡 CPE Management</a></li>\n    <li><a href=\"#backhaul-management\">🔗 Backhaul Management</a></li>\n    <li><a href=\"#equipment-inventory\">📦 Equipment Inventory</a></li>\n    <li><a href=\"#filtering-search\">🔍 Filtering and Search</a></li>\n    <li><a href=\"#reports-export\">📊 Reports and Export</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n  </ul>\n</div>\n\n<h4 id=\"key-features\">🎯 Key Features</h4>\n<ul>\n  <li><strong>Interactive Map:</strong> ArcGIS-powered map with satellite, street, and hybrid views</li>\n  <li><strong>Tower Site Management:</strong> Add, edit, and manage tower sites with GPS coordinates</li>\n  <li><strong>Sector Management:</strong> Configure sectors per tower with azimuth, tilt, and frequency</li>\n  <li><strong>CPE Device Mapping:</strong> View and manage customer premise equipment locations</li>\n  <li><strong>Backhaul Links:</strong> Visualize and manage point-to-point backhaul connections</li>\n  <li><strong>Equipment Inventory:</strong> Track equipment deployed at each site</li>\n  <li><strong>Coverage Visualization:</strong> View coverage areas and signal strength</li>\n</ul>\n\n<h4 id=\"getting-started\">🚀 Getting Started</h4>\n\n<h4>Step 1: Add a Tower Site</h4>\n<ol>\n  <li>Navigate to <strong>Coverage Map</strong> module</li>\n  <li>Click <strong>\"Add Site\"</strong> button</li>\n  <li>Enter site information:\n    <ul>\n      <li><strong>Site Name</strong> - Unique identifier</li>\n      <li><strong>Address</strong> - Physical location</li>\n      <li><strong>GPS Coordinates</strong> - Latitude and longitude (or click on map)</li>\n      <li><strong>Site Type</strong> - Tower, Building, Pole, etc.</li>\n      <li><strong>Height</strong> - Tower height in meters</li>\n    </ul>\n  </li>\n  <li>Click <strong>\"Save\"</strong> to create site</li>\n</ol>\n\n<h4>Step 2: Add Sectors</h4>\n<ol>\n  <li>Click on a tower site marker on the map</li>\n  <li>Click <strong>\"Add Sector\"</strong> from site popup</li>\n  <li>Enter sector details:\n    <ul>\n      <li><strong>Azimuth</strong> - Direction (0-360 degrees)</li>\n      <li><strong>Tilt</strong> - Antenna tilt angle</li>\n      <li><strong>Frequency</strong> - Operating frequency band</li>\n      <li><strong>Technology</strong> - LTE, 5G, WiMAX, etc.</li>\n      <li><strong>Power</strong> - Transmit power</li>\n    </ul>\n  </li>\n  <li>Save sector</li>\n</ol>\n\n<h4>Step 3: Add CPE Devices</h4>\n<ol>\n  <li>Click <strong>\"Add CPE\"</strong> button</li>\n  <li>Enter CPE information:\n    <ul>\n      <li><strong>Serial Number</strong> - Device identifier</li>\n      <li><strong>Customer</strong> - Associated customer</li>\n      <li><strong>Location</strong> - GPS coordinates or click on map</li>\n      <li><strong>Model</strong> - CPE device model</li>\n      <li><strong>Status</strong> - Active, Inactive, Maintenance</li>\n    </ul>\n  </li>\n  <li>Save CPE device</li>\n</ol>\n\n<h4 id=\"map-features\">🗺️ Map Features</h4>\n\n<h4>Map Controls</h4>\n<ul>\n  <li><strong>Zoom:</strong> Mouse wheel or +/- buttons</li>\n  <li><strong>Pan:</strong> Click and drag map</li>\n  <li><strong>Basemap:</strong> Switch between street, satellite, hybrid, topographic</li>\n  <li><strong>Search:</strong> Search for addresses or coordinates</li>\n  <li><strong>Measure:</strong> Measure distances between points</li>\n  <li><strong>Draw:</strong> Draw coverage areas and zones</li>\n</ul>\n\n<h4>Map Layers</h4>\n<ul>\n  <li><strong>Tower Sites:</strong> Network infrastructure sites</li>\n  <li><strong>Sectors:</strong> Antenna sectors with coverage arcs</li>\n  <li><strong>CPE Devices:</strong> Customer premise equipment</li>\n  <li><strong>Backhaul Links:</strong> Point-to-point connections</li>\n  <li><strong>Coverage Areas:</strong> Signal coverage visualization</li>\n  <li><strong>Equipment:</strong> Deployed equipment markers</li>\n</ul>\n\n<h4 id=\"site-management\">Site Management</h4>\n\n<h4>Viewing Site Details</h4>\n<p>Click on any site marker to see:</p>\n<ul>\n  <li>Site information and address</li>\n  <li>List of sectors configured</li>\n  <li>Deployed equipment inventory</li>\n  <li>Connected CPE devices</li>\n  <li>Backhaul links</li>\n  <li>Site actions menu</li>\n</ul>\n\n<h4>Editing Sites</h4>\n<ol>\n  <li>Click site marker</li>\n  <li>Click <strong>\"Edit Site\"</strong></li>\n  <li>Update site information</li>\n  <li>Move marker on map to update coordinates</li>\n  <li>Save changes</li>\n</ol>\n\n<h4 id=\"sector-configuration\">Sector Configuration</h4>\n\n<h4>Adding Sectors</h4>\n<p>Each tower can have multiple sectors:</p>\n<ul>\n  <li>Typically 3-6 sectors per tower</li>\n  <li>Each sector covers 60-120 degrees</li>\n  <li>Sectors can overlap for redundancy</li>\n  <li>Visual coverage arcs shown on map</li>\n</ul>\n\n<h4>Sector Parameters</h4>\n<ul>\n  <li><strong>Azimuth:</strong> Direction sector is pointing (0-360°)</li>\n  <li><strong>Tilt:</strong> Antenna downtilt angle</li>\n  <li><strong>Frequency:</strong> Operating frequency band</li>\n  <li><strong>Technology:</strong> LTE, 5G, WiMAX, etc.</li>\n  <li><strong>Power:</strong> Transmit power in dBm</li>\n  <li><strong>Height:</strong> Antenna height above ground</li>\n</ul>\n\n<h4 id=\"cpe-management\">📡 CPE Management</h4>\n\n<h4>Adding CPE Devices</h4>\n<p>CPE devices represent customer equipment:</p>\n<ul>\n  <li>Link to customer accounts</li>\n  <li>Track installation location</li>\n  <li>Monitor connection status</li>\n  <li>View signal strength</li>\n  <li>Manage firmware updates</li>\n</ul>\n\n<h4>CPE Status</h4>\n<ul>\n  <li><strong>Active:</strong> Device is online and operational</li>\n  <li><strong>Inactive:</strong> Device is offline or disconnected</li>\n  <li><strong>Maintenance:</strong> Device requires service</li>\n  <li><strong>Pending:</strong> Device awaiting installation</li>\n</ul>\n\n<h4 id=\"backhaul-management\">🔗 Backhaul Management</h4>\n\n<h4>Adding Backhaul Links</h4>\n<ol>\n  <li>Click <strong>\"Add Backhaul Link\"</strong></li>\n  <li>Select source site</li>\n  <li>Select destination site</li>\n  <li>Enter link details:\n    <ul>\n      <li><strong>Link Type:</strong> Point-to-point, Point-to-multipoint</li>\n      <li><strong>Frequency:</strong> Operating frequency</li>\n      <li><strong>Bandwidth:</strong> Link capacity</li>\n      <li><strong>Status:</strong> Active, Planned, Maintenance</li>\n    </ul>\n  </li>\n  <li>Save backhaul link</li>\n</ol>\n\n<h4>Visualizing Backhaul</h4>\n<ul>\n  <li>Lines connect source and destination sites</li>\n  <li>Color coding by status (green=active, red=down, yellow=maintenance)</li>\n  <li>Click link to view details</li>\n  <li>Monitor link utilization</li>\n</ul>\n\n<h4 id=\"equipment-inventory\">📦 Equipment Inventory</h4>\n\n<h4>Site Equipment</h4>\n<p>Track equipment deployed at each site:</p>\n<ul>\n  <li>Radios and antennas</li>\n  <li>Switches and routers</li>\n  <li>Power systems</li>\n  <li>Enclosures and mounting hardware</li>\n</ul>\n\n<h4>Adding Equipment</h4>\n<ol>\n  <li>Click site marker</li>\n  <li>Click <strong>\"Add Equipment\"</strong></li>\n  <li>Select equipment from inventory</li>\n  <li>Enter deployment date</li>\n  <li>Add notes</li>\n  <li>Save equipment assignment</li>\n</ol>\n\n<h4 id=\"filtering-search\">🔍 Filtering and Search</h4>\n\n<h4>Filter Panel</h4>\n<p>Use filters to focus on specific elements:</p>\n<ul>\n  <li><strong>Site Type:</strong> Filter by tower, building, pole</li>\n  <li><strong>Technology:</strong> Filter by LTE, 5G, WiMAX</li>\n  <li><strong>Status:</strong> Filter by active, inactive, maintenance</li>\n  <li><strong>Coverage Area:</strong> Show/hide coverage visualization</li>\n</ul>\n\n<h4>Search Functionality</h4>\n<ul>\n  <li>Search by site name</li>\n  <li>Search by address</li>\n  <li>Search by customer name</li>\n  <li>Search by equipment serial number</li>\n</ul>\n\n<h4 id=\"reports-export\">📊 Reports and Export</h4>\n\n<h4>Available Reports</h4>\n<ul>\n  <li><strong>Site Inventory:</strong> Equipment at each site</li>\n  <li><strong>Coverage Analysis:</strong> Coverage areas and gaps</li>\n  <li><strong>CPE Distribution:</strong> CPE devices by location</li>\n  <li><strong>Backhaul Network:</strong> Backhaul link topology</li>\n</ul>\n\n<h4>Export Options</h4>\n<ul>\n  <li>Export map as image (PNG, PDF)</li>\n  <li>Export site data to CSV</li>\n  <li>Export coverage data for analysis</li>\n  <li>Print map with annotations</li>\n</ul>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n<ul>\n  <li><strong>Accurate Coordinates:</strong> Use GPS for precise site locations</li>\n  <li><strong>Regular Updates:</strong> Keep site information current</li>\n  <li><strong>Documentation:</strong> Add notes and photos to sites</li>\n  <li><strong>Coverage Planning:</strong> Use coverage visualization for planning</li>\n  <li><strong>Equipment Tracking:</strong> Keep equipment inventory updated</li>\n  <li><strong>Backhaul Monitoring:</strong> Track backhaul link status</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>Map not loading:</h4>\n<ul>\n  <li>Check ArcGIS API key is configured</li>\n  <li>Verify internet connection</li>\n  <li>Clear browser cache</li>\n  <li>Check browser console for errors</li>\n</ul>\n\n<h4>Sites not appearing:</h4>\n<ul>\n  <li>Check filters aren't hiding sites</li>\n  <li>Verify site coordinates are valid</li>\n  <li>Zoom out to see all sites</li>\n  <li>Check site status filter</li>\n</ul>\n\n<h4>Can't add sectors:</h4>\n<ul>\n  <li>Verify site is selected</li>\n  <li>Check you have edit permissions</li>\n  <li>Ensure site exists and is saved</li>\n</ul>\n\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- Site Edit Modal -->\n<div data-cwl-component=\"SiteEditModal\" data-cwl-lifted-component=\"SiteEditModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSiteEditModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"site\">✏️ Edit Site: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.name\"></span></div>\n          ➕ Create New Site\n\n      </h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Find Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter address to search...\" data-cwl-on-keydown=\"action:handleSearchAddress\"\n          />\n          <button\n            class=\"btn-secondary\" data-cwl-action=\"handleSearchAddress\" data-cwl-attr-disabled=\"isSearching\"\n           aria-label=\"Search Address\">\n            Search\n          </button>\n        </div>\n        <p class=\"help-text\">Or enter GPS coordinates below</p>\n      </div>\n\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Site Name *</label>\n            <input type=\"text\" placeholder=\"Main Tower Site\" required />\n          </div>\n\n          <div class=\"form-group\" style=\"grid-column: 1 / -1;\">\n            <label>Site Types * (Select all that apply)</label>\n            <div class=\"type-checkboxes\">\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">📡</span>\n                    Tower\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🖥️</span>\n                    NOC\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🏢</span>\n                    HQ\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🏭</span>\n                    Warehouse\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🏗️</span>\n                    Building / Rooftop\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">📡</span>\n                    Pole / Monopole\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🌐</span>\n                    Internet Access Point\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🌍</span>\n                    Internet\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">📍</span>\n                    Other\n                  </span>\n                </label>\n\n            </div>\n            <p class=\"help-text\">Small operators can select multiple types (e.g., NOC + Tower, HQ + NOC)</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">✅ Active</option>\n              <option value=\"inactive\">❌ Inactive</option>\n              <option value=\"maintenance\">🔧 Maintenance</option>\n              <option value=\"planned\">📅 Planned</option>\n            </select>\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.types.includes('tower') || formData.types.includes('pole')\"><div class=\"form-group\">\n            <label>Height (feet)</label>\n            <input type=\"number\" placeholder=\"100\" min=\"0\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Structure Type</label>\n            <select>\n              <option>-- Select --</option>\n              <option value=\"self-supporting\">Self-Supporting</option>\n              <option value=\"guyed\">Guyed</option>\n              <option value=\"monopole\">Monopole</option>\n              <option value=\"building-mounted\">Building-Mounted</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div></div>\n\n          <div class=\"form-group\">\n            <label>Owner</label>\n            <input type=\"text\" placeholder=\"Tower Company LLC\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>FCC ID</label>\n            <input type=\"text\" placeholder=\"FCC-12345\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 GPS Coordinates</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Tower Rd\" />\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Country</label>\n            <input type=\"text\" placeholder=\"US\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Tower Contact (for tower/pole sites) -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.type === 'tower' || formData.type === 'pole'\"><div class=\"section\">\n        <h3>🏢 Tower Owner Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Company</label>\n            <input type=\"text\" placeholder=\"Tower Company LLC\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Contact Name</label>\n            <input type=\"text\" placeholder=\"John Doe\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@tower.com\" />\n          </div>\n        </div>\n      </div></div>\n\n      <!-- Building Contact (for building sites) -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.type === 'building'\"><div class=\"section\">\n        <h3>🏢 Building Owner Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Company</label>\n            <input type=\"text\" placeholder=\"Building Management Co\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Building Manager</label>\n            <input type=\"text\" placeholder=\"Jane Smith\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Contact Name</label>\n            <input type=\"text\" placeholder=\"John Doe\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@building.com\" />\n          </div>\n        </div>\n      </div></div>\n\n      <!-- Site Contact (for all site types) -->\n      <div class=\"section\">\n        <h3>👷 On-Site Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Jane Smith\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Role</label>\n            <input type=\"text\" placeholder=\"Site Manager\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-5678\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"manager@site.com\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- General Contact (fallback) -->\n      <div class=\"section\">\n        <h3>📞 General Contact (Fallback)</h3>\n        <p class=\"help-text\">Used if no specific contact types are provided</p>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Contact Name\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-0000\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@example.com\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Access Information -->\n      <div class=\"section\">\n        <h3>🔐 Site Access</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Gate Code</label>\n            <input type=\"text\" placeholder=\"1234#\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Access Hours</label>\n            <input type=\"text\" placeholder=\"24/7 or Mon-Fri 8am-5pm\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Access Instructions</label>\n          <textarea\n            placeholder=\"Call 30 minutes before arrival. Gate code required. Enter through main gate.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Safety Notes</label>\n          <textarea\n            placeholder=\"High voltage equipment. PPE required. Confined space. Lockout/tagout required.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (site ? '💾 Save Changes' : '✅ Create Site')\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n<!-- Global Settings Button - Removed from modules --></div>\n<div data-cwl-component=\"AddBackhaulModal\" data-cwl-lifted-component=\"AddBackhaulModal\" data-cwl-orphan-modal=\"1\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔗 Add Backhaul Link</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Site Selection -->\n      <div class=\"section\">\n        <h3>📡 Tower Site</h3>\n        <div class=\"form-group\">\n          <label>Select Site *</label>\n          <select>\n            <option>-- Select a tower site --</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as s\" data-cwl-each-item=\"s\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bs.id%7D%3E%7Bs.name%7D%20(%7Bs.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n          </select>\n        </div>\n      </div>\n\n      <!-- Backhaul Type -->\n      <div class=\"section\">\n        <h3>🔗 Backhaul Type</h3>\n        <div class=\"form-group\">\n          <label>Type *</label>\n          <select>\n            <option value=\"fiber\">🌐 Fiber Optic</option>\n            <option value=\"fixed-wireless-licensed\">📡 Fixed Wireless (Licensed Spectrum)</option>\n            <option value=\"fixed-wireless-unlicensed\">📡 Fixed Wireless (Unlicensed - WiFi/60GHz)</option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Link Name *</label>\n          <input type=\"text\" placeholder=\"Main Fiber Link\" />\n        </div>\n      </div>\n\n      <!-- Fiber Specific Fields -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isFiber\"><div class=\"section fiber-section\">\n          <h3>🌐 Fiber Optic Details</h3>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Fiber Provider *</label>\n              <input type=\"text\" placeholder=\"AT&T, Verizon, Zayo, Crown Castle\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Circuit ID</label>\n              <input type=\"text\" placeholder=\"CIRCUIT-123456-ABC\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Fiber Speed</label>\n              <select>\n                <option value=\"100M\">100 Mbps</option>\n                <option value=\"1G\">1 Gbps</option>\n                <option value=\"10G\">10 Gbps</option>\n                <option value=\"100G\">100 Gbps</option>\n              </select>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Handoff Type</label>\n              <select>\n                <option value=\"single-mode\">Single-Mode Fiber (SMF)</option>\n                <option value=\"multi-mode\">Multi-Mode Fiber (MMF)</option>\n                <option value=\"ethernet\">Ethernet Handoff</option>\n                <option value=\"coax\">Coax Handoff</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Connector Type</label>\n              <select>\n                <option value=\"LC\">LC (Lucent Connector)</option>\n                <option value=\"SC\">SC (Subscriber Connector)</option>\n                <option value=\"ST\">ST (Straight Tip)</option>\n                <option value=\"RJ45\">RJ45 (Ethernet)</option>\n                <option value=\"MTP\">MTP/MPO (Multi-fiber)</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Fiber Count</label>\n              <input type=\"number\" placeholder=\"2\" />\n              <p class=\"help-text\">Number of fiber strands</p>\n            </div>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Demarc Location</label>\n            <input type=\"text\" placeholder=\"Ground floor equipment room, Rack A3\" />\n            <p class=\"help-text\">Where fiber enters the building</p>\n          </div>\n        </div></div>\n\n      <!-- Fixed Wireless Specific Fields -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isWireless\"><div class=\"section wireless-section\">\n          <h3>📡 Fixed Wireless Details</h3>\n\n          <!-- RF Configuration -->\n          <h4>📻 RF Configuration</h4>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Azimuth (degrees) *</label>\n              <input type=\"number\" min=\"0\" max=\"360\" />\n              <p class=\"help-text\">Direction link is pointing (0° = North)</p>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Beamwidth (degrees)</label>\n              <input type=\"number\" />\n              <p class=\"help-text\">Antenna beamwidth (10-30° typical for PTP)</p>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Antenna Height (feet)</label>\n              <input type=\"number\" placeholder=\"150\" />\n              <p class=\"help-text\">Height above ground level</p>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Frequency (MHz) *</label>\n              <input type=\"number\" placeholder=\"5800\" />\n              <p class=\"help-text\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.backhaulType === 'fixed-wireless-unlicensed'\">WiFi: 2412-2484, 5150-5850 MHz | 60 GHz: 57000-71000 MHz</div>\n                  Licensed bands: 6 GHz, 11 GHz, 18 GHz, 23 GHz, 80 GHz\n\n              </p>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Channel Bandwidth (MHz)</label>\n              <input type=\"number\" placeholder=\"40\" />\n              <p class=\"help-text\">20, 40, 80, 160 MHz</p>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Antenna Gain (dBi)</label>\n              <input type=\"number\" placeholder=\"23\" />\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>TX Power (dBm)</label>\n              <input type=\"number\" placeholder=\"20\" />\n              <p class=\"help-text\">Transmit power</p>\n            </div>\n          </div>\n\n          <!-- Remote Site Location -->\n          <h4>📍 Remote Site Location</h4>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Remote Latitude</label>\n              <input type=\"number\" step=\"0.000001\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Remote Longitude</label>\n              <input type=\"number\" step=\"0.000001\" />\n            </div>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Remote Site Address</label>\n            <input type=\"text\" placeholder=\"123 Remote Tower Rd\" />\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.backhaulType === 'fixed-wireless-licensed'\"><div class=\"license-section\">\n              <h4>📜 FCC Licensing (Required for Licensed Spectrum)</h4>\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>License Type *</label>\n                  <select>\n                    <option>-- Select Type --</option>\n                    <option value=\"point-to-point\">Point-to-Point</option>\n                    <option value=\"point-to-multipoint\">Point-to-Multipoint</option>\n                    <option value=\"multipoint\">Multipoint</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>FCC License Number *</label>\n                  <input type=\"text\" placeholder=\"FCC-ABC123456\" />\n                  <p class=\"help-text\">FCC call sign or license number</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>License Expiration Date</label>\n                  <input type=\"date\" />\n                </div>\n              </div>\n            </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.backhaulType === 'fixed-wireless-unlicensed'\"><div class=\"unlicensed-info\">\n              <p class=\"info-text\">\n                ℹ️ <strong>Unlicensed Spectrum:</strong> No FCC license required for WiFi (2.4/5 GHz) or 60 GHz bands.\n                Ensure compliance with Part 15 power limits.\n              </p>\n            </div></div>\n        </div></div>\n\n      <!-- Common Fields -->\n      <div class=\"section\">\n        <h3>⚙️ Link Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Link Capacity (Mbps) *</label>\n            <input type=\"number\" placeholder=\"1000\" />\n            <p class=\"help-text\">Expected/guaranteed throughput</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Connects to (Upstream Site)</label>\n            <select>\n              <option>-- Select upstream site --</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites.filter(s => s.id !== formData.siteId) as upstreamOption\"><option></option></div>\n            </select>\n            <p class=\"help-text\">Network topology - which site this connects to</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">Active</option>\n              <option value=\"inactive\">Inactive</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"planned\">Planned</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- Equipment Details -->\n      <div class=\"section\">\n        <h3>🔧 Equipment Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Equipment Manufacturer</label>\n            <input\n              type=\"text\"\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Equipment Model</label>\n            <input\n              type=\"text\"\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Serial Number</label>\n            <input type=\"text\" placeholder=\"SN-123456789\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Install Date</label>\n          <input type=\"date\" />\n        </div>\n      </div>\n\n      <!-- Financial/Contract -->\n      <div class=\"section\">\n        <h3>💰 Financial Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Monthly Recurring Cost ($)</label>\n            <input type=\"number\" />\n            <p class=\"help-text\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isFiber ? 'Monthly circuit fee' : 'Maintenance/licensing costs'\"></span></p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Contract Term (months)</label>\n            <input type=\"number\" placeholder=\"12\" />\n            <p class=\"help-text\">Length of service agreement</p>\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Notes</label>\n          <textarea\n            placeholder=\"Installation notes, special requirements, escalation contacts...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create Backhaul\n      </button>\n    </div>\n  </div>\n</div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/customers"
page modules_customers_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "customers" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers\" data-cwl-island=\"client\"><div class=\"customers-page\">\n    <div class=\"page-header\">\n      <div class=\"header-content\">\n        <div class=\"header-top\">\n          <button class=\"back-btn\" data-cwl-nav=\"/modules\" title=\"Back to Module Manager\">\n            ←\n          </button>\n          <h1>👥 Customer Management</h1>\n        </div>\n        <p class=\"subtitle\">Manage your tenant's customers, service plans, and customer groups</p>\n      </div>\n      <div class=\"header-actions\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'customers'\">\n          <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showModuleWizardMenu\" hidden aria-hidden=\"true\"><div class=\"module-wizard-menu\">\n    <button\n      type=\"button\"\n      class=\"wizard-trigger\" data-cwl-attr-disabled=\"disabled\" data-cwl-action=\"toggle\" data-cwl-on-blur=\"action:handleBlur\"\n      title=\"Wizards for this module\"\n      aria-haspopup=\"true\"\n    >\n      <span class=\"wizard-trigger-icon\">🧙</span>\n      <span class=\"wizard-trigger-label\">Wizards</span>\n      <span class=\"wizard-trigger-chevron\">▼</span>\n    </button>\n\n      <div class=\"wizard-dropdown\" role=\"menu\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"wizards as w\" data-cwl-each-item=\"w\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22menuitem%22%0A%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22wizard-item%22%20data-cwl-action%3D%22select%22%20data-cwl-action-args%3D%22w.id%22%0A%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20w.icon%7D%3Cspan%20class%3D%22wizard-item-icon%22%3E%7Bw.icon%7D%3C%2Fspan%3E%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22wizard-item-label%22%3E%7Bw.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20\"><button\n            type=\"button\"\n            role=\"menuitem\"\n            class=\"wizard-item\" data-cwl-action=\"select\" data-cwl-action-args=\"w.id\"\n           aria-label=\"Select\">\n            <div hidden aria-hidden=\"true\"><span class=\"wizard-item-icon\"></span></div>\n            <span class=\"wizard-item-label\"></span>\n          </button></div>\n      </div>\n\n  </div></div></div>\n          <button class=\"btn-primary\" data-cwl-toggle=\"showAddModal:true\" aria-label=\"Show Add Modal\">\n            ➕ Add Customer\n          </button>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'portal'\" hidden aria-hidden=\"true\">\n          <a href=\"/modules/customers/portal-setup\" class=\"btn-secondary\" title=\"Customize portal branding, FAQ, alerts, and ticket options\">🌐 Customize Portal</a>\n          <a href=\"/modules/customers/portal/login\" target=\"_blank\" class=\"btn-secondary\" title=\"Open Customer Portal\">👁️ View Portal</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Navigation Tabs -->\n    <div class=\"tabs\">\n      <button data-cwl-set=\"activeTab:customers\"\n      >\n        👥 Customers\n      </button>\n      <button data-cwl-set=\"activeTab:service-plans\"\n      >\n        📡 Service Plans\n      </button>\n      <button data-cwl-set=\"activeTab:customer-groups\"\n      >\n        📦 Customer Groups\n      </button>\n      <button data-cwl-set=\"activeTab:portal\"\n      >\n        🌐 Portal\n      </button>\n    </div>\n\n      <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"alert alert-success\" hidden aria-hidden=\"true\"></div>\n\n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'customers'\">\n        <!-- Customers Tab -->\n        <!-- Stats Cards -->\n        <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.total\"></span></div>\n        <div class=\"stat-label\">Total Customers</div>\n      </div>\n      <div class=\"stat-card stat-active\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.active\"></span></div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card stat-pending\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.pending\"></span></div>\n        <div class=\"stat-label\">Pending</div>\n      </div>\n      <div class=\"stat-card stat-suspended\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.suspended\"></span></div>\n        <div class=\"stat-label\">Suspended</div>\n      </div>\n    </div>\n\n    <!-- Search and Filters -->\n    <div class=\"filters-section\">\n      <div class=\"search-bar\">\n        <input\n          type=\"text\"\n          placeholder=\"Search by name, phone, email, or customer ID...\"\n          class=\"search-input\" data-cwl-on-input=\"action:loadCustomers\"\n        />\n      </div>\n\n      <div class=\"filter-controls\">\n        <select data-cwl-on-change=\"action:loadCustomers\">\n          <option>All Statuses</option>\n          <option value=\"active\">Active</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"suspended\">Suspended</option>\n          <option value=\"cancelled\">Cancelled</option>\n          <option value=\"trial\">Trial</option>\n        </select>\n\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" data-cwl-on-change=\"action:loadCustomers\" />\n          Show Inactive\n        </label>\n      </div>\n    </div>\n\n    <!-- Customer List -->\n    <div class=\"customers-list\">\n\n        <div class=\"customer-grid\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"customers as customer (customer._id || customer.customerId)\" data-cwl-each-item=\"customer\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-name-section%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bcustomer.fullName%20%7C%7C%20%60%24%7Bcustomer.firstName%7D%20%24%7Bcustomer.lastName%7D%60%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22customer-id%22%3E%7Bcustomer.customerId%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20%7BgetStatusBadgeClass(customer.serviceStatus)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.serviceStatus%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.primaryPhone%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-icon%22%3E%F0%9F%93%9E%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3E%7BformatPhone(customer.primaryPhone)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.email%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-icon%22%3E%F0%9F%93%A7%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3E%7Bcustomer.email%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceAddress%3F.street%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-icon%22%3E%F0%9F%93%8D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.serviceAddress.street%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceAddress.city%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2C%20%7Bcustomer.serviceAddress.city%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceAddress.state%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2C%20%7Bcustomer.serviceAddress.state%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.servicePlan%3F.planName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-icon%22%3E%F0%9F%93%A1%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.servicePlan.planName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.servicePlan.downloadMbps%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20(%7Bcustomer.servicePlan.downloadMbps%7D%2F%7Bcustomer.servicePlan.uploadMbps%7D%20Mbps)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceType%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-icon%22%3E%F0%9F%93%B6%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EService%20Type%3A%20%7Bcustomer.serviceType%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.networkInfo%3F.imsi%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-icon%22%3E%F0%9F%94%A2%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EIMSI%3A%20%7Bcustomer.networkInfo.imsi%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-secondary%20btn-sm%22%20data-cwl-action%3D%22handleEdit%22%20data-cwl-action-args%3D%22customer%22%20aria-label%3D%22Edit%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9C%8F%EF%B8%8F%20Edit%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-danger%20btn-sm%22%20data-cwl-action%3D%22handleDelete%22%20data-cwl-action-args%3D%22customer%22%20aria-label%3D%22Delete%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%97%91%EF%B8%8F%20Delete%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-secondary%20btn-sm%22%20data-cwl-nav%3D%22%2Fmodules%2Fcustomers%2F%7Bcustomer._id%20%7C%7C%20customer.customerId%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%91%81%EF%B8%8F%20View%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-secondary%20btn-sm%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Voice%20%26%20SIP%20for%20this%20customer%22%20data-cwl-nav%3D%22%2Fmodules%2Fvoice-telephony%3FcustomerId%3D%7BencodeURIComponent(customer.customerId)%7D%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%93%9E%20Voice%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ca%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20href%3D%22%2Fmodules%2Fcustomers%2Fportal%2Flogin%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20target%3D%22_blank%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-secondary%20btn-sm%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Open%20Customer%20Portal%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%8C%90%20Portal%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fa%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20\"><div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> </h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n\n                </span>\n              </div>\n\n              <div class=\"customer-details\">\n\n                  <div class=\"detail-row\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-icon\">📞</span>\n                    <span></span>\n                  </div>\n\n                  <div class=\"detail-row\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.serviceAddress?.street\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">📍</span>\n                    <span>\n\n                        <div hidden aria-hidden=\"true\">,\n                      </div>\n\n                        <div hidden aria-hidden=\"true\">,\n                      </div>\n                    </span>\n                  </div></div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.servicePlan?.planName\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">📡</span>\n                    <span>\n\n                        <div hidden aria-hidden=\"true\">(/ Mbps)\n                      </div>\n                    </span>\n                  </div></div>\n\n                  <div class=\"detail-row\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-icon\">📶</span>\n                    <span>Service Type: </span>\n                  </div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.networkInfo?.imsi\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">🔢</span>\n                    <span>IMSI: </span>\n                  </div></div>\n              </div>\n\n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\" data-cwl-action=\"handleEdit\" data-cwl-action-args=\"customer\" aria-label=\"Edit\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\" data-cwl-action=\"handleDelete\" data-cwl-action-args=\"customer\" aria-label=\"Delete\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a\n                  href=\"/modules/customers/portal/login\"\n                  target=\"_blank\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div></div>\n        </div>\n\n        <div class=\"empty-state\" hidden aria-hidden=\"true\">\n          <p>No customers found.</p>\n          <button class=\"btn-primary\" data-cwl-toggle=\"showAddModal:true\" aria-label=\"Show Add Modal\">Add Your First Customer</button>\n        </div>\n\n        <div class=\"loading\" hidden aria-hidden=\"true\">Loading customers...</div>\n\n    </div>\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'service-plans'\" hidden aria-hidden=\"true\">\n        <!-- Service Plans Tab -->\n        <div data-cwl-component=\"BandwidthPlans\" data-cwl-lifted-component=\"BandwidthPlans\"><div class=\"bandwidth-plans\">\n  <div class=\"header\">\n    <h2>Bandwidth Plans</h2>\n    <button class=\"btn-primary\" data-cwl-toggle=\"showAddModal:true\" aria-label=\"Show Add Modal\">\n      + Add Bandwidth Plan\n    </button>\n  </div>\n\n    <div class=\"plans-grid\">\n      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"plans as plan\" data-cwl-each-item=\"plan\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bplan.name%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-speeds%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22speed%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EDOWNLOAD%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bplan.download_mbps%20%7C%7C%200%7D%20Mbps%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22speed%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EUPLOAD%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bplan.upload_mbps%20%7C%7C%200%7D%20Mbps%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22plan-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-edit%22%20data-cwl-action%3D%22openEditModal%22%20data-cwl-action-args%3D%22plan%22%20aria-label%3D%22Open%20Edit%20Modal%22%3EEdit%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-delete%22%20data-cwl-action%3D%22deletePlan%22%20data-cwl-action-args%3D%22plan.plan_id%22%20aria-label%3D%22Delete%20Plan%22%3EDelete%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20\"><div class=\"plan-card\">\n          <div class=\"plan-header\">\n            <h3></h3>\n          </div>\n          <div class=\"plan-speeds\">\n            <div class=\"speed\">\n              <span class=\"label\">DOWNLOAD</span>\n              <span class=\"value\"> Mbps</span>\n            </div>\n            <div class=\"speed\">\n              <span class=\"label\">UPLOAD</span>\n              <span class=\"value\"> Mbps</span>\n            </div>\n          </div>\n          <div class=\"plan-actions\">\n            <button class=\"btn-edit\" data-cwl-action=\"openEditModal\" data-cwl-action-args=\"plan\" aria-label=\"Open Edit Modal\">Edit</button>\n            <button class=\"btn-delete\" data-cwl-action=\"deletePlan\" data-cwl-action-args=\"plan.plan_id\" aria-label=\"Delete Plan\">Delete</button>\n          </div>\n        </div></div>\n    </div>\n\n    <div class=\"empty-state\" hidden aria-hidden=\"true\">\n      <p>No bandwidth plans yet</p>\n      <p class=\"hint\">Create bandwidth plans to assign to subscriber groups</p>\n    </div>\n\n</div>\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showAddModal:false\" data-cwl-shell-key=\"showAddModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal\">\n      <div class=\"modal-header\">\n        <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingPlan ? 'Edit' : 'Add'\"></span> Bandwidth Plan</h3>\n        <button class=\"close-btn\" data-cwl-toggle=\"showAddModal:false\" aria-label=\"Show Add Modal\">×</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"form-group\">\n          <label>Plan Name</label>\n          <input\n            type=\"text\"\n            placeholder=\"Gold Plan\"\n          />\n        </div>\n        <div class=\"form-row\">\n          <div class=\"form-group\">\n            <label>Download Speed (Mbps)</label>\n            <input\n              type=\"number\"\n              min=\"1\"\n              placeholder=\"100\"\n            />\n          </div>\n          <div class=\"form-group\">\n            <label>Upload Speed (Mbps)</label>\n            <input\n              type=\"number\"\n              min=\"1\"\n              placeholder=\"50\"\n            />\n          </div>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"btn-cancel\" data-cwl-toggle=\"showAddModal:false\" aria-label=\"Show Add Modal\">Cancel</button>\n        <button class=\"btn-save\" data-cwl-action=\"savePlan\" aria-label=\"Save Plan\">\n          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingPlan ? 'Update' : 'Create'\"></span> Plan\n        </button>\n      </div>\n    </div>\n  </div></div>\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'customer-groups'\" hidden aria-hidden=\"true\">\n        <!-- Customer Groups Tab -->\n        <div data-cwl-component=\"GroupManagement\" data-cwl-lifted-component=\"GroupManagement\"><div class=\"group-management\">\n  <div class=\"header\">\n    <h2>Subscriber Groups</h2>\n    <div style=\"display: flex; gap: 0.5rem;\">\n      <button class=\"btn-secondary\" data-cwl-action=\"loadCustomers\" title=\"Refresh groups and customers\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn-primary\" data-cwl-toggle=\"showAddModal:true\" aria-label=\"Show Add Modal\">\n        + Add Group\n      </button>\n    </div>\n  </div>\n\n    <div class=\"groups-grid\">\n      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"groups as group\" data-cwl-each-item=\"group\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%7B%40const%20groupCustomers%20%3D%20getCustomersInGroup(group.group_id%20%7C%7C%20group.id)%7D%0A%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22group-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22group-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bgroup.name%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22customer-count%22%3E%7BgroupCustomers.length%7D%20%7BgroupCustomers.length%20%3D%3D%3D%201%20%3F%20'customer'%20%3A%20'customers'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%7B%23if%20group.description%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22description%22%3E%7Bgroup.description%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22group-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22info-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EBandwidth%20Plan%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7BgetBandwidthPlanName(group.bandwidth_plan_id)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%7B%23if%20groupCustomers.length%20%3E%200%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customers-list%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3ECustomers%20in%20this%20group%3A%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cul%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20groupCustomers%20as%20customer%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22customer-name%22%3E%7Bcustomer.fullName%20%7C%7C%20%60%24%7Bcustomer.firstName%7D%20%24%7Bcustomer.lastName%7D%60%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.primaryPhone%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22customer-phone%22%3E%7Bcustomer.primaryPhone%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceStatus%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22customer-status%20status-%7Bcustomer.serviceStatus%7D%22%3E%7Bcustomer.serviceStatus%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ful%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22no-customers%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%3ENo%20customers%20assigned%20to%20this%20group%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22group-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-edit%22%20data-cwl-action%3D%22openEditModal%22%20data-cwl-action-args%3D%22group%22%20aria-label%3D%22Open%20Edit%20Modal%22%3EEdit%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-delete%22%20data-cwl-action%3D%22deleteGroup%22%20data-cwl-action-args%3D%22group.group_id%22%20aria-label%3D%22Delete%20Group%22%3EDelete%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20\">\n        <div class=\"group-card\">\n          <div class=\"group-header\">\n            <h3></h3>\n            <span class=\"customer-count\"> </span>\n          </div>\n\n            <div hidden aria-hidden=\"true\"><p class=\"description\"></p>\n          </div>\n          <div class=\"group-info\">\n            <div class=\"info-item\">\n              <span class=\"label\">Bandwidth Plan</span>\n              <span class=\"value\"></span>\n            </div>\n          </div>\n\n            <div class=\"customers-list\">\n              <h4>Customers in this group:</h4>\n              <ul>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"groupCustomers as customer\"><li>\n                    <span class=\"customer-name\"> </span>\n\n                      <div hidden aria-hidden=\"true\"><span class=\"customer-phone\"></span>\n                    </div>\n\n                      <div hidden aria-hidden=\"true\"><span class=\"customer-status status-\"></span>\n                    </div>\n                  </li></div>\n              </ul>\n            </div>\n\n          <div class=\"group-actions\">\n            <button class=\"btn-edit\" data-cwl-action=\"openEditModal\" data-cwl-action-args=\"group\" aria-label=\"Open Edit Modal\">Edit</button>\n            <button class=\"btn-delete\" data-cwl-action=\"deleteGroup\" data-cwl-action-args=\"group.group_id\" aria-label=\"Delete Group\">Delete</button>\n          </div>\n        </div></div>\n    </div>\n\n    <div class=\"empty-state\" hidden aria-hidden=\"true\">\n      <p>No subscriber groups yet</p>\n      <p class=\"hint\">Create groups to organize subscribers and assign bandwidth plans</p>\n    </div>\n\n</div>\n\n  <div class=\"modal-overlay\" data-cwl-toggle=\"showAddModal:false\" data-cwl-shell-key=\"showAddModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal\">\n      <div class=\"modal-header\">\n        <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingGroup ? 'Edit' : 'Add'\"></span> Subscriber Group</h3>\n        <button class=\"close-btn\" data-cwl-toggle=\"showAddModal:false\" aria-label=\"Show Add Modal\">×</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"form-group\">\n          <label>Group Name</label>\n          <input\n            type=\"text\"\n            placeholder=\"Residential Users\"\n          />\n        </div>\n        <div class=\"form-group\">\n          <label>Description</label>\n          <textarea\n            placeholder=\"Group description...\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n        <div class=\"form-group\">\n          <label>Bandwidth Plan</label>\n          <select>\n            <option>No plan</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"bandwidthPlans as plan\" data-cwl-each-item=\"plan\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bplan.plan_id%7D%3E%7Bplan.name%7D%20(%7Bplan.download_mbps%7D%2F%7Bplan.upload_mbps%7D%20Mbps)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option> (/ Mbps)</option></div>\n          </select>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button class=\"btn-cancel\" data-cwl-toggle=\"showAddModal:false\" aria-label=\"Show Add Modal\">Cancel</button>\n        <button class=\"btn-save\" data-cwl-action=\"saveGroup\" aria-label=\"Save Group\">\n          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingGroup ? 'Update' : 'Create'\"></span> Group\n        </button>\n      </div>\n    </div>\n  </div></div>\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'portal'\" hidden aria-hidden=\"true\">\n        <!-- Portal Tab: setup and view customer portal -->\n        <div class=\"portal-tab\">\n          <div class=\"portal-tab-header\">\n            <h2>Customer Portal</h2>\n            <p class=\"portal-tab-desc\">The customer portal lets your subscribers log in to view tickets, service status, and support. Use <strong>Customize Portal</strong> to configure branding and options; use <strong>View Portal</strong> to open the portal in a new tab.</p>\n          </div>\n          <div class=\"portal-actions\">\n            <a href=\"/modules/customers/portal-setup\" class=\"btn-primary\" title=\"Customize portal branding, FAQ, alerts, and ticket options\">\n              🌐 Customize Portal\n            </a>\n            <a href=\"/modules/customers/portal/login\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-secondary\" title=\"Open portal login in new tab\">\n              👁️ View Portal\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n    <div data-cwl-shell-key=\"showAddModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"AddEditCustomerModal\" data-cwl-lifted-component=\"AddEditCustomerModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAddModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"customer ? '✏️ Edit Customer' : '➕ Add Customer'\"></span></h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"success\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Basic Information -->\n      <div class=\"section\">\n        <h3>👤 Basic Information</h3>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>First Name *</label>\n            <input type=\"text\" placeholder=\"John\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Last Name *</label>\n            <input type=\"text\" placeholder=\"Smith\" required />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Primary Phone *</label>\n            <input type=\"tel\" placeholder=\"555-123-4567\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Alternate Phone</label>\n            <input type=\"tel\" placeholder=\"555-123-4568\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Email</label>\n          <input type=\"email\" placeholder=\"john.smith@example.com\" />\n        </div>\n      </div>\n\n      <!-- Service -->\n      <div class=\"section\">\n        <h3>📡 Service</h3>\n\n        <div class=\"form-group\">\n          <label>Service Status</label>\n          <select>\n            <option>Select Service Status</option>\n            <option value=\"pending\">Pending</option>\n            <option value=\"active\">Active</option>\n            <option value=\"trial\">Trial</option>\n            <option value=\"suspended\">Suspended</option>\n            <option value=\"cancelled\">Cancelled</option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Service Type</label>\n          <select>\n            <option>Select Service Type</option>\n            <option value=\"4G/5G\">4G/5G (LTE/5G)</option>\n            <option value=\"FWA\">FWA (Fixed Wireless Access)</option>\n            <option value=\"WiFi\">WiFi</option>\n            <option value=\"Fiber\">Fiber</option>\n          </select>\n        </div>\n      </div>\n\n      <!-- Service Address -->\n      <div class=\"section\">\n        <h3>📍 Service Address</h3>\n\n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Main St\" />\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"City\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"State\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"12345\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Billing Address -->\n      <div class=\"section\">\n        <h3>💳 Billing Address</h3>\n\n        <div class=\"form-group\">\n          <label>\n            <input type=\"checkbox\" data-cwl-on-change=\"action:handleBillingAddressChange\" />\n            Same as Service Address\n          </label>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!formData.billingAddress.sameAsService\"><div class=\"form-group\">\n            <label>Street Address</label>\n            <input type=\"text\" placeholder=\"123 Main St\" />\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>City</label>\n              <input type=\"text\" placeholder=\"City\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>State</label>\n              <input type=\"text\" placeholder=\"State\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>ZIP Code</label>\n              <input type=\"text\" placeholder=\"12345\" />\n            </div>\n          </div></div>\n      </div>\n\n      <!-- Customer Group -->\n      <div class=\"section\">\n        <h3>📦 Customer Group</h3>\n        <p class=\"section-description\">Select a customer group. The service plan will be automatically set from the group's bandwidth plan.</p>\n\n        <div class=\"form-group\">\n          <select data-cwl-on-change=\"action:handleGroupChange\">\n            <option>Select Customer Group</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"customerGroups as group\" data-cwl-each-item=\"group\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bgroup.group_id%20%7C%7C%20group.id%7D%3E%7Bgroup.name%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n          </select>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"groupWarning\"><div class=\"warning-message\" style=\"margin-top: 0.75rem; padding: 0.75rem; background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; color: #856404;\">\n            <strong>⚠️ </strong>\n          </div></div>\n\n          <div hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.servicePlan.planId || formData.servicePlan.downloadMbps || formData.servicePlan.uploadMbps\"><div class=\"service-plan-preview\">\n              <h4>Service Plan</h4>\n              <div class=\"plan-details\">\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Plan ID:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.planId\"></span></span>\n                  </div>\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Plan:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.planName\"></span></span>\n                  </div>\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Download:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.downloadMbps\"></span> Mbps</span>\n                  </div>\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Upload:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.uploadMbps\"></span> Mbps</span>\n                  </div>\n\n              </div>\n            </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!groupWarning\"><div class=\"service-plan-preview\" style=\"opacity: 0.6;\">\n              <p style=\"margin: 0; color: var(--text-secondary);\">Loading service plan from group...</p>\n            </div></div>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.serviceType === '4G/5G'\"><div class=\"form-grid\" style=\"margin-top: 1rem;\">\n            <div class=\"form-group\">\n              <label>QCI (Quality Class Identifier)</label>\n              <input type=\"number\" min=\"1\" max=\"9\" placeholder=\"9\" />\n              <small>1-9 (9 is default best effort)</small>\n            </div>\n            <div class=\"form-group\">\n              <label>Data Quota (bytes)</label>\n              <input type=\"number\" placeholder=\"0 = unlimited\" />\n              <small>0 = unlimited, or specify bytes</small>\n            </div>\n            <div class=\"form-group\">\n              <select>\n                <option>Select Priority Level</option>\n                <option value=\"low\">Low</option>\n                <option value=\"medium\">Medium</option>\n                <option value=\"high\">High</option>\n                <option value=\"premium\">Premium</option>\n              </select>\n            </div>\n          </div></div>\n      </div>\n\n      <!-- LTE/5G Authentication (for 4G/5G service type) -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.serviceType === '4G/5G'\"><div class=\"section\">\n          <h3>🔐 LTE/5G Authentication</h3>\n          <p class=\"section-description\">Required for 4G/5G service type. These credentials are used for subscriber authentication.</p>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>IMSI (15 digits)</label>\n              <input\n                type=\"text\"\n                placeholder=\"123456789012345\"\n                maxlength=\"15\"\n                pattern=\"[0-9]\"\n              />\n              <small>International Mobile Subscriber Identity</small>\n            </div>\n\n            <div class=\"form-group\">\n              <label>MSISDN (Phone Number)</label>\n              <input\n                type=\"text\" data-cwl-attr-placeholder=\"formData.primaryPhone.replace(/\\D/g, '')\"\n              />\n              <small>Mobile Station ISDN Number</small>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Ki (Authentication Key) *</label>\n              <input\n                type=\"text\"\n                placeholder=\"32 or 64 hex characters\"\n                pattern=\"[0-9A-Fa-f]|[0-9A-Fa-f]\"\n              />\n              <small>128-bit (32 hex) or 256-bit (64 hex) key</small>\n            </div>\n\n            <div class=\"form-group\">\n              <label>OPc (Operator Variant) *</label>\n              <input\n                type=\"text\"\n                placeholder=\"32 hex characters\"\n                pattern=\"[0-9A-Fa-f]\"\n              />\n              <small>128-bit (32 hex) operator variant</small>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>OP (Operator Variant - Alternative)</label>\n              <input\n                type=\"text\"\n                placeholder=\"32 hex characters (optional)\"\n                pattern=\"[0-9A-Fa-f]\"\n              />\n              <small>Use OP instead of OPc if needed</small>\n            </div>\n\n            <div class=\"form-group\">\n              <label>SQN (Sequence Number)</label>\n              <input\n                type=\"number\"\n                placeholder=\"0\"\n                min=\"0\"\n              />\n              <small>Sequence number for AKA (default: 0)</small>\n            </div>\n          </div>\n        </div></div>\n\n      <!-- MAC Address (Optional, for ACS integration) -->\n      <div class=\"section\">\n        <h3>🔌 MAC Address (Optional)</h3>\n        <p class=\"section-description\">MAC address for ACS/TR-069 integration. Not required but useful for device management.</p>\n\n        <div class=\"form-group\">\n          <label>MAC Address</label>\n          <input\n            type=\"text\"\n            placeholder=\"aa:bb:cc:dd:ee:ff or aa-bb-cc-dd-ee-ff\"\n            pattern=\"([0-9A-Fa-f][:-])([0-9A-Fa-f])\"\n          />\n          <small>Format: xx:xx:xx:xx:xx:xx or xx-xx-xx-xx-xx-xx</small>\n        </div>\n      </div>\n\n      <!-- Tags -->\n      <div class=\"section\">\n        <h3>🏷️ Tags</h3>\n\n        <div class=\"form-group\">\n          <div class=\"tag-input-group\">\n            <input\n              type=\"text\"\n              placeholder=\"Add tag...\" data-cwl-on-keydown=\"action:addTag\"\n            />\n            <button type=\"button\" class=\"btn-add-tag\" data-cwl-action=\"addTag\" aria-label=\"Add Tag\">Add</button>\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.tags.length > 0\"><div class=\"tags-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"formData.tags as tag\"><span class=\"tag\">\n\n                  <button type=\"button\" class=\"tag-remove\" data-cwl-action=\"removeTag\" data-cwl-action-args=\"tag\" aria-label=\"Remove Tag\">✕</button>\n                </span></div>\n            </div></div>\n        </div>\n      </div>\n\n      <!-- Voice / SIP (linked by customer id) -->\n\n        <div class=\"section\" hidden aria-hidden=\"true\">\n          <h3>📞 Voice / SIP</h3>\n          <p class=\"section-description\">\n            Voice inventory and E911 are managed in the Voice module. Telephone numbers can be linked to this customer using\n            customer id <code><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"customer.customerId\"></span></code>.\n          </p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"voiceError\"><p class=\"voice-err\"></p></div>\n            <ul class=\"voice-line-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"voiceLines as vl\" data-cwl-each-item=\"vl\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccode%3E%7Bvl.e164%7D%3C%2Fcode%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22muted%22%3E%C2%B7%20%7Bvl.status%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20title%3D%22E911%20from%20emergency%20address%22%3E%C2%B7%20911%3A%20%7Bvl.e911Display%20%3F%3F%20'%E2%80%94'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><li>\n                  <code></code>\n                  <span class=\"muted\">· </span>\n                  <span title=\"E911 from emergency address\">· 911: </span>\n                </li></div>\n            </ul>\n\n            <div hidden aria-hidden=\"true\"><p class=\"muted\">No voice lines linked yet. Open Voice &amp; SIP to assign numbers to this customer.</p>\n          </div>\n          <div class=\"voice-actions\">\n            <button\n              type=\"button\"\n              class=\"btn-secondary\" data-cwl-nav=\"/modules/voice-telephony?customerId=\"\n            >\n              Open Voice module\n            </button>\n          </div>\n        </div>\n\n      <!-- Notes -->\n      <div class=\"section\">\n        <h3>📝 Notes</h3>\n\n        <div class=\"form-group\">\n          <textarea\n            placeholder=\"Additional notes about this customer...\"\n            rows=\"4\"\n          ></textarea>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (customer ? '✅ Update Customer' : '✅ Create Customer')\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n  </div>\n\n    <div data-cwl-shell-key=\"showEditModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"AddEditCustomerModal\" data-cwl-lifted-component=\"AddEditCustomerModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showEditModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"customer ? '✏️ Edit Customer' : '➕ Add Customer'\"></span></h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"success\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Basic Information -->\n      <div class=\"section\">\n        <h3>👤 Basic Information</h3>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>First Name *</label>\n            <input type=\"text\" placeholder=\"John\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Last Name *</label>\n            <input type=\"text\" placeholder=\"Smith\" required />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Primary Phone *</label>\n            <input type=\"tel\" placeholder=\"555-123-4567\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Alternate Phone</label>\n            <input type=\"tel\" placeholder=\"555-123-4568\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Email</label>\n          <input type=\"email\" placeholder=\"john.smith@example.com\" />\n        </div>\n      </div>\n\n      <!-- Service -->\n      <div class=\"section\">\n        <h3>📡 Service</h3>\n\n        <div class=\"form-group\">\n          <label>Service Status</label>\n          <select>\n            <option>Select Service Status</option>\n            <option value=\"pending\">Pending</option>\n            <option value=\"active\">Active</option>\n            <option value=\"trial\">Trial</option>\n            <option value=\"suspended\">Suspended</option>\n            <option value=\"cancelled\">Cancelled</option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Service Type</label>\n          <select>\n            <option>Select Service Type</option>\n            <option value=\"4G/5G\">4G/5G (LTE/5G)</option>\n            <option value=\"FWA\">FWA (Fixed Wireless Access)</option>\n            <option value=\"WiFi\">WiFi</option>\n            <option value=\"Fiber\">Fiber</option>\n          </select>\n        </div>\n      </div>\n\n      <!-- Service Address -->\n      <div class=\"section\">\n        <h3>📍 Service Address</h3>\n\n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Main St\" />\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"City\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"State\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"12345\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Billing Address -->\n      <div class=\"section\">\n        <h3>💳 Billing Address</h3>\n\n        <div class=\"form-group\">\n          <label>\n            <input type=\"checkbox\" data-cwl-on-change=\"action:handleBillingAddressChange\" />\n            Same as Service Address\n          </label>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!formData.billingAddress.sameAsService\"><div class=\"form-group\">\n            <label>Street Address</label>\n            <input type=\"text\" placeholder=\"123 Main St\" />\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>City</label>\n              <input type=\"text\" placeholder=\"City\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>State</label>\n              <input type=\"text\" placeholder=\"State\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>ZIP Code</label>\n              <input type=\"text\" placeholder=\"12345\" />\n            </div>\n          </div></div>\n      </div>\n\n      <!-- Customer Group -->\n      <div class=\"section\">\n        <h3>📦 Customer Group</h3>\n        <p class=\"section-description\">Select a customer group. The service plan will be automatically set from the group's bandwidth plan.</p>\n\n        <div class=\"form-group\">\n          <select data-cwl-on-change=\"action:handleGroupChange\">\n            <option>Select Customer Group</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"customerGroups as group\" data-cwl-each-item=\"group\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bgroup.group_id%20%7C%7C%20group.id%7D%3E%7Bgroup.name%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n          </select>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"groupWarning\"><div class=\"warning-message\" style=\"margin-top: 0.75rem; padding: 0.75rem; background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; color: #856404;\">\n            <strong>⚠️ </strong>\n          </div></div>\n\n          <div hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.servicePlan.planId || formData.servicePlan.downloadMbps || formData.servicePlan.uploadMbps\"><div class=\"service-plan-preview\">\n              <h4>Service Plan</h4>\n              <div class=\"plan-details\">\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Plan ID:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.planId\"></span></span>\n                  </div>\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Plan:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.planName\"></span></span>\n                  </div>\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Download:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.downloadMbps\"></span> Mbps</span>\n                  </div>\n\n                  <div class=\"plan-detail\" hidden aria-hidden=\"true\">\n                    <span class=\"label\">Upload:</span>\n                    <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formData.servicePlan.uploadMbps\"></span> Mbps</span>\n                  </div>\n\n              </div>\n            </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!groupWarning\"><div class=\"service-plan-preview\" style=\"opacity: 0.6;\">\n              <p style=\"margin: 0; color: var(--text-secondary);\">Loading service plan from group...</p>\n            </div></div>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.serviceType === '4G/5G'\"><div class=\"form-grid\" style=\"margin-top: 1rem;\">\n            <div class=\"form-group\">\n              <label>QCI (Quality Class Identifier)</label>\n              <input type=\"number\" min=\"1\" max=\"9\" placeholder=\"9\" />\n              <small>1-9 (9 is default best effort)</small>\n            </div>\n            <div class=\"form-group\">\n              <label>Data Quota (bytes)</label>\n              <input type=\"number\" placeholder=\"0 = unlimited\" />\n              <small>0 = unlimited, or specify bytes</small>\n            </div>\n            <div class=\"form-group\">\n              <select>\n                <option>Select Priority Level</option>\n                <option value=\"low\">Low</option>\n                <option value=\"medium\">Medium</option>\n                <option value=\"high\">High</option>\n                <option value=\"premium\">Premium</option>\n              </select>\n            </div>\n          </div></div>\n      </div>\n\n      <!-- LTE/5G Authentication (for 4G/5G service type) -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.serviceType === '4G/5G'\"><div class=\"section\">\n          <h3>🔐 LTE/5G Authentication</h3>\n          <p class=\"section-description\">Required for 4G/5G service type. These credentials are used for subscriber authentication.</p>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>IMSI (15 digits)</label>\n              <input\n                type=\"text\"\n                placeholder=\"123456789012345\"\n                maxlength=\"15\"\n                pattern=\"[0-9]\"\n              />\n              <small>International Mobile Subscriber Identity</small>\n            </div>\n\n            <div class=\"form-group\">\n              <label>MSISDN (Phone Number)</label>\n              <input\n                type=\"text\" data-cwl-attr-placeholder=\"formData.primaryPhone.replace(/\\D/g, '')\"\n              />\n              <small>Mobile Station ISDN Number</small>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Ki (Authentication Key) *</label>\n              <input\n                type=\"text\"\n                placeholder=\"32 or 64 hex characters\"\n                pattern=\"[0-9A-Fa-f]|[0-9A-Fa-f]\"\n              />\n              <small>128-bit (32 hex) or 256-bit (64 hex) key</small>\n            </div>\n\n            <div class=\"form-group\">\n              <label>OPc (Operator Variant) *</label>\n              <input\n                type=\"text\"\n                placeholder=\"32 hex characters\"\n                pattern=\"[0-9A-Fa-f]\"\n              />\n              <small>128-bit (32 hex) operator variant</small>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>OP (Operator Variant - Alternative)</label>\n              <input\n                type=\"text\"\n                placeholder=\"32 hex characters (optional)\"\n                pattern=\"[0-9A-Fa-f]\"\n              />\n              <small>Use OP instead of OPc if needed</small>\n            </div>\n\n            <div class=\"form-group\">\n              <label>SQN (Sequence Number)</label>\n              <input\n                type=\"number\"\n                placeholder=\"0\"\n                min=\"0\"\n              />\n              <small>Sequence number for AKA (default: 0)</small>\n            </div>\n          </div>\n        </div></div>\n\n      <!-- MAC Address (Optional, for ACS integration) -->\n      <div class=\"section\">\n        <h3>🔌 MAC Address (Optional)</h3>\n        <p class=\"section-description\">MAC address for ACS/TR-069 integration. Not required but useful for device management.</p>\n\n        <div class=\"form-group\">\n          <label>MAC Address</label>\n          <input\n            type=\"text\"\n            placeholder=\"aa:bb:cc:dd:ee:ff or aa-bb-cc-dd-ee-ff\"\n            pattern=\"([0-9A-Fa-f][:-])([0-9A-Fa-f])\"\n          />\n          <small>Format: xx:xx:xx:xx:xx:xx or xx-xx-xx-xx-xx-xx</small>\n        </div>\n      </div>\n\n      <!-- Tags -->\n      <div class=\"section\">\n        <h3>🏷️ Tags</h3>\n\n        <div class=\"form-group\">\n          <div class=\"tag-input-group\">\n            <input\n              type=\"text\"\n              placeholder=\"Add tag...\" data-cwl-on-keydown=\"action:addTag\"\n            />\n            <button type=\"button\" class=\"btn-add-tag\" data-cwl-action=\"addTag\" aria-label=\"Add Tag\">Add</button>\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.tags.length > 0\"><div class=\"tags-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"formData.tags as tag\"><span class=\"tag\">\n\n                  <button type=\"button\" class=\"tag-remove\" data-cwl-action=\"removeTag\" data-cwl-action-args=\"tag\" aria-label=\"Remove Tag\">✕</button>\n                </span></div>\n            </div></div>\n        </div>\n      </div>\n\n      <!-- Voice / SIP (linked by customer id) -->\n\n        <div class=\"section\" hidden aria-hidden=\"true\">\n          <h3>📞 Voice / SIP</h3>\n          <p class=\"section-description\">\n            Voice inventory and E911 are managed in the Voice module. Telephone numbers can be linked to this customer using\n            customer id <code><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"customer.customerId\"></span></code>.\n          </p>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"voiceError\"><p class=\"voice-err\"></p></div>\n            <ul class=\"voice-line-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"voiceLines as vl\" data-cwl-each-item=\"vl\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccode%3E%7Bvl.e164%7D%3C%2Fcode%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22muted%22%3E%C2%B7%20%7Bvl.status%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20title%3D%22E911%20from%20emergency%20address%22%3E%C2%B7%20911%3A%20%7Bvl.e911Display%20%3F%3F%20'%E2%80%94'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><li>\n                  <code></code>\n                  <span class=\"muted\">· </span>\n                  <span title=\"E911 from emergency address\">· 911: </span>\n                </li></div>\n            </ul>\n\n            <div hidden aria-hidden=\"true\"><p class=\"muted\">No voice lines linked yet. Open Voice &amp; SIP to assign numbers to this customer.</p>\n          </div>\n          <div class=\"voice-actions\">\n            <button\n              type=\"button\"\n              class=\"btn-secondary\" data-cwl-nav=\"/modules/voice-telephony?customerId=\"\n            >\n              Open Voice module\n            </button>\n          </div>\n        </div>\n\n      <!-- Notes -->\n      <div class=\"section\">\n        <h3>📝 Notes</h3>\n\n        <div class=\"form-group\">\n          <textarea\n            placeholder=\"Additional notes about this customer...\"\n            rows=\"4\"\n          ></textarea>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (customer ? '✅ Update Customer' : '✅ Create Customer')\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n  </div>\n\n  <div data-cwl-component=\"CustomerOnboardingWizard\" data-cwl-lifted-component=\"CustomerOnboardingWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showOnboardingWizard\" hidden aria-hidden=\"true\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showBaseWizard\" hidden aria-hidden=\"true\"><div\n    class=\"wizard-overlay\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"wizard-title\" data-cwl-action=\"handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"wizard-modal\"\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\">👋 Customer Onboarding Wizard</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <!-- Progress Steps -->\n\n        <nav class=\"wizard-steps\" aria-label=\"Wizard steps\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"steps as step, index\"><button\n              type=\"button\"\n              class=\"wizard-step\" data-cwl-attr-disabled=\"!allowStepNavigation || index &gt; currentStep\" data-cwl-action=\"goToStep\" data-cwl-action-args=\"index\"\n             aria-label=\"Go To Step\">\n              <span class=\"step-icon\"></span>\n              <span class=\"step-title\"></span>\n            </button></div>\n        </nav>\n\n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n          <div class=\"alert alert-success\" hidden aria-hidden=\"true\"></div>\n\n        <!-- Slot for step content -->\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><div class=\"wizard-panel\">\n        <h3>Add a New Customer</h3>\n        <p>This wizard guides you through adding a customer: basic info, address, service type, and optional LTE credentials.</p>\n        <div class=\"info-box\">\n          <h4>You will:</h4>\n          <ul>\n            <li>Enter name and contact info</li>\n            <li>Set service address</li>\n            <li>Choose service type and optional group</li>\n            <li>Optionally add LTE/5G credentials</li>\n          </ul>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 1\"><div class=\"wizard-panel\">\n        <h3>Basic Information</h3>\n        <div class=\"form-group\">\n          <label>First Name <span class=\"required\">*</span></label>\n          <input type=\"text\" placeholder=\"John\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n        <div class=\"form-group\">\n          <label>Last Name <span class=\"required\">*</span></label>\n          <input type=\"text\" placeholder=\"Smith\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n        <div class=\"form-group\">\n          <label>Primary Phone <span class=\"required\">*</span></label>\n          <input type=\"tel\" placeholder=\"555-123-4567\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n        <div class=\"form-group\">\n          <label>Email</label>\n          <input type=\"email\" placeholder=\"john@example.com\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><div class=\"wizard-panel\">\n        <h3>Service Address</h3>\n        <div class=\"form-group\">\n          <label>Street <span class=\"required\">*</span></label>\n          <input type=\"text\" placeholder=\"123 Main St\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n        <div class=\"form-row\">\n          <div class=\"form-group\">\n            <label>City <span class=\"required\">*</span></label>\n            <input type=\"text\" placeholder=\"City\" data-cwl-attr-disabled=\"isLoading\" />\n          </div>\n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"State\" data-cwl-attr-disabled=\"isLoading\" />\n          </div>\n          <div class=\"form-group\">\n            <label>ZIP <span class=\"required\">*</span></label>\n            <input type=\"text\" placeholder=\"12345\" data-cwl-attr-disabled=\"isLoading\" />\n          </div>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 3\"><div class=\"wizard-panel\">\n        <h3>Service Type & Group</h3>\n        <div class=\"form-group\">\n          <label>Service Type</label>\n          <select data-cwl-attr-disabled=\"isLoading\">\n            <option>Select type</option>\n            <option value=\"4G/5G\">4G/5G (LTE/5G)</option>\n            <option value=\"FWA\">FWA (Fixed Wireless)</option>\n            <option value=\"WiFi\">WiFi</option>\n            <option value=\"Fiber\">Fiber</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label>Customer Group (optional)</label>\n          <select data-cwl-attr-disabled=\"isLoading\">\n            <option>No group</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"groups as g\" data-cwl-each-item=\"g\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bg.group_id%7D%3E%7Bg.name%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n          </select>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 4\"><div class=\"wizard-panel\">\n        <h3>LTE/5G (optional)</h3>\n        <p class=\"hint\">Only needed if service type is 4G/5G and you want to sync to HSS.</p>\n        <div class=\"form-group\">\n          <label>IMSI (15 digits)</label>\n          <input type=\"text\" placeholder=\"123456789012345\" maxlength=\"15\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n        <div class=\"form-group\">\n          <label>Ki (32 hex)</label>\n          <input type=\"text\" placeholder=\"32 hex characters\" maxlength=\"32\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n        <div class=\"form-group\">\n          <label>OPc (32 hex)</label>\n          <input type=\"text\" placeholder=\"32 hex characters\" maxlength=\"32\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n        <div class=\"form-group\">\n          <label>MAC Address (optional)</label>\n          <input type=\"text\" placeholder=\"aa:bb:cc:dd:ee:ff\" data-cwl-attr-disabled=\"isLoading\" />\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 5\"><div class=\"wizard-panel\">\n\n          <h3>Review & create</h3>\n          <div class=\"summary-row\"><span class=\"label\">Name</span><span class=\"value\"> </span></div>\n          <div class=\"summary-row\"><span class=\"label\">Phone</span><span class=\"value\"></span></div>\n          <div class=\"summary-row\"><span class=\"label\">Address</span><span class=\"value\">, ,  </span></div>\n          <div class=\"summary-row\"><span class=\"label\">Service</span><span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceType || '—'\"></span></span></div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"groupId\"><div class=\"summary-row\"><span class=\"label\">Group</span><span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"groups.find(g => g.group_id === groupId)?.name || groupId\"></span></span></div></div>\n          <button type=\"button\" class=\"wizard-btn-primary\" data-cwl-action=\"createCustomer\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Create Customer\">\n            Create customer\n          </button>\n\n          <div hidden aria-hidden=\"true\"><h3>🎉 Customer created</h3>\n          <p></p>\n          <div class=\"info-box success\">\n            <p><strong> </strong></p>\n            <p>, ,  </p>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"serviceType\"><p>Service: </p></div>\n          </div>\n          <a href=\"/modules/customers\" class=\"next-step-item\">View in Customers module →</a>\n        </div>\n      </div></div>\n      </div>\n\n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 0 && currentStep < steps.length - 1\"><button class=\"wizard-btn-secondary\" data-cwl-action=\"prevStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Prev Step\">← Previous</button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><button class=\"wizard-btn-secondary\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Close\">Cancel</button></div>\n    <div class=\"footer-actions\">\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 4\"><button class=\"wizard-btn-primary\" data-cwl-action=\"nextStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Next Step\">Next →</button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 5 && success\"><button class=\"wizard-btn-primary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Done</button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep < steps.length - 1\"><button class=\"wizard-btn-primary\" data-cwl-action=\"nextStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Next Step\">Next →</button></div>\n    </div></span> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"prevStep\"></span>    />\n      </div>\n    </div>\n  </div></div></div></div></div></div>\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\" data-cwl-orphan-modal=\"1\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\" hidden aria-hidden=\"true\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div>\n<div data-cwl-component=\"CustomerBillingModal\" data-cwl-lifted-component=\"CustomerBillingModal\" data-cwl-orphan-modal=\"1\"><div class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal\">\n      <div class=\"modal-header\">\n        <h2>Billing – <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"customer?.fullName || customer?.customerId\"></span></h2>\n        <button type=\"button\" class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"modal-body\">\n\n          <div class=\"form-section\">\n            <h3>Service plan</h3>\n            <div class=\"form-row\">\n              <label for=\"billing-plan\">Plan name</label>\n              <input id=\"billing-plan\" type=\"text\" placeholder=\"e.g. Residential 50\" />\n            </div>\n            <div class=\"form-row\">\n              <label for=\"billing-monthly\">Monthly fee ($)</label>\n              <input id=\"billing-monthly\" type=\"number\" step=\"0.01\" min=\"0\" />\n            </div>\n            <div class=\"form-row\">\n              <label for=\"billing-setup\">Setup fee ($)</label>\n              <input id=\"billing-setup\" type=\"number\" step=\"0.01\" min=\"0\" />\n            </div>\n          </div>\n          <div class=\"form-section\">\n            <h3>Billing cycle</h3>\n            <div class=\"form-row\">\n              <label for=\"billing-type\">Cycle</label>\n              <select id=\"billing-type\">\n                <option value=\"monthly\">Monthly</option>\n                <option value=\"annual\">Annual</option>\n              </select>\n            </div>\n            <div class=\"form-row\">\n              <label for=\"billing-day\">Day of month (1–31)</label>\n              <input id=\"billing-day\" type=\"number\" min=\"1\" max=\"31\" />\n            </div>\n            <div class=\"form-row\">\n              <label for=\"next-billing\">Next billing date</label>\n              <input id=\"next-billing\" type=\"date\" />\n            </div>\n          </div>\n          <div class=\"form-section\">\n            <h3>SLA</h3>\n            <div class=\"form-row\">\n              <label for=\"sla-response\">Response time (hours)</label>\n              <input id=\"sla-response\" type=\"number\" min=\"1\" max=\"168\" placeholder=\"e.g. 24\" />\n            </div>\n            <div class=\"form-row\">\n              <label for=\"sla-uptime\">Uptime guarantee (%)</label>\n              <input id=\"sla-uptime\" type=\"number\" step=\"0.1\" min=\"0\" max=\"100\" placeholder=\"e.g. 99.9\" />\n            </div>\n            <div class=\"form-row\">\n              <label for=\"sla-notes\">SLA notes</label>\n              <input id=\"sla-notes\" type=\"text\" placeholder=\"Optional notes\" />\n            </div>\n          </div>\n\n            <div class=\"balance-section\" hidden aria-hidden=\"true\">\n              <h3>Balance</h3>\n              <p>Current: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(billing.balance.current ?? 0)\"></span> · Overdue: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(billing.balance.overdue ?? 0)\"></span></p>\n            </div>\n\n          <div class=\"form-section\">\n            <h3>Invoices</h3>\n\n              <p class=\"muted\">No invoices yet.</p>\n\n              <div hidden aria-hidden=\"true\"><ul class=\"invoice-list\">\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"billing.invoices as inv\"><li class=\"invoice-item\">\n                    <span class=\"inv-num\"></span>\n                    <span class=\"inv-amount\"></span>\n                    <span class=\"inv-status\"></span>\n                    <span class=\"inv-due\">Due </span>\n                  </li></div>\n              </ul>\n            </div>\n\n              <div class=\"sub-form\" data-cwl-shell-key=\"showAddInvoice\" hidden aria-hidden=\"true\">\n                <div class=\"form-row\">\n                  <label>Invoice number</label>\n                  <input type=\"text\" placeholder=\"e.g. INV-2025-001\" />\n                </div>\n                <div class=\"form-row\">\n                  <label>Amount ($)</label>\n                  <input type=\"number\" step=\"0.01\" min=\"0\" />\n                </div>\n                <div class=\"form-row\">\n                  <label>Due date</label>\n                  <input type=\"date\" />\n                </div>\n                <div class=\"form-actions-inline\">\n                  <button type=\"button\" class=\"btn-primary\" data-cwl-action=\"handleAddInvoice\" data-cwl-attr-disabled=\"saving || !invoiceForm.invoiceNumber || invoiceForm.amount &lt;= 0 || !invoiceForm.dueDate\" aria-label=\"Add Invoice\">Add invoice</button>\n                  <button type=\"button\" class=\"btn-secondary\" data-cwl-toggle=\"showAddInvoice:false\">Cancel</button>\n                </div>\n              </div>\n\n          </div>\n\n          <div class=\"form-section\">\n            <h3>Payment history</h3>\n\n              <p class=\"muted\">No payments recorded.</p>\n\n              <div hidden aria-hidden=\"true\"><ul class=\"payment-list\">\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"billing.paymentHistory.slice().reverse() as pay\"><li class=\"payment-item\">\n                    <span class=\"pay-amount\"></span>\n                    <span class=\"pay-method\"></span>\n                    <span class=\"pay-date\"></span>\n                  </li></div>\n              </ul>\n            </div>\n\n              <div class=\"sub-form\" data-cwl-shell-key=\"showRecordPayment\" hidden aria-hidden=\"true\">\n                <div class=\"form-row\">\n                  <label>Amount ($)</label>\n                  <input type=\"number\" step=\"0.01\" min=\"0.01\" />\n                </div>\n                <div class=\"form-row\">\n                  <label>Method</label>\n                  <select>\n                    <option value=\"cash\">Cash</option>\n                    <option value=\"check\">Check</option>\n                    <option value=\"credit_card\">Credit card</option>\n                    <option value=\"ach\">ACH</option>\n                    <option value=\"other\">Other</option>\n                  </select>\n                </div>\n                <div class=\"form-row\">\n                  <label>Apply to invoice (optional)</label>\n                  <select>\n                    <option>—</option>\n\n                      <div hidden aria-hidden=\"true\"><div data-cwl-bind=\"each\" data-cwl-hole-detail=\"billing.invoices.filter((i) => i.status === 'pending' || i.status === 'overdue') as inv\"><option> – </option></div>\n                    </div>\n                  </select>\n                </div>\n                <div class=\"form-row\">\n                  <label>Transaction ID (optional)</label>\n                  <input type=\"text\" placeholder=\"Reference\" />\n                </div>\n                <div class=\"form-actions-inline\">\n                  <button type=\"button\" class=\"btn-primary\" data-cwl-action=\"handleRecordPayment\" data-cwl-attr-disabled=\"saving || paymentForm.amount &lt;= 0\" aria-label=\"Record Payment\">Record payment</button>\n                  <button type=\"button\" class=\"btn-secondary\" data-cwl-toggle=\"showRecordPayment:false\">Cancel</button>\n                </div>\n              </div>\n\n          </div>\n\n          <div hidden aria-hidden=\"true\"><p class=\"error-msg\"></p>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <button type=\"button\" class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n\n          <button type=\"button\" class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"saving\" aria-label=\"Save\">Save</button>\n\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/customers/portal"
page modules_customers_portal_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"auth-redirect\" data-wisp-path=\"/modules/customers/portal\"><div class=\"loading-page\"><div class=\"spinner\"></div><p>Checking authentication...</p></div><script>(function(){function go(p){location.replace(p);}try{var a=window.firebase&&firebase.auth&&firebase.auth();if(a&&a.onAuthStateChanged){a.onAuthStateChanged(function(u){go(u?\"/modules/customers/portal/dashboard\":\"/modules/customers/portal/login\");});return;}var u=localStorage.getItem(\"firebase:authUser\")||sessionStorage.getItem(\"wisp-demo-user\")||localStorage.getItem(\"wisp-customer-session\")||sessionStorage.getItem(\"wisp-customer-session\");go(u?\"/modules/customers/portal/dashboard\":\"/modules/customers/portal/login\");}catch(e){go(\"/modules/customers/portal/login\");}})();</script><noscript><a href=\"/modules/customers/portal/login\">Continue to login</a></noscript></div>";
}

@page GET "/modules/customers/portal-setup"
page modules_customers_portal_setup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal-setup" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal-setup\" data-cwl-island=\"client\"><div class=\"portal-admin-page\">\n    <div class=\"page-header\">\n      <div class=\"header-left\">\n        <button class=\"back-btn\" data-cwl-nav=\"/modules\" title=\"Back to Modules\">\n          ← Exit to Modules\n        </button>\n      </div>\n      <div class=\"header-content\">\n        <h1>🌐 Customer Portal Management</h1>\n        <p class=\"subtitle\">Configure your customer-facing portal, content, and support features</p>\n      </div>\n      <div class=\"header-actions\">\n        <a target=\"_blank\" class=\"btn-secondary\">\n          View Portal →\n        </a>\n      </div>\n    </div>\n\n      <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"alert alert-success\" hidden aria-hidden=\"true\"></div>\n\n    <!-- Tab Navigation -->\n    <div class=\"tab-navigation\">\n      <button class=\"tab-btn\" data-cwl-set=\"currentTab:branding\">\n        🎨 Branding\n      </button>\n      <button class=\"tab-btn\" data-cwl-set=\"currentTab:features\">\n        ⚙️ Features\n      </button>\n      <button class=\"tab-btn\" data-cwl-set=\"currentTab:billing\">\n        💳 Billing Portal\n      </button>\n      <button class=\"tab-btn\" data-cwl-set=\"currentTab:alerts\">\n        🚨 Alerts & Outages\n      </button>\n      <button class=\"tab-btn\" data-cwl-set=\"currentTab:faq\">\n        ❓ FAQ\n      </button>\n      <button class=\"tab-btn\" data-cwl-set=\"currentTab:knowledge\">\n        📚 Knowledge Base\n      </button>\n      <button class=\"tab-btn\" data-cwl-set=\"currentTab:chat\">\n        💬 Live Chat\n      </button>\n    </div>\n\n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      <!-- Branding Tab -->\n\n        <div class=\"content-section\">\n          <h2>Portal Branding</h2>\n          <p class=\"section-description\">Customize the look and feel of your customer portal.</p>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Company Name</label>\n              <div class=\"readonly-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"companyName || 'Not set'\"></span></div>\n              <p class=\"help-text\">Managed from tenant settings</p>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Portal URL</label>\n              <div class=\"readonly-value url-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getPortalUrl()\"></span></div>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Logo URL</label>\n              <input type=\"url\" placeholder=\"https://yourcompany.com/logo.png\" class=\"form-input\" />\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"logoUrl\"><div class=\"logo-preview\">\n                  <img alt=\"Logo preview\" />\n                </div></div>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Primary Color</label>\n              <div class=\"color-input-group\">\n                <input type=\"color\" class=\"color-picker\" />\n                <input type=\"text\" placeholder=\"#3b82f6\" class=\"form-input color-text\" />\n              </div>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Support Email</label>\n              <input type=\"email\" placeholder=\"support@yourcompany.com\" class=\"form-input\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Support Phone</label>\n              <input type=\"tel\" placeholder=\"(555) 123-4567\" class=\"form-input\" />\n            </div>\n\n            <div class=\"form-group full-width\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Use Custom Domain</span>\n              </label>\n\n            </div>\n          </div>\n\n          <div class=\"form-actions\">\n            <button class=\"btn-primary\" data-cwl-action=\"saveBranding\" data-cwl-attr-disabled=\"saving\" aria-label=\"Save Branding\">\n              Save Branding\n            </button>\n          </div>\n        </div>\n\n      <!-- Billing Portal Tab: payment gateways & invoice customization -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentTab === 'billing'\" hidden aria-hidden=\"true\">\n        <div class=\"content-section\">\n          <h2>Billing Portal Admin</h2>\n          <p class=\"section-description\">Configure payment gateways (Stripe, PayPal) and customize how invoices look for your customers.</p>\n\n          <div class=\"billing-portal-sections\">\n            <section class=\"billing-subsection\">\n              <h3>Payment Gateways</h3>\n              <p class=\"help-text\">Enable online payments in the customer portal. Store Stripe secret key in backend env (STRIPE_SECRET_KEY); use the publishable key here for the portal. For PayPal, use your client ID and choose sandbox for testing.</p>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group full-width\">\n                  <label class=\"toggle-label\">\n                    <input type=\"checkbox\" />\n                    <span class=\"toggle-switch\"></span>\n                    <span>Enable Stripe</span>\n                  </label>\n                  <input type=\"text\" placeholder=\"pk_live_... or pk_test_... (publishable key)\" class=\"form-input\" />\n                  <input type=\"text\" placeholder=\"Optional note (e.g. key purpose)\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label class=\"toggle-label\">\n                    <input type=\"checkbox\" />\n                    <span class=\"toggle-switch\"></span>\n                    <span>Enable PayPal</span>\n                  </label>\n                  <input type=\"text\" placeholder=\"PayPal client ID\" class=\"form-input\" />\n                  <label class=\"checkbox-label\">\n                    <input type=\"checkbox\" />\n                    Use PayPal sandbox (testing)\n                  </label>\n                  <input type=\"text\" placeholder=\"Optional note\" class=\"form-input\" />\n                </div>\n              </div>\n            </section>\n\n            <section class=\"billing-subsection\">\n              <h3>Invoice Customization</h3>\n              <p class=\"help-text\">These appear on generated invoices and in the customer billing portal.</p>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>Company name on invoices</label>\n                  <input type=\"text\" placeholder=\"Your WISP Name\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group\">\n                  <label>Invoice logo URL</label>\n                  <input type=\"url\" placeholder=\"https://...\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label>Address (on invoice)</label>\n                  <input type=\"text\" placeholder=\"Street, City, State ZIP\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label>Footer text</label>\n                  <input type=\"text\" placeholder=\"Thank you for your business\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label>Terms & conditions</label>\n                  <textarea placeholder=\"Payment terms, late fees, etc.\" class=\"form-input\" rows=\"4\"></textarea>\n                </div>\n                <div class=\"form-group\">\n                  <label>Default due days</label>\n                  <input type=\"number\" min=\"1\" max=\"90\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group\">\n                  <label>Currency</label>\n                  <select class=\"form-input\">\n                    <option value=\"USD\">USD</option>\n                    <option value=\"CAD\">CAD</option>\n                    <option value=\"EUR\">EUR</option>\n                    <option value=\"GBP\">GBP</option>\n                  </select>\n                </div>\n              </div>\n            </section>\n          </div>\n\n          <div class=\"form-actions\">\n            <button class=\"btn-primary\" data-cwl-action=\"saveBillingPortal\" data-cwl-attr-disabled=\"saving\" aria-label=\"Save Billing Portal\">\n              Save Billing Portal Settings\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Features Tab -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentTab === 'features'\" hidden aria-hidden=\"true\">\n        <div class=\"content-section\">\n          <h2>Portal Features</h2>\n          <p class=\"section-description\">Enable or disable features for your customer portal.</p>\n\n          <div class=\"feature-toggles\">\n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">❓ FAQ / Help Center</span>\n                  <span class=\"toggle-description\">Show frequently asked questions to customers</span>\n                </div>\n              </label>\n            </div>\n\n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">🚨 Service Status & Outages</span>\n                  <span class=\"toggle-description\">Display service alerts and outage notifications</span>\n                </div>\n              </label>\n            </div>\n\n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">💳 Billing & Invoices</span>\n                  <span class=\"toggle-description\">Let customers view billing and invoice history</span>\n                </div>\n              </label>\n            </div>\n\n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">🎫 Support Tickets</span>\n                  <span class=\"toggle-description\">Let customers open and track support tickets</span>\n                </div>\n              </label>\n            </div>\n\n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">📚 Knowledge Base</span>\n                  <span class=\"toggle-description\">Provide documentation and help articles</span>\n                </div>\n              </label>\n            </div>\n\n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">💬 Live Chat Support</span>\n                  <span class=\"toggle-description\">Enable real-time chat with customers</span>\n                </div>\n              </label>\n\n            </div>\n          </div>\n\n          <div class=\"form-actions\">\n            <button class=\"btn-primary\" data-cwl-action=\"saveFeatures\" data-cwl-attr-disabled=\"saving\" aria-label=\"Save Features\">\n              Save Features\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Alerts Tab -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentTab === 'alerts'\" hidden aria-hidden=\"true\">\n        <div class=\"content-section\">\n          <div class=\"section-header\">\n            <div>\n              <h2>Alerts & Outages</h2>\n              <p class=\"section-description\">Notify customers about service issues, maintenance, and updates.</p>\n            </div>\n            <button class=\"btn-primary\" data-cwl-toggle=\"showAlertForm:true\" aria-label=\"Show Alert Form\">\n              + New Alert\n            </button>\n          </div>\n\n            <div class=\"form-card\" data-cwl-shell-key=\"showAlertForm\" hidden aria-hidden=\"true\">\n              <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingAlertId ? 'Edit Alert' : 'Create New Alert'\"></span></h3>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>Title</label>\n                  <input type=\"text\" placeholder=\"Alert title\" class=\"form-input\" />\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Type</label>\n                  <select class=\"form-input\">\n                    <option value=\"info\">ℹ️ Information</option>\n                    <option value=\"warning\">⚠️ Warning</option>\n                    <option value=\"outage\">🔴 Outage</option>\n                    <option value=\"maintenance\">🟡 Maintenance</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Status</label>\n                  <select class=\"form-input\">\n                    <option value=\"active\">Active</option>\n                    <option value=\"scheduled\">Scheduled</option>\n                    <option value=\"resolved\">Resolved</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group full-width\">\n                  <label>Message</label>\n                  <textarea placeholder=\"Alert message...\" class=\"form-input\" rows=\"3\"></textarea>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Start Date (optional)</label>\n                  <input type=\"datetime-local\" class=\"form-input\" />\n                </div>\n\n                <div class=\"form-group\">\n                  <label>End Date (optional)</label>\n                  <input type=\"datetime-local\" class=\"form-input\" />\n                </div>\n              </div>\n\n              <div class=\"form-actions\">\n                <button class=\"btn-secondary\" data-cwl-toggle=\"showAlertForm:false\" aria-label=\"Show Alert Form\">Cancel</button>\n                <button class=\"btn-primary\" data-cwl-action=\"saveAlert\" data-cwl-attr-disabled=\"saving || !newAlert.title || !newAlert.message\" aria-label=\"Save Alert\">\n                  Save Alert\n                </button>\n              </div>\n            </div>\n\n          <div class=\"items-list\">\n\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"alerts as alert\" data-cwl-each-item=\"alert\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22list-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-icon%22%3E%7BgetAlertTypeIcon(alert.type)%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-content%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7Balert.title%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20%7BgetAlertStatusBadge(alert.status)%7D%22%3E%7Balert.status%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22item-description%22%3E%7Balert.message%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-icon%22%20data-cwl-action%3D%22editAlert%22%20data-cwl-action-args%3D%22alert%22%20title%3D%22Edit%22%3E%E2%9C%8F%EF%B8%8F%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-icon%20danger%22%20data-cwl-action%3D%22deleteAlert%22%20data-cwl-action-args%3D%22alert._id%20%7C%7C%20''%22%20title%3D%22Delete%22%3E%F0%9F%97%91%EF%B8%8F%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"list-item\">\n                  <div class=\"item-icon\"></div>\n                  <div class=\"item-content\">\n                    <div class=\"item-header\">\n                      <h4></h4>\n                      <span class=\"status-badge \"></span>\n                    </div>\n                    <p class=\"item-description\"></p>\n                  </div>\n                  <div class=\"item-actions\">\n                    <button class=\"btn-icon\" data-cwl-action=\"editAlert\" data-cwl-action-args=\"alert\" title=\"Edit\">✏️</button>\n                    <button class=\"btn-icon danger\" data-cwl-action=\"deleteAlert\" data-cwl-action-args=\"alert._id || ''\" title=\"Delete\">🗑️</button>\n                  </div>\n                </div></div>\n\n              <div class=\"empty-state\" hidden aria-hidden=\"true\">\n                <p>No alerts yet. Create one to notify your customers.</p>\n              </div>\n\n          </div>\n        </div>\n      </div>\n\n      <!-- FAQ Tab -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentTab === 'faq'\" hidden aria-hidden=\"true\">\n        <div class=\"content-section\">\n          <div class=\"section-header\">\n            <div>\n              <h2>FAQ Management</h2>\n              <p class=\"section-description\">Create and manage frequently asked questions.</p>\n            </div>\n            <button class=\"btn-primary\" data-cwl-toggle=\"showFAQForm:true\" aria-label=\"Show FAQForm\">\n              + New FAQ\n            </button>\n          </div>\n\n            <div class=\"form-card\" data-cwl-shell-key=\"showFAQForm\" hidden aria-hidden=\"true\">\n              <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingFAQId ? 'Edit FAQ' : 'Create New FAQ'\"></span></h3>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group full-width\">\n                  <label>Question</label>\n                  <input type=\"text\" placeholder=\"What is your question?\" class=\"form-input\" />\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Category</label>\n                  <select class=\"form-input\">\n\n                      <option value=\"General\">General</option>\n\n                      <option value=\"Billing\">Billing</option>\n\n                      <option value=\"Technical\">Technical</option>\n\n                      <option value=\"Account\">Account</option>\n\n                      <option value=\"Service\">Service</option>\n\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label class=\"checkbox-label inline\">\n                    <input type=\"checkbox\" />\n                    <span>Published</span>\n                  </label>\n                </div>\n\n                <div class=\"form-group full-width\">\n                  <label>Answer</label>\n                  <textarea placeholder=\"Provide the answer...\" class=\"form-input\" rows=\"4\"></textarea>\n                </div>\n              </div>\n\n              <div class=\"form-actions\">\n                <button class=\"btn-secondary\" data-cwl-toggle=\"showFAQForm:false\" aria-label=\"Show FAQForm\">Cancel</button>\n                <button class=\"btn-primary\" data-cwl-action=\"saveFAQ\" data-cwl-attr-disabled=\"saving || !newFAQ.question || !newFAQ.answer\" aria-label=\"Save FAQ\">\n                  Save FAQ\n                </button>\n              </div>\n            </div>\n\n          <div class=\"items-list\">\n\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"faqItems as faq\" data-cwl-each-item=\"faq\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22list-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-icon%22%3E%E2%9D%93%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-content%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7Bfaq.question%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22category-badge%22%3E%7Bfaq.category%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20!faq.published%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-draft%22%3EDraft%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22item-description%22%3E%7Bfaq.answer.substring(0%2C%20150)%7D...%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-icon%22%20data-cwl-action%3D%22editFAQ%22%20data-cwl-action-args%3D%22faq%22%20title%3D%22Edit%22%3E%E2%9C%8F%EF%B8%8F%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-icon%20danger%22%20data-cwl-action%3D%22deleteFAQ%22%20data-cwl-action-args%3D%22faq._id%20%7C%7C%20''%22%20title%3D%22Delete%22%3E%F0%9F%97%91%EF%B8%8F%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"list-item\">\n                  <div class=\"item-icon\">❓</div>\n                  <div class=\"item-content\">\n                    <div class=\"item-header\">\n                      <h4></h4>\n                      <span class=\"category-badge\"></span>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!faq.published\"><span class=\"status-badge status-draft\">Draft</span></div>\n                    </div>\n                    <p class=\"item-description\">...</p>\n                  </div>\n                  <div class=\"item-actions\">\n                    <button class=\"btn-icon\" data-cwl-action=\"editFAQ\" data-cwl-action-args=\"faq\" title=\"Edit\">✏️</button>\n                    <button class=\"btn-icon danger\" data-cwl-action=\"deleteFAQ\" data-cwl-action-args=\"faq._id || ''\" title=\"Delete\">🗑️</button>\n                  </div>\n                </div></div>\n\n              <div class=\"empty-state\" hidden aria-hidden=\"true\">\n                <p>No FAQs yet. Create some to help your customers.</p>\n              </div>\n\n          </div>\n        </div>\n      </div>\n\n      <!-- Knowledge Base Tab -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentTab === 'knowledge'\" hidden aria-hidden=\"true\">\n        <div class=\"content-section\">\n          <div class=\"section-header\">\n            <div>\n              <h2>Knowledge Base</h2>\n              <p class=\"section-description\">Create help articles and documentation for customers.</p>\n            </div>\n            <button class=\"btn-primary\" data-cwl-toggle=\"showArticleForm:true\" aria-label=\"Show Article Form\">\n              + New Article\n            </button>\n          </div>\n\n            <div class=\"form-card\" data-cwl-shell-key=\"showArticleForm\" hidden aria-hidden=\"true\">\n              <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingArticleId ? 'Edit Article' : 'Create New Article'\"></span></h3>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group full-width\">\n                  <label>Title</label>\n                  <input type=\"text\" placeholder=\"Article title\" class=\"form-input\" />\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Category</label>\n                  <select class=\"form-input\">\n                    <option value=\"Getting Started\">Getting Started</option>\n                    <option value=\"Account\">Account</option>\n                    <option value=\"Billing\">Billing</option>\n                    <option value=\"Technical\">Technical</option>\n                    <option value=\"Troubleshooting\">Troubleshooting</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label class=\"checkbox-label inline\">\n                    <input type=\"checkbox\" />\n                    <span>Published</span>\n                  </label>\n                </div>\n\n                <div class=\"form-group full-width\">\n                  <label>Tags</label>\n                  <div class=\"tags-input\">\n                    <input type=\"text\" placeholder=\"Add tags (comma separated)\" class=\"form-input\" data-cwl-on-keypress=\"action:addTag\" />\n                    <button class=\"btn-secondary btn-sm\" data-cwl-action=\"addTag\" aria-label=\"Add Tag\">Add</button>\n                  </div>\n                  <div class=\"tags-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"newArticle.tags as tag\"><span class=\"tag\"> <button data-cwl-action=\"removeTag\" data-cwl-action-args=\"tag\" aria-label=\"Remove Tag\">×</button></span></div>\n                  </div>\n                </div>\n\n                <div class=\"form-group full-width\">\n                  <label>Content</label>\n                  <textarea placeholder=\"Write your article content...\" class=\"form-input\" rows=\"8\"></textarea>\n                </div>\n              </div>\n\n              <div class=\"form-actions\">\n                <button class=\"btn-secondary\" data-cwl-toggle=\"showArticleForm:false\" aria-label=\"Show Article Form\">Cancel</button>\n                <button class=\"btn-primary\" data-cwl-action=\"saveArticle\" data-cwl-attr-disabled=\"saving || !newArticle.title || !newArticle.content\" aria-label=\"Save Article\">\n                  Save Article\n                </button>\n              </div>\n            </div>\n\n          <div class=\"items-list\">\n\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"kbArticles as article\" data-cwl-each-item=\"article\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22list-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-icon%22%3E%F0%9F%93%84%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-content%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7Barticle.title%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22category-badge%22%3E%7Barticle.category%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20!article.published%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-draft%22%3EDraft%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22item-description%22%3E%7Barticle.content.substring(0%2C%20150)%7D...%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20article.tags%3F.length%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tags-list%20small%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20article.tags%20as%20tag%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22tag%22%3E%7Btag%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-icon%22%20data-cwl-action%3D%22editArticle%22%20data-cwl-action-args%3D%22article%22%20title%3D%22Edit%22%3E%E2%9C%8F%EF%B8%8F%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-icon%20danger%22%20data-cwl-action%3D%22deleteArticle%22%20data-cwl-action-args%3D%22article._id%20%7C%7C%20''%22%20title%3D%22Delete%22%3E%F0%9F%97%91%EF%B8%8F%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"list-item\">\n                  <div class=\"item-icon\">📄</div>\n                  <div class=\"item-content\">\n                    <div class=\"item-header\">\n                      <h4></h4>\n                      <span class=\"category-badge\"></span>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!article.published\"><span class=\"status-badge status-draft\">Draft</span></div>\n                    </div>\n                    <p class=\"item-description\">...</p>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"article.tags?.length\"><div class=\"tags-list small\">\n                        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"article.tags as tag\"><span class=\"tag\"></span></div>\n                      </div></div>\n                  </div>\n                  <div class=\"item-actions\">\n                    <button class=\"btn-icon\" data-cwl-action=\"editArticle\" data-cwl-action-args=\"article\" title=\"Edit\">✏️</button>\n                    <button class=\"btn-icon danger\" data-cwl-action=\"deleteArticle\" data-cwl-action-args=\"article._id || ''\" title=\"Delete\">🗑️</button>\n                  </div>\n                </div></div>\n\n              <div class=\"empty-state\" hidden aria-hidden=\"true\">\n                <p>No articles yet. Create documentation to help your customers.</p>\n              </div>\n\n          </div>\n        </div>\n      </div>\n\n      <!-- Live Chat Tab -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentTab === 'chat'\" hidden aria-hidden=\"true\">\n        <div class=\"content-section\">\n          <h2>Live Chat Settings</h2>\n          <p class=\"section-description\">Configure real-time chat support for your customers.</p>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group full-width\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">Enable Live Chat</span>\n                  <span class=\"toggle-description\">Show chat widget on customer portal</span>\n                </div>\n              </label>\n            </div>\n\n            <div class=\"form-group full-width\">\n              <label>Welcome Message</label>\n              <textarea placeholder=\"Hello! How can we help?\" class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n\n            <div class=\"form-group full-width\">\n              <label>Offline Message</label>\n              <textarea placeholder=\"We're offline, leave a message...\" class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n\n            <div class=\"form-group full-width\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Set Operating Hours</span>\n              </label>\n            </div>\n\n              <div class=\"form-group\" hidden aria-hidden=\"true\">\n                <label>Start Time</label>\n                <input type=\"time\" class=\"form-input\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>End Time</label>\n                <input type=\"time\" class=\"form-input\" />\n              </div>\n\n            <div class=\"form-group full-width\">\n              <h4>Auto Responses</h4>\n            </div>\n\n            <div class=\"form-group full-width\">\n              <label>Greeting Message</label>\n              <textarea class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n\n            <div class=\"form-group full-width\">\n              <label>Away Message</label>\n              <textarea class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n\n            <div class=\"form-group full-width\">\n              <label>Closed Message</label>\n              <textarea class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n          </div>\n\n          <div class=\"form-actions\">\n            <button class=\"btn-primary\" data-cwl-action=\"saveChatSettings\" data-cwl-attr-disabled=\"saving\" aria-label=\"Save Chat Settings\">\n              Save Chat Settings\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/customers/portal/billing"
page modules_customers_portal_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/billing" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/billing\" data-cwl-island=\"client\"><div class=\"billing-page\">\n    <h1>Billing &amp; Account</h1>\n    <p class=\"subtitle\">Your plan, billing cycle, and balance. <a href=\"/modules/customers/portal/billing/settings\" class=\"link-settings\">Billing settings</a></p>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing\"><div class=\"billing-sections\">\n\n          <section class=\"info-section\" hidden aria-hidden=\"true\">\n            <h2>Service Plan</h2>\n            <div class=\"info-card\">\n              <div class=\"info-row\">\n                <span class=\"info-label\">Plan</span>\n                <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"billing.servicePlan.planName || '—'\"></span></span>\n              </div>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.servicePlan.monthlyFee != null\"><div class=\"info-row\">\n                  <span class=\"info-label\">Monthly</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(billing.servicePlan.monthlyFee)\"></span></span>\n                </div></div>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.servicePlan.setupFee != null && billing.servicePlan.setupFee > 0\"><div class=\"info-row\">\n                  <span class=\"info-label\">Setup (one-time)</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(billing.servicePlan.setupFee)\"></span></span>\n                </div></div>\n            </div>\n          </section>\n\n          <section class=\"info-section\" hidden aria-hidden=\"true\">\n            <h2>Billing Cycle</h2>\n            <div class=\"info-card\">\n              <div class=\"info-row\">\n                <span class=\"info-label\">Cycle</span>\n                <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"billing.billingCycle.type || '—'\"></span></span>\n              </div>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.billingCycle.dayOfMonth != null\"><div class=\"info-row\">\n                  <span class=\"info-label\">Billing day</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"billing.billingCycle.dayOfMonth\"></span></span>\n                </div></div>\n              <div class=\"info-row\">\n                <span class=\"info-label\">Next billing date</span>\n                <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDate(billing.billingCycle.nextBillingDate)\"></span></span>\n              </div>\n            </div>\n          </section>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.balance && (billing.balance.current != null || billing.balance.overdue != null)\"><section class=\"info-section\">\n            <h2>Balance</h2>\n            <div class=\"info-card\">\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.balance.current != null\"><div class=\"info-row\">\n                  <span class=\"info-label\">Current balance</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(billing.balance.current)\"></span></span>\n                </div></div>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.balance.overdue != null && billing.balance.overdue > 0\"><div class=\"info-row overdue\">\n                  <span class=\"info-label\">Overdue</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(billing.balance.overdue)\"></span></span>\n                </div></div>\n            </div>\n          </section></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.autoPay?.enabled\"><section class=\"info-section\">\n            <div class=\"info-card auto-pay-badge\">\n              <span class=\"badge\">Auto-pay enabled</span>\n            </div>\n          </section></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.balance && ((billing.balance.current ?? 0) + (billing.balance.overdue ?? 0)) > 0\"><section class=\"info-section\">\n            <h2>Pay now</h2>\n            <div class=\"info-card\">\n\n                <div data-cwl-shell-key=\"showCardForm\" hidden aria-hidden=\"true\"><div data-cwl-component=\"StripeCardForm\" data-cwl-lifted-component=\"StripeCardForm\"><div class=\"stripe-card-form\">\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mountError\"><p class=\"form-error\"></p></div>\n    <div class=\"card-mount\"></div>\n    <p class=\"card-hint\">Enter your card details. Your payment is secure.</p>\n    <button type=\"button\" class=\"btn-submit\" data-cwl-attr-disabled=\"disabled || submitting\" data-cwl-action=\"handleSubmit\" aria-label=\"Submit\">\n      <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"submitting ? 'Processing…' : 'Pay ' + amountLabel\"></span>\n    </button>\n\n</div></div>\n              </div>\n\n                <div hidden aria-hidden=\"true\"><p class=\"pay-message\"></p>\n              </div>\n            </div>\n          </section></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.invoices && billing.invoices.length > 0\"><section class=\"info-section\">\n            <h2>Invoices</h2>\n            <div class=\"info-card\">\n              <ul class=\"invoice-list\">\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"billing.invoices as inv\"><li class=\"invoice-row\">\n                    <span class=\"inv-num\"></span>\n                    <span class=\"inv-amount\"></span>\n                    <span class=\"inv-status\"></span>\n                    <span class=\"inv-due\">Due </span>\n                    <button type=\"button\" class=\"btn-view\" data-cwl-action=\"openInvoiceDetail\" data-cwl-action-args=\"inv.invoiceId\" aria-label=\"Open Invoice Detail\">View</button>\n                  </li></div>\n              </ul>\n            </div>\n          </section></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"billing.paymentHistory && billing.paymentHistory.length > 0\"><section class=\"info-section\">\n            <h2>Payment history</h2>\n            <div class=\"info-card\">\n              <ul class=\"payment-list\">\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"billing.paymentHistory.slice().reverse() as pay\"><li class=\"payment-row\">\n                    <span class=\"pay-amount\"></span>\n                    <span class=\"pay-method\"></span>\n                    <span class=\"pay-date\"></span>\n                  </li></div>\n              </ul>\n            </div>\n          </section></div>\n      </div></div>\n      <div class=\"empty-state\">\n        <p>No billing record is set up for your account yet.</p>\n        <p class=\"hint\">Your provider may add a plan later, or you can contact support for details.</p>\n      </div>\n\n      <div class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Invoice detail\" data-cwl-toggle=\"showInvoiceModal:false\" data-cwl-on-keydown=\"toggle:showInvoiceModal:false\" data-cwl-shell-key=\"showInvoiceModal\" hidden aria-hidden=\"true\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h2>Invoice detail</h2>\n            <button type=\"button\" class=\"modal-close\" data-cwl-toggle=\"showInvoiceModal:false\" aria-label=\"Close\">&times;</button>\n          </div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedInvoice\"><div class=\"invoice-detail\">\n              <div class=\"detail-row\"><span class=\"label\">Invoice</span><span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedInvoice.invoiceNumber\"></span></span></div>\n              <div class=\"detail-row\"><span class=\"label\">Amount</span><span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCurrency(selectedInvoice.amount)\"></span></span></div>\n              <div class=\"detail-row\"><span class=\"label\">Status</span><span class=\"status\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedInvoice.status\"></span></span></div>\n              <div class=\"detail-row\"><span class=\"label\">Due date</span><span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDate(selectedInvoice.dueDate)\"></span></span></div>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedInvoice.lineItems && selectedInvoice.lineItems.length > 0\"><h3>Line items</h3>\n                <ul class=\"line-items\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"selectedInvoice.lineItems as item\"><li> —  ×  = </li></div>\n                </ul></div>\n            </div></div>\n        </div>\n      </div>\n\n  </div>\n\n  <div class=\"error\" hidden aria-hidden=\"true\"></div></div>";
}

@page GET "/modules/customers/portal/billing/settings"
page modules_customers_portal_billing_settings_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/billing/settings" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/billing/settings\" data-cwl-island=\"client\"><div class=\"billing-settings-page\">\n    <h1>Billing settings</h1>\n    <p class=\"subtitle\">Payment method and invoice preferences</p>\n\n      <div class=\"message error\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"message success\" hidden aria-hidden=\"true\"></div>\n\n    <form data-cwl-on-submit=\"action:handleSave\" class=\"settings-form\">\n\n      <section class=\"settings-section\">\n        <h2>Invoice delivery</h2>\n        <p class=\"hint\">How you want to receive invoices.</p>\n        <label>\n          <input type=\"radio\" value=\"email\" />\n          Email only\n        </label>\n        <label>\n          <input type=\"radio\" value=\"portal\" />\n          Portal only (view in Billing page)\n        </label>\n        <label>\n          <input type=\"radio\" value=\"both\" />\n          Both email and portal\n        </label>\n      </section>\n\n      <section class=\"settings-section read-only\">\n        <h2>Invoice format</h2>\n        <p class=\"hint\">Set by your provider (read-only).</p>\n        <div class=\"info-rows\">\n          <div class=\"info-row\">\n            <span class=\"label\">Company name</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"invoiceFormat.companyName || '—'\"></span></span>\n          </div>\n          <div class=\"info-row\">\n            <span class=\"label\">Payment due (days)</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"invoiceFormat.dueDays\"></span></span>\n          </div>\n          <div class=\"info-row\">\n            <span class=\"label\">Currency</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"invoiceFormat.currency\"></span></span>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"actions\">\n        <button type=\"submit\" class=\"btn-primary\" data-cwl-attr-disabled=\"saving\">\n          Save settings\n        </button>\n        <a href=\"/modules/customers/portal/billing\" class=\"btn-secondary\">Back to Billing</a>\n      </div>\n    </form>\n  </div></div>";
}

@page GET "/modules/customers/portal/dashboard"
page modules_customers_portal_dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/dashboard" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/dashboard\" data-cwl-island=\"client\"><div class=\"dashboard\">\n    <div class=\"dashboard-header\">\n      <h1>Welcome, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"customer?.firstName || 'Customer'\"></span>!</h1>\n      <p class=\"subtitle\">Manage your tickets and view your service information</p>\n    </div>\n\n    <div class=\"dashboard-stats\">\n\n        <div class=\"stat-card\" hidden aria-hidden=\"true\">\n          <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.totalTickets\"></span></div>\n          <div class=\"stat-label\">Total Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.openTickets\"></span></div>\n          <div class=\"stat-label\">Open Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.resolvedTickets\"></span></div>\n          <div class=\"stat-label\">Resolved</div>\n        </div>\n\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo?.serviceStatus || 'N/A'\"></span></div>\n        <div class=\"stat-label\">Service Status</div>\n      </div>\n    </div>\n\n      <div class=\"dashboard-actions\" hidden aria-hidden=\"true\">\n        <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n          Create New Ticket\n        </a>\n        <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">\n          View All Tickets\n        </a>\n      </div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"featureFlags.faq || featureFlags.serviceStatus || featureFlags.billing || featureFlags.tickets || featureFlags.knowledge\"><div class=\"support-tools\">\n\n          <div class=\"support-card\" hidden aria-hidden=\"true\">\n            <h3>Billing &amp; Account</h3>\n            <p>View your plan, billing cycle, balance, and next billing date.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/billing\">View Billing</a>\n            <a class=\"support-link secondary\" href=\"/modules/customers/portal/billing/settings\">Billing settings</a>\n          </div>\n\n          <div class=\"support-card\" hidden aria-hidden=\"true\">\n            <h3>Service Status &amp; Outages</h3>\n            <p>Check real-time service health, scheduled maintenance, and network alerts.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/service\">View Status</a>\n          </div>\n\n          <div class=\"support-card\" hidden aria-hidden=\"true\">\n            <h3>FAQ &amp; Help Center</h3>\n            <p>Browse answers to the most common account, billing, and technical questions.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/faq\">Visit FAQ</a>\n          </div>\n\n          <div class=\"support-card\" hidden aria-hidden=\"true\">\n            <h3>Knowledge Base</h3>\n            <p>Step-by-step guides and tutorials curated by <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$portalBranding?.company?.displayName || 'our team'\"></span>.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/knowledge\">Browse Articles</a>\n          </div>\n\n          <div class=\"support-card\" hidden aria-hidden=\"true\">\n            <h3>Live Chat Support</h3>\n            <p>Connect with a support specialist for hands-on troubleshooting.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/live-chat\">Start Chat</a>\n          </div>\n\n      </div></div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"featureFlags.tickets && tickets.length > 0\"><div class=\"recent-tickets\">\n        <h2>Recent Tickets</h2>\n        <div class=\"tickets-list\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"tickets.slice(0, 5) as ticket\"><div class=\"ticket-card\">\n              <div class=\"ticket-header\">\n                <span class=\"ticket-number\"></span>\n                <span\n                  class=\"ticket-status\"\n                  style=\"background: \"\n                >\n\n                </span>\n              </div>\n              <h3 class=\"ticket-title\"></h3>\n              <p class=\"ticket-description\"></p>\n              <div class=\"ticket-meta\">\n                <span>Priority: </span>\n                <span>Created: </span>\n              </div>\n            </div></div>\n        </div>\n      </div></div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"serviceInfo\"><div class=\"service-info\">\n        <h2>Service Information</h2>\n        <div class=\"info-card\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Service Status:</span>\n            <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceStatus || 'N/A'\"></span></span>\n          </div>\n\n            <div class=\"info-row\" hidden aria-hidden=\"true\">\n              <span class=\"info-label\">Service Plan:</span>\n              <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.servicePlan\"></span></span>\n            </div>\n\n            <div class=\"info-row\" hidden aria-hidden=\"true\">\n              <span class=\"info-label\">Service Address:</span>\n              <span class=\"info-value\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.street || ''\"></span>\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.city || ''\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.state || ''\"></span> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.zipCode || ''\"></span>\n              </span>\n            </div>\n\n        </div>\n      </div></div>\n  </div>\n\n  <div class=\"error\" hidden aria-hidden=\"true\"></div></div>";
}

@page GET "/modules/customers/portal/faq"
page modules_customers_portal_faq_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/faq" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/faq\" data-cwl-island=\"client\"><div class=\"faq-page\">\n    <h1>Our team Help Center</h1>\n    <p class=\"subtitle\">Quick answers to the most common questions from subscribers.</p>\n    <input\n      type=\"search\"\n      class=\"faq-search\"\n      placeholder=\"Search FAQ…\"\n      aria-label=\"Search FAQ\"\n    />\n    <div class=\"faq-list\">\n      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"displayFaqs as faq\" data-cwl-each-item=\"faq\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%3Cdetails%20class%3D%22faq-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%3Csummary%3E%7Bfaq.question%7D%3C%2Fsummary%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cp%3E%7Bfaq.answer%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdetails%3E%0A%20%20%20%20%20%20\"><details class=\"faq-item\">\n          <summary></summary>\n          <p></p>\n        </details></div>\n    </div>\n\n    <div class=\"contact-card\">\n      <h2>Still need help?</h2>\n      <p>Open a support ticket from the dashboard or contact our team directly.</p>\n      <div class=\"contact-links\">\n        <a class=\"btn-link\">Email Support</a>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"supportPhone\"><a class=\"btn-link\">Call </a></div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/customers/portal/knowledge"
page modules_customers_portal_knowledge_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/knowledge" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/knowledge\" data-cwl-island=\"client\"><div class=\"feature-disabled\">\n    <p class=\"back-link\"><a href=\"/modules/customers/portal/dashboard\">← Back to Dashboard</a></p>\n    <h1>Knowledge Base Unavailable</h1>\n    <p>This tenant has not enabled the Knowledge Base module. For guidance, please contact <a>support@example.com</a>.</p>\n  </div></div>";
}

@page GET "/modules/customers/portal/knowledge/:id"
page modules_customers_portal_knowledge_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/knowledge/:id" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/knowledge/:id\" data-cwl-island=\"client\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"error || !article\"><div class=\"error\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"error || 'Article not found'\"></span></div>\n  <a href=\"/modules/customers/portal/knowledge\" class=\"back-link\">← Back to Knowledge Base</a></div>\n  <article class=\"article-page\">\n    <a href=\"/modules/customers/portal/knowledge\" class=\"back-link\">← Back to Knowledge Base</a>\n    <header>\n      <h1><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"article.title\"></span></h1>\n      <div hidden aria-hidden=\"true\"><span class=\"category\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"article.category\"></span></span></div>\n    </header>\n    <div class=\"content\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"article.content || ''\"></span></div>\n  </article></div>";
}

@page GET "/modules/customers/portal/live-chat"
page modules_customers_portal_live_chat_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/live-chat" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/live-chat\" data-cwl-island=\"client\"><div class=\"feature-disabled\">\n    <h1>Live Chat Unavailable</h1>\n    <p>This tenant currently handles conversations via email or phone.</p>\n    <p class=\"contact\">\n      Email: <a></a>\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"supportPhone\"><br />\n        Phone: <a></a></div>\n    </p>\n  </div></div>";
}

@page GET "/modules/customers/portal/login"
page modules_customers_portal_login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/login" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/login\" data-cwl-island=\"client\"><div class=\"login-page\">\n  <div class=\"login-container\">\n    <div class=\"login-header\">\n\n        <h1><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"branding?.company?.displayName || branding?.company?.name || 'Customer Portal'\"></span></h1>\n\n        <div hidden aria-hidden=\"true\"><img class=\"login-logo\" />\n      </div>\n      <h2>Sign In</h2>\n      <p class=\"login-subtitle\">Access your account to view tickets and service information</p>\n    </div>\n\n      <form data-cwl-on-submit=\"action:handleLogin\" class=\"login-form\">\n\n        <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"form-group\">\n        <label for=\"identifier\">Customer ID, Email, or Phone</label>\n        <input\n          id=\"identifier\"\n          type=\"text\"\n          placeholder=\"Enter your customer ID, email, or phone\"\n          required data-cwl-attr-disabled=\"loading\"\n        />\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"password\">Password</label>\n        <input\n          id=\"password\"\n          type=\"password\"\n          placeholder=\"Enter your password\"\n          required data-cwl-attr-disabled=\"loading\"\n        />\n      </div>\n\n      <button type=\"submit\" class=\"btn-primary\" data-cwl-attr-disabled=\"loading\">\n        Sign In\n      </button>\n    </form>\n    <div class=\"login-links\">\n\n        <div class=\"forgot-section\" data-cwl-shell-key=\"showForgotPassword\" hidden aria-hidden=\"true\">\n          <h3 class=\"forgot-title\">Reset password</h3>\n          <p class=\"forgot-desc\">Enter the email for your account and we'll send a reset link.</p>\n\n            <form data-cwl-on-submit=\"action:handleForgotSubmit\" class=\"forgot-form\">\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"forgotError\"><div class=\"error-message\"></div></div>\n              <div class=\"form-group\">\n                <label for=\"forgot-email\">Email</label>\n                <input id=\"forgot-email\" type=\"email\" placeholder=\"Your account email\" required data-cwl-attr-disabled=\"loading\" />\n              </div>\n              <div class=\"forgot-actions\">\n                <button type=\"submit\" class=\"btn-primary\" data-cwl-attr-disabled=\"loading\">Send reset link</button>\n                <button type=\"button\" class=\"link\" data-cwl-attr-disabled=\"loading\" data-cwl-set=\"forgotEmail:\">Cancel</button>\n              </div>\n            </form>\n\n        </div>\n\n    </div>\n  </div>\n</div></div>";
}

@page GET "/modules/customers/portal/service"
page modules_customers_portal_service_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/service" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/service\" data-cwl-island=\"client\"><div class=\"service-page\">\n    <p class=\"back-link\"><a href=\"/modules/customers/portal/dashboard\">← Back to Dashboard</a></p>\n    <h1>Service Information</h1>\n\n    <div class=\"service-details\">\n      <div class=\"info-section\">\n        <h2>Service Status</h2>\n        <div class=\"info-card\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Status:</span>\n            <span class=\"info-value status-\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo?.serviceStatus || 'N/A'\"></span>\n            </span>\n          </div>\n\n            <div class=\"info-row\" hidden aria-hidden=\"true\">\n              <span class=\"info-label\">Service Plan:</span>\n              <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.servicePlan\"></span></span>\n            </div>\n\n        </div>\n      </div>\n\n        <div class=\"info-section\" hidden aria-hidden=\"true\">\n          <h2>Service Address</h2>\n          <div class=\"info-card\">\n            <div class=\"info-row\">\n              <span class=\"info-label\">Address:</span>\n              <span class=\"info-value\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.street || ''\"></span>\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.city || ''\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.state || ''\"></span> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"serviceInfo.serviceAddress.zipCode || ''\"></span>\n              </span>\n            </div>\n          </div>\n        </div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"serviceInfo?.equipment && serviceInfo.equipment.length > 0\"><div class=\"info-section\">\n          <h2>Equipment</h2>\n          <div class=\"equipment-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"serviceInfo.equipment as equipment\"><div class=\"equipment-card\">\n                <div class=\"equipment-header\">\n                  <span class=\"equipment-type\"></span>\n\n                    <div hidden aria-hidden=\"true\"><span class=\"equipment-serial\">SN: </span>\n                  </div>\n                </div>\n\n                  <div class=\"equipment-detail\" hidden aria-hidden=\"true\">Model: </div>\n\n                  <div class=\"equipment-detail\" hidden aria-hidden=\"true\">\n                    Installed:\n                  </div>\n\n              </div></div>\n          </div>\n        </div></div>\n    </div>\n  </div>\n\n  <div class=\"error\" hidden aria-hidden=\"true\"></div></div>";
}

@page GET "/modules/customers/portal/signup"
page modules_customers_portal_signup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/signup" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/signup\" data-cwl-island=\"client\"><div class=\"signup-page\">\n  <div class=\"signup-container\">\n    <div class=\"signup-header\">\n\n        <h1><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"branding?.company?.displayName || branding?.company?.name || 'Customer Portal'\"></span></h1>\n\n        <div hidden aria-hidden=\"true\"><img class=\"signup-logo\" />\n      </div>\n      <h2>Create Account</h2>\n      <p class=\"signup-subtitle\">Link your customer account to access the portal</p>\n    </div>\n\n      <form data-cwl-on-submit=\"action:handleSignup\" class=\"signup-form\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"form-group\">\n          <label for=\"customerId\">Customer ID</label>\n          <input\n            id=\"customerId\"\n            type=\"text\"\n            placeholder=\"Enter your customer ID\"\n            required data-cwl-attr-disabled=\"loading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"phone\">Phone Number</label>\n          <input\n            id=\"phone\"\n            type=\"tel\"\n            placeholder=\"Enter your phone number\"\n            required data-cwl-attr-disabled=\"loading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"Enter your email\"\n            required data-cwl-attr-disabled=\"loading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"password\">Password</label>\n          <input\n            id=\"password\"\n            type=\"password\"\n            placeholder=\"Create a password (min 6 characters)\"\n            required\n            minlength=\"6\" data-cwl-attr-disabled=\"loading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"confirmPassword\">Confirm Password</label>\n          <input\n            id=\"confirmPassword\"\n            type=\"password\"\n            placeholder=\"Confirm your password\"\n            required data-cwl-attr-disabled=\"loading\"\n          />\n        </div>\n\n        <button type=\"submit\" class=\"btn-primary\" data-cwl-attr-disabled=\"loading\">\n          Create Account\n        </button>\n\n        <div class=\"signup-links\">\n          <a href=\"/modules/customers/portal/login\" class=\"link\">Already have an account? Sign in</a>\n        </div>\n      </form>\n\n      <div class=\"success-message\" hidden aria-hidden=\"true\">\n        <p>Account created successfully! Redirecting...</p>\n      </div>\n\n  </div>\n</div></div>";
}

@page GET "/modules/customers/portal/tickets"
page modules_customers_portal_tickets_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/tickets" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/tickets\" data-cwl-island=\"client\"><div class=\"tickets-page\">\n  <div class=\"page-header\">\n    <h1>My Tickets</h1>\n    <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n      Create New Ticket\n    </a>\n  </div>\n\n  <div class=\"filters\">\n    <select class=\"filter-select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"open\">Open</option>\n      <option value=\"assigned\">Assigned</option>\n      <option value=\"in-progress\">In Progress</option>\n      <option value=\"waiting-parts\">Waiting Parts</option>\n      <option value=\"resolved\">Resolved</option>\n      <option value=\"closed\">Closed</option>\n    </select>\n  </div>\n\n    <div class=\"tickets-list\">\n      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredTickets as ticket\" data-cwl-each-item=\"ticket\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%3Cdiv%20%0A%20%20%20%20%20%20%20%20%20%20class%3D%22ticket-card%22%20data-cwl-nav%3D%22%2Fmodules%2Fcustomers%2Fportal%2Ftickets%2F%7Bticket._id%7D%22%0A%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22ticket-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22ticket-number%22%3E%7Bticket.ticketNumber%20%7C%7C%20'N%2FA'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22ticket-status%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20style%3D%22background%3A%20%7BgetStatusColor(ticket.status)%7D%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bticket.status%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3Ch3%20class%3D%22ticket-title%22%3E%7Bticket.title%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22ticket-description%22%3E%7Bticket.description%20%7C%7C%20'No%20description'%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22ticket-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EPriority%3A%20%7Bticket.priority%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3ECreated%3A%20%7Bnew%20Date(ticket.createdAt%20%7C%7C%20'').toLocaleDateString()%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20ticket.resolvedAt%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EResolved%3A%20%7Bnew%20Date(ticket.resolvedAt).toLocaleDateString()%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20\"><div\n          class=\"ticket-card\"\n        >\n          <div class=\"ticket-header\">\n            <span class=\"ticket-number\"></span>\n            <span\n              class=\"ticket-status\"\n              style=\"background: \"\n            >\n\n            </span>\n          </div>\n          <h3 class=\"ticket-title\"></h3>\n          <p class=\"ticket-description\"></p>\n          <div class=\"ticket-meta\">\n            <span>Priority: </span>\n            <span>Created: </span>\n\n              <div hidden aria-hidden=\"true\"><span>Resolved: </span>\n            </div>\n          </div>\n        </div></div>\n    </div>\n\n    <div class=\"empty-state\" hidden aria-hidden=\"true\">\n      <p>No tickets found.</p>\n      <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n        Create Your First Ticket\n      </a>\n    </div>\n\n    <div class=\"error\" hidden aria-hidden=\"true\"></div>\n\n</div></div>";
}

@page GET "/modules/customers/portal/tickets/:id"
page modules_customers_portal_tickets_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/tickets/:id" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/tickets/:id\" data-cwl-island=\"client\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!ticket\"><div class=\"error\">Ticket not found</div></div>\n  <div class=\"ticket-details-page\">\n    <div class=\"page-header\">\n      <a href=\"/modules/customers/portal/tickets\" class=\"back-link\">← Back to Tickets</a>\n      <h1>Ticket Details</h1>\n    </div>\n\n    <div class=\"ticket-details\">\n      <div class=\"ticket-header\">\n        <div>\n          <span class=\"ticket-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ticket.ticketNumber || 'N/A'\"></span></span>\n          <span\n            class=\"ticket-status\"\n            style=\"background:\"\n          >\n            <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ticket.status\"></span>\n          </span>\n        </div>\n        <div class=\"ticket-meta\">\n          <span>Priority: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ticket.priority\"></span></span>\n          <span>Created: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"new Date(ticket.createdAt || '').toLocaleDateString()\"></span></span>\n        </div>\n      </div>\n\n      <div class=\"ticket-content\">\n        <h2><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ticket.title\"></span></h2>\n        <p class=\"ticket-description\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ticket.description || 'No description'\"></span></p>\n      </div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"ticket.workPerformed && ticket.workPerformed.length > 0\"><div class=\"ticket-history\">\n          <h3>Ticket History</h3>\n          <div class=\"history-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"ticket.workPerformed as work\"><div class=\"history-item\">\n                <div class=\"history-header\">\n                  <span class=\"history-action\"></span>\n                  <span class=\"history-date\">\n\n                  </span>\n                </div>\n\n                  <div class=\"history-performer\" hidden aria-hidden=\"true\">\n                    By:\n                  </div>\n\n                  <div class=\"history-notes\" hidden aria-hidden=\"true\"></div>\n\n              </div></div>\n          </div>\n        </div></div>\n\n      <div class=\"add-comment\">\n        <h3>Add Comment</h3>\n        <form data-cwl-on-submit=\"action:handleAddComment\">\n          <textarea\n            placeholder=\"Add a comment or update...\"\n            rows=\"4\" data-cwl-attr-disabled=\"submittingComment\"\n          ></textarea>\n          <button type=\"submit\" class=\"btn-primary\" data-cwl-attr-disabled=\"submittingComment || !comment.trim()\">\n            Add Comment\n          </button>\n        </form>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"error\" hidden aria-hidden=\"true\"></div></div>";
}

@page GET "/modules/customers/portal/tickets/new"
page modules_customers_portal_tickets_new_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/customers/portal/tickets/new" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"customers\" data-wisp-path=\"/modules/customers/portal/tickets/new\" data-cwl-island=\"client\"><div class=\"create-ticket-page\">\n  <div class=\"page-header\">\n    <h1>Create New Ticket</h1>\n    <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Back to Tickets</a>\n  </div>\n\n  <form data-cwl-on-submit=\"action:handleSubmit\" class=\"ticket-form\">\n\n      <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"form-group\">\n      <label for=\"title\">Title *</label>\n      <input\n        id=\"title\"\n        type=\"text\"\n        placeholder=\"Brief description of the issue\"\n        required data-cwl-attr-disabled=\"loading\"\n      />\n    </div>\n\n    <div class=\"form-group\">\n      <label for=\"category\">Category</label>\n      <select id=\"category\" data-cwl-attr-disabled=\"loading\">\n        <option value=\"slow-speed\">Slow Speed</option>\n        <option value=\"no-connection\">No Connection</option>\n        <option value=\"intermittent\">Intermittent Connection</option>\n        <option value=\"equipment-failure\">Equipment Failure</option>\n        <option value=\"billing-issue\">Billing Issue</option>\n        <option value=\"other\">Other</option>\n      </select>\n    </div>\n\n    <div class=\"form-group\">\n      <label for=\"priority\">Priority</label>\n      <select id=\"priority\" data-cwl-attr-disabled=\"loading\">\n        <option value=\"low\">Low</option>\n        <option value=\"medium\">Medium</option>\n        <option value=\"high\">High</option>\n        <option value=\"critical\">Critical</option>\n      </select>\n    </div>\n\n    <div class=\"form-group\">\n      <label for=\"description\">Description *</label>\n      <textarea\n        id=\"description\"\n        placeholder=\"Please provide detailed information about the issue...\"\n        rows=\"6\"\n        required data-cwl-attr-disabled=\"loading\"\n      ></textarea>\n    </div>\n\n    <div class=\"form-actions\">\n      <button type=\"submit\" class=\"btn-primary\" data-cwl-attr-disabled=\"loading\">\n        Create Ticket\n      </button>\n      <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Cancel</a>\n    </div>\n  </form>\n</div></div>";
}

@page GET "/modules/deploy"
page modules_deploy_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "deploy" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"deploy\" data-wisp-path=\"/modules/deploy\" data-cwl-island=\"client\"><div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      <iframe id=\"deploy-map-iframe\" class=\"plan-map-iframe\" title=\"Deploy map\" src=\"/modules/coverage-map?mode=deploy&hideStats=true&deployMode=true\" data-cwl-island=\"shared-map\" data-cwl-map-mode=\"deploy\" data-cwl-lifted-component=\"SharedMap\"></iframe>\n    </div>\n\n    <!-- Minimal Header Overlay -->\n    <!-- Deploy Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-success);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\" data-cwl-nav=\"/dashboard\" title=\"Back to Dashboard\" type=\"button\">\n          ←\n        </button>\n        <h1>🚀 Deploy</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" data-cwl-toggle=\"showHelpModal:true\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n        <button\n          class=\"module-control-btn\" data-cwl-toggle=\"showProjectFilters:flip\"\n          title=\"Project Filters - Approved projects ready for deployment\"\n        >\n          <span class=\"control-icon\">🔍</span>\n          <span class=\"control-label\">Approved (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"approvedPlans.length\"></span>)</span>\n        </button>\n        <button class=\"module-control-btn\" data-cwl-toggle=\"showPlanApprovalModal:true\" title=\"Projects - View and manage all projects\">\n          <span class=\"control-icon\">📋</span>\n          <span class=\"control-label\">Projects (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"readyPlans.length\"></span>)</span>\n        </button>\n        <button\n          class=\"module-control-btn\" data-cwl-toggle=\"showDeployedHardwareModal:true\"\n          title=\"View Deployed Projects\"\n        >\n          <span class=\"control-icon\">✅</span>\n          <span class=\"control-label\">Deployed (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deployedPlans.length\"></span>)</span>\n        </button>\n        <button\n          class=\"module-control-btn\" data-cwl-toggle=\"showPCIPlannerModal:true\" data-cwl-attr-title=\"isAdmin ? `PCI Planner (Admin) - $ LTE sectors` : ($currentTenant ? `PCI Planner - $ LTE sectors` : &quot;PCI Planner (No tenant selected)&quot;)\"\n        >\n          <span class=\"control-icon\">📊</span>\n          <span class=\"control-label\">PCI <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"lteSectorCount > 0 ? `()` : ''\"></span></span>\n        </button>\n\n        <button\n          class=\"module-control-btn\" data-cwl-toggle=\"showFrequencyPlannerModal:true\" data-cwl-attr-title=\"isAdmin ? `Frequency Planner (Admin) - $ LTE/FWA sectors` : ($currentTenant ? `Frequency Planner - $ LTE/FWA sectors` : &quot;Frequency Planner (No tenant selected)&quot;)\"\n        >\n          <span class=\"control-icon\">📡</span>\n          <span class=\"control-label\">Frequency <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"frequencySectorCount > 0 ? `()` : ''\"></span></span>\n        </button>\n        <button\n          class=\"module-control-btn\" data-cwl-toggle=\"showDeployedHardwareModal:true\"\n          title=\"View and Edit Deployed Hardware\"\n        >\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Hardware (0)</span>\n        </button>\n\n        <button\n          class=\"module-control-btn deploy-btn\" data-cwl-attr-disabled=\"!mapState?.activePlan\" data-cwl-action=\"pushActivePlanToField\" data-cwl-attr-title=\"mapState?.activePlan ? `Push $ to field teams` : 'Select a plan to deploy'\"\n        >\n          <span class=\"control-icon\">🚀</span>\n          <span class=\"control-label\">Deploy Plan</span>\n        </button>\n\n        <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showModuleWizardMenu\" hidden aria-hidden=\"true\"><div class=\"module-wizard-menu\">\n    <button\n      type=\"button\"\n      class=\"wizard-trigger\" data-cwl-attr-disabled=\"disabled\" data-cwl-action=\"toggle\" data-cwl-on-blur=\"action:handleBlur\"\n      title=\"Wizards for this module\"\n      aria-haspopup=\"true\"\n    >\n      <span class=\"wizard-trigger-icon\">🧙</span>\n      <span class=\"wizard-trigger-label\">Wizards</span>\n      <span class=\"wizard-trigger-chevron\">▼</span>\n    </button>\n\n      <div class=\"wizard-dropdown\" role=\"menu\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"wizards as w\" data-cwl-each-item=\"w\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22menuitem%22%0A%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22wizard-item%22%20data-cwl-action%3D%22select%22%20data-cwl-action-args%3D%22w.id%22%0A%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20w.icon%7D%3Cspan%20class%3D%22wizard-item-icon%22%3E%7Bw.icon%7D%3C%2Fspan%3E%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22wizard-item-label%22%3E%7Bw.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20\"><button\n            type=\"button\"\n            role=\"menuitem\"\n            class=\"wizard-item\" data-cwl-action=\"select\" data-cwl-action-args=\"w.id\"\n           aria-label=\"Select\">\n            <div hidden aria-hidden=\"true\"><span class=\"wizard-item-icon\"></span></div>\n            <span class=\"wizard-item-label\"></span>\n          </button></div>\n      </div>\n\n  </div></div></div>\n      </div>\n    </div>\n\n  </div>\n\n    <div class=\"plan-summary\" hidden aria-hidden=\"true\">\n      <h3>Active Plan: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"mapState.activePlan.name\"></span></h3>\n      <p class=\"summary-line\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"mapState.stagedSummary.total\"></span> staged features • <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"mapState.productionHardware.length\"></span> production assets in view\n      </p>\n    </div>\n\n    <div class=\"deployment-toast\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"error-toast\" hidden aria-hidden=\"true\"></div>\n\n  <!-- PCI Planner Modal -->\n\n    <div data-cwl-shell-key=\"showPCIPlannerModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"PCIPlannerModal\" data-cwl-lifted-component=\"PCIPlannerModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showPCIPlannerModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content pci-planner-modal\">\n    <div class=\"modal-header\">\n      <h2>📊 PCI Planner</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"success-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n\n        <!-- Tabs -->\n        <div class=\"tabs\">\n          <button\n            class=\"tab-btn\" data-cwl-set=\"activeTab:analysis\"\n          >\n            📊 Analysis\n          </button>\n          <button\n            class=\"tab-btn\" data-cwl-set=\"activeTab:conflicts\"\n          >\n            ⚠️ Conflicts (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.length\"></span>)\n          </button>\n          <button\n            class=\"tab-btn\" data-cwl-set=\"activeTab:optimization\"\n          >\n            🔧 Optimization\n          </button>\n        </div>\n\n      <!-- Analysis Tab -->\n\n        <div class=\"tab-content\">\n          <div class=\"analysis-section\">\n            <h3>📡 Network Overview</h3>\n            <div class=\"stats-grid\">\n              <div class=\"stat-card\">\n                <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"cells.length\"></span></div>\n                <div class=\"stat-label\">Total Cells</div>\n              </div>\n              <div class=\"stat-card\">\n                <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"cells.filter(c => c.pci === -1).length\"></span></div>\n                <div class=\"stat-label\">Auto-Assign PCI</div>\n              </div>\n              <div class=\"stat-card\">\n                <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.length\"></span></div>\n                <div class=\"stat-label\">Current Conflicts</div>\n              </div>\n            </div>\n\n            <div class=\"action-buttons\">\n              <button\n                class=\"btn-primary\" data-cwl-action=\"performAnalysis\" data-cwl-attr-disabled=\"isAnalyzing || cells.length === 0\"\n               aria-label=\"Perform Analysis\">\n\n                  🔍 Analyze Conflicts\n\n              </button>\n\n              <button\n                class=\"btn-secondary\" data-cwl-toggle=\"showAdvancedOptions:flip\"\n               aria-label=\"Show Advanced Options\">\n                ⚙️ Advanced Options\n              </button>\n            </div>\n\n              <div class=\"advanced-options\" data-cwl-shell-key=\"showAdvancedOptions\" hidden aria-hidden=\"true\">\n                <h4>Advanced Configuration</h4>\n                <div class=\"form-grid\">\n                  <div class=\"form-group\">\n                    <label>\n                      <input type=\"checkbox\" />\n                      Enable Line-of-Sight Analysis\n                    </label>\n                  </div>\n                  <div class=\"form-group\">\n                    <label>Max Iterations</label>\n                    <input type=\"number\" min=\"5\" max=\"100\" />\n                  </div>\n                  <div class=\"form-group\">\n                    <label>Algorithm</label>\n                    <select>\n                      <option value=\"simple\">Simple (Fast)</option>\n                      <option value=\"advanced\">Advanced (Thorough)</option>\n                    </select>\n                  </div>\n                </div>\n              </div>\n\n          </div>\n        </div>\n\n      <!-- Conflicts Tab -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'conflicts'\" hidden aria-hidden=\"true\">\n        <div class=\"tab-content\">\n\n              <div class=\"conflicts-section\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"conflictStats\"><div class=\"conflict-stats\">\n                    <div class=\"stat-item critical\">\n                      <span class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictStats.critical\"></span></span>\n                      <span class=\"stat-label\">Critical</span>\n                    </div>\n                    <div class=\"stat-item high\">\n                      <span class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictStats.high\"></span></span>\n                      <span class=\"stat-label\">High</span>\n                    </div>\n                    <div class=\"stat-item medium\">\n                      <span class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictStats.medium\"></span></span>\n                      <span class=\"stat-label\">Medium</span>\n                    </div>\n                    <div class=\"stat-item low\">\n                      <span class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictStats.low\"></span></span>\n                      <span class=\"stat-label\">Low</span>\n                    </div>\n                  </div></div>\n\n              <div class=\"conflicts-list\">\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"conflicts as conflict\" data-cwl-each-item=\"conflict\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22conflict-item%22%20class%3Acritical%3D%7Bconflict.severity%20%3D%3D%3D%20'CRITICAL'%7D%20class%3Ahigh%3D%7Bconflict.severity%20%3D%3D%3D%20'HIGH'%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22conflict-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22severity-badge%20%7Bconflict.severity.toLowerCase()%7D%22%3E%7Bconflict.severity%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22conflict-type%22%3E%7Bconflict.conflictType%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22conflict-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22cell-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bconflict.primaryCell.name%7D%3C%2Fstrong%3E%20(PCI%3A%20%7Bconflict.primaryCell.pci%7D)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22vs%22%3Evs%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22cell-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bconflict.conflictingCell.name%7D%3C%2Fstrong%3E%20(PCI%3A%20%7Bconflict.conflictingCell.pci%7D)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22conflict-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Distance%3A%20%7Bconflict.distance.toFixed(2)%7Dm%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"conflict-item\">\n                    <div class=\"conflict-header\">\n                      <span class=\"severity-badge \"></span>\n                      <span class=\"conflict-type\"></span>\n                    </div>\n                    <div class=\"conflict-details\">\n                      <div class=\"cell-info\">\n                        <strong></strong> (PCI: )\n                      </div>\n                      <div class=\"vs\">vs</div>\n                      <div class=\"cell-info\">\n                        <strong></strong> (PCI: )\n                      </div>\n                    </div>\n                    <div class=\"conflict-meta\">\n                      Distance: m\n                    </div>\n                  </div></div>\n              </div>\n\n              <div class=\"action-buttons\">\n                <button\n                  class=\"btn-primary\" data-cwl-action=\"optimizePCIs\" data-cwl-attr-disabled=\"isOptimizing\"\n                 aria-label=\"Optimize PCIs\">\n\n                    🔧 Optimize PCIs\n\n                </button>\n              </div>\n            </div>\n\n            <div class=\"empty-state\" hidden aria-hidden=\"true\">\n              <div class=\"empty-icon\">✅</div>\n              <h3>No Conflicts Found</h3>\n              <p>Your network has no PCI conflicts!</p>\n            </div>\n\n        </div>\n      </div>\n\n      <!-- Optimization Tab -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'optimization'\" hidden aria-hidden=\"true\">\n        <div class=\"tab-content\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"optimizationResult\"><div class=\"optimization-section\">\n              <h3>🎯 Optimization Results</h3>\n\n              <div class=\"optimization-stats\">\n                <div class=\"stat-card\">\n                  <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimizationResult.changes.length\"></span></div>\n                  <div class=\"stat-label\">PCI Changes</div>\n                </div>\n                <div class=\"stat-card\">\n                  <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimizationResult.iterations\"></span></div>\n                  <div class=\"stat-label\">Iterations</div>\n                </div>\n                <div class=\"stat-card\">\n                  <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimizationResult.convergenceHistory.length\"></span></div>\n                  <div class=\"stat-label\">Convergence Steps</div>\n                </div>\n              </div>\n\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"optimizationResult.changes.length > 0\"><div class=\"changes-list\">\n                  <h4>📝 PCI Changes Made</h4>\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"optimizationResult.changes as change\"><div class=\"change-item\">\n                      <div class=\"change-cell\">\n                        <strong></strong>\n                      </div>\n                      <div class=\"change-values\">\n                        <span class=\"old-pci\"></span>\n                        <span class=\"arrow\">→</span>\n                        <span class=\"new-pci\"></span>\n                      </div>\n                    </div></div>\n                </div></div>\n\n              <div class=\"action-buttons\">\n                <button class=\"btn-secondary\" data-cwl-action=\"exportResults\" aria-label=\"Export Results\">\n                  📥 Export Results\n                </button>\n                <button class=\"btn-primary\" data-cwl-action=\"performAnalysis\" aria-label=\"Perform Analysis\">\n                  🔍 Re-analyze\n                </button>\n              </div>\n            </div></div>\n            <div class=\"empty-state\">\n              <div class=\"empty-icon\">🔧</div>\n              <h3>No Optimization Results</h3>\n              <p>Run optimization to see results here.</p>\n            </div>\n\n        </div>\n      </div>\n\n        <div class=\"loading-state\" hidden aria-hidden=\"true\">\n          <div class=\"loading-spinner\"></div>\n          <p>Loading network data...</p>\n        </div>\n\n    </div>\n  </div>\n</div></div></div>\n  </div>\n\n  <!-- Frequency Planner Modal -->\n\n    <div data-cwl-shell-key=\"showFrequencyPlannerModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"FrequencyPlannerModal\" data-cwl-lifted-component=\"FrequencyPlannerModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showFrequencyPlannerModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content frequency-planner-modal\">\n      <div class=\"modal-header\">\n        <h2>📡 Frequency Planner</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n        <div class=\"error-banner\"></div>\n\n        <div class=\"success-banner\"></div>\n\n      <div class=\"modal-body\">\n\n          <div class=\"loading-state\">\n            <div class=\"loading-spinner\"></div>\n            <p>Loading network data...</p>\n          </div>\n\n          <!-- Tabs -->\n          <div class=\"tabs\">\n            <button\n              class=\"tab-btn\" data-cwl-set=\"activeTab:analysis\"\n            >\n              📊 Analysis\n            </button>\n            <button\n              class=\"tab-btn\" data-cwl-set=\"activeTab:conflicts\"\n            >\n              ⚠️ Conflicts\n\n                <span class=\"conflict-count\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.length\"></span></span>\n\n            </button>\n            <button\n              class=\"tab-btn\" data-cwl-set=\"activeTab:optimization\"\n            >\n              🔧 Optimization\n            </button>\n          </div>\n\n          <!-- Analysis Tab -->\n\n            <div class=\"analysis-content\">\n              <div class=\"analysis-header\">\n                <h3>Frequency Analysis</h3>\n                <p>Analyze frequency conflicts and interference patterns</p>\n              </div>\n\n              <div class=\"analysis-stats\">\n                <div class=\"stat-card\">\n                  <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sectors.length\"></span></div>\n                  <div class=\"stat-label\">Total Sectors</div>\n                </div>\n                <div class=\"stat-card\">\n                  <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan?.planScore || 0\"></span></div>\n                  <div class=\"stat-label\">Plan Score</div>\n                </div>\n                <div class=\"stat-card\">\n                  <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan?.conflicts.length || 0\"></span></div>\n                  <div class=\"stat-label\">Conflicts</div>\n                </div>\n                <div class=\"stat-card\">\n                  <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan?.optimizations.length || 0\"></span></div>\n                  <div class=\"stat-label\">Suggestions</div>\n                </div>\n              </div>\n\n              <div class=\"analysis-actions\">\n                <button\n                  class=\"btn-primary\" data-cwl-action=\"performAnalysis\" data-cwl-attr-disabled=\"isAnalyzing || !sectors.length\"\n                 aria-label=\"Perform Analysis\">\n\n                    <div class=\"loading-spinner small\"></div>\n                    Analyzing...\n\n                    🔍 Analyze Conflicts\n\n                </button>\n\n                <button\n                  class=\"btn-secondary\" data-cwl-action=\"generateOptimizations\" data-cwl-attr-disabled=\"isOptimizing || !conflicts.length\"\n                 aria-label=\"Generate Optimizations\">\n\n                    <div class=\"loading-spinner small\"></div>\n                    Optimizing...\n\n                    🔧 Generate Suggestions\n\n                </button>\n\n                  <button class=\"btn-secondary\" data-cwl-action=\"exportResults\" aria-label=\"Export Results\">\n                    📥 Export Plan\n                  </button>\n\n              </div>\n\n                <div class=\"plan-summary\">\n                  <h4>Plan Summary</h4>\n                  <div class=\"summary-grid\">\n                    <div class=\"summary-item\">\n                      <strong>Total Interference:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.totalInterference.toFixed(1)\"></span> dB\n                    </div>\n                    <div class=\"summary-item\">\n                      <strong>Plan Score:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.planScore\"></span>/100\n                    </div>\n                    <div class=\"summary-item\">\n                      <strong>Status:</strong>\n                      <span>\n                        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.planScore >= 80 ? 'Excellent' : plan.planScore >= 60 ? 'Good' : 'Needs Impr\"></span>\n                      </span>\n                    </div>\n                  </div>\n                </div>\n\n            </div>\n\n          <!-- Conflicts Tab -->\n\n            <div class=\"conflicts-content\">\n              <div class=\"conflicts-header\">\n                <h3>Frequency Conflicts</h3>\n                <p>Detected interference and spacing issues</p>\n              </div>\n\n                <div class=\"no-conflicts\">\n                  <div class=\"no-conflicts-icon\">✅</div>\n                  <h4>No Conflicts Found</h4>\n                  <p>Your frequency plan looks good! No interference issues detected.</p>\n                </div>\n\n                  <div class=\"conflict-summary\">\n                    <div class=\"conflict-stat high\">\n                      <span class=\"count\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictSummary.high\"></span></span>\n                      <span class=\"label\">High Severity</span>\n                    </div>\n                    <div class=\"conflict-stat medium\">\n                      <span class=\"count\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictSummary.medium\"></span></span>\n                      <span class=\"label\">Medium Severity</span>\n                    </div>\n                    <div class=\"conflict-stat low\">\n                      <span class=\"count\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictSummary.low\"></span></span>\n                      <span class=\"label\">Low Severity</span>\n                    </div>\n                  </div>\n\n                <div class=\"conflicts-list\">\n\n                    <div class=\"conflict-item\">\n                      <div class=\"conflict-header\">\n                        <div class=\"conflict-type\">\n                          <span class=\"type-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getConflictTypeIcon(conflict.type)\"></span></span>\n                          <span class=\"type-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflict.type.replace('_', ' ')\"></span></span>\n                        </div>\n                        <div class=\"conflict-severity\" style=\"color:\">\n                          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflict.severity\"></span>\n                        </div>\n                      </div>\n\n                      <div class=\"conflict-details\">\n                        <div class=\"conflict-description\">\n                          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflict.description\"></span>\n                        </div>\n                        <div class=\"conflict-suggestion\">\n                          <strong>Suggestion:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflict.suggestedAction\"></span>\n                        </div>\n                        <div class=\"conflict-metrics\">\n                          <span>Distance: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflict.distance.toFixed(1)\"></span>m</span>\n                          <span>Interference: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflict.interferenceLevel.toFixed(1)\"></span> dB</span>\n                        </div>\n                      </div>\n                    </div>\n\n                </div>\n\n            </div>\n\n          <!-- Optimization Tab -->\n\n            <div class=\"optimization-content\">\n              <div class=\"optimization-header\">\n                <h3>Optimization Suggestions</h3>\n                <p>Recommended frequency changes to reduce interference</p>\n              </div>\n\n                <div class=\"no-optimizations\">\n                  <div class=\"no-optimizations-icon\">🎯</div>\n                  <h4>No Optimizations Available</h4>\n                  <p>Run analysis first to generate optimization suggestions.</p>\n                </div>\n\n                <div class=\"optimizations-list\">\n\n                    <div class=\"optimization-item\">\n                      <div class=\"optimization-header\">\n                        <div class=\"optimization-sector\">\n                          <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.sectorId\"></span></strong>\n                        </div>\n                        <div class=\"optimization-priority\">\n                          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.priority\"></span>\n                        </div>\n                      </div>\n\n                      <div class=\"optimization-details\">\n                        <div class=\"frequency-change\">\n                          <div class=\"current-freq\">\n                            <span class=\"label\">Current:</span>\n                            <span class=\"freq\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.currentFrequency.frequency\"></span> MHz</span>\n                            <span class=\"bw\">(<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.currentFrequency.bandwidth\"></span> MHz)</span>\n                          </div>\n                          <div class=\"arrow\">→</div>\n                          <div class=\"suggested-freq\">\n                            <span class=\"label\">Suggested:</span>\n                            <span class=\"freq\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.suggestedFrequency.frequency\"></span> MHz</span>\n                            <span class=\"bw\">(<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.suggestedFrequency.bandwidth\"></span> MHz)</span>\n                          </div>\n                        </div>\n\n                        <div class=\"optimization-reason\">\n                          <strong>Reason:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.reason\"></span>\n                        </div>\n\n                        <div class=\"optimization-improvement\">\n                          <strong>Expected Improvement:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimization.expectedImprovement.toFixed(1)\"></span> dB reduction\n                        </div>\n                      </div>\n                    </div>\n\n                </div>\n\n            </div>\n\n         <!-- Closing tag for  -->\n      </div>\n    </div>\n  </div></div></div>\n  </div>\n\n  <!-- Plan Approval Modal -->\n\n    <div data-cwl-shell-key=\"showPlanApprovalModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"PlanApprovalModal\" data-cwl-lifted-component=\"PlanApprovalModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showPlanApprovalModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && plan\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h2>📋 Plan Approval: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.name\"></span></h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n        <!-- Plan Details -->\n        <div class=\"plan-info\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Status:</span>\n            <span class=\"status-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.status\"></span></span>\n          </div>\n\n            <div class=\"info-row\" hidden aria-hidden=\"true\">\n              <span class=\"info-label\">Description:</span>\n              <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.description\"></span></span>\n            </div>\n\n          <div class=\"info-row\">\n            <span class=\"info-label\">Scope:</span>\n            <span class=\"info-value\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.scope.towers.length\"></span> towers, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.scope.sectors.length\"></span> sectors,\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.scope.cpeDevices.length\"></span> CPE, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.scope.equipment.length\"></span> equipment\n            </span>\n          </div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"plan.purchasePlan?.totalEstimatedCost\"><div class=\"info-row\">\n              <span class=\"info-label\">Estimated Cost:</span>\n              <span class=\"info-value cost\">$<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.purchasePlan.totalEstimatedCost.toLocaleString()\"></span></span>\n            </div></div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"plan.approval?.approvedBy\"><div class=\"info-row\">\n              <span class=\"info-label\">Previously Approved By:</span>\n              <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.approval.approvedBy\"></span> on <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.approval.approvedAt ? new Date(plan.approval.approvedAt).toLocaleDateString\"></span></span>\n            </div></div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"plan.approval?.rejectedBy\"><div class=\"info-row\">\n              <span class=\"info-label\">Previously Rejected By:</span>\n              <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.approval.rejectedBy\"></span> on <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.approval.rejectedAt ? new Date(plan.approval.rejectedAt).toLocaleDateString\"></span></span>\n            </div>\n\n              <div class=\"info-row\" hidden aria-hidden=\"true\">\n                <span class=\"info-label\">Reason:</span>\n                <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getRejectionReasonLabel(plan.approval.rejectionReason)\"></span></span>\n              </div>\n            </div>\n        </div>\n\n        <!-- Approval Section -->\n        <div class=\"approval-section\">\n          <h3>✅ Approve Plan</h3>\n          <div class=\"form-group assign-to\">\n            <label for=\"assignedToUserId\">Assign to tech (optional)</label>\n            <p class=\"hint\">User ID or email — field app &quot;My Projects&quot; uses this to show assigned plans.</p>\n            <input\n              type=\"text\"\n              id=\"assignedToUserId\"\n              placeholder=\"Firebase UID or email\"\n            />\n            <input\n              type=\"text\"\n              id=\"assignedToName\"\n              placeholder=\"Display name (optional)\"\n            />\n          </div>\n          <div class=\"form-group\">\n            <label for=\"approvalNotes\">Approval Notes (Optional)</label>\n            <textarea\n              id=\"approvalNotes\"\n              placeholder=\"Add any notes about the approval...\"\n              rows=\"3\"\n            ></textarea>\n          </div>\n          <button\n            class=\"btn-approve\" data-cwl-action=\"handleApprove\" data-cwl-attr-disabled=\"isProcessing\"\n           aria-label=\"Approve\">\n            ✅ Approve Plan\n          </button>\n        </div>\n\n        <div class=\"divider\">OR</div>\n\n        <!-- Rejection Section -->\n        <div class=\"rejection-section\">\n          <h3>❌ Reject Plan</h3>\n          <div class=\"form-group\">\n            <label for=\"rejectionReason\">Rejection Reason *</label>\n            <select id=\"rejectionReason\" required>\n\n                <option value=budget>💰 Budget Constraints</option>\n\n                <option value=technical>🔧 Technical Issues</option>\n\n                <option value=timing>⏰ Timing/Timeline Concerns</option>\n\n                <option value=regulatory>📋 Regulatory/Compliance Issues</option>\n\n                <option value=scope>📐 Scope Changes Needed</option>\n\n                <option value=other>❓ Other</option>\n\n            </select>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"rejectionNotes\">Rejection Notes (Optional)</label>\n            <textarea\n              id=\"rejectionNotes\"\n              placeholder=\"Provide details about why the plan is being rejected...\"\n              rows=\"4\"\n            ></textarea>\n          </div>\n          <button\n            class=\"btn-reject\" data-cwl-action=\"handleReject\" data-cwl-attr-disabled=\"isProcessing || !rejectionReason\"\n           aria-label=\"Reject\">\n            ❌ Reject Plan\n          </button>\n        </div>\n\n        <!-- Error/Success Messages -->\n\n          <div class=\"message error\" hidden aria-hidden=\"true\"></div>\n\n          <div class=\"message success\" hidden aria-hidden=\"true\"></div>\n\n      </div>\n\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      </div>\n    </div>\n  </div></div></div></div>\n  </div>\n\n  <!-- Deployed Hardware Modal -->\n  <div data-cwl-component=\"DeployedHardwareModal\" data-cwl-lifted-component=\"DeployedHardwareModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showDeployedHardwareModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-toggle=\"showEditModal:false\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content large\">\n    <div class=\"modal-header\">\n      <h2>🔧 Deployed Hardware</h2>\n      <button class=\"close-btn\" data-cwl-toggle=\"showEditModal:false\" aria-label=\"Show Edit Modal\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <!-- Tabs -->\n    <div class=\"tabs\">\n      <button class=\"tab-btn\" data-cwl-set=\"activeTab:hardware\">\n        🔧 Hardware (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deployments.length\"></span>)\n      </button>\n      <button class=\"tab-btn\" data-cwl-set=\"activeTab:epc\">\n        📡 EPC/SNMP Devices (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcDevices.length\"></span>)\n      </button>\n    </div>\n\n    <div class=\"modal-body\">\n\n        <!-- Hardware Deployments Tab -->\n\n          <div class=\"deployments-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"deployments as deployment\" data-cwl-each-item=\"deployment\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22deployment-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22deployment-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bdeployment.name%20%7C%7C%20'Unnamed%20Deployment'%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22deployment-type%22%3E%7Bdeployment.hardware_type%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22deployment-status%20%7Bdeployment.status%7D%22%3E%7Bdeployment.status%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22deployment-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-edit%22%20data-cwl-action%3D%22openEdit%22%20data-cwl-action-args%3D%22deployment%22%20aria-label%3D%22Open%20Edit%22%3E%E2%9C%8F%EF%B8%8F%20Edit%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-delete%22%20data-cwl-action%3D%22deleteDeployment%22%20data-cwl-action-args%3D%22deployment%22%20aria-label%3D%22Delete%20Deployment%22%3E%F0%9F%97%91%EF%B8%8F%20Delete%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22deployment-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3ESite%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bdeployment.siteId%3F.name%20%7C%7C%20'Unknown'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EProject%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7BgetPlanName(deployment.planId)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EDeployed%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bnew%20Date(deployment.deployedAt).toLocaleDateString()%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"deployment-item\">\n                <div class=\"deployment-header\">\n                  <div>\n                    <h3></h3>\n                    <span class=\"deployment-type\"></span>\n                    <span class=\"deployment-status \"></span>\n                  </div>\n                  <div class=\"deployment-actions\">\n                    <button class=\"btn-edit\" data-cwl-action=\"openEdit\" data-cwl-action-args=\"deployment\" aria-label=\"Open Edit\">✏️ Edit</button>\n                    <button class=\"btn-delete\" data-cwl-action=\"deleteDeployment\" data-cwl-action-args=\"deployment\" aria-label=\"Delete Deployment\">🗑️ Delete</button>\n                  </div>\n                </div>\n\n                <div class=\"deployment-details\">\n                  <div class=\"detail-row\">\n                    <span class=\"label\">Site:</span>\n                    <span class=\"value\"></span>\n                  </div>\n                  <div class=\"detail-row\">\n                    <span class=\"label\">Project:</span>\n                    <span class=\"value\"></span>\n                  </div>\n                  <div class=\"detail-row\">\n                    <span class=\"label\">Deployed:</span>\n                    <span class=\"value\"></span>\n                  </div>\n                </div>\n              </div></div>\n          </div>\n\n          <div class=\"empty-state\" hidden aria-hidden=\"true\">\n            <p>No hardware deployments found</p>\n          </div>\n\n          <div class=\"loading\" hidden aria-hidden=\"true\">Loading deployments...</div>\n\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-toggle=\"showEditModal:false\" aria-label=\"Show Edit Modal\">Close</button>\n    </div>\n  </div>\n</div>\n\n<!-- Edit Modal for General Hardware -->\n\n<div class=\"modal-overlay\" data-cwl-toggle=\"showEditModal:false\" data-cwl-shell-key=\"showEditModal\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content edit-modal\">\n    <div class=\"modal-header\">\n      <h2>✏️ Edit Deployment</h2>\n      <button class=\"close-btn\" data-cwl-toggle=\"showEditModal:false\" aria-label=\"Show Edit Modal\">✕</button>\n    </div>\n\n    <div class=\"modal-body\">\n      <div class=\"form-group\">\n        <label>Name</label>\n        <input type=\"text\" />\n      </div>\n\n      <div class=\"form-group\">\n        <label>Hardware Type</label>\n        <input type=\"text\" />\n      </div>\n\n      <div class=\"form-group\">\n        <label>Status</label>\n        <select>\n          <option value=\"deployed\">Deployed</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"active\">Active</option>\n          <option value=\"maintenance\">Maintenance</option>\n          <option value=\"retired\">Retired</option>\n        </select>\n      </div>\n\n      <div class=\"form-group\">\n        <label>Project</label>\n        <select>\n          <option>No project</option>\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"plans as plan\" data-cwl-each-item=\"plan\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bplan.id%7D%3E%7Bplan.name%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n        </select>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-toggle=\"showEditModal:false\" aria-label=\"Show Edit Modal\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"saveEdit\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save Edit\">\n        Save\n      </button>\n    </div>\n  </div>\n</div>\n\n<!-- Edit Modal for EPC/SNMP Devices -->\n\n<div class=\"modal-overlay nested\" data-cwl-toggle=\"showEPCEditModal:false\" data-cwl-shell-key=\"showEPCEditModal\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content edit-modal epc-edit\">\n    <div class=\"modal-header\">\n      <h2>✏️ Edit EPC/SNMP Device</h2>\n      <button class=\"close-btn\" data-cwl-toggle=\"showEPCEditModal:false\" aria-label=\"Show EPCEdit Modal\">✕</button>\n    </div>\n\n    <div class=\"modal-body\">\n      <div class=\"device-info-banner\">\n        <strong>Site:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedEPCDevice.site_name\"></span>\n        <br>\n        <strong>ID:</strong> <code><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedEPCDevice.epc_id\"></span></code>\n      </div>\n\n      <!-- Device Code Section -->\n      <div class=\"config-section\">\n        <h4>🔗 Device Linking</h4>\n\n          <p class=\"hint\">Enter the code shown on the device's status page to link it.</p>\n          <div class=\"link-device-row\">\n            <input type=\"text\" placeholder=\"e.g., ABCD1234\" maxlength=\"8\" class=\"device-code-input\" />\n            <button class=\"btn-link\" data-cwl-action=\"linkDeviceCode\" data-cwl-attr-disabled=\"isSaving || !epcEditForm.device_code\" aria-label=\"Link Device Code\">\n              🔗 Link\n            </button>\n          </div>\n\n          <div hidden aria-hidden=\"true\"><p class=\"linked-info\">✅ Device linked with code: <code class=\"device-code\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedEPCDevice.device_code\"></span></code></p>\n        </div>\n      </div>\n\n      <div class=\"form-group\">\n        <label>Deployment Type</label>\n        <select>\n          <option value=\"epc\">📡 EPC Only - LTE Core Network</option>\n          <option value=\"snmp\">📊 SNMP Agent Only - Network Monitoring</option>\n          <option value=\"both\">📡📊 EPC + SNMP - Full Package</option>\n        </select>\n      </div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"epcEditForm.deployment_type === 'epc' || epcEditForm.deployment_type === 'both'\"><div class=\"config-section\">\n          <h4>📡 EPC Configuration</h4>\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label>MCC</label>\n              <input type=\"text\" />\n            </div>\n            <div class=\"form-group\">\n              <label>MNC</label>\n              <input type=\"text\" />\n            </div>\n            <div class=\"form-group\">\n              <label>TAC</label>\n              <input type=\"text\" />\n            </div>\n          </div>\n          <div class=\"form-group\">\n            <label>APN Name</label>\n            <input type=\"text\" />\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label>Primary DNS</label>\n              <input type=\"text\" />\n            </div>\n            <div class=\"form-group\">\n              <label>Secondary DNS</label>\n              <input type=\"text\" />\n            </div>\n          </div>\n        </div></div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"epcEditForm.deployment_type === 'snmp' || epcEditForm.deployment_type === 'both'\"><div class=\"config-section\">\n          <h4>📊 SNMP Configuration</h4>\n          <div class=\"form-row checkbox-row\">\n            <label class=\"checkbox-label\">\n              <input type=\"checkbox\" />\n              SNMP Enabled\n            </label>\n            <label class=\"checkbox-label\">\n              <input type=\"checkbox\" />\n              Auto-Discovery\n            </label>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label>Community String</label>\n              <input type=\"text\" />\n            </div>\n            <div class=\"form-group\">\n              <label>Version</label>\n              <select>\n                <option value=\"1\">SNMPv1</option>\n                <option value=\"2c\">SNMPv2c</option>\n                <option value=\"3\">SNMPv3</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"form-group\">\n            <label>Polling Interval (seconds)</label>\n            <input type=\"number\" min=\"10\" max=\"3600\" />\n          </div>\n        </div></div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-toggle=\"showEPCEditModal:false\" aria-label=\"Show EPCEdit Modal\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"saveEPCEdit\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save EPCEdit\">\n        💾 Save Changes\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n  <!-- Site Details Modal -->\n\n    <div data-cwl-shell-key=\"showSiteDetailsModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"SiteDetailsModal\" data-cwl-lifted-component=\"SiteDetailsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSiteDetailsModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && site\"><div class=\"modal-overlay\" data-cwl-action=\"closeModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content large\">\n      <div class=\"modal-header\">\n        <h2>📋 Site Details: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.name\"></span></h2>\n        <button class=\"close-btn\" data-cwl-action=\"closeModal\" aria-label=\"Close Modal\">✕</button>\n      </div>\n\n        <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n      <!-- Site Info -->\n      <div class=\"site-info\">\n        <div class=\"info-row\">\n          <span class=\"label\">Type:</span>\n          <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.type || 'tower'\"></span></span>\n        </div>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"site.location?.address\"><div class=\"info-row\">\n            <span class=\"label\">Address:</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.location.address\"></span></span>\n          </div></div>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"site.location?.latitude && site.location?.longitude\"><div class=\"info-row\">\n            <span class=\"label\">Coordinates:</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.location.latitude.toFixed(6)\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.location.longitude.toFixed(6)\"></span></span>\n          </div></div>\n        <div class=\"info-row\">\n          <span class=\"label\">Status:</span>\n          <span class=\"value status-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.status || 'active'\"></span></span>\n        </div>\n      </div>\n\n      <!-- Tabs -->\n      <div class=\"tabs\">\n        <button class=\"tab-btn\" data-cwl-set=\"activeTab:hardware\">\n          🔧 Hardware (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"hardwareDeployments.length\"></span>)\n        </button>\n        <button class=\"tab-btn\" data-cwl-set=\"activeTab:epc\">\n          📡 EPC/SNMP (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcDevices.length\"></span>)\n        </button>\n        <button class=\"tab-btn\" data-cwl-set=\"activeTab:equipment\">\n          📦 Equipment (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"equipment.length\"></span>)\n        </button>\n        <button class=\"tab-btn\" data-cwl-set=\"activeTab:sectors\">\n          📶 Sectors (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sectors.length\"></span>)\n        </button>\n      </div>\n\n      <div class=\"modal-body\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'hardware'\">\n          <!-- Hardware Deployments -->\n\n            <div class=\"items-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"hardwareDeployments as deployment\" data-cwl-each-item=\"deployment\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bdeployment.name%20%7C%7C%20'Unnamed%20Deployment'%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20%7Bdeployment.status%20%7C%7C%20'deployed'%7D%22%3E%7Bdeployment.status%20%7C%7C%20'deployed'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22item-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EType%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bdeployment.hardware_type%20%7C%7C%20'Unknown'%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20deployment.config%3F.ipAddress%20%7C%7C%20deployment.config%3F.ip_address%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EIP%20Address%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%20mono%22%3E%7Bdeployment.config.ipAddress%20%7C%7C%20deployment.config.ip_address%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20deployment.config%3F.macAddress