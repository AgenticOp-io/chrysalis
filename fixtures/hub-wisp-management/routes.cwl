  return html "<svelte:head>\n  <title>Plan – WISP Management</title>\n</svelte:head>\n\n<div class=\"module-shell\">\n  <nav class=\"module-nav\">\n  <a href=\"/modules/plan\">Plan</a>\n  <a href=\"/modules/deploy\">Deploy</a>\n  <a href=\"/modules/coverage-map\">Coverage Map</a>\n  <a href=\"/dashboard\">← Dashboard</a>\n</nav>\n  <header>\n    <h1>Plan</h1>\n    <p class=\"module-blurb\">Coverage and site planning</p>\n    <p class=\"api-surface\">API: /api/plans (proxied upstream)</p>\n  </header>\n  <p class=\"client-hole-note\">ArcGIS geocode client calls remain <code>hub-svelte:arcgis-map</code>.</p>\n  <p class=\"ui-hole-note\">Interactive module widgets remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/modules/sites"
page modules_sites_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/sites", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"sites-page\">\n    <div class=\"page-header\">\n      <div>\n        <h1>🏢 Site Management</h1>\n        <p class=\"subtitle\">Manage all network sites, towers, buildings, and facilities</p>\n      </div>\n      <div class=\"header-actions\">\n        <button class=\"btn-primary\">\n          ➕ Create New Site\n        </button>\n        <button class=\"btn-secondary\" title=\"Refresh\">\n          🔄 Refresh\n        </button>\n      </div>\n    </div>\n    \n    \n    \n    <!-- Filters and Search -->\n    <div class=\"filters-section\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"Search sites by name, address, or city...\"\n          class=\"search-input\"\n        />\n        <span class=\"search-icon\">🔍</span>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Type:</label>\n        <select>\n          <option value=\"all\">All Types</option>\n          <option value=\"tower\">📡 Tower</option>\n          <option value=\"building\">🏢 Building</option>\n          <option value=\"noc\">🖥️ NOC</option>\n          <option value=\"warehouse\">🏭 Warehouse</option>\n          <option value=\"pole\">📡 Pole</option>\n          <option value=\"other\">📍 Other</option>\n        </select>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Status:</label>\n        <select>\n          <option value=\"all\">All Statuses</option>\n          <option value=\"active\">✅ Active</option>\n          <option value=\"inactive\">❌ Inactive</option>\n          <option value=\"maintenance\">🔧 Maintenance</option>\n          <option value=\"planned\">📅 Planned</option>\n        </select>\n      </div>\n    </div>\n    \n    <!-- Summary Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Sites</div>\n      </div>\n      <div class=\"stat-card active\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Towers</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Buildings</div>\n      </div>\n    </div>\n    \n    <!-- Sites Table -->\n    \n      <div class=\"sites-table-container\">\n        <table class=\"sites-table\">\n          <thead>\n            <tr>\n              <th>Site Name</th>\n              <th>Type</th>\n              <th>Status</th>\n              <th>Location</th>\n              <th>Contact</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            \n          </tbody>\n        </table>\n      </div>\n    \n  </div>\n  \n  <!-- Site Edit Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SiteEditModal\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  \n  <!-- EPC Deployment Modal -->\n  \n  \n  <!-- Sector Deployment Modal -->\n  \n  \n  <!-- CPE/FWA Deployment Modal -->\n  \n  \n  <!-- Backhaul Deployment Modal -->\n  \n\n  <!-- Tips Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />";
}

