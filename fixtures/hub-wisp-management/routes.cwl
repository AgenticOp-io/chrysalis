@page GET "/dashboard"
page dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { tenantLabel: "WISP Tenant", source: "wisp-m30", moduleCount: 7, apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- First-Time Setup Wizard -->\n  \n  \n  <div class=\"dashboard-container\">\n    <!-- Header: centered logo + text, icons directly below -->\n    <div class=\"header\">\n      <div class=\"header-content\">\n        <div class=\"header-brand\">\n          <div class=\"logo-section\">\n            <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"dashboard-logo\" />\n            <div class=\"branding\">\n              <h1 class=\"app-title\">WISP Management</h1>\n              <p class=\"app-subtitle\">wisptools.io</p>\n            <p class=\"poc-notice\">wisptools.io · Source code: <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">github.com/theorem6/WISP-Management</a></p>\n            </div>\n          </div>\n          <div class=\"header-icons\">\n            <a class=\"icon-btn apk-btn\" title=\"Download Field App\" aria-label=\"Download WISP Field App (APK)\" download>\n              <span class=\"apk-icon\">📱</span>\n            </a>\n            <a href=\"/help\" class=\"icon-btn doc-btn\" title=\"Help\" aria-label=\"Open help\">\n              <span class=\"doc-icon\">📖</span>\n            </a>\n            <button class=\"icon-btn gear-btn\" title=\"Settings\" aria-label=\"Open settings\">\n              <svg class=\"gear-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n                <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path>\n              </svg>\n            </button>\n            \n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"GlobalSettings\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>t1</td><td>active</td></tr><tr><td>t2</td><td>trial</td></tr></tbody></table></div> (showSettings = false)} />\n    <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> (showTipsModal = false)} />\n\n    <!-- Main Content -->\n    <div class=\"main-content\">\n      <!-- Core Modules -->\n      <div class=\"modules-section\">\n        <div class=\"modules-grid\">\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"modules as module\"><div \n              class=\"module-card\" role=\"button\"\n              tabindex=\"0\"\n              aria-label=\"Open . \"\n            >\n              <div class=\"module-header\">\n                <h3 class=\"module-name\"></h3>\n              </div>\n              \n              <div class=\"module-features\">\n                <ul>\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"module.features as feature\"><li></li></div>\n                </ul>\n              </div>\n\n              <div class=\"module-status\">\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"module.status === 'active'\"><span class=\"status-badge active\">Active</span></div>\n              </div>\n            </div></div>\n        </div>\n      </div>\n\n      <!-- Admin Modules -->\n      \n        <div class=\"admin-section\">\n          <h2 class=\"section-title\">Administration</h2>\n          <div class=\"admin-modules\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"adminModules as module\"><div \n                class=\"admin-card\"\n                role=\"button\"\n                tabindex=\"0\"\n                aria-label=\"Open . \"\n              >\n                <div class=\"admin-icon\" style=\"background-color: 20; color: \">\n                  \n                </div>\n                <div class=\"admin-info\">\n                  <h3 class=\"admin-name\"></h3>\n                  <p class=\"admin-description\"></p>\n                </div>\n              </div></div>\n          </div>\n        </div>\n      \n\n      <!-- Footer: License + GitHub -->\n      <footer class=\"app-footer\">\n        <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a>\n        <span class=\"sep\">·</span>\n        <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener noreferrer\">CC BY 4.0</a>\n      </footer>\n    </div>\n  </div>";
}

@page GET "/debug-tenants"
page debug_tenants_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/debug-tenants" };
  return html "<div class=\"debug-container\">\n  <h1>Tenant Debug Information</h1>\n  \n  <div class=\"debug-section\">\n    <h2>Authentication Status</h2>\n    <p><strong>Is Authenticated:</strong> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"debugInfo.isAuthenticated\"></span></p>\n    <p><strong>User Email:</strong> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"debugInfo.currentUser?.email || 'None'\"></span></p>\n    <p><strong>User UID:</strong> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"debugInfo.currentUser?.uid || 'None'\"></span></p>\n  </div>\n\n  <div class=\"debug-section\">\n    <h2>Tenant Store State</h2>\n    <pre><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"JSON.stringify(debugInfo.tenantState, null, 2)\"></span></pre>\n  </div>\n\n  <div class=\"debug-section\">\n    <h2>User Tenants (Direct API Call)</h2>\n    <p><strong>Count:</strong> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"debugInfo.userTenants.length\"></span></p>\n    <pre><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"JSON.stringify(debugInfo.userTenants, null, 2)\"></span></pre>\n  </div>\n\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"debugInfo.error\"><div class=\"debug-section error\">\n      <h2>Error</h2>\n      <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"debugInfo.error\"></span></p>\n    </div></div>\n</div>";
}

@page GET "/demo"
page demo_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/demo" };
  return html "<div class=\"wrap\">\n    <header class=\"hero\">\n      <h1>Demo walkthrough</h1>\n      <p class=\"lead\">\n        Seeded records use prefixes <code>CUST-DEMO-*</code>, <code>TKT-DEMO-*</code>,\n        <code>INC-DEMO-*</code>, <code>DEMO-SN-*</code>. Prefer editing and resolving over deleting.\n        Use one pre-provisioned demo login — see the operator runbook in the repo.\n      </p>\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"$currentTenant\"><p class=\"tenant\">\n          Organization: <strong><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"$currentTenant.displayName\"></span></strong>\n          <span class=\"muted\">(<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"$currentTenant.id\"></span>)</span>\n        </p></div>\n    </header>\n\n    <div class=\"grid\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"links as item\"><a class=\"card\">\n          <h2></h2>\n          <p></p>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.hint\"><span class=\"hint\"></span></div>\n        </a></div>\n    </div>\n\n    <section class=\"doc\">\n      <h2>Documentation (repository)</h2>\n      <ul>\n        <li>\n          Demo visitor (IP login, limits, purge on logout):\n          <code>docs/deployment/DEMO_VISITOR.md</code>\n        </li>\n        <li>\n          Operator runbook (logins, isolation, feature matrix, reset policy):\n          <code>docs/deployment/DEMO_RUNBOOK.md</code>\n        </li>\n        <li>\n          Seed &amp; env:\n          <code>scripts/demo/README.md</code>\n        </li>\n        <li>\n          Deploy:\n          <code>docs/deployment/DEMO_SITE.md</code>\n        </li>\n      </ul>\n    </section>\n  </div>";
}

@page GET "/docs"
page docs_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/docs" };
  return html "<svelte:head>\r\n  <title>Documentation – WISP Management</title>\r\n</svelte:head>\r\n\r\n<h1>WISP Management Documentation</h1>\r\n<p class=\"lead\">Documentation is integrated into the app. Use the sidebar or the links below.</p>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>Quick links</h2>\r\n  <ul>\r\n    <li><a href=\"/help\">Getting Started</a> – New users and administrators.</li>\r\n    <li><a href=\"/help\">Using WISP Management</a> – For end users: dashboard, wizards, help.</li>\r\n    <li><a href=\"/help\">Project Status & Next Steps</a> – Current status and what to work on next.</li>\r\n    <li><a href=\"/help\">Help by topic</a> – Module-specific help (Inventory, ACS, Deploy, Plan, etc.).</li>\r\n    <li><a href=\"/wizards\">Wizards</a> – Guided flows (sites, subscribers, customers, RMA, plans, groups, troubleshooting).</li>\r\n  </ul>\r\n</section>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>What is WISP Management?</h2>\r\n  <p>WISP Management is the main app on wisptools.io for LTE WISP operations:</p>\r\n  <ul>\r\n    <li><strong>Multi-tenant</strong> – Manage multiple organizations</li>\r\n    <li><strong>HSS</strong> – Home Subscriber Server for Open5GS</li>\r\n    <li><strong>Device management</strong> – TR-069/CWMP via GenieACS</li>\r\n    <li><strong>Network planning</strong> – Coverage mapping, PCI resolution</li>\r\n    <li><strong>Monitoring</strong> – SNMP and performance graphs</li>\r\n    <li><strong>CBRS/SAS</strong> – Spectrum Access System integration</li>\r\n  </ul>\r\n</section>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>In-app help</h2>\r\n  <p>Each module (Inventory, Deploy, ACS CPE, HSS, Plan, Coverage Map, CBRS, PCI Resolution, Monitoring) has a <strong>Help</strong> button that opens module-specific documentation. The <a href=\"/help\">Help by topic</a> page lists all topics in one place. For reference and project status, use the sidebar or <a href=\"/docs/reference/project-status\">Project Status &amp; Next Steps</a>.</p>\r\n</section>";
}

@page GET "/docs/deployment"
page docs_deployment_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/docs/deployment" };
  return html "<svelte:head>\r\n  <title>Using WISP Management – WISP Management Docs</title>\r\n</svelte:head>\r\n\r\n<h1>Using WISP Management</h1>\r\n<p class=\"lead\">Your organization’s WISP Management instance is set up and managed by your administrator. This page is for end users.</p>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>What you can do</h2>\r\n  <ul>\r\n    <li><strong>Dashboard</strong> – Open modules (Plan, Deploy, Monitor, Maintain, Customers, Hardware) and use <strong>Wizards</strong> for guided flows.</li>\r\n    <li><strong>Wizards</strong> – Use the <strong>Wizards</strong> menu on the dashboard or go to <a href=\"/wizards\">/wizards</a> to see all guided flows (sites, subscribers, customers, RMA, plans, groups, troubleshooting).</li>\r\n    <li><strong>Documentation</strong> – Use <a href=\"/help\">Help</a> for getting started and project status.</li>\r\n    <li><strong>Help</strong> – Use <a href=\"/help\">Help by topic</a> for module-specific guidance.</li>\r\n  </ul>\r\n</section>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>Need access or changes?</h2>\r\n  <p>For new accounts, access to modules, or platform changes, contact your WISP Management administrator.</p>\r\n  <p><a href=\"/help\">← Help & Documentation</a></p>\r\n</section>";
}

@page GET "/docs/getting-started"
page docs_getting_started_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/docs/getting-started" };
  return html "<svelte:head>\r\n  <title>Getting Started – WISP Management Docs</title>\r\n</svelte:head>\r\n\r\n<h1>Getting Started</h1>\r\n<p class=\"lead\">Welcome to WISP Management. This guide helps you get started with the LTE WISP platform on wisptools.io.</p>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>What is WISP Management?</h2>\r\n  <p>WISP Management is the main app on wisptools.io for LTE WISPs. It provides:</p>\r\n  <ul>\r\n    <li><strong>Multi-tenant architecture</strong> – Manage multiple organizations</li>\r\n    <li><strong>HSS management</strong> – Home Subscriber Server for Open5GS</li>\r\n    <li><strong>Device management</strong> – TR-069/CWMP via GenieACS</li>\r\n    <li><strong>Network planning</strong> – Coverage mapping and PCI collision prevention</li>\r\n    <li><strong>Monitoring</strong> – SNMP monitoring and performance graphs</li>\r\n    <li><strong>CBRS/SAS</strong> – Spectrum Access System integration</li>\r\n  </ul>\r\n</section>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>Quick start</h2>\r\n  <h3>For new users</h3>\r\n  <ol>\r\n    <li><strong>Create an account</strong> – Complete registration and verify your email.</li>\r\n    <li><strong>Set up your first tenant</strong> – Configure organization details and subscription.</li>\r\n    <li><strong>Use the platform</strong> – Open the <a href=\"/dashboard\">dashboard</a>, explore modules, and start managing your network.</li>\r\n  </ol>\r\n  <h3>For administrators</h3>\r\n  <ol>\r\n    <li><strong>Deploy the platform</strong> – Follow the <a href=\"/help\">deployment guide</a>; set up backend and frontend.</li>\r\n    <li><strong>Configure HSS</strong> – Set up Open5GS and connect MMEs (see repo <code>docs/</code> for admin guides).</li>\r\n    <li><strong>Manage tenants</strong> – Use Admin Management from the dashboard; configure GenieACS and user roles.</li>\r\n  </ol>\r\n</section>\r\n\r\n<section class=\"doc-section\">\r\n  <h2>Next steps</h2>\r\n  <ul>\r\n    <li><a href=\"/help\">Help & Documentation</a></li>\r\n    <li><a href=\"/help\">Deployment</a></li>\r\n    <li><a href=\"/help\">Project status & next steps</a></li>\r\n    <li><a href=\"/help\">Help by topic</a></li>\r\n    <li><a href=\"/wizards\">Wizards</a> – Guided flows for sites, subscribers, customers, RMA, plans, groups</li>\r\n  </ul>\r\n</section>";
}

@page GET "/docs/reference"
page docs_reference_page {
  effects: session.read;
