  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/tenant-admin" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"tenant-admin\" data-wisp-path=\"/tenant-admin\" data-cwl-island=\"client\"><div class=\"tenant-admin-page\">\n  <div class=\"admin-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to Dashboard\n      </button>\n      <h1>🏢 Tenant Settings</h1>\n      \n    </div>\n  </div>\n\n  \n    <div class=\"admin-container\">\n      <div class=\"tabs\">\n        <button \n          class=\"tab\"\n        >\n          General\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Device Settings\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Connection\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Limits & Quotas\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Users\n        </button>\n      </div>\n\n  \n\n  \n\n      \n\n      \n\n      \n\n      \n\n      \n    </div>\n  \n</div></div>";
}

@page GET "/tenant-selector"
page tenant_selector_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/tenant-selector" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"tenant-selector\" data-wisp-path=\"/tenant-selector\" data-cwl-island=\"client\"><div class=\"tenant-selector-page\">\n  <div class=\"selector-container\">\n    <div class=\"selector-header\">\n      <h1>Select Organization</h1>\n      <p>Choose the organization you want to work with</p>\n    </div>\n\n    \n      <div class=\"tenants-grid\">\n        \n\n        <button class=\"tenant-card create-new\">\n          <div class=\"create-icon\">➕</div>\n          <h3>Create New Organization</h3>\n          <p>Set up a new tenant for your devices</p>\n        </button>\n      </div>\n    \n  </div>\n</div></div>";
}

@page GET "/tenant-setup"
page tenant_setup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/tenant-setup" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"tenant-setup\" data-wisp-path=\"/tenant-setup\" data-cwl-island=\"client\"><div class=\"tenant-setup-page\">\n  <div class=\"setup-container\">\n    <div class=\"setup-header\">\n      <div>\n        <h1>🏢 Set Up Your Organization</h1>\n        <p>Create a tenant to manage your devices and networks</p>\n      </div>\n      <button type=\"button\" class=\"exit-button\">\n        Exit setup\n      </button>\n    </div>\n\n    <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 50%\"></div>\n        </div>\n\n        <h2>Organization Details</h2>\n        <p class=\"subtitle\">Tell us about your organization</p>\n\n        <div class=\"info-message\">\n          <span class=\"info-icon\">ℹ️</span>\n          <strong>Note:</strong> Each account can create one organization. You'll be the owner and can invite additional users.\n        </div>\n\n        \n\n        <form>\n          <div class=\"form-group\">\n            <label for=\"tenantName\">\n              Organization Name <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"tenantName\"\n              type=\"text\"\n              placeholder=\"e.g., Acme Wireless\"\n              required\n            />\n            <p class=\"help-text\">Legal or business name of your organization</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"displayName\">\n              Display Name <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"displayName\"\n              type=\"text\"\n              placeholder=\"e.g., Acme Wireless ISP\"\n              required\n            />\n            <p class=\"help-text\">Name shown in the application</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"subdomain\">\n              Subdomain <span class=\"required\">*</span>\n            </label>\n            <div class=\"subdomain-input\">\n              <input\n                id=\"subdomain\"\n                type=\"text\"\n                placeholder=\"acme-wireless\"\n                required\n                pattern=\"[a-z0-9\\\\-]+\"\n              />\n              <span class=\"subdomain-suffix\">.your-domain.com</span>\n            </div>\n            <p class=\"help-text\">Unique URL for device connections: /cwmp/</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactEmail\">\n              Contact Email <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"contactEmail\"\n              type=\"email\"\n              placeholder=\"admin@acme-wireless.com\"\n              required\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactPhone\">\n              Contact Phone\n            </label>\n            <input\n              id=\"contactPhone\"\n              type=\"tel\"\n              placeholder=\"+1 (555) 123-4567\"\n            />\n          </div>\n\n          <div class=\"form-actions\">\n            <button type=\"submit\" class=\"btn-primary\">\n              \n                Create Tenant\n              \n            </button>\n          </div>\n        </form>\n      </div>\n    \n      <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 66%\"></div>\n        </div>\n\n        <h2>Payment Method Setup</h2>\n        <p class=\"subtitle\">Add a payment method for your account (required)</p>\n\n        <div class=\"beta-disclaimer\">\n          <div class=\"beta-badge\">BETA</div>\n          <p><strong>wisptools.io (WISP Management) is currently in beta.</strong> No charges will be made without prior notice. Adding a payment method now ensures uninterrupted service when billing begins.</p>\n        </div>\n\n        \n\n        <div class=\"form-group\">\n          <label>Payment Method <span class=\"required\">*</span></label>\n          <div class=\"payment-method-options\">\n            <label class=\"payment-option\">\n              <input \n                type=\"radio\" \n                name=\"paymentMethod\" \n                value=\"paypal\"\n              />\n              <div class=\"payment-option-content\">\n                <div class=\"payment-icon\">💳</div>\n                <div>\n                  <strong>PayPal</strong>\n                  <p>Pay with PayPal account</p>\n                </div>\n              </div>\n            </label>\n            <label class=\"payment-option\">\n              <input \n                type=\"radio\" \n                name=\"paymentMethod\" \n                value=\"credit_card\"\n              />\n              <div class=\"payment-option-content\">\n                <div class=\"payment-icon\">💳</div>\n                <div>\n                  <strong>Credit Card</strong>\n                  <p>Pay with credit or debit card</p>\n                </div>\n              </div>\n            </label>\n          </div>\n        </div>\n\n        \n\n        \n\n        <div class=\"form-actions\">\n          <button \n            type=\"button\" \n            class=\"btn-secondary\"\n          >\n            Skip for Now\n          </button>\n          <button \n            type=\"button\" \n            class=\"btn-primary\"\n          >\n            \n              Continue\n            \n          </button>\n        </div>\n      </div>\n    \n      <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 100%\"></div>\n        </div>\n\n        <h2>Primary Location Setup</h2>\n        <p class=\"subtitle\">Set up your primary NOC/HQ/Tower location for inventory management</p>\n\n        <div class=\"info-message\">\n          <span class=\"info-icon\">ℹ️</span>\n          <strong>Note:</strong> Hardware scanned in will automatically be assigned to this location. You can change this later in settings.\n        </div>\n\n        \n\n        <div class=\"form-group\">\n          <label>Primary Location</label>\n          <div class=\"radio-group\">\n            <label class=\"radio-option\">\n              <input type=\"radio\" value=\"create\" />\n              <span>Create New Location</span>\n            </label>\n            <label class=\"radio-option\">\n              <input type=\"radio\" value=\"skip\" />\n              <span>Skip for Now</span>\n            </label>\n          </div>\n        </div>\n\n        \n\n        <div class=\"form-actions\">\n          <button \n            type=\"button\" \n            class=\"btn-secondary\");\n            }}\n          >\n            Skip\n          </button>\n          <button \n            type=\"button\" \n            class=\"btn-primary\"\n          >\n            \n              Complete Setup\n            \n          </button>\n        </div>\n      </div>\n  </div>\n  \n  <!-- Site Creation Modal -->\n  \n</div></div>";
}

@page GET "/wizards"
page wizards_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/wizards" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"wizards\" data-wisp-path=\"/wizards\" data-cwl-island=\"client\"><div class=\"wizards-page\">\n    <header class=\"wizards-header\">\n      <button class=\"back-btn\" type=\"button\">\n        ← Dashboard\n      </button>\n      <div class=\"wizards-header-row\">\n        <h1>🧙 List of wizards</h1>\n        <div class=\"wizards-pulldown-wrap\">\n          <button\n            type=\"button\"\n            class=\"wizards-pulldown-trigger\"\n            aria-haspopup=\"true\"\n          >\n            Jump to wizard ▼\n          </button>\n          \n        </div>\n      </div>\n      <p class=\"subtitle\">Guided flows for setup, deployment, and operations. Each wizard runs inside its module. Use <strong>Jump to wizard</strong> above or \"Open in [Module]\" below to go to that module, then click the wizard button in the module header.</p>\n    </header>\n\n    <div class=\"wizards-grid\">\n      \n    </div>\n  </div>\n  <div data-cwl-component=\"OrganizationSetupWizard\" data-cwl-lifted-component=\"OrganizationSetupWizard\"><div class=\"wizard-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"org-wizard-title\" hidden aria-hidden=\"true\">\n    <div class=\"wizard-modal\">\n      <div class=\"wizard-header\">\n        <h2 id=\"org-wizard-title\">🏢 Organization Setup</h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      <div class=\"wizard-content\">\n        <div class=\"wizard-panel\">\n          <p>Verify your organization details. You can edit these later in Settings.</p>\n          <div class=\"info-card\">\n              <div class=\"info-row\">\n                <span class=\"label\">Organization Name:</span>\n                <span class=\"value\">Demo Tenant</span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Contact Email:</span>\n                <span class=\"value\"></span>\n              </div>\n            </div>\n          <div class=\"actions\">\n            <button type=\"button\" class=\"btn-primary\">Edit in Settings</button>\n            <button type=\"button\" class=\"btn-secondary\">Done</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>\n  <div data-cwl-component=\"InitialConfigurationWizard\" data-cwl-lifted-component=\"InitialConfigurationWizard\"><div class=\"wizard-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"config-wizard-title\" hidden aria-hidden=\"true\">\n    <div class=\"wizard-modal\">\n      <div class=\"wizard-header\">\n        <h2 id=\"config-wizard-title\">⚙️ Initial Configuration</h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      <div class=\"wizard-content\">\n        <div class=\"wizard-panel\">\n          <p>Add your first tower and configure the modules you'll use. You can do these later from the Dashboard.</p>\n\n          <div class=\"section\">\n            <h3>Add First Tower</h3>\n            <p class=\"section-desc\">Add a tower site for coverage planning.</p>\n            <button type=\"button\" class=\"btn-primary\">Open Coverage Map</button>\n          </div>\n\n          <div class=\"section\">\n            <h3>Configure Modules</h3>\n            <div class=\"modules-grid\">\n              <div class=\"module-card\">\n                <span class=\"icon\">📡</span>\n                <h4>CBRS Management</h4>\n                <p>Configure SAS API keys</p>\n                <button type=\"button\" class=\"btn-secondary\">Setup CBRS</button>\n              </div>\n              <div class=\"module-card\">\n                <span class=\"icon\">⚙️</span>\n                <h4>ACS/TR-069</h4>\n                <p>Configure network monitoring</p>\n                <button type=\"button\" class=\"btn-secondary\">Setup ACS</button>\n              </div>\n              <div class=\"module-card\">\n                <span class=\"icon\">📊</span>\n                <h4>Monitoring</h4>\n                <p>Configure SNMP and monitoring</p>\n                <button type=\"button\" class=\"btn-secondary\">Setup Monitoring</button>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"actions\">\n            <button type=\"button\" class=\"btn-secondary\">Done</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div></div>";
}

@page GET "/admin/billing/add"
page admin_billing_add_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "markup-form-shell", path: "/admin/billing/add", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<section class=\"cwl-form-shell\" data-cwl-form-shell=\"no-source-add\" data-cwl-route=\"/admin/billing/add\"><header class=\"cwl-form-shell-header\"><h1>Add billing</h1><a class=\"cwl-form-shell-back\" href=\"/admin/billing\">Back</a></header><form class=\"cwl-form-shell-form\" method=\"post\" action=\"/admin/billing/add\" data-cwl-form-shell-empty=\"true\"><p class=\"cwl-form-shell-note\">Missing +page.svelte — empty shell (no invented fields).</p><button type=\"submit\" disabled>Save</button></form></section>";
}

@page GET "/admin/management/add"
