@page GET "/modules/billing"
page modules_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/billing", apiPath: "/api/customer-billing", api_ok: true, api_surface: "wisp-api-native", api_resource: "customer-billing", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"billing-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-content\">\n        <button class=\"back-btn\">\n          <span class=\"back-icon\">←</span>\n          Back to Dashboard\n        </button>\n        <div class=\"module-title\">\n          <h1>💳 Billing & Subscriptions</h1>\n          <p>Manage your subscription and billing information</p>\n        </div>\n        <div class=\"tenant-info\">\n          <span class=\"tenant-name\">Demo Tenant</span>\n            <span class=\"tenant-subdomain\">demo</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n      \n\n      \n        <!-- Current Subscription -->\n        <div class=\"current-subscription\">\n          <h2>Current Subscription</h2>\n          \n        </div>\n\n        <!-- Available Plans -->\n        <div class=\"plans-section\">\n          <h2>Available Plans</h2>\n          <div class=\"plans-grid\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"plans as plan\"><div class=\"plan-card \">\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"plan.isPopular\"><div class=\"popular-badge\">Most Popular</div></div>\n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"plan.features as feature\"><li>✓ </li></div>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button \n                  class=\"select-plan-btn\">\n                  \n                </button>\n              </div></div>\n          </div>\n        </div>\n\n        <!-- Payment Methods -->\n        <div class=\"payment-methods-section\">\n          <h2>Payment Methods</h2>\n          \n        </div>\n\n        <!-- Recent Invoices -->\n        <div class=\"invoices-section\">\n          <h2>Recent Invoices</h2>\n          \n        </div>\n      \n    </div>\n\n    <!-- Edit Payment Method Modal -->\n    \n  </div>";
}

@page GET "/modules/cbrs-management"
page modules_cbrs_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/cbrs-management", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- CBRS Setup Wizard -->\n\n<!-- CBRS Device Registration Wizard -->\n<div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"CBRSDeviceRegistrationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cbrs-module\">\n  <!-- Header -->\n  <div class=\"module-header\">\n    <div class=\"header-content\">\n      <div class=\"header-left\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          Back to Dashboard\n        </a>\n        <h1 class=\"module-title\">\n          <span class=\"module-icon\">📡</span>\n          CBRS Management\n        </h1>\n        <p class=\"module-description\">Citizens Broadband Radio Service spectrum management</p>\n        \n        <div class=\"tenant-badge\">\n            <span class=\"tenant-icon\">🏢</span>\n            <span class=\"tenant-text\">Demo Tenant</span>\n          </div>\n      </div>\n      \n      <div class=\"header-actions\">\n        \n        <button class=\"btn btn-secondary\" title=\"Configure SAS providers\">\n          ⚙️ Settings\n        </button>\n        <button class=\"btn btn-primary\">\n          + Add CBSD Device\n        </button>\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"if (e.detail.id === 'cbrs-setup') true;\n            else if (e\"></span>}\n        />\n      </div>\n    </div>\n  </div>\n\n  \n  \n  <div class=\"error-banner\">\n      <span class=\"error-icon\">⚠️</span>\n      <span class=\"error-message\">\n        No tenant selected. Please return to the \n        <a href=\"/dashboard\" class=\"inline-link\">dashboard</a> \n        and select a tenant first.\n      </span>\n    </div>\n\n  <!-- Main Content -->\n  <div class=\"module-content\">\n    <!-- Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📡</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"devices.length\"></span></div>\n          <div class=\"stat-label\">Total Devices</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">✅</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"devices.filter(d => d.state === 'REGISTERED' || d.state === 'GRANTED' || d.state\"></span></div>\n          <div class=\"stat-label\">Registered</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📊</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"devices.reduce((sum, d) => sum + (d.activeGrants?.length || 0), 0)\"></span></div>\n          <div class=\"stat-label\">Active Grants</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🌐</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"CBRS_BAND.BANDWIDTH / 1000000\"></span> MHz</div>\n          <div class=\"stat-label\">CBRS Band</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Map -->\n    <div class=\"map-section\">\n      <div class=\"map-header\">\n        <h3>CBSD Device Map</h3>\n        <div class=\"legend\">\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #10b981;\"></span>\n            <span>Active</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #3b82f6;\"></span>\n            <span>Registered</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #6b7280;\"></span>\n            <span>Unregistered</span>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"map-container\">\n        <div class=\"arcgis-map\"></div>\n        \n        \n      </div>\n    </div>\n\n    <!-- Device List and Grant Status -->\n    <div class=\"content-grid\">\n      <div class=\"device-list-section\">\n        <h3>CBSD Devices</h3>\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"DeviceList\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>cpe-1</td><td>online</td></tr><tr><td>cpe-2</td><td>degraded</td></tr></tbody></table></div> true}\n        />\n      </div>\n      \n      \n    </div>\n  </div>\n</div>\n\n<!-- Add Device Modal -->\n\n\n<!-- Grant Request Modal -->\n\n\n<!-- Settings Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SettingsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<!-- User ID / Network Selector Modal (includes Google login) -->\n<div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"UserIDSelector\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>s1</td><td>online</td></tr></tbody></table></div> false}\n/>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<!-- Quick Tips Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

@page GET "/modules/coverage-map"
page modules_coverage_map_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { moduleKey: "coverage-map", source: "wisp-m30", apiPath: "/api/coverage", vendor: "arcgis-map", api_ok: true, itemCount: 1, tracedApiStatus: 200 };
  return html "<svelte:window />\n\n<div class=\"fullscreen-map\">\n  <!-- Full Screen Map -->\n  \n    <div class=\"cwl-map-shell\" data-cwl-map-shell=\"CoverageMapView\" aria-hidden=\"true\" role=\"img\"></div>\n  \n\n  \n\n  <!-- Floating Control Panel -->\n  <div class=\"floating-controls\">\n    <button class=\"control-btn\" title=\"Toggle Filters\">\n        🔍\n      </button>\n    <button class=\"control-btn\" title=\"Toggle Statistics\">\n        📊\n      </button>\n    <button \n      class=\"control-btn\" \n      title=\"Device Management (SNMP, TR-069, MikroTik, EPC)\"\n    >\n      📱\n    </button>\n    \n    <!-- Map Type Toggle -->\n    <div class=\"control-group\">\n      <button class=\"control-btn map-control-btn\" title=\"Toggle Map Type\">\n        🗺️\n      </button>\n      <div class=\"control-dropdown\">\n        <div class=\"dropdown-section\">\n          <div class=\"dropdown-label\">Map View</div>\n          <div class=\"basemap-switcher-inline\">\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Streets\"\n            >\n              🛣️\n            </button>\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Satellite\"\n            >\n              🛰️\n            </button>\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Topographic\"\n            >\n              🗺️\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Help Button - Fixed Position -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"displayPlanSummary && (() =>\"><div class=\"plan-summary-card\">\n      <div class=\"plan-summary-header\">\n        <span>Plan Drafts</span>\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"sharedMapStateTimestamp\"><small>Updated <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"sharedMapStateTimestamp.toLocaleTimeString()\"></span></small></div>\n      </div>\n      <div class=\"plan-summary-total\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"displayPlanSummary.total\"></span> objects</div>\n      <div class=\"plan-summary-grid\">\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"Object.entries(displayPlanSummary.byType ?? ) as [type, count]\"><div class=\"plan-summary-item\">\n            <span class=\"label\"></span>\n            <span class=\"value\"></span>\n          </div></div>\n      </div>\n    </div></div>\n\n  <!-- Filters Modal -->\n  \n\n  <!-- Statistics Modal -->\n  \n\n  <!-- Messages -->\n  \n  \n  \n</div>\n\n<!-- Unified Device Management -->\n<div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"DeviceManagementPanel\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>c1</td><td>active</td></tr></tbody></table></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"selectedDevice = e.detail.device; e.detail.deviceType;\n\"></span>}\n/>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"UnifiedDeviceDetailsModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showUnifiedDeviceModal = false; null;\"></span>}\n/>\n\n<!-- Modals -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddSiteModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddNOCModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddWarehouseModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddVehicleModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddRMAModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddSectorModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddCPEModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddBackhaulLinkModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddInventoryModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<!-- Context Menus -->\n<div class=\"cwl-map-shell\" data-cwl-map-shell=\"MapContextMenu\" aria-hidden=\"true\" role=\"img\"></div>\n\n<nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"TowerActionsMenu\" aria-hidden=\"true\"></nav>\n\n<nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"SectorActionsMenu\" aria-hidden=\"true\"></nav>\n\n<nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"BackhaulActionsMenu\" aria-hidden=\"true\"></nav>\n\n<!-- EPC Deployment Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"EPCDeploymentModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showEPCDeploymentModal = false; null;\"></span>}\n/>\n\n<!-- HSS Registration Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HSSRegistrationModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showHSSRegistrationModal = false; null;\"></span>}\n/>\n\n<!-- Hardware Deployment Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HardwareDeploymentModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showHardwareDeploymentModal = false; null;\"></span>}\n/>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<!-- Site Edit Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SiteEditModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showSiteEditModal = false; null;\"></span>}\n/>\n\n<!-- Global Settings Button - Removed from modules -->";
}

@page GET "/modules/customers"
page modules_customers_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"customers-page\">\n    <div class=\"page-header\">\n      <div class=\"header-content\">\n        <div class=\"header-top\">\n          <button class=\"back-btn\" title=\"Back to Module Manager\">\n            ←\n          </button>\n          <h1>👥 Customer Management</h1>\n        </div>\n        <p class=\"subtitle\">Manage your tenant's customers, service plans, and customer groups</p>\n      </div>\n      <div class=\"header-actions\">\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"if (e.detail?.id === 'customer-onboarding') true;\"></span>}\n          />\n          <button class=\"btn-primary\">\n            ➕ Add Customer\n          </button>\n      </div>\n    </div>\n    \n    <!-- Navigation Tabs -->\n    <div class=\"tabs\">\n      <button\n      >\n        👥 Customers\n      </button>\n      <button\n      >\n        📡 Service Plans\n      </button>\n      <button\n      >\n        📦 Customer Groups\n      </button>\n      <button\n      >\n        🌐 Portal\n      </button>\n    </div>\n    \n    \n    \n    \n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      <!-- Customers Tab -->\n        <!-- Stats Cards -->\n        <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">3</div>\n        <div class=\"stat-label\">Total Customers</div>\n      </div>\n      <div class=\"stat-card stat-active\">\n        <div class=\"stat-value\">2</div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card stat-pending\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Pending</div>\n      </div>\n      <div class=\"stat-card stat-suspended\">\n        <div class=\"stat-value\">0</div>\n        <div class=\"stat-label\">Suspended</div>\n      </div>\n    </div>\n    \n    <!-- Search and Filters -->\n    <div class=\"filters-section\">\n      <div class=\"search-bar\">\n        <input\n          type=\"text\"\n          placeholder=\"Search by name, phone, email, or customer ID...\"\n          class=\"search-input\"\n        />\n      </div>\n      \n      <div class=\"filter-controls\">\n        <select>\n          <option>All Statuses</option>\n          <option value=\"active\">Active</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"suspended\">Suspended</option>\n          <option value=\"cancelled\">Cancelled</option>\n          <option value=\"trial\">Trial</option>\n        </select>\n        \n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" />\n          Show Inactive\n        </label>\n      </div>\n    </div>\n    \n    <!-- Customer List -->\n    <div class=\"customers-list\">\n      \n        <div class=\"customer-grid\">\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"customers as customer (customer._id || customer.customerId)\"><div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> $`}</h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n                  \n                </span>\n              </div>\n              \n              <div class=\"customer-details\">\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.primaryPhone\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">📞</span>\n                    <span></span>\n                  </div></div>\n                \n                <div class=\"detail-row\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n                \n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.serviceAddress?.street\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">📍</span>\n                    <span>\n                      \n                      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.serviceAddress.city\">,</div>\n                      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.serviceAddress.state\">,</div>\n                    </span>\n                  </div></div>\n                \n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.servicePlan?.planName\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">📡</span>\n                    <span>\n                      \n                      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.servicePlan.downloadMbps\">(/ Mbps)</div>\n                    </span>\n                  </div></div>\n                \n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.serviceType\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">📶</span>\n                    <span>Service Type: </span>\n                  </div></div>\n                \n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"customer.networkInfo?.imsi\"><div class=\"detail-row\">\n                    <span class=\"detail-icon\">🔢</span>\n                    <span>IMSI: </span>\n                  </div></div>\n              </div>\n              \n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a \n                  href=\"/modules/customers/portal/login\" \n                  target=\"_blank\" \n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div></div>\n        </div>\n      \n    </div>\n      \n        <!-- Service Plans Tab -->\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"BandwidthPlans\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>p1</td><td>active</td></tr><tr><td>p2</td><td>active</td></tr></tbody></table></div>\n      \n        <!-- Customer Groups Tab -->\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"GroupManagement\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>c1</td><td>active</td></tr><tr><td>c2</td><td>pending</td></tr><tr><td>c3</td><td>active</td></tr></tbody></table></div>\n    </div>\n  </div>\n  \n  \n  \n  \n\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"CustomerOnboardingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showOnboardingWizard = false; loadCustomers();\"></span>}\n  />";
}

@page GET "/modules/customers/portal"
page modules_customers_portal_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  return html "<div class=\"redirecting\">\n  <p>Redirecting...</p>\n</div>";
}

@page GET "/modules/customers/portal-setup"
page modules_customers_portal_setup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal-setup", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"portal-admin-page\">\n    <div class=\"page-header\">\n      <div class=\"header-left\">\n        <button class=\"back-btn\" title=\"Back to Modules\">\n          ← Exit to Modules\n        </button>\n      </div>\n      <div class=\"header-content\">\n        <h1>🌐 Customer Portal Management</h1>\n        <p class=\"subtitle\">Configure your customer-facing portal, content, and support features</p>\n      </div>\n      <div class=\"header-actions\">\n        <a target=\"_blank\" class=\"btn-secondary\">\n          View Portal →\n        </a>\n      </div>\n    </div>\n    \n    \n    \n    \n    \n    <!-- Tab Navigation -->\n    <div class=\"tab-navigation\">\n      <button class=\"tab-btn\">\n        🎨 Branding\n      </button>\n      <button class=\"tab-btn\">\n        ⚙️ Features\n      </button>\n      <button class=\"tab-btn\">\n        💳 Billing Portal\n      </button>\n      <button class=\"tab-btn\">\n        🚨 Alerts & Outages\n      </button>\n      <button class=\"tab-btn\">\n        ❓ FAQ\n      </button>\n      <button class=\"tab-btn\">\n        📚 Knowledge Base\n      </button>\n      <button class=\"tab-btn\">\n        💬 Live Chat\n      </button>\n    </div>\n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      <!-- Branding Tab -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"currentTab === 'branding'\"><div class=\"content-section\">\n          <h2>Portal Branding</h2>\n          <p class=\"section-description\">Customize the look and feel of your customer portal.</p>\n          \n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Company Name</label>\n              <div class=\"readonly-value\">Not set</div>\n              <p class=\"help-text\">Managed from tenant settings</p>\n            </div>\n            \n            <div class=\"form-group\">\n              <label>Portal URL</label>\n              <div class=\"readonly-value url-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"getPortalUrl()\"></span></div>\n            </div>\n            \n            <div class=\"form-group\">\n              <label>Logo URL</label>\n              <input type=\"url\" placeholder=\"https://yourcompany.com/logo.png\" class=\"form-input\" />\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"logoUrl\"><div class=\"logo-preview\">\n                  <img alt=\"Logo preview\" />\n                </div></div>\n            </div>\n            \n            <div class=\"form-group\">\n              <label>Primary Color</label>\n              <div class=\"color-input-group\">\n                <input type=\"color\" class=\"color-picker\" />\n                <input type=\"text\" placeholder=\"#3b82f6\" class=\"form-input color-text\" />\n              </div>\n            </div>\n            \n            <div class=\"form-group\">\n              <label>Support Email</label>\n              <input type=\"email\" placeholder=\"support@yourcompany.com\" class=\"form-input\" />\n            </div>\n            \n            <div class=\"form-group\">\n              <label>Support Phone</label>\n              <input type=\"tel\" placeholder=\"(555) 123-4567\" class=\"form-input\" />\n            </div>\n            \n            <div class=\"form-group full-width\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Use Custom Domain</span>\n              </label>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"enableCustomDomain\"><input type=\"text\" placeholder=\"portal.yourcompany.com\" class=\"form-input\" />\n                <p class=\"help-text\">Point your domain's CNAME record to: <code>wisptools.io</code></p></div>\n            </div>\n          </div>\n          \n          <div class=\"form-actions\">\n            <button class=\"btn-primary\">\n              Save Branding\n            </button>\n          </div>\n        </div></div>\n      \n      <!-- Billing Portal Tab: payment gateways & invoice customization -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"currentTab === 'billing'\"><div class=\"content-section\">\n          <h2>Billing Portal Admin</h2>\n          <p class=\"section-description\">Configure payment gateways (Stripe, PayPal) and customize how invoices look for your customers.</p>\n          \n          <div class=\"billing-portal-sections\">\n            <section class=\"billing-subsection\">\n              <h3>Payment Gateways</h3>\n              <p class=\"help-text\">Enable online payments in the customer portal. Store Stripe secret key in backend env (STRIPE_SECRET_KEY); use the publishable key here for the portal. For PayPal, use your client ID and choose sandbox for testing.</p>\n              \n              <div class=\"form-grid\">\n                <div class=\"form-group full-width\">\n                  <label class=\"toggle-label\">\n                    <input type=\"checkbox\" />\n                    <span class=\"toggle-switch\"></span>\n                    <span>Enable Stripe</span>\n                  </label>\n                  <input type=\"text\" placeholder=\"pk_live_... or pk_test_... (publishable key)\" class=\"form-input\" />\n                  <input type=\"text\" placeholder=\"Optional note (e.g. key purpose)\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label class=\"toggle-label\">\n                    <input type=\"checkbox\" />\n                    <span class=\"toggle-switch\"></span>\n                    <span>Enable PayPal</span>\n                  </label>\n                  <input type=\"text\" placeholder=\"PayPal client ID\" class=\"form-input\" />\n                  <label class=\"checkbox-label\">\n                    <input type=\"checkbox\" />\n                    Use PayPal sandbox (testing)\n                  </label>\n                  <input type=\"text\" placeholder=\"Optional note\" class=\"form-input\" />\n                </div>\n              </div>\n            </section>\n            \n            <section class=\"billing-subsection\">\n              <h3>Invoice Customization</h3>\n              <p class=\"help-text\">These appear on generated invoices and in the customer billing portal.</p>\n              \n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>Company name on invoices</label>\n                  <input type=\"text\" placeholder=\"Your WISP Name\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group\">\n                  <label>Invoice logo URL</label>\n                  <input type=\"url\" placeholder=\"https://...\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label>Address (on invoice)</label>\n                  <input type=\"text\" placeholder=\"Street, City, State ZIP\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label>Footer text</label>\n                  <input type=\"text\" placeholder=\"Thank you for your business\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group full-width\">\n                  <label>Terms & conditions</label>\n                  <textarea placeholder=\"Payment terms, late fees, etc.\" class=\"form-input\" rows=\"4\"></textarea>\n                </div>\n                <div class=\"form-group\">\n                  <label>Default due days</label>\n                  <input type=\"number\" min=\"1\" max=\"90\" class=\"form-input\" />\n                </div>\n                <div class=\"form-group\">\n                  <label>Currency</label>\n                  <select class=\"form-input\">\n                    <option value=\"USD\">USD</option>\n                    <option value=\"CAD\">CAD</option>\n                    <option value=\"EUR\">EUR</option>\n                    <option value=\"GBP\">GBP</option>\n                  </select>\n                </div>\n              </div>\n            </section>\n          </div>\n          \n          <div class=\"form-actions\">\n            <button class=\"btn-primary\">\n              Save Billing Portal Settings\n            </button>\n          </div>\n        </div></div>\n      \n      <!-- Features Tab -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"currentTab === 'features'\"><div class=\"content-section\">\n          <h2>Portal Features</h2>\n          <p class=\"section-description\">Enable or disable features for your customer portal.</p>\n          \n          <div class=\"feature-toggles\">\n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">❓ FAQ / Help Center</span>\n                  <span class=\"toggle-description\">Show frequently asked questions to customers</span>\n                </div>\n              </label>\n            </div>\n            \n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">🚨 Service Status & Outages</span>\n                  <span class=\"toggle-description\">Display service alerts and outage notifications</span>\n                </div>\n              </label>\n            </div>\n            \n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">💳 Billing & Invoices</span>\n                  <span class=\"toggle-description\">Let customers view billing and invoice history</span>\n                </div>\n              </label>\n            </div>\n            \n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">🎫 Support Tickets</span>\n                  <span class=\"toggle-description\">Let customers open and track support tickets</span>\n                </div>\n              </label>\n            </div>\n            \n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">📚 Knowledge Base</span>\n                  <span class=\"toggle-description\">Provide documentation and help articles</span>\n                </div>\n              </label>\n            </div>\n            \n            <div class=\"feature-toggle\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">💬 Live Chat Support</span>\n                  <span class=\"toggle-description\">Enable real-time chat with customers</span>\n                </div>\n              </label>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"enableLiveChat\"><div class=\"form-group\" style=\"margin-top: 0.75rem; margin-left: 2.5rem;\">\n                  <label>Chat widget embed code (e.g. Tawk.to, Crisp, Intercom)</label>\n                  <textarea rows=\"4\" class=\"form-input\" placeholder=\"Paste the &lt;script&gt;...&lt;/script&gt; snippet from your chat provider\"></textarea>\n                  <p class=\"hint\">Paste the full script tag(s) from your chat provider. The widget will load on all portal pages when Live Chat is enabled.</p>\n                </div></div>\n            </div>\n          </div>\n          \n          <div class=\"form-actions\">\n            <button class=\"btn-primary\">\n              Save Features\n            </button>\n          </div>\n        </div></div>\n      \n      <!-- Alerts Tab -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"currentTab === 'alerts'\"><div class=\"content-section\">\n          <div class=\"section-header\">\n            <div>\n              <h2>Alerts & Outages</h2>\n              <p class=\"section-description\">Notify customers about service issues, maintenance, and updates.</p>\n            </div>\n            <button class=\"btn-primary\">\n              + New Alert\n            </button>\n          </div>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showAlertForm\"><div class=\"form-card\">\n              <h3>Create New Alert</h3>\n              \n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>Title</label>\n                  <input type=\"text\" placeholder=\"Alert title\" class=\"form-input\" />\n                </div>\n                \n                <div class=\"form-group\">\n                  <label>Type</label>\n                  <select class=\"form-input\">\n                    <option value=\"info\">ℹ️ Information</option>\n                    <option value=\"warning\">⚠️ Warning</option>\n                    <option value=\"outage\">🔴 Outage</option>\n                    <option value=\"maintenance\">🟡 Maintenance</option>\n                  </select>\n                </div>\n                \n                <div class=\"form-group\">\n                  <label>Status</label>\n                  <select class=\"form-input\">\n                    <option value=\"active\">Active</option>\n                    <option value=\"scheduled\">Scheduled</option>\n                    <option value=\"resolved\">Resolved</option>\n                  </select>\n                </div>\n                \n                <div class=\"form-group full-width\">\n                  <label>Message</label>\n                  <textarea placeholder=\"Alert message...\" class=\"form-input\" rows=\"3\"></textarea>\n                </div>\n                \n                <div class=\"form-group\">\n                  <label>Start Date (optional)</label>\n                  <input type=\"datetime-local\" class=\"form-input\" />\n                </div>\n                \n                <div class=\"form-group\">\n                  <label>End Date (optional)</label>\n                  <input type=\"datetime-local\" class=\"form-input\" />\n                </div>\n              </div>\n              \n              <div class=\"form-actions\">\n                <button class=\"btn-secondary\">Cancel</button>\n                <button class=\"btn-primary\">\n                  Save Alert\n                </button>\n              </div>\n            </div></div>\n          \n          <div class=\"items-list\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"alerts.length === 0\"><div class=\"empty-state\">\n                <p>No alerts yet. Create one to notify your customers.</p>\n              </div></div>\n          </div>\n        </div></div>\n      \n      <!-- FAQ Tab -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"currentTab === 'faq'\"><div class=\"content-section\">\n          <div class=\"section-header\">\n            <div>\n              <h2>FAQ Management</h2>\n              <p class=\"section-description\">Create and manage frequently asked questions.</p>\n            </div>\n            <button class=\"btn-primary\">\n              + New FAQ\n            </button>\n          </div>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showFAQForm\"><div class=\"form-card\">\n              <h3>Create New FAQ</h3>\n              \n              <div class=\"form-grid\">\n                <div class=\"form-group full-width\">\n                  <label>Question</label>\n                  <input type=\"text\" placeholder=\"What is your question?\" class=\"form-input\" />\n                </div>\n                \n                <div class=\"form-group\">\n                  <label>Category</label>\n                  <select class=\"form-input\">\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"faqCategories as category\"><option></option></div>\n                  </select>\n                </div>\n                \n                <div class=\"form-group\">\n                  <label class=\"checkbox-label inline\">\n                    <input type=\"checkbox\" />\n                    <span>Published</span>\n                  </label>\n                </div>\n                \n                <div class=\"form-group full-width\">\n                  <label>Answer</label>\n                  <textarea placeholder=\"Provide the answer...\" class=\"form-input\" rows=\"4\"></textarea>\n                </div>\n              </div>\n              \n              <div class=\"form-actions\">\n                <button class=\"btn-secondary\">Cancel</button>\n                <button class=\"btn-primary\">\n                  Save FAQ\n                </button>\n              </div>\n            </div></div>\n          \n          <div class=\"items-list\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"faqItems.length === 0\"><div class=\"empty-state\">\n                <p>No FAQs yet. Create some to help your customers.</p>\n              </div></div>\n          </div>\n        </div></div>\n      \n      <!-- Knowledge Base Tab -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"currentTab === 'knowledge'\"><div class=\"content-section\">\n          <div class=\"section-header\">\n            <div>\n              <h2>Knowledge Base</h2>\n              <p class=\"section-description\">Create help articles and documentation for customers.</p>\n            </div>\n            <button class=\"btn-primary\">\n              + New Article\n            </button>\n          </div>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showArticleForm\"><div class=\"form-card\">\n              <h3>Create New Article</h3>\n              \n              <div class=\"form-grid\">\n                <div class=\"form-group full-width\">\n                  <label>Title</label>\n                  <input type=\"text\" placeholder=\"Article title\" class=\"form-input\" />\n                </div>\n                \n                <div class=\"form-group\">\n                  <label>Category</label>\n                  <select class=\"form-input\">\n                    <option value=\"Getting Started\">Getting Started</option>\n                    <option value=\"Account\">Account</option>\n                    <option value=\"Billing\">Billing</option>\n                    <option value=\"Technical\">Technical</option>\n                    <option value=\"Troubleshooting\">Troubleshooting</option>\n                  </select>\n                </div>\n                \n                <div class=\"form-group\">\n                  <label class=\"checkbox-label inline\">\n                    <input type=\"checkbox\" />\n                    <span>Published</span>\n                  </label>\n                </div>\n                \n                <div class=\"form-group full-width\">\n                  <label>Tags</label>\n                  <div class=\"tags-input\">\n                    <input type=\"text\" placeholder=\"Add tags (comma separated)\" class=\"form-input\" />\n                    <button class=\"btn-secondary btn-sm\">Add</button>\n                  </div>\n                  <div class=\"tags-list\">\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"newArticle.tags as tag\"><span class=\"tag\"> <button>×</button></span></div>\n                  </div>\n                </div>\n                \n                <div class=\"form-group full-width\">\n                  <label>Content</label>\n                  <textarea placeholder=\"Write your article content...\" class=\"form-input\" rows=\"8\"></textarea>\n                </div>\n              </div>\n              \n              <div class=\"form-actions\">\n                <button class=\"btn-secondary\">Cancel</button>\n                <button class=\"btn-primary\">\n                  Save Article\n                </button>\n              </div>\n            </div></div>\n          \n          <div class=\"items-list\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"kbArticles.length === 0\"><div class=\"empty-state\">\n                <p>No articles yet. Create documentation to help your customers.</p>\n              </div></div>\n          </div>\n        </div></div>\n      \n      <!-- Live Chat Tab -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"currentTab === 'chat'\"><div class=\"content-section\">\n          <h2>Live Chat Settings</h2>\n          <p class=\"section-description\">Configure real-time chat support for your customers.</p>\n          \n          <div class=\"form-grid\">\n            <div class=\"form-group full-width\">\n              <label class=\"toggle-label\">\n                <input type=\"checkbox\" />\n                <span class=\"toggle-switch\"></span>\n                <div class=\"toggle-content\">\n                  <span class=\"toggle-title\">Enable Live Chat</span>\n                  <span class=\"toggle-description\">Show chat widget on customer portal</span>\n                </div>\n              </label>\n            </div>\n            \n            <div class=\"form-group full-width\">\n              <label>Welcome Message</label>\n              <textarea placeholder=\"Hello! How can we help?\" class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n            \n            <div class=\"form-group full-width\">\n              <label>Offline Message</label>\n              <textarea placeholder=\"We're offline, leave a message...\" class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n            \n            <div class=\"form-group full-width\">\n              <label class=\"checkbox-label\">\n                <input type=\"checkbox\" />\n                <span>Set Operating Hours</span>\n              </label>\n            </div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"chatSettings.operatingHours.enabled\"><div class=\"form-group\">\n                <label>Start Time</label>\n                <input type=\"time\" class=\"form-input\" />\n              </div>\n              \n              <div class=\"form-group\">\n                <label>End Time</label>\n                <input type=\"time\" class=\"form-input\" />\n              </div></div>\n            \n            <div class=\"form-group full-width\">\n              <h4>Auto Responses</h4>\n            </div>\n            \n            <div class=\"form-group full-width\">\n              <label>Greeting Message</label>\n              <textarea class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n            \n            <div class=\"form-group full-width\">\n              <label>Away Message</label>\n              <textarea class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n            \n            <div class=\"form-group full-width\">\n              <label>Closed Message</label>\n              <textarea class=\"form-input\" rows=\"2\"></textarea>\n            </div>\n          </div>\n          \n          <div class=\"form-actions\">\n            <button class=\"btn-primary\">\n              Save Chat Settings\n            </button>\n          </div>\n        </div></div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/billing"
page modules_customers_portal_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/billing", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"billing-page\">\\r\n    <h1>Billing &amp; Account</h1>\\r\n    <p class=\"subtitle\">Your plan, billing cycle, and balance. <a href=\"/modules/customers/portal/billing/settings\" class=\"link-settings\">Billing settings</a></p>\\r\n\\r\n    \\r\n\\r\n    \\r\n  </div>";
}

@page GET "/modules/customers/portal/billing/settings"
page modules_customers_portal_billing_settings_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/billing/settings", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"billing-settings-page\">\\r\n    <h1>Billing settings</h1>\\r\n    <p class=\"subtitle\">Payment method and invoice preferences</p>\\r\n\\r\n    \\r\n    \\r\n\\r\n    <form on:submit|preventDefault=<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"handleSave\"></span> class=\"settings-form\">\\r\n      \\r\n\\r\n      <section class=\"settings-section\">\\r\n        <h2>Invoice delivery</h2>\\r\n        <p class=\"hint\">How you want to receive invoices.</p>\\r\n        <label>\\r\n          <input type=\"radio\" value=\"email\" />\\r\n          Email only\\r\n        </label>\\r\n        <label>\\r\n          <input type=\"radio\" value=\"portal\" />\\r\n          Portal only (view in Billing page)\\r\n        </label>\\r\n        <label>\\r\n          <input type=\"radio\" value=\"both\" />\\r\n          Both email and portal\\r\n        </label>\\r\n      </section>\\r\n\\r\n      <section class=\"settings-section read-only\">\\r\n        <h2>Invoice format</h2>\\r\n        <p class=\"hint\">Set by your provider (read-only).</p>\\r\n        <div class=\"info-rows\">\\r\n          <div class=\"info-row\">\\r\n            <span class=\"label\">Company name</span>\\r\n            <span class=\"value\">—</span>\\r\n          </div>\\r\n          <div class=\"info-row\">\\r\n            <span class=\"label\">Payment due (days)</span>\\r\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"invoiceFormat.dueDays\"></span></span>\\r\n          </div>\\r\n          <div class=\"info-row\">\\r\n            <span class=\"label\">Currency</span>\\r\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"invoiceFormat.currency\"></span></span>\\r\n          </div>\\r\n        </div>\\r\n      </section>\\r\n\\r\n      <div class=\"actions\">\\r\n        <button type=\"submit\" class=\"btn-primary\">\\r\n          Save settings\\r\n        </button>\\r\n        <a href=\"/modules/customers/portal/billing\" class=\"btn-secondary\">Back to Billing</a>\\r\n      </div>\\r\n    </form>\\r\n  </div>";
}

@page GET "/modules/customers/portal/dashboard"
page modules_customers_portal_dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/dashboard", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"dashboard\">\n    <div class=\"dashboard-header\">\n      <h1>Welcome, Alex!</h1>\n      <p class=\"subtitle\">Manage your tickets and view your service information</p>\n    </div>\n    \n    <div class=\"dashboard-stats\">\n      <div class=\"stat-card\">\n          <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.totalTickets\"></span></div>\n          <div class=\"stat-label\">Total Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.openTickets\"></span></div>\n          <div class=\"stat-label\">Open Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.resolvedTickets\"></span></div>\n          <div class=\"stat-label\">Resolved</div>\n        </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">active</div>\n        <div class=\"stat-label\">Service Status</div>\n      </div>\n    </div>\n    \n    <div class=\"dashboard-actions\">\n        <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n          Create New Ticket\n        </a>\n        <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">\n          View All Tickets\n        </a>\n      </div>\n    \n    <div class=\"support-tools\">\n        <div class=\"support-card\">\n            <h3>Billing &amp; Account</h3>\n            <p>View your plan, billing cycle, balance, and next billing date.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/billing\">View Billing</a>\n            <a class=\"support-link secondary\" href=\"/modules/customers/portal/billing/settings\">Billing settings</a>\n          </div>\n        <div class=\"support-card\">\n            <h3>Service Status &amp; Outages</h3>\n            <p>Check real-time service health, scheduled maintenance, and network alerts.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/service\">View Status</a>\n          </div>\n        <div class=\"support-card\">\n            <h3>FAQ &amp; Help Center</h3>\n            <p>Browse answers to the most common account, billing, and technical questions.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/faq\">Visit FAQ</a>\n          </div>\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"featureFlags.knowledgeBase\"><div class=\"support-card\">\n            <h3>Knowledge Base</h3>\n            <p>Step-by-step guides and tutorials curated by our team.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/knowledge\">Browse Articles</a>\n          </div></div>\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"featureFlags.liveChat\"><div class=\"support-card\">\n            <h3>Live Chat Support</h3>\n            <p>Connect with a support specialist for hands-on troubleshooting.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/live-chat\">Start Chat</a>\n          </div></div>\n      </div>\n    \n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"featureFlags.tickets && tickets.length > 0\"><div class=\"recent-tickets\">\n        <h2>Recent Tickets</h2>\n        <div class=\"tickets-list\">\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"tickets.slice(0, 5) as ticket\"><div class=\"ticket-card\">\n              <div class=\"ticket-header\">\n                <span class=\"ticket-number\"></span>\n                <span \n                  class=\"ticket-status\" \n                  style=\"background: \"\n                >\n                  \n                </span>\n              </div>\n              <h3 class=\"ticket-title\"></h3>\n              <p class=\"ticket-description\"></p>\n              <div class=\"ticket-meta\">\n                <span>Priority: </span>\n                <span>Created: </span>\n              </div>\n            </div></div>\n        </div>\n      </div></div>\n    \n    <div class=\"service-info\">\n        <h2>Service Information</h2>\n        <div class=\"info-card\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Service Status:</span>\n            <span class=\"info-value\">active</span>\n          </div>\n          <div class=\"info-row\">\n              <span class=\"info-label\">Service Plan:</span>\n              <span class=\"info-value\">Residential 100</span>\n            </div>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"serviceInfo.serviceAddress\"><div class=\"info-row\">\n              <span class=\"info-label\">Service Address:</span>\n              <span class=\"info-value\">\n                \n                ,  \n              </span>\n            </div></div>\n        </div>\n      </div>\n  </div>";
}

@page GET "/modules/customers/portal/faq"
page modules_customers_portal_faq_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/faq", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"faq-page\">\n    <h1>WISP Management Help Center</h1>\n    <p class=\"subtitle\">Quick answers to the most common questions from subscribers.</p>\n    <input\n      type=\"search\"\n      class=\"faq-search\"\n      placeholder=\"Search FAQ…\"\n      aria-label=\"Search FAQ\"\n    />\n    <div class=\"faq-list\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"displayFaqs as faq\"><details class=\"faq-item\">\n          <summary></summary>\n          <p></p>\n        </details></div>\n    </div>\n    \n    <div class=\"contact-card\">\n      <h2>Still need help?</h2>\n      <p>Open a support ticket from the dashboard or contact our team directly.</p>\n      <div class=\"contact-links\">\n        <a class=\"btn-link\">Email Support</a>\n        \n      </div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/knowledge"
page modules_customers_portal_knowledge_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/knowledge", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"knowledge-page\">\n    <header>\n      <h1>WISP Management Knowledge Base</h1>\n      <p class=\"subtitle\">Self-service guides curated by our support engineers.</p>\n      <div class=\"kb-filters\">\n        <input\n          type=\"search\"\n          class=\"kb-search\"\n          placeholder=\"Search articles…\"\n          aria-label=\"Search knowledge base\"\n        />\n        <select class=\"kb-category\" aria-label=\"Filter by category\">\n            <option>All categories</option>\n            <option></option><option></option><option></option><option></option>\n          </select>\n      </div>\n    </header>\n    <section class=\"guides-grid\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"displayItems as article\"><article class=\"guide-card\">\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"article._id\"><a href=\"/modules/customers/portal/knowledge/\" class=\"guide-link\">\n              <h2></h2>\n              <p></p>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"article.category\"><span class=\"meta\"></span></div>\n            </a></div>\n        </article></div>\n    </section>\n  </div>";
}

@page GET "/modules/customers/portal/knowledge/:id"
page modules_customers_portal_knowledge_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/knowledge/:id", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<article class=\"article-page\">\\r\n    <a href=\"/modules/customers/portal/knowledge\" class=\"back-link\">← Back to Knowledge Base</a>\\r\n    <header>\\r\n      <h1><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"article.title\"></span></h1>\\r\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"article.category\"><span class=\"category\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"article.category\"></span></span></div>\\r\n    </header>\\r\n    <div class=\"content\"></div>\\r\n  </article>";
}

@page GET "/modules/customers/portal/live-chat"
page modules_customers_portal_live_chat_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/live-chat", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"chat-page\">\n    <h1>Live Chat with WISP Management</h1>\n    <p class=\"subtitle\">Chat is monitored <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"supportHours\"></span>. Start a conversation and we’ll respond as soon as a specialist is available.</p>\n    \n    <div class=\"chat-wrapper\">\n      <div class=\"chat-placeholder\">        \n      </div>\n      <div class=\"fallback-card\">\n        <h2>Need immediate help?</h2>\n        <p>If chat is offline, use one of the options below.</p>\n        <a class=\"btn-link\">Email <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"supportEmail\"></span></a>\n        \n      </div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/login"
page modules_customers_portal_login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/login", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"login-page\">\n  <div class=\"login-container\">\n    <div class=\"login-header\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"branding?.logo?.url\"><img class=\"login-logo\" /></div>\n      <h2>Sign In</h2>\n      <p class=\"login-subtitle\">Access your account to view tickets and service information</p>\n    </div>\n    \n      <form class=\"login-form\">\n      \n      \n      <div class=\"form-group\">\n        <label for=\"identifier\">Customer ID, Email, or Phone</label>\n        <input\n          id=\"identifier\"\n          type=\"text\"\n          placeholder=\"Enter your customer ID, email, or phone\"\n          required\n        />\n      </div>\n      \n      <div class=\"form-group\">\n        <label for=\"password\">Password</label>\n        <input\n          id=\"password\"\n          type=\"password\"\n          placeholder=\"Enter your password\"\n          required\n        />\n      </div>\n      \n      <button type=\"submit\" class=\"btn-primary\">\n        Sign In\n      </button>\n    </form>\n    <div class=\"login-links\">\n      \n    </div>\n  </div>\n</div>";
}

@page GET "/modules/customers/portal/service"
page modules_customers_portal_service_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/service", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"service-page\">\n    <p class=\"back-link\"><a href=\"/modules/customers/portal/dashboard\">← Back to Dashboard</a></p>\n    <h1>Service Information</h1>\n    \n    <div class=\"service-details\">\n      <div class=\"info-section\">\n        <h2>Service Status</h2>\n        <div class=\"info-card\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Status:</span>\n            <span class=\"info-value status-\">\n              active\n            </span>\n          </div>\n          <div class=\"info-row\">\n              <span class=\"info-label\">Service Plan:</span>\n              <span class=\"info-value\">Residential 100</span>\n            </div>\n        </div>\n      </div>\n      \n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"serviceInfo?.serviceAddress\"><div class=\"info-section\">\n          <h2>Service Address</h2>\n          <div class=\"info-card\">\n            <div class=\"info-row\">\n              <span class=\"info-label\">Address:</span>\n              <span class=\"info-value\">\n                \n                ,  \n              </span>\n            </div>\n          </div>\n        </div></div>\n      \n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"serviceInfo?.equipment && serviceInfo.equipment.length > 0\"><div class=\"info-section\">\n          <h2>Equipment</h2>\n          <div class=\"equipment-list\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"serviceInfo.equipment as equipment\"><div class=\"equipment-card\">\n                <div class=\"equipment-header\">\n                  <span class=\"equipment-type\"></span>\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"equipment.serialNumber\"><span class=\"equipment-serial\">SN: </span></div>\n                </div>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"equipment.model\"><div class=\"equipment-detail\">Model: </div></div>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"equipment.installDate\"><div class=\"equipment-detail\">\n                    Installed: \n                  </div></div>\n              </div></div>\n          </div>\n        </div></div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/signup"
page modules_customers_portal_signup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/signup", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"signup-page\">\n  <div class=\"signup-container\">\n    <div class=\"signup-header\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"branding?.logo?.url\"><img class=\"signup-logo\" /></div>\n      <h2>Create Account</h2>\n      <p class=\"signup-subtitle\">Link your customer account to access the portal</p>\n    </div>\n    \n    \n      <form class=\"signup-form\">\n        \n        \n        <div class=\"form-group\">\n          <label for=\"customerId\">Customer ID</label>\n          <input\n            id=\"customerId\"\n            type=\"text\"\n            placeholder=\"Enter your customer ID\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"phone\">Phone Number</label>\n          <input\n            id=\"phone\"\n            type=\"tel\"\n            placeholder=\"Enter your phone number\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"Enter your email\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"password\">Password</label>\n          <input\n            id=\"password\"\n            type=\"password\"\n            placeholder=\"Create a password (min 6 characters)\"\n            required\n            minlength=\"6\"\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"confirmPassword\">Confirm Password</label>\n          <input\n            id=\"confirmPassword\"\n            type=\"password\"\n            placeholder=\"Confirm your password\"\n            required\n          />\n        </div>\n        \n        <button type=\"submit\" class=\"btn-primary\">\n          Create Account\n        </button>\n        \n        <div class=\"signup-links\">\n          <a href=\"/modules/customers/portal/login\" class=\"link\">Already have an account? Sign in</a>\n        </div>\n      </form>\n    \n  </div>\n</div>";
}

@page GET "/modules/customers/portal/tickets"
page modules_customers_portal_tickets_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"tickets-page\">\n  <div class=\"page-header\">\n    <h1>My Tickets</h1>\n    <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n      Create New Ticket\n    </a>\n  </div>\n  \n  <div class=\"filters\">\n    <select class=\"filter-select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"open\">Open</option>\n      <option value=\"assigned\">Assigned</option>\n      <option value=\"in-progress\">In Progress</option>\n      <option value=\"waiting-parts\">Waiting Parts</option>\n      <option value=\"resolved\">Resolved</option>\n      <option value=\"closed\">Closed</option>\n    </select>\n  </div>\n  \n  \n    <div class=\"tickets-list\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"filteredTickets as ticket\"><div \n          class=\"ticket-card\"\n        >\n          <div class=\"ticket-header\">\n            <span class=\"ticket-number\"></span>\n            <span \n              class=\"ticket-status\" \n              style=\"background: \"\n            >\n              \n            </span>\n          </div>\n          <h3 class=\"ticket-title\"></h3>\n          <p class=\"ticket-description\"></p>\n          <div class=\"ticket-meta\">\n            <span>Priority: </span>\n            <span>Created: </span>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.resolvedAt\"><span>Resolved: </span></div>\n          </div>\n        </div></div>\n    </div>\n  \n</div>";
}

@page GET "/modules/customers/portal/tickets/:id"
page modules_customers_portal_tickets_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets/:id", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"ticket-details-page\">\n    <div class=\"page-header\">\n      <a href=\"/modules/customers/portal/tickets\" class=\"back-link\">← Back to Tickets</a>\n      <h1>Ticket Details</h1>\n    </div>\n    \n    <div class=\"ticket-details\">\n      <div class=\"ticket-header\">\n        <div>\n          <span class=\"ticket-number\">N/A</span>\n          <span \n            class=\"ticket-status\" \n            style=\"background:\"\n          >\n            <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"ticket.status\"></span>\n          </span>\n        </div>\n        <div class=\"ticket-meta\">\n          <span>Priority: <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"ticket.priority\"></span></span>\n          <span>Created: <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"new Date(ticket.createdAt || '').toLocaleDateString()\"></span></span>\n        </div>\n      </div>\n      \n      <div class=\"ticket-content\">\n        <h2><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"ticket.title\"></span></h2>\n        <p class=\"ticket-description\">No description</p>\n      </div>\n      \n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.workPerformed && ticket.workPerformed.length > 0\"><div class=\"ticket-history\">\n          <h3>Ticket History</h3>\n          <div class=\"history-list\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"ticket.workPerformed as work\"><div class=\"history-item\">\n                <div class=\"history-header\">\n                  <span class=\"history-action\"></span>\n                  <span class=\"history-date\">\n                    \n                  </span>\n                </div>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"work.performedByName\"><div class=\"history-performer\">\n                    By: \n                  </div></div>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"work.notes\"><div class=\"history-notes\"></div></div>\n              </div></div>\n          </div>\n        </div></div>\n      \n      <div class=\"add-comment\">\n        <h3>Add Comment</h3>\n        <form>\n          <textarea\n            placeholder=\"Add a comment or update...\"\n            rows=\"4\"\n          ></textarea>\n          <button type=\"submit\" class=\"btn-primary\">\n            Add Comment\n          </button>\n        </form>\n      </div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/tickets/new"
page modules_customers_portal_tickets_new_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets/new", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"create-ticket-page\">\n  <div class=\"page-header\">\n    <h1>Create New Ticket</h1>\n    <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Back to Tickets</a>\n  </div>\n  \n  <form class=\"ticket-form\">\n    \n    \n    <div class=\"form-group\">\n      <label for=\"title\">Title *</label>\n      <input\n        id=\"title\"\n        type=\"text\"\n        placeholder=\"Brief description of the issue\"\n        required\n      />\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"category\">Category</label>\n      <select id=\"category\">\n        <option value=\"slow-speed\">Slow Speed</option>\n        <option value=\"no-connection\">No Connection</option>\n        <option value=\"intermittent\">Intermittent Connection</option>\n        <option value=\"equipment-failure\">Equipment Failure</option>\n        <option value=\"billing-issue\">Billing Issue</option>\n        <option value=\"other\">Other</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"priority\">Priority</label>\n      <select id=\"priority\">\n        <option value=\"low\">Low</option>\n        <option value=\"medium\">Medium</option>\n        <option value=\"high\">High</option>\n        <option value=\"critical\">Critical</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"description\">Description *</label>\n      <textarea\n        id=\"description\"\n        placeholder=\"Please provide detailed information about the issue...\"\n        rows=\"6\"\n        required\n      ></textarea>\n    </div>\n    \n    <div class=\"form-actions\">\n      <button type=\"submit\" class=\"btn-primary\">\n        Create Ticket\n      </button>\n      <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Cancel</a>\n    </div>\n  </form>\n</div>";
}

@page GET "/modules/deploy"
page modules_deploy_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { moduleKey: "deploy", source: "wisp-m30", apiPath: "/api/deploy", api_ok: true, api_surface: "wisp-api-native", api_resource: "deploy", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      <div class=\"cwl-map-shell\" data-cwl-map-shell=\"SharedMap\" aria-hidden=\"true\" role=\"img\"></div>\n    </div>\n\n    <!-- Minimal Header Overlay -->\n    <!-- Deploy Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-success);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\"} title=\"Back to Dashboard\">\n          ←\n        </button>\n        <h1>🚀 Deploy</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n        <button \n          class=\"module-control-btn\" \n          title=\"Project Filters - Approved projects ready for deployment\"\n        >\n          <span class=\"control-icon\">🔍</span>\n          <span class=\"control-label\">Approved (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"approvedPlans.length\"></span>)</span>\n        </button>\n        <button class=\"module-control-btn\" title=\"Projects - View and manage all projects\">\n          <span class=\"control-icon\">📋</span>\n          <span class=\"control-label\">Projects (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"readyPlans.length\"></span>)</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"View Deployed Projects\"\n        >\n          <span class=\"control-icon\">✅</span>\n          <span class=\"control-label\">Deployed (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"deployedPlans.length\"></span>)</span>\n        </button>\n        <button \n          class=\"module-control-btn\"}\n        >\n          <span class=\"control-icon\">📊</span>\n          <span class=\"control-label\">PCI <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"lteSectorCount > 0 ? `(${lteSectorCount})` : ''\"></span></span>\n        </button>\n\n        <button \n          class=\"module-control-btn\"}\n        >\n          <span class=\"control-icon\">📡</span>\n          <span class=\"control-label\">Frequency <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"frequencySectorCount > 0 ? `(${frequencySectorCount})` : ''\"></span></span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"View and Edit Deployed Hardware\"\n        >\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Hardware (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"deployedCount\"></span>)</span>\n        </button>\n        \n        <button \n          class=\"module-control-btn deploy-btn\"\n        >\n          <span class=\"control-icon\">🚀</span>\n          <span class=\"control-label\">Deploy Plan</span>\n        </button>\n        \n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"if (e.detail.id === 'site-deployment') true;\n        \"></span>}\n        />\n      </div>\n    </div>\n\n  </div>\n\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"mapState?.activePlan\"><div class=\"plan-summary\">\n      <h3>Active Plan: <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"mapState.activePlan.name\"></span></h3>\n      <p class=\"summary-line\">\n        <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"mapState.stagedSummary.total\"></span> staged features • <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"mapState.productionHardware.length\"></span> production assets in view\n      </p>\n    </div></div>\n\n  \n\n  \n\n  <!-- PCI Planner Modal -->\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showPCIPlannerModal && ($currentTenant?.id || isAdmin)\"><div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"PCIPlannerModal\" aria-hidden=\"true\" role=\"dialog\"></div></div>\n\n  <!-- Frequency Planner Modal -->\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showFrequencyPlannerModal && ($currentTenant?.id || isAdmin)\"><div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"FrequencyPlannerModal\" aria-hidden=\"true\" role=\"dialog\"></div></div>\n\n  <!-- Plan Approval Modal -->\n  \n  \n  <!-- Deployed Hardware Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"DeployedHardwareModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n  <!-- Site Details Modal -->\n  \n\n  \n  \n  <!-- Add Inventory Modal -->\n  \n  \n  <!-- Site Edit Modal -->\n  \n  \n  <!-- EPC Deployment Modal -->\n  \n  \n  <!-- Project Filter Panel -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ProjectFilterPanel\" aria-hidden=\"true\"></nav> false}\n  />\n  \n  <!-- Deployment Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"DeploymentWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showDeploymentWizard = false; null;\n      deplo\"></span>}\n  />\n\n  <!-- Site Deployment Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"SiteDeploymentWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showSiteDeploymentWizard = false;\n      loadReadyPlans();\"></span>}\n  />\n\n  <!-- Plan Selection Modal (shows list of all plans) -->\n  \n  \n  <!-- Global Settings Button - Hidden in deploy mode, shown in coverage-map iframe instead -->\n\n  <!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

@page GET "/modules/hardware"
page modules_hardware_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/hardware", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"hardware-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>🔧 Hardware Management</h1>\n      <p class=\"subtitle\">Comprehensive equipment and hardware management system</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Check In\n      </button>\n      <button class=\"btn-secondary\">\n        📤 Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 Reports\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> true}\n      />\n      <!-- Add Hardware Dropdown -->\n      <div class=\"dropdown-container\">\n        <button class=\"btn-primary dropdown-toggle\">\n          ➕ Add Hardware ▼\n        </button>\n        \n      </div>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔧</div>\n      <div>\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.totalItems + epcDevices.length\"></span></div>\n        <div class=\"stat-label\">Total Hardware</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card clickable\">\n      <div class=\"stat-icon\">📡</div>\n      <div>\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">EPC/SNMP Devices</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"getStatusCount('available')\"></span></div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"getStatusCount('deployed') + epcDevices.filter(d => d.status === 'online').lengt\"></span></div>\n        <div class=\"stat-label\">Deployed/Online</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatCurrency(stats.totalValue)\"></span></div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🏗️</div>\n      <div>\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"getStatusCount('maintenance')\"></span></div>\n        <div class=\"stat-label\">In Maintenance</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Hardware Type Tabs -->\n  <div class=\"hardware-tabs\">\n    <button class=\"tab-btn\">\n      📋 All Hardware (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"items.length + epcDevices.length\"></span>)\n    </button>\n    <button class=\"tab-btn\">\n      📦 Inventory (3)\n    </button>\n    <button class=\"tab-btn\">\n      📡 EPC/SNMP Devices (1)\n    </button>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer, asset tag...\"\n        />\n        <button class=\"search-btn\">Search</button>\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"locationTypes as location\"><option></option></div>\n      </select>\n      \n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"manufacturers.length > 0\"><select>\n          <option>All Manufacturers</option>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"manufacturers as manufacturer\"><option></option></div>\n        </select></div>\n      \n      <button class=\"btn-clear\">\n        Clear Filters\n      </button>\n    </div>\n    \n    <!-- Category Quick Filters -->\n    <div class=\"category-filters\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"categoryList as category\">\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"count > 0\"><button\n            class=\"category-chip\">\n             ()\n          </button></div></div>\n    </div>\n  </div>\n  \n  <!-- Hardware Content -->\n  \n    <!-- EPC/SNMP Devices Section -->\n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"activeHardwareTab === 'epc'\"><!-- EPC Devices Section -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"epcDevices.length === 0\"><div class=\"empty-state\">\n          <span class=\"empty-icon\">📡</span>\n          <h3>No EPC devices deployed</h3>\n          <p>Deploy EPC devices from the Deploy module</p>\n          <button class=\"btn-primary\">\n            🚀 Go to Deploy\n          </button>\n        </div></div>\n      \n      <!-- Discovered SNMP Devices Section -->\n      <div class=\"snmp-section\" style=\"margin-top: 2rem;\">\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"SNMPDevicesPanel\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>dev-1</td><td>online</td></tr><tr><td>dev-2</td><td>offline</td></tr></tbody></table></div>\n      </div></div>\n  \n  \n  <!-- Inventory Items Section -->\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"!isLoading && (activeHardwareTab === 'inventory' || activeHardwareTab === 'all')\"><div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"items.length === 0 && activeHardwareTab === 'inventory'\"><div class=\"empty-state\">\n        <span class=\"empty-icon\">🔧</span>\n        <h3>No inventory items found</h3>\n        <p>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"searchQuery || selectedCategory || selectedStatus || selectedLocation\">Try adjusting your filters or search criteria</div>\n        </p>\n        <button class=\"btn-primary\">\n          ➕ Add Hardware\n        </button>\n      </div></div></div>\n</div>\n\n<!-- Scan Modal -->\n\n\n<!-- EPC Deployment Wizard -->\n\n\n<!-- EPC Edit Modal -->\n";
}

@page GET "/modules/help-desk"
page modules_help_desk_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/help-desk", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"help-desk-container\">\n  <div class=\"header\">\n    <button class=\"btn-back\">\n      ← Back to Modules\n    </button>\n    \n    <div class=\"title-section\">\n      <h1>🎧 Help Desk</h1>\n      <p class=\"subtitle\">Customer support and ticket management for Demo Tenant</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button \n        class=\"btn btn-secondary btn-reports\"\n        title=\"View Ticket Reports and Analytics\"\n      >\n        📊 Reports\n      </button>\n      <button class=\"btn btn-secondary\">\n        🔍 Customer Lookup\n      </button>\n      <button class=\"btn btn-primary\">\n        ➕ Create Ticket\n      </button>\n    </div>\n  </div>\n  \n  \n  \n  <div class=\"stats-grid\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon open\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.open\"></span></div>\n        <div class=\"stat-label\">Open Tickets</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon in-progress\">⚙️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.inProgress\"></span></div>\n        <div class=\"stat-label\">In Progress</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon resolved\">✅</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.resolved\"></span></div>\n        <div class=\"stat-label\">Resolved</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon time\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.avgResolutionTime\"></span></div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n  \n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search tickets, customers...\"\n      />\n    </div>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"open\">Open</option>\n      <option value=\"assigned\">Assigned</option>\n      <option value=\"in-progress\">In Progress</option>\n      <option value=\"waiting-parts\">Waiting Parts</option>\n      <option value=\"resolved\">Resolved</option>\n      <option value=\"closed\">Closed</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Priority</option>\n      <option value=\"critical\">Critical</option>\n      <option value=\"high\">High</option>\n      <option value=\"medium\">Medium</option>\n      <option value=\"low\">Low</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Categories</option>\n      <option value=\"customer-facing\">Customer-Facing</option>\n      <option value=\"infrastructure\">Infrastructure</option>\n    </select>\n    \n    <div class=\"results-count\">\n      <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"filteredTickets.length\"></span> of 1 tickets\n    </div>\n  </div>\n  \n  \n    <div class=\"tickets-grid\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"filteredTickets as ticket (ticket._id)\"><div class=\"ticket-card\">\n          <div class=\"ticket-header\">\n            <div>\n              <div class=\"ticket-number\"></div>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.ticketCategory\"><span class=\"ticket-category\"></span></div>\n            </div>\n            <div class=\"badges\">\n              <span class=\"badge \">\n                \n              </span>\n              <span class=\"badge \">\n                \n              </span>\n            </div>\n          </div>\n          \n          <h3 class=\"ticket-title\"></h3>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.description\"><p class=\"ticket-description\"></p></div>\n          \n          <div class=\"ticket-meta\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.affectedCustomers && ticket.affectedCustomers.length > 0\"><div class=\"meta-item\">\n                <span class=\"meta-icon\">👤</span>\n                <span class=\"meta-text\"></span>\n              </div></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.assignedToName\"><div class=\"meta-item\">\n                <span class=\"meta-icon\">👷</span>\n                <span class=\"meta-text\"></span>\n              </div></div>\n            \n            <div class=\"meta-item\">\n              <span class=\"meta-icon\">🕒</span>\n              <span class=\"meta-text\"></span>\n            </div>\n          </div>\n        </div></div>\n    </div>\n  \n</div>\n\n\n\n";
}

@page GET "/modules/help-desk/reports"
page modules_help_desk_reports_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/help-desk/reports", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"reports-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Help Desk\n      </button>\n      <h1>📊 Ticket Reports & Analytics</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn btn-primary\">\n        🖨️ Print PDF\n      </button>\n    </div>\n  </div>\n\n  \n    <!-- Summary Cards -->\n    <div class=\"summary-grid\">\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">🎧</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">10</div>\n          <div class=\"card-label\">Total Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card open\">\n        <div class=\"card-icon\">📋</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.summary.openTickets\"></span></div>\n          <div class=\"card-label\">Open Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card resolved\">\n        <div class=\"card-icon\">✅</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.summary.resolvedTickets\"></span></div>\n          <div class=\"card-label\">Resolved Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">⏱️</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatHours(report.summary.avgResolutionTime)\"></span></div>\n          <div class=\"card-label\">Avg Resolution Time</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Alerts -->\n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"report.alerts.slaBreached.length > 0\"><div class=\"alert-section warning\">\n        <h3>⚠️ SLA Breached Tickets (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.alerts.slaBreached.length\"></span>)</h3>\n        <ul>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"report.alerts.slaBreached.slice(0, 5) as ticket\"><li>\n              <strong></strong> -  -  priority\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.assignedToName\">(Assigned to: )</div>\n            </li></div>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"report.alerts.slaBreached.length > 5\"><li><em>...and <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.alerts.slaBreached.length - 5\"></span> more</em></li></div>\n        </ul>\n      </div></div>\n\n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"report.alerts.criticalOpen.length > 0\"><div class=\"alert-section critical\">\n        <h3>🔴 Critical Open Tickets (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.alerts.criticalOpen.length\"></span>)</h3>\n        <ul>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"report.alerts.criticalOpen.slice(0, 5) as ticket\"><li>\n              <strong></strong> - \n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"ticket.assignedToName\">(Assigned to: )</div>\n            </li></div>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"report.alerts.criticalOpen.length > 5\"><li><em>...and <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.alerts.criticalOpen.length - 5\"></span> more</em></li></div>\n        </ul>\n      </div></div>\n\n    <!-- Charts -->\n    <div class=\"charts-grid\">\n      <!-- Status Distribution -->\n      <div class=\"chart-card\">\n        <h3>Status Distribution</h3>\n        \n      </div>\n\n      <!-- Priority Distribution -->\n      <div class=\"chart-card\">\n        <h3>Priority Distribution</h3>\n        \n      </div>\n\n      <!-- Category Distribution -->\n      <div class=\"chart-card\">\n        <h3>Category Distribution</h3>\n        \n      </div>\n\n      <!-- Type Distribution -->\n      <div class=\"chart-card\">\n        <h3>Type Distribution</h3>\n        \n      </div>\n    </div>\n\n    <!-- Detailed Tables -->\n    <div class=\"table-section\">\n      <h3>By Status</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"Object.entries(report.summary.byStatus) as [status, count]\"><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"((count / report.summary.totalTickets) * 100).toFixed(1)\"></span>%</td>\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Priority</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Priority</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"Object.entries(report.summary.byPriority) as [priority, count]\"><tr>\n              <td></td>\n              <td></td>\n              <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"((count / report.summary.totalTickets) * 100).toFixed(1)\"></span>%</td>\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Category</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Category</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"Object.entries(report.summary.byCategory) as [category, count]\"><tr>\n              <td></td>\n              <td></td>\n              <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"((count / report.summary.totalTickets) * 100).toFixed(1)\"></span>%</td>\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Assigned To</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Assigned To</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"Object.entries(report.summary.byAssignedTo) as [assignedTo, count]\"><tr>\n              <td></td>\n              <td></td>\n              <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"((count / report.summary.totalTickets) * 100).toFixed(1)\"></span>%</td>\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>SLA Compliance</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>On Time</td>\n            <td>8</td>\n            <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.summary.slaCompliance.onTime + report.summary.slaCompliance.breached > 0 \"></span>%</td>\n          </tr>\n          <tr>\n            <td>Breached</td>\n            <td>2</td>\n            <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.summary.slaCompliance.onTime + report.summary.slaCompliance.breached > 0 \"></span>%</td>\n          </tr>\n          <tr>\n            <td>No SLA</td>\n            <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.summary.slaCompliance.noSLA\"></span></td>\n            <td>-</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  \n</div>";
}

@page GET "/modules/hss-management"
page modules_hss_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/hss-management", apiPath: "/api/hss", api_ok: true, api_surface: "wisp-api-native", api_resource: "hss", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"hss-management\">\n  <!-- Header -->\n  <div class=\"header\">\n    <div class=\"header-content\">\n      <div class=\"header-main\">\n        <div class=\"header-row\">\n          <button class=\"back-button\">\n            ← Back to Dashboard\n          </button>\n          <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"if (e.detail.id === 'subscriber-creation') true;\n        \"></span>}\n          />\n        </div>\n        <div>\n          <h1>🔐 HSS & Subscriber Management</h1>\n          <p class=\"subtitle\">Home Subscriber Server - Authentication & User Management</p>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Help Button - Fixed Position -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n  \n  \n    <!-- Navigation Tabs -->\n    <div class=\"tabs\">\n      <button\n      >\n        📊 Dashboard\n      </button>\n      <button\n      >\n        📦 Groups\n      </button>\n      <button\n      >\n        🚀 Bandwidth Plans\n      </button>\n      <button\n      >\n        🌐 MME Connections\n      </button>\n      <button\n      >\n        📥 Bulk Import\n      </button>\n      <button\n      >\n        🌐 Remote EPCs\n      </button>\n    </div>\n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      \n    </div>\n  \n  \n  <!-- Help Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n  <!-- Subscriber Creation Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"SubscriberCreationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showSubscriberWizard = false;\n      refreshAll();\"></span>}\n  />\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"BandwidthPlanWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showBandwidthPlanWizard = false;\n      refreshAll();\"></span>}\n  />\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"SubscriberGroupWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showGroupWizard = false;\n      refreshAll();\"></span>}\n  />\n</div>";
}

@page GET "/modules/inventory"
page modules_inventory_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"inventory-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n        <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📦 Inventory Management</h1>\n      <p class=\"subtitle\">Centralized asset tracking and management</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\"}>\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\"}>\n        📥 Scan Check In\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"if (e.detail.id === 'inventory-checkin') true;\n          els\"></span>}\n      />\n      <button class=\"btn-secondary\"}>\n        📤 Scan Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        🔍 Manual Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 View Reports\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn-primary\">\n        ➕ Add Item\n      </button>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📦</div>\n      <div>\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.totalItems\"></span></div>\n        <div class=\"stat-label\">Total Items</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\">\n          <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"getStatusCount('available')\"></span>\n        </div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\">\n          <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"getStatusCount('deployed')\"></span>\n        </div>\n        <div class=\"stat-label\">Deployed</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatCurrency(stats.totalValue)\"></span></div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer...\"\n        />\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"locationTypes as locType\"><option></option></div>\n      </select>\n      \n      <button class=\"btn-primary\">Apply</button>\n      <button class=\"btn-secondary\">Clear</button>\n    </div>\n  </div>\n  \n  <!-- Loading State -->\n  \n    <!-- Inventory Table -->\n    <div class=\"table-container\">\n      <table class=\"inventory-table\">\n        <thead>\n          <tr>\n            <th>Asset Tag</th>\n            <th>Category</th>\n            <th>Type</th>\n            <th>Manufacturer</th>\n            <th>Model</th>\n            <th>Serial Number</th>\n            <th>Status</th>\n            <th>Condition</th>\n            <th>Location</th>\n            <th>Last Updated</th>\n            <th>Actions</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n    \n    <!-- Pagination -->\n    <div class=\"pagination\">\n        <button \n          class=\"btn-secondary\"\n        >\n          ← Previous\n        </button>\n        \n        <span class=\"pagination-info\">\n          Page 1 of 2 \n          (24 items)\n        </span>\n        \n        <button \n          class=\"btn-secondary\"\n        >\n          Next →\n        </button>\n      </div>\n  \n  \n  <!-- Manual Barcode Entry Modal -->\n  \n\n  <!-- Asset Tag Viewer -->\n  \n  \n  <!-- Scan Modal -->\n  \n  \n  <!-- Check-in Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"InventoryCheckInWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showCheckInWizard = false;\n      loadData(); // Refresh inventory after check-in\"></span>}\n  />\n  <!-- RMA Tracking Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"RMATrackingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showRMAWizard = false;\n      loadData();\"></span>}\n  />\n</div>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

@page GET "/modules/inventory/:id"
page modules_inventory_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/:id", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"item-detail-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Inventory\n      </button>\n      <h1>📦 Equipment Details</h1>\n      \n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        📱 View QR Code\n      </button>\n      <button class=\"btn btn-secondary\">\n        🖨️ Print Tag\n      </button>\n      <button class=\"btn btn-primary\">\n        ✏️ Edit\n      </button>\n      <button class=\"btn btn-primary\">\n        📦 Transfer\n      </button>\n    </div>\n  </div>\n\n  \n    <div class=\"content-grid\">\n      <!-- Basic Information -->\n      <div class=\"info-card\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Asset Tag</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Serial Number</label>\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.serialNumber\"></span></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Category</label>\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.category\"></span></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Equipment Type</label>\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.equipmentType\"></span></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Manufacturer</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Model</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Status</label>\n            <span class=\"status-badge\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.status\"></span></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Condition</label>\n            <span class=\"condition-badge\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.condition\"></span></span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Current Location -->\n      <div class=\"info-card\">\n        <h3>📍 Current Location</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Location Type</label>\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.currentLocation?.type === 'unassigned' ? 'Unassigned' : (item.currentLocati\"></span></span>\n          </div>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.currentLocation?.type === 'unassigned'\"><div class=\"info-item\">\n              <span class=\"value\">Assign during deploy</span>\n            </div></div>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.currentLocation?.type !== 'unassigned' && item.currentLocation?.warehouse\"><div class=\"info-item\">\n              <label>Warehouse</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Section</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Aisle</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Shelf</label>\n              <span class=\"value\">N/A</span>\n            </div></div>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.currentLocation?.type !== 'unassigned' && item.currentLocation?.tower\"><div class=\"info-item\">\n              <label>Rack</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Rack Unit</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Cabinet</label>\n              <span class=\"value\">N/A</span>\n            </div></div>\n        </div>\n      </div>\n\n      <!-- Purchase Information -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.purchaseInfo\"><div class=\"info-card\">\n          <h3>💰 Purchase Information</h3>\n          <div class=\"info-grid\">\n            <div class=\"info-item\">\n              <label>Vendor</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Purchase Date</label>\n              <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.purchaseInfo.purchaseDate)\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <label>Purchase Price</label>\n              <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatCurrency(item.purchaseInfo.purchasePrice)\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <label>PO Number</label>\n              <span class=\"value\">N/A</span>\n            </div>\n          </div>\n        </div></div>\n\n      <!-- Warranty Information -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.warranty\"><div class=\"info-card\">\n          <h3>🛡️ Warranty Information</h3>\n          <div class=\"info-grid\">\n            <div class=\"info-item\">\n              <label>Provider</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Start Date</label>\n              <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.warranty.startDate)\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <label>End Date</label>\n              <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.warranty.endDate)\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <label>Type</label>\n              <span class=\"value\">N/A</span>\n            </div>\n          </div>\n        </div></div>\n\n      <!-- Technical Specifications -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.technicalSpecs\"><div class=\"info-card\">\n          <h3>⚙️ Technical Specifications</h3>\n          <div class=\"info-grid\">\n            <div class=\"info-item\">\n              <label>Power Requirements</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>IP Address</label>\n              <span class=\"value\">N/A</span>\n            </div>\n            <div class=\"info-item\">\n              <label>Management URL</label>\n              <span class=\"value\">N/A</span>\n            </div>\n          </div>\n        </div></div>\n\n      <!-- Module Integration -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.modules\"><div class=\"info-card\">\n          <h3>🔗 Module Integration</h3>\n          <div class=\"info-grid\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.modules.acs\"><div class=\"info-item\">\n                <label>ACS Device ID</label>\n                <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.modules.acs.deviceId\"></span></span>\n              </div>\n              <div class=\"info-item\">\n                <label>ACS Last Sync</label>\n                <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.modules.acs.lastSync)\"></span></span>\n              </div></div>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.modules.cbrs\"><div class=\"info-item\">\n                <label>CBRS CBSD ID</label>\n                <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.modules.cbrs.cbsdId\"></span></span>\n              </div>\n              <div class=\"info-item\">\n                <label>CBRS Last Sync</label>\n                <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.modules.cbrs.lastSync)\"></span></span>\n              </div></div>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.modules.coverageMap\"><div class=\"info-item\">\n                <label>Coverage Map Site ID</label>\n                <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.modules.coverageMap.siteId\"></span></span>\n              </div>\n              <div class=\"info-item\">\n                <label>Map Last Sync</label>\n                <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.modules.coverageMap.lastSync)\"></span></span>\n              </div></div>\n          </div>\n        </div></div>\n\n      <!-- Notes -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"item.notes\"><div class=\"info-card full-width\">\n          <h3>📝 Notes</h3>\n          <div class=\"notes-content\">\n            <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"item.notes\"></span>\n          </div>\n        </div></div>\n\n      <!-- Metadata -->\n      <div class=\"info-card full-width\">\n        <h3>📊 Metadata</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Created</label>\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.createdAt)\"></span></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Last Updated</label>\n            <span class=\"value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDate(item.updatedAt)\"></span></span>\n          </div>\n        </div>\n      </div>\n    </div>\n  \n</div>\n\n<!-- QR Code Modal -->\n";
}

@page GET "/modules/inventory/:id/edit"
page modules_inventory_id_edit_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/:id/edit", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"edit-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Details\n      </button>\n      <h1>✏️ Edit Equipment</h1>\n      \n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        Cancel\n      </button>\n      <button class=\"btn btn-primary\">\n        Save Changes\n      </button>\n    </div>\n  </div>\n\n  \n    <form on:submit|preventDefault=<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"handleSave\"></span> class=\"edit-form\">\n      <div class=\"form-sections\">\n        <!-- Basic Information -->\n        <div class=\"form-section\">\n          <h3>📋 Basic Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"assetTag\">Asset Tag</label>\n              <input \n                id=\"assetTag\"\n                type=\"text\" \n                placeholder=\"Enter asset tag\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"serialNumber\">Serial Number *</label>\n              <input \n                id=\"serialNumber\"\n                type=\"text\" \n                placeholder=\"Enter serial number\"\n                required\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"category\">Category *</label>\n              <select id=\"category\" required>\n                <option>Select category...</option>\n                <option value=\"radio\">Radio Equipment</option>\n                <option value=\"antenna\">Antenna</option>\n                <option value=\"cpe\">CPE Device</option>\n                <option value=\"backhaul\">Backhaul Equipment</option>\n                <option value=\"power\">Power Equipment</option>\n                <option value=\"network\">Network Equipment</option>\n                <option value=\"test\">Test Equipment</option>\n                <option value=\"other\">Other</option>\n              </select>\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"equipmentType\">Equipment Type *</label>\n              <input \n                id=\"equipmentType\"\n                type=\"text\" \n                placeholder=\"e.g., Sector Antenna, CPE Router\"\n                required\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"manufacturer\">Manufacturer</label>\n              <input \n                id=\"manufacturer\"\n                type=\"text\" \n                placeholder=\"Enter manufacturer\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"model\">Model</label>\n              <input \n                id=\"model\"\n                type=\"text\" \n                placeholder=\"Enter model\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"status\">Status *</label>\n              <select id=\"status\" required>\n                <option value=\"available\">Available</option>\n                <option value=\"deployed\">Deployed</option>\n                <option value=\"reserved\">Reserved</option>\n                <option value=\"in-transit\">In Transit</option>\n                <option value=\"maintenance\">Maintenance</option>\n                <option value=\"rma\">RMA</option>\n                <option value=\"retired\">Retired</option>\n                <option value=\"lost\">Lost</option>\n                <option value=\"sold\">Sold</option>\n              </select>\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"condition\">Condition *</label>\n              <select id=\"condition\" required>\n                <option value=\"new\">New</option>\n                <option value=\"excellent\">Excellent</option>\n                <option value=\"good\">Good</option>\n                <option value=\"fair\">Fair</option>\n                <option value=\"poor\">Poor</option>\n                <option value=\"damaged\">Damaged</option>\n                <option value=\"refurbished\">Refurbished</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <!-- Current Location (optional; assign during deploy if unassigned) -->\n        <div class=\"form-section\">\n          <h3>📍 Current Location</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"locationType\">Location Type</label>\n              <select id=\"locationType\">\n                <option value=\"unassigned\">Unassigned (assign during deploy)</option>\n                <option value=\"warehouse\">Warehouse</option>\n                <option value=\"tower\">Tower Site</option>\n                <option value=\"noc\">NOC</option>\n                <option value=\"vehicle\">Vehicle</option>\n                <option value=\"customer\">Customer Site</option>\n                <option value=\"rma\">RMA</option>\n                <option value=\"vendor\">Vendor</option>\n                <option value=\"other\">Other</option>\n              </select>\n            </div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"formData.currentLocation.type !== 'unassigned'\"><div class=\"form-group\">\n                <label for=\"siteName\">Site Name</label>\n                <input \n                  id=\"siteName\"\n                  type=\"text\" \n                  placeholder=\"Enter site name\"\n                />\n              </div></div>\n          </div>\n        </div>\n\n        <!-- Purchase Information -->\n        <div class=\"form-section\">\n          <h3>💰 Purchase Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"vendor\">Vendor</label>\n              <input \n                id=\"vendor\"\n                type=\"text\" \n                placeholder=\"Enter vendor name\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchaseDate\">Purchase Date</label>\n              <input \n                id=\"purchaseDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchasePrice\">Purchase Price</label>\n              <input \n                id=\"purchasePrice\"\n                type=\"number\" \n                step=\"0.01\" \n                placeholder=\"0.00\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchaseOrderNumber\">PO Number</label>\n              <input \n                id=\"purchaseOrderNumber\"\n                type=\"text\" \n                placeholder=\"Enter PO number\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Warranty Information -->\n        <div class=\"form-section\">\n          <h3>🛡️ Warranty Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"warrantyProvider\">Provider</label>\n              <input \n                id=\"warrantyProvider\"\n                type=\"text\" \n                placeholder=\"Enter warranty provider\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyStartDate\">Start Date</label>\n              <input \n                id=\"warrantyStartDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyEndDate\">End Date</label>\n              <input \n                id=\"warrantyEndDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyType\">Type</label>\n              <input \n                id=\"warrantyType\"\n                type=\"text\" \n                placeholder=\"e.g., Manufacturer, Extended\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Technical Specifications -->\n        <div class=\"form-section\">\n          <h3>⚙️ Technical Specifications</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"powerRequirements\">Power Requirements</label>\n              <input \n                id=\"powerRequirements\"\n                type=\"text\" \n                placeholder=\"e.g., 24V DC, 2A\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"ipAddress\">IP Address</label>\n              <input \n                id=\"ipAddress\"\n                type=\"text\" \n                placeholder=\"192.168.1.100\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"managementUrl\">Management URL</label>\n              <input \n                id=\"managementUrl\"\n                type=\"url\" \n                placeholder=\"http://192.168.1.100\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Notes -->\n        <div class=\"form-section\">\n          <h3>📝 Notes</h3>\n          <div class=\"form-group\">\n            <label for=\"notes\">Additional Notes</label>\n            <textarea \n              id=\"notes\" \n              placeholder=\"Enter any additional notes or comments...\"\n              rows=\"4\"\n            ></textarea>\n          </div>\n        </div>\n      </div>\n    </form>\n  \n</div>";
}

@page GET "/modules/inventory/add"
page modules_inventory_add_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/add", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"add-inventory-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Inventory\n      </button>\n      <h1>➕ Add Inventory Item</h1>\n    </div>\n  </div>\n  \n  \n  \n  <div class=\"form-container\">\n    <form on:submit|preventDefault=<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"handleSave\"></span>>\n      \n      <!-- Classification -->\n      <div class=\"section\">\n        <h3>🏷️ Equipment Classification</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Category *</label>\n            <select required>\n              <option></option><option></option><option></option><option></option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Equipment Type *</label>\n            <select required>\n              <option>-- Select Type --</option>\n              <option></option><option></option><option></option><option></option>\n              <option value=\"Other/Custom\">Other/Custom</option>\n            </select>\n          </div>\n        </div>\n        \n        \n      </div>\n      \n      <!-- Manufacturer Info -->\n      <div class=\"section\">\n        <h3>🏭 Manufacturer Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Manufacturer</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Model</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Part Number</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Serial Number *</label>\n            <input type=\"text\" required />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Firmware Version</label>\n          <input type=\"text\" />\n        </div>\n      </div>\n      \n      <!-- Location (optional; assign during deploy if left unassigned) -->\n      <div class=\"section\">\n        <h3>📍 Location</h3>\n        <p class=\"help-text\" style=\"margin-bottom: 1rem;\">Optional. Leave unassigned to assign a location during the deploy step.</p>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Location Type</label>\n            <select>\n              <option value=\"unassigned\">Unassigned (assign during deploy)</option>\n              <option value=\"warehouse\">Warehouse</option>\n              <option value=\"tower\">Tower Site</option>\n              <option value=\"noc\">NOC</option>\n              <option value=\"vehicle\">Service Vehicle</option>\n              <option value=\"rma\">RMA/Repair Center</option>\n              <option value=\"customer\">Customer Premises</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n              <label>Select Location</label>\n              <select>\n                <option>-- Select from map --</option>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"filteredLocations as location\"><option>\n                      ()\n                  </option></div>\n              </select>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"filteredLocations.length === 0 && formData.locationType !== 'customer' && formData.locationType !== 'other'\"><p class=\"help-text warning\">\n                  ⚠️ No <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formData.locationType\"></span> locations found. \n                  <button type=\"button\" class=\"link-button\">\n                    Add in Coverage Map →\n                  </button>\n                </p></div>\n            </div>\n        </div>\n        \n        <!-- Specific location details based on type -->\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"!locationUnassigned && formData.locationSiteId\"><div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"formData.locationType === 'warehouse'\"><div class=\"form-group\">\n              <label>Warehouse Section/Aisle</label>\n              <input type=\"text\" placeholder=\"A-5, Shelf 3, Bin 12\" />\n            </div></div></div>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Status *</label>\n            <select required>\n              <option value=\"available\">Available</option>\n              <option value=\"deployed\">Deployed</option>\n              <option value=\"reserved\">Reserved</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"rma\">RMA</option>\n              <option value=\"retired\">Retired</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Condition *</label>\n            <select required>\n              <option value=\"new\">New</option>\n              <option value=\"excellent\">Excellent</option>\n              <option value=\"good\">Good</option>\n              <option value=\"fair\">Fair</option>\n              <option value=\"poor\">Poor</option>\n              <option value=\"refurbished\">Refurbished</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Purchase Info -->\n      <div class=\"section\">\n        <h3>💰 Purchase Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Vendor</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Purchase Date</label>\n            <input type=\"date\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Purchase Price ($)</label>\n            <input type=\"number\" step=\"0.01\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>PO Number</label>\n            <input type=\"text\" />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Book Value ($)</label>\n          <input type=\"number\" step=\"0.01\" />\n        </div>\n      </div>\n      \n      <!-- Warranty -->\n      <div class=\"section\">\n        <h3>🛡️ Warranty Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Warranty Provider</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Start Date</label>\n            <input type=\"date\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>End Date</label>\n            <input type=\"date\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Technical Details -->\n      <div class=\"section\">\n        <h3>⚙️ Technical Specifications</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Power Requirements</label>\n            <input type=\"text\" placeholder=\"48V DC, 100-240V AC\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>IP Address</label>\n            <input type=\"text\" placeholder=\"192.168.1.100\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Notes -->\n      <div class=\"section\">\n        <h3>📝 Additional Notes</h3>\n        <div class=\"form-group\">\n          <textarea rows=\"4\" placeholder=\"Configuration notes, special instructions...\"></textarea>\n        </div>\n      </div>\n      \n      <!-- Actions -->\n      <div class=\"form-actions\">\n        <button type=\"button\" class=\"btn-secondary\">\n          Cancel\n        </button>\n        <button type=\"submit\" class=\"btn-primary\">\n          ✅ Add to Inventory\n        </button>\n      </div>\n    </form>\n  </div>\n</div>";
}

@page GET "/modules/inventory/bundles"
page modules_inventory_bundles_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/bundles", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"bundles-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Inventory\n      </button>\n      <h1>📦 Hardware Bundles</h1>\n      <p class=\"subtitle\">Create and manage hardware bundles for easy planning and deployment</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-primary\">\n        ➕ Create Bundle\n      </button>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Filters -->\n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search bundles...\"\n      />\n    </div>\n    \n    <select>\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"bundleTypes as type\"><option></option></div>\n    </select>\n    \n    <select>\n      <option></option><option></option><option></option><option></option><option></option>\n    </select>\n    \n    <div class=\"results-count\">\n      <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"bundles.length\"></span> of 24 bundles\n    </div>\n  </div>\n  \n  <!-- Bundles List -->\n  \n    <div class=\"bundles-grid\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"bundles as bundle (bundle._id)\"><div class=\"bundle-card\">\n          <div class=\"bundle-header\">\n            <div class=\"bundle-icon\"></div>\n            <div class=\"bundle-title\">\n              <h3></h3>\n              <span class=\"bundle-type\"></span>\n            </div>\n            <div class=\"bundle-status\">\n              <span class=\"badge badge-\"></span>\n            </div>\n          </div>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"bundle.description\"><p class=\"bundle-description\"></p></div>\n          \n          <div class=\"bundle-stats\">\n            <div class=\"stat\">\n              <span class=\"stat-label\">Items:</span>\n              <span class=\"stat-value\"></span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat-label\">Total Cost:</span>\n              <span class=\"stat-value\"></span>\n            </div>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"bundle.usageCount\"><div class=\"stat\">\n                <span class=\"stat-label\">Used:</span>\n                <span class=\"stat-value\"> times</span>\n              </div></div>\n          </div>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"bundle.tags && bundle.tags.length > 0\"><div class=\"bundle-tags\">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"bundle.tags as tag\"><span class=\"tag\"></span></div>\n            </div></div>\n          \n          <div class=\"bundle-actions\">\n            <button class=\"btn-secondary\">\n              👁️ View Details\n            </button>\n            <button class=\"btn-secondary\">\n              ✏️ Edit\n            </button>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"bundle.status === 'active'\"><button class=\"btn-warning\">\n                📦 Archive\n              </button></div>\n            <button class=\"btn-danger\">\n              🗑️ Delete\n            </button>\n          </div>\n          \n          <div class=\"bundle-footer\">\n            <span class=\"footer-text\">Updated: </span>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"bundle.lastUsedAt\"><span class=\"footer-text\">Last used: </span></div>\n          </div>\n        </div></div>\n    </div>\n    \n    <!-- Pagination -->\n    <div class=\"pagination\">\n        <button \n          class=\"btn-page\"\n        >\n          ← Previous\n        </button>\n        <span class=\"pagination-info\">\n          Page 1 of 2\n        </span>\n        <button \n          class=\"btn-page\"\n        >\n          Next →\n        </button>\n      </div>\n  \n</div>\n\n<!-- Modals -->\n\n";
}

@page GET "/modules/inventory/reports"
page modules_inventory_reports_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/reports", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"reports-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Inventory\n      </button>\n      <h1>📊 Inventory Reports & Analytics</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn btn-primary\">\n        🖨️ Print PDF\n      </button>\n    </div>\n  </div>\n\n  \n    <!-- Summary Cards -->\n    <div class=\"summary-grid\">\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">📦</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">10</div>\n          <div class=\"card-label\">Total Items</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">💰</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">$<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.summary.totalValue.toLocaleString()\"></span></div>\n          <div class=\"card-label\">Total Value</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">📍</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"Object.keys(report.summary.byLocation).length\"></span></div>\n          <div class=\"card-label\">Locations</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">🏭</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"Object.keys(report.summary.byManufacturer).length\"></span></div>\n          <div class=\"card-label\">Manufacturers</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Alerts -->\n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"report.alerts.expiringWarranties.length > 0\"><div class=\"alert-section warning\">\n        <h3>⚠️ Expiring Warranties (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"report.alerts.expiringWarranties.length\"></span>)</h3>\n        <ul>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"report.alerts.expiringWarranties as item\"><li>\n              <strong> </strong>\n              - SN: \n              - Expires: \n            </li></div>\n        </ul>\n      </div></div>\n\n    <!-- Charts -->\n    <div class=\"charts-grid\">\n      <!-- Status Distribution -->\n      <div class=\"chart-card\">\n        <h3>Status Distribution</h3>\n        \n      </div>\n\n      <!-- Category Distribution -->\n      <div class=\"chart-card\">\n        <h3>Category Distribution</h3>\n        \n      </div>\n\n      <!-- Location Distribution -->\n      <div class=\"chart-card full-width\">\n        <h3>Location Distribution</h3>\n        \n      </div>\n    </div>\n\n    <!-- Detailed Tables -->\n    <div class=\"table-section\">\n      <h3>By Status</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"Object.entries(report.summary.byStatus) as [status, count]\"><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"((count / report.summary.totalItems) * 100).toFixed(1)\"></span>%</td>\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Category</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Category</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"Object.entries(report.summary.byCategory) as [category, count]\"><tr>\n              <td></td>\n              <td></td>\n              <td><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"((count / report.summary.totalItems) * 100).toFixed(1)\"></span>%</td>\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n  \n</div>";
}

@page GET "/modules/maintain"
page modules_maintain_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/maintain", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
