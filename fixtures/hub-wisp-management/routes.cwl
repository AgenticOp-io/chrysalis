  return html "<div class=\"hardware-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>🔧 Hardware Management</h1>\n      <p class=\"subtitle\">Comprehensive equipment and hardware management system</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Check In\n      </button>\n      <button class=\"btn-secondary\">\n        📤 Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 Reports\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> true}\n      />\n      <!-- Add Hardware Dropdown -->\n      <div class=\"dropdown-container\">\n        <button class=\"btn-primary dropdown-toggle\">\n          ➕ Add Hardware ▼\n        </button>\n        \n      </div>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔧</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Hardware</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card clickable\">\n      <div class=\"stat-icon\">📡</div>\n      <div>\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">EPC/SNMP Devices</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\">12</div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Deployed/Online</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\">$25000.00</div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🏗️</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">In Maintenance</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Hardware Type Tabs -->\n  <div class=\"hardware-tabs\">\n    <button class=\"tab-btn\">\n      📋 All Hardware ()\n    </button>\n    <button class=\"tab-btn\">\n      📦 Inventory ()\n    </button>\n    <button class=\"tab-btn\">\n      📡 EPC/SNMP Devices (1)\n    </button>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer, asset tag...\"\n        />\n        <button class=\"search-btn\">Search</button>\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        \n      </select>\n      \n      \n      \n      <button class=\"btn-clear\">\n        Clear Filters\n      </button>\n    </div>\n    \n    <!-- Category Quick Filters -->\n    <div class=\"category-filters\">\n      \n        \n        \n        \n        \n    </div>\n  </div>\n  \n  <!-- Hardware Content -->\n  \n    <!-- EPC/SNMP Devices Section -->\n    \n  \n  \n  <!-- Inventory Items Section -->\n  \n</div>\n\n<!-- Scan Modal -->\n\n\n<!-- EPC Deployment Wizard -->\n\n\n<!-- EPC Edit Modal -->\n";
