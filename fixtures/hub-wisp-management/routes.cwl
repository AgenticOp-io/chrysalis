@page GET "/modules/customers/portal/signup"
page modules_customers_portal_signup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/signup", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"signup-page\">\n  <div class=\"signup-container\">\n    <div class=\"signup-header\">\n      \n      <h2>Create Account</h2>\n      <p class=\"signup-subtitle\">Link your customer account to access the portal</p>\n    </div>\n    \n    \n      <form class=\"signup-form\">\n        \n        \n        <div class=\"form-group\">\n          <label for=\"customerId\">Customer ID</label>\n          <input\n            id=\"customerId\"\n            type=\"text\"\n            placeholder=\"Enter your customer ID\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"phone\">Phone Number</label>\n          <input\n            id=\"phone\"\n            type=\"tel\"\n            placeholder=\"Enter your phone number\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"Enter your email\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"password\">Password</label>\n          <input\n            id=\"password\"\n            type=\"password\"\n            placeholder=\"Create a password (min 6 characters)\"\n            required\n            minlength=\"6\"\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"confirmPassword\">Confirm Password</label>\n          <input\n            id=\"confirmPassword\"\n            type=\"password\"\n            placeholder=\"Confirm your password\"\n            required\n          />\n        </div>\n        \n        <button type=\"submit\" class=\"btn-primary\">\n          Create Account\n        </button>\n        \n        <div class=\"signup-links\">\n          <a href=\"/modules/customers/portal/login\" class=\"link\">Already have an account? Sign in</a>\n        </div>\n      </form>\n    \n  </div>\n</div>";
}

@page GET "/modules/customers/portal/tickets"
