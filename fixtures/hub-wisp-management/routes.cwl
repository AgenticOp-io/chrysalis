  load { moduleKey: "plan", source: "wisp-m30", apiPath: "/api/plans", api_ok: true, api_surface: "wisp-api-native", api_resource: "plans", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      <div class=\"cwl-map-shell\" data-cwl-map-shell=\"SharedMap\" aria-hidden=\"true\" role=\"img\"></div>\n    </div>\n\n    <!-- Enhanced Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-primary);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\" title=\"Back to Dashboard\">\n          ←\n        </button>\n        <h1>📋 Plan</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n          <button class=\"module-control-btn\" title=\"View All Hardware\">\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Hardware</span>\n        </button>\n        <button class=\"module-control-btn\" title=\"Project List\">\n          <span class=\"control-icon\">📁</span>\n          <span class=\"control-label\">Projects</span>\n        </button>\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n        />\n        <button\n          class=\"module-control-btn marketing-btn\"\n            type=\"button\"\n        >\n          <span class=\"control-icon\">🔍</span>\n          <span class=\"control-label\">Find Addresses</span>\n        </button>\n        <button \n          class=\"module-control-btn filter-btn\"\n          type=\"button\"}\n          title=\"Toggle Layer Filters\"\n        >\n          <span class=\"control-icon\">🎛️</span>\n          <span class=\"control-label\">Layers</span>\n        </button>\n      </div>\n    </div>\n\n    \n  </div>\n\n  <!-- Filter Panel (non-modal) -->\n  \n  \n  <!-- Click outside to close filter panel -->\n  \n\n  <!-- Hardware View Modal -->\n\n\n  <!-- Project List Modal -->\n  \n\n  <!-- Create Project Modal -->\n\n\n  <!-- Missing Hardware Modal -->\n\n\n  <!-- Marketing Modal (deprecated - kept for backward compatibility) -->\n  \n\n  <!-- Marketing Results Popup -->\n  \n\n  <!-- Add Hardware Requirement Modal -->\n\n\n  <!-- Planning Report Modal -->\n\n  \n  <!-- Global Settings Button - Hidden in plan mode, shown in coverage-map iframe instead -->\n\n  <!-- Help Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<!-- MapLayerManager: overlay/visibleProjects/projectOverlays wired. Staging CRUD (site/equipment add/edit/delete from plan) planned – see docs/PROJECT_WORKFLOW_STATUS.md -->";
}

@page GET "/modules/sites"
page modules_sites_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/sites", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"sites-page\">\n    <div class=\"page-header\">\n      <div>\n        <h1>🏢 Site Management</h1>\n        <p class=\"subtitle\">Manage all network sites, towers, buildings, and facilities</p>\n      </div>\n      <div class=\"header-actions\">\n        <button class=\"btn-primary\">\n          ➕ Create New Site\n        </button>\n        <button class=\"btn-secondary\" title=\"Refresh\">\n          🔄 Refresh\n        </button>\n      </div>\n    </div>\n    \n    \n    \n    <!-- Filters and Search -->\n    <div class=\"filters-section\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"Search sites by name, address, or city...\"\n          class=\"search-input\"\n        />\n        <span class=\"search-icon\">🔍</span>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Type:</label>\n        <select>\n          <option value=\"all\">All Types</option>\n          <option value=\"tower\">📡 Tower</option>\n          <option value=\"building\">🏢 Building</option>\n          <option value=\"noc\">🖥️ NOC</option>\n          <option value=\"warehouse\">🏭 Warehouse</option>\n          <option value=\"pole\">📡 Pole</option>\n          <option value=\"other\">📍 Other</option>\n        </select>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Status:</label>\n        <select>\n          <option value=\"all\">All Statuses</option>\n          <option value=\"active\">✅ Active</option>\n          <option value=\"inactive\">❌ Inactive</option>\n          <option value=\"maintenance\">🔧 Maintenance</option>\n          <option value=\"planned\">📅 Planned</option>\n        </select>\n      </div>\n    </div>\n    \n    <!-- Summary Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Total Sites</div>\n      </div>\n      <div class=\"stat-card active\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Towers</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Buildings</div>\n      </div>\n    </div>\n    \n    <!-- Sites Table -->\n    \n      <div class=\"sites-table-container\">\n        <table class=\"sites-table\">\n          <thead>\n            <tr>\n              <th>Site Name</th>\n              <th>Type</th>\n              <th>Status</th>\n              <th>Location</th>\n              <th>Contact</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            \n          </tbody>\n        </table>\n      </div>\n    \n  </div>\n  \n  <!-- Site Edit Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SiteEditModal\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  \n  <!-- EPC Deployment Modal -->\n  \n  \n  <!-- Sector Deployment Modal -->\n  \n  \n  <!-- CPE/FWA Deployment Modal -->\n  \n  \n  <!-- Backhaul Deployment Modal -->\n  \n\n  <!-- Tips Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />";
}

@page GET "/modules/tenant-management"
page modules_tenant_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/tenant-management", apiPath: "/api/tenants", api_ok: true, api_surface: "wisp-api-native", api_resource: "tenants", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"tenant-management-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to Dashboard\n      </button>\n      <h1>🏢 Tenant Management</h1>\n      <p class=\"subtitle\">Manage all organizations and customer accounts</p>\n      <div class=\"admin-badge\">\n        <span>🔐</span>\n        <span>Platform Admin Access</span>\n      </div>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔑 CBRS Platform Keys\n      </button>\n      <button class=\"btn-primary\">\n        ➕ Create New Tenant\n      </button>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Create Tenant Form -->\n  \n\n  <!-- Tenants List -->\n  <div class=\"tenants-section\">\n    <h2>All Tenants (2)</h2>\n    \n    \n      <div class=\"tenants-grid\">\n        <div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <div class=\"tenant-icon\">🏢</div>\n              <div class=\"tenant-status\">\n                <span class=\"status-badge status-\">\n                  \n                </span>\n              </div>\n            </div>\n\n            <h3 class=\"tenant-name\"></h3>\n            <p class=\"tenant-id\"></p>\n\n            <div class=\"tenant-info\">\n              <div class=\"info-row\">\n                <span class=\"label\">Contact:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">CWMP URL:</span>\n                <span class=\"value url\"></span>\n              </div>\n            </div>\n\n            <div class=\"tenant-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Users</span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Devices</span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-small\">\n                ⚙️ Manage\n              </button>\n              <button class=\"btn-small\">\n                📊 Settings\n              </button>\n              <button class=\"btn-small btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div><div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <div class=\"tenant-icon\">🏢</div>\n              <div class=\"tenant-status\">\n                <span class=\"status-badge status-\">\n                  \n                </span>\n              </div>\n            </div>\n\n            <h3 class=\"tenant-name\"></h3>\n            <p class=\"tenant-id\"></p>\n\n            <div class=\"tenant-info\">\n              <div class=\"info-row\">\n                <span class=\"label\">Contact:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">CWMP URL:</span>\n                <span class=\"value url\"></span>\n              </div>\n            </div>\n\n            <div class=\"tenant-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Users</span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Devices</span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-small\">\n                ⚙️ Manage\n              </button>\n              <button class=\"btn-small\">\n                📊 Settings\n              </button>\n              <button class=\"btn-small btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div>\n      </div>\n    \n  </div>\n</div>\n\n<!-- Edit Tenant Modal -->\n\n\n<!-- Delete Confirmation Dialog -->\n";
}

