@page GET "/modules/customers/portal/login"
page modules_customers_portal_login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/customers/portal/login", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-customers-portal-login\" data-wisp-path=\"/modules/customers/portal/login\" data-cwl-island=\"client\"><div class=\"login-page\">\n  <div class=\"login-container\">\n    <div class=\"login-header\">\n      \n      <h2>Sign In</h2>\n      <p class=\"login-subtitle\">Access your account to view tickets and service information</p>\n    </div>\n    \n      <form class=\"login-form\">\n      \n      \n      <div class=\"form-group\">\n        <label for=\"identifier\">Customer ID, Email, or Phone</label>\n        <input\n          id=\"identifier\"\n          type=\"text\"\n          placeholder=\"Enter your customer ID, email, or phone\"\n          required\n        />\n      </div>\n      \n      <div class=\"form-group\">\n        <label for=\"password\">Password</label>\n        <input\n          id=\"password\"\n          type=\"password\"\n          placeholder=\"Enter your password\"\n          required\n        />\n      </div>\n      \n      <button type=\"submit\" class=\"btn-primary\">\n        Sign In\n      </button>\n    </form>\n    <div class=\"login-links\">\n      \n    </div>\n  </div>\n</div></div>";
}

