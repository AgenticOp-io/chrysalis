  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-user-management-permissions\" data-wisp-path=\"/modules/user-management/permissions\" data-cwl-island=\"client\"><div class=\"permissions-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"btn-back\">\n        ← Back\n      </button>\n      <div>\n        <h1>🔐 FCAPS Permission Management</h1>\n        <p class=\"subtitle\">Manage Fault, Configuration, Accounting, Performance, and Security permissions</p>\n      </div>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Permission Type Selector -->\n  <div class=\"permission-type-selector\">\n    <button\n      class=\"type-btn\"\n    >\n      👥 Role Permissions\n    </button>\n    <button\n      class=\"type-btn\"\n    >\n      👤 User Permissions\n    </button>\n  </div>\n\n  \n\n  <!-- Edit Permission Modal -->\n  \n</div></div>";
