@page GET "/reset-password"
page reset_password_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/reset-password" };
  return html "<div class=\"reset-password-page\">\r\n  <div class=\"reset-password-container\">\r\n    <div class=\"reset-password-card\">\r\n      <h1>WISP Management</h1>\r\n      <p class=\"subtitle\">Password Reset</p>\r\n\r\n      \r\n\r\n      \r\n\r\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"mode === 'reset'\"><div class=\"form-container\">\r\n          <h2>Set New Password</h2>\r\n          <p class=\"form-description\">Enter your new password below</p>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"newPassword\">New Password <span class=\"required\">*</span></label>\r\n            <input\r\n              id=\"newPassword\"\r\n              type=\"password\"\r\n              placeholder=\"Enter your new password\"\r\n              required\r\n              minlength=\"6\"\r\n            />\r\n          </div>\r\n\r\n          <div class=\"form-group\">\r\n            <label for=\"confirmPassword\">Confirm Password <span class=\"required\">*</span></label>\r\n            <input\r\n              id=\"confirmPassword\"\r\n              type=\"password\"\r\n              placeholder=\"Confirm your new password\"\r\n              required\r\n              minlength=\"6\"\r\n            />\r\n          </div>\r\n\r\n          <button \r\n            type=\"button\" \r\n            class=\"btn-primary\"\r\n          >\r\n            \r\n              Reset Password\r\n            \r\n          </button>\r\n        </div>\r\n      \r\n        <div class=\"form-container\">\r\n          <h2>Verify Email</h2>\r\n          <p class=\"form-description\">Click the button below to verify your email address</p>\r\n\r\n          <button \r\n            type=\"button\" \r\n            class=\"btn-primary\"\r\n          >\r\n            \r\n              Verify Email\r\n            \r\n          </button>\r\n        </div></div>\r\n\r\n      <div class=\"form-footer\">\r\n        <a href=\"/login\" class=\"link\">Back to Login</a>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>";
}

@page GET "/settings/module-access"
page settings_module_access_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/settings/module-access" };
  return html "<div class=\"module-access-container\">\n  <div class=\"header\">\n    <div class=\"title-section\">\n      <h1>⚙️ Module Access Configuration</h1>\n      <p class=\"subtitle\">Configure which modules each role can access in <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"$currentTenant?.name || 'your organization'\"></span></p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Reset All to Defaults\n      </button>\n      \n      <button class=\"btn btn-primary\">\n        \n          💾 Save Configuration\n        \n      </button>\n    </div>\n  </div>\n  \n  \n  \n  \n  \n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"hasChanges\"><div class=\"alert alert-warning\">\n      <span>⚠️</span>\n      <span>You have unsaved changes. Click \"Save Configuration\" to apply them.</span>\n    </div></div>\n  \n  \n    <div class=\"config-table-container\">\n      <table class=\"config-table\">\n        <thead>\n          <tr>\n            <th class=\"module-column\">Module</th>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"roles as role\"><div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"role !== 'platform_admin'\"><th class=\"role-column\">\n                  <div class=\"role-header\">\n                    <div class=\"role-name\"></div>\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"isRoleLocked(role)\"><span class=\"lock-badge\">🔒</span></div>\n                  </div>\n                </th></div></div>\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"modules as module\"><tr>\n              <td class=\"module-name\">\n                <span class=\"module-icon\"></span>\n                \n              </td>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"roles as role\"><div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"role !== 'platform_admin'\"><td class=\"checkbox-cell\">\n                    <label class=\"checkbox-container\">\n                      <input\n                        type=\"checkbox\"/>\n                      <span class=\"checkmark\"></span>\n                    </label>\n                  </td></div></div>\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n    \n    <div class=\"legend\">\n      <h3>Legend:</h3>\n      <ul>\n        <li>✅ <strong>Checked</strong> = Role can access this module</li>\n        <li>❌ <strong>Unchecked</strong> = Role cannot access this module</li>\n        <li>🔒 <strong>Locked</strong> = Owner role always has full access (cannot be changed)</li>\n        <li>🔄 <strong>Reset</strong> = Reset individual role to default permissions</li>\n      </ul>\n    </div>\n  \n</div>\n\n<div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showResetConfirm\"><div\n    class=\"modal-backdrop\"\n    role=\"presentation\"\n    aria-hidden=\"true\"\n    tabindex=\"-1\"\n  >\n    <div\n      class=\"modal-content\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Reset module access confirmation dialog\"\n      tabindex=\"0\"\n      on:click|stopPropagation\n    >\n      <div class=\"modal-header\">\n        <h2>Reset All to Defaults?</h2>\n        <button class=\"close-btn\">✕</button>\n      </div>\n      <div class=\"modal-body\">\n        <p>This will reset module access for all roles to their default configurations.</p>\n        <p class=\"warning-text\">Any custom changes will be lost. This cannot be undone.</p>\n      </div>\n      <div class=\"modal-actions\">\n        <button class=\"btn btn-secondary\">\n          Cancel\n        </button>\n        <button class=\"btn btn-danger\">\n          \n            Yes, Reset All\n          \n        </button>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/setup-admin"
page setup_admin_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/setup-admin" };
  return html "<div class=\"setup-container\">\n  <div class=\"setup-card\">\n    <h1>🔧 Setup Admin Access</h1>\n    <p class=\"subtitle\">Grant yourself owner access to your tenants</p>\n    \n    <div class=\"info-box\">\n      <p><strong>This will:</strong></p>\n      <ul>\n        <li>✅ Grant you owner role in all your tenants</li>\n        <li>✅ Enable User Management module</li>\n        <li>✅ Enable Help Desk module</li>\n        <li>✅ Allow you to invite other users</li>\n        <li>✅ Give you full administrative access</li>\n      </ul>\n    </div>\n    \n    \n        🚀 Setup Admin Access\n      \n    </button>\n    \n    \n  </div>\n</div>";
}

@page GET "/signup"
page signup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/signup" };
  return html "<div class=\"signup-wizard\">\n  <div class=\"wizard-container\">\n    <div class=\"wizard-header\">\n      <h1>Create Your Account</h1>\n      <p class=\"subtitle\">Get started with WISP Management in just a few steps</p>\n    </div>\n\n    <div class=\"progress-bar\">\n      <div class=\"progress\" style=\"width: %\"></div>\n    </div>\n\n    <div class=\"wizard-content\">\n      \n\n      \n\n      <!-- Step 1: Email Verification -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"step === 1\"><div class=\"step-content\">\n          <h2>Step 1: Verify Your Email</h2>\n          <p class=\"step-description\">We'll send a verification code to your email address to ensure it's valid.</p>\n\n          <div class=\"form-group\">\n            <label for=\"email\">Email Address <span class=\"required\">*</span></label>\n            <input\n              id=\"email\"\n              type=\"email\"\n              placeholder=\"your@email.com\"\n              required\n            />\n          </div>\n\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"!verificationCodeSent\"><div style=\"display: flex; flex-direction: column; gap: 1rem;\">\n              <button \n                type=\"button\" \n                class=\"btn-primary\"\n              >\n                \n                  Send Verification Code\n                \n              </button>\n\n              <div style=\"display: flex; align-items: center; gap: 1rem; margin: 0.5rem 0;\">\n                <div style=\"flex: 1; height: 1px; background: var(--border-color, #d1d5db);\"></div>\n                <span style=\"color: var(--text-secondary, #6b7280); font-size: 0.875rem;\">OR</span>\n                <div style=\"flex: 1; height: 1px; background: var(--border-color, #d1d5db);\"></div>\n              </div>\n\n              <button \n                type=\"button\" \n                class=\"btn-google\"\n                style=\"width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.75rem; padding: 0.9rem 1rem; border-radius: 0.6rem; background: #ffffff; color: #1a2332; font-weight: 600; font-size: 0.95rem; border: none; cursor: pointer; transition: transform 0.15s ease, box-shadow 0.15s ease; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);\"\n              >\n                <svg aria-hidden=\"true\" viewBox=\"0 0 533.5 544.3\" style=\"width: 20px; height: 20px;\">\n                  <path fill=\"#4285f4\" d=\"M533.5 278.4c0-17.4-1.4-34.1-4.1-50.2H272v95h147.5c-6.4 34-25 62.8-53.4 82v68h86.1c50.4-46.5 80.3-115.1 80.3-194.8z\"/>\n                  <path fill=\"#34a853\" d=\"M272 544.3c72.2 0 132.8-23.9 177-64.7l-86.1-68c-23.9 16.1-54.5 25.7-90.9 25.7-69.9 0-129.2-47.2-150.4-110.5h-90.7v69.8c44 87.4 134.5 148.7 241.1 148.7z\"/>\n                  <path fill=\"#fbbc04\" d=\"M121.6 326.8c-10.2-30-10.2-62.5 0-92.5v-69.8h-90.7c-37.3 74.6-37.3 158.4 0 233z\"/>\n                  <path fill=\"#ea4335\" d=\"M272 107.7c39.2-.6 76.4 13.8 105 39.9l78.2-78.2C404.5 25.5 344 0 272 0 165.4 0 74.9 61.3 30.9 148.7l90.7 69.8C142.7 175 202.1 107.7 272 107.7z\"/>\n                </svg>\n                <span>Sign up with Google</span>\n              </button>\n            </div></div>\n        </div>\n\n      <!-- Step 2: Tenant Information -->\n      \n        <div class=\"step-content\">\n          <h2>Step 2: Payment Option</h2>\n          <p class=\"step-description\">Select your preferred payment method. No charges will be made at this time.</p>\n\n          <div class=\"beta-disclaimer\">\n            <div class=\"beta-badge\">BETA</div>\n            <p><strong>WISPTools.io is currently in beta.</strong> Start with our free beta option - no payment required. You can upgrade to a paid plan later from your account settings.</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Payment Option <span class=\"required\">*</span></label>\n            <div class=\"payment-method-options\">\n              <label class=\"payment-option\">\n                <input \n                  type=\"radio\" \n                  name=\"paymentMethod\" \n                  value=\"beta\"\n                  checked\n                />\n                <div class=\"payment-option-content\">\n                  <div class=\"payment-icon\">🎉</div>\n                  <div>\n                    <strong>Beta (Free)</strong>\n                    <p>Free access during beta period - No payment required</p>\n                  </div>\n                </div>\n              </label>\n              <label class=\"payment-option\">\n                <input \n                  type=\"radio\" \n                  name=\"paymentMethod\" \n                  value=\"paypal\"\n                />\n                <div class=\"payment-option-content\">\n                  <div class=\"payment-icon\">💳</div>\n                  <div>\n                    <strong>PayPal</strong>\n                    <p>Pay with PayPal account (set up now, charges begin after beta)</p>\n                  </div>\n                </div>\n              </label>\n              <label class=\"payment-option\">\n                <input \n                  type=\"radio\" \n                  name=\"paymentMethod\" \n                  value=\"credit_card\"\n                />\n                <div class=\"payment-option-content\">\n                  <div class=\"payment-icon\">💳</div>\n                  <div>\n                    <strong>Credit Card</strong>\n                    <p>Pay with credit or debit card (set up now, charges begin after beta)</p>\n                  </div>\n                </div>\n              </label>\n            </div>\n          </div>\n\n          <div class=\"form-actions\">\n            <button \n              type=\"button\" \n              class=\"btn-secondary\"\n            >\n              ← Back\n            </button>\n            <button \n              type=\"button\" \n              class=\"btn-primary\"\n            >\n              Continue →\n            </button>\n          </div>\n        </div>\n\n      \n        <div class=\"step-content\">\n          <h2>Step 3: Organization Information</h2>\n          <p class=\"step-description\">Tell us about your organization.</p>\n\n          <div class=\"form-group\">\n            <label for=\"tenantName\">Organization Name <span class=\"required\">*</span></label>\n            <input\n              id=\"tenantName\"\n              type=\"text\"\n              placeholder=\"Acme WISP\"\n              required\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"displayName\">Display Name <span class=\"required\">*</span></label>\n            <input\n              id=\"displayName\"\n              type=\"text\"\n              placeholder=\"Acme Wireless Internet\"\n              required\n            />\n            <p class=\"help-text\">This is how your organization will appear in the system</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactPhone\">Contact Phone <span class=\"required\">*</span></label>\n            <input\n              id=\"contactPhone\"\n              type=\"tel\"\n              placeholder=\"+1 (555) 123-4567\"\n              required\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"subdomain\">Subdomain <span class=\"required\">*</span></label>\n            <input\n              id=\"subdomain\"\n              type=\"text\"\n              placeholder=\"acme-wisp\"\n              minlength=\"3\"\n              maxlength=\"63\"\n              required\n            />\n            <p class=\"help-text\">Unique subdomain for your organization (lowercase letters, numbers, and hyphens only). Will be auto-generated from tenant name if left blank.</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Primary Location (Optional)</label>\n            <p class=\"help-text\">You can create your primary location (NOC/HQ/Tower) after completing setup from the coverage map.</p>\n          </div>\n\n          <div class=\"form-actions\">\n            <button \n              type=\"button\" \n              class=\"btn-secondary\"\n            >\n              ← Back\n            </button>\n            <button \n              type=\"button\" \n              class=\"btn-primary\"\n            >\n              \n                Finish\n              \n            </button>\n          </div>\n        </div>\n\n      <!-- Step 3: Payment Information -->\n      <!-- Step 4: Success --></div>\n    </div>\n  </div>\n</div>";
}

@page GET "/support-dashboard"
page support_dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/support-dashboard" };
  return html "<div class=\"support-dashboard\">\n    <header class=\"dashboard-header\">\n      <div class=\"header-content\">\n        <h1>🎧 Customer Support Dashboard</h1>\n        <p class=\"subtitle\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"tenantName\"></span> - Support Portal</p>\n      </div>\n      <div class=\"header-actions\">\n        <button class=\"btn-secondary\">\n          ⚙️ Portal Settings\n        </button>\n      </div>\n    </header>\n\n    \n      <!-- Stats Cards -->\n      <div class=\"stats-grid\">\n        <div class=\"stat-card alerts\">\n          <div class=\"stat-icon\">🚨</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.activeAlerts\"></span></div>\n            <div class=\"stat-label\">Active Alerts</div>\n          </div>\n        </div>\n        \n        <div class=\"stat-card tickets\">\n          <div class=\"stat-icon\">🎫</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.pendingTickets\"></span></div>\n            <div class=\"stat-label\">Pending Tickets</div>\n          </div>\n        </div>\n        \n        <div class=\"stat-card chats\">\n          <div class=\"stat-icon\">💬</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.openChats\"></span></div>\n            <div class=\"stat-label\">Open Chats</div>\n          </div>\n        </div>\n        \n        <div class=\"stat-card customers\">\n          <div class=\"stat-icon\">👥</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.totalCustomers\"></span></div>\n            <div class=\"stat-label\">Customers</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Quick Actions -->\n      <div class=\"quick-actions\">\n        <h2>Quick Actions</h2>\n        <div class=\"actions-grid\">\n          <button class=\"action-card\">\n            <span class=\"action-icon\">🚨</span>\n            <span class=\"action-label\">Manage Alerts</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">❓</span>\n            <span class=\"action-label\">Edit FAQ</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">📚</span>\n            <span class=\"action-label\">Knowledge Base</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">💬</span>\n            <span class=\"action-label\">Chat Settings</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">🎫</span>\n            <span class=\"action-label\">Help Desk</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">👥</span>\n            <span class=\"action-label\">Customers</span>\n          </button>\n        </div>\n      </div>\n\n      <!-- Active Alerts Section -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"activeAlerts.length > 0\"><div class=\"section\">\n          <div class=\"section-header\">\n            <h2>🚨 Active Alerts</h2>\n            <button class=\"btn-link\">\n              Manage All →\n            </button>\n          </div>\n          <div class=\"alerts-list\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"activeAlerts as alert\"><div class=\"alert-item \">\n                <span class=\"alert-icon\"></span>\n                <div class=\"alert-content\">\n                  <h4></h4>\n                  <p></p>\n                </div>\n                <span class=\"alert-status\"></span>\n              </div></div>\n          </div>\n        </div></div>\n\n      <!-- Recent Tickets Section -->\n      <div class=\"section\">\n        <div class=\"section-header\">\n          <h2>🎫 Recent Support Tickets</h2>\n          <button class=\"btn-link\">\n            View All →\n          </button>\n        </div>\n        \n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"recentTickets.length === 0\"><div class=\"empty-state\">\n            <p>No recent tickets</p>\n          </div></div>\n      </div>\n    \n  </div>";
}

@page GET "/tenant-admin"
page tenant_admin_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/tenant-admin" };
  return html "<div class=\"tenant-admin-page\">\n  <div class=\"admin-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to Dashboard\n      </button>\n      <h1>🏢 Tenant Settings</h1>\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"tenant\"><p class=\"tenant-name\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"tenant.displayName\"></span></p></div>\n    </div>\n  </div>\n\n  \n    <div class=\"admin-container\">\n      <div class=\"tabs\">\n        <button \n          class=\"tab\"\n        >\n          General\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Device Settings\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Connection\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Limits & Quotas\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Users\n        </button>\n      </div>\n\n  \n\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"error && tenant\"><div class=\"error-message\">\n      <span class=\"error-icon\">⚠️</span>\n      <span></span>\n      <button class=\"dismiss-btn\">✕</button>\n    </div></div>\n\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"activeTab === 'general'\"><div class=\"settings-panel\">\n          <h2>General Settings</h2>\n          \n          <div class=\"form-group\">\n            <label>Organization Name</label>\n            <input type=\"text\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Contact Email</label>\n            <input type=\"email\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Contact Phone</label>\n            <input type=\"tel\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"tenant-timezone\">Timezone</label>\n            <select id=\"tenant-timezone\">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"US_TIMEZONES as tz\"><option></option></div>\n            </select>\n            <p class=\"help-text\">All device times will be displayed in this timezone</p>\n          </div>\n\n          <div class=\"form-group\">\n            <div class=\"field-label\">Status</div>\n            <div class=\"status-badge status-\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"tenant.status\"></span></div>\n          </div>\n\n          <div class=\"form-group\">\n            <div class=\"field-label\">Created</div>\n            <p class=\"read-only\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatInTenantTimezone(tenant.createdAt)\"></span></p>\n          </div>\n\n          <button class=\"btn-primary\">\n            <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : 'Save General Settings'\"></span>\n          </button>\n        </div></div>\n\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"activeTab === 'devices' && settings\"><div class=\"settings-panel\">\n          <h2>Device Management Settings</h2>\n          \n          <div class=\"form-group\">\n            <label>Inform Interval (seconds)</label>\n            <input\n              type=\"number\"\n              min=\"60\"\n              max=\"3600\"\n            />\n            <p class=\"help-text\">How often devices report to the ACS (60-3600 seconds)</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>\n              <input type=\"checkbox\" />\n              Enable Auto Discovery\n            </label>\n            <p class=\"help-text\">Automatically discover new devices when they connect</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>\n              <input type=\"checkbox\" />\n              Enable PCI Monitoring\n            </label>\n            <p class=\"help-text\">Monitor LTE PCI values and detect conflicts</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>\n              <input type=\"checkbox\" />\n              Enable Performance Monitoring\n            </label>\n            <p class=\"help-text\">Track device performance metrics</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Data Retention (days)</label>\n            <input\n              type=\"number\"\n              min=\"7\"\n              max=\"365\"\n            />\n            <p class=\"help-text\">How long to keep historical data (7-365 days)</p>\n          </div>\n\n          <button class=\"btn-primary\" type=\"button\">\n            <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : 'Save Device Settings'\"></span>\n          </button>\n        </div></div>\n\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"activeTab === 'connection' && settings\"><div class=\"settings-panel\">\n          <h2>Connection Information</h2>\n          \n          <div class=\"info-box\">\n            <h3>CWMP Connection URL</h3>\n            <div class=\"url-display\">\n              <code><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"tenant.cwmpUrl\"></span></code>\n              <button class=\"copy-btn\">\n                📋 Copy\n              </button>\n            </div>\n            <p class=\"help-text\">Configure this URL in your TR-069 devices as the ACS URL</p>\n          </div>\n\n          <div class=\"info-box\">\n            <h3>Tenant Subdomain</h3>\n            <code class=\"subdomain-display\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"tenant.subdomain\"></span></code>\n            <p class=\"help-text\">Unique identifier for your organization</p>\n          </div>\n\n          <div class=\"info-box credentials-box\">\n            <h3>ACS Authentication Credentials</h3>\n            <p class=\"help-text\">Credentials that CPE devices must use to connect</p>\n            \n            <div class=\"form-group\">\n              <label>\n                <input type=\"checkbox\" />\n                Require Authentication\n              </label>\n              <p class=\"help-text\">If enabled, devices must provide username/password</p>\n            </div>\n\n            <div class=\"credentials-grid\">\n              <div class=\"form-group\">\n                <label for=\"acs-username\">ACS Username</label>\n                <input\n                  id=\"acs-username\"\n                  type=\"text\"\n                  placeholder=\"admin\"\n                />\n              </div>\n\n              <div class=\"form-group\">\n                <label for=\"acs-password\">ACS Password</label>\n                <div class=\"password-field\">\n                  <input\n                    id=\"acs-password\"\n                    type=\"text\"\n                    placeholder=\"••••••••\"\n                  />\n                  <button \n                    class=\"generate-btn\"\n                  >\n                    🔄 Generate\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            <button \n              class=\"btn-primary\"\n            >\n              <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : 'Save ACS Credentials'\"></span>\n            </button>\n          </div>\n\n          <div class=\"info-box\">\n            <h3>Connection Instructions</h3>\n            <ol class=\"instructions\">\n              <li>Access your device's TR-069 configuration</li>\n              <li>Set <strong>ACS URL</strong> to: <code><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"tenant.cwmpUrl\"></span></code></li>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"settings.requireAuth\"><li>Set <strong>ACS Username</strong> to: <code><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"settings.acsUsername\"></span></code></li>\n                <li>Set <strong>ACS Password</strong> to: <code><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"settings.acsPassword\"></span></code></li></div>\n              <li>Save and reboot the device</li>\n              <li>Device should appear in your device list within 5 minutes</li>\n            </ol>\n          </div>\n        </div></div>\n\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"activeTab === 'limits' && limits\"><div class=\"settings-panel\">\n          <h2>Limits & Quotas</h2>\n          <p class=\"subtitle\">Current plan limits for your organization</p>\n          \n          <div class=\"limits-grid\">\n            <div class=\"limit-card\">\n              <h3>Max Devices</h3>\n              <div class=\"limit-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"limits.maxDevices\"></span></div>\n              <input type=\"number\" min=\"1\" />\n            </div>\n\n            <div class=\"limit-card\">\n              <h3>Max Users</h3>\n              <div class=\"limit-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"limits.maxUsers\"></span></div>\n              <input type=\"number\" min=\"1\" />\n            </div>\n\n            <div class=\"limit-card\">\n              <h3>Max Networks</h3>\n              <div class=\"limit-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"limits.maxNetworks\"></span></div>\n              <input type=\"number\" min=\"1\" />\n            </div>\n\n            <div class=\"limit-card\">\n              <h3>Storage Quota (MB)</h3>\n              <div class=\"limit-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"limits.storageQuotaMB\"></span></div>\n              <input type=\"number\" min=\"100\" step=\"100\" />\n            </div>\n          </div>\n\n          <button class=\"btn-primary\">\n            <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : 'Update Limits'\"></span>\n          </button>\n        </div></div>\n\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"activeTab === 'users'\"><div class=\"settings-panel\">\n          <h2>User Management</h2>\n          <p class=\"subtitle\">Manage users and their roles in your organization</p>\n          \n          <div class=\"user-management-redirect\">\n            <p>Manage your team members and their access levels</p>\n            <button class=\"btn-primary\">\n              👥 Manage Users\n            </button>\n          </div>\n        </div></div>\n    </div>\n  \n</div>";
}

@page GET "/tenant-selector"
page tenant_selector_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/tenant-selector" };
  return html "<div class=\"tenant-selector-page\">\n  <div class=\"selector-container\">\n    <div class=\"selector-header\">\n      <h1>Select Organization</h1>\n      <p>Choose the organization you want to work with</p>\n    </div>\n\n    \n      <div class=\"tenants-grid\">\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"tenants as tenant\"><button class=\"tenant-card\">\n            <div class=\"tenant-icon\">🏢</div>\n            <h3></h3>\n            <p class=\"tenant-subdomain\"></p>\n            <div class=\"tenant-meta\">\n              <span class=\"status-badge status-\"></span>\n              <span class=\"role-badge\">Your Role: Admin</span>\n            </div>\n          </button></div>\n\n        <button class=\"tenant-card create-new\">\n          <div class=\"create-icon\">➕</div>\n          <h3>Create New Organization</h3>\n          <p>Set up a new tenant for your devices</p>\n        </button>\n      </div>\n    \n  </div>\n</div>";
}

@page GET "/tenant-setup"
page tenant_setup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/tenant-setup" };
  return html "<div class=\"tenant-setup-page\">\n  <div class=\"setup-container\">\n    <div class=\"setup-header\">\n      <div>\n        <h1>🏢 Set Up Your Organization</h1>\n        <p>Create a tenant to manage your devices and networks</p>\n      </div>\n      <button type=\"button\" class=\"exit-button\")}>\n        Exit setup\n      </button>\n    </div>\n\n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"step === 1\"><div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 50%\"></div>\n        </div>\n\n        <h2>Organization Details</h2>\n        <p class=\"subtitle\">Tell us about your organization</p>\n\n        <div class=\"info-message\">\n          <span class=\"info-icon\">ℹ️</span>\n          <strong>Note:</strong> Each account can create one organization. You'll be the owner and can invite additional users.\n        </div>\n\n        \n\n        <form}>\n          <div class=\"form-group\">\n            <label for=\"tenantName\">\n              Organization Name <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"tenantName\"\n              type=\"text\"\n              placeholder=\"e.g., Acme Wireless\"\n              required\n            />\n            <p class=\"help-text\">Legal or business name of your organization</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"displayName\">\n              Display Name <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"displayName\"\n              type=\"text\"\n              placeholder=\"e.g., Acme Wireless ISP\"\n              required\n            />\n            <p class=\"help-text\">Name shown in the application</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"subdomain\">\n              Subdomain <span class=\"required\">*</span>\n            </label>\n            <div class=\"subdomain-input\">\n              <input\n                id=\"subdomain\"\n                type=\"text\"\n                placeholder=\"acme-wireless\"\n                required\n                pattern=\"[a-z0-9\\-]+\"\n              />\n              <span class=\"subdomain-suffix\">.your-domain.com</span>\n            </div>\n            <p class=\"help-text\">Unique URL for device connections: /cwmp/<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"subdomain\"></span></p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactEmail\">\n              Contact Email <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"contactEmail\"\n              type=\"email\"\n              placeholder=\"admin@acme-wireless.com\"\n              required\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactPhone\">\n              Contact Phone\n            </label>\n            <input\n              id=\"contactPhone\"\n              type=\"tel\"\n              placeholder=\"+1 (555) 123-4567\"\n            />\n          </div>\n\n          <div class=\"form-actions\">\n            <button type=\"submit\" class=\"btn-primary\">\n              \n                Create Tenant\n              \n            </button>\n          </div>\n        </form>\n      </div>\n    \n      <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 66%\"></div>\n        </div>\n\n        <h2>Payment Method Setup</h2>\n        <p class=\"subtitle\">Add a payment method for your account (required)</p>\n\n        <div class=\"beta-disclaimer\">\n          <div class=\"beta-badge\">BETA</div>\n          <p><strong>wisptools.io (WISP Management) is currently in beta.</strong> No charges will be made without prior notice. Adding a payment method now ensures uninterrupted service when billing begins.</p>\n        </div>\n\n        \n\n        <div class=\"form-group\">\n          <label>Payment Method <span class=\"required\">*</span></label>\n          <div class=\"payment-method-options\">\n            <label class=\"payment-option\">\n              <input \n                type=\"radio\" \n                name=\"paymentMethod\" \n                value=\"paypal\"\n              />\n              <div class=\"payment-option-content\">\n                <div class=\"payment-icon\">💳</div>\n                <div>\n                  <strong>PayPal</strong>\n                  <p>Pay with PayPal account</p>\n                </div>\n              </div>\n            </label>\n            <label class=\"payment-option\">\n              <input \n                type=\"radio\" \n                name=\"paymentMethod\" \n                value=\"credit_card\"\n              />\n              <div class=\"payment-option-content\">\n                <div class=\"payment-icon\">💳</div>\n                <div>\n                  <strong>Credit Card</strong>\n                  <p>Pay with credit or debit card</p>\n                </div>\n              </div>\n            </label>\n          </div>\n        </div>\n\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"paymentMethodType === 'paypal'\"><div class=\"form-group\">\n            <label for=\"paypalEmail\">\n              PayPal Email Address <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"paypalEmail\"\n              type=\"email\"\n              placeholder=\"your-email@example.com\"\n              required\n            />\n            <p class=\"help-text\">The email address associated with your PayPal account</p>\n          </div></div>\n\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"paymentMethodType === 'credit_card'\"><div class=\"form-group\">\n            <label for=\"cardEmail\">\n              Billing Email <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"cardEmail\"\n              type=\"email\"\n              placeholder=\"billing@example.com\"\n              required\n            />\n          </div>\n          <div class=\"form-group\">\n            <label for=\"cardNumber\">\n              Card Number <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"cardNumber\"\n              type=\"text\"\n              placeholder=\"1234 5678 9012 3456\"\n              maxlength=\"19\")/g, '$1 ').trim(); value;\n              }}\n              required\n            />\n          </div>\n          <div class=\"form-row\">\n            <div class=\"form-group\">\n              <label for=\"expiryDate\">\n                Expiry Date (MM/YY) <span class=\"required\">*</span>\n              </label>\n              <input\n                id=\"expiryDate\"\n                type=\"text\"\n                placeholder=\"12/25\"\n                maxlength=\"5\" value;\n                }}\n                required\n              />\n            </div>\n            <div class=\"form-group\">\n              <label for=\"cvv\">\n                CVV <span class=\"required\">*</span>\n              </label>\n              <input\n                id=\"cvv\"\n                type=\"text\"\n                placeholder=\"123\"\n                maxlength=\"4\"\n                pattern=\"\\d\"\n                required\n              />\n            </div>\n          </div>\n          <div class=\"form-group\">\n            <label for=\"cardName\">\n              Cardholder Name <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"cardName\"\n              type=\"text\"\n              placeholder=\"John Doe\"\n              required\n            />\n          </div></div>\n\n        <div class=\"form-actions\">\n          <button \n            type=\"button\" \n            class=\"btn-secondary\"\n          >\n            Skip for Now\n          </button>\n          <button \n            type=\"button\" \n            class=\"btn-primary\"\n          >\n            \n              Continue\n            \n          </button>\n        </div>\n      </div>\n    \n      <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 100%\"></div>\n        </div>\n\n        <h2>Primary Location Setup</h2>\n        <p class=\"subtitle\">Set up your primary NOC/HQ/Tower location for inventory management</p>\n\n        <div class=\"info-message\">\n          <span class=\"info-icon\">ℹ️</span>\n          <strong>Note:</strong> Hardware scanned in will automatically be assigned to this location. You can change this later in settings.\n        </div>\n\n        \n\n        <div class=\"form-group\">\n          <label>Primary Location</label>\n          <div class=\"radio-group\">\n            <label class=\"radio-option\">\n              <input type=\"radio\" value=\"create\" />\n              <span>Create New Location</span>\n            </label>\n            <label class=\"radio-option\">\n              <input type=\"radio\" value=\"skip\" />\n              <span>Skip for Now</span>\n            </label>\n          </div>\n        </div>\n\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"primaryLocationOption === 'create'\"><div class=\"form-group\">\n            <button \n              type=\"button\" \n              class=\"btn-secondary\"\n            >\n              ➕ Create Primary Location\n            </button>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"createdSite\"><p class=\"success-text\">✅ Created: <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"createdSite.name\"></span></p></div>\n          </div></div>\n\n        <div class=\"form-actions\">\n          <button \n            type=\"button\" \n            class=\"btn-secondary\");\n            }}\n          >\n            Skip\n          </button>\n          <button \n            type=\"button\" \n            class=\"btn-primary\"}\n          >\n            \n              Complete Setup\n            \n          </button>\n        </div>\n      </div></div>\n  </div>\n  \n  <!-- Site Creation Modal -->\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showSiteModal\">\n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"tenantId\"><div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SiteEditModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n      /></div></div>\n</div>";
}

@page GET "/wizards"
page wizards_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/wizards" };
  return html "<div class=\"wizards-page\">\r\n    <header class=\"wizards-header\">\r\n      <button class=\"back-btn\" type=\"button\">\r\n        ← Dashboard\r\n      </button>\r\n      <div class=\"wizards-header-row\">\r\n        <h1>🧙 List of wizards</h1>\r\n        <div class=\"wizards-pulldown-wrap\">\r\n          <button\r\n            type=\"button\"\r\n            class=\"wizards-pulldown-trigger\"\r\n            aria-haspopup=\"true\"\r\n          >\r\n            Jump to wizard ▼\r\n          </button>\r\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"wizardsPulldownOpen\"><div class=\"wizards-pulldown-menu\" role=\"menu\">\r\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"ALL_WIZARDS as w\"><button type=\"button\" role=\"menuitem\" class=\"wizards-pulldown-item\"}>\r\n                  <span class=\"wizards-pulldown-icon\"></span>\r\n                  <span></span>\r\n                </button></div>\r\n            </div></div>\r\n        </div>\r\n      </div>\r\n      <p class=\"subtitle\">Guided flows for setup, deployment, and operations. Each wizard runs inside its module. Use <strong>Jump to wizard</strong> above or \"Open in [Module]\" below to go to that module, then click the wizard button in the module header.</p>\r\n    </header>\r\n\r\n    <div class=\"wizards-grid\">\r\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"wizards as w\"><article class=\"wizard-card\">\r\n          <div class=\"wizard-icon\"></div>\r\n          <h2 class=\"wizard-name\"></h2>\r\n          <p class=\"wizard-desc\"></p>\r\n          <p class=\"wizard-where\">\r\n            <strong></strong> · \r\n          </p>\r\n          <button\r\n            class=\"open-in-module\"\r\n              if (w.openHere && w.id === 'initial-configuration') <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showConfigWizard = true; return;\"></span>\r\n              const w.modulePath + '?wizard=' + encodeURIComponent(w.id);\r\n              goto(url);\r\n            }}\r\n            type=\"button\"\r\n          >\r\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"w.openHere\">Open</div>\r\n          </button>\r\n        </article></div>\r\n    </div>\r\n  </div>\r\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"OrganizationSetupWizard\" aria-hidden=\"true\" role=\"dialog\"></div> (showOrgWizard = false)} />\r\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"InitialConfigurationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> (showConfigWizard = false)} />";
}

