@page GET "/modules/customers/portal/tickets/:id"
page modules_customers_portal_tickets_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets/:id", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"ticket-details-page\">\n    <div class=\"page-header\">\n      <a href=\"/modules/customers/portal/tickets\" class=\"back-link\">← Back to Tickets</a>\n      <h1>Ticket Details</h1>\n    </div>\n    \n    <div class=\"ticket-details\">\n      <div class=\"ticket-header\">\n        <div>\n          <span class=\"ticket-number\">N/A</span>\n          <span \n            class=\"ticket-status\" \n            style=\"background:\"\n          >\n            \n          </span>\n        </div>\n        <div class=\"ticket-meta\">\n          <span>Priority: </span>\n          <span>Created: </span>\n        </div>\n      </div>\n      \n      <div class=\"ticket-content\">\n        <h2></h2>\n        <p class=\"ticket-description\">No description</p>\n      </div>\n      \n      \n      \n      <div class=\"add-comment\">\n        <h3>Add Comment</h3>\n        <form>\n          <textarea\n            placeholder=\"Add a comment or update...\"\n            rows=\"4\"\n          ></textarea>\n          <button type=\"submit\" class=\"btn-primary\">\n            Add Comment\n          </button>\n        </form>\n      </div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/tickets/new"
page modules_customers_portal_tickets_new_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets/new", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"create-ticket-page\">\n  <div class=\"page-header\">\n    <h1>Create New Ticket</h1>\n    <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Back to Tickets</a>\n  </div>\n  \n  <form class=\"ticket-form\">\n    \n    \n    <div class=\"form-group\">\n      <label for=\"title\">Title *</label>\n      <input\n        id=\"title\"\n        type=\"text\"\n        placeholder=\"Brief description of the issue\"\n        required\n      />\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"category\">Category</label>\n      <select id=\"category\">\n        <option value=\"slow-speed\">Slow Speed</option>\n        <option value=\"no-connection\">No Connection</option>\n        <option value=\"intermittent\">Intermittent Connection</option>\n        <option value=\"equipment-failure\">Equipment Failure</option>\n        <option value=\"billing-issue\">Billing Issue</option>\n        <option value=\"other\">Other</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"priority\">Priority</label>\n      <select id=\"priority\">\n        <option value=\"low\">Low</option>\n        <option value=\"medium\">Medium</option>\n        <option value=\"high\">High</option>\n        <option value=\"critical\">Critical</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"description\">Description *</label>\n      <textarea\n        id=\"description\"\n        placeholder=\"Please provide detailed information about the issue...\"\n        rows=\"6\"\n        required\n      ></textarea>\n    </div>\n    \n    <div class=\"form-actions\">\n      <button type=\"submit\" class=\"btn-primary\">\n        Create Ticket\n      </button>\n      <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Cancel</a>\n    </div>\n  </form>\n</div>";
}

@page GET "/modules/deploy"
page modules_deploy_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  load { module: "deploy", source: "wisp-m3", apiPath: "/api/deploy" };
