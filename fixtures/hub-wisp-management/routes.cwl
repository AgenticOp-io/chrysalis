@page GET "/modules/user-management/roles"
page modules_user_management_roles_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/user-management/roles", apiPath: "/api/permissions", api_ok: true, api_surface: "wisp-api-native", api_resource: "permissions", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-user-management-roles\" data-wisp-path=\"/modules/user-management/roles\" data-cwl-island=\"client\"><div class=\"role-management-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"btn-back\">\n        ← Back\n      </button>\n      <div>\n        <h1>👥 Role Management</h1>\n        <p class=\"subtitle\">Define FCAPS permissions (Fault, Configuration, Accounting, Performance, Security) for each role</p>\n      </div>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Role Selector -->\n  <div class=\"role-selector-section\">\n    <h2>Select Role</h2>\n    <div class=\"role-tabs\">\n      \n    </div>\n    \n  </div>\n\n  <!-- FCAPS Legend -->\n  <div class=\"fcaps-legend\">\n    <h3>FCAPS Categories:</h3>\n    <div class=\"legend-items\">\n      <div class=\"legend-item\">\n        <strong>F</strong> - <span>Fault:</span> Monitoring, alarms, error handling\n      </div>\n      <div class=\"legend-item\">\n        <strong>C</strong> - <span>Configuration:</span> Settings, changes, management\n      </div>\n      <div class=\"legend-item\">\n        <strong>A</strong> - <span>Accounting:</span> Billing, usage tracking\n      </div>\n      <div class=\"legend-item\">\n        <strong>P</strong> - <span>Performance:</span> Metrics, analytics, monitoring\n      </div>\n      <div class=\"legend-item\">\n        <strong>S</strong> - <span>Security:</span> Access control, authentication\n      </div>\n    </div>\n    <div class=\"operations-legend\">\n      <strong>Operations:</strong> <span class=\"badge\">R</span> = Read, <span class=\"badge\">W</span> = Write, <span class=\"badge\">D</span> = Delete\n    </div>\n  </div>\n\n  <!-- Modules Grid -->\n  <div class=\"modules-section\">\n    <h2>Module Permissions for </h2>\n    <div class=\"modules-grid\">\n      \n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\"></span>\n            <div>\n              <h3></h3>\n              <p class=\"module-description\"></p>\n            </div>\n          </div>\n          \n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div>\n          </div>\n          \n          <button class=\"btn-edit\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\"></span>\n            <div>\n              <h3></h3>\n              <p class=\"module-description\"></p>\n            </div>\n          </div>\n          \n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                \n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n                  <div class=\"permission-cell\">\n                    \n                  </div>\n              </div>\n          </div>\n          \n          <button class=\"btn-edit\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n    </div>\n  </div>\n\n  <!-- Edit Permission Modal -->\n  \n</div></div>";
}

@page GET "/modules/voice-telephony"
page modules_voice_telephony_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/voice-telephony", apiPath: "/api/voice", api_ok: true, api_surface: "wisp-api-native", api_resource: "voice", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-voice-telephony\" data-wisp-path=\"/modules/voice-telephony\" data-cwl-island=\"client\"><div class=\"voice-page\">\n    <header class=\"page-head\">\n      <div class=\"page-head-row\">\n        <h1>Voice / SIP & UC</h1>\n        <div class=\"page-toolbar\">\n          <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n          <button type=\"button\" class=\"btn tips-btn\">Tips</button>\n        </div>\n      </div>\n      <p class=\"sub\">\n        Tenant-scoped numbers, carrier accounts, E911, and porting. Webhook ingress:\n        <code>POST /api/voice/webhooks/:provider</code> (HMAC when <code>VOICE_WEBHOOK_SECRET</code> is set).\n        Customer records link via <code>customerId</code> (same id as Customers module).\n      </p>\n    </header>\n\n    <div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"></div>\n\n    \n\n    \n\n    <nav class=\"tabs\">\n      <button type=\"button\">Overview</button>\n      <button type=\"button\">Provider accounts</button>\n      <button type=\"button\">Numbers</button>\n      <button type=\"button\">Port orders</button>\n      <button type=\"button\">Service locations</button>\n    </nav>\n\n    \n      <section class=\"panel\">\n        <div class=\"row\">\n          <h2>Service locations (E911 / geocode)</h2>\n          <button type=\"button\" class=\"btn primary\">Add location</button>\n        </div>\n        <p class=\"muted small\">\n          Use the same <code>customerId</code> as the Customers module to tie addresses together. Coverage Map opens centered on\n          coordinates when available.\n        </p>\n        \n      </section>\n    \n  </div>\n\n  \n\n  \n\n  \n\n  </div>";
}

@page GET "/modules/work-orders"
page modules_work_orders_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "work-orders", apiPath: "/api/work-orders", api_ok: true, api_surface: "wisp-api-native", api_resource: "work-orders", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"work-orders-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📋 Work Orders & Tickets</h1>\n      <p class=\"subtitle\">Field operations and trouble ticket management</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn-secondary\">\n        ➕ Quick Create\n      </button>\n      <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"></div>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">2</div>\n        <div class=\"stat-label\">Total Tickets</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔓</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Open</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⚡</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          \n        </div>\n        <div class=\"stat-label\">High Priority</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          h\n        </div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Priorities</option>\n        \n      </select>\n      \n      <select>\n        <option>All Types</option>\n        \n      </select>\n      \n      <button class=\"btn-secondary\">\n        Clear Filters\n      </button>\n    </div>\n  </div>\n  \n  <!-- Work Orders List -->\n  \n    <div class=\"work-orders-grid\">\n      <div data-cwl-component=\"WorkOrderCard\" data-cwl-lifted-component=\"WorkOrderCard\"><div \n  class=\"work-order-card\" \n  style=\"border-left: 4px solid\"\n  on:keydown\n  role=\"button\"\n  tabindex=\"0\"\n>\n  <div class=\"card-header\">\n    <div class=\"header-left\">\n      <span class=\"priority-icon\"></span>\n      <div class=\"title-group\">\n        <h3 class=\"ticket-number\">TKT-NEW</h3>\n        <span class=\"ticket-type\"></span>\n      </div>\n    </div>\n    \n    <div \n      class=\"status-badge\" \n      style=\"background-color:\"\n    >\n      open\n    </div>\n  </div>\n  \n  <p class=\"ticket-title\"></p>\n  \n  \n  \n  \n  \n  <div class=\"card-footer\">\n    <div class=\"footer-left\">\n      <span class=\"time-ago\"></span>\n      \n    </div>\n    \n    \n  </div>\n</div></div><div data-cwl-component=\"WorkOrderCard\" data-cwl-lifted-component=\"WorkOrderCard\"><div \n  class=\"work-order-card\" \n  style=\"border-left: 4px solid\"\n  on:keydown\n  role=\"button\"\n  tabindex=\"0\"\n>\n  <div class=\"card-header\">\n    <div class=\"header-left\">\n      <span class=\"priority-icon\"></span>\n      <div class=\"title-group\">\n        <h3 class=\"ticket-number\">TKT-NEW</h3>\n        <span class=\"ticket-type\"></span>\n      </div>\n    </div>\n    \n    <div \n      class=\"status-badge\" \n      style=\"background-color:\"\n    >\n      open\n    </div>\n  </div>\n  \n  <p class=\"ticket-title\"></p>\n  \n  \n  \n  \n  \n  <div class=\"card-footer\">\n    <div class=\"footer-left\">\n      <span class=\"time-ago\"></span>\n      \n    </div>\n    \n    \n  </div>\n</div></div>\n      \n      \n    </div>\n  \n  \n  <!-- Create Modal -->\n  <div data-cwl-component=\"CreateWorkOrderModal\" data-cwl-lifted-component=\"CreateWorkOrderModal\"><div\n  class=\"modal-overlay\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  tabindex=\"0\"\n  aria-label=\"Create work order dialog\"\n hidden aria-hidden=\"true\">\n  <div class=\"modal-content\" role=\"document\">\n    <div class=\"modal-header\">\n      <h2>➕ Create Work Order</h2>\n      <button class=\"close-btn\">✕</button>\n    </div>\n    \n    \n    \n    <div class=\"modal-body\">\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Type *</label>\n            <select>\n              <option value=\"installation\">Installation</option>\n              <option value=\"repair\">Repair</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"upgrade\">Upgrade</option>\n              <option value=\"removal\">Removal</option>\n              <option value=\"troubleshoot\">Troubleshoot</option>\n              <option value=\"inspection\">Inspection</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Priority *</label>\n            <select>\n              <option value=\"low\">Low</option>\n              <option value=\"medium\">Medium</option>\n              <option value=\"high\">High</option>\n              <option value=\"critical\">Critical</option>\n            </select>\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Title *</label>\n          <input\n            type=\"text\"\n            placeholder=\"Brief description of the issue or task\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Description</label>\n          <textarea \n            placeholder=\"Detailed description of the work to be performed...\"\n            rows=\"4\"\n          ></textarea>\n        </div>\n        \n        \n      </div>\n      \n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 Location</h3>\n        \n        <div class=\"form-group\">\n          <label>Site</label>\n          <select>\n            <option>Select site...</option>\n            \n          </select>\n        </div>\n      </div>\n      \n      <!-- Customer Info -->\n      <div class=\"section\">\n        <h3>👤 Customer Information</h3>\n        \n        <div class=\"form-group\">\n          <label>\n            <input type=\"checkbox\" />\n            Customer Reported Issue\n          </label>\n        </div>\n        \n        \n      </div>\n      \n      <!-- Scheduling -->\n      <div class=\"section\">\n        <h3>📅 Scheduling</h3>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Scheduled Date</label>\n            <input\n              type=\"datetime-local\"\n            />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Estimated Duration (minutes)</label>\n            <input\n              type=\"number\"\n              placeholder=\"120\"\n            />\n          </div>\n        </div>\n      </div>\n      \n      <!-- SLA -->\n      <div class=\"section\">\n        <h3>⏱️ SLA (Service Level Agreement)</h3>\n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Response Time (hours)</label>\n            <input\n              type=\"number\"\n              placeholder=\"4\"\n            />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Resolution Time (hours)</label>\n            <input\n              type=\"number\"\n              placeholder=\"24\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\">Cancel</button>\n      <button class=\"btn-primary\">\n        ✅ Create Work Order\n      </button>\n    </div>\n  </div>\n</div>\n\n</div>\n  \n  <!-- Work Order Creation Wizard -->\n  <div data-cwl-component=\"WorkOrderCreationWizard\" data-cwl-lifted-component=\"WorkOrderCreationWizard\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\" hidden aria-hidden=\"true\"><div \n    class=\"wizard-overlay\" \n    role=\"dialog\" \n    aria-modal=\"true\" \n    aria-labelledby=\"wizard-title\"\n   hidden aria-hidden=\"true\">\n    <div \n      class=\"wizard-modal\"\n      on:click|stopPropagation\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\"></h2>\n        <button class=\"close-btn\" aria-label=\"Close\">✕</button>\n      </div>\n      \n      <!-- Progress Steps -->\n      \n      \n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n        \n        \n        \n        \n        <!-- Slot for step content -->\n        <slot name=\"content\"  />\n      </div>\n      \n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <slot name=\"footer\"       />\n      </div>\n    </div>\n  </div></div>\n  <div slot=\"content\">\n    \n  </div>\n  \n  <div slot=\"footer\" let:currentStep let:nextStep let:prevStep let:handleClose let:isLoading>\n    \n    \n    <div class=\"footer-actions\">\n      \n    </div>\n  </div>\n</div>\n\n</div>\n</div>";
}

@page GET "/modules/work-orders/:id"
page modules_work_orders_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/work-orders/:id", apiPath: "/api/work-orders", api_ok: true, api_surface: "wisp-api-native", api_resource: "work-orders", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-work-orders-:id\" data-wisp-path=\"/modules/work-orders/:id\" data-cwl-island=\"client\"><div class=\"work-order-details\">\n  <div class=\"page-header\">\n    <button class=\"back-button\">\n      ← Back to Work Orders\n    </button>\n    \n    <div class=\"header-content\">\n        <div class=\"header-left\">\n          <h1>Work Order</h1>\n          <p class=\"subtitle\"></p>\n        </div>\n        \n        <div class=\"header-badges\">\n          <div \n            class=\"priority-badge\" \n            style=\"background-color:\"\n          >\n            \n          </div>\n          \n          <div \n            class=\"status-badge\" \n            style=\"background-color:\"\n          >\n            open\n          </div>\n        </div>\n      </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  \n    <div class=\"content-grid\">\n      <!-- Main Content -->\n      <div class=\"main-column\">\n        <!-- Description -->\n        <div class=\"card\">\n          <h3>📋 Description</h3>\n          <p class=\"description\">No description provided</p>\n          \n          \n        </div>\n        \n        <!-- Location -->\n        \n        \n        <!-- Customer Info -->\n        \n        \n        <!-- Resolution -->\n        \n        \n        <!-- Work Log -->\n        \n      </div>\n      \n      <!-- Sidebar -->\n      <div class=\"sidebar-column\">\n        <!-- Actions -->\n        <div class=\"card actions-card\">\n          <h3>⚡ Quick Actions</h3>\n          \n          <button \n              class=\"action-btn start-btn\"\n            >\n              ▶️ Start Work\n            </button>\n          \n          \n          \n          \n          \n          <button \n            class=\"action-btn secondary-btn\"\n          >\n            ✏️ Edit Details\n          </button>\n        </div>\n        \n        <!-- Details -->\n        <div class=\"card\">\n          <h3>ℹ️ Details</h3>\n          \n          <div class=\"detail-list\">\n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Type:</span>\n              <span class=\"detail-value\"></span>\n            </div>\n            \n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Created:</span>\n              <span class=\"detail-value\">2026-07-01 12:00:00</span>\n            </div>\n            \n            \n            \n            \n            \n            \n            \n            \n          </div>\n        </div>\n        \n        <!-- SLA -->\n        \n        \n        <!-- Timeline -->\n        <div class=\"card\">\n          <h3>📅 Timeline</h3>\n          \n          <div class=\"timeline\">\n            <div class=\"timeline-item\">\n              <span class=\"timeline-icon\">📝</span>\n              <div class=\"timeline-content\">\n                <span class=\"timeline-label\">Created</span>\n                <span class=\"timeline-time\">2026-07-01 12:00:00</span>\n              </div>\n            </div>\n            \n            \n            \n            \n            \n            \n            \n            \n          </div>\n        </div>\n      </div>\n    </div>\n  \n</div></div>";
}

