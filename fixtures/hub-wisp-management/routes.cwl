# Chrysalis Web Language — hub emit from svelte
module hub;

@page GET "/"
page root_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  return html "<p>Checking authentication…</p><script>location.replace(\"/login\");</script><noscript><a href=\"/login\">Continue to login</a></noscript>";
}

@page GET "/admin/billing"
page admin_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/admin/billing", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-module-demo wisp-demo-content\" data-wisp-page=\"admin_billing\" data-wisp-path=\"/admin/billing\" data-cwl-island=\"client\" data-wisp-layout=\"list\" data-wisp-api=\"/api/admin\">\n  <header class=\"wisp-demo-header\">\n    <h1>Billing</h1>\n    <p class=\"wisp-demo-desc\">Platform administration — tenants, billing, and system configuration.</p>\n    <div class=\"wisp-demo-toolbar\"><button type=\"button\" class=\"wisp-demo-btn\" data-action=\"refresh\">Refresh</button><a class=\"wisp-demo-btn primary\" href=\"/admin/billing/add\">Add new</a><button type=\"button\" class=\"wisp-demo-btn\" data-action=\"search\" title=\"Filter table\">Search</button><button type=\"button\" class=\"wisp-demo-btn\" data-action=\"export\" title=\"Export CSV\">Export</button><button type=\"button\" class=\"wisp-demo-btn\" data-action=\"back\">← Dashboard</button></div>\n  </header>\n  <section class=\"wisp-demo-panel\">\n    <div class=\"wisp-demo-stats\">\n  <article class=\"wisp-demo-stat\"><strong>12</strong><span>Active records</span></article>\n  <article class=\"wisp-demo-stat\"><strong>2</strong><span>Open alerts</span></article>\n  <article class=\"wisp-demo-stat\"><strong>3</strong><span>Pending tasks</span></article>\n</div>\n<table class=\"wisp-demo-table\" id=\"wisp-demo-table\" aria-label=\"Billing data\">\n  <thead><tr><th>ID</th><th>Name</th><th>Status</th><th>Updated</th></tr></thead>\n  <tbody><tr><td>t1</td><td>Acme Org</td><td>active</td><td></td></tr><tr><td>t2</td><td>Beta Org</td><td>trial</td><td></td></tr></tbody>\n</table>\n  </section>\n  <footer class=\"wisp-demo-api-status\" id=\"wisp-demo-api-status\" aria-live=\"polite\">Ready</footer>\n</div>";
}

