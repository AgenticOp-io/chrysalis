  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/voice-telephony" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"voice-telephony\" data-wisp-path=\"/modules/voice-telephony\" data-cwl-island=\"client\"><div class=\"voice-page\">\n    <header class=\"page-head\">\n      <div class=\"page-head-row\">\n        <h1>Voice / SIP & UC</h1>\n        <div class=\"page-toolbar\">\n          <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showModuleWizardMenu\" hidden aria-hidden=\"true\"><div class=\"module-wizard-menu\">\n    <button\n      type=\"button\"\n      class=\"wizard-trigger\" data-cwl-attr-disabled=\"disabled\" data-cwl-action=\"toggle\" data-cwl-on-blur=\"action:handleBlur\"\n      title=\"Wizards for this module\"\n      aria-haspopup=\"true\"\n    >\n      <span class=\"wizard-trigger-icon\">🧙</span>\n      <span class=\"wizard-trigger-label\">Wizards</span>\n      <span class=\"wizard-trigger-chevron\">▼</span>\n    </button>\n\n      <div class=\"wizard-dropdown\" role=\"menu\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"wizards as w\" data-cwl-each-item=\"w\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22menuitem%22%0A%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22wizard-item%22%20data-cwl-action%3D%22select%22%20data-cwl-action-args%3D%22w.id%22%0A%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20w.icon%7D%3Cspan%20class%3D%22wizard-item-icon%22%3E%7Bw.icon%7D%3C%2Fspan%3E%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22wizard-item-label%22%3E%7Bw.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20\"><button\n            type=\"button\"\n            role=\"menuitem\"\n            class=\"wizard-item\" data-cwl-action=\"select\" data-cwl-action-args=\"w.id\"\n           aria-label=\"Select\">\n            <div hidden aria-hidden=\"true\"><span class=\"wizard-item-icon\"></span></div>\n            <span class=\"wizard-item-label\"></span>\n          </button></div>\n      </div>\n\n  </div></div></div>\n          <button type=\"button\" class=\"btn tips-btn\" data-cwl-toggle=\"showTipsModal:true\" aria-label=\"Show Tips Modal\">Tips</button>\n        </div>\n      </div>\n      <p class=\"sub\">\n        Tenant-scoped numbers, carrier accounts, E911, and porting. Webhook ingress:\n        <code>POST /api/voice/webhooks/:provider</code> (HMAC when <code>VOICE_WEBHOOK_SECRET</code> is set).\n        Customer records link via <code>customerId</code> (same id as Customers module).\n      </p>\n    </header>\n\n    <div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showTipsModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div></div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"filterCustomerId\"><div class=\"filter-banner\" role=\"status\">\n        Filtered for customer <code><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filterCustomerId\"></span></code> (from Customers or URL).\n        <button type=\"button\" class=\"linkish\" data-cwl-nav=\"/modules/voice-telephony\">Show all</button>\n      </div></div>\n\n      <div class=\"alert err\" role=\"alert\" hidden aria-hidden=\"true\"></div>\n\n    <nav class=\"tabs\">\n      <button type=\"button\" data-cwl-set=\"activeTab:overview\">Overview</button>\n      <button type=\"button\" data-cwl-set=\"activeTab:accounts\">Provider accounts</button>\n      <button type=\"button\" data-cwl-set=\"activeTab:numbers\">Numbers</button>\n      <button type=\"button\" data-cwl-set=\"activeTab:ports\">Port orders</button>\n      <button type=\"button\" data-cwl-set=\"activeTab:locations\">Service locations</button>\n    </nav>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'overview'\">\n      <section class=\"panel\">\n        <h2>Bounded contexts</h2>\n        <ul class=\"ctx-list\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"schema.bounded_contexts as bc\"><li>\n              <strong></strong>\n              <span class=\"muted\">()</span> —\n            </li></div>\n        </ul>\n\n        <h2>State machines</h2>\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"Object.entries(schema.state_machines) as [k, v]\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"k === 'notes'\"><ul class=\"notes\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"(Array.isArray(v) ? v : []) as n\"><li></li></div>\n            </ul></div>\n            <p class=\"sm-key\"></p>\n            <ul class=\"inline\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"(Array.isArray(v) ? v : []) as x\"><li><code></code></li></div>\n            </ul>\n          </div>\n\n        <h2>Carrier comparison</h2>\n        <div class=\"table-wrap\">\n          <table>\n            <thead>\n              <tr>\n                <th>Dimension</th>\n                <th>Bandwidth</th>\n                <th>Telnyx</th>\n                <th>Twilio</th>\n              </tr>\n            </thead>\n            <tbody>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"schema.carrier_comparison as row\"><tr>\n                  <td></td>\n                  <td></td>\n                  <td></td>\n                  <td></td>\n                </tr></div>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"muted\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"schema.pragmatic_recommendation\"></span></p>\n\n        <h2>ArcGIS</h2>\n        <p class=\"muted\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"schema.arcgis.note\"></span></p>\n        <ul>\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"schema.arcgis.uses as u\"><li></li></div>\n        </ul>\n\n        <h2>Phased rollout</h2>\n        <ol>\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"schema.phased_rollout as ph\"><li><strong>Phase </strong> — </li></div>\n        </ol>\n      </section>\n    </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'accounts'\" hidden aria-hidden=\"true\">\n      <section class=\"panel\">\n        <div class=\"row\">\n          <h2>Voice provider accounts</h2>\n          <button type=\"button\" class=\"btn primary\" data-cwl-toggle=\"showAddAccount:true\" aria-label=\"Show Add Account\">Add account</button>\n        </div>\n\n          <div class=\"table-wrap\">\n            <table>\n              <thead>\n                <tr>\n                  <th>Provider</th>\n                  <th>External account ID</th>\n                  <th>Display name</th>\n                  <th>Credential ref</th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"accounts as a\" data-cwl-each-item=\"a\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%3Ccode%3E%7Ba.provider%7D%3C%2Fcode%3E%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Ba.externalAccountId%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Ba.displayName%20%7C%7C%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Ba.credentialRef%20%3F%20'%E2%80%A2%E2%80%A2%E2%80%A2%E2%80%A2'%20%3A%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                    <td><code></code></td>\n                    <td></td>\n                    <td></td>\n                    <td></td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n\n          <div hidden aria-hidden=\"true\"><p class=\"muted\">No provider accounts yet. Add one to represent your Bandwidth site, Twilio subaccount, or Telnyx connection.</p>\n        </div>\n      </section>\n    </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'numbers'\" hidden aria-hidden=\"true\">\n      <section class=\"panel\">\n        <div class=\"row\">\n          <h2>Telephone numbers</h2>\n          <button\n            type=\"button\"\n            class=\"btn primary\" data-cwl-attr-disabled=\"accounts.length === 0\" data-cwl-attr-title=\"accounts.length === 0 ? 'Add a provider account first' : ''\" data-cwl-toggle=\"showAddTn:true\"\n          >\n            Add number\n          </button>\n        </div>\n\n          <div class=\"table-wrap\">\n            <table>\n              <thead>\n                <tr>\n                  <th>E.164</th>\n                  <th>Status</th>\n                  <th>911</th>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!filterCustomerId\"><th>Customer</th></div>\n                  <th>Rate center</th>\n                  <th></th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"numbers as n\" data-cwl-each-item=\"n\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%3Ccode%3E%7Bn.e164%7D%3C%2Fcode%3E%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Bn.status%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20title%3D%22From%20linked%20emergency%20address%22%3E%7Bn.e911Display%20%3F%3F%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20!filterCustomerId%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20n.customerId%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ca%20href%3D%22%2Fmodules%2Fvoice-telephony%3FcustomerId%3D%7BencodeURIComponent(n.customerId)%7D%22%20class%3D%22map-link%22%3E%7Bn.customerId%7D%3C%2Fa%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%80%94%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Bn.rateCenter%20%7C%7C%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20type%3D%22button%22%20class%3D%22btn%20sm%22%20data-cwl-action%3D%22openEditTn%22%20data-cwl-action-args%3D%22n%22%20aria-label%3D%22Open%20Edit%20Tn%22%3EEdit%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                    <td><code></code></td>\n                    <td></td>\n                    <td title=\"From linked emergency address\"></td>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!filterCustomerId\"><td>\n\n                          —\n\n                          <div hidden aria-hidden=\"true\"><a href=\"/modules/voice-telephony?customerId=\" class=\"map-link\"></a>\n                        </div>\n                      </td></div>\n                    <td></td>\n                    <td>\n                      <button type=\"button\" class=\"btn sm\" data-cwl-action=\"openEditTn\" data-cwl-action-args=\"n\" aria-label=\"Open Edit Tn\">Edit</button>\n                    </td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n\n          <div hidden aria-hidden=\"true\"><p class=\"muted\">No numbers yet. Add one above or import from your carrier later.</p>\n        </div>\n          <div hidden aria-hidden=\"true\"><p class=\"muted\">Add a voice provider account on the <strong>Provider accounts</strong> tab before creating numbers.</p>\n        </div>\n      </section>\n    </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'ports'\" hidden aria-hidden=\"true\">\n      <section class=\"panel\">\n        <h2>Port orders (LNP)</h2>\n\n          <div class=\"table-wrap\">\n            <table>\n              <thead>\n                <tr>\n                  <th>Status</th>\n                  <th>TNs</th>\n                  <th>Losing carrier</th>\n                  <th>FOC target</th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"portOrders as o\" data-cwl-each-item=\"o\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%3Ccode%3E%7Bo.status%7D%3C%2Fcode%3E%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7B(o.telephoneNumbersE164%20%7C%7C%20%5B%5D).join('%2C%20')%20%7C%7C%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Bo.losingCarrierName%20%7C%7C%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7Bo.focTargetDate%20%7C%7C%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                    <td><code></code></td>\n                    <td><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"(o.telephoneNumbersE164 || []).join(', ') || '—'\"></span></td>\n                    <td></td>\n                    <td></td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n\n          <div hidden aria-hidden=\"true\"><p class=\"muted\">No port orders yet.</p>\n        </div>\n      </section>\n    </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'locations'\" hidden aria-hidden=\"true\">\n      <section class=\"panel\">\n        <div class=\"row\">\n          <h2>Service locations (E911 / geocode)</h2>\n          <button type=\"button\" class=\"btn primary\" data-cwl-toggle=\"showAddLocation:true\" aria-label=\"Show Add Location\">Add location</button>\n        </div>\n        <p class=\"muted small\">\n          Use the same <code>customerId</code> as the Customers module to tie addresses together. Coverage Map opens centered on\n          coordinates when available.\n        </p>\n\n          <div class=\"table-wrap\">\n            <table>\n              <thead>\n                <tr>\n                  <th>Address</th>\n                  <th>Customer</th>\n                  <th>Geocode</th>\n                  <th>Map</th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"locations as loc\" data-cwl-each-item=\"loc\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%7B%5Bloc.street%2C%20loc.unit%2C%20loc.city%2C%20loc.state%2C%20loc.postal%5D.filter(Boolean).join('%2C%20')%20%7C%7C%20'%E2%80%94'%7D%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20loc.customerId%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ca%20href%3D%22%2Fmodules%2Fvoice-telephony%3FcustomerId%3D%7BencodeURIComponent(loc.customerId)%7D%22%20class%3D%22map-link%22%3E%7Bloc.customerId%7D%3C%2Fa%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%80%94%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bloc.geocodeSource%20%7C%7C%20'%E2%80%94'%7D%7B%23if%20loc.geocodeScore%20!%3D%20null%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20(score%20%7Bloc.geocodeScore%7D)%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20loc.latitude%20!%3D%20null%20%26%26%20loc.longitude%20!%3D%20null%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ca%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22map-link%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20href%3D%22%2Fmodules%2Fcoverage-map%3FfocusLat%3D%7Bloc.latitude%7D%26focusLng%3D%7Bloc.longitude%7D%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Coverage%20map%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fa%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%80%94%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                    <td><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"[loc.street, loc.unit, loc.city, loc.state, loc.postal].filter(Boolean).join(', \"></span></td>\n                    <td>\n\n                        —\n\n                        <div hidden aria-hidden=\"true\"><a href=\"/modules/voice-telephony?customerId=\" class=\"map-link\"></a>\n                      </div>\n                    </td>\n                    <td>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"loc.geocodeScore != null\">(score )</div>\n                    </td>\n                    <td>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"loc.latitude != null && loc.longitude != null\"><a\n                          class=\"map-link\"\n                          href=\"/modules/coverage-map?focusLat=&focusLng=\"\n                        >\n                          Coverage map\n                        </a></div>\n                        —\n\n                    </td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n\n          <div hidden aria-hidden=\"true\"><p class=\"muted\">No service locations yet. Add one above.</p>\n        </div>\n      </section>\n    </div>\n  </div>\n\n    <div class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Add provider account\" data-cwl-shell-key=\"showAddAccount\" hidden aria-hidden=\"true\">\n      <div class=\"modal card\">\n        <h3>Add voice provider account</h3>\n        <label for=\"va-provider\">Provider</label>\n        <select id=\"va-provider\">\n          <option value=\"twilio\">Twilio</option>\n          <option value=\"telnyx\">Telnyx</option>\n          <option value=\"bandwidth\">Bandwidth</option>\n        </select>\n        <label for=\"va-ext\">External account ID</label>\n        <input id=\"va-ext\" type=\"text\" placeholder=\"Subaccount SID, site ID, etc.\" />\n        <label for=\"va-name\">Display name</label>\n        <input id=\"va-name\" type=\"text\" />\n        <label for=\"va-cred\">Credential ref (KMS / secret name — never paste secrets)</label>\n        <input id=\"va-cred\" type=\"text\" placeholder=\"Optional\" />\n        <div class=\"modal-actions\">\n          <button type=\"button\" class=\"btn\" data-cwl-toggle=\"showAddAccount:false\" aria-label=\"Show Add Account\">Cancel</button>\n          <button type=\"button\" class=\"btn primary\" data-cwl-attr-disabled=\"savingAccount || !newAccount.externalAccountId.trim()\" data-cwl-action=\"submitAccount\" aria-label=\"Submit Account\">\n            Save\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Add telephone number\" data-cwl-shell-key=\"showAddTn\" hidden aria-hidden=\"true\">\n      <div class=\"modal card wide\">\n        <h3>Add telephone number</h3>\n        <label for=\"tn-e164\">E.164</label>\n        <input id=\"tn-e164\" type=\"text\" placeholder=\"+15551234567\" autocomplete=\"tel\" />\n        <label for=\"tn-status\">Status</label>\n        <select id=\"tn-status\">\n          <option value=\"inventory\">inventory</option>\n          <option value=\"assigned\">assigned</option>\n          <option value=\"suspended\">suspended</option>\n        </select>\n        <label for=\"tn-acct\">Voice provider account</label>\n        <select id=\"tn-acct\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"accounts as a\" data-cwl-each-item=\"a\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Ba._id%7D%3E%7Ba.provider%7D%20%E2%80%94%20%7Ba.displayName%20%7C%7C%20a.externalAccountId%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20\"><option> — </option></div>\n        </select>\n        <label for=\"tn-prov\">Provider TN ID (optional)</label>\n        <input id=\"tn-prov\" type=\"text\" placeholder=\"Carrier-side ID\" />\n        <label for=\"tn-rc\">Rate center / LATA (optional)</label>\n        <div class=\"grid-2\">\n          <input id=\"tn-rc\" type=\"text\" placeholder=\"Rate center\" />\n          <input id=\"tn-lata\" type=\"text\" placeholder=\"LATA\" />\n        </div>\n        <label for=\"tn-e911\">Emergency address ID (optional)</label>\n        <input id=\"tn-e911\" type=\"text\" placeholder=\"Mongo ObjectId after E911 is provisioned\" />\n        <label for=\"tn-cust\">Customer ID (optional)</label>\n        <input id=\"tn-cust\" type=\"text\" placeholder=\"Same as Customers module, e.g. CUST-2025-001\" />\n        <div class=\"modal-actions\">\n          <button type=\"button\" class=\"btn\" data-cwl-toggle=\"showAddTn:false\" aria-label=\"Show Add Tn\">Cancel</button>\n          <button\n            type=\"button\"\n            class=\"btn primary\" data-cwl-attr-disabled=\"savingTn || !newTn.e164.trim() || !newTn.voiceProviderAccountId\" data-cwl-action=\"submitTn\"\n           aria-label=\"Submit Tn\">\n            Create\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Edit telephone number\" data-cwl-shell-key=\"showEditTn\" hidden aria-hidden=\"true\">\n      <div class=\"modal card wide\">\n        <h3>Edit <code><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editTn.e164\"></span></code></h3>\n        <label for=\"etn-status\">Status</label>\n        <select id=\"etn-status\">\n          <option value=\"inventory\">inventory</option>\n          <option value=\"assigned\">assigned</option>\n          <option value=\"suspended\">suspended</option>\n        </select>\n        <label for=\"etn-cust\">Customer ID</label>\n        <input id=\"etn-cust\" type=\"text\" placeholder=\"Leave empty to clear\" />\n        <label for=\"etn-rc\">Rate center / LATA</label>\n        <div class=\"grid-2\">\n          <input id=\"etn-rc\" type=\"text\" placeholder=\"Rate center\" />\n          <input id=\"etn-lata\" type=\"text\" placeholder=\"LATA\" />\n        </div>\n        <label for=\"etn-prov\">Provider TN ID</label>\n        <input id=\"etn-prov\" type=\"text\" />\n        <div class=\"modal-actions\">\n          <button\n            type=\"button\"\n            class=\"btn\" data-cwl-toggle=\"showEditTn:false\" aria-label=\"Show Edit Tn\">Cancel</button>\n          <button type=\"button\" class=\"btn primary\" data-cwl-attr-disabled=\"savingEditTn\" data-cwl-action=\"submitEditTn\" aria-label=\"Submit Edit Tn\">\n            Save\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Add service location\" data-cwl-shell-key=\"showAddLocation\" hidden aria-hidden=\"true\">\n      <div class=\"modal card wide\">\n        <h3>Add service location</h3>\n        <label for=\"sl-cust\">Customer ID (optional)</label>\n        <input id=\"sl-cust\" type=\"text\" placeholder=\"Same as Customers module\" />\n        <label for=\"sl-street\">Street</label>\n        <input id=\"sl-street\" type=\"text\" />\n        <label for=\"sl-unit\">Unit (optional)</label>\n        <input id=\"sl-unit\" type=\"text\" />\n        <div class=\"grid-2\">\n          <div>\n            <label for=\"sl-city\">City</label>\n            <input id=\"sl-city\" type=\"text\" />\n          </div>\n          <div>\n            <label for=\"sl-state\">State</label>\n            <input id=\"sl-state\" type=\"text\" maxlength=\"2\" placeholder=\"TX\" />\n          </div>\n        </div>\n        <div class=\"grid-2\">\n          <div>\n            <label for=\"sl-postal\">Postal</label>\n            <input id=\"sl-postal\" type=\"text\" />\n          </div>\n          <div>\n            <label for=\"sl-country\">Country</label>\n            <input id=\"sl-country\" type=\"text\" />\n          </div>\n        </div>\n        <p class=\"muted small\">Coordinates (optional — enables Coverage map link)</p>\n        <div class=\"grid-2\">\n          <div>\n            <label for=\"sl-lat\">Latitude</label>\n            <input id=\"sl-lat\" type=\"text\" placeholder=\"e.g. 32.7767\" />\n          </div>\n          <div>\n            <label for=\"sl-lng\">Longitude</label>\n            <input id=\"sl-lng\" type=\"text\" placeholder=\"e.g. -96.7970\" />\n          </div>\n        </div>\n        <div class=\"grid-2\">\n          <div>\n            <label for=\"sl-acc\">Geocode accuracy (m)</label>\n            <input id=\"sl-acc\" type=\"text\" />\n          </div>\n          <div>\n            <label for=\"sl-score\">Geocode score</label>\n            <input id=\"sl-score\" type=\"text\" />\n          </div>\n        </div>\n        <label for=\"sl-src\">Geocode source</label>\n        <input id=\"sl-src\" type=\"text\" placeholder=\"e.g. arcgis\" />\n        <label for=\"sl-locname\">Locator name</label>\n        <input id=\"sl-locname\" type=\"text\" />\n        <div class=\"modal-actions\">\n          <button type=\"button\" class=\"btn\" data-cwl-toggle=\"showAddLocation:false\" aria-label=\"Show Add Location\">Cancel</button>\n          <button type=\"button\" class=\"btn primary\" data-cwl-attr-disabled=\"savingLoc\" data-cwl-action=\"submitLocation\" aria-label=\"Submit Location\">\n            Create\n          </button>\n        </div>\n      </div>\n    </div></div>";
}

@page GET "/modules/work-orders"
page modules_work_orders_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "work-orders" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"work-orders\" data-wisp-path=\"/modules/work-orders\" data-cwl-island=\"client\"><div class=\"work-orders-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\" data-cwl-nav=\"/dashboard\" type=\"button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📋 Work Orders & Tickets</h1>\n      <p class=\"subtitle\">Field operations and trouble ticket management</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\" data-cwl-action=\"loadData\" aria-label=\"Load Data\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn-secondary\" data-cwl-toggle=\"showCreateModal:true\" aria-label=\"Show Create Modal\">\n        ➕ Quick Create\n      </button>\n      <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showModuleWizardMenu\" hidden aria-hidden=\"true\"><div class=\"module-wizard-menu\">\n    <button\n      type=\"button\"\n      class=\"wizard-trigger\" data-cwl-attr-disabled=\"disabled\" data-cwl-action=\"toggle\" data-cwl-on-blur=\"action:handleBlur\"\n      title=\"Wizards for this module\"\n      aria-haspopup=\"true\"\n    >\n      <span class=\"wizard-trigger-icon\">🧙</span>\n      <span class=\"wizard-trigger-label\">Wizards</span>\n      <span class=\"wizard-trigger-chevron\">▼</span>\n    </button>\n\n      <div class=\"wizard-dropdown\" role=\"menu\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"wizards as w\" data-cwl-each-item=\"w\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22menuitem%22%0A%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22wizard-item%22%20data-cwl-action%3D%22select%22%20data-cwl-action-args%3D%22w.id%22%0A%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20w.icon%7D%3Cspan%20class%3D%22wizard-item-icon%22%3E%7Bw.icon%7D%3C%2Fspan%3E%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22wizard-item-label%22%3E%7Bw.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20\"><button\n            type=\"button\"\n            role=\"menuitem\"\n            class=\"wizard-item\" data-cwl-action=\"select\" data-cwl-action-args=\"w.id\"\n           aria-label=\"Select\">\n            <div hidden aria-hidden=\"true\"><span class=\"wizard-item-icon\"></span></div>\n            <span class=\"wizard-item-label\"></span>\n          </button></div>\n      </div>\n\n  </div></div></div>\n    </div>\n  </div>\n\n  <!-- Alerts -->\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      <span>⚠️</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n      <span>✅</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"success:\">✕</button>\n    </div>\n\n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrders.length\"></span></div>\n        <div class=\"stat-label\">Total Tickets</div>\n      </div>\n    </div>\n\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔓</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.totalOpen\"></span></div>\n        <div class=\"stat-label\">Open</div>\n      </div>\n    </div>\n\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⚡</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrders.filter(wo => wo.priority === 'critical' || wo.priority === 'high').le\"></span>\n        </div>\n        <div class=\"stat-label\">High Priority</div>\n      </div>\n    </div>\n\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"stats.avgResolutionTime ? Math.round(stats.avgResolutionTime) : 0\"></span>h\n        </div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <select data-cwl-on-change=\"action:applyFilters\">\n        <option>All Statuses</option>\n\n          <option value=\"open\">open</option>\n\n          <option value=\"assigned\">assigned</option>\n\n          <option value=\"in-progress\">in-progress</option>\n\n          <option value=\"waiting-parts\">waiting-parts</option>\n\n          <option value=\"resolved\">resolved</option>\n\n          <option value=\"closed\">closed</option>\n\n      </select>\n\n      <select data-cwl-on-change=\"action:applyFilters\">\n        <option>All Priorities</option>\n\n          <option value=\"low\">low</option>\n\n          <option value=\"medium\">medium</option>\n\n          <option value=\"high\">high</option>\n\n          <option value=\"critical\">critical</option>\n\n      </select>\n\n      <select data-cwl-on-change=\"action:applyFilters\">\n        <option>All Types</option>\n\n          <option value=\"installation\">installation</option>\n\n          <option value=\"repair\">repair</option>\n\n          <option value=\"maintenance\">maintenance</option>\n\n          <option value=\"upgrade\">upgrade</option>\n\n          <option value=\"removal\">removal</option>\n\n          <option value=\"troubleshoot\">troubleshoot</option>\n\n          <option value=\"inspection\">inspection</option>\n\n      </select>\n\n      <button class=\"btn-secondary\" data-cwl-action=\"clearFilters\" aria-label=\"Clear Filters\">\n        Clear Filters\n      </button>\n    </div>\n  </div>\n\n  <!-- Work Orders List -->\n\n    <div class=\"work-orders-grid\">\n      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"workOrders as workOrder\" data-cwl-each-item=\"workOrder\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%3CWorkOrderCard%20%0A%20%20%20%20%20%20%20%20%20%20%7BworkOrder%7D%20data-cwl-nav%3D%22%2Fmodules%2Fwork-orders%2F%7BworkOrder._id%7D%22%20data-cwl-on-refresh%3D%22action%3AloadData%22%0A%20%20%20%20%20%20%20%20%2F%3E%0A%20%20%20%20%20%20\"><div data-cwl-component=\"WorkOrderCard\" data-cwl-lifted-component=\"WorkOrderCard\"><div\n  class=\"work-order-card\"\n  style=\"border-left: 4px solid\" data-cwl-action=\"click\"\n  role=\"button\"\n  tabindex=\"0\"\n>\n  <div class=\"card-header\">\n    <div class=\"header-left\">\n      <span class=\"priority-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getPriorityIcon(workOrder.priority)\"></span></span>\n      <div class=\"title-group\">\n        <h3 class=\"ticket-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.ticketNumber || 'TKT-NEW'\"></span></h3>\n        <span class=\"ticket-type\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.type\"></span></span>\n      </div>\n    </div>\n\n    <div\n      class=\"status-badge\"\n      style=\"background-color:\"\n    >\n      <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.status\"></span>\n    </div>\n  </div>\n\n  <p class=\"ticket-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.title\"></span></p>\n\n    <div hidden aria-hidden=\"true\"><p class=\"ticket-description\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.description.substring(0, 150)\"></span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.description.length > 150 ? '...' : ''\"></span></p>\n  </div>\n\n    <div class=\"location-info\" hidden aria-hidden=\"true\">\n      <span class=\"location-icon\">📍</span>\n      <span class=\"location-text\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.location.siteName || workOrder.location.address || workOrder.location.\"></span>\n      </span>\n    </div>\n\n  <div class=\"card-footer\">\n    <div class=\"footer-left\">\n      <span class=\"time-ago\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatTimeAgo(workOrder.createdAt)\"></span></span>\n\n        <div hidden aria-hidden=\"true\"><span class=\"assignee\">👤 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.assignedToName\"></span></span>\n      </div>\n    </div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"workOrder.sla?.breached\"><span class=\"sla-breach\">⚠️ SLA Breach</span></div>\n  </div>\n</div></div></div>\n\n        <div class=\"empty-state\" hidden aria-hidden=\"true\">\n          <div class=\"empty-icon\">📋</div>\n          <h3>No work orders found</h3>\n          <p>Create your first work order or adjust filters</p>\n          <button class=\"btn-primary\" data-cwl-toggle=\"showCreateModal:true\" aria-label=\"Show Create Modal\">\n            ➕ Create Work Order\n          </button>\n        </div>\n\n    </div>\n\n    <div class=\"loading-state\" hidden aria-hidden=\"true\">\n      <div class=\"spinner\"></div>\n      <p>Loading work orders...</p>\n    </div>\n\n  <!-- Create Modal -->\n  <div data-cwl-component=\"CreateWorkOrderModal\" data-cwl-lifted-component=\"CreateWorkOrderModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showCreateModal\" hidden aria-hidden=\"true\"><div\n  class=\"modal-overlay\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  tabindex=\"0\"\n  aria-label=\"Create work order dialog\" data-cwl-action=\"handleOverlayClick\" data-cwl-on-keydown=\"action:handleOverlayKeydown\"\n hidden aria-hidden=\"true\">\n  <div class=\"modal-content\" role=\"document\">\n    <div class=\"modal-header\">\n      <h2>➕ Create Work Order</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Type *</label>\n            <select>\n              <option value=\"installation\">Installation</option>\n              <option value=\"repair\">Repair</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"upgrade\">Upgrade</option>\n              <option value=\"removal\">Removal</option>\n              <option value=\"troubleshoot\">Troubleshoot</option>\n              <option value=\"inspection\">Inspection</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Priority *</label>\n            <select>\n              <option value=\"low\">Low</option>\n              <option value=\"medium\">Medium</option>\n              <option value=\"high\">High</option>\n              <option value=\"critical\">Critical</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Title *</label>\n          <input\n            type=\"text\"\n            placeholder=\"Brief description of the issue or task\"\n            required\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Description</label>\n          <textarea\n            placeholder=\"Detailed description of the work to be performed...\"\n            rows=\"4\"\n          ></textarea>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.type === 'troubleshoot' || formData.type === 'repair'\"><div class=\"form-group\">\n            <label>Issue Category</label>\n            <select>\n              <option>Select category...</option>\n              <option value=\"cpe-offline\">CPE Offline</option>\n              <option value=\"sector-down\">Sector Down</option>\n              <option value=\"backhaul-failure\">Backhaul Failure</option>\n              <option value=\"network-outage\">Network Outage</option>\n              <option value=\"poor-performance\">Poor Performance</option>\n              <option value=\"equipment-failure\">Equipment Failure</option>\n              <option value=\"power-issue\">Power Issue</option>\n              <option value=\"configuration-error\">Configuration Error</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div></div>\n      </div>\n\n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 Location</h3>\n\n        <div class=\"form-group\">\n          <label>Site</label>\n          <select data-cwl-attr-value=\"formData.location.siteId\" data-cwl-on-change=\"action:handleSiteChange\">\n            <option>Select site...</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%20(%7Bsite.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n          </select>\n        </div>\n      </div>\n\n      <!-- Customer Info -->\n      <div class=\"section\">\n        <h3>👤 Customer Information</h3>\n\n        <div class=\"form-group\">\n          <label>\n            <input type=\"checkbox\" />\n            Customer Reported Issue\n          </label>\n        </div>\n\n          <div hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedCustomer\"><div class=\"selected-customer\">\n              <div class=\"customer-card\">\n                <div class=\"customer-info\">\n                  <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedCustomer.fullName || ` $\"></span></strong>\n                  <span class=\"customer-id\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedCustomer.customerId\"></span></span>\n\n                    <div class=\"customer-phone\" hidden aria-hidden=\"true\">📞 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedCustomer.primaryPhone\"></span></div>\n\n                    <div class=\"customer-email\" hidden aria-hidden=\"true\">📧 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedCustomer.email\"></span></div>\n\n                </div>\n                <button type=\"button\" class=\"btn-remove\" data-cwl-action=\"clearCustomer\" aria-label=\"Clear Customer\">✕</button>\n              </div>\n            </div></div>\n            <div class=\"customer-lookup-section\">\n              <button\n                type=\"button\"\n                class=\"btn-lookup\" data-cwl-toggle=\"showCustomerLookup:true\"\n               aria-label=\"Show Customer Lookup\">\n                🔍 Lookup Customer from Database\n              </button>\n              <p class=\"or-divider\">OR</p>\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>Customer Name</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"John Smith\"\n                  />\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Phone</label>\n                  <input\n                    type=\"tel\"\n                    placeholder=\"555-1234\"\n                  />\n                </div>\n              </div>\n            </div>\n\n        </div>\n      </div>\n\n      <!-- Scheduling -->\n      <div class=\"section\">\n        <h3>📅 Scheduling</h3>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Scheduled Date</label>\n            <input\n              type=\"datetime-local\"\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Estimated Duration (minutes)</label>\n            <input\n              type=\"number\"\n              placeholder=\"120\"\n            />\n          </div>\n        </div>\n      </div>\n\n      <!-- SLA -->\n      <div class=\"section\">\n        <h3>⏱️ SLA (Service Level Agreement)</h3>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Response Time (hours)</label>\n            <input\n              type=\"number\"\n              placeholder=\"4\"\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Resolution Time (hours)</label>\n            <input\n              type=\"number\"\n              placeholder=\"24\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create Work Order\n      </button>\n    </div>\n  </div>\n</div>\n\n  <div data-cwl-shell-key=\"showCustomerLookup\" hidden aria-hidden=\"true\"><div data-cwl-component=\"CustomerLookupModal\" data-cwl-lifted-component=\"CustomerLookupModal\"><div\n  class=\"modal-backdrop\"\n  role=\"presentation\" data-cwl-action=\"close\"\n>\n  <div\n    class=\"modal-content\"\n    data-size=\"sm\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"customer-lookup-heading\"\n  >\n    <header class=\"modal-header\">\n      <div>\n        <p class=\"modal-eyebrow\">Customers</p>\n        <h2 id=\"customer-lookup-heading\">Customer Lookup</h2>\n      </div>\n      <button\n        class=\"modal-close-btn\"\n        type=\"button\"\n        aria-label=\"Close customer lookup\" data-cwl-action=\"close\"\n      >\n        ✕\n      </button>\n    </header>\n\n    <section class=\"modal-body\">\n      <div class=\"search-section\">\n        <input\n          type=\"text\"\n          placeholder=\"Search by name, phone, email, or customer ID...\"\n          class=\"search-input\" data-cwl-on-input=\"action:loadCustomers\"\n        />\n      </div>\n\n        <div class=\"error-message\" role=\"alert\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"customer-list\" role=\"listbox\" aria-label=\"Customer results\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"customers as customer (customer._id || customer.customerId)\" data-cwl-each-item=\"customer\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22customer-item%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22option%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20aria-selected%3D%7BselectedCustomerId%20%3D%3D%3D%20(customer._id%20%7C%7C%20customer.customerId)%7D%20data-cwl-action%3D%22selectCustomer%22%20data-cwl-action-args%3D%22customer%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%20Customer%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-name%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcustomer.fullName%20%7C%7C%20%60%24%7Bcustomer.firstName%7D%20%24%7Bcustomer.lastName%7D%60%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.customerId%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22customer-id%22%3E%23%7Bcustomer.customerId%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceStatus%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-%7Bcustomer.serviceStatus%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.serviceStatus%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.primaryPhone%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%9E%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatPhone(customer.primaryPhone)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.email%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%A7%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.email%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceAddress%3F.street%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%8D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.serviceAddress.street%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceAddress.city%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2C%20%7Bcustomer.serviceAddress.city%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.networkInfo%3F.imsi%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%A1%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20IMSI%3A%20%7Bcustomer.networkInfo.imsi%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.servicePlan%3F.planName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-plan%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Plan%3A%20%7Bcustomer.servicePlan.planName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.servicePlan.downloadMbps%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20(%7Bcustomer.servicePlan.downloadMbps%7D%2F%7Bcustomer.servicePlan.uploadMbps%7D%20Mbps)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20\"><button\n              class=\"customer-item\"\n              type=\"button\"\n              role=\"option\" data-cwl-action=\"selectCustomer\" data-cwl-action-args=\"customer\"\n             aria-label=\"Select Customer\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name\">\n                  <strong> </strong>\n\n                    <div hidden aria-hidden=\"true\"><span class=\"customer-id\">#</span>\n                  </div>\n                </div>\n\n                  <div hidden aria-hidden=\"true\"><span class=\"status-badge status-\">\n\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"customer-details\">\n\n                  <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📞</span>\n\n                  </div>\n\n                  <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📧</span>\n\n                  </div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.serviceAddress?.street\"><div class=\"detail-item\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📍</span>\n\n                      <div hidden aria-hidden=\"true\">,\n                    </div>\n                  </div></div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.networkInfo?.imsi\"><div class=\"detail-item\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📡</span>\n                    IMSI:\n                  </div></div>\n              </div>\n\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.servicePlan?.planName\"><div class=\"customer-plan\">\n                  Plan:\n\n                    <div hidden aria-hidden=\"true\">(/ Mbps)\n                  </div>\n                </div></div>\n            </button></div>\n        </div>\n\n        <div class=\"state-message\" hidden aria-hidden=\"true\">\n          <p>No customers found. Create a customer first.</p>\n        </div>\n\n        <div class=\"state-message\" hidden aria-hidden=\"true\">\n          <p>No customers found matching “”.</p>\n        </div>\n\n    </section>\n  </div>\n</div></div>\n</div></div></div>\n\n  <!-- Work Order Creation Wizard -->\n  <div data-cwl-component=\"WorkOrderCreationWizard\" data-cwl-lifted-component=\"WorkOrderCreationWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showWorkOrderWizard\" hidden aria-hidden=\"true\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showBaseWizard\" hidden aria-hidden=\"true\"><div\n    class=\"wizard-overlay\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"wizard-title\" data-cwl-action=\"handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"wizard-modal\"\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\">📋 Work Order Creation Wizard</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <!-- Progress Steps -->\n\n        <nav class=\"wizard-steps\" aria-label=\"Wizard steps\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"steps as step, index\"><button\n              type=\"button\"\n              class=\"wizard-step\" data-cwl-attr-disabled=\"!allowStepNavigation || index &gt; currentStep\" data-cwl-action=\"goToStep\" data-cwl-action-args=\"index\"\n             aria-label=\"Go To Step\">\n              <span class=\"step-icon\"></span>\n              <span class=\"step-title\"></span>\n            </button></div>\n        </nav>\n\n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n          <div class=\"alert alert-success\" hidden aria-hidden=\"true\"></div>\n\n        <!-- Slot for step content -->\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><!-- Welcome Step -->\n      <div class=\"wizard-panel\">\n        <h3>Welcome to Work Order Creation! 📋</h3>\n        <p>This wizard will guide you through creating a work order or ticket.</p>\n\n        <div class=\"info-box\">\n          <h4>What You'll Do:</h4>\n          <ul>\n            <li>✅ Select work order type</li>\n            <li>✅ Identify affected sites/equipment/customers</li>\n            <li>✅ Enter details and description</li>\n            <li>✅ Set priority and SLA</li>\n            <li>✅ Assign technician (optional)</li>\n            <li>✅ Attach files/photos</li>\n          </ul>\n        </div>\n\n        <div class=\"info-box\">\n          <h4>Work Order Types:</h4>\n          <ul>\n            <li><strong>Installation:</strong> New equipment installation</li>\n            <li><strong>Repair:</strong> Fix broken equipment</li>\n            <li><strong>Maintenance:</strong> Scheduled maintenance</li>\n            <li><strong>Upgrade:</strong> Equipment upgrade</li>\n            <li><strong>Removal:</strong> Remove equipment</li>\n            <li><strong>Troubleshoot:</strong> Diagnose issues</li>\n            <li><strong>Inspection:</strong> Site inspection</li>\n          </ul>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 1\"><!-- Work Order Type -->\n      <div class=\"wizard-panel\">\n        <h3>Select Work Order Type</h3>\n        <p>What type of work order are you creating?</p>\n\n        <div class=\"type-grid\">\n          <button\n            class=\"type-card\" data-cwl-action=\"selectWorkOrderType\" data-cwl-action-args=\"'installation'\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Select Work Order Type\">\n            <div class=\"type-icon\">🔧</div>\n            <h4>Installation</h4>\n            <p>New equipment installation</p>\n          </button>\n\n          <button\n            class=\"type-card\" data-cwl-action=\"selectWorkOrderType\" data-cwl-action-args=\"'repair'\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Select Work Order Type\">\n            <div class=\"type-icon\">🔨</div>\n            <h4>Repair</h4>\n            <p>Fix broken equipment</p>\n          </button>\n\n          <button\n            class=\"type-card\" data-cwl-action=\"selectWorkOrderType\" data-cwl-action-args=\"'maintenance'\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Select Work Order Type\">\n            <div class=\"type-icon\">🛠️</div>\n            <h4>Maintenance</h4>\n            <p>Scheduled maintenance</p>\n          </button>\n\n          <button\n            class=\"type-card\" data-cwl-action=\"selectWorkOrderType\" data-cwl-action-args=\"'troubleshoot'\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Select Work Order Type\">\n            <div class=\"type-icon\">🔍</div>\n            <h4>Troubleshoot</h4>\n            <p>Diagnose issues</p>\n          </button>\n\n          <button\n            class=\"type-card\" data-cwl-action=\"selectWorkOrderType\" data-cwl-action-args=\"'upgrade'\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Select Work Order Type\">\n            <div class=\"type-icon\">⬆️</div>\n            <h4>Upgrade</h4>\n            <p>Equipment upgrade</p>\n          </button>\n\n          <button\n            class=\"type-card\" data-cwl-action=\"selectWorkOrderType\" data-cwl-action-args=\"'removal'\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Select Work Order Type\">\n            <div class=\"type-icon\">🗑️</div>\n            <h4>Removal</h4>\n            <p>Remove equipment</p>\n          </button>\n\n          <button\n            class=\"type-card\" data-cwl-action=\"selectWorkOrderType\" data-cwl-action-args=\"'inspection'\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Select Work Order Type\">\n            <div class=\"type-icon\">👁️</div>\n            <h4>Inspection</h4>\n            <p>Site inspection</p>\n          </button>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><!-- Affected Items -->\n      <div class=\"wizard-panel\">\n        <h3>Affected Sites & Equipment</h3>\n        <p>Select sites and equipment affected by this work order.</p>\n\n        <div class=\"affected-section\">\n          <h4>Sites</h4>\n\n            <div class=\"items-grid\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableSites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22item-card%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3Aselected%3D%7BaffectedSites.some(s%20%3D%3E%20s.siteId%20%3D%3D%3D%20site.id)%7D%20data-cwl-action%3D%22toggleSite%22%20data-cwl-action-args%3D%22site.id%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7BisLoading%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7Bsite.name%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><button\n                  class=\"item-card\" data-cwl-action=\"toggleSite\" data-cwl-action-args=\"site.id\" aria-label=\"Toggle Site\">\n                  <h4></h4>\n                </button></div>\n            </div>\n\n            <div class=\"info-box\" hidden aria-hidden=\"true\">\n              <p>No sites available. Sites will be added as you deploy equipment.</p>\n            </div>\n\n        </div>\n\n        <div class=\"affected-section\">\n          <h4>Equipment</h4>\n\n            <div class=\"items-grid\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableEquipment as equipment\" data-cwl-each-item=\"equipment\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22item-card%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3Aselected%3D%7BaffectedEquipment.some(e%20%3D%3E%20e.equipmentId%20%3D%3D%3D%20equipment.id)%7D%20data-cwl-action%3D%22toggleEquipment%22%20data-cwl-action-args%3D%22equipment.id%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7BisLoading%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7Bequipment.name%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><button\n                  class=\"item-card\" data-cwl-action=\"toggleEquipment\" data-cwl-action-args=\"equipment.id\" aria-label=\"Toggle Equipment\">\n                  <h4></h4>\n                </button></div>\n            </div>\n\n            <div class=\"info-box\" hidden aria-hidden=\"true\">\n              <p>No equipment available. Equipment will appear as it's added to inventory.</p>\n            </div>\n\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"affectedSites.length > 0 || affectedEquipment.length > 0\"><div class=\"selected-summary\">\n            <h4>Selected:</h4>\n\n              <p><strong>Sites:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"affectedSites.length\"></span></p>\n\n              <p><strong>Equipment:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"affectedEquipment.length\"></span></p>\n\n          </div></div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 3\"><!-- Details -->\n      <div class=\"wizard-panel\">\n        <h3>Work Order Details</h3>\n\n        <div class=\"form-group\">\n          <label>\n            Title <span class=\"required\">*</span>\n          </label>\n          <input\n            type=\"text\"\n            placeholder=\"Brief description of the work order\" data-cwl-attr-disabled=\"isLoading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label>\n            Description <span class=\"required\">*</span>\n          </label>\n          <textarea\n            placeholder=\"Detailed description of the issue or work needed...\"\n            rows=\"6\" data-cwl-attr-disabled=\"isLoading\"\n          ></textarea>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Issue Category</label>\n          <select data-cwl-attr-disabled=\"isLoading\">\n            <option>-- Select Category --</option>\n            <option value=\"cpe-offline\">CPE Offline</option>\n            <option value=\"sector-down\">Sector Down</option>\n            <option value=\"backhaul-failure\">Backhaul Failure</option>\n            <option value=\"power-issue\">Power Issue</option>\n            <option value=\"signal-issue\">Signal Issue</option>\n            <option value=\"configuration\">Configuration</option>\n            <option value=\"other\">Other</option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>\n            <input\n              type=\"checkbox\" data-cwl-attr-disabled=\"isLoading\"\n            />\n            Customer Reported Issue\n          </label>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Attach Files/Photos</label>\n          <input\n            type=\"file\"\n            accept=\"image/*,.pdf,.doc,.docx\"\n            multiple data-cwl-on-change=\"action:handleFileUpload\" data-cwl-attr-disabled=\"isLoading\"\n          />\n\n            <div class=\"attachments-list\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"attachments as attachment, index\"><div class=\"attachment-item\">\n                  <span></span>\n                  <button\n                    class=\"btn-icon\" data-cwl-action=\"removeAttachment\" data-cwl-action-args=\"index\" aria-label=\"Remove Attachment\">\n                    ×\n                  </button>\n                </div></div>\n            </div>\n\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 4\"><!-- Priority & SLA -->\n      <div class=\"wizard-panel\">\n        <h3>Priority & SLA</h3>\n\n        <div class=\"form-group\">\n          <label>Priority</label>\n          <select data-cwl-attr-disabled=\"isLoading\">\n            <option value=\"low\">Low</option>\n            <option value=\"medium\">Medium</option>\n            <option value=\"high\">High</option>\n            <option value=\"critical\">Critical</option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Scheduled Date (Optional)</label>\n          <input\n            type=\"datetime-local\" data-cwl-attr-disabled=\"isLoading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label>Estimated Duration (minutes)</label>\n          <input\n            type=\"number\"\n            min=\"15\"\n            step=\"15\" data-cwl-attr-disabled=\"isLoading\"\n          />\n        </div>\n\n        <div class=\"sla-section\">\n          <h4>SLA Settings</h4>\n          <div class=\"form-group\">\n            <label>Response Time (hours)</label>\n            <input\n              type=\"number\"\n              min=\"1\" data-cwl-attr-disabled=\"isLoading\"\n            />\n            <small>Time to acknowledge the work order</small>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Resolution Time (hours)</label>\n            <input\n              type=\"number\"\n              min=\"1\" data-cwl-attr-disabled=\"isLoading\"\n            />\n            <small>Time to resolve the work order</small>\n          </div>\n        </div>\n\n        <div class=\"info-box\">\n          <p><strong>Priority Guidelines:</strong></p>\n          <ul>\n            <li><strong>Critical:</strong> Service outage affecting multiple customers</li>\n            <li><strong>High:</strong> Service issue affecting one or more customers</li>\n            <li><strong>Medium:</strong> Non-urgent repair or maintenance</li>\n            <li><strong>Low:</strong> Routine maintenance or upgrades</li>\n          </ul>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 5\"><!-- Assign -->\n      <div class=\"wizard-panel\">\n        <h3>Assign Technician</h3>\n        <p>Optionally assign this work order to a technician.</p>\n\n        <div class=\"form-group\">\n          <label>Assign To (Optional)</label>\n          <select data-cwl-attr-disabled=\"isLoading\">\n            <option>-- Unassigned --</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableTechnicians as tech\" data-cwl-each-item=\"tech\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Btech.id%7D%3E%7Btech.name%7D%20(%7Btech.email%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n          </select>\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"assignedTo\"><div class=\"info-box success\">\n            <p>Work order will be assigned to: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"availableTechnicians.find(t => t.id === assignedTo)?.name || 'Unknown'\"></span></p>\n          </div></div>\n          <div class=\"info-box\">\n            <p>Work order will be created as \"Open\" and can be assigned later.</p>\n          </div>\n\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 6\"><!-- Complete -->\n      <div class=\"wizard-panel\">\n        <h3>🎉 Work Order Created!</h3>\n        <p>Your work order has been created successfully.</p>\n\n        <div class=\"workorder-summary\">\n          <h4>Work Order Summary</h4>\n          <div class=\"summary-row\">\n            <span class=\"label\">Type:</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrderType\"></span></span>\n          </div>\n          <div class=\"summary-row\">\n            <span class=\"label\">Priority:</span>\n            <span class=\"value\">medium</span>\n          </div>\n          <div class=\"summary-row\">\n            <span class=\"label\">Title:</span>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"summary-row\">\n            <span class=\"label\">Affected Sites:</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"affectedSites.length\"></span></span>\n          </div>\n          <div class=\"summary-row\">\n            <span class=\"label\">Affected Equipment:</span>\n            <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"affectedEquipment.length\"></span></span>\n          </div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"assignedTo\"><div class=\"summary-row\">\n              <span class=\"label\">Assigned To:</span>\n              <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"availableTechnicians.find(t => t.id === assignedTo)?.name || 'Unknown'\"></span></span>\n            </div></div>\n        </div>\n\n        <div class=\"next-steps\">\n          <h4>What's Next?</h4>\n          <a href=\"/modules/work-orders\" class=\"next-step-item\">\n            <span class=\"icon\">📋</span>\n            <div>\n              <strong>View Work Order</strong>\n              <p>Check the Work Orders module to see your ticket</p>\n            </div>\n          </a>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"assignedTo\"><div class=\"next-step-item\">\n              <span class=\"icon\">📧</span>\n              <div>\n                <strong>Technician Notified</strong>\n                <p>Assigned technician will be notified</p>\n              </div>\n            </div></div>\n        </div>\n      </div></div>\n      </div>\n\n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 0\"><button class=\"wizard-btn-secondary\" data-cwl-action=\"prevStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Prev Step\">\n        ← Previous\n      </button></div>\n      <button class=\"wizard-btn-secondary\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Close\">\n        Cancel\n      </button>\n\n    <div class=\"footer-actions\">\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 5\"><button\n          class=\"wizard-btn-primary\" data-cwl-action=\"createWorkOrder\" data-cwl-attr-disabled=\"isLoading || !title.trim() || !description.trim()\"\n         aria-label=\"Create Work Order\">\n          ✅ Create Work Order\n        </button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep < steps.length - 1\"><button class=\"wizard-btn-primary\" data-cwl-action=\"nextStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Next Step\">\n          Next →\n        </button></div>\n        <button class=\"wizard-btn-primary\" data-cwl-action=\"complete\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Complete\">\n          Finish →\n        </button>\n\n    </div></span> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"prevStep\"></span>    />\n      </div>\n    </div>\n  </div></div></div>\n\n  <div data-cwl-shell-key=\"showCustomerLookup\" hidden aria-hidden=\"true\"><div data-cwl-component=\"CustomerLookupModal\" data-cwl-lifted-component=\"CustomerLookupModal\"><div\n  class=\"modal-backdrop\"\n  role=\"presentation\" data-cwl-action=\"close\"\n>\n  <div\n    class=\"modal-content\"\n    data-size=\"sm\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"customer-lookup-heading\"\n  >\n    <header class=\"modal-header\">\n      <div>\n        <p class=\"modal-eyebrow\">Customers</p>\n        <h2 id=\"customer-lookup-heading\">Customer Lookup</h2>\n      </div>\n      <button\n        class=\"modal-close-btn\"\n        type=\"button\"\n        aria-label=\"Close customer lookup\" data-cwl-action=\"close\"\n      >\n        ✕\n      </button>\n    </header>\n\n    <section class=\"modal-body\">\n      <div class=\"search-section\">\n        <input\n          type=\"text\"\n          placeholder=\"Search by name, phone, email, or customer ID...\"\n          class=\"search-input\" data-cwl-on-input=\"action:loadCustomers\"\n        />\n      </div>\n\n        <div class=\"error-message\" role=\"alert\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"customer-list\" role=\"listbox\" aria-label=\"Customer results\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"customers as customer (customer._id || customer.customerId)\" data-cwl-each-item=\"customer\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22customer-item%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22option%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20aria-selected%3D%7BselectedCustomerId%20%3D%3D%3D%20(customer._id%20%7C%7C%20customer.customerId)%7D%20data-cwl-action%3D%22selectCustomer%22%20data-cwl-action-args%3D%22customer%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%20Customer%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-name%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcustomer.fullName%20%7C%7C%20%60%24%7Bcustomer.firstName%7D%20%24%7Bcustomer.lastName%7D%60%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.customerId%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22customer-id%22%3E%23%7Bcustomer.customerId%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceStatus%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-%7Bcustomer.serviceStatus%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.serviceStatus%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.primaryPhone%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%9E%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatPhone(customer.primaryPhone)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.email%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%A7%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.email%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceAddress%3F.street%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%8D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bcustomer.serviceAddress.street%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.serviceAddress.city%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2C%20%7Bcustomer.serviceAddress.city%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.networkInfo%3F.imsi%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22detail-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22detail-label%22%20aria-hidden%3D%22true%22%3E%F0%9F%93%A1%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20IMSI%3A%20%7Bcustomer.networkInfo.imsi%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.servicePlan%3F.planName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22customer-plan%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Plan%3A%20%7Bcustomer.servicePlan.planName%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20customer.servicePlan.downloadMbps%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20(%7Bcustomer.servicePlan.downloadMbps%7D%2F%7Bcustomer.servicePlan.uploadMbps%7D%20Mbps)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20\"><button\n              class=\"customer-item\"\n              type=\"button\"\n              role=\"option\" data-cwl-action=\"selectCustomer\" data-cwl-action-args=\"customer\"\n             aria-label=\"Select Customer\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name\">\n                  <strong> </strong>\n\n                    <div hidden aria-hidden=\"true\"><span class=\"customer-id\">#</span>\n                  </div>\n                </div>\n\n                  <div hidden aria-hidden=\"true\"><span class=\"status-badge status-\">\n\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"customer-details\">\n\n                  <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📞</span>\n\n                  </div>\n\n                  <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📧</span>\n\n                  </div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.serviceAddress?.street\"><div class=\"detail-item\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📍</span>\n\n                      <div hidden aria-hidden=\"true\">,\n                    </div>\n                  </div></div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.networkInfo?.imsi\"><div class=\"detail-item\">\n                    <span class=\"detail-label\" aria-hidden=\"true\">📡</span>\n                    IMSI:\n                  </div></div>\n              </div>\n\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"customer.servicePlan?.planName\"><div class=\"customer-plan\">\n                  Plan:\n\n                    <div hidden aria-hidden=\"true\">(/ Mbps)\n                  </div>\n                </div></div>\n            </button></div>\n        </div>\n\n        <div class=\"state-message\" hidden aria-hidden=\"true\">\n          <p>No customers found. Create a customer first.</p>\n        </div>\n\n        <div class=\"state-message\" hidden aria-hidden=\"true\">\n          <p>No customers found matching “”.</p>\n        </div>\n\n    </section>\n  </div>\n</div></div>\n</div></div></div>\n</div></div>\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\" data-cwl-orphan-modal=\"1\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\" hidden aria-hidden=\"true\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/work-orders/:id"
page modules_work_orders_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/work-orders/:id" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"work-orders\" data-wisp-path=\"/modules/work-orders/:id\" data-cwl-island=\"client\"><div class=\"work-order-details\">\n  <div class=\"page-header\">\n    <button class=\"back-button\" data-cwl-nav=\"/modules/work-orders\" type=\"button\">\n      ← Back to Work Orders\n    </button>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"workOrder\"><div class=\"header-content\">\n        <div class=\"header-left\">\n          <h1><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.ticketNumber || 'Work Order'\"></span></h1>\n          <p class=\"subtitle\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.title\"></span></p>\n        </div>\n\n        <div class=\"header-badges\">\n          <div\n            class=\"priority-badge\"\n            style=\"background-color:\"\n          >\n            <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.priority\"></span>\n          </div>\n\n          <div\n            class=\"status-badge\"\n            style=\"background-color:\"\n          >\n            <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.status\"></span>\n          </div>\n        </div>\n      </div></div>\n  </div>\n\n  <!-- Alerts -->\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      <span>⚠️</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n      <span>✅</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"success:\">✕</button>\n    </div>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"workOrder\"><div class=\"content-grid\">\n      <!-- Main Content -->\n      <div class=\"main-column\">\n        <!-- Description -->\n        <div class=\"card\">\n          <h3>📋 Description</h3>\n          <p class=\"description\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.description || 'No description provided'\"></span></p>\n\n            <div hidden aria-hidden=\"true\"><h4>Symptoms:</h4>\n            <p class=\"symptoms\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.symptoms\"></span></p>\n          </div>\n        </div>\n\n        <!-- Location -->\n\n          <div class=\"card\" hidden aria-hidden=\"true\">\n            <h3>📍 Location</h3>\n            <div class=\"info-grid\">\n              <div class=\"info-item\">\n                <span class=\"info-label\">Type:</span>\n                <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.location.type\"></span></span>\n              </div>\n\n                <div class=\"info-item\" hidden aria-hidden=\"true\">\n                  <span class=\"info-label\">Site:</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.location.siteName\"></span></span>\n                </div>\n\n                <div class=\"info-item\" hidden aria-hidden=\"true\">\n                  <span class=\"info-label\">Address:</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.location.address\"></span></span>\n                </div>\n\n            </div>\n          </div>\n\n        <!-- Customer Info -->\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"workOrder.customerReported && workOrder.customerContact\"><div class=\"card\">\n            <h3>👤 Customer Information</h3>\n            <div class=\"info-grid\">\n              <div class=\"info-item\">\n                <span class=\"info-label\">Name:</span>\n                <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.customerContact.name\"></span></span>\n              </div>\n\n                <div class=\"info-item\" hidden aria-hidden=\"true\">\n                  <span class=\"info-label\">Phone:</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.customerContact.phone\"></span></span>\n                </div>\n\n                <div class=\"info-item\" hidden aria-hidden=\"true\">\n                  <span class=\"info-label\">Email:</span>\n                  <span class=\"info-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.customerContact.email\"></span></span>\n                </div>\n\n            </div>\n          </div></div>\n\n        <!-- Resolution -->\n\n          <div class=\"card\" hidden aria-hidden=\"true\">\n            <h3>✅ Resolution</h3>\n            <p class=\"resolution\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.resolution\"></span></p>\n\n              <div hidden aria-hidden=\"true\"><h4>Root Cause:</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.rootCause\"></span></p>\n            </div>\n\n              <div hidden aria-hidden=\"true\"><h4>Preventive Measures:</h4>\n              <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.preventiveMeasures\"></span></p>\n            </div>\n          </div>\n\n        <!-- Work Log -->\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"workOrder.workPerformed && workOrder.workPerformed.length > 0\"><div class=\"card\">\n            <h3>📝 Work Log</h3>\n            <div class=\"work-log\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"workOrder.workPerformed as entry\"><div class=\"log-entry\">\n                  <div class=\"log-header\">\n                    <span class=\"log-time\"></span>\n                    <span class=\"log-user\"></span>\n                  </div>\n                  <p class=\"log-action\"></p>\n\n                    <div hidden aria-hidden=\"true\"><p class=\"log-notes\"></p>\n                  </div>\n                </div></div>\n            </div>\n          </div></div>\n      </div>\n\n      <!-- Sidebar -->\n      <div class=\"sidebar-column\">\n        <!-- Actions -->\n        <div class=\"card actions-card\">\n          <h3>⚡ Quick Actions</h3>\n\n            <div hidden aria-hidden=\"true\"><button\n              class=\"action-btn start-btn\" data-cwl-action=\"handleStartWork\" data-cwl-attr-disabled=\"isUpdating\"\n             aria-label=\"Start Work\">\n              ▶️ Start Work\n            </button>\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"workOrder.status === 'in-progress'\"><button\n              class=\"action-btn complete-btn\" data-cwl-action=\"handleComplete\" data-cwl-attr-disabled=\"isUpdating\"\n             aria-label=\"Complete\">\n              ✅ Mark Complete\n            </button></div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"workOrder.status === 'resolved'\"><button\n              class=\"action-btn\" data-cwl-action=\"handleUpdateStatus\" data-cwl-action-args=\"'closed'\" data-cwl-attr-disabled=\"isUpdating\"\n             aria-label=\"Update Status\">\n              🔒 Close Ticket\n            </button></div>\n\n          <button\n            class=\"action-btn secondary-btn\" data-cwl-action=\"gotoEditWorkOrder\"\n           aria-label=\"Goto Edit Work Order\">\n            ✏️ Edit Details\n          </button>\n        </div>\n\n        <!-- Details -->\n        <div class=\"card\">\n          <h3>ℹ️ Details</h3>\n\n          <div class=\"detail-list\">\n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Type:</span>\n              <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.type\"></span></span>\n            </div>\n\n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Created:</span>\n              <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.createdAt)\"></span></span>\n            </div>\n\n              <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                <span class=\"detail-label\">Created By:</span>\n                <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.createdByName\"></span></span>\n              </div>\n\n              <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                <span class=\"detail-label\">Assigned To:</span>\n                <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.assignedToName\"></span></span>\n              </div>\n\n              <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                <span class=\"detail-label\">Scheduled:</span>\n                <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.scheduledDate)\"></span></span>\n              </div>\n\n              <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                <span class=\"detail-label\">Est. Duration:</span>\n                <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"workOrder.estimatedDuration\"></span> min</span>\n              </div>\n\n          </div>\n        </div>\n\n        <!-- SLA -->\n\n          <div class=\"card\" hidden aria-hidden=\"true\">\n            <h3>⏱️ SLA</h3>\n\n            <div class=\"detail-list\">\n\n                <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                  <span class=\"detail-label\">Response By:</span>\n                  <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.sla.responseDeadline)\"></span></span>\n                </div>\n\n                <div class=\"detail-item\" hidden aria-hidden=\"true\">\n                  <span class=\"detail-label\">Resolve By:</span>\n                  <span class=\"detail-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.sla.resolutionDeadline)\"></span></span>\n                </div>\n\n                <div class=\"sla-warning\" hidden aria-hidden=\"true\">\n                  ⚠️ SLA Breached\n                </div>\n\n            </div>\n          </div>\n\n        <!-- Timeline -->\n        <div class=\"card\">\n          <h3>📅 Timeline</h3>\n\n          <div class=\"timeline\">\n            <div class=\"timeline-item\">\n              <span class=\"timeline-icon\">📝</span>\n              <div class=\"timeline-content\">\n                <span class=\"timeline-label\">Created</span>\n                <span class=\"timeline-time\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.createdAt)\"></span></span>\n              </div>\n            </div>\n\n              <div class=\"timeline-item\" hidden aria-hidden=\"true\">\n                <span class=\"timeline-icon\">👤</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Assigned</span>\n                  <span class=\"timeline-time\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.assignedAt)\"></span></span>\n                </div>\n              </div>\n\n              <div class=\"timeline-item\" hidden aria-hidden=\"true\">\n                <span class=\"timeline-icon\">▶️</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Started</span>\n                  <span class=\"timeline-time\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.startedAt)\"></span></span>\n                </div>\n              </div>\n\n              <div class=\"timeline-item\" hidden aria-hidden=\"true\">\n                <span class=\"timeline-icon\">✅</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Completed</span>\n                  <span class=\"timeline-time\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.completedAt)\"></span></span>\n                </div>\n              </div>\n\n              <div class=\"timeline-item\" hidden aria-hidden=\"true\">\n                <span class=\"timeline-icon\">🔒</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Closed</span>\n                  <span class=\"timeline-time\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.closedAt)\"></span></span>\n                </div>\n              </div>\n\n          </div>\n        </div>\n      </div>\n    </div></div>\n    <div class=\"loading-state\" hidden aria-hidden=\"true\">\n      <div class=\"spinner\"></div>\n      <p>Loading work order...</p>\n    </div>\n\n</div></div>";
}

@page GET "/oauth/google/callback"
page oauth_google_callback_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/oauth/google/callback" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"oauth-google-callback\" data-wisp-path=\"/oauth/google/callback\" data-cwl-island=\"client\"><div class=\"callback-page\">\n  <div class=\"callback-card\">\n    <div class=\"callback-icon\">\n\n        🔄\n\n        <div hidden aria-hidden=\"true\">❌\n      </div>\n    </div>\n\n    <h2>Processing Google Sign-In...</h2>\n\n      <div class=\"loading-spinner\"></div>\n\n      <div hidden aria-hidden=\"true\"><p class=\"error-message\"></p>\n      <p class=\"help-text\">You can close this window and try again.</p>\n    </div>\n  </div>\n</div></div>";
}

@page GET "/onboarding"
page onboarding_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/onboarding" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"onboarding\" data-wisp-path=\"/onboarding\" data-cwl-island=\"client\"><div class=\"onboarding-message\"><p>Redirecting to the appropriate setup step...</p></div><div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"FirstTimeSetupWizard\" aria-hidden=\"true\" role=\"dialog\"></div><script>(function(){try{if(localStorage.getItem(\"onboardingCompleted\")===\"true\"){location.replace(\"/dashboard\");return;}if(localStorage.getItem(\"tenantSetupCompleted\")!==\"true\"){location.replace(\"/tenant-setup\");return;}}catch(e){}})();</script></div>";
}

@page GET "/portal/:tenantId"
page portal_tenantId_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/portal/:tenantId" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"redirect\" data-wisp-path=\"/portal/:tenantId\"><div class=\"redirect-message\">Redirecting to portal…</div><script>var m=location.pathname.match(/^\\/portal\\/([^/]+)/);location.replace(m?\"/modules/customers/portal/login?tenant=\"+encodeURIComponent(m[1]):\"/modules/customers/portal/login\");</script><noscript><a href=\"/modules/customers/portal/login\">Continue</a></noscript></div>";
}

@page GET "/reset-password"
page reset_password_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/reset-password" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"reset-password\" data-wisp-path=\"/reset-password\" data-cwl-island=\"client\"><div class=\"reset-password-page\">\n  <div class=\"reset-password-container\">\n    <div class=\"reset-password-card\">\n      <h1>WISP Management</h1>\n      <p class=\"subtitle\">Password Reset</p>\n\n        <div class=\"error-message\" hidden aria-hidden=\"true\">\n          <span class=\"error-icon\">⚠️</span>\n\n        </div>\n\n        <div class=\"success-message\" hidden aria-hidden=\"true\">\n          <span class=\"success-icon\">✅</span>\n\n        </div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'reset'\" hidden aria-hidden=\"true\">\n        <div class=\"form-container\">\n          <h2>Set New Password</h2>\n          <p class=\"form-description\">Enter your new password below</p>\n\n          <div class=\"form-group\">\n            <label for=\"newPassword\">New Password <span class=\"required\">*</span></label>\n            <input\n              id=\"newPassword\"\n              type=\"password\"\n              placeholder=\"Enter your new password\" data-cwl-attr-disabled=\"isLoading\"\n              required\n              minlength=\"6\"\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"confirmPassword\">Confirm Password <span class=\"required\">*</span></label>\n            <input\n              id=\"confirmPassword\"\n              type=\"password\"\n              placeholder=\"Confirm your new password\" data-cwl-attr-disabled=\"isLoading\"\n              required\n              minlength=\"6\"\n            />\n          </div>\n\n          <button\n            type=\"button\"\n            class=\"btn-primary\" data-cwl-action=\"handlePasswordReset\" data-cwl-attr-disabled=\"isLoading || !newPassword || !confirmPassword\"\n           aria-label=\"Password Reset\">\n\n              Reset Password\n\n              <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n              Resetting...\n            </div>\n          </button>\n        </div>\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'verify'\" hidden aria-hidden=\"true\">\n        <div class=\"form-container\">\n          <h2>Verify Email</h2>\n          <p class=\"form-description\">Click the button below to verify your email address</p>\n\n          <button\n            type=\"button\"\n            class=\"btn-primary\" data-cwl-action=\"handleEmailVerification\" data-cwl-attr-disabled=\"isLoading\"\n           aria-label=\"Email Verification\">\n\n              Verify Email\n\n              <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n              Verifying...\n            </div>\n          </button>\n        </div>\n      </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!actionCode\"><div class=\"form-container\">\n          <p class=\"error-text\">Invalid reset link. Please request a new password reset email.</p>\n          <button\n            type=\"button\"\n            class=\"btn-primary\" data-cwl-nav=\"/login\"\n          >\n            Go to Login\n          </button>\n        </div></div>\n\n      <div class=\"form-footer\">\n        <a href=\"/login\" class=\"link\">Back to Login</a>\n      </div>\n    </div>\n  </div>\n</div></div>";
}

@page GET "/settings/module-access"
page settings_module_access_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/settings/module-access" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"settings-module-access\" data-wisp-path=\"/settings/module-access\" data-cwl-island=\"client\"><div class=\"module-access-container\">\n  <div class=\"header\">\n    <div class=\"title-section\">\n      <h1>⚙️ Module Access Configuration</h1>\n      <p class=\"subtitle\">Configure which modules each role can access in <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentTenant?.name || 'your organization'\"></span></p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\" data-cwl-toggle=\"showResetConfirm:true\" data-cwl-attr-disabled=\"loading || saving\" aria-label=\"Show Reset Confirm\">\n        🔄 Reset All to Defaults\n      </button>\n\n      <button class=\"btn btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"!hasChanges || saving\" aria-label=\"Save\">\n\n          💾 Save Configuration\n\n      </button>\n    </div>\n  </div>\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      <span>❌</span>\n      <span></span>\n      <button data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n      <span>✅</span>\n      <span>Configuration saved successfully!</span>\n    </div>\n\n    <div class=\"config-table-container\">\n      <table class=\"config-table\">\n        <thead>\n          <tr>\n            <th class=\"module-column\">Module</th>\n\n                <th class=\"role-column\">\n                  <div class=\"role-header\">\n                    <div class=\"role-name\">Owner</div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isRoleLocked('owner')\"><span class=\"lock-badge\">🔒</span></div>\n                      <button\n                        class=\"reset-role-btn\" data-cwl-action=\"handleResetRole\" data-cwl-action-args=\"'owner'\"\n                        title=\"Reset to defaults\"\n                      >\n                        🔄\n                      </button>\n\n                  </div>\n                </th>\n\n                <th class=\"role-column\">\n                  <div class=\"role-header\">\n                    <div class=\"role-name\">Admin</div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isRoleLocked('admin')\"><span class=\"lock-badge\">🔒</span></div>\n                      <button\n                        class=\"reset-role-btn\" data-cwl-action=\"handleResetRole\" data-cwl-action-args=\"'admin'\"\n                        title=\"Reset to defaults\"\n                      >\n                        🔄\n                      </button>\n\n                  </div>\n                </th>\n\n                <th class=\"role-column\">\n                  <div class=\"role-header\">\n                    <div class=\"role-name\">Engineer</div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isRoleLocked('engineer')\"><span class=\"lock-badge\">🔒</span></div>\n                      <button\n                        class=\"reset-role-btn\" data-cwl-action=\"handleResetRole\" data-cwl-action-args=\"'engineer'\"\n                        title=\"Reset to defaults\"\n                      >\n                        🔄\n                      </button>\n\n                  </div>\n                </th>\n\n                <th class=\"role-column\">\n                  <div class=\"role-header\">\n                    <div class=\"role-name\">Field Technician</div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isRoleLocked('installer')\"><span class=\"lock-badge\">🔒</span></div>\n                      <button\n                        class=\"reset-role-btn\" data-cwl-action=\"handleResetRole\" data-cwl-action-args=\"'installer'\"\n                        title=\"Reset to defaults\"\n                      >\n                        🔄\n                      </button>\n\n                  </div>\n                </th>\n\n                <th class=\"role-column\">\n                  <div class=\"role-header\">\n                    <div class=\"role-name\">Help Desk</div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isRoleLocked('helpdesk')\"><span class=\"lock-badge\">🔒</span></div>\n                      <button\n                        class=\"reset-role-btn\" data-cwl-action=\"handleResetRole\" data-cwl-action-args=\"'helpdesk'\"\n                        title=\"Reset to defaults\"\n                      >\n                        🔄\n                      </button>\n\n                  </div>\n                </th>\n\n                <th class=\"role-column\">\n                  <div class=\"role-header\">\n                    <div class=\"role-name\">Viewer</div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isRoleLocked('viewer')\"><span class=\"lock-badge\">🔒</span></div>\n                      <button\n                        class=\"reset-role-btn\" data-cwl-action=\"handleResetRole\" data-cwl-action-args=\"'viewer'\"\n                        title=\"Reset to defaults\"\n                      >\n                        🔄\n                      </button>\n\n                  </div>\n                </th>\n\n          </tr>\n        </thead>\n        <tbody>\n\n            <tr>\n              <td class=\"module-name\">\n                <span class=\"module-icon\">📊</span>\n                PCI Resolution\n              </td>\n\n                  <td class=\"checkbox-cell\">\n                    <label class=\"checkbox-container\">\n                      <input\n                        type=\"checkbox\" data-cwl-on-change=\"action:toggleModule\" data-cwl-on-change-args=\"role, &quot;pciResolution&quot;\" data-cwl-attr-disabled=\"isRoleLocked('owner') || saving\"\n                      />\n                      <span class=\"checkmark\"></span>\n                    </label>\n                  </td>\n\n             