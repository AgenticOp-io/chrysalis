  load { source: "wisp-m31", path: "/onboarding" };
  return html "<div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"showWizard\"><div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"FirstTimeSetupWizard\" aria-hidden=\"true\" role=\"dialog\"></div></div>";
}

