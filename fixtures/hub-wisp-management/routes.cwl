@page GET "/modules/backend-management"
page modules_backend_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/modules/backend-management" };
  return html "<div class=\"wisp-module-demo wisp-demo-content\" data-wisp-page=\"modules_backend_management\" data-wisp-path=\"/modules/backend-management\" data-cwl-island=\"client\" data-wisp-layout=\"list\" data-wisp-api=\"/api/admin\">\n  <header class=\"wisp-demo-header\">\n    <h1>Backend Management</h1>\n    <p class=\"wisp-demo-desc\">Operational workspace for Backend Management — native CWL handlers with live API integration.</p>\n    <div class=\"wisp-demo-toolbar\"><button type=\"button\" class=\"wisp-demo-btn\" data-action=\"refresh\">Refresh</button><a class=\"wisp-demo-btn primary\" href=\"/modules/backend-management/add\">Add new</a><a class=\"wisp-demo-btn\" href=\"/help\">Help</a><button type=\"button\" class=\"wisp-demo-btn\" data-action=\"back\">← Dashboard</button></div>\n  </header>\n  <section class=\"wisp-demo-panel\">\n    <div class=\"wisp-demo-stats\">\n  <article class=\"wisp-demo-stat\"><strong>179</strong><span>Active records</span></article>\n  <article class=\"wisp-demo-stat\"><strong>3</strong><span>Open alerts</span></article>\n  <article class=\"wisp-demo-stat\"><strong>12</strong><span>Pending tasks</span></article>\n</div>\n<table class=\"wisp-demo-table\" id=\"wisp-demo-table\" aria-label=\"Backend Management data\">\n  <thead><tr><th>ID</th><th>Name</th><th>Status</th><th>Updated</th></tr></thead>\n  <tbody><tr><td colspan=\"4\">Loading…</td></tr></tbody>\n</table>\n  </section>\n  <footer class=\"wisp-demo-api-status\" id=\"wisp-demo-api-status\" aria-live=\"polite\">Ready</footer>\n</div>";
}

@page GET "/modules/billing"
page modules_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/billing", apiPath: "/api/customer-billing", api_ok: true, api_surface: "wisp-api-native", api_resource: "customer-billing", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"billing-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-content\">\n        <button class=\"back-btn\">\n          <span class=\"back-icon\">←</span>\n          Back to Dashboard\n        </button>\n        <div class=\"module-title\">\n          <h1>💳 Billing & Subscriptions</h1>\n          <p>Manage your subscription and billing information</p>\n        </div>\n        <div class=\"tenant-info\">\n          <span class=\"tenant-name\">Demo Tenant</span>\n            <span class=\"tenant-subdomain\">demo</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n      \n\n      \n        <!-- Current Subscription -->\n        <div class=\"current-subscription\">\n          <h2>Current Subscription</h2>\n          \n        </div>\n\n        <!-- Available Plans -->\n        <div class=\"plans-section\">\n          <h2>Available Plans</h2>\n          <div class=\"plans-grid\">\n            <div class=\"plan-card \">\n                \n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <li>✓ </li><li>✓ </li>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button \n                  class=\"select-plan-btn\">\n                  \n                </button>\n              </div><div class=\"plan-card \">\n                \n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <li>✓ </li><li>✓ </li>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button \n                  class=\"select-plan-btn\">\n                  \n                </button>\n              </div>\n          </div>\n        </div>\n\n        <!-- Payment Methods -->\n        <div class=\"payment-methods-section\">\n          <h2>Payment Methods</h2>\n          \n        </div>\n\n        <!-- Recent Invoices -->\n        <div class=\"invoices-section\">\n          <h2>Recent Invoices</h2>\n          \n        </div>\n      \n    </div>\n\n    <!-- Edit Payment Method Modal -->\n    \n  </div>";
}

@page GET "/modules/cbrs-management"
page modules_cbrs_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/cbrs-management", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- CBRS Setup Wizard -->\n\n<!-- CBRS Device Registration Wizard -->\n<div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"CBRSDeviceRegistrationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cbrs-module\">\n  <!-- Header -->\n  <div class=\"module-header\">\n    <div class=\"header-content\">\n      <div class=\"header-left\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          Back to Dashboard\n        </a>\n        <h1 class=\"module-title\">\n          <span class=\"module-icon\">📡</span>\n          CBRS Management\n        </h1>\n        <p class=\"module-description\">Citizens Broadband Radio Service spectrum management</p>\n        \n        <div class=\"tenant-badge\">\n            <span class=\"tenant-icon\">🏢</span>\n            <span class=\"tenant-text\">Demo Tenant</span>\n          </div>\n      </div>\n      \n      <div class=\"header-actions\">\n        \n        <button class=\"btn btn-secondary\" title=\"Configure SAS providers\">\n          ⚙️ Settings\n        </button>\n        <button class=\"btn btn-primary\">\n          + Add CBSD Device\n        </button>\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n        />\n      </div>\n    </div>\n  </div>\n\n  \n  \n  <div class=\"error-banner\">\n      <span class=\"error-icon\">⚠️</span>\n      <span class=\"error-message\">\n        No tenant selected. Please return to the \n        <a href=\"/dashboard\" class=\"inline-link\">dashboard</a> \n        and select a tenant first.\n      </span>\n    </div>\n\n  <!-- Main Content -->\n  <div class=\"module-content\">\n    <!-- Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📡</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Total Devices</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">✅</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Registered</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📊</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Active Grants</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🌐</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"> MHz</div>\n          <div class=\"stat-label\">CBRS Band</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Map -->\n    <div class=\"map-section\">\n      <div class=\"map-header\">\n        <h3>CBSD Device Map</h3>\n        <div class=\"legend\">\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #10b981;\"></span>\n            <span>Active</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #3b82f6;\"></span>\n            <span>Registered</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #6b7280;\"></span>\n            <span>Unregistered</span>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"map-container\">\n        <div class=\"arcgis-map\"></div>\n        \n        \n      </div>\n    </div>\n\n    <!-- Device List and Grant Status -->\n    <div class=\"content-grid\">\n      <div class=\"device-list-section\">\n        <h3>CBSD Devices</h3>\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"DeviceList\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>cpe-1</td><td>online</td></tr><tr><td>cpe-2</td><td>degraded</td></tr></tbody></table></div> true}\n        />\n      </div>\n      \n      \n    </div>\n  </div>\n</div>\n\n<!-- Add Device Modal -->\n\n\n<!-- Grant Request Modal -->\n\n\n<!-- Settings Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SettingsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<!-- User ID / Network Selector Modal (includes Google login) -->\n<div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"UserIDSelector\" aria-hidden=\"true\"></div> false}\n/>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<!-- Quick Tips Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

@page GET "/modules/coverage-map"
page modules_coverage_map_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  load { module: "coverage-map", source: "wisp-m3", apiPath: "/api/network" };
  return html "<svelte:head>\n  <title>Coverage Map – WISP Management</title>\n</svelte:head>\n\n<div class=\"module-shell\">\n  <nav class=\"module-nav\">\n  <a href=\"/modules/plan\">Plan</a>\n  <a href=\"/modules/deploy\">Deploy</a>\n  <a href=\"/modules/coverage-map\">Coverage Map</a>\n  <a href=\"/dashboard\">← Dashboard</a>\n</nav>\n  <header>\n    <h1>Coverage Map</h1>\n    <p class=\"module-blurb\">Network coverage visualization</p>\n    <p class=\"api-surface\">API: /api/network (proxied upstream)</p>\n  </header>\n  <p class=\"client-hole-note\">ArcGIS MapView remains <code>hub-svelte:arcgis-map</code> (client bundle) until CWL UI policy.</p>\n  <p class=\"ui-hole-note\">Interactive module widgets remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/modules/customers"
page modules_customers_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { module: "customers", source: "wisp-m2", apiPath: "/api/customers" };
  return html "<svelte:head>\n  <title>Customers – WISP Management</title>\n</svelte:head>\n\n<div class=\"customers-shell\">\n  <header>\n    <h1>Customers Module</h1>\n    <p class=\"api-surface\">API: /api/customers (proxied upstream)</p>\n  </header>\n  <section class=\"portal-links\">\n    <h2>Customer Portal</h2>\n    <ul>\n      <li><a href=\"/modules/customers/portal\">Portal home</a></li>\n      <li><a href=\"/modules/customers/portal-setup\">Portal setup</a></li>\n      <li><a href=\"/modules/customers/portal/dashboard\">Portal dashboard</a></li>\n      <li><a href=\"/modules/customers/portal/tickets\">Tickets</a></li>\n      <li><a href=\"/modules/customers/portal/billing\">Billing</a></li>\n      <li><a href=\"/modules/customers/portal/knowledge\">Knowledge base</a></li>\n    </ul>\n  </section>\n  <p class=\"ui-hole-note\">CRM widgets and portal sub-pages remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

