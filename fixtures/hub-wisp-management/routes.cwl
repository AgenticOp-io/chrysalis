@page GET "/modules/customers/portal/billing/settings"
page modules_customers_portal_billing_settings_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/billing/settings", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"billing-settings-page\">\\r\n    <h1>Billing settings</h1>\\r\n    <p class=\"subtitle\">Payment method and invoice preferences</p>\\r\n\\r\n    \\r\n    \\r\n\\r\n    <form on:submit|preventDefault= class=\"settings-form\">\\r\n      \\r\n\\r\n      <section class=\"settings-section\">\\r\n        <h2>Invoice delivery</h2>\\r\n        <p class=\"hint\">How you want to receive invoices.</p>\\r\n        <label>\\r\n          <input type=\"radio\" value=\"email\" />\\r\n          Email only\\r\n        </label>\\r\n        <label>\\r\n          <input type=\"radio\" value=\"portal\" />\\r\n          Portal only (view in Billing page)\\r\n        </label>\\r\n        <label>\\r\n          <input type=\"radio\" value=\"both\" />\\r\n          Both email and portal\\r\n        </label>\\r\n      </section>\\r\n\\r\n      <section class=\"settings-section read-only\">\\r\n        <h2>Invoice format</h2>\\r\n        <p class=\"hint\">Set by your provider (read-only).</p>\\r\n        <div class=\"info-rows\">\\r\n          <div class=\"info-row\">\\r\n            <span class=\"label\">Company name</span>\\r\n            <span class=\"value\">—</span>\\r\n          </div>\\r\n          <div class=\"info-row\">\\r\n            <span class=\"label\">Payment due (days)</span>\\r\n            <span class=\"value\"></span>\\r\n          </div>\\r\n          <div class=\"info-row\">\\r\n            <span class=\"label\">Currency</span>\\r\n            <span class=\"value\"></span>\\r\n          </div>\\r\n        </div>\\r\n      </section>\\r\n\\r\n      <div class=\"actions\">\\r\n        <button type=\"submit\" class=\"btn-primary\">\\r\n          Save settings\\r\n        </button>\\r\n        <a href=\"/modules/customers/portal/billing\" class=\"btn-secondary\">Back to Billing</a>\\r\n      </div>\\r\n    </form>\\r\n  </div>";
}

@page GET "/modules/customers/portal/dashboard"
page modules_customers_portal_dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/dashboard", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"dashboard\">\n    <div class=\"dashboard-header\">\n      <h1>Welcome, Alex!</h1>\n      <p class=\"subtitle\">Manage your tickets and view your service information</p>\n    </div>\n    \n    <div class=\"dashboard-stats\">\n      <div class=\"stat-card\">\n          <div class=\"stat-value\"></div>\n          <div class=\"stat-label\">Total Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"></div>\n          <div class=\"stat-label\">Open Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"></div>\n          <div class=\"stat-label\">Resolved</div>\n        </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">active</div>\n        <div class=\"stat-label\">Service Status</div>\n      </div>\n    </div>\n    \n    <div class=\"dashboard-actions\">\n        <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n          Create New Ticket\n        </a>\n        <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">\n          View All Tickets\n        </a>\n      </div>\n    \n    <div class=\"support-tools\">\n        <div class=\"support-card\">\n            <h3>Billing &amp; Account</h3>\n            <p>View your plan, billing cycle, balance, and next billing date.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/billing\">View Billing</a>\n            <a class=\"support-link secondary\" href=\"/modules/customers/portal/billing/settings\">Billing settings</a>\n          </div>\n        <div class=\"support-card\">\n            <h3>Service Status &amp; Outages</h3>\n            <p>Check real-time service health, scheduled maintenance, and network alerts.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/service\">View Status</a>\n          </div>\n        <div class=\"support-card\">\n            <h3>FAQ &amp; Help Center</h3>\n            <p>Browse answers to the most common account, billing, and technical questions.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/faq\">Visit FAQ</a>\n          </div>\n        \n        \n      </div>\n    \n    <div class=\"recent-tickets\">\n        <h2>Recent Tickets</h2>\n        <div class=\"tickets-list\">\n          <div class=\"ticket-card\">\n              <div class=\"ticket-header\">\n                <span class=\"ticket-number\"></span>\n                <span \n                  class=\"ticket-status\" \n                  style=\"background: \"\n                >\n                  \n                </span>\n              </div>\n              <h3 class=\"ticket-title\"></h3>\n              <p class=\"ticket-description\"></p>\n              <div class=\"ticket-meta\">\n                <span>Priority: </span>\n                <span>Created: </span>\n              </div>\n            </div>\n        </div>\n      </div>\n    \n    <div class=\"service-info\">\n        <h2>Service Information</h2>\n        <div class=\"info-card\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Service Status:</span>\n            <span class=\"info-value\">active</span>\n          </div>\n          <div class=\"info-row\">\n              <span class=\"info-label\">Service Plan:</span>\n              <span class=\"info-value\">Residential 100</span>\n            </div>\n          \n        </div>\n      </div>\n  </div>";
}

@page GET "/modules/customers/portal/faq"
page modules_customers_portal_faq_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/faq", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"faq-page\">\n    <h1>WISP Management Help Center</h1>\n    <p class=\"subtitle\">Quick answers to the most common questions from subscribers.</p>\n    <input\n      type=\"search\"\n      class=\"faq-search\"\n      placeholder=\"Search FAQ…\"\n      aria-label=\"Search FAQ\"\n    />\n    <div class=\"faq-list\">\n      \n    </div>\n    \n    <div class=\"contact-card\">\n      <h2>Still need help?</h2>\n      <p>Open a support ticket from the dashboard or contact our team directly.</p>\n      <div class=\"contact-links\">\n        <a class=\"btn-link\">Email Support</a>\n        \n      </div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/knowledge"
page modules_customers_portal_knowledge_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/knowledge", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"knowledge-page\">\n    <header>\n      <h1>WISP Management Knowledge Base</h1>\n      <p class=\"subtitle\">Self-service guides curated by our support engineers.</p>\n      <div class=\"kb-filters\">\n        <input\n          type=\"search\"\n          class=\"kb-search\"\n          placeholder=\"Search articles…\"\n          aria-label=\"Search knowledge base\"\n        />\n        <select class=\"kb-category\" aria-label=\"Filter by category\">\n            <option>All categories</option>\n            <option></option><option></option><option></option><option></option>\n          </select>\n      </div>\n    </header>\n    <section class=\"guides-grid\">\n      \n    </section>\n  </div>";
}

