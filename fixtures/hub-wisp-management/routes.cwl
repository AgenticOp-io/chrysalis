  return html "<div class=\"item-detail-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Inventory\n      </button>\n      <h1>📦 Equipment Details</h1>\n      \n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        📱 View QR Code\n      </button>\n      <button class=\"btn btn-secondary\">\n        🖨️ Print Tag\n      </button>\n      <button class=\"btn btn-primary\">\n        ✏️ Edit\n      </button>\n      <button class=\"btn btn-primary\">\n        📦 Transfer\n      </button>\n    </div>\n  </div>\n\n  \n    <div class=\"content-grid\">\n      <!-- Basic Information -->\n      <div class=\"info-card\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Asset Tag</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Serial Number</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Category</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Equipment Type</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Manufacturer</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Model</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Status</label>\n            <span class=\"status-badge\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Condition</label>\n            <span class=\"condition-badge\"></span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Current Location -->\n      <div class=\"info-card\">\n        <h3>📍 Current Location</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Location Type</label>\n            <span class=\"value\"></span>\n          </div>\n          \n          \n          \n        </div>\n      </div>\n\n      <!-- Purchase Information -->\n      \n\n      <!-- Warranty Information -->\n      \n\n      <!-- Technical Specifications -->\n      \n\n      <!-- Module Integration -->\n      \n\n      <!-- Notes -->\n      \n\n      <!-- Metadata -->\n      <div class=\"info-card full-width\">\n        <h3>📊 Metadata</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Created</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Last Updated</label>\n            <span class=\"value\"></span>\n          </div>\n        </div>\n      </div>\n    </div>\n  \n</div>\n\n<!-- QR Code Modal -->\n";
}

