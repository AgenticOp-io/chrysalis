@page GET "/settings/module-access"
page settings_module_access_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/settings/module-access" };
  return html "<div class=\"module-access-container\">\n  <div class=\"header\">\n    <div class=\"title-section\">\n      <h1>⚙️ Module Access Configuration</h1>\n      <p class=\"subtitle\">Configure which modules each role can access in Demo Tenant</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Reset All to Defaults\n      </button>\n      \n      <button class=\"btn btn-primary\">\n        \n          💾 Save Configuration\n        \n      </button>\n    </div>\n  </div>\n  \n  \n  \n  \n  \n  \n  \n  \n    <div class=\"config-table-container\">\n      <table class=\"config-table\">\n        <thead>\n          <tr>\n            <th class=\"module-column\">Module</th>\n            \n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td class=\"module-name\">\n                <span class=\"module-icon\"></span>\n                \n              </td>\n              \n            </tr><tr>\n              <td class=\"module-name\">\n                <span class=\"module-icon\"></span>\n                \n              </td>\n              \n            </tr><tr>\n              <td class=\"module-name\">\n                <span class=\"module-icon\"></span>\n                \n              </td>\n              \n            </tr>\n        </tbody>\n      </table>\n    </div>\n    \n    <div class=\"legend\">\n      <h3>Legend:</h3>\n      <ul>\n        <li>✅ <strong>Checked</strong> = Role can access this module</li>\n        <li>❌ <strong>Unchecked</strong> = Role cannot access this module</li>\n        <li>🔒 <strong>Locked</strong> = Owner role always has full access (cannot be changed)</li>\n        <li>🔄 <strong>Reset</strong> = Reset individual role to default permissions</li>\n      </ul>\n    </div>\n  \n</div>\n\n";
}

@page GET "/setup-admin"
page setup_admin_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/setup-admin" };
  return html "<div class=\"setup-container\">\n  <div class=\"setup-card\">\n    <h1>🔧 Setup Admin Access</h1>\n    <p class=\"subtitle\">Grant yourself owner access to your tenants</p>\n    \n    <div class=\"info-box\">\n      <p><strong>This will:</strong></p>\n      <ul>\n        <li>✅ Grant you owner role in all your tenants</li>\n        <li>✅ Enable User Management module</li>\n        <li>✅ Enable Help Desk module</li>\n        <li>✅ Allow you to invite other users</li>\n        <li>✅ Give you full administrative access</li>\n      </ul>\n    </div>\n    \n    \n        🚀 Setup Admin Access\n      \n    </button>\n    \n    \n  </div>\n</div>";
}

@page GET "/signup"
page signup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/signup" };
  return html "<div class=\"signup-wizard\">\n  <div class=\"wizard-container\">\n    <div class=\"wizard-header\">\n      <h1>Create Your Account</h1>\n      <p class=\"subtitle\">Get started with WISP Management in just a few steps</p>\n    </div>\n\n    <div class=\"progress-bar\">\n      <div class=\"progress\" style=\"width: %\"></div>\n    </div>\n\n    <div class=\"wizard-content\">\n      \n\n      \n\n      <!-- Step 1: Email Verification -->\n      <div class=\"step-content\">\n          <h2>Step 1: Verify Your Email</h2>\n          <p class=\"step-description\">We'll send a verification code to your email address to ensure it's valid.</p>\n\n          <div class=\"form-group\">\n            <label for=\"email\">Email Address <span class=\"required\">*</span></label>\n            <input\n              id=\"email\"\n              type=\"email\"\n              placeholder=\"your@email.com\"\n              required\n            />\n          </div>\n\n          <div style=\"display: flex; flex-direction: column; gap: 1rem;\">\n              <button \n                type=\"button\" \n                class=\"btn-primary\"\n              >\n                \n                  Send Verification Code\n                \n              </button>\n\n              <div style=\"display: flex; align-items: center; gap: 1rem; margin: 0.5rem 0;\">\n                <div style=\"flex: 1; height: 1px; background: var(--border-color, #d1d5db);\"></div>\n                <span style=\"color: var(--text-secondary, #6b7280); font-size: 0.875rem;\">OR</span>\n                <div style=\"flex: 1; height: 1px; background: var(--border-color, #d1d5db);\"></div>\n              </div>\n\n              <button \n                type=\"button\" \n                class=\"btn-google\"\n                style=\"width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.75rem; padding: 0.9rem 1rem; border-radius: 0.6rem; background: #ffffff; color: #1a2332; font-weight: 600; font-size: 0.95rem; border: none; cursor: pointer; transition: transform 0.15s ease, box-shadow 0.15s ease; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);\"\n              >\n                <svg aria-hidden=\"true\" viewBox=\"0 0 533.5 544.3\" style=\"width: 20px; height: 20px;\">\n                  <path fill=\"#4285f4\" d=\"M533.5 278.4c0-17.4-1.4-34.1-4.1-50.2H272v95h147.5c-6.4 34-25 62.8-53.4 82v68h86.1c50.4-46.5 80.3-115.1 80.3-194.8z\"/>\n                  <path fill=\"#34a853\" d=\"M272 544.3c72.2 0 132.8-23.9 177-64.7l-86.1-68c-23.9 16.1-54.5 25.7-90.9 25.7-69.9 0-129.2-47.2-150.4-110.5h-90.7v69.8c44 87.4 134.5 148.7 241.1 148.7z\"/>\n                  <path fill=\"#fbbc04\" d=\"M121.6 326.8c-10.2-30-10.2-62.5 0-92.5v-69.8h-90.7c-37.3 74.6-37.3 158.4 0 233z\"/>\n                  <path fill=\"#ea4335\" d=\"M272 107.7c39.2-.6 76.4 13.8 105 39.9l78.2-78.2C404.5 25.5 344 0 272 0 165.4 0 74.9 61.3 30.9 148.7l90.7 69.8C142.7 175 202.1 107.7 272 107.7z\"/>\n                </svg>\n                <span>Sign up with Google</span>\n              </button>\n            </div>\n        </div>\n\n      <!-- Step 2: Tenant Information -->\n      \n        <div class=\"step-content\">\n          <h2>Step 2: Payment Option</h2>\n          <p class=\"step-description\">Select your preferred payment method. No charges will be made at this time.</p>\n\n          <div class=\"beta-disclaimer\">\n            <div class=\"beta-badge\">BETA</div>\n            <p><strong>WISPTools.io is currently in beta.</strong> Start with our free beta option - no payment required. You can upgrade to a paid plan later from your account settings.</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Payment Option <span class=\"required\">*</span></label>\n            <div class=\"payment-method-options\">\n              <label class=\"payment-option\">\n                <input \n                  type=\"radio\" \n                  name=\"paymentMethod\" \n                  value=\"beta\"\n                  checked\n                />\n                <div class=\"payment-option-content\">\n                  <div class=\"payment-icon\">🎉</div>\n                  <div>\n                    <strong>Beta (Free)</strong>\n                    <p>Free access during beta period - No payment required</p>\n                  </div>\n                </div>\n              </label>\n              <label class=\"payment-option\">\n                <input \n                  type=\"radio\" \n                  name=\"paymentMethod\" \n                  value=\"paypal\"\n                />\n                <div class=\"payment-option-content\">\n                  <div class=\"payment-icon\">💳</div>\n                  <div>\n                    <strong>PayPal</strong>\n                    <p>Pay with PayPal account (set up now, charges begin after beta)</p>\n                  </div>\n                </div>\n              </label>\n              <label class=\"payment-option\">\n                <input \n                  type=\"radio\" \n                  name=\"paymentMethod\" \n                  value=\"credit_card\"\n                />\n                <div class=\"payment-option-content\">\n                  <div class=\"payment-icon\">💳</div>\n                  <div>\n                    <strong>Credit Card</strong>\n                    <p>Pay with credit or debit card (set up now, charges begin after beta)</p>\n                  </div>\n                </div>\n              </label>\n            </div>\n          </div>\n\n          <div class=\"form-actions\">\n            <button \n              type=\"button\" \n              class=\"btn-secondary\"\n            >\n              ← Back\n            </button>\n            <button \n              type=\"button\" \n              class=\"btn-primary\"\n            >\n              Continue →\n            </button>\n          </div>\n        </div>\n\n      \n        <div class=\"step-content\">\n          <h2>Step 3: Organization Information</h2>\n          <p class=\"step-description\">Tell us about your organization.</p>\n\n          <div class=\"form-group\">\n            <label for=\"tenantName\">Organization Name <span class=\"required\">*</span></label>\n            <input\n              id=\"tenantName\"\n              type=\"text\"\n              placeholder=\"Acme WISP\"\n              required\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"displayName\">Display Name <span class=\"required\">*</span></label>\n            <input\n              id=\"displayName\"\n              type=\"text\"\n              placeholder=\"Acme Wireless Internet\"\n              required\n            />\n            <p class=\"help-text\">This is how your organization will appear in the system</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactPhone\">Contact Phone <span class=\"required\">*</span></label>\n            <input\n              id=\"contactPhone\"\n              type=\"tel\"\n              placeholder=\"+1 (555) 123-4567\"\n              required\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"subdomain\">Subdomain <span class=\"required\">*</span></label>\n            <input\n              id=\"subdomain\"\n              type=\"text\"\n              placeholder=\"acme-wisp\"\n              minlength=\"3\"\n              maxlength=\"63\"\n              required\n            />\n            <p class=\"help-text\">Unique subdomain for your organization (lowercase letters, numbers, and hyphens only). Will be auto-generated from tenant name if left blank.</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Primary Location (Optional)</label>\n            <p class=\"help-text\">You can create your primary location (NOC/HQ/Tower) after completing setup from the coverage map.</p>\n          </div>\n\n          <div class=\"form-actions\">\n            <button \n              type=\"button\" \n              class=\"btn-secondary\"\n            >\n              ← Back\n            </button>\n            <button \n              type=\"button\" \n              class=\"btn-primary\"\n            >\n              \n                Finish\n              \n            </button>\n          </div>\n        </div>\n\n      <!-- Step 3: Payment Information -->\n      <!-- Step 4: Success -->\n    </div>\n  </div>\n</div>";
}

@page GET "/support-dashboard"
page support_dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/support-dashboard" };
  return html "<div class=\"support-dashboard\">\n    <header class=\"dashboard-header\">\n      <div class=\"header-content\">\n        <h1>🎧 Customer Support Dashboard</h1>\n        <p class=\"subtitle\">Demo Tenant - Support Portal</p>\n      </div>\n      <div class=\"header-actions\">\n        <button class=\"btn-secondary\">\n          ⚙️ Portal Settings\n        </button>\n      </div>\n    </header>\n\n    \n      <!-- Stats Cards -->\n      <div class=\"stats-grid\">\n        <div class=\"stat-card alerts\">\n          <div class=\"stat-icon\">🚨</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"></div>\n            <div class=\"stat-label\">Active Alerts</div>\n          </div>\n        </div>\n        \n        <div class=\"stat-card tickets\">\n          <div class=\"stat-icon\">🎫</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"></div>\n            <div class=\"stat-label\">Pending Tickets</div>\n          </div>\n        </div>\n        \n        <div class=\"stat-card chats\">\n          <div class=\"stat-icon\">💬</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"></div>\n            <div class=\"stat-label\">Open Chats</div>\n          </div>\n        </div>\n        \n        <div class=\"stat-card customers\">\n          <div class=\"stat-icon\">👥</div>\n          <div class=\"stat-content\">\n            <div class=\"stat-value\"></div>\n            <div class=\"stat-label\">Customers</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Quick Actions -->\n      <div class=\"quick-actions\">\n        <h2>Quick Actions</h2>\n        <div class=\"actions-grid\">\n          <button class=\"action-card\">\n            <span class=\"action-icon\">🚨</span>\n            <span class=\"action-label\">Manage Alerts</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">❓</span>\n            <span class=\"action-label\">Edit FAQ</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">📚</span>\n            <span class=\"action-label\">Knowledge Base</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">💬</span>\n            <span class=\"action-label\">Chat Settings</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">🎫</span>\n            <span class=\"action-label\">Help Desk</span>\n          </button>\n          \n          <button class=\"action-card\">\n            <span class=\"action-icon\">👥</span>\n            <span class=\"action-label\">Customers</span>\n          </button>\n        </div>\n      </div>\n\n      <!-- Active Alerts Section -->\n      \n\n      <!-- Recent Tickets Section -->\n      <div class=\"section\">\n        <div class=\"section-header\">\n          <h2>🎫 Recent Support Tickets</h2>\n          <button class=\"btn-link\">\n            View All →\n          </button>\n        </div>\n        \n        \n      </div>\n    \n  </div>";
}

@page GET "/tenant-admin"
page tenant_admin_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/tenant-admin" };
  return html "<div class=\"tenant-admin-page\">\n  <div class=\"admin-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to Dashboard\n      </button>\n      <h1>🏢 Tenant Settings</h1>\n      \n    </div>\n  </div>\n\n  \n    <div class=\"admin-container\">\n      <div class=\"tabs\">\n        <button \n          class=\"tab\"\n        >\n          General\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Device Settings\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Connection\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Limits & Quotas\n        </button>\n        <button \n          class=\"tab\"\n        >\n          Users\n        </button>\n      </div>\n\n  \n\n  \n\n      \n\n      \n\n      \n\n      \n\n      \n    </div>\n  \n</div>";
}

@page GET "/tenant-selector"
page tenant_selector_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/tenant-selector" };
  return html "<div class=\"tenant-selector-page\">\n  <div class=\"selector-container\">\n    <div class=\"selector-header\">\n      <h1>Select Organization</h1>\n      <p>Choose the organization you want to work with</p>\n    </div>\n\n    \n      <div class=\"tenants-grid\">\n        \n\n        <button class=\"tenant-card create-new\">\n          <div class=\"create-icon\">➕</div>\n          <h3>Create New Organization</h3>\n          <p>Set up a new tenant for your devices</p>\n        </button>\n      </div>\n    \n  </div>\n</div>";
}

@page GET "/tenant-setup"
page tenant_setup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/tenant-setup" };
  return html "<div class=\"tenant-setup-page\">\n  <div class=\"setup-container\">\n    <div class=\"setup-header\">\n      <div>\n        <h1>🏢 Set Up Your Organization</h1>\n        <p>Create a tenant to manage your devices and networks</p>\n      </div>\n      <button type=\"button\" class=\"exit-button\")}>\n        Exit setup\n      </button>\n    </div>\n\n    <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 50%\"></div>\n        </div>\n\n        <h2>Organization Details</h2>\n        <p class=\"subtitle\">Tell us about your organization</p>\n\n        <div class=\"info-message\">\n          <span class=\"info-icon\">ℹ️</span>\n          <strong>Note:</strong> Each account can create one organization. You'll be the owner and can invite additional users.\n        </div>\n\n        \n\n        <form}>\n          <div class=\"form-group\">\n            <label for=\"tenantName\">\n              Organization Name <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"tenantName\"\n              type=\"text\"\n              placeholder=\"e.g., Acme Wireless\"\n              required\n            />\n            <p class=\"help-text\">Legal or business name of your organization</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"displayName\">\n              Display Name <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"displayName\"\n              type=\"text\"\n              placeholder=\"e.g., Acme Wireless ISP\"\n              required\n            />\n            <p class=\"help-text\">Name shown in the application</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"subdomain\">\n              Subdomain <span class=\"required\">*</span>\n            </label>\n            <div class=\"subdomain-input\">\n              <input\n                id=\"subdomain\"\n                type=\"text\"\n                placeholder=\"acme-wireless\"\n                required\n                pattern=\"[a-z0-9\\\\-]+\"\n              />\n              <span class=\"subdomain-suffix\">.your-domain.com</span>\n            </div>\n            <p class=\"help-text\">Unique URL for device connections: /cwmp/</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactEmail\">\n              Contact Email <span class=\"required\">*</span>\n            </label>\n            <input\n              id=\"contactEmail\"\n              type=\"email\"\n              placeholder=\"admin@acme-wireless.com\"\n              required\n            />\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"contactPhone\">\n              Contact Phone\n            </label>\n            <input\n              id=\"contactPhone\"\n              type=\"tel\"\n              placeholder=\"+1 (555) 123-4567\"\n            />\n          </div>\n\n          <div class=\"form-actions\">\n            <button type=\"submit\" class=\"btn-primary\">\n              \n                Create Tenant\n              \n            </button>\n          </div>\n        </form>\n      </div>\n    \n      <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 66%\"></div>\n        </div>\n\n        <h2>Payment Method Setup</h2>\n        <p class=\"subtitle\">Add a payment method for your account (required)</p>\n\n        <div class=\"beta-disclaimer\">\n          <div class=\"beta-badge\">BETA</div>\n          <p><strong>wisptools.io (WISP Management) is currently in beta.</strong> No charges will be made without prior notice. Adding a payment method now ensures uninterrupted service when billing begins.</p>\n        </div>\n\n        \n\n        <div class=\"form-group\">\n          <label>Payment Method <span class=\"required\">*</span></label>\n          <div class=\"payment-method-options\">\n            <label class=\"payment-option\">\n              <input \n                type=\"radio\" \n                name=\"paymentMethod\" \n                value=\"paypal\"\n              />\n              <div class=\"payment-option-content\">\n                <div class=\"payment-icon\">💳</div>\n                <div>\n                  <strong>PayPal</strong>\n                  <p>Pay with PayPal account</p>\n                </div>\n              </div>\n            </label>\n            <label class=\"payment-option\">\n              <input \n                type=\"radio\" \n                name=\"paymentMethod\" \n                value=\"credit_card\"\n              />\n              <div class=\"payment-option-content\">\n                <div class=\"payment-icon\">💳</div>\n                <div>\n                  <strong>Credit Card</strong>\n                  <p>Pay with credit or debit card</p>\n                </div>\n              </div>\n            </label>\n          </div>\n        </div>\n\n        \n\n        \n\n        <div class=\"form-actions\">\n          <button \n            type=\"button\" \n            class=\"btn-secondary\"\n          >\n            Skip for Now\n          </button>\n          <button \n            type=\"button\" \n            class=\"btn-primary\"\n          >\n            \n              Continue\n            \n          </button>\n        </div>\n      </div>\n    \n      <div class=\"setup-card\">\n        <div class=\"progress-bar\">\n          <div class=\"progress\" style=\"width: 100%\"></div>\n        </div>\n\n        <h2>Primary Location Setup</h2>\n        <p class=\"subtitle\">Set up your primary NOC/HQ/Tower location for inventory management</p>\n\n        <div class=\"info-message\">\n          <span class=\"info-icon\">ℹ️</span>\n          <strong>Note:</strong> Hardware scanned in will automatically be assigned to this location. You can change this later in settings.\n        </div>\n\n        \n\n        <div class=\"form-group\">\n          <label>Primary Location</label>\n          <div class=\"radio-group\">\n            <label class=\"radio-option\">\n              <input type=\"radio\" value=\"create\" />\n              <span>Create New Location</span>\n            </label>\n            <label class=\"radio-option\">\n              <input type=\"radio\" value=\"skip\" />\n              <span>Skip for Now</span>\n            </label>\n          </div>\n        </div>\n\n        \n\n        <div class=\"form-actions\">\n          <button \n            type=\"button\" \n            class=\"btn-secondary\");\n            }}\n          >\n            Skip\n          </button>\n          <button \n            type=\"button\" \n            class=\"btn-primary\"}\n          >\n            \n              Complete Setup\n            \n          </button>\n        </div>\n      </div>\n  </div>\n  \n  <!-- Site Creation Modal -->\n  \n</div>";
}

@page GET "/wizards"
page wizards_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/wizards" };
  return html "<div class=\"wizards-page\">\\r\n    <header class=\"wizards-header\">\\r\n      <button class=\"back-btn\" type=\"button\">\\r\n        ← Dashboard\\r\n      </button>\\r\n      <div class=\"wizards-header-row\">\\r\n        <h1>🧙 List of wizards</h1>\\r\n        <div class=\"wizards-pulldown-wrap\">\\r\n          <button\\r\n            type=\"button\"\\r\n            class=\"wizards-pulldown-trigger\"\\r\n            aria-haspopup=\"true\"\\r\n          >\\r\n            Jump to wizard ▼\\r\n          </button>\\r\n          \\r\n        </div>\\r\n      </div>\\r\n      <p class=\"subtitle\">Guided flows for setup, deployment, and operations. Each wizard runs inside its module. Use <strong>Jump to wizard</strong> above or \"Open in [Module]\" below to go to that module, then click the wizard button in the module header.</p>\\r\n    </header>\\r\n\\r\n    <div class=\"wizards-grid\">\\r\n      \\r\n    </div>\\r\n  </div>\\r\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"OrganizationSetupWizard\" aria-hidden=\"true\" role=\"dialog\"></div> (showOrgWizard = false)} />\\r\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"InitialConfigurationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> (showConfigWizard = false)} />";
}

