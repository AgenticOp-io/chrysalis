    </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/pci-resolution"
page modules_pci_resolution_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "pci-resolution" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"pci-resolution\" data-wisp-path=\"/modules/pci-resolution\" data-cwl-island=\"client\"><!-- Full Screen Map -->\n<!-- Note: Auth check removed - Module_Manager dashboard handles authentication -->\n<div class=\"app\">\n  <!-- Map Background -->\n  <div class=\"map-fullscreen\">\n\n      <div class=\"loading\" hidden aria-hidden=\"true\">\n        <div class=\"spinner\"></div>\n        <p>Analyzing...</p>\n      </div>\n\n  </div>\n\n  <!-- New UI Layout: Separate Positioned Elements -->\n\n  <!-- Top Left: Brand -->\n  <div data-cwl-component=\"TopBrand\" data-cwl-lifted-component=\"TopBrand\"><div class=\"top-brand\">\n  <div class=\"brand-content\">\n    <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"brand-icon\">\n      <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n      <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n    </svg>\n    <h1 class=\"app-title\">LTE PCI Mapper</h1>\n  </div>\n</div></div>\n\n  <!-- Top Right: Basemap Switcher -->\n  <div data-cwl-component=\"BasemapSwitcher\" data-cwl-lifted-component=\"BasemapSwitcher\"><div class=\"basemap-switcher\">\n\n    <button\n      class=\"basemap-btn\" data-cwl-action=\"selectBasemap\" data-cwl-action-args=\"&quot;topo-vector&quot;\"\n      title=Topo\n    >\n      <span class=\"basemap-icon\">🗺️</span>\n      <span class=\"basemap-label\">Topo</span>\n    </button>\n\n    <button\n      class=\"basemap-btn\" data-cwl-action=\"selectBasemap\" data-cwl-action-args=\"&quot;streets-vector&quot;\"\n      title=Streets\n    >\n      <span class=\"basemap-icon\">🛣️</span>\n      <span class=\"basemap-label\">Streets</span>\n    </button>\n\n    <button\n      class=\"basemap-btn\" data-cwl-action=\"selectBasemap\" data-cwl-action-args=\"&quot;hybrid&quot;\"\n      title=Satellite\n    >\n      <span class=\"basemap-icon\">🛰️</span>\n      <span class=\"basemap-label\">Satellite</span>\n    </button>\n\n</div></div>\n\n  <!-- Right Side: PCI Status Widget -->\n  <div data-cwl-component=\"PCIStatusWidget\" data-cwl-lifted-component=\"PCIStatusWidget\"><div class=\"pci-status-widget\">\n  <div class=\"status-header\">\n    <h2 class=\"status-title\">PCI Status</h2>\n    <div class=\"cell-count\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$cellCount\"></span> Cells</div>\n  </div>\n\n  <div class=\"status-grid\">\n    <div class=\"status-item total\">\n      <span class=\"status-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$conflictCount\"></span></span>\n      <span class=\"status-label\">Total</span>\n    </div>\n\n    <div class=\"status-item critical\">\n      <span class=\"status-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$criticalConflictCount\"></span></span>\n      <span class=\"status-label\">Critical</span>\n    </div>\n\n    <div class=\"status-item high\">\n      <span class=\"status-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$highConflictCount\"></span></span>\n      <span class=\"status-label\">High</span>\n    </div>\n\n    <div class=\"status-item medium\">\n      <span class=\"status-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$mediumConflictCount\"></span></span>\n      <span class=\"status-label\">Medium</span>\n    </div>\n\n    <div class=\"status-item low\">\n      <span class=\"status-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$lowConflictCount\"></span></span>\n      <span class=\"status-label\">Low</span>\n    </div>\n  </div>\n</div></div>\n\n  <!-- Left Sidebar: Vertical Menu -->\n  <div data-cwl-component=\"VerticalMenu\" data-cwl-lifted-component=\"VerticalMenu\"><div class=\"vertical-menu\">\n  <div class=\"menu-items\">\n    <!-- Back to Dashboard Button at Top -->\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$isAuthenticated && $currentUser\"><button class=\"logout-button back-button\" title=\"Back to Module Manager\" data-cwl-nav=\"/dashboard\" type=\"button\">\n        <div class=\"user-info\">\n          <span class=\"user-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getUserName()\"></span></span>\n          <span class=\"user-email\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentUser.email\"></span></span>\n        </div>\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path>\n          <polyline points=\"9 22 9 12 15 12 15 22\"></polyline>\n        </svg>\n      </button></div>\n\n    <div class=\"menu-divider\"></div>\n\n    <!-- Network Selector -->\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$currentNetwork\"><button class=\"network-selector\" data-cwl-action=\"networks\" title=\"Change network\">\n        <div class=\"network-info\">\n          <span class=\"network-name-menu\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentNetwork.name\"></span></span>\n          <span class=\"network-market-menu\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentNetwork.market\"></span></span>\n        </div>\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"chevron\">\n          <polyline points=\"6 9 12 15 18 9\"></polyline>\n        </svg>\n      </button></div>\n      <button class=\"network-selector empty\" data-cwl-action=\"networks\" title=\"Select network\">\n        <span>Select Network</span>\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"chevron\">\n          <polyline points=\"6 9 12 15 18 9\"></polyline>\n        </svg>\n      </button>\n\n    <div class=\"menu-divider\"></div>\n    <button class=\"menu-item\" data-cwl-action=\"import\" title=\"Import cell data\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n        <polyline points=\"7 10 12 15 17 10\"></polyline>\n        <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"></line>\n      </svg>\n      <span class=\"menu-label\">Import</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"towers\" title=\"Manage towers and cell sites\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n        <polyline points=\"2 17 12 22 22 17\"></polyline>\n        <polyline points=\"2 12 12 17 22 12\"></polyline>\n      </svg>\n      <span class=\"menu-label\">Towers</span>\n    </button>\n\n    <div class=\"menu-divider\"></div>\n\n    <button class=\"menu-item\" data-cwl-action=\"analyze\" data-cwl-attr-disabled=\"!hasData\" title=\"Run PCI analysis\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n        <path d=\"m21 21-4.35-4.35\"></path>\n      </svg>\n      <span class=\"menu-label\">Analyze</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"optimize\" data-cwl-attr-disabled=\"!hasConflicts\" title=\"Optimize PCI assignments\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n        <path d=\"M12 6v6l4 2\"></path>\n      </svg>\n      <span class=\"menu-label\">Optimize</span>\n    </button>\n\n      <div class=\"menu-wizards\">\n        <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showModuleWizardMenu\" hidden aria-hidden=\"true\"><div class=\"module-wizard-menu\">\n    <button\n      type=\"button\"\n      class=\"wizard-trigger\" data-cwl-attr-disabled=\"disabled\" data-cwl-action=\"toggle\" data-cwl-on-blur=\"action:handleBlur\"\n      title=\"Wizards for this module\"\n      aria-haspopup=\"true\"\n    >\n      <span class=\"wizard-trigger-icon\">🧙</span>\n      <span class=\"wizard-trigger-label\">Wizards</span>\n      <span class=\"wizard-trigger-chevron\">▼</span>\n    </button>\n\n      <div class=\"wizard-dropdown\" role=\"menu\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"wizards as w\" data-cwl-each-item=\"w\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22menuitem%22%0A%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22wizard-item%22%20data-cwl-action%3D%22select%22%20data-cwl-action-args%3D%22w.id%22%0A%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20w.icon%7D%3Cspan%20class%3D%22wizard-item-icon%22%3E%7Bw.icon%7D%3C%2Fspan%3E%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22wizard-item-label%22%3E%7Bw.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20\"><button\n            type=\"button\"\n            role=\"menuitem\"\n            class=\"wizard-item\" data-cwl-action=\"select\" data-cwl-action-args=\"w.id\"\n           aria-label=\"Select\">\n            <div hidden aria-hidden=\"true\"><span class=\"wizard-item-icon\"></span></div>\n            <span class=\"wizard-item-label\"></span>\n          </button></div>\n      </div>\n\n  </div></div></div>\n      </div>\n\n    <div class=\"menu-divider\"></div>\n\n    <button class=\"menu-item\" data-cwl-action=\"analysis\" title=\"View detailed analysis\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line>\n        <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line>\n        <line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"></line>\n      </svg>\n      <span class=\"menu-label\">Analysis</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"conflicts\" title=\"View PCI conflicts\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"></path>\n        <line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line>\n        <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n      </svg>\n      <span class=\"menu-label\">Conflicts</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"recommendations\" title=\"AI recommendations\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n        <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n        <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n      </svg>\n      <span class=\"menu-label\">AI Suggest</span>\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"export\" data-cwl-attr-disabled=\"!hasData\" title=\"Export reports and configurations\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n        <polyline points=\"17 8 12 3 7 8\"></polyline>\n        <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n      </svg>\n      <span class=\"menu-label\">Export</span>\n    </button>\n\n  </div>\n</div></div>\n\n  <!-- Bottom Right: Settings Gear Menu -->\n  <div data-cwl-component=\"SettingsMenu\" data-cwl-lifted-component=\"SettingsMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSettingsMenu\" hidden aria-hidden=\"true\"><div class=\"settings-menu\">\n  <button class=\"settings-trigger\" data-cwl-action=\"toggleMenu\" title=\"Settings\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n      <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path>\n    </svg>\n  </button>\n\n    <div class=\"settings-panel\">\n      <div class=\"settings-header\">\n        <h3>⚙️ Settings</h3>\n        <button class=\"close-btn\" data-cwl-toggle=\"isOpen:false\" aria-label=\"Is Open\">×</button>\n      </div>\n\n      <div class=\"settings-content\">\n        <div class=\"setting-item\">\n          <span class=\"setting-label\">Theme</span>\n          <div data-cwl-component=\"ThemeSwitcher\" data-cwl-lifted-component=\"ThemeSwitcher\"><div class=\"theme-switcher\">\n  <button\n    class=\"theme-button\" data-cwl-action=\"toggleDropdown\"\n    aria-label=\"Toggle theme\"\n    title=\"Change theme\"\n  >\n\n  </button>\n\n    <div class=\"dropdown\" data-cwl-shell-key=\"showDropdown\" hidden aria-hidden=\"true\">\n      <button\n        class=\"dropdown-item\" data-cwl-action=\"handleThemeSelect\" data-cwl-action-args=\"'light'\"\n       aria-label=\"Theme Select\">\n        <svg\n          class=\"dropdown-icon\"\n          width=\"18\"\n          height=\"18\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n        >\n          <circle cx=\"12\" cy=\"12\" r=\"5\" />\n          <line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"3\" />\n          <line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"23\" />\n          <line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\" />\n          <line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\" />\n          <line x1=\"1\" y1=\"12\" x2=\"3\" y2=\"12\" />\n          <line x1=\"21\" y1=\"12\" x2=\"23\" y2=\"12\" />\n          <line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\" />\n          <line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\" />\n        </svg>\n        <span>Light</span>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$themeStore.mode === 'light'\"><svg class=\"check-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n            <polyline points=\"20 6 9 17 4 12\"></polyline>\n          </svg></div>\n      </button>\n\n      <button\n        class=\"dropdown-item\" data-cwl-action=\"handleThemeSelect\" data-cwl-action-args=\"'dark'\"\n       aria-label=\"Theme Select\">\n        <svg\n          class=\"dropdown-icon\"\n          width=\"18\"\n          height=\"18\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n        >\n          <path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\" />\n        </svg>\n        <span>Dark</span>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$themeStore.mode === 'dark'\"><svg class=\"check-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n            <polyline points=\"20 6 9 17 4 12\"></polyline>\n          </svg></div>\n      </button>\n\n      <button\n        class=\"dropdown-item\" data-cwl-action=\"handleThemeSelect\" data-cwl-action-args=\"'system'\"\n       aria-label=\"Theme Select\">\n        <svg\n          class=\"dropdown-icon\"\n          width=\"18\"\n          height=\"18\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n        >\n          <rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect>\n          <line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"></line>\n          <line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"></line>\n        </svg>\n        <span>System</span>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$themeStore.mode === 'system'\"><svg class=\"check-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\n            <polyline points=\"20 6 9 17 4 12\"></polyline>\n          </svg></div>\n      </button>\n    </div>\n\n</div></div>\n        </div>\n\n        <div class=\"menu-divider\"></div>\n\n        <div class=\"setting-info\">\n          <p class=\"info-text\">More settings coming soon...</p>\n        </div>\n      </div>\n    </div>\n\n</div></div></div>\n\n  <!-- Help Button -->\n  <button class=\"help-button\" data-cwl-toggle=\"showHelpModal:true\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n  <!-- Modular Components - Isolated and reusable -->\n  <div data-cwl-component=\"NetworkManager\" data-cwl-lifted-component=\"NetworkManager\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showNetworkManager\" hidden aria-hidden=\"true\"><div\n    class=\"network-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n  >\n    <div\n      class=\"network-modal\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"network-manager-modal-title\"\n    >\n      <div class=\"network-header\">\n        <h2 id=\"network-manager-modal-title\">\n\n            My Networks\n\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"network-body\">\n\n          <div class=\"network-list\">\n\n              <div class=\"loading-state\" hidden aria-hidden=\"true\">\n                <div class=\"spinner-small\"></div>\n                <p>Loading networks...</p>\n              </div>\n\n          </div>\n\n      </div>\n    </div>\n  </div></div></div>\n\n  <div data-cwl-component=\"ImportWizard\" data-cwl-lifted-component=\"ImportWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showImportWizard\" hidden aria-hidden=\"true\"><div\n    class=\"wizard-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"wizard-modal\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"import-wizard-modal-title\"\n    >\n      <div class=\"wizard-header\">\n        <h2 id=\"import-wizard-modal-title\">Import Data</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"wizard-body\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!importMethod\"><!-- Step 1: Choose Import Method -->\n          <div class=\"wizard-intro\">\n            <p class=\"intro-text\">Choose how you'd like to import cell data:</p>\n          </div>\n\n          <div class=\"method-grid\">\n            <button class=\"method-card\" data-cwl-action=\"selectMethod\" data-cwl-action-args=\"'csv'\" aria-label=\"Select Method\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path>\n                  <polyline points=\"14 2 14 8 20 8\"></polyline>\n                  <line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"12\"></line>\n                  <line x1=\"9\" y1=\"15\" x2=\"15\" y2=\"15\"></line>\n                </svg>\n              </div>\n              <h3>CSV File</h3>\n              <p>Upload a CSV file with cell tower data</p>\n            </button>\n\n            <button class=\"method-card\" data-cwl-action=\"selectMethod\" data-cwl-action-args=\"'kml'\" aria-label=\"Select Method\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n              </div>\n              <h3>KML File</h3>\n              <p>Import from Google Earth or GIS software</p>\n            </button>\n\n            <button class=\"method-card\" data-cwl-action=\"selectMethod\" data-cwl-action-args=\"'manual'\" aria-label=\"Select Method\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path>\n                  <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path>\n                </svg>\n              </div>\n              <h3>Manual Entry</h3>\n              <p>Add cell data manually one by one</p>\n            </button>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importMethod === 'csv'\"><!-- Step 2: CSV Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\" data-cwl-action=\"goBack\" aria-label=\"Go Back\">← Back</button>\n\n            <h3>📄 CSV Import</h3>\n            <p class=\"help-text\">Upload a CSV file with tower/cell data. Leave PCI blank for auto-assignment.</p>\n\n            <div class=\"file-upload-zone\">\n              <input\n                type=\"file\"\n                accept=\".csv\" data-cwl-on-change=\"action:handleCSVUpload\"\n                id=\"csv-upload\"\n              />\n              <label for=\"csv-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n                  <polyline points=\"17 8 12 3 7 8\"></polyline>\n                  <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n                </svg>\n                <span>Choose CSV file or drag & drop</span>\n              </label>\n            </div>\n\n            <button class=\"template-btn\" data-cwl-action=\"downloadCSVTemplate\" aria-label=\"Download CSVTemplate\">\n              📥 Download CSV Template\n            </button>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importMethod === 'kml'\"><!-- Step 2: KML Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\" data-cwl-action=\"goBack\" aria-label=\"Go Back\">← Back</button>\n\n            <h3>🗺️ KML Import</h3>\n            <p class=\"help-text\">Upload a KML file from Google Earth or GIS software.</p>\n\n            <div class=\"file-upload-zone\">\n              <input\n                type=\"file\"\n                accept=\".kml,.kmz\" data-cwl-on-change=\"action:handleKMLUpload\"\n                id=\"kml-upload\"\n              />\n              <label for=\"kml-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n                <span>Choose KML/KMZ file or drag & drop</span>\n              </label>\n            </div>\n\n            <button class=\"template-btn\" data-cwl-action=\"downloadKMLTemplate\" aria-label=\"Download KMLTemplate\">\n              📥 Download KML Template\n            </button>\n\n            <div class=\"info-box\">\n              <strong>Supported Data:</strong> The KML parser will extract coordinates, name, and cell parameters from ExtendedData or description fields (PCI, eNodeB, Sector, Frequency, etc.).\n            </div>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importMethod === 'manual'\"><!-- Step 2: Manual Site Entry -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\" data-cwl-action=\"goBack\" aria-label=\"Go Back\">← Back</button>\n\n            <h3>✏️ Manual Site Entry</h3>\n            <p class=\"method-description\">Add cell sites with sectors and channels</p>\n\n            <!-- Add Site Button -->\n            <div class=\"manual-add-section\">\n              <button\n                type=\"button\"\n                class=\"add-site-btn-large\" data-cwl-toggle=\"showSiteEditorInWizard:true\"\n               aria-label=\"Show Site Editor In Wizard\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n                Add Cell Site\n              </button>\n              <p class=\"add-hint\">Each site can have multiple sectors with different azimuths and EARFCNs</p>\n            </div>\n\n            <!-- Sites List -->\n\n              <div class=\"sites-list\">\n                <h4>Added Sites (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"manualSites.length\"></span>)</h4>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"manualSites as site, index\"><div class=\"site-preview\">\n                    <div class=\"site-preview-header\">\n                      <strong></strong>\n                      <span class=\"site-preview-meta\">eNodeB  •  Sector</span>\n                    </div>\n                    <div class=\"sector-summary\">\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"site.sectors as sector\"><span class=\"sector-badge\">\n                          Sec : ° | PCI  |  Ch\n                        </span></div>\n                    </div>\n                    <button\n                      type=\"button\"\n                      class=\"remove-site-btn\" data-cwl-action=\"removeSiteFromImport\" data-cwl-action-args=\"index\"\n                     aria-label=\"Remove Site From Import\">\n                      Remove\n                    </button>\n                  </div></div>\n              </div>\n\n              <div class=\"manual-actions\">\n                <button class=\"import-btn\" data-cwl-action=\"importManualSites\" aria-label=\"Import Manual Sites\">\n                  ✅ Import <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"manualSites.length\"></span> Site<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"manualSites.length !== 1 ? 's' : ''\"></span>\n                </button>\n              </div>\n\n          </div></div>\n      </div>\n    </div>\n  </div>\n\n<!-- Nested Site Editor for Manual Import -->\n<div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSiteEditorInWizard\" hidden aria-hidden=\"true\"><div class=\"modal-backdrop\">\n    <div class=\"site-editor\">\n      <div class=\"editor-header\">\n        <h2>\n\n            🏗️ Create New Cell Site\n\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"editor-content\">\n        <!-- Site Information -->\n        <section class=\"editor-section\">\n          <h3>Cell Site Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"siteId\">Site ID</label>\n              <input\n                type=\"text\"\n                id=\"siteId\" data-cwl-attr-disabled=\"!isNewSite\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"siteName\">Site Name</label>\n              <input\n                type=\"text\"\n                id=\"siteName\"\n                placeholder=\"Manhattan Tower A\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"eNodeB\">eNodeB</label>\n              <input\n                type=\"number\"\n                id=\"eNodeB\"\n                required\n              />\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"latitude\">Latitude</label>\n              <input\n                type=\"number\"\n                id=\"latitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"longitude\">Longitude</label>\n              <input\n                type=\"number\"\n                id=\"longitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n          </div>\n        </section>\n\n        <!-- Sectors Section -->\n        <section class=\"editor-section sectors-section\">\n          <div class=\"section-header\">\n            <h3>📡 Sectors (Transmitters on this Cell)</h3>\n            <div class=\"sector-count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length\"></span> Sector<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length !== 1 ? 's' : ''\"></span></div>\n          </div>\n\n          <div class=\"add-sector-prompt\">\n            <button type=\"button\" class=\"add-sector-btn-large\" data-cwl-action=\"addSector\" aria-label=\"Add Sector\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line>\n                <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line>\n              </svg>\n              Add New Sector\n            </button>\n            <p class=\"add-sector-hint\">Add up to 4 sectors (3-sector or 4-sector tower). Each sector can have multiple carriers.</p>\n          </div>\n\n            <div class=\"sectors-grid\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"editedSite.sectors as sector, sectorIndex\"><div class=\"sector-unit\">\n                  <!-- Sector Header with Visual Indicator -->\n                  <div class=\"sector-unit-header\">\n                    <div class=\"sector-title-section\">\n                      <div class=\"sector-icon\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                          <path d=\"M2 17l10 5 10-5\"></path>\n                          <path d=\"M2 12l10 5 10-5\"></path>\n                        </svg>\n                      </div>\n                      <div class=\"sector-title-info\">\n                        <h4>Sector </h4>\n                        <span class=\"sector-subtitle\">Azimuth: ° |  Carrier</span>\n                        <span class=\"sector-pcis\">Carrier PCIs: :$`).join(', ')}</span>\n                      </div>\n                    </div>\n                    <button\n                      type=\"button\"\n                      class=\"remove-sector-btn\" data-cwl-action=\"removeSector\" data-cwl-action-args=\"sectorIndex\"\n                      title=\"Remove this sector\"\n                    >\n                      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <polyline points=\"3 6 5 6 21 6\"></polyline>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n                      </svg>\n                    </button>\n                  </div>\n\n                  <div class=\"sector-details\">\n                    <!-- Prominent Azimuth Control -->\n                    <div class=\"azimuth-control\">\n                      <div class=\"azimuth-label\">\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <polygon points=\"3 11 22 2 13 21 11 13 3 11\"></polygon>\n                        </svg>\n                        Azimuth Direction\n                      </div>\n                      <div class=\"azimuth-input-group\">\n                        <input\n                          type=\"range\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-slider\"\n                        />\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-number\"\n                        />\n                        <span class=\"azimuth-compass\">\n                          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 337.5 || sector.azimuth < 22.5\">N</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 22.5 && sector.azimuth < 67.5\">NE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 67.5 && sector.azimuth < 112.5\">E</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 112.5 && sector.azimuth < 157.5\">SE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 157.5 && sector.azimuth < 202.5\">S</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 202.5 && sector.azimuth < 247.5\">SW</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 247.5 && sector.azimuth < 292.5\">W</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 292.5 && sector.azimuth < 337.5\">NW</div>\n                        </span>\n                      </div>\n                    </div>\n\n                    <!-- Beamwidth Control -->\n                    <div class=\"beamwidth-control\">\n                      <div class=\"beamwidth-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7v10c0 5.5 3.84 7.66 10 9 6.16-1.34 10-3.5 10-9V7l-10-5z\"></path>\n                        </svg>\n                        Beamwidth (Coverage Angle)\n                      </div>\n                      <div class=\"beamwidth-selector\">\n                        <select= class=\"beamwidth-select\">\n                          <option data-cwl-attr-value=\"33\">33° (Narrow - Directional)</option>\n                          <option data-cwl-attr-value=\"65\">65° (Standard - Macro)</option>\n                          <option data-cwl-attr-value=\"78\">78° (Wide - Coverage)</option>\n                          <option data-cwl-attr-value=\"90\">90° (Very Wide - Small Cell)</option>\n                          <option data-cwl-attr-value=\"120\">120° (Ultra Wide - Omni-like)</option>\n                        </select>\n                        <span class=\"beamwidth-visual\">°</span>\n                      </div>\n                    </div>\n\n                    <!-- Height AGL Control -->\n                    <div class=\"height-control\">\n                      <div class=\"height-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line>\n                          <polyline points=\"8 8 12 4 16 8\"></polyline>\n                          <polyline points=\"8 16 12 20 16 16\"></polyline>\n                        </svg>\n                        Height Above Ground Level\n                      </div>\n                      <div class=\"height-input-group\">\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"2000\"\n                          step=\"1\"\n                          class=\"height-input\"\n                        />\n                        <span class=\"height-unit\">feet</span>\n                      </div>\n                    </div>\n\n                    <div class=\"form-row\">\n                      <div class=\"form-group-sm\">\n                        <label>\n                          RS Power (dBm)\n                          <input\n                            type=\"number\"=\n                            min=\"-120\"\n                            max=\"30\"\n                          />\n                        </label>\n                      </div>\n\n                      <div class=\"form-group-sm\">\n                        <label>\n                          Technology\n                          <select=>\n                            <option value=\"LTE\">LTE (4G)</option>\n                          </select>\n                        </label>\n                      </div>\n                    </div>\n\n                    <div class=\"pci-note\">\n                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                        <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                      </svg>\n                      <span>Each sector transmitter can have multiple carriers. Each carrier needs its own PCI and EARFCN.</span>\n                    </div>\n\n                    <!-- Carriers for this transmitter -->\n                    <div class=\"channels-section\">\n                      <div class=\"channels-header\">\n                        <strong>📻 Carriers</strong>\n                        <span class=\"carrier-info\">Each carrier has its own EARFCN & PCI</span>\n                        <button\n                          type=\"button\"\n                          class=\"add-channel-btn-sm\" data-cwl-action=\"addChannelToSector\" data-cwl-action-args=\"sectorIndex\"\n                         aria-label=\"Add Channel To Sector\">\n                          + Add Carrier\n                        </button>\n                      </div>\n\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sector.channels as channel, channelIndex\"><div class=\"carrier-card\">\n                          <div class=\"carrier-header\">\n                            <div class=\"carrier-number\">Carrier </div>\n                            <div class=\"carrier-primary-select\">\n                              <input\n                                type=\"radio\"\n                                name=\"primary-\" data-cwl-on-change=\"action:setPrimaryChannel\" data-cwl-on-change-args=\"sectorIndex, channelIndex\"\n                                title=\"Primary carrier\"\n                                id=\"primary--\"\n                              />\n                              <label for=\"primary--\" class=\"primary-label\">\n\n                              </label>\n                            </div>\n                            <button\n                              type=\"button\"\n                              class=\"remove-channel-btn\" data-cwl-action=\"removeChannel\" data-cwl-action-args=\"sectorIndex, channelIndex\" title=\"Remove carrier\"\n                            >\n                              ×\n                            </button>\n                          </div>\n\n                          <div class=\"carrier-details\">\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"earfcn--\">EARFCN DL</label>\n                              <input\n                                type=\"number\"\n                                id=\"earfcn--\"=\n                                placeholder=\"55640\"\n                                class=\"carrier-input\"\n                                min=\"55240\"\n                                max=\"56739\"\n                                title=\"Band 48: 55240-56739\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"bw--\">Bandwidth</label>\n                              <select id=\"bw--\"= class=\"carrier-select\">\n                                <option data-cwl-attr-value=\"10\">10 MHz</option>\n                                <option data-cwl-attr-value=\"15\">15 MHz</option>\n                                <option data-cwl-attr-value=\"20\">20 MHz</option>\n                              </select>\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"pci--\">PCI</label>\n                              <input\n                                type=\"number\"\n                                id=\"pci--\"=\n                                placeholder=\"0\"\n                                class=\"carrier-input-sm\"\n                                min=\"0\"\n                                max=\"503\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <span class=\"freq-display\"> MHz</span>\n                            </div>\n                          </div>\n                        </div></div>\n                    </div>\n                  </div>\n                </div></div>\n            </div>\n\n            <div hidden aria-hidden=\"true\"><p class=\"empty-message\">\n              📍 No sectors configured yet.<br/>\n              Click \"Add New Sector\" above to create your first sector.\n            </p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"editor-footer\">\n        <button type=\"button\" class=\"cancel-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n        <button type=\"button\" class=\"save-btn\" data-cwl-action=\"handleSave\" aria-label=\"Save\">\n\n            🏗️ Create Site\n\n        </button>\n      </div>\n    </div>\n  </div></div></div></div></div>\n\n  <div data-cwl-component=\"AnalysisModal\" data-cwl-lifted-component=\"AnalysisModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showAnalysisModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && analysis\"><div\n    class=\"modal-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"modal\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"analysis-modal-title\"\n    >\n      <div class=\"modal-header\">\n        <h2 id=\"analysis-modal-title\">Analysis Summary</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"stats-grid\">\n          <div class=\"stat-box\">\n            <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"analysis.totalCells\"></span></div>\n            <div class=\"stat-label\">Total Cells</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"analysis.conflicts.length\"></span></div>\n            <div class=\"stat-label\">Conflicts</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"analysis.conflictRate.toFixed(1)\"></span>%</div>\n            <div class=\"stat-label\">Conflict Rate</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.filter(c => c.severity === 'CRITICAL').length\"></span></div>\n            <div class=\"stat-label\">Critical</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.filter(c => c.severity === 'HIGH').length\"></span></div>\n            <div class=\"stat-label\">High</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-number\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.filter(c => c.severity === 'MEDIUM').length\"></span></div>\n            <div class=\"stat-label\">Medium</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div></div></div>\n\n  <div data-cwl-component=\"ConflictsModal\" data-cwl-lifted-component=\"ConflictsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showConflictsModal\" hidden aria-hidden=\"true\"><div\n    class=\"modal-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"modal modal-large\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"conflicts-modal-title\"\n    >\n      <div class=\"modal-header\">\n        <h2 id=\"conflicts-modal-title\">Conflicts (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.length\"></span>)</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"modal-body scrollable\">\n\n          <div class=\"conflicts-table\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"conflicts as conflict\" data-cwl-each-item=\"conflict\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22conflict-row%20%7Bconflict.severity.toLowerCase()%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22conflict-cells%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22cell-name%22%3E%7Bconflict.primaryCell.id%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22arrow%22%3E%E2%86%92%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22cell-name%22%3E%7Bconflict.conflictingCell.id%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22conflict-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7Bconflict.severity.toLowerCase()%7D%22%3E%7Bconflict.severity%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22type%22%3E%7Bconflict.conflictType%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22distance%22%3E%7Bconflict.distance.toFixed(0)%7Dm%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20conflict.losChecked%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20conflict.terrainBlocked%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22los-badge%20blocked%22%20title%3D%22Terrain%20blocks%20line%20of%20sight%22%3E%F0%9F%97%BB%20No%20LOS%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%20if%20conflict.hasLineOfSight%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22los-badge%20clear%22%20title%3D%22Clear%20line%20of%20sight%22%3E%F0%9F%91%81%EF%B8%8F%20LOS%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"conflict-row \">\n                <div class=\"conflict-cells\">\n                  <span class=\"cell-name\"></span>\n                  <span class=\"arrow\">→</span>\n                  <span class=\"cell-name\"></span>\n                </div>\n                <div class=\"conflict-meta\">\n                  <span class=\"badge \"></span>\n                  <span class=\"type\"></span>\n                  <span class=\"distance\">m</span>\n\n                    <div hidden aria-hidden=\"true\">\n                      <div hidden aria-hidden=\"true\"><span class=\"los-badge clear\" title=\"Clear line of sight\">👁️ LOS</span>\n                    </div>\n                      <div hidden aria-hidden=\"true\"><span class=\"los-badge blocked\" title=\"Terrain blocks line of sight\">🗻 No LOS</span>\n                    </div>\n                  </div>\n                </div>\n              </div></div>\n          </div>\n\n      </div>\n    </div>\n  </div></div></div>\n\n  <div data-cwl-component=\"RecommendationsModal\" data-cwl-lifted-component=\"RecommendationsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showRecommendationsModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && geminiAnalysis\"><div\n    class=\"modal-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"modal modal-large\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"recommendations-modal-title\"\n    >\n      <div class=\"modal-header\">\n        <h2 id=\"recommendations-modal-title\">AI Recommendations</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"modal-body scrollable\">\n        <div class=\"recommendations\">\n\n        </div>\n      </div>\n    </div>\n  </div></div></div></div>\n\n  <div data-cwl-component=\"OptimizationResultModal\" data-cwl-lifted-component=\"OptimizationResultModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showOptimizationResultModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && result\"><div\n    class=\"modal-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"modal\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"optimization-modal-title\"\n    >\n      <div class=\"modal-header\">\n        <h2 id=\"optimization-modal-title\">Optimization Complete</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"success-banner\">\n          <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <polyline points=\"20 6 9 17 4 12\"></polyline>\n          </svg>\n          <p>Successfully optimized PCI assignments</p>\n        </div>\n        <div class=\"result-stats\">\n          <div class=\"result-item\">\n            <div class=\"result-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"result.resolvedConflicts\"></span></div>\n            <div class=\"result-label\">Conflicts Resolved</div>\n          </div>\n          <div class=\"result-item\">\n            <div class=\"result-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"result.conflictReduction.toFixed(0)\"></span>%</div>\n            <div class=\"result-label\">Reduction</div>\n          </div>\n          <div class=\"result-item\">\n            <div class=\"result-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"result.iterations\"></span></div>\n            <div class=\"result-label\">Iterations</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div></div></div>\n\n  <div data-cwl-component=\"CellEditor\" data-cwl-lifted-component=\"CellEditor\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showCellEditor\" hidden aria-hidden=\"true\"><div class=\"modal-backdrop\">\n    <div class=\"cell-editor\">\n      <div class=\"editor-header\">\n        <h2>\n\n            📡 Edit Cell: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"cell?.id || 'Unknown'\"></span>\n\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"editor-content\">\n        <!-- Basic Info Section -->\n        <section class=\"editor-section\">\n          <h3>Basic Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"cellId\">Cell ID</label>\n              <input\n                type=\"text\"\n                id=\"cellId\" data-cwl-attr-disabled=\"!isNewCell\"\n                placeholder=\"CELL001\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"eNodeB\">eNodeB</label>\n              <input\n                type=\"number\"\n                id=\"eNodeB\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"sector\">Sector</label>\n              <input\n                type=\"number\"\n                id=\"sector\"\n                min=\"1\"\n                max=\"12\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"pci\">PCI</label>\n              <input\n                type=\"number\"\n                id=\"pci\"\n                min=\"0\"\n                max=\"503\"\n              />\n            </div>\n          </div>\n        </section>\n\n        <!-- Location Section -->\n        <section class=\"editor-section\">\n          <h3>Location</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"latitude\">Latitude</label>\n              <input\n                type=\"number\"\n                id=\"latitude\"\n                step=\"0.000001\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"longitude\">Longitude</label>\n              <input\n                type=\"number\"\n                id=\"longitude\"\n                step=\"0.000001\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"azimuth\">Azimuth (degrees)</label>\n              <input\n                type=\"number\"\n                id=\"azimuth\"\n                min=\"0\"\n                max=\"359\"\n                placeholder=\"0-359\"\n                required\n              />\n              <span class=\"helper-text\">Direction the antenna is pointing (0° = North)</span>\n            </div>\n          </div>\n        </section>\n\n        <!-- RF Parameters Section -->\n        <section class=\"editor-section\">\n          <h3>RF Parameters</h3>\n\n          <!-- Smart Frequency/EARFCN Input -->\n          <div class=\"smart-input-section\">\n            <label for=\"smartInput\">🎯 Quick Add: Frequency or EARFCN</label>\n            <p class=\"smart-help\">Add frequencies or EARFCNs to the list below (e.g., 2100, 3550, 1950, 55240)</p>\n\n            <!-- Band Selector -->\n            <div class=\"band-selector-group\">\n              <label for=\"bandSelect\" class=\"band-label\">LTE Band:</label>\n              <select id=\"bandSelect\" class=\"band-select\">\n\n                  <option value=auto>Auto-Detect</option>\n\n                  <option value=1>Band 1 (2100 MHz FDD)</option>\n\n                  <option value=2>Band 2 (1900 MHz FDD)</option>\n\n                  <option value=3>Band 3 (1800 MHz FDD)</option>\n\n                  <option value=4>Band 4 (AWS 2100 FDD)</option>\n\n                  <option value=5>Band 5 (850 MHz FDD)</option>\n\n                  <option value=7>Band 7 (2600 MHz FDD)</option>\n\n                  <option value=12>Band 12 (700 MHz FDD)</option>\n\n                  <option value=13>Band 13 (700 MHz FDD)</option>\n\n                  <option value=17>Band 17 (700 MHz FDD)</option>\n\n                  <option value=25>Band 25 (1900 MHz FDD)</option>\n\n                  <option value=26>Band 26 (850 MHz FDD)</option>\n\n                  <option value=66>Band 66 (AWS-3 FDD)</option>\n\n                  <option value=71>Band 71 (600 MHz FDD)</option>\n\n                  <option value=33>Band 33 (1900 MHz TDD)</option>\n\n                  <option value=34>Band 34 (2000 MHz TDD)</option>\n\n                  <option value=41>Band 41 (2500 MHz TDD)</option>\n\n                  <option value=42>Band 42 (3500 MHz TDD)</option>\n\n                  <option value=43>Band 43 (3700 MHz TDD)</option>\n\n                  <option value=48>Band 48 (CBRS 3550 TDD)</option>\n\n              </select>\n            </div>\n\n            <!-- Frequency/EARFCN Input -->\n            <div class=\"smart-input-group\">\n              <input\n                type=\"number\"\n                id=\"smartInput\"\n                placeholder=\"2100 or 1950 or 55240...\" data-cwl-on-keydown=\"action:handleSmartInput\"\n                class=\"smart-input\"\n              />\n              <button\n                type=\"button\"\n                class=\"smart-btn\" data-cwl-action=\"handleSmartInput\" data-cwl-attr-disabled=\"!smartInputValue\"\n               aria-label=\"Smart Input\">\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n                  <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                </svg>\n                Add to List\n              </button>\n            </div>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedBand !== 'auto'\"><p class=\"band-hint\">\n                ℹ️ <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"bandOptions.find(b => b.value === selectedBand)?.label || ''\"></span> -\n                Enter frequency between <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"bandOptions.find(b => b.value === selectedBand)?.freqRange?.[0]\"></span>-<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"bandOptions.find(b => b.value === selectedBand)?.freqRange?.[1]\"></span> MHz\n              </p></div>\n          </div>\n\n          <div class=\"divider\"></div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"dlEarfcn\">DL EARFCN</label>\n              <input\n                type=\"number\"\n                id=\"dlEarfcn\" data-cwl-on-input=\"action:handleDlEarfcnChange\"\n                min=\"0\"\n                max=\"70000\"\n              />\n              <span class=\"helper-text\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getFrequencyBand(editedCell.dlEarfcn || 0)\"></span>\n\n                  <div hidden aria-hidden=\"true\">• <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"earfcnToFrequency(editedCell.dlEarfcn).isTDD ? 'TDD' : 'FDD'\"></span>\n                </div>\n              </span>\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"ulEarfcn\">UL EARFCN <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"earfcnToFrequency(editedCell.dlEarfcn || 0).isTDD ? '(Same as DL for TDD)' : ''\"></span></label>\n              <input\n                type=\"number\"\n                id=\"ulEarfcn\"\n                min=\"0\"\n                max=\"70000\" data-cwl-attr-disabled=\"earfcnToFrequency(editedCell.dlEarfcn || 0).isTDD\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"centerFreq\">Center Frequency (MHz)</label>\n              <input\n                type=\"number\"\n                id=\"centerFreq\" data-cwl-on-input=\"action:handleCenterFreqChange\"\n                step=\"0.1\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"channelBandwidth\">Channel Bandwidth (MHz)</label>\n              <select id=\"channelBandwidth\">\n                <option data-cwl-attr-value=\"1.4\">1.4 MHz</option>\n                <option data-cwl-attr-value=\"3\">3 MHz</option>\n                <option data-cwl-attr-value=\"5\">5 MHz</option>\n                <option data-cwl-attr-value=\"10\">10 MHz</option>\n                <option data-cwl-attr-value=\"15\">15 MHz</option>\n                <option data-cwl-attr-value=\"20\">20 MHz</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"rsPower\">RS Power (dBm)</label>\n              <input\n                type=\"number\"\n                id=\"rsPower\"\n                step=\"0.1\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"technology\">Technology</label>\n              <select id=\"technology\">\n                <option value=\"LTE\">LTE (4G)</option>\n              </select>\n            </div>\n          </div>\n        </section>\n\n        <!-- Additional EARFCNs Section -->\n        <section class=\"editor-section\">\n          <h3>Additional EARFCNs</h3>\n          <p class=\"section-description\">Add carrier aggregation or additional frequency channels</p>\n\n          <div class=\"earfcn-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"additionalEarfcns as earfcn, index\"><div class=\"earfcn-item\">\n                <span class=\"earfcn-value\"></span>\n                <span class=\"earfcn-band\"></span>\n                <button\n                  type=\"button\"\n                  class=\"remove-earfcn-btn\" data-cwl-action=\"removeEarfcn\" data-cwl-action-args=\"index\"\n                 aria-label=\"Remove Earfcn\">\n                  ×\n                </button>\n              </div></div>\n          </div>\n\n          <div class=\"add-earfcn-group\">\n            <input\n              type=\"number\"\n              placeholder=\"Enter EARFCN (e.g., 1950)\" data-cwl-on-keydown=\"action:addEarfcn\"\n            />\n            <button\n              type=\"button\"\n              class=\"add-earfcn-btn\" data-cwl-action=\"addEarfcn\" data-cwl-attr-disabled=\"!newEarfcn\"\n             aria-label=\"Add Earfcn\">\n              + Add EARFCN\n            </button>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"editor-footer\">\n        <button type=\"button\" class=\"cancel-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n        <button type=\"button\" class=\"save-btn\" data-cwl-action=\"handleSave\" aria-label=\"Save\">\n\n            💾 Save Changes\n\n        </button>\n      </div>\n    </div>\n  </div></div></div>\n\n  <div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSiteEditor\" hidden aria-hidden=\"true\"><div class=\"modal-backdrop\">\n    <div class=\"site-editor\">\n      <div class=\"editor-header\">\n        <h2>\n\n            🏗️ Edit Cell Site: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site?.name || 'Unknown'\"></span>\n\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"editor-content\">\n        <!-- Site Information -->\n        <section class=\"editor-section\">\n          <h3>Cell Site Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"siteId\">Site ID</label>\n              <input\n                type=\"text\"\n                id=\"siteId\" data-cwl-attr-disabled=\"!isNewSite\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"siteName\">Site Name</label>\n              <input\n                type=\"text\"\n                id=\"siteName\"\n                placeholder=\"Manhattan Tower A\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"eNodeB\">eNodeB</label>\n              <input\n                type=\"number\"\n                id=\"eNodeB\"\n                required\n              />\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"latitude\">Latitude</label>\n              <input\n                type=\"number\"\n                id=\"latitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"longitude\">Longitude</label>\n              <input\n                type=\"number\"\n                id=\"longitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n          </div>\n        </section>\n\n        <!-- Sectors Section -->\n        <section class=\"editor-section sectors-section\">\n          <div class=\"section-header\">\n            <h3>📡 Sectors (Transmitters on this Cell)</h3>\n            <div class=\"sector-count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length\"></span> Sector<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length !== 1 ? 's' : ''\"></span></div>\n          </div>\n\n          <div class=\"add-sector-prompt\">\n            <button type=\"button\" class=\"add-sector-btn-large\" data-cwl-action=\"addSector\" aria-label=\"Add Sector\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line>\n                <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line>\n              </svg>\n              Add New Sector\n            </button>\n            <p class=\"add-sector-hint\">Add up to 4 sectors (3-sector or 4-sector tower). Each sector can have multiple carriers.</p>\n          </div>\n\n            <div class=\"sectors-grid\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"editedSite.sectors as sector, sectorIndex\"><div class=\"sector-unit\">\n                  <!-- Sector Header with Visual Indicator -->\n                  <div class=\"sector-unit-header\">\n                    <div class=\"sector-title-section\">\n                      <div class=\"sector-icon\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                          <path d=\"M2 17l10 5 10-5\"></path>\n                          <path d=\"M2 12l10 5 10-5\"></path>\n                        </svg>\n                      </div>\n                      <div class=\"sector-title-info\">\n                        <h4>Sector </h4>\n                        <span class=\"sector-subtitle\">Azimuth: ° |  Carrier</span>\n                        <span class=\"sector-pcis\">Carrier PCIs: :$`).join(', ')}</span>\n                      </div>\n                    </div>\n                    <button\n                      type=\"button\"\n                      class=\"remove-sector-btn\" data-cwl-action=\"removeSector\" data-cwl-action-args=\"sectorIndex\"\n                      title=\"Remove this sector\"\n                    >\n                      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <polyline points=\"3 6 5 6 21 6\"></polyline>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n                      </svg>\n                    </button>\n                  </div>\n\n                  <div class=\"sector-details\">\n                    <!-- Prominent Azimuth Control -->\n                    <div class=\"azimuth-control\">\n                      <div class=\"azimuth-label\">\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <polygon points=\"3 11 22 2 13 21 11 13 3 11\"></polygon>\n                        </svg>\n                        Azimuth Direction\n                      </div>\n                      <div class=\"azimuth-input-group\">\n                        <input\n                          type=\"range\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-slider\"\n                        />\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-number\"\n                        />\n                        <span class=\"azimuth-compass\">\n                          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 337.5 || sector.azimuth < 22.5\">N</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 22.5 && sector.azimuth < 67.5\">NE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 67.5 && sector.azimuth < 112.5\">E</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 112.5 && sector.azimuth < 157.5\">SE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 157.5 && sector.azimuth < 202.5\">S</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 202.5 && sector.azimuth < 247.5\">SW</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 247.5 && sector.azimuth < 292.5\">W</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 292.5 && sector.azimuth < 337.5\">NW</div>\n                        </span>\n                      </div>\n                    </div>\n\n                    <!-- Beamwidth Control -->\n                    <div class=\"beamwidth-control\">\n                      <div class=\"beamwidth-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7v10c0 5.5 3.84 7.66 10 9 6.16-1.34 10-3.5 10-9V7l-10-5z\"></path>\n                        </svg>\n                        Beamwidth (Coverage Angle)\n                      </div>\n                      <div class=\"beamwidth-selector\">\n                        <select= class=\"beamwidth-select\">\n                          <option data-cwl-attr-value=\"33\">33° (Narrow - Directional)</option>\n                          <option data-cwl-attr-value=\"65\">65° (Standard - Macro)</option>\n                          <option data-cwl-attr-value=\"78\">78° (Wide - Coverage)</option>\n                          <option data-cwl-attr-value=\"90\">90° (Very Wide - Small Cell)</option>\n                          <option data-cwl-attr-value=\"120\">120° (Ultra Wide - Omni-like)</option>\n                        </select>\n                        <span class=\"beamwidth-visual\">°</span>\n                      </div>\n                    </div>\n\n                    <!-- Height AGL Control -->\n                    <div class=\"height-control\">\n                      <div class=\"height-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line>\n                          <polyline points=\"8 8 12 4 16 8\"></polyline>\n                          <polyline points=\"8 16 12 20 16 16\"></polyline>\n                        </svg>\n                        Height Above Ground Level\n                      </div>\n                      <div class=\"height-input-group\">\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"2000\"\n                          step=\"1\"\n                          class=\"height-input\"\n                        />\n                        <span class=\"height-unit\">feet</span>\n                      </div>\n                    </div>\n\n                    <div class=\"form-row\">\n                      <div class=\"form-group-sm\">\n                        <label>\n                          RS Power (dBm)\n                          <input\n                            type=\"number\"=\n                            min=\"-120\"\n                            max=\"30\"\n                          />\n                        </label>\n                      </div>\n\n                      <div class=\"form-group-sm\">\n                        <label>\n                          Technology\n                          <select=>\n                            <option value=\"LTE\">LTE (4G)</option>\n                          </select>\n                        </label>\n                      </div>\n                    </div>\n\n                    <div class=\"pci-note\">\n                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                        <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                      </svg>\n                      <span>Each sector transmitter can have multiple carriers. Each carrier needs its own PCI and EARFCN.</span>\n                    </div>\n\n                    <!-- Carriers for this transmitter -->\n                    <div class=\"channels-section\">\n                      <div class=\"channels-header\">\n                        <strong>📻 Carriers</strong>\n                        <span class=\"carrier-info\">Each carrier has its own EARFCN & PCI</span>\n                        <button\n                          type=\"button\"\n                          class=\"add-channel-btn-sm\" data-cwl-action=\"addChannelToSector\" data-cwl-action-args=\"sectorIndex\"\n                         aria-label=\"Add Channel To Sector\">\n                          + Add Carrier\n                        </button>\n                      </div>\n\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sector.channels as channel, channelIndex\"><div class=\"carrier-card\">\n                          <div class=\"carrier-header\">\n                            <div class=\"carrier-number\">Carrier </div>\n                            <div class=\"carrier-primary-select\">\n                              <input\n                                type=\"radio\"\n                                name=\"primary-\" data-cwl-on-change=\"action:setPrimaryChannel\" data-cwl-on-change-args=\"sectorIndex, channelIndex\"\n                                title=\"Primary carrier\"\n                                id=\"primary--\"\n                              />\n                              <label for=\"primary--\" class=\"primary-label\">\n\n                              </label>\n                            </div>\n                            <button\n                              type=\"button\"\n                              class=\"remove-channel-btn\" data-cwl-action=\"removeChannel\" data-cwl-action-args=\"sectorIndex, channelIndex\" title=\"Remove carrier\"\n                            >\n                              ×\n                            </button>\n                          </div>\n\n                          <div class=\"carrier-details\">\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"earfcn--\">EARFCN DL</label>\n                              <input\n                                type=\"number\"\n                                id=\"earfcn--\"=\n                                placeholder=\"55640\"\n                                class=\"carrier-input\"\n                                min=\"55240\"\n                                max=\"56739\"\n                                title=\"Band 48: 55240-56739\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"bw--\">Bandwidth</label>\n                              <select id=\"bw--\"= class=\"carrier-select\">\n                                <option data-cwl-attr-value=\"10\">10 MHz</option>\n                                <option data-cwl-attr-value=\"15\">15 MHz</option>\n                                <option data-cwl-attr-value=\"20\">20 MHz</option>\n                              </select>\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"pci--\">PCI</label>\n                              <input\n                                type=\"number\"\n                                id=\"pci--\"=\n                                placeholder=\"0\"\n                                class=\"carrier-input-sm\"\n                                min=\"0\"\n                                max=\"503\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <span class=\"freq-display\"> MHz</span>\n                            </div>\n                          </div>\n                        </div></div>\n                    </div>\n                  </div>\n                </div></div>\n            </div>\n\n            <div hidden aria-hidden=\"true\"><p class=\"empty-message\">\n              📍 No sectors configured yet.<br/>\n              Click \"Add New Sector\" above to create your first sector.\n            </p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"editor-footer\">\n        <button type=\"button\" class=\"cancel-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n        <button type=\"button\" class=\"save-btn\" data-cwl-action=\"handleSave\" aria-label=\"Save\">\n\n            💾 Save Changes\n\n        </button>\n      </div>\n    </div>\n  </div></div></div>\n\n  <div data-cwl-component=\"ContextMenu\" data-cwl-lifted-component=\"ContextMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showContextMenu\" hidden aria-hidden=\"true\"><!-- Invisible backdrop to close menu -->\n  <div\n    class=\"context-backdrop\"\n    role=\"presentation\" data-cwl-action=\"handleBackdropClick\" data-cwl-on-keydown=\"action:handleBackdropClick\"\n  ></div>\n\n  <!-- Context menu -->\n  <div class=\"context-menu\" style=\"left: px; top: px;\">\n\n    <!-- Always show add options -->\n    <button class=\"menu-item primary\" data-cwl-action=\"handleAddSite\" aria-label=\"Add Site\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n        <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n        <line x1=\"12\" y1=\"7\" x2=\"12\" y2=\"13\"></line>\n        <line x1=\"9\" y1=\"10\" x2=\"15\" y2=\"10\"></line>\n      </svg>\n      Add Cell Site Manually\n    </button>\n\n    <button class=\"menu-item\" data-cwl-action=\"handleImport\" aria-label=\"Import\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n        <polyline points=\"17 8 12 3 7 8\"></polyline>\n        <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n      </svg>\n      Import from CSV/KML\n    </button>\n  </div></div></div>\n\n  <div data-cwl-component=\"TowerManager\" data-cwl-lifted-component=\"TowerManager\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showTowerManager\" hidden aria-hidden=\"true\"><div\n    class=\"tower-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n  >\n    <div\n      class=\"tower-modal\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"tower-manager-modal-title\"\n    >\n      <div class=\"tower-header\">\n        <div class=\"header-title\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n            <polyline points=\"2 17 12 22 22 17\"></polyline>\n            <polyline points=\"2 12 12 17 22 12\"></polyline>\n          </svg>\n          <h2 id=\"tower-manager-modal-title\">Tower Management</h2>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"$currentNetwork\"><span class=\"network-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$currentNetwork.name\"></span></span></div>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tower-body\">\n        <!-- Search and Actions Bar -->\n        <div class=\"actions-bar\">\n          <div class=\"search-box\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n              <path d=\"m21 21-4.35-4.35\"></path>\n            </svg>\n            <input\n              type=\"text\"\n              placeholder=\"Search towers by eNodeB or sector ID...\"\n            />\n          </div>\n          <button class=\"add-tower-btn\" data-cwl-toggle=\"showSiteEditor:true\" aria-label=\"Show Site Editor\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            </svg>\n            Add Tower\n          </button>\n        </div>\n\n        <!-- Tower Stats -->\n        <div class=\"tower-stats\">\n          <div class=\"stat-card\">\n            <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"towers.length\"></span></span>\n            <span class=\"stat-label\">Towers</span>\n          </div>\n          <div class=\"stat-card\">\n            <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"towers.reduce((sum, t) => sum + t.sectorCount, 0)\"></span></span>\n            <span class=\"stat-label\">Sectors</span>\n          </div>\n          <div class=\"stat-card\">\n            <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"$cellsStore.items.length\"></span></span>\n            <span class=\"stat-label\">Carriers</span>\n          </div>\n        </div>\n\n        <!-- Tower List -->\n        <div class=\"tower-list\">\n\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredTowers as tower (tower.eNodeB)\" data-cwl-each-item=\"tower\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tower-card%22%20class%3Aexpanded%3D%7BexpandedTowerId%20%3D%3D%3D%20tower.eNodeB.toString()%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22tower-card-header%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20tabindex%3D%220%22%20data-cwl-action%3D%22toggleExpand%22%20data-cwl-action-args%3D%22tower.eNodeB%22%20data-cwl-on-keydown%3D%22action%3AtoggleExpand%22%20data-cwl-on-keydown-args%3D%22tower.eNodeB%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tower-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tower-icon%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csvg%20width%3D%2220%22%20height%3D%2220%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cpath%20d%3D%22M12%202L2%207l10%205%2010-5-10-5z%22%3E%3C%2Fpath%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cpolyline%20points%3D%222%2017%2012%2022%2022%2017%22%3E%3C%2Fpolyline%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cpolyline%20points%3D%222%2012%2012%2017%2022%2012%22%3E%3C%2Fpolyline%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fsvg%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tower-details%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3ETower%20%7Btower.eNodeB%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tower-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22meta-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csvg%20width%3D%2214%22%20height%3D%2214%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccircle%20cx%3D%2212%22%2