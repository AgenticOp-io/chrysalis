  load { source: "wisp-m31", path: "/modules/inventory", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"inventory-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n        <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📦 Inventory Management</h1>\n      <p class=\"subtitle\">Centralized asset tracking and management</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\"}>\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\"}>\n        📥 Scan Check In\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n      />\n      <button class=\"btn-secondary\"}>\n        📤 Scan Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        🔍 Manual Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 View Reports\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn-primary\">\n        ➕ Add Item\n      </button>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📦</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Items</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\">\n          12\n        </div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\">\n          \n        </div>\n        <div class=\"stat-label\">Deployed</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\">$25000.00</div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer...\"\n        />\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        \n      </select>\n      \n      <button class=\"btn-primary\">Apply</button>\n      <button class=\"btn-secondary\">Clear</button>\n    </div>\n  </div>\n  \n  <!-- Loading State -->\n  \n    <!-- Inventory Table -->\n    <div class=\"table-container\">\n      <table class=\"inventory-table\">\n        <thead>\n          <tr>\n            <th>Asset Tag</th>\n            <th>Category</th>\n            <th>Type</th>\n            <th>Manufacturer</th>\n            <th>Model</th>\n            <th>Serial Number</th>\n            <th>Status</th>\n            <th>Condition</th>\n            <th>Location</th>\n            <th>Last Updated</th>\n            <th>Actions</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n    \n    <!-- Pagination -->\n    <div class=\"pagination\">\n        <button \n          class=\"btn-secondary\"\n        >\n          ← Previous\n        </button>\n        \n        <span class=\"pagination-info\">\n          Page 1 of 2 \n          (24 items)\n        </span>\n        \n        <button \n          class=\"btn-secondary\"\n        >\n          Next →\n        </button>\n      </div>\n  \n  \n  <!-- Manual Barcode Entry Modal -->\n  \n\n  <!-- Asset Tag Viewer -->\n  \n  \n  <!-- Scan Modal -->\n  \n  \n  <!-- Check-in Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"InventoryCheckInWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  <!-- RMA Tracking Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"RMATrackingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n</div>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

