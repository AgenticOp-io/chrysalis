@page GET "/help"
page help_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/help" };
  return html "<div class=\"wisp-docs-shell wisp-demo-content\" data-wisp-page=\"help\" data-wisp-path=\"/help\" data-cwl-island=\"client\" data-wisp-layout=\"docs\">\n  <header class=\"wisp-docs-topbar\">\n    <nav class=\"wisp-docs-crumb\" aria-label=\"Documentation\">\n      <a href=\"/dashboard\">Dashboard</a>\n      <span aria-hidden=\"true\">/</span>\n      <a href=\"/help\">Help</a>\n      <span aria-hidden=\"true\">/</span>\n      <span>Help</span>\n    </nav>\n  </header>\n  <main class=\"wisp-docs-main\">\n    <div class=\"wisp-docs-body\">\n  <section class=\"wisp-docs-hero\">\n    <p class=\"wisp-docs-eyebrow\">WISP Management · GCE demo</p>\n    <h2>WISP Management Help</h2>\n    <p class=\"wisp-docs-lead\">Pure CWL chimera with native API handlers. Operational modules integrate with the HSS backend when configured.</p>\n  </section>\n  <section class=\"wisp-docs-section\">\n    <h3 class=\"wisp-docs-section-title\">Quick start</h3>\n    <div class=\"wisp-docs-quick-grid\">\n  <a class=\"wisp-docs-quick-card\" href=\"/docs/getting-started\">\n    <span class=\"wisp-docs-quick-label\">Getting started</span>\n    <span class=\"wisp-docs-quick-desc\">Install Chrysalis and run your first verify loop</span>\n  </a>\n  <a class=\"wisp-docs-quick-card\" href=\"/docs/deployment\">\n    <span class=\"wisp-docs-quick-label\">Deployment</span>\n    <span class=\"wisp-docs-quick-desc\">GCE hub deploy, WISP chimera, operator refresh</span>\n  </a>\n  <a class=\"wisp-docs-quick-card\" href=\"/docs/reference/project-status\">\n    <span class=\"wisp-docs-quick-label\">Project status</span>\n    <span class=\"wisp-docs-quick-desc\">Maintenance queue and honest product gaps</span>\n  </a>\n  <a class=\"wisp-docs-quick-card\" href=\"https://hub.agenticop.io/#/guide?doc=migration-os\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"wisp-docs-quick-label\">Migration OS</span>\n    <span class=\"wisp-docs-quick-desc\">Primary operator entry on the Translation Hub</span>\n  </a>\n</div>\n  </section>\n  <section class=\"wisp-docs-section wisp-docs-section-split\">\n    <div class=\"wisp-docs-panel\">\n      <h3 class=\"wisp-docs-section-title\">This deployment</h3>\n      <ul class=\"wisp-docs-checklist\">\n        <li>Session auth via Firebase or CWL session preview</li>\n        <li>Native CWL API handlers; HSS at <code>https://hss.wisptools.io</code> when proxied</li>\n        <li>Plan, Deploy, and Coverage Map — ArcGIS charter surfaces</li>\n        <li>Verify: <code>pnpm run wisp:verify:demo -- --base-url http://HOST:19100</code></li>\n      </ul>\n      <p class=\"wisp-docs-inline-links\"><a href=\"/dashboard\">Dashboard</a> · <a href=\"/login\">Login</a> · <a href=\"/docs\">Documentation home</a></p>\n    </div>\n    <div class=\"wisp-docs-panel wisp-docs-panel-accent\">\n      <h3 class=\"wisp-docs-section-title\">Demo shortcuts</h3>\n      <ul class=\"wisp-docs-linklist\">\n        <li><a href=\"/docs/getting-started\">Getting started</a></li>\n        <li><a href=\"/docs/deployment\">Deployment &amp; refresh</a></li>\n        <li><a href=\"/docs/reference/project-status\">Project status</a></li>\n      </ul>\n    </div>\n  </section>\n  <section class=\"wisp-docs-section\">\n    <h3 class=\"wisp-docs-section-title\">Chrysalis operator library</h3>\n    <div class=\"wisp-docs-library\">\n<div class=\"wisp-docs-library-head\">\n<p class=\"wisp-docs-library-lead\">Browse on this page or open the full reader on the Translation Hub.</p>\n<a class=\"wisp-docs-hub-cta\" href=\"https://hub.agenticop.io/#/guide\" target=\"_blank\" rel=\"noopener\">Open full library in Translation Hub</a>\n</div>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Migration OS</span><span class=\"wisp-docs-count\">15</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=migration-os\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Migration OS</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=site-to-cwl-llm\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Site → CWL → LLM</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=site-port-federation\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Verified Migration Federation</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=migration-evidence\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Migration Evidence POC</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=intelligence-shorthand\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Intelligence Shorthand</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=intelligence-shorthand-protocol\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">IS runtime protocol</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=open-web-llm\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Open web-LLM program</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=open-web-llm-poc\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Web-LLM agent POC</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=llm-assisted-convert\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">LLM-assisted convert</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=llm-convert-full\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">LLM convert full program</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=full-matrix-oracle\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Full matrix oracle</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=web-llm-training\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Web-LLM training recipe</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=web-verify-benchmark\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Web Verify Benchmark (WVB)</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=cwl\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">CWL overview</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=cwl-rfc\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">CWL RFC index</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Hub</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=hub-install\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Demo install &amp; walkthrough</span><span class=\"wisp-docs-card-meta\">Hub</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=hub-connectivity\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">SSH &amp; connectivity</span><span class=\"wisp-docs-card-meta\">Hub</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=hub-server-install\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Hub server install</span><span class=\"wisp-docs-card-meta\">Hub</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Engine &amp; CLI</span><span class=\"wisp-docs-count\">11</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=whitepaper\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Whitepaper</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=use-cases\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Use cases</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=installation\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Installation</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=user-guide\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">User guide (CLI)</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=how-to\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">How-to cookbook</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=operations\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Operations</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=deployment\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Deployment</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=administration\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Administration</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=gce-local-verify\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">GCE test runner</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=gce-gpu-lab\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">GCE GPU lab</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=windows-compat\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Windows vs Linux</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Governance</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=strategic-plan\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Strategic plan (locked)</span><span class=\"wisp-docs-card-meta\">Governance</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=paused-and-maintenance\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Paused &amp; maintenance index</span><span class=\"wisp-docs-card-meta\">Governance</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=roadmap\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Roadmap (active)</span><span class=\"wisp-docs-card-meta\">Governance</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>WISP showcase</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=wisp-cwl-fullstack\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WISP CWL fullstack program</span><span class=\"wisp-docs-card-meta\">WISP showcase</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=wisp-cwl-ui-parity\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WISP CWL UI parity</span><span class=\"wisp-docs-card-meta\">WISP showcase</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=wisp-production\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WISP production completion</span><span class=\"wisp-docs-card-meta\">WISP showcase</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Hub &amp; commercial</span><span class=\"wisp-docs-count\">4</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=commercial\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Commercial offering</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=agenticop\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">AgenticOp practice</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=github-project\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">GitHub Project</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=multi-repo-workspace\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Multi-repo workspace</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Architecture</span><span class=\"wisp-docs-count\">4</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=design\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">DESIGN.md</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=agents\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">AGENTS.md</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=roadmap-archive\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Roadmap archive</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=docs-index\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Documentation index</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Archive</span><span class=\"wisp-docs-count\">4</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=archive-index\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Archive index</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=strategic-plan-shipped-log\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Strategic plan ship log</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=cwl-fullstack-build-log\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">CWL full-stack build log</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=master-program\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WPTP master program</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Community</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=code-of-conduct\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Code of conduct</span><span class=\"wisp-docs-card-meta\">Community</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=contributing\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Contributing</span><span class=\"wisp-docs-card-meta\">Community</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=security\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Security</span><span class=\"wisp-docs-card-meta\">Community</span></a>\n</div></details>\n</div>\n  </section>\n</div>\n  </main>\n</div>";
}

@page GET "/login"
page login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  use auth session;
  load { surface: "wisp-auth-native", source: "wisp-30", profile: "gce-single-use" };
  return html "<div class=\"login-page\" data-wisp-page=\"login\" data-cwl-island=\"client\">\n  <div class=\"login-container\">\n    <div class=\"login-brand\">\n      <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"brand-logo\" width=\"120\" height=\"120\" />\n      <h1>WISPTools Demo ISP</h1>\n    </div>\n    <div class=\"login-card\">\n      <h2>Sign in</h2>\n      <div class=\"demo-credentials-panel\" role=\"note\">\n        <p class=\"demo-credentials-title\">Demo login (Firebase <code>wisptools-production</code>)</p>\n        <p><strong>Email:</strong> demo@wisptools.io</p>\n        <p><strong>Password:</strong> WisptoolsDemo2026!</p>\n        <p class=\"demo-credentials-hint\">Use the GCE demo URL for this deployment.</p>\n      </div>\n      <p class=\"subtitle\">Use your email and password to access WISPTools Demo ISP.</p>\n      <div id=\"wisp-cwl-status\" class=\"wisp-status\" hidden aria-live=\"polite\"></div>\n      <form id=\"login-form\" autocomplete=\"on\">\n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input id=\"email\" name=\"email\" type=\"email\" value=\"demo@wisptools.io\" placeholder=\"you@example.com\" required />\n        </div>\n        <div class=\"form-group\">\n          <label for=\"password\">Password</label>\n          <input id=\"password\" name=\"password\" type=\"password\" placeholder=\"Enter your password\" required />\n        </div>\n        <button type=\"submit\" class=\"btn-primary\" id=\"sign-in\">Sign In</button>\n      </form>\n      <p class=\"form-footer simple-only-hint\">Access is managed by your administrator.</p>\n    </div>\n  </div>\n</div>";
}

@route POST "/login"
handler login_post {
  effects: session.write;
  use auth session;
  header X-Tenant-ID;
  body email;
  body password;
  return { ok: true, surface: "wisp-auth-native" };
}

@route GET "/api/me"
handler session_me {
  effects: session.read;
  use auth session;
  return { ok: true, surface: "wisp-auth-native" };
}

@page GET "/modules"
page modules_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  return html "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta http-equiv=\"refresh\" content=\"0;url=/dashboard\"><title>Redirecting to dashboard…</title></head><body><p>Redirecting to dashboard…</p><script>location.replace(\"/dashboard\");</script><noscript><a href=\"/dashboard\">Continue</a></noscript></body></html>";
}

@page GET "/modules/acs-cpe-management"
page modules_acs_cpe_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"acs-module\">\n  <!-- Main Navigation -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Help Button -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n  \n  <!-- Module Header -->\n  <div class=\"module-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <div class=\"module-info\">\n        <h1 class=\"module-title\">\n          <span class=\"module-icon\">📡</span>\n          Module\n        </h1>\n        <p class=\"module-description\">Showcase module</p>\n        \n        <!-- Multi-Tenant Info -->\n        <div class=\"tenant-badge\">\n            <span class=\"tenant-icon\">🏢</span>\n            <span class=\"tenant-text\">Demo Tenant</span>\n            <span class=\"tenant-label\">Organization</span>\n          </div>\n      </div>\n      \n      <div class=\"module-actions\">\n        \n        \n        \n        \n        <button \n          class=\"btn btn-primary\"\n        >\n          \n        </button>\n\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n        />\n\n        <button \n          class=\"btn btn-primary\"\n        >\n          \n        </button>\n        \n        <button \n          class=\"btn btn-secondary\"\n        >\n          🔄 Refresh View\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Error Display -->\n  \n\n  <!-- Module Content -->\n  <div class=\"module-content\">\n    <!-- CPE Statistics -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card tenant-stat\">\n        <div class=\"stat-icon\">🏢</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">Demo Tenant</div>\n          <div class=\"stat-label\">Current Organization</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📱</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">2</div>\n          <div class=\"stat-label\">Total CPEs</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🟢</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">\n            2\n          </div>\n          <div class=\"stat-label\">Online</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🔴</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">\n            2\n          </div>\n          <div class=\"stat-label\">Offline</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📍</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">\n            2\n          </div>\n          <div class=\"stat-label\">With GPS</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Map Section Placeholder -->\n    <div class=\"map-section\">\n      <div class=\"map-header\">\n        <h3>CPE Device Map</h3>\n        <div class=\"map-controls\">\n          <div class=\"legend\">\n            <div class=\"legend-item\">\n              <span class=\"legend-color online\"></span>\n              <span>Online CPEs</span>\n            </div>\n            <div class=\"legend-item\">\n              <span class=\"legend-color offline\"></span>\n              <span>Offline CPEs</span>\n            </div>\n            <div class=\"legend-item\">\n              <span class=\"legend-color error\"></span>\n              <span>Error CPEs</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"map-container\">\n        <div class=\"arcgis-map\"></div>\n        \n        \n      </div>\n    </div>\n\n    <!-- Performance Analytics Section -->\n    <div class=\"performance-analytics-section\">\n      <div class=\"section-header\">\n        <div class=\"section-title-block\">\n          <h3>📊 Performance Analytics</h3>\n          <p class=\"section-hint\">Monitoring and Graphs are in the sidebar →</p>\n        </div>\n        <div class=\"analytics-controls\">\n          <select class=\"time-select\">\n            <option value=\"1h\">Last Hour</option>\n            <option value=\"6h\">Last 6 Hours</option>\n            <option value=\"24h\">Last 24 Hours</option>\n            <option value=\"7d\">Last 7 Days</option>\n          </select>\n        </div>\n      </div>\n\n      <div class=\"analytics-content\">\n        <!-- Performance Summary Cards (from TR-069 metrics API) -->\n        <div class=\"analytics-grid\">\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📶</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\"></div>\n              <div class=\"metric-label\">Average RSSI</div>\n              \n            </div>\n          </div>\n\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📡</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\">8/10</div>\n              <div class=\"metric-label\">Online CPEs</div>\n              <div class=\"metric-trend positive\">99.2% uptime</div>\n            </div>\n          </div>\n\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">⚡</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\"></div>\n              <div class=\"metric-label\">Signal Quality</div>\n              \n            </div>\n          </div>\n\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">🔄</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\"></div>\n              <div class=\"metric-label\">Avg. Uptime</div>\n              <div class=\"metric-trend neutral\">From device metrics</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Per-device metrics & charts (link to dedicated pages) -->\n        <div class=\"performance-charts\">\n          <div class=\"chart-placeholder chart-cta\">\n            <div class=\"chart-icon\">📈</div>\n            <h4>Per-Device Metrics & Charts</h4>\n            <p>View time-series RSSI, SINR, throughput, and uptime for individual CPE devices.</p>\n            <div class=\"chart-actions\">\n              <a href=\"/modules/acs-cpe-management/monitoring\" class=\"btn btn-primary\">📊 Monitoring</a>\n              <a href=\"/modules/acs-cpe-management/graphs\" class=\"btn btn-secondary\">📈 Graphs</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- CPE Device List -->\n    <div class=\"cpe-list-section\">\n      <div class=\"section-header\">\n        <h3>CPE Device List</h3>\n        <div class=\"list-controls\">\n          <input\n            type=\"text\"\n            placeholder=\"Search CPE devices...\"\n            class=\"search-input\"\n          />\n        </div>\n      </div>\n\n      \n    </div>\n  </div>\n\n  <!-- CPE Performance Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"CPEPerformanceModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n  \n  <!-- Help / Tips Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n  \n  \n  <!-- Device Onboarding Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"DeviceOnboardingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  \n  <!-- Troubleshooting Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"TroubleshootingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Preset Creation Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"PresetCreationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Bulk Operations Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"BulkOperationsWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Firmware Update Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"FirmwareUpdateWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Device Registration Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"DeviceRegistrationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n</div>";
}

@page GET "/modules/acs-cpe-management/alerts"
page modules_acs_cpe_management_alerts_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/alerts", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"alerts-page\">\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <a href=\"/modules/acs-cpe-management\" class=\"back-button\">← Back to ACS Management</a>\n      <h1>🚨 Alert Rules</h1>\n      <p>Configure alerts for ACS device monitoring</p>\n    </div>\n    <button class=\"btn btn-primary\">\n      ➕ Create Alert Rule\n    </button>\n  </div>\n\n  \n\n  \n\n  <!-- Active Alerts -->\n  <div class=\"alerts-section\">\n      <h2>Active Alerts (2)</h2>\n      <div class=\"alerts-list\">\n        <div class=\"alert-item\" style=\"border-left-color: \">\n            <div class=\"alert-header\">\n              <span class=\"alert-severity\" style=\"color: \">\n                \n              </span>\n              <span class=\"alert-time\"></span>\n            </div>\n            <div class=\"alert-message\"></div>\n            \n            \n          </div><div class=\"alert-item\" style=\"border-left-color: \">\n            <div class=\"alert-header\">\n              <span class=\"alert-severity\" style=\"color: \">\n                \n              </span>\n              <span class=\"alert-time\"></span>\n            </div>\n            <div class=\"alert-message\"></div>\n            \n            \n          </div>\n      </div>\n    </div>\n\n  <!-- Alert Rules -->\n  \n</div>\n\n<!-- Create/Edit Modal -->\n";
}

@page GET "/modules/acs-cpe-management/devices"
page modules_acs_cpe_management_devices_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/devices", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"devices-page\">\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Page Header -->\n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <h1 class=\"page-title\">\n        <span class=\"page-icon\">📱</span>\n        CPE Device Management\n      </h1>\n      <p class=\"page-description\">\n        Manage TR-069 enabled CPE devices with remote control capabilities\n      </p>\n    </div>\n    <div class=\"header-actions\">\n      <button class=\"btn btn-primary\">\n        \n          🔄\n        \n        Refresh\n      </button>\n    </div>\n  </div>\n\n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-item\">\n      <span class=\"stat-icon\">📊</span>\n      <span class=\"stat-value\"></span>\n      <span class=\"stat-label\">Total</span>\n    </div>\n    <div class=\"stat-item online\">\n      <span class=\"stat-icon\">🟢</span>\n      <span class=\"stat-value\">8</span>\n      <span class=\"stat-label\">Online</span>\n    </div>\n    <div class=\"stat-item offline\">\n      <span class=\"stat-icon\">🔴</span>\n      <span class=\"stat-value\">2</span>\n      <span class=\"stat-label\">Offline</span>\n    </div>\n    <div class=\"stat-item\">\n      <span class=\"stat-icon\">📈</span>\n      <span class=\"stat-value\">1</span>\n      <span class=\"stat-label\">Shown</span>\n    </div>\n  </div>\n\n  <!-- Filters -->\n  <div class=\"filters-bar\">\n    <div class=\"filter-group\">\n      <input\n        type=\"text\"\n        placeholder=\"Search devices...\"\n        class=\"search-input\"\n      />\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option value=\"all\">All Status</option>\n        <option value=\"online\">Online</option>\n        <option value=\"offline\">Offline</option>\n      </select>\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option>All Tags</option>\n        <option></option><option></option>\n      </select>\n    </div>\n    <button \n      class=\"btn btn-secondary btn-sm\"\n    >\n      ▶ Advanced Filters\n    </button>\n    <button \n      class=\"btn btn-secondary btn-sm\"\n    >\n      Clear Filters\n    </button>\n  </div>\n\n  \n\n  <!-- Bulk Actions Bar -->\n  \n\n  <!-- Devices Table -->\n  <div class=\"devices-table-container\">\n    <table class=\"devices-table\">\n      <thead>\n        <tr>\n          <th class=\"col-select\">\n            <input\n              type=\"checkbox\"\n              class=\"select-all-checkbox\"\n            />\n          </th>\n          <th class=\"col-expand\"></th>\n          <th class=\"col-status\">Status</th>\n          <th class=\"col-device-id\">Device ID</th>\n          <th class=\"col-manufacturer\">Manufacturer</th>\n          <th class=\"col-model\">Model</th>\n          <th class=\"col-serial\">Serial Number</th>\n          <th class=\"col-ip\">IP Address</th>\n          <th class=\"col-firmware\">Firmware</th>\n          <th class=\"col-contact\">Last Contact</th>\n          <th class=\"col-tags\">Tags</th>\n          <th class=\"col-actions\">Actions</th>\n        </tr>\n      </thead>\n      <tbody>\n        \n          <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"CPEDeviceRow\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>cpe-1</td><td>online</td></tr><tr><td>cpe-2</td><td>degraded</td></tr></tbody></table></div> toggleSelectDevice(e.detail.id)}/>\n        \n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- TR-069 Actions Modal -->\n\n\n\n\n<!-- Preset Selection Modal -->\n\n\n<!-- Edit Device Tags Modal -->\n";
}

@page GET "/modules/acs-cpe-management/faults"
page modules_acs_cpe_management_faults_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/faults", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"faults-page\">\n  <!-- Main Navigation -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Page Header -->\n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <h1 class=\"page-title\">\n        <span class=\"page-icon\">⚠️</span>\n        Device Faults\n      </h1>\n      <p class=\"page-description\">\n        Monitor and manage device faults and errors\n      </p>\n    </div>\n    <div class=\"header-actions\">\n      <a href=\"/modules/acs-cpe-management/admin/database\" class=\"btn btn-secondary\">\n        <span class=\"btn-icon\">🗂️</span>\n        Initialize Faults in Database\n      </a>\n      <button class=\"btn btn-primary\">\n        <span class=\"btn-icon\">🔄</span>\n        Refresh\n      </button>\n    </div>\n  </div>\n\n  <!-- Fault Statistics -->\n  <div class=\"stats-section\">\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📊</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">4</div>\n          <div class=\"stat-label\">Total Faults</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🔴</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">2</div>\n          <div class=\"stat-label\">Open</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🟢</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">2</div>\n          <div class=\"stat-label\">Resolved</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🚨</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">1</div>\n          <div class=\"stat-label\">Critical</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filter-group\">\n      <input \n        type=\"text\" \n        placeholder=\"Search faults...\"\n        class=\"search-input\"\n      />\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option value=\"all\">All Severities</option>\n        <option value=\"Critical\">Critical</option>\n        <option value=\"Warning\">Warning</option>\n        <option value=\"Info\">Info</option>\n      </select>\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option value=\"all\">All Status</option>\n        <option value=\"Open\">Open</option>\n        <option value=\"Resolved\">Resolved</option>\n      </select>\n    </div>\n  </div>\n\n  <!-- Faults List -->\n  <div class=\"faults-container\">\n    \n      <div class=\"faults-list\">\n        <div class=\"fault-card\">\n            <div class=\"fault-header\">\n              <div class=\"fault-info\">\n                <h3 class=\"fault-id\"></h3>\n                <p class=\"fault-device\"></p>\n              </div>\n              <div class=\"fault-badges\">\n                <span class=\"severity-badge\">\n                  \n                </span>\n                <span class=\"status-badge\">\n                  \n                </span>\n              </div>\n            </div>\n            \n            <div class=\"fault-content\">\n              <div class=\"fault-message\">\n                <strong>Error :</strong> \n              </div>\n              <div class=\"fault-description\">\n                \n              </div>\n              <div class=\"fault-meta\">\n                <span class=\"meta-item\">\n                  <strong>Timestamp:</strong> \n                </span>\n                \n              </div>\n            </div>\n            \n            <div class=\"fault-actions\">\n              <button class=\"btn btn-sm btn-primary\">\n                View Details\n              </button>\n              \n              <button class=\"btn btn-sm btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div>\n      </div>\n    \n  </div>\n</div>\n\n<!-- Fault Details Modal -->\n";
}

@page GET "/modules/acs-cpe-management/files"
page modules_acs_cpe_management_files_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/files", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"files-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to ACS Management\n      </button>\n      <h1>📁 File Management</h1>\n      <p class=\"subtitle\">Demo Tenant - Firmware & Configuration Files</p>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Upload Section -->\n  <div class=\"upload-section\">\n    <h2>📤 Upload File</h2>\n    <p class=\"section-subtitle\">Upload firmware images or configuration files for CPE devices</p>\n\n    <div class=\"upload-form\">\n      <div class=\"form-group\">\n        <label for=\"file-input\">Select File</label>\n        <input\n          id=\"file-input\"\n          type=\"file\"\n          accept=\".bin,.img,.tar,.gz,.zip,.xml,.json\"\n        />\n        \n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"file-type\">File Type</label>\n        <select id=\"file-type\">\n          \n        </select>\n        <p class=\"help-text\">TR-069 FileType parameter for Download RPC</p>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"description\">Description (Optional)</label>\n        <input\n          id=\"description\"\n          type=\"text\"\n          placeholder=\"e.g., Firmware v2.4.1 for Nokia devices\"\n        />\n      </div>\n\n      <button \n        class=\"btn-primary\"\n      >\n        \n      </button>\n    </div>\n  </div>\n\n  <!-- TR-069 Download Method Info -->\n  <div class=\"info-panel\">\n    <h2>📚 TR-069 Firmware Upgrade Methods</h2>\n    \n    <div class=\"method-card recommended\">\n      <div class=\"method-header\">\n        <h3>✅ Recommended: URL-based Download</h3>\n        <span class=\"badge\">Best Practice</span>\n      </div>\n      <p>Use TR-069 <code>Download</code> RPC with file URL from GenieACS File Server</p>\n      \n      <div class=\"method-details\">\n        <h4>How it Works:</h4>\n        <ol>\n          <li>Upload firmware file to File Server (this page)</li>\n          <li>File stored in GenieACS FS (MongoDB GridFS)</li>\n          <li>System generates URL: <code>http://your-domain.com/fs/{filename}</code></li>\n          <li>Create Download task in Presets or manually</li>\n          <li>CPE downloads file from URL and installs</li>\n        </ol>\n\n        <h4>Task Parameters:</h4>\n        <div class=\"code-block\">\n          Task Name: download<br/>\n          File Type: 1 (Firmware Upgrade Image)<br/>\n          URL: http://your-domain.com/fs/firmware-v2.4.1.bin<br/>\n          Username: (optional - if auth required)<br/>\n          Password: (optional - if auth required)\n        </div>\n\n        <h4>Advantages:</h4>\n        <ul>\n          <li>✅ Standardized TR-069 method</li>\n          <li>✅ Works with all TR-069 compliant devices</li>\n          <li>✅ Can use HTTPS for security</li>\n          <li>✅ Progress tracking available</li>\n          <li>✅ Can schedule downloads</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"method-card\">\n      <div class=\"method-header\">\n        <h3>Alternative: ScheduleDownload RPC</h3>\n      </div>\n      <p>Schedule firmware download for specific time (maintenance window)</p>\n      \n      <div class=\"method-details\">\n        <h4>Use Case:</h4>\n        <p>When you want to upgrade devices at night or during low-traffic periods</p>\n        \n        <h4>Parameters:</h4>\n        <ul>\n          <li>FileType, URL (same as Download)</li>\n          <li>TimeWindow: Start and end time</li>\n          <li>CPE downloads during specified window</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"method-card\">\n      <div class=\"method-header\">\n        <h3>Vendor Specific Methods</h3>\n      </div>\n      <p>Some vendors (Huawei, Nokia, ZTE) have custom upgrade methods</p>\n      \n      <div class=\"method-details\">\n        <h4>Examples:</h4>\n        <ul>\n          <li>X_HUAWEI_Download</li>\n          <li>X_NOKIA_SoftwareUpgrade</li>\n          <li>X_ZTE_FirmwareUpgrade</li>\n        </ul>\n        \n        <p class=\"warning\">⚠️ Not recommended - vendor lock-in and not standardized</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Quick Start Guide -->\n  <div class=\"info-panel\">\n    <h2>🚀 Quick Start: Firmware Upgrade</h2>\n    \n    <div class=\"steps-grid\">\n      <div class=\"step-card\">\n        <div class=\"step-number\">1</div>\n        <h3>Upload Firmware</h3>\n        <p>Upload firmware file using the form above</p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-number\">2</div>\n        <h3>Note the URL</h3>\n        <p>File Server URL: <code>http://domain:7567/{filename}</code></p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-number\">3</div>\n        <h3>Create Preset or Task</h3>\n        <p>Go to Presets/Admin → Create Download task</p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-number\">4</div>\n        <h3>Apply to Devices</h3>\n        <p>Task executes on next device inform</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Current Implementation Notice -->\n  <div class=\"notice-panel\">\n    <h3>🔧 Implementation Status</h3>\n    <p><strong>File Server Setup Required:</strong></p>\n    <ul>\n      <li>GenieACS File Server must be running on backend</li>\n      <li>Configure <code>FS_HOSTNAME</code> in GenieACS config</li>\n      <li>Ensure port 7567 is accessible</li>\n      <li>Files stored in MongoDB GridFS per tenant</li>\n    </ul>\n    \n    <p><strong>For Now:</strong></p>\n    <p>You can manually upload files to the GenieACS File Server via:</p>\n    <div class=\"code-block\">\n      # Via HTTP PUT<br/>\n      curl -T firmware.bin http://your-server:7567/firmware-v2.4.1.bin\n    </div>\n    \n    <p>Then use the URL in Download tasks: <code>http://your-server:7567/firmware-v2.4.1.bin</code></p>\n  </div>\n</div>";
}

@page GET "/modules/acs-cpe-management/firmware"
page modules_acs_cpe_management_firmware_page {
  effects: session.read;
