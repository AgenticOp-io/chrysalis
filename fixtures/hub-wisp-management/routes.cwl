}

@page GET "/help"
page help_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/help" };
  return html "<div class=\"help-container\">\n  <div class=\"help-header\">\n    <button type=\"button\" class=\"help-back-link\" title=\"Back to main app\">← Back to main app</button>\n    <div class=\"help-header-brand\">\n      <div class=\"help-logo-section\">\n        <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"help-logo\" />\n        <div class=\"help-branding\">\n          <h1 class=\"help-app-title\">WISP Management</h1>\n          <p class=\"help-app-subtitle\">Documentation</p>\n        </div>\n      </div>\n    </div>\n    <p class=\"help-header-desc\">Complete guide to using the platform. Use the Help button in each module for context-specific tips.</p>\n    <p class=\"help-docs-link\"><a href=\"/docs\">Reference &amp; Project Status → /docs</a></p>\n  </div>\n  \n  <div class=\"help-layout\">\n    <aside class=\"help-sidebar\">\n      <nav>\n        <button\n            class=\"topic-btn\">\n            <span class=\"topic-title\"></span>\n          </button>\n      </nav>\n    </aside>\n    \n    <main class=\"help-content\">\n      <article>\n          <h2>Welcome to WISP Multitool</h2>\n          <p class=\"lead\">Your complete wireless ISP management platform.</p>\n          \n          <section>\n            <h3>What is WISP Multitool?</h3>\n            <p><strong>WISP Multitool</strong> is an all-in-one platform designed for wireless Internet service providers (WISPs) to manage every aspect of their operations:</p>\n            \n            <ul>\n              <li><strong>Network Planning</strong> - PCI resolution, CBRS spectrum, coverage mapping</li>\n              <li><strong>Field Operations</strong> - Mobile app for technicians, work orders, inventory</li>\n              <li><strong>Customer Support</strong> - Help desk ticketing, subscriber management</li>\n              <li><strong>Customers & Portal</strong> - Customer records, branded customer portal, billing, support tickets</li>\n              <li><strong>Device Management</strong> - ACS/TR-069 CPE management, HSS subscriber auth</li>\n              <li><strong>Team Management</strong> - Role-based access, user invitations, permissions</li>\n              <li><strong>Wizards & Quick Tips</strong> - Guided wizards (site deployment, subscribers, RMA, onboarding) and in-module help</li>\n            </ul>\n          </section>\n          \n          <section>\n            <h3>Platform Components</h3>\n            \n            <div class=\"component-grid\">\n              <div class=\"component-card\">\n                <div class=\"component-icon\">🌐</div>\n                <h4>Web Platform</h4>\n                <p>Browser-based management console for administrators, engineers, and support staff.</p>\n              </div>\n              \n              <div class=\"component-card\">\n                <div class=\"component-icon\">📱</div>\n                <h4>Mobile App</h4>\n                <p>Android app for field technicians with work orders, equipment scanning, and GPS navigation.</p>\n              </div>\n              \n              <div class=\"component-card\">\n                <div class=\"component-icon\">☁️</div>\n                <h4>Cloud Backend</h4>\n                <p>Scalable cloud backend for APIs, push notifications, and data storage.</p>\n              </div>\n            </div>\n          </section>\n          \n          <section>\n            <h3>Who Uses WISP Multitool?</h3>\n            \n            <div class=\"role-cards\">\n              <div class=\"role-card\">\n                <h4>🏢 Owner / Admin</h4>\n                <p>Manage users, configure system, view all modules, control organization settings.</p>\n              </div>\n              \n              <div class=\"role-card\">\n                <h4>👷 Network Engineer</h4>\n                <p>Plan network coverage, configure CBRS, manage HSS subscribers, optimize PCI.</p>\n              </div>\n              \n              <div class=\"role-card\">\n                <h4>🔧 Field Technician</h4>\n                <p>Use mobile app for work orders, equipment deployment, inventory checkout, site visits.</p>\n              </div>\n              \n              <div class=\"role-card\">\n                <h4>🎧 Help Desk</h4>\n                <p>Create support tickets, assist customers, lookup subscribers, troubleshoot CPE devices.</p>\n              </div>\n            </div>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🚀 Getting Started</h2>\n          \n          <section>\n            <h3>1. First Login</h3>\n            <ol>\n              <li>Navigate to the platform URL</li>\n              <li>Click <strong>\"Sign in with Google\"</strong></li>\n              <li>Authorize with your Google account</li>\n              <li>Select or create your organization (tenant)</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>2. Dashboard Overview</h3>\n            <p>After login, you'll see the main dashboard with module cards and a header with:</p>\n            <ul>\n              <li><strong>Docs</strong> (top right) - Opens this help page</li>\n              <li><strong>Settings</strong> - Theme (light/dark), branding, module access, tenant options</li>\n              <li><strong>Notifications</strong> - In-app and optional browser notifications (enable in the panel)</li>\n              <li><strong>Quick access</strong> dropdown - Jump to wizards (Plan, Deploy, CBRS, Customers, HSS, Inventory, etc.)</li>\n            </ul>\n            <p>Module cards include: <strong>PCI Resolution</strong>, <strong>CBRS Management</strong>, <strong>ACS CPE Management</strong>, <strong>HSS Management</strong>, <strong>Coverage Map</strong>, <strong>Inventory</strong>, <strong>Work Orders</strong>, <strong>Help Desk</strong>, <strong>Customers</strong>, <strong>User Management</strong>, and more.</p>\n            <p><em>Note: Available modules depend on your user role and tenant configuration. First-time visitors see quick tips (Field App, Docs, Quick access).</em></p>\n          </section>\n          \n          <section>\n            <h3>3. Inviting Team Members</h3>\n            <ol>\n              <li>Go to <strong>User Management</strong> module</li>\n              <li>Click <strong>\"Invite User\"</strong></li>\n              <li>Enter email address</li>\n              <li>Select role (Admin, Engineer, Installer, Help Desk, Viewer)</li>\n              <li>Click <strong>\"Send Invitation\"</strong></li>\n              <li>User receives email and can accept invitation</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>4. Mobile App Setup</h3>\n            <p><strong>For Field Technicians:</strong></p>\n            <ol>\n              <li>Install <strong>WISP Multitool</strong> APK on Android device</li>\n              <li>Open app and grant permissions (Camera, Location, Notifications)</li>\n              <li>Login with same Google account as web platform</li>\n              <li>Select your organization</li>\n              <li>Start receiving work orders!</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>👥 User Management</h2>\n          <p class=\"lead\">Manage your team members, roles, and permissions.</p>\n          \n          <section>\n            <h3>Inviting Users</h3>\n            <ol>\n              <li>Navigate to <code>/modules/user-management</code></li>\n              <li>Click <strong>\"Invite User\"</strong> button</li>\n              <li>Enter user's email address</li>\n              <li>Select appropriate role:\n                <ul>\n                  <li><strong>Admin</strong> - Can manage users and configure modules</li>\n                  <li><strong>Engineer</strong> - Access to technical/network modules</li>\n                  <li><strong>Field Technician</strong> - Mobile app and field operations</li>\n                  <li><strong>Help Desk</strong> - Customer support and ticketing</li>\n                  <li><strong>Viewer</strong> - Read-only access to reports</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Send Invitation\"</strong></li>\n            </ol>\n            <p class=\"tip\">💡 <strong>Tip:</strong> Invited users will appear with \"Pending\" status until they accept the invitation and login.</p>\n          </section>\n          \n          <section>\n            <h3>Editing User Roles</h3>\n            <ol>\n              <li>In User Management, click <strong>\"Edit\"</strong> next to a user</li>\n              <li>Select new role from dropdown</li>\n              <li>Click <strong>\"Update Role\"</strong></li>\n              <li>Changes take effect immediately</li>\n            </ol>\n            <p class=\"warning\">⚠️ <strong>Note:</strong> Owner role cannot be changed. Only one owner per organization.</p>\n          </section>\n          \n          <section>\n            <h3>Suspending Users</h3>\n            <p>Temporarily disable a user's access without removing them:</p>\n            <ol>\n              <li>Click <strong>\"Edit\"</strong> on the user</li>\n              <li>Click <strong>\"Suspend User\"</strong></li>\n              <li>User can still login but API calls will fail</li>\n              <li>To re-enable, click <strong>\"Activate User\"</strong></li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Removing Users</h3>\n            <ol>\n              <li>Click <strong>\"Edit\"</strong> on the user</li>\n              <li>Click <strong>\"Remove from Organization\"</strong></li>\n              <li>Confirm deletion</li>\n              <li>User is removed from tenant (cannot be undone)</li>\n            </ol>\n            <p class=\"warning\">⚠️ <strong>Warning:</strong> Cannot remove the owner. Transfer ownership first.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🎧 Help Desk Module</h2>\n          <p class=\"lead\">Customer support ticketing and equipment troubleshooting.</p>\n          \n          <section>\n            <h3>Creating Support Tickets</h3>\n            <ol>\n              <li>Go to <strong>Help Desk</strong> module</li>\n              <li>Click <strong>\"Create Ticket\"</strong></li>\n              <li>Enter ticket information:\n                <ul>\n                  <li><strong>Title</strong> - Brief description</li>\n                  <li><strong>Type</strong> - Troubleshoot, Repair, Installation, Other</li>\n                  <li><strong>Priority</strong> - Critical, High, Medium, Low</li>\n                  <li><strong>Description</strong> - Detailed issue description</li>\n                  <li><strong>Customer</strong> - Name and phone (optional)</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Create Ticket\"</strong></li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Assigning Tickets</h3>\n            <p>Help desk staff can assign tickets to field technicians:</p>\n            <ol>\n              <li>Click on a ticket card to open details</li>\n              <li>Click <strong>\"Assign\"</strong> button</li>\n              <li>Select field technician from dropdown</li>\n              <li>Technician receives push notification on mobile app</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Filtering Tickets</h3>\n            <p>Use filters to find specific tickets:</p>\n            <ul>\n              <li><strong>Status</strong> - Open, Assigned, In Progress, Resolved, Closed</li>\n              <li><strong>Priority</strong> - Critical, High, Medium, Low</li>\n              <li><strong>Search</strong> - Search by ticket number, title, or customer name</li>\n            </ul>\n          </section>\n          \n          <section>\n            <h3>Customer Lookup</h3>\n            <ol>\n              <li>Click <strong>\"Customer Lookup\"</strong> button</li>\n              <li>Search by phone, email, or IMSI</li>\n              <li>View customer information and service status</li>\n              <li>See active equipment and recent tickets</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🔐 User Roles & Permissions</h2>\n          <p class=\"lead\">Understanding the role-based access control system.</p>\n          \n          <section>\n            <h3>Role Hierarchy</h3>\n            \n            <div class=\"role-detail\">\n              <h4>🏢 Platform Admin</h4>\n              <p><strong>Who:</strong> System administrator (admin@wisptools.io)</p>\n              <p><strong>Access:</strong> ALL tenants, ALL modules, ALL permissions</p>\n              <p><strong>Can:</strong> Manage all tenants, create owners, override any permission</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>👑 Owner</h4>\n              <p><strong>Who:</strong> Organization creator</p>\n              <p><strong>Access:</strong> ALL modules in their tenant</p>\n              <p><strong>Can:</strong> Manage users, configure modules, full administrative control</p>\n              <p><strong>Cannot:</strong> Be changed or removed (permanent role)</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>⚙️ Admin</h4>\n              <p><strong>Who:</strong> Assistant administrators</p>\n              <p><strong>Access:</strong> Configurable module access</p>\n              <p><strong>Can:</strong> Manage users, configure permissions, access enabled modules</p>\n              <p><strong>Cannot:</strong> Change owner role, delete organization</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>👷 Engineer</h4>\n              <p><strong>Who:</strong> Network engineers</p>\n              <p><strong>Access:</strong> Technical modules only (PCI, CBRS, HSS, ACS, Distributed EPC)</p>\n              <p><strong>Can:</strong> Configure network, manage subscribers, view all work orders</p>\n              <p><strong>Cannot:</strong> Manage users, access help desk</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>🔧 Field Technician (Installer)</h4>\n              <p><strong>Who:</strong> Field workers</p>\n              <p><strong>Access:</strong> Mobile app, assigned work orders, inventory checkout</p>\n              <p><strong>Can:</strong> Deploy equipment, complete tickets, checkout inventory</p>\n              <p><strong>Cannot:</strong> View other techs' tickets, configure network</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>🎧 Help Desk</h4>\n              <p><strong>Who:</strong> Customer support staff</p>\n              <p><strong>Access:</strong> Help desk, work orders, ACS troubleshooting</p>\n              <p><strong>Can:</strong> Create tickets, assign to techs, troubleshoot CPE</p>\n              <p><strong>Cannot:</strong> Manage users, configure network</p>\n            </div>\n            \n            <div class=\"role-detail\">\n              <h4>👁️ Viewer</h4>\n              <p><strong>Who:</strong> Read-only users, auditors</p>\n              <p><strong>Access:</strong> View-only access to all modules</p>\n              <p><strong>Can:</strong> View dashboards, reports, export data</p>\n              <p><strong>Cannot:</strong> Make any changes</p>\n            </div>\n          </section>\n          \n          <section>\n            <h3>Configuring Module Access</h3>\n            <ol>\n              <li>Go to <strong>Settings</strong> → <strong>Module Access</strong></li>\n              <li>See matrix of roles vs. modules</li>\n              <li>Check/uncheck boxes to enable/disable modules per role</li>\n              <li>Click <strong>\"Save Configuration\"</strong></li>\n              <li>Changes apply immediately to all users</li>\n            </ol>\n            <p class=\"tip\">💡 <strong>Tip:</strong> Use the reset button to restore default permissions for a role.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>Customers & Customer Portal</h2>\n          <p class=\"lead\">Customer records, branded portal, billing, and support tickets.</p>\n          \n          <section>\n            <h3>Customers Module</h3>\n            <p>Manage customer records with service type (4G/5G, FWA, WiFi, Fiber), LTE auth (IMSI, Ki, OPc), MAC address, and QoS. Use the <strong>Customer Onboarding</strong> wizard from Quick access or the Customers module for guided setup.</p>\n          </section>\n          \n          <section>\n            <h3>Customer Portal Setup</h3>\n            <p>Enable a branded customer portal so customers can sign in and access:</p>\n            <ul>\n              <li><strong>Dashboard</strong> - Overview and quick links</li>\n              <li><strong>Billing</strong> - View account and billing information</li>\n              <li><strong>Tickets</strong> - Open and track support tickets</li>\n              <li><strong>Knowledge base / FAQ</strong> - Self-service help</li>\n            </ul>\n            <p>Configure portal branding (logo, colors) and enable the portal in <strong>Customers → Portal setup</strong>. Use <strong>Settings</strong> for organization-wide branding if needed.</p>\n          </section>\n          \n          <section>\n            <h3>Billing</h3>\n            <p>Customer billing is available from the Customers module (billing modal per customer) and in the customer portal. Billing cycles and invoicing can be extended when prioritized.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>Wizards & Quick Actions</h2>\n          <p class=\"lead\">Guided flows and in-module quick tips.</p>\n          \n          <section>\n            <h3>Available Wizards</h3>\n            <p>Open wizards from the dashboard <strong>Quick access</strong> dropdown or from the <strong>Wizards</strong> page:</p>\n            <ul>\n              <li><strong>Site Deployment</strong> - Deploy and configure sites</li>\n              <li><strong>Subscriber Creation / Group / Bandwidth Plan</strong> - HSS subscriber management</li>\n              <li><strong>RMA Tracking</strong> - Inventory returns and tracking</li>\n              <li><strong>Customer Onboarding</strong> - Guided customer setup</li>\n              <li><strong>Device Onboarding / Registration</strong> - ACS and CBRS device registration</li>\n              <li><strong>Conflict Resolution</strong> - PCI conflict resolution</li>\n              <li><strong>Work Order Creation</strong> - Create work orders</li>\n              <li><strong>Troubleshooting (ACS)</strong> - CPE diagnostics and steps</li>\n              <li><strong>First-time / Organization / Initial Configuration</strong> - Setup and tenant wizards</li>\n            </ul>\n          </section>\n          \n          <section>\n            <h3>Quick Tips in Modules</h3>\n            <p>Each module can show a <strong>Help</strong> button that opens context-specific tips (e.g. Monitoring, Deploy, CBRS, Plan, Inventory). Use it for step-by-step guidance without leaving the module.</p>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>📋 Work Orders & Field Operations</h2>\n          \n          <section>\n            <h3>Creating Work Orders</h3>\n            <ol>\n              <li>Go to <strong>Work Orders</strong> or <strong>Help Desk</strong> module</li>\n              <li>Click <strong>\"Create Work Order\"</strong></li>\n              <li>Fill in details:\n                <ul>\n                  <li><strong>Title</strong> - Brief description</li>\n                  <li><strong>Type</strong> - Installation, Repair, Maintenance, etc.</li>\n                  <li><strong>Priority</strong> - Critical to Low</li>\n                  <li><strong>Site</strong> - Affected tower site (optional)</li>\n                  <li><strong>Customer</strong> - Customer details (optional)</li>\n                  <li><strong>Description</strong> - Full details</li>\n                </ul>\n              </li>\n              <li>Click <strong>\"Create\"</strong></li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Assigning Work Orders</h3>\n            <ol>\n              <li>Open work order details</li>\n              <li>Click <strong>\"Assign\"</strong></li>\n              <li>Select field technician</li>\n              <li>Technician receives push notification on mobile app</li>\n              <li>Status changes to \"Assigned\"</li>\n            </ol>\n          </section>\n          \n          <section>\n            <h3>Mobile App Workflow</h3>\n            <p><strong>Field Technician receives notification:</strong></p>\n            <ol>\n              <li>Push notification appears on phone</li>\n              <li>Tap notification to open app</li>\n              <li>View work order details</li>\n              <li>Navigate to site using GPS</li>\n              <li>Complete work</li>\n              <li>Update status to \"Resolved\"</li>\n              <li>Add notes and photos</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          <h2>🔧 Troubleshooting</h2>\n          \n          <section>\n            <h3>Common Issues</h3>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Can't see a module on dashboard</h4>\n              <p><strong>Cause:</strong> Module not enabled for your role</p>\n              <p><strong>Solution:</strong> Ask your administrator to enable the module in Settings → Module Access</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ API calls fail with 403 Forbidden</h4>\n              <p><strong>Cause:</strong> Insufficient permissions for the action</p>\n              <p><strong>Solution:</strong> Contact your administrator to update your role or permissions</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Mobile app not receiving notifications</h4>\n              <p><strong>Solutions:</strong></p>\n              <ul>\n                <li>Check app has notification permissions granted</li>\n                <li>Check user is logged in</li>\n                <li>Restart app to re-register FCM token</li>\n                <li>Check system notification settings</li>\n              </ul>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Browser notifications not showing</h4>\n              <p><strong>Solution:</strong> Open the <strong>Notifications</strong> panel (bell icon on dashboard), click <strong>Enable notifications</strong>, and allow when the browser prompts. Notifications then appear for new unread items.</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Want to change light/dark theme</h4>\n              <p><strong>Solution:</strong> Click the <strong>Settings</strong> (gear) icon on the dashboard header and choose theme in the settings modal.</p>\n            </div>\n            \n            <div class=\"troubleshoot-item\">\n              <h4>❌ Work order not appearing in mobile app</h4>\n              <p><strong>Cause:</strong> Work order not assigned to your user</p>\n              <p><strong>Solution:</strong> Field technicians only see tickets assigned to them. Ask help desk to assign the ticket.</p>\n            </div>\n          </section>\n          \n          <section>\n            <h3>Getting Help</h3>\n            <p>If you encounter issues:</p>\n            <ol>\n              <li>Check this documentation first</li>\n              <li>Contact your organization administrator</li>\n              <li>Check browser console for errors (F12)</li>\n              <li>Clear browser cache and cookies</li>\n              <li>Try logging out and back in</li>\n            </ol>\n          </section>\n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n      \n      \n        <article>\n          \n        </article>\n    </main>\n  </div>\n</div>";
}

@page GET "/login"
page login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  use auth session;
  load { surface: "wisp-auth-native", source: "wisp-30", profile: "gce-single-use", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"login-page\">\n  <div class=\"login-container\">\n    <!-- Branding Section -->\n    <div class=\"login-brand\">\n      <img src=\"/wisptools-logo.svg\" alt=\"WISP Management\" class=\"brand-logo\" />\n      \n      <h1>WISP Management</h1>\n      <p class=\"brand-tagline\">wisptools.io</p>\n        <p class=\"poc-notice\">Part of wisptools.io. Source code: <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a> · <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener noreferrer\">CC BY 4.0</a></p>\n    </div>\n\n    <!-- Login Form -->\n    <div class=\"login-card\">\n      <h2>Welcome Back</h2>\n      \n\n      <p class=\"subtitle\">\n        \n          Sign in to access your network management tools\n        \n      </p>\n\n      \n\n      \n\n      \n\n      \n\n      <form}>\n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"you@example.com\"\n            required\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;\">\n            <label for=\"password\">Password</label>\n            <button \n              type=\"button\" \n              class=\"link-btn\" \n              style=\"font-size: 0.875rem; padding: 0;\"\n            >\n              Forgot password?\n            </button>\n          </div>\n          <input\n            id=\"password\"\n            type=\"password\"\n            placeholder=\"Enter your password\"\n            required\n          />\n        </div>\n\n        <button type=\"submit\" class=\"btn-primary\">\n          \n            Sign In\n          \n        </button>\n      </form>\n\n      \n        <div class=\"form-footer\">\n          <span class=\"link-btn\" style=\"text-decoration: none; opacity: 0.8;\">\n            Contact your admin for access\n          </span>\n        </div>\n\n        <div class=\"login-divider\">\n          <span></span>\n          <p>or</p>\n          <span></span>\n        </div>\n\n        <button type=\"button\" class=\"btn-google\">\n          <svg aria-hidden=\"true\" viewBox=\"0 0 533.5 544.3\">\n            <path fill=\"#4285f4\" d=\"M533.5 278.4c0-17.4-1.4-34.1-4.1-50.2H272v95h147.5c-6.4 34-25 62.8-53.4 82v68h86.1c50.4-46.5 80.3-115.1 80.3-194.8z\"/>\n            <path fill=\"#34a853\" d=\"M272 544.3c72.2 0 132.8-23.9 177-64.7l-86.1-68c-23.9 16.1-54.5 25.7-90.9 25.7-69.9 0-129.2-47.2-150.4-110.5h-90.7v69.8c44 87.4 134.5 148.7 241.1 148.7z\"/>\n            <path fill=\"#fbbc04\" d=\"M121.6 326.8c-10.2-30-10.2-62.5 0-92.5v-69.8h-90.7c-37.3 74.6-37.3 158.4 0 233z\"/>\n            <path fill=\"#ea4335\" d=\"M272 107.7c39.2-.6 76.4 13.8 105 39.9l78.2-78.2C404.5 25.5 344 0 272 0 165.4 0 74.9 61.3 30.9 148.7l90.7 69.8C142.7 175 202.1 107.7 272 107.7z\"/>\n          </svg>\n          <span>Sign in with Google</span>\n        </button>\n      \n\n    </div>\n\n    <!-- Features Section -->\n    <div class=\"features\">\n      <div class=\"feature\">\n        <span class=\"feature-icon\">📊</span>\n        <h3>PCI Resolution</h3>\n        <p>Automated conflict detection</p>\n      </div>\n      <div class=\"feature\">\n        <span class=\"feature-icon\">📡</span>\n        <h3>Coverage Planning</h3>\n        <p>RF analysis tools</p>\n      </div>\n      <div class=\"feature\">\n        <span class=\"feature-icon\">🌐</span>\n        <h3>Spectrum Management</h3>\n        <p>Frequency planning</p>\n      </div>\n    </div>\n\n    <footer class=\"login-footer\">\n      <a href=\"https://github.com/theorem6/WISP-Management\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a>\n      <span class=\"sep\">·</span>\n      <a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener noreferrer\">CC BY 4.0</a>\n    </footer>\n  </div>\n</div>";
}

@route POST "/login"
handler login_post {
  effects: session.write;
  use auth session;
  header X-Tenant-ID;
  body email;
  body password;
  return { ok: true, surface: "wisp-auth-native" };
}

@route GET "/api/me"
handler session_me {
  effects: session.read;
  use auth session;
  return { ok: true, surface: "wisp-auth-native" };
}

@page GET "/modules"
page modules_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  return html "<svelte:head>\n  <title>Modules - LTE WISP Management Platform</title>\n  <meta name=\"description\" content=\"Available modules for network management and optimization\" />\n</svelte:head>\n\n<div class=\"redirect-message\">\n  Redirecting to dashboard...\n</div>";
}

@page GET "/modules/acs-cpe-management"
page modules_acs_cpe_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"acs-module\">\n  <!-- Main Navigation -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Help Button -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n  \n  <!-- Module Header -->\n  <div class=\"module-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <div class=\"module-info\">\n        <h1 class=\"module-title\">\n          <span class=\"module-icon\">📡</span>\n          Module\n        </h1>\n        <p class=\"module-description\">Showcase module</p>\n        \n        <!-- Multi-Tenant Info -->\n        <div class=\"tenant-badge\">\n            <span class=\"tenant-icon\">🏢</span>\n            <span class=\"tenant-text\">Demo Tenant</span>\n            <span class=\"tenant-label\">Organization</span>\n          </div>\n      </div>\n      \n      <div class=\"module-actions\">\n        \n        \n        \n        \n        <button \n          class=\"btn btn-primary\"\n        >\n          \n        </button>\n\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n        />\n\n        <button \n          class=\"btn btn-primary\"\n        >\n          \n        </button>\n        \n        <button \n          class=\"btn btn-secondary\"\n        >\n          🔄 Refresh View\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Error Display -->\n  \n\n  <!-- Module Content -->\n  <div class=\"module-content\">\n    <!-- CPE Statistics -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card tenant-stat\">\n        <div class=\"stat-icon\">🏢</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">Demo Tenant</div>\n          <div class=\"stat-label\">Current Organization</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📱</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">2</div>\n          <div class=\"stat-label\">Total CPEs</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🟢</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">\n            2\n          </div>\n          <div class=\"stat-label\">Online</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🔴</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">\n            2\n          </div>\n          <div class=\"stat-label\">Offline</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📍</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">\n            2\n          </div>\n          <div class=\"stat-label\">With GPS</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Map Section Placeholder -->\n    <div class=\"map-section\">\n      <div class=\"map-header\">\n        <h3>CPE Device Map</h3>\n        <div class=\"map-controls\">\n          <div class=\"legend\">\n            <div class=\"legend-item\">\n              <span class=\"legend-color online\"></span>\n              <span>Online CPEs</span>\n            </div>\n            <div class=\"legend-item\">\n              <span class=\"legend-color offline\"></span>\n              <span>Offline CPEs</span>\n            </div>\n            <div class=\"legend-item\">\n              <span class=\"legend-color error\"></span>\n              <span>Error CPEs</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"map-container\">\n        <div class=\"arcgis-map\"></div>\n        \n        \n      </div>\n    </div>\n\n    <!-- Performance Analytics Section -->\n    <div class=\"performance-analytics-section\">\n      <div class=\"section-header\">\n        <div class=\"section-title-block\">\n          <h3>📊 Performance Analytics</h3>\n          <p class=\"section-hint\">Monitoring and Graphs are in the sidebar →</p>\n        </div>\n        <div class=\"analytics-controls\">\n          <select class=\"time-select\">\n            <option value=\"1h\">Last Hour</option>\n            <option value=\"6h\">Last 6 Hours</option>\n            <option value=\"24h\">Last 24 Hours</option>\n            <option value=\"7d\">Last 7 Days</option>\n          </select>\n        </div>\n      </div>\n\n      <div class=\"analytics-content\">\n        <!-- Performance Summary Cards (from TR-069 metrics API) -->\n        <div class=\"analytics-grid\">\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📶</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\"></div>\n              <div class=\"metric-label\">Average RSSI</div>\n              \n            </div>\n          </div>\n\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📡</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\">8/10</div>\n              <div class=\"metric-label\">Online CPEs</div>\n              <div class=\"metric-trend positive\">99.2% uptime</div>\n            </div>\n          </div>\n\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">⚡</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\"></div>\n              <div class=\"metric-label\">Signal Quality</div>\n              \n            </div>\n          </div>\n\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">🔄</div>\n            <div class=\"analytics-metric\">\n              <div class=\"metric-value\"></div>\n              <div class=\"metric-label\">Avg. Uptime</div>\n              <div class=\"metric-trend neutral\">From device metrics</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Per-device metrics & charts (link to dedicated pages) -->\n        <div class=\"performance-charts\">\n          <div class=\"chart-placeholder chart-cta\">\n            <div class=\"chart-icon\">📈</div>\n            <h4>Per-Device Metrics & Charts</h4>\n            <p>View time-series RSSI, SINR, throughput, and uptime for individual CPE devices.</p>\n            <div class=\"chart-actions\">\n              <a href=\"/modules/acs-cpe-management/monitoring\" class=\"btn btn-primary\">📊 Monitoring</a>\n              <a href=\"/modules/acs-cpe-management/graphs\" class=\"btn btn-secondary\">📈 Graphs</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- CPE Device List -->\n    <div class=\"cpe-list-section\">\n      <div class=\"section-header\">\n        <h3>CPE Device List</h3>\n        <div class=\"list-controls\">\n          <input\n            type=\"text\"\n            placeholder=\"Search CPE devices...\"\n            class=\"search-input\"\n          />\n        </div>\n      </div>\n\n      \n    </div>\n  </div>\n\n  <!-- CPE Performance Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"CPEPerformanceModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n  \n  <!-- Help / Tips Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n  \n  \n  <!-- Device Onboarding Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"DeviceOnboardingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  \n  <!-- Troubleshooting Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"TroubleshootingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Preset Creation Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"PresetCreationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Bulk Operations Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"BulkOperationsWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Firmware Update Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"FirmwareUpdateWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Device Registration Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"DeviceRegistrationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n</div>";
}

@page GET "/modules/acs-cpe-management/alerts"
page modules_acs_cpe_management_alerts_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/alerts", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"alerts-page\">\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <a href=\"/modules/acs-cpe-management\" class=\"back-button\">← Back to ACS Management</a>\n      <h1>🚨 Alert Rules</h1>\n      <p>Configure alerts for ACS device monitoring</p>\n    </div>\n    <button class=\"btn btn-primary\">\n      ➕ Create Alert Rule\n    </button>\n  </div>\n\n  \n\n  \n\n  <!-- Active Alerts -->\n  <div class=\"alerts-section\">\n      <h2>Active Alerts (2)</h2>\n      <div class=\"alerts-list\">\n        <div class=\"alert-item\" style=\"border-left-color: \">\n            <div class=\"alert-header\">\n              <span class=\"alert-severity\" style=\"color: \">\n                \n              </span>\n              <span class=\"alert-time\"></span>\n            </div>\n            <div class=\"alert-message\"></div>\n            \n            \n          </div><div class=\"alert-item\" style=\"border-left-color: \">\n            <div class=\"alert-header\">\n              <span class=\"alert-severity\" style=\"color: \">\n                \n              </span>\n              <span class=\"alert-time\"></span>\n            </div>\n            <div class=\"alert-message\"></div>\n            \n            \n          </div>\n      </div>\n    </div>\n\n  <!-- Alert Rules -->\n  \n</div>\n\n<!-- Create/Edit Modal -->\n";
}

@page GET "/modules/acs-cpe-management/devices"
page modules_acs_cpe_management_devices_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/devices", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"devices-page\">\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Page Header -->\n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <h1 class=\"page-title\">\n        <span class=\"page-icon\">📱</span>\n        CPE Device Management\n      </h1>\n      <p class=\"page-description\">\n        Manage TR-069 enabled CPE devices with remote control capabilities\n      </p>\n    </div>\n    <div class=\"header-actions\">\n      <button class=\"btn btn-primary\">\n        \n          🔄\n        \n        Refresh\n      </button>\n    </div>\n  </div>\n\n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-item\">\n      <span class=\"stat-icon\">📊</span>\n      <span class=\"stat-value\">2</span>\n      <span class=\"stat-label\">Total</span>\n    </div>\n    <div class=\"stat-item online\">\n      <span class=\"stat-icon\">🟢</span>\n      <span class=\"stat-value\">8</span>\n      <span class=\"stat-label\">Online</span>\n    </div>\n    <div class=\"stat-item offline\">\n      <span class=\"stat-icon\">🔴</span>\n      <span class=\"stat-value\">2</span>\n      <span class=\"stat-label\">Offline</span>\n    </div>\n    <div class=\"stat-item\">\n      <span class=\"stat-icon\">📈</span>\n      <span class=\"stat-value\">1</span>\n      <span class=\"stat-label\">Shown</span>\n    </div>\n  </div>\n\n  <!-- Filters -->\n  <div class=\"filters-bar\">\n    <div class=\"filter-group\">\n      <input\n        type=\"text\"\n        placeholder=\"Search devices...\"\n        class=\"search-input\"\n      />\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option value=\"all\">All Status</option>\n        <option value=\"online\">Online</option>\n        <option value=\"offline\">Offline</option>\n      </select>\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option>All Tags</option>\n        <option></option><option></option>\n      </select>\n    </div>\n    <button \n      class=\"btn btn-secondary btn-sm\"\n    >\n      ▶ Advanced Filters\n    </button>\n    <button \n      class=\"btn btn-secondary btn-sm\"\n    >\n      Clear Filters\n    </button>\n  </div>\n\n  \n\n  <!-- Bulk Actions Bar -->\n  \n\n  <!-- Devices Table -->\n  <div class=\"devices-table-container\">\n    <table class=\"devices-table\">\n      <thead>\n        <tr>\n          <th class=\"col-select\">\n            <input\n              type=\"checkbox\"\n              class=\"select-all-checkbox\"\n            />\n          </th>\n          <th class=\"col-expand\"></th>\n          <th class=\"col-status\">Status</th>\n          <th class=\"col-device-id\">Device ID</th>\n          <th class=\"col-manufacturer\">Manufacturer</th>\n          <th class=\"col-model\">Model</th>\n          <th class=\"col-serial\">Serial Number</th>\n          <th class=\"col-ip\">IP Address</th>\n          <th class=\"col-firmware\">Firmware</th>\n          <th class=\"col-contact\">Last Contact</th>\n          <th class=\"col-tags\">Tags</th>\n          <th class=\"col-actions\">Actions</th>\n        </tr>\n      </thead>\n      <tbody>\n        \n          <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"CPEDeviceRow\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>cpe-1</td><td>online</td></tr><tr><td>cpe-2</td><td>degraded</td></tr></tbody></table></div> toggleSelectDevice(e.detail.id)}/>\n        \n      </tbody>\n    </table>\n  </div>\n</div>\n\n<!-- TR-069 Actions Modal -->\n\n\n\n\n<!-- Preset Selection Modal -->\n\n\n<!-- Edit Device Tags Modal -->\n";
}

@page GET "/modules/acs-cpe-management/faults"
page modules_acs_cpe_management_faults_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/faults", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"faults-page\">\n  <!-- Main Navigation -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Page Header -->\n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <h1 class=\"page-title\">\n        <span class=\"page-icon\">⚠️</span>\n        Device Faults\n      </h1>\n      <p class=\"page-description\">\n        Monitor and manage device faults and errors\n      </p>\n    </div>\n    <div class=\"header-actions\">\n      <a href=\"/modules/acs-cpe-management/admin/database\" class=\"btn btn-secondary\">\n        <span class=\"btn-icon\">🗂️</span>\n        Initialize Faults in Database\n      </a>\n      <button class=\"btn btn-primary\">\n        <span class=\"btn-icon\">🔄</span>\n        Refresh\n      </button>\n    </div>\n  </div>\n\n  <!-- Fault Statistics -->\n  <div class=\"stats-section\">\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📊</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">4</div>\n          <div class=\"stat-label\">Total Faults</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🔴</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">2</div>\n          <div class=\"stat-label\">Open</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🟢</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">2</div>\n          <div class=\"stat-label\">Resolved</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🚨</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">1</div>\n          <div class=\"stat-label\">Critical</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filter-group\">\n      <input \n        type=\"text\" \n        placeholder=\"Search faults...\"\n        class=\"search-input\"\n      />\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option value=\"all\">All Severities</option>\n        <option value=\"Critical\">Critical</option>\n        <option value=\"Warning\">Warning</option>\n        <option value=\"Info\">Info</option>\n      </select>\n    </div>\n    <div class=\"filter-group\">\n      <select class=\"filter-select\">\n        <option value=\"all\">All Status</option>\n        <option value=\"Open\">Open</option>\n        <option value=\"Resolved\">Resolved</option>\n      </select>\n    </div>\n  </div>\n\n  <!-- Faults List -->\n  <div class=\"faults-container\">\n    \n      <div class=\"faults-list\">\n        <div class=\"fault-card\">\n            <div class=\"fault-header\">\n              <div class=\"fault-info\">\n                <h3 class=\"fault-id\"></h3>\n                <p class=\"fault-device\"></p>\n              </div>\n              <div class=\"fault-badges\">\n                <span class=\"severity-badge\">\n                  \n                </span>\n                <span class=\"status-badge\">\n                  \n                </span>\n              </div>\n            </div>\n            \n            <div class=\"fault-content\">\n              <div class=\"fault-message\">\n                <strong>Error :</strong> \n              </div>\n              <div class=\"fault-description\">\n                \n              </div>\n              <div class=\"fault-meta\">\n                <span class=\"meta-item\">\n                  <strong>Timestamp:</strong> \n                </span>\n                \n              </div>\n            </div>\n            \n            <div class=\"fault-actions\">\n              <button class=\"btn btn-sm btn-primary\">\n                View Details\n              </button>\n              \n              <button class=\"btn btn-sm btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div>\n      </div>\n    \n  </div>\n</div>\n\n<!-- Fault Details Modal -->\n";
}

@page GET "/modules/acs-cpe-management/files"
page modules_acs_cpe_management_files_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/files", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"files-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to ACS Management\n      </button>\n      <h1>📁 File Management</h1>\n      <p class=\"subtitle\">Demo Tenant - Firmware & Configuration Files</p>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Upload Section -->\n  <div class=\"upload-section\">\n    <h2>📤 Upload File</h2>\n    <p class=\"section-subtitle\">Upload firmware images or configuration files for CPE devices</p>\n\n    <div class=\"upload-form\">\n      <div class=\"form-group\">\n        <label for=\"file-input\">Select File</label>\n        <input\n          id=\"file-input\"\n          type=\"file\"\n          accept=\".bin,.img,.tar,.gz,.zip,.xml,.json\"\n        />\n        \n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"file-type\">File Type</label>\n        <select id=\"file-type\">\n          \n        </select>\n        <p class=\"help-text\">TR-069 FileType parameter for Download RPC</p>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"description\">Description (Optional)</label>\n        <input\n          id=\"description\"\n          type=\"text\"\n          placeholder=\"e.g., Firmware v2.4.1 for Nokia devices\"\n        />\n      </div>\n\n      <button \n        class=\"btn-primary\"\n      >\n        \n      </button>\n    </div>\n  </div>\n\n  <!-- TR-069 Download Method Info -->\n  <div class=\"info-panel\">\n    <h2>📚 TR-069 Firmware Upgrade Methods</h2>\n    \n    <div class=\"method-card recommended\">\n      <div class=\"method-header\">\n        <h3>✅ Recommended: URL-based Download</h3>\n        <span class=\"badge\">Best Practice</span>\n      </div>\n      <p>Use TR-069 <code>Download</code> RPC with file URL from GenieACS File Server</p>\n      \n      <div class=\"method-details\">\n        <h4>How it Works:</h4>\n        <ol>\n          <li>Upload firmware file to File Server (this page)</li>\n          <li>File stored in GenieACS FS (MongoDB GridFS)</li>\n          <li>System generates URL: <code>http://your-domain.com/fs/{filename}</code></li>\n          <li>Create Download task in Presets or manually</li>\n          <li>CPE downloads file from URL and installs</li>\n        </ol>\n\n        <h4>Task Parameters:</h4>\n        <div class=\"code-block\">\n          Task Name: download<br/>\n          File Type: 1 (Firmware Upgrade Image)<br/>\n          URL: http://your-domain.com/fs/firmware-v2.4.1.bin<br/>\n          Username: (optional - if auth required)<br/>\n          Password: (optional - if auth required)\n        </div>\n\n        <h4>Advantages:</h4>\n        <ul>\n          <li>✅ Standardized TR-069 method</li>\n          <li>✅ Works with all TR-069 compliant devices</li>\n          <li>✅ Can use HTTPS for security</li>\n          <li>✅ Progress tracking available</li>\n          <li>✅ Can schedule downloads</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"method-card\">\n      <div class=\"method-header\">\n        <h3>Alternative: ScheduleDownload RPC</h3>\n      </div>\n      <p>Schedule firmware download for specific time (maintenance window)</p>\n      \n      <div class=\"method-details\">\n        <h4>Use Case:</h4>\n        <p>When you want to upgrade devices at night or during low-traffic periods</p>\n        \n        <h4>Parameters:</h4>\n        <ul>\n          <li>FileType, URL (same as Download)</li>\n          <li>TimeWindow: Start and end time</li>\n          <li>CPE downloads during specified window</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"method-card\">\n      <div class=\"method-header\">\n        <h3>Vendor Specific Methods</h3>\n      </div>\n      <p>Some vendors (Huawei, Nokia, ZTE) have custom upgrade methods</p>\n      \n      <div class=\"method-details\">\n        <h4>Examples:</h4>\n        <ul>\n          <li>X_HUAWEI_Download</li>\n          <li>X_NOKIA_SoftwareUpgrade</li>\n          <li>X_ZTE_FirmwareUpgrade</li>\n        </ul>\n        \n        <p class=\"warning\">⚠️ Not recommended - vendor lock-in and not standardized</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Quick Start Guide -->\n  <div class=\"info-panel\">\n    <h2>🚀 Quick Start: Firmware Upgrade</h2>\n    \n    <div class=\"steps-grid\">\n      <div class=\"step-card\">\n        <div class=\"step-number\">1</div>\n        <h3>Upload Firmware</h3>\n        <p>Upload firmware file using the form above</p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-number\">2</div>\n        <h3>Note the URL</h3>\n        <p>File Server URL: <code>http://domain:7567/{filename}</code></p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-number\">3</div>\n        <h3>Create Preset or Task</h3>\n        <p>Go to Presets/Admin → Create Download task</p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-number\">4</div>\n        <h3>Apply to Devices</h3>\n        <p>Task executes on next device inform</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Current Implementation Notice -->\n  <div class=\"notice-panel\">\n    <h3>🔧 Implementation Status</h3>\n    <p><strong>File Server Setup Required:</strong></p>\n    <ul>\n      <li>GenieACS File Server must be running on backend</li>\n      <li>Configure <code>FS_HOSTNAME</code> in GenieACS config</li>\n      <li>Ensure port 7567 is accessible</li>\n      <li>Files stored in MongoDB GridFS per tenant</li>\n    </ul>\n    \n    <p><strong>For Now:</strong></p>\n    <p>You can manually upload files to the GenieACS File Server via:</p>\n    <div class=\"code-block\">\n      # Via HTTP PUT<br/>\n      curl -T firmware.bin http://your-server:7567/firmware-v2.4.1.bin\n    </div>\n    \n    <p>Then use the URL in Download tasks: <code>http://your-server:7567/firmware-v2.4.1.bin</code></p>\n  </div>\n</div>";
}

