  return html "<section class=\"cwl-form-shell\" data-cwl-form-shell=\"no-source-add\" data-cwl-route=\"/modules/add\"><header class=\"cwl-form-shell-header\"><h1>Add modules</h1><a class=\"cwl-form-shell-back\" href=\"/modules\">Back</a></header><form class=\"cwl-form-shell-form\" method=\"post\" action=\"/modules/add\" data-cwl-form-shell-empty=\"true\"><p class=\"cwl-form-shell-note\">Missing +page.svelte — empty shell (no invented fields).</p><button type=\"submit\" disabled>Save</button></form></section>";
}
