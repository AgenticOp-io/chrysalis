@page GET "/modules/acs-cpe-management/tasks"
page modules_acs_cpe_management_tasks_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/tasks", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"tasks-page\">\\r\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\\r\n  <main class=\"content\">\\r\n    <header class=\"page-header\">\\r\n      <h1>TR-069 Task Queue</h1>\\r\n      <p class=\"subtitle\">Pending and recent tasks sent to CPE devices via GenieACS.</p>\\r\n    </header>\\r\n\\r\n    <div class=\"toolbar\">\\r\n      <input\\r\n        type=\"text\"\\r\n        placeholder=\"Filter by device ID\"\\r\n        class=\"filter-input\"\\r\n      />\\r\n      <button class=\"btn-primary\">\\r\n        Refresh\\r\n      </button>\\r\n    </div>\\r\n\\r\n    \\r\n\\r\n    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"isLoading && tasks.length === 0\"><div class=\"loading\">Loading task queue…</div>\\r\n    \\r\n      <div class=\"empty\">No tasks in the queue. Tasks appear when you reboot, refresh, or run operations on devices.</div></div>\\r\n  </main>\\r\n</div>";
}

