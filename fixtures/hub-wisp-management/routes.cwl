@page GET "/modules/help-desk"
page modules_help_desk_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/help-desk", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"help-desk-container\">\n  <div class=\"header\">\n    <button class=\"btn-back\">\n      ← Back to Modules\n    </button>\n    \n    <div class=\"title-section\">\n      <h1>🎧 Help Desk</h1>\n      <p class=\"subtitle\">Customer support and ticket management for Demo Tenant</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button \n        class=\"btn btn-secondary btn-reports\"\n        title=\"View Ticket Reports and Analytics\"\n      >\n        📊 Reports\n      </button>\n      <button class=\"btn btn-secondary\">\n        🔍 Customer Lookup\n      </button>\n      <button class=\"btn btn-primary\">\n        ➕ Create Ticket\n      </button>\n    </div>\n  </div>\n  \n  \n  \n  <div class=\"stats-grid\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon open\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Open Tickets</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon in-progress\">⚙️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">In Progress</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon resolved\">✅</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Resolved</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon time\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n  \n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search tickets, customers...\"\n      />\n    </div>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"open\">Open</option>\n      <option value=\"assigned\">Assigned</option>\n      <option value=\"in-progress\">In Progress</option>\n      <option value=\"waiting-parts\">Waiting Parts</option>\n      <option value=\"resolved\">Resolved</option>\n      <option value=\"closed\">Closed</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Priority</option>\n      <option value=\"critical\">Critical</option>\n      <option value=\"high\">High</option>\n      <option value=\"medium\">Medium</option>\n      <option value=\"low\">Low</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Categories</option>\n      <option value=\"customer-facing\">Customer-Facing</option>\n      <option value=\"infrastructure\">Infrastructure</option>\n    </select>\n    \n    <div class=\"results-count\">\n       of 1 tickets\n    </div>\n  </div>\n  \n  \n    <div class=\"tickets-grid\">\n      \n    </div>\n  \n</div>\n\n\n\n";
}

@page GET "/modules/help-desk/reports"
page modules_help_desk_reports_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/help-desk/reports", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"reports-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Help Desk\n      </button>\n      <h1>📊 Ticket Reports & Analytics</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn btn-primary\">\n        🖨️ Print PDF\n      </button>\n    </div>\n  </div>\n\n  \n    <!-- Summary Cards -->\n    <div class=\"summary-grid\">\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">🎧</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">10</div>\n          <div class=\"card-label\">Total Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card open\">\n        <div class=\"card-icon\">📋</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Open Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card resolved\">\n        <div class=\"card-icon\">✅</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Resolved Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">⏱️</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Avg Resolution Time</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Alerts -->\n    \n\n    <div class=\"alert-section critical\">\n        <h3>🔴 Critical Open Tickets (2)</h3>\n        <ul>\n          <li>\n              <strong></strong> - \n              \n            </li><li>\n              <strong></strong> - \n              \n            </li>\n          \n        </ul>\n      </div>\n\n    <!-- Charts -->\n    <div class=\"charts-grid\">\n      <!-- Status Distribution -->\n      <div class=\"chart-card\">\n        <h3>Status Distribution</h3>\n        \n      </div>\n\n      <!-- Priority Distribution -->\n      <div class=\"chart-card\">\n        <h3>Priority Distribution</h3>\n        \n      </div>\n\n      <!-- Category Distribution -->\n      <div class=\"chart-card\">\n        <h3>Category Distribution</h3>\n        \n      </div>\n\n      <!-- Type Distribution -->\n      <div class=\"chart-card\">\n        <h3>Type Distribution</h3>\n        \n      </div>\n    </div>\n\n    <!-- Detailed Tables -->\n    <div class=\"table-section\">\n      <h3>By Status</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Priority</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Priority</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Category</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Category</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Assigned To</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Assigned To</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>SLA Compliance</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>On Time</td>\n            <td>8</td>\n            <td>%</td>\n          </tr>\n          <tr>\n            <td>Breached</td>\n            <td>2</td>\n            <td>%</td>\n          </tr>\n          <tr>\n            <td>No SLA</td>\n            <td></td>\n            <td>-</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  \n</div>";
}

