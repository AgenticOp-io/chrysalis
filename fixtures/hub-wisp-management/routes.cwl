# Chrysalis Web Language — hub emit from svelte
module hub;

@page GET "/"
page root_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  return html "<div class=\"loading-page\">\n  <div class=\"spinner\"></div>\n  <p>Checking authentication...</p>\n</div>";
}

@page GET "/admin/billing"
page admin_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/admin/billing", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"billing-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"AdminBreadcrumb\" aria-hidden=\"true\"></nav>\n      <div class=\"header-content\">\n        <div class=\"module-title\">\n          <h1>💳 Billing Management</h1>\n          <p>Manage subscriptions, payments, and billing analytics</p>\n        </div>\n        <div class=\"user-info\">\n          \n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n      \n\n      <!-- Billing Analytics -->\n      <div class=\"analytics-section\">\n        <h2>Billing Analytics</h2>\n        <div class=\"analytics-grid\">\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">💰</div>\n            <div class=\"analytics-info\">\n              <h4>Total Revenue</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatCurrency(analytics.totalRevenue)\"></span></p>\n            </div>\n          </div>\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📈</div>\n            <div class=\"analytics-info\">\n              <h4>Monthly Recurring Revenue</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatCurrency(analytics.monthlyRecurringRevenue)\"></span></p>\n            </div>\n          </div>\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">👥</div>\n            <div class=\"analytics-info\">\n              <h4>Active Subscriptions</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"analytics.activeSubscriptions\"></span></p>\n            </div>\n          </div>\n          <div class=\"analytics-card\">\n            <div class=\"analytics-icon\">📊</div>\n            <div class=\"analytics-info\">\n              <h4>Average Revenue Per User</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatCurrency(analytics.averageRevenuePerUser)\"></span></p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Subscription Plans -->\n      <div class=\"plans-section\">\n        <h2>Subscription Plans</h2>\n        <div class=\"plans-grid\">\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"plans as plan\"><div class=\"plan-card \">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"plan.isPopular\"><div class=\"popular-badge\">Most Popular</div></div>\n              <div class=\"plan-header\">\n                <h3></h3>\n                <div class=\"plan-price\">\n                  <span class=\"price\"></span>\n                  <span class=\"interval\">/</span>\n                </div>\n              </div>\n              <p class=\"plan-description\"></p>\n              <ul class=\"plan-features\">\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"plan.features as feature\"><li>✓ </li></div>\n              </ul>\n              <div class=\"plan-limits\">\n                <span>Up to  users</span>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"plan.maxTenants\"><span>Up to  tenants</span></div>\n              </div>\n            </div></div>\n        </div>\n      </div>\n\n      <!-- Failed Payment Alerts -->\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"!loading && getFailedPayments().length > 0\"><div class=\"alerts-section\">\n          <h2>⚠️ Failed Payment Alerts</h2>\n          <div class=\"failed-payments-list\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"getFailedPayments() as invoice\"><div class=\"alert-card alert-error\">\n                <div class=\"alert-icon\">⚠️</div>\n                <div class=\"alert-content\">\n                  <strong>Failed Payment</strong>\n                  <p>Tenant: </p>\n                  <p>Amount:  </p>\n                  <p>Invoice ID: </p>\n                  <p class=\"alert-date\">Date: </p>\n                </div>\n              </div></div>\n          </div>\n        </div></div>\n\n      <!-- Payment History Section -->\n      <div class=\"payments-section\">\n        <h2>💳 Payment History</h2>\n        \n          <div class=\"payments-table\">\n            <div class=\"table-header\">\n              <div class=\"col-invoice\">Invoice ID</div>\n              <div class=\"col-tenant\">Tenant</div>\n              <div class=\"col-amount\">Amount</div>\n              <div class=\"col-status\">Status</div>\n              <div class=\"col-date\">Date</div>\n            </div>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"invoices as invoice\"><div class=\"table-row\">\n                <div class=\"col-invoice\">\n                  <span class=\"invoice-id\"></span>\n                </div>\n                <div class=\"col-tenant\">\n                  <span class=\"tenant-name\"></span>\n                </div>\n                <div class=\"col-amount\">\n                  <span class=\"amount\"> </span>\n                </div>\n                <div class=\"col-status\">\n                  <span class=\"badge \">\n                    \n                  </span>\n                </div>\n                <div class=\"col-date\">\n                  <span class=\"date\"></span>\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"invoice.paidAt\"><span class=\"paid-date\">Paid: </span></div>\n                </div>\n              </div></div>\n          </div>\n        \n      </div>\n\n      <!-- Payment Methods Section -->\n      <div class=\"payment-methods-section\">\n        <h2>💳 Payment Methods & Billing Details</h2>\n        \n          <div class=\"payment-methods-grid\">\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"paymentMethods as method\"><div class=\"payment-method-card\">\n                <div class=\"method-header\">\n                  <div class=\"method-type\">\n                    <span class=\"method-icon\">💳</span>\n                    <strong></strong>\n                  </div>\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"method.isDefault\"><span class=\"default-badge\">Default</span></div>\n                </div>\n                <div class=\"method-details\">\n                  <p><strong>Tenant:</strong> </p>\n                  <p><strong>Email:</strong> </p>\n                  <p><strong>Added:</strong> </p>\n                </div>\n              </div></div>\n          </div>\n        \n      </div>\n\n      <!-- Active Subscriptions -->\n      <div class=\"subscriptions-section\">\n        <h2>Active Subscriptions</h2>\n        \n          <div class=\"subscriptions-table\">\n            <div class=\"table-header\">\n              <div class=\"col-tenant\">Tenant</div>\n              <div class=\"col-plan\">Plan</div>\n              <div class=\"col-status\">Status</div>\n              <div class=\"col-period\">Current Period</div>\n              <div class=\"col-actions\">Actions</div>\n            </div>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"subscriptions as subscription\"><div class=\"table-row\">\n                <div class=\"col-tenant\">\n                  <span class=\"tenant-name\"></span>\n                </div>\n                <div class=\"col-plan\">\n                  <span class=\"plan-name\"></span>\n                </div>\n                <div class=\"col-status\">\n                  <span class=\"badge \">\n                    \n                  </span>\n                </div>\n                <div class=\"col-period\">\n                  <span class=\"period-dates\">\n                     - \n                  </span>\n                </div>\n                <div class=\"col-actions\">\n                  <button class=\"action-btn\">\n                    View Details\n                  </button>\n                </div>\n              </div></div>\n          </div>\n        \n      </div>\n      </div>\n    </div>";
}

@page GET "/admin/management"
page admin_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/admin/management", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"admin-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-content\">\n        <div class=\"module-title\">\n          <h1>⚙️ Admin Management</h1>\n          <p>User and tenant management for owners and administrators</p>\n        </div>\n        <div class=\"user-info\">\n          \n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n      <!-- Overview -->\n      <div class=\"overview-section\">\n        <h2>Administration Overview</h2>\n        <p>The Admin Management module provides comprehensive tools for managing users, tenants, system settings, and billing. This module is only accessible to platform owners and administrators.</p>\n      </div>\n\n      <!-- Features Grid -->\n      <div class=\"features-section\">\n        <h2>Administration Features</h2>\n        <div class=\"features-grid\">\n          <div \n              class=\"feature-card\"\n              role=\"button\"\n              tabindex=\"0\"\n            >\n              <div class=\"feature-icon\"></div>\n              <div class=\"feature-info\">\n                <h3 class=\"feature-name\"></h3>\n                <p class=\"feature-description\"></p>\n              </div>\n              <div class=\"feature-arrow\">→</div>\n            </div><div \n              class=\"feature-card\"\n              role=\"button\"\n              tabindex=\"0\"\n            >\n              <div class=\"feature-icon\"></div>\n              <div class=\"feature-info\">\n                <h3 class=\"feature-name\"></h3>\n                <p class=\"feature-description\"></p>\n              </div>\n              <div class=\"feature-arrow\">→</div>\n            </div><div \n              class=\"feature-card\"\n              role=\"button\"\n              tabindex=\"0\"\n            >\n              <div class=\"feature-icon\"></div>\n              <div class=\"feature-info\">\n                <h3 class=\"feature-name\"></h3>\n                <p class=\"feature-description\"></p>\n              </div>\n              <div class=\"feature-arrow\">→</div>\n            </div><div \n              class=\"feature-card\"\n              role=\"button\"\n              tabindex=\"0\"\n            >\n              <div class=\"feature-icon\"></div>\n              <div class=\"feature-info\">\n                <h3 class=\"feature-name\"></h3>\n                <p class=\"feature-description\"></p>\n              </div>\n              <div class=\"feature-arrow\">→</div>\n            </div>\n        </div>\n      </div>\n\n      <!-- System Status -->\n      <div class=\"system-status\">\n        <h2>System Status</h2>\n        \n        <div class=\"status-grid\">\n          <div class=\"status-card\">\n            <div class=\"status-icon\">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"systemStatus.health === 'operational'\">🟢\n              \n                🔴</div>\n            </div>\n            <div class=\"status-info\">\n              <h4>System Health</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"systemStatus.healthMessage\"></span></p>\n            </div>\n          </div>\n          <div class=\"status-card\">\n            <div class=\"status-icon\">📊</div>\n            <div class=\"status-info\">\n              <h4>Active Tenants</h4>\n              <p>\n                \n                  <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"systemStatus.activeTenants\"></span> tenant<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"systemStatus.activeTenants !== 1 ? 's' : ''\"></span> active\n                \n              </p>\n            </div>\n          </div>\n          <div class=\"status-card\">\n            <div class=\"status-icon\">👥</div>\n            <div class=\"status-info\">\n              <h4>Total Users</h4>\n              <p>\n                \n                  <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"systemStatus.totalUsers\"></span> users across all tenants\n                \n              </p>\n            </div>\n          </div>\n          <div class=\"status-card\">\n            <div class=\"status-icon\">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"systemStatus.databaseStatus === 'connected'\">💾\n              \n                ⚠️</div>\n            </div>\n            <div class=\"status-info\">\n              <h4>Database</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"systemStatus.databaseMessage\"></span></p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Remote Agents Status Section -->\n      <div class=\"remote-agents-section\">\n        <div class=\"section-header\">\n          <h2>📡 Remote Agents Status</h2>\n          <button class=\"refresh-btn\">\n            🔄 Refresh\n          </button>\n        </div>\n\n        \n      </div>\n      </div>\n    </div>";
}

@page GET "/admin/system-management"
page admin_system_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/admin/system-management", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"system-admin-page\">\n    <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"AdminBreadcrumb\" aria-hidden=\"true\"></nav>\n    <div class=\"admin-header\">\n      <h1>🔧 System Administration</h1>\n      <p>Manage all tenants and system settings</p>\n    </div>\n\n    \n\n    <div class=\"admin-content\">\n      <div class=\"tenants-list\">\n        <h2>All Tenants (2)</h2>\n        \n        \n      </div>\n\n      \n    </div>\n\n    <!-- Remote Agents Status Section (Global/System-wide) -->\n    <div class=\"remote-agents-section\">\n      <div class=\"section-header\">\n        <h2>📡 Remote Agents Status (System-wide)</h2>\n        <button class=\"btn btn-secondary\">\n          Refresh\n        </button>\n      </div>\n\n        \n          <div class=\"agents-table-container\">\n            <table class=\"agents-table\">\n              <thead>\n                <tr>\n                  <th>Tenant</th>\n                  <th>Type</th>\n                  <th>ID</th>\n                  <th>Name/Code</th>\n                  <th>First Check-in</th>\n                  <th>Last Check-in</th>\n                  <th>Status</th>\n                  <th>Hardware Linked</th>\n                </tr>\n              </thead>\n              <tbody>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"remoteAgents as agent (agent.epc_id || agent.device_id)\"><tr>\n                    <td>\n                      <strong></strong>\n                    </td>\n                    <td>\n                      <span class=\"agent-type-badge type-\">\n                        \n                      </span>\n                    </td>\n                    <td>\n                      <code></code>\n                    </td>\n                    <td>\n                      \n                    </td>\n                    <td></td>\n                    <td>\n                      \n                      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"agent.time_since_checkin !== null && agent.time_since_checkin !== undefined\"><br>\n                        <small class=\"time-ago\"></small></div>\n                    </td>\n                    <td>\n                      <span class=\"status-badge status-\">\n                        \n                      </span>\n                    </td>\n                    <td>\n                      <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"agent.hardware_linked\"><span class=\"linked-badge linked\">✓ Linked</span>\n                        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"agent.hardware_link_type\"><br><small>()</small></div></div>\n                    </td>\n                  </tr></div>\n              </tbody>\n            </table>\n          </div>\n        \n      </div>\n\n    \n  </div>";
}

@page GET "/admin/tenant-management"
page admin_tenant_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/admin/tenant-management", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"admin-page\">\n  <header>\n    <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"AdminBreadcrumb\" aria-hidden=\"true\"></nav>\n    <div class=\"header-content\">\n      <div class=\"header-title\">\n        <h1>🏢 Platform Admin - Tenant Management</h1>\n        <p>Create and manage organization tenants</p>\n      </div>\n      <button class=\"btn-create\">\n        ➕ Create New Tenant\n      </button>\n    </div>\n  </header>\n  \n  <main>\n    \n      <div class=\"tenants-grid\">\n        <div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <h3></h3>\n              <span class=\"tenant-status\">\n                \n              </span>\n            </div>\n            \n            <div class=\"tenant-details\">\n              <div class=\"detail-row\">\n                <span class=\"label\">Organization Name:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Subdomain:</span>\n                <span class=\"value monospace\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Contact Email:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Users:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Status:</span>\n                <span class=\"value\">\n                  <label class=\"status-toggle\">\n                    <input \n                      type=\"checkbox\"/>\n                    <span class=\"toggle-slider\"></span>\n                    <span class=\"toggle-label\"></span>\n                  </label>\n                </span>\n              </div>\n            </div>\n            \n            <div class=\"tenant-actions\">\n              <button class=\"btn-action btn-users\">\n                👥 View Users ()\n              </button>\n              <button class=\"btn-action btn-owner\">\n                👤 Assign Owner\n              </button>\n              <button class=\"btn-action btn-edit\">\n                ✏️ Edit\n              </button>\n              <button class=\"btn-action btn-delete\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div><div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <h3></h3>\n              <span class=\"tenant-status\">\n                \n              </span>\n            </div>\n            \n            <div class=\"tenant-details\">\n              <div class=\"detail-row\">\n                <span class=\"label\">Organization Name:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Subdomain:</span>\n                <span class=\"value monospace\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Contact Email:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Users:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"detail-row\">\n                <span class=\"label\">Status:</span>\n                <span class=\"value\">\n                  <label class=\"status-toggle\">\n                    <input \n                      type=\"checkbox\"/>\n                    <span class=\"toggle-slider\"></span>\n                    <span class=\"toggle-label\"></span>\n                  </label>\n                </span>\n              </div>\n            </div>\n            \n            <div class=\"tenant-actions\">\n              <button class=\"btn-action btn-users\">\n                👥 View Users ()\n              </button>\n              <button class=\"btn-action btn-owner\">\n                👤 Assign Owner\n              </button>\n              <button class=\"btn-action btn-edit\">\n                ✏️ Edit\n              </button>\n              <button class=\"btn-action btn-delete\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div>\n      </div>\n    \n  </main>\n</div>\n\n<!-- Create/Edit Modal -->\n\n\n<!-- Delete Confirmation Modal -->\n\n\n<!-- Assign Owner Modal -->\n\n\n<!-- Users Modal -->\n";
}

@page GET "/admin/tenants/:tenantId/modules"
page admin_tenants_tenantId_modules_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/admin/tenants/:tenantId/modules", apiPath: "/api/admin", api_ok: true, api_surface: "wisp-api-native", api_resource: "admin-prefix", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"admin-page\">\n  <div class=\"page-header\">\n    <button class=\"back-button\">\n      ← Back to Tenants\n    </button>\n    <h1>Module Configuration</h1>\n    \n  </div>\n  \n  \n  \n  \n  \n  \n    <div class=\"config-container\">\n      \n      <!-- Subscription Tier -->\n      <div class=\"section\">\n        <h2>📋 Subscription Tier</h2>\n        <div class=\"tier-selector\">\n          <select>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"tiers as tier\"><option></option></div>\n          </select>\n          <button class=\"btn-secondary\">\n            Apply Tier Defaults\n          </button>\n        </div>\n      </div>\n      \n      <!-- Enabled Modules -->\n      <div class=\"section\">\n        <h2>🎛️ Enabled Modules</h2>\n        <div class=\"module-toggles\">\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📊</span>\n              <span>PCI Resolution & Network Optimization</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📡</span>\n              <span>CBRS Management</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📡</span>\n              <span>ACS CPE Management</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🔐</span>\n              <span>HSS & Subscriber Management</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🗺️</span>\n              <span>Coverage Map</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📦</span>\n              <span>Inventory Management</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🌐</span>\n              <span>Distributed EPC (Advanced)</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">🔍</span>\n              <span>Monitoring & Alerts</span>\n            </span>\n          </label>\n\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span class=\"toggle-icon\">📞</span>\n              <span>Voice / SIP & UC</span>\n            </span>\n          </label>\n        </div>\n      </div>\n      \n      <!-- Usage Limits -->\n      <div class=\"section\">\n        <h2>📊 Usage Limits</h2>\n        <div class=\"limits-grid\">\n          <div class=\"limit-item\">\n            <label>Max Tower Sites</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n          \n          <div class=\"limit-item\">\n            <label>Max Subscribers</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n          \n          <div class=\"limit-item\">\n            <label>Max CPE Devices</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n          \n          <div class=\"limit-item\">\n            <label>Max Users</label>\n            <input type=\"number\" min=\"1\" />\n          </div>\n          \n          <div class=\"limit-item\">\n            <label>Max Inventory Items</label>\n            <input type=\"number\" min=\"0\" />\n          </div>\n        </div>\n        <p class=\"help-text\">Set to 999999 for unlimited</p>\n      </div>\n      \n      <!-- Feature Flags -->\n      <div class=\"section\">\n        <h2>⭐ Feature Flags</h2>\n        <div class=\"feature-toggles\">\n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>Advanced Reporting</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>API Access</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>White Label</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>Custom Integrations</span>\n            </span>\n          </label>\n          \n          <label class=\"toggle-item\">\n            <input type=\"checkbox\" />\n            <span class=\"toggle-label\">\n              <span>Priority Support</span>\n            </span>\n          </label>\n        </div>\n      </div>\n      \n      <!-- Save Button -->\n      <div class=\"actions\">\n        <button class=\"btn-secondary\">\n          Cancel\n        </button>\n        <button class=\"btn-primary\">\n          💾 Save Configuration\n        </button>\n      </div>\n    </div>\n  \n</div>";
}

