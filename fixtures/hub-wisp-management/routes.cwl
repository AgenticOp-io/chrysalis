  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/voice-telephony", apiPath: "/api/voice", api_ok: true, api_surface: "wisp-api-native", api_resource: "voice", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"voice-page\">\\r\n    <header class=\"page-head\">\\r\n      <div class=\"page-head-row\">\\r\n        <h1>Voice / SIP & UC</h1>\\r\n        <div class=\"page-toolbar\">\\r\n          <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav>\\r\n          <button type=\"button\" class=\"btn tips-btn\">Tips</button>\\r\n        </div>\\r\n      </div>\\r\n      <p class=\"sub\">\\r\n        Tenant-scoped numbers, carrier accounts, E911, and porting. Webhook ingress:\\r\n        <code>POST /api/voice/webhooks/:provider</code> (HMAC when <code>VOICE_WEBHOOK_SECRET</code> is set).\\r\n        Customer records link via <code>customerId</code> (same id as Customers module).\\r\n      </p>\\r\n    </header>\\r\n\\r\n    <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> (showTipsModal = false)} />\\r\n\\r\n    \\r\n\\r\n    \\r\n\\r\n    <nav class=\"tabs\">\\r\n      <button type=\"button\">Overview</button>\\r\n      <button type=\"button\">Provider accounts</button>\\r\n      <button type=\"button\">Numbers</button>\\r\n      <button type=\"button\">Port orders</button>\\r\n      <button type=\"button\">Service locations</button>\\r\n    </nav>\\r\n\\r\n    \\r\n      <section class=\"panel\">\\r\n        <div class=\"row\">\\r\n          <h2>Service locations (E911 / geocode)</h2>\\r\n          <button type=\"button\" class=\"btn primary\">Add location</button>\\r\n        </div>\\r\n        <p class=\"muted small\">\\r\n          Use the same <code>customerId</code> as the Customers module to tie addresses together. Coverage Map opens centered on\\r\n          coordinates when available.\\r\n        </p>\\r\n        \\r\n      </section>\\r\n    \\r\n  </div>\\r\n\\r\n  \\r\n\\r\n  \\r\n\\r\n  \\r\n\\r\n  ";
}

@page GET "/modules/work-orders"
page modules_work_orders_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/work-orders", apiPath: "/api/work-orders", api_ok: true, api_surface: "wisp-api-native", api_resource: "work-orders", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"work-orders-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📋 Work Orders & Tickets</h1>\n      <p class=\"subtitle\">Field operations and trouble ticket management</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn-secondary\">\n        ➕ Quick Create\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> true}\n      />\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Tickets</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔓</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Open</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⚡</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          \n        </div>\n        <div class=\"stat-label\">High Priority</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          h\n        </div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Priorities</option>\n        \n      </select>\n      \n      <select>\n        <option>All Types</option>\n        \n      </select>\n      \n      <button class=\"btn-secondary\">\n        Clear Filters\n      </button>\n    </div>\n  </div>\n  \n  <!-- Work Orders List -->\n  \n    <div class=\"work-orders-grid\">\n      \n      \n      \n    </div>\n  \n  \n  <!-- Create Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"CreateWorkOrderModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n  \n  <!-- Work Order Creation Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"WorkOrderCreationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n</div>";
}

@page GET "/modules/work-orders/:id"
page modules_work_orders_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/work-orders/:id", apiPath: "/api/work-orders", api_ok: true, api_surface: "wisp-api-native", api_resource: "work-orders", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"work-order-details\">\n  <div class=\"page-header\">\n    <button class=\"back-button\">\n      ← Back to Work Orders\n    </button>\n    \n    <div class=\"header-content\">\n        <div class=\"header-left\">\n          <h1>Work Order</h1>\n          <p class=\"subtitle\"></p>\n        </div>\n        \n        <div class=\"header-badges\">\n          <div \n            class=\"priority-badge\" \n            style=\"background-color:\"\n          >\n            \n          </div>\n          \n          <div \n            class=\"status-badge\" \n            style=\"background-color:\"\n          >\n            open\n          </div>\n        </div>\n      </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  \n    <div class=\"content-grid\">\n      <!-- Main Content -->\n      <div class=\"main-column\">\n        <!-- Description -->\n        <div class=\"card\">\n          <h3>📋 Description</h3>\n          <p class=\"description\">No description provided</p>\n          \n          \n        </div>\n        \n        <!-- Location -->\n        \n        \n        <!-- Customer Info -->\n        \n        \n        <!-- Resolution -->\n        \n        \n        <!-- Work Log -->\n        \n      </div>\n      \n      <!-- Sidebar -->\n      <div class=\"sidebar-column\">\n        <!-- Actions -->\n        <div class=\"card actions-card\">\n          <h3>⚡ Quick Actions</h3>\n          \n          <button \n              class=\"action-btn start-btn\"\n            >\n              ▶️ Start Work\n            </button>\n          \n          \n          \n          \n          \n          <button \n            class=\"action-btn secondary-btn\"\n          >\n            ✏️ Edit Details\n          </button>\n        </div>\n        \n        <!-- Details -->\n        <div class=\"card\">\n          <h3>ℹ️ Details</h3>\n          \n          <div class=\"detail-list\">\n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Type:</span>\n              <span class=\"detail-value\"></span>\n            </div>\n            \n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Created:</span>\n              <span class=\"detail-value\">2026-07-01 12:00:00</span>\n            </div>\n            \n            \n            \n            \n            \n            \n            \n            \n          </div>\n        </div>\n        \n        <!-- SLA -->\n        \n        \n        <!-- Timeline -->\n        <div class=\"card\">\n          <h3>📅 Timeline</h3>\n          \n          <div class=\"timeline\">\n            <div class=\"timeline-item\">\n              <span class=\"timeline-icon\">📝</span>\n              <div class=\"timeline-content\">\n                <span class=\"timeline-label\">Created</span>\n                <span class=\"timeline-time\">2026-07-01 12:00:00</span>\n              </div>\n            </div>\n            \n            \n            \n            \n            \n            \n            \n            \n          </div>\n        </div>\n      </div>\n    </div>\n  \n</div>";
}

