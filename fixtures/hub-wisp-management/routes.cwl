@page GET "/modules/customers/portal/live-chat"
page modules_customers_portal_live_chat_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/live-chat", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"chat-page\">\n    <h1>Live Chat with WISP Management</h1>\n    <p class=\"subtitle\">Chat is monitored . Start a conversation and we’ll respond as soon as a specialist is available.</p>\n    \n    <div class=\"chat-wrapper\">\n      <div class=\"chat-placeholder\">        \n      </div>\n      <div class=\"fallback-card\">\n        <h2>Need immediate help?</h2>\n        <p>If chat is offline, use one of the options below.</p>\n        <a class=\"btn-link\">Email </a>\n        \n      </div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/login"
page modules_customers_portal_login_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/login", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"login-page\">\n  <div class=\"login-container\">\n    <div class=\"login-header\">\n      \n      <h2>Sign In</h2>\n      <p class=\"login-subtitle\">Access your account to view tickets and service information</p>\n    </div>\n    \n      <form class=\"login-form\">\n      \n      \n      <div class=\"form-group\">\n        <label for=\"identifier\">Customer ID, Email, or Phone</label>\n        <input\n          id=\"identifier\"\n          type=\"text\"\n          placeholder=\"Enter your customer ID, email, or phone\"\n          required\n        />\n      </div>\n      \n      <div class=\"form-group\">\n        <label for=\"password\">Password</label>\n        <input\n          id=\"password\"\n          type=\"password\"\n          placeholder=\"Enter your password\"\n          required\n        />\n      </div>\n      \n      <button type=\"submit\" class=\"btn-primary\">\n        Sign In\n      </button>\n    </form>\n    <div class=\"login-links\">\n      \n    </div>\n  </div>\n</div>";
}

@page GET "/modules/customers/portal/service"
page modules_customers_portal_service_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/service", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"service-page\">\n    <p class=\"back-link\"><a href=\"/modules/customers/portal/dashboard\">← Back to Dashboard</a></p>\n    <h1>Service Information</h1>\n    \n    <div class=\"service-details\">\n      <div class=\"info-section\">\n        <h2>Service Status</h2>\n        <div class=\"info-card\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Status:</span>\n            <span class=\"info-value status-\">\n              active\n            </span>\n          </div>\n          <div class=\"info-row\">\n              <span class=\"info-label\">Service Plan:</span>\n              <span class=\"info-value\">Residential 100</span>\n            </div>\n        </div>\n      </div>\n      \n      \n      \n      \n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/signup"
page modules_customers_portal_signup_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/signup", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"signup-page\">\n  <div class=\"signup-container\">\n    <div class=\"signup-header\">\n      \n      <h2>Create Account</h2>\n      <p class=\"signup-subtitle\">Link your customer account to access the portal</p>\n    </div>\n    \n    \n      <form class=\"signup-form\">\n        \n        \n        <div class=\"form-group\">\n          <label for=\"customerId\">Customer ID</label>\n          <input\n            id=\"customerId\"\n            type=\"text\"\n            placeholder=\"Enter your customer ID\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"phone\">Phone Number</label>\n          <input\n            id=\"phone\"\n            type=\"tel\"\n            placeholder=\"Enter your phone number\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"email\">Email Address</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"Enter your email\"\n            required\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"password\">Password</label>\n          <input\n            id=\"password\"\n            type=\"password\"\n            placeholder=\"Create a password (min 6 characters)\"\n            required\n            minlength=\"6\"\n          />\n        </div>\n        \n        <div class=\"form-group\">\n          <label for=\"confirmPassword\">Confirm Password</label>\n          <input\n            id=\"confirmPassword\"\n            type=\"password\"\n            placeholder=\"Confirm your password\"\n            required\n          />\n        </div>\n        \n        <button type=\"submit\" class=\"btn-primary\">\n          Create Account\n        </button>\n        \n        <div class=\"signup-links\">\n          <a href=\"/modules/customers/portal/login\" class=\"link\">Already have an account? Sign in</a>\n        </div>\n      </form>\n    \n  </div>\n</div>";
}

@page GET "/modules/customers/portal/tickets"
page modules_customers_portal_tickets_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"tickets-page\">\n  <div class=\"page-header\">\n    <h1>My Tickets</h1>\n    <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n      Create New Ticket\n    </a>\n  </div>\n  \n  <div class=\"filters\">\n    <select class=\"filter-select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"open\">Open</option>\n      <option value=\"assigned\">Assigned</option>\n      <option value=\"in-progress\">In Progress</option>\n      <option value=\"waiting-parts\">Waiting Parts</option>\n      <option value=\"resolved\">Resolved</option>\n      <option value=\"closed\">Closed</option>\n    </select>\n  </div>\n  \n  \n    <div class=\"tickets-list\">\n      \n    </div>\n  \n</div>";
}

@page GET "/modules/customers/portal/tickets/:id"
page modules_customers_portal_tickets_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets/:id", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"ticket-details-page\">\n    <div class=\"page-header\">\n      <a href=\"/modules/customers/portal/tickets\" class=\"back-link\">← Back to Tickets</a>\n      <h1>Ticket Details</h1>\n    </div>\n    \n    <div class=\"ticket-details\">\n      <div class=\"ticket-header\">\n        <div>\n          <span class=\"ticket-number\">N/A</span>\n          <span \n            class=\"ticket-status\" \n            style=\"background:\"\n          >\n            \n          </span>\n        </div>\n        <div class=\"ticket-meta\">\n          <span>Priority: </span>\n          <span>Created: </span>\n        </div>\n      </div>\n      \n      <div class=\"ticket-content\">\n        <h2></h2>\n        <p class=\"ticket-description\">No description</p>\n      </div>\n      \n      \n      \n      <div class=\"add-comment\">\n        <h3>Add Comment</h3>\n        <form>\n          <textarea\n            placeholder=\"Add a comment or update...\"\n            rows=\"4\"\n          ></textarea>\n          <button type=\"submit\" class=\"btn-primary\">\n            Add Comment\n          </button>\n        </form>\n      </div>\n    </div>\n  </div>";
}

@page GET "/modules/customers/portal/tickets/new"
page modules_customers_portal_tickets_new_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/tickets/new", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"create-ticket-page\">\n  <div class=\"page-header\">\n    <h1>Create New Ticket</h1>\n    <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Back to Tickets</a>\n  </div>\n  \n  <form class=\"ticket-form\">\n    \n    \n    <div class=\"form-group\">\n      <label for=\"title\">Title *</label>\n      <input\n        id=\"title\"\n        type=\"text\"\n        placeholder=\"Brief description of the issue\"\n        required\n      />\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"category\">Category</label>\n      <select id=\"category\">\n        <option value=\"slow-speed\">Slow Speed</option>\n        <option value=\"no-connection\">No Connection</option>\n        <option value=\"intermittent\">Intermittent Connection</option>\n        <option value=\"equipment-failure\">Equipment Failure</option>\n        <option value=\"billing-issue\">Billing Issue</option>\n        <option value=\"other\">Other</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"priority\">Priority</label>\n      <select id=\"priority\">\n        <option value=\"low\">Low</option>\n        <option value=\"medium\">Medium</option>\n        <option value=\"high\">High</option>\n        <option value=\"critical\">Critical</option>\n      </select>\n    </div>\n    \n    <div class=\"form-group\">\n      <label for=\"description\">Description *</label>\n      <textarea\n        id=\"description\"\n        placeholder=\"Please provide detailed information about the issue...\"\n        rows=\"6\"\n        required\n      ></textarea>\n    </div>\n    \n    <div class=\"form-actions\">\n      <button type=\"submit\" class=\"btn-primary\">\n        Create Ticket\n      </button>\n      <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">Cancel</a>\n    </div>\n  </form>\n</div>";
}

@page GET "/modules/deploy"
page modules_deploy_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { moduleKey: "deploy", source: "wisp-m30", apiPath: "/api/deploy", api_ok: true, api_surface: "wisp-api-native", api_resource: "deploy", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      <div class=\"cwl-map-shell\" data-cwl-map-shell=\"SharedMap\" aria-hidden=\"true\" role=\"img\"></div>\n    </div>\n\n    <!-- Minimal Header Overlay -->\n    <!-- Deploy Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-success);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\"} title=\"Back to Dashboard\">\n          ←\n        </button>\n        <h1>🚀 Deploy</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n        <button \n          class=\"module-control-btn\" \n          title=\"Project Filters - Approved projects ready for deployment\"\n        >\n          <span class=\"control-icon\">🔍</span>\n          <span class=\"control-label\">Approved ()</span>\n        </button>\n        <button class=\"module-control-btn\" title=\"Projects - View and manage all projects\">\n          <span class=\"control-icon\">📋</span>\n          <span class=\"control-label\">Projects ()</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"View Deployed Projects\"\n        >\n          <span class=\"control-icon\">✅</span>\n          <span class=\"control-label\">Deployed ()</span>\n        </button>\n        <button \n          class=\"module-control-btn\"}\n        >\n          <span class=\"control-icon\">📊</span>\n          <span class=\"control-label\">PCI </span>\n        </button>\n\n        <button \n          class=\"module-control-btn\"}\n        >\n          <span class=\"control-icon\">📡</span>\n          <span class=\"control-label\">Frequency </span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"View and Edit Deployed Hardware\"\n        >\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Hardware ()</span>\n        </button>\n        \n        <button \n          class=\"module-control-btn deploy-btn\"\n        >\n          <span class=\"control-icon\">🚀</span>\n          <span class=\"control-label\">Deploy Plan</span>\n        </button>\n        \n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n        />\n      </div>\n    </div>\n\n  </div>\n\n  \n\n  \n\n  \n\n  <!-- PCI Planner Modal -->\n  \n\n  <!-- Frequency Planner Modal -->\n  \n\n  <!-- Plan Approval Modal -->\n  \n  \n  <!-- Deployed Hardware Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"DeployedHardwareModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n  <!-- Site Details Modal -->\n  \n\n  \n  \n  <!-- Add Inventory Modal -->\n  \n  \n  <!-- Site Edit Modal -->\n  \n  \n  <!-- EPC Deployment Modal -->\n  \n  \n  <!-- Project Filter Panel -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ProjectFilterPanel\" aria-hidden=\"true\"></nav> false}\n  />\n  \n  <!-- Deployment Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"DeploymentWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Site Deployment Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"SiteDeploymentWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n\n  <!-- Plan Selection Modal (shows list of all plans) -->\n  \n  \n  <!-- Global Settings Button - Hidden in deploy mode, shown in coverage-map iframe instead -->\n\n  <!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

@page GET "/modules/hardware"
page modules_hardware_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/hardware", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"hardware-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>🔧 Hardware Management</h1>\n      <p class=\"subtitle\">Comprehensive equipment and hardware management system</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Check In\n      </button>\n      <button class=\"btn-secondary\">\n        📤 Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 Reports\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> true}\n      />\n      <!-- Add Hardware Dropdown -->\n      <div class=\"dropdown-container\">\n        <button class=\"btn-primary dropdown-toggle\">\n          ➕ Add Hardware ▼\n        </button>\n        \n      </div>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔧</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Hardware</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card clickable\">\n      <div class=\"stat-icon\">📡</div>\n      <div>\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">EPC/SNMP Devices</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\">12</div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Deployed/Online</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🏗️</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">In Maintenance</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Hardware Type Tabs -->\n  <div class=\"hardware-tabs\">\n    <button class=\"tab-btn\">\n      📋 All Hardware ()\n    </button>\n    <button class=\"tab-btn\">\n      📦 Inventory (3)\n    </button>\n    <button class=\"tab-btn\">\n      📡 EPC/SNMP Devices (1)\n    </button>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer, asset tag...\"\n        />\n        <button class=\"search-btn\">Search</button>\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        \n      </select>\n      \n      \n      \n      <button class=\"btn-clear\">\n        Clear Filters\n      </button>\n    </div>\n    \n    <!-- Category Quick Filters -->\n    <div class=\"category-filters\">\n      \n        \n        \n        \n        \n    </div>\n  </div>\n  \n  <!-- Hardware Content -->\n  \n    <!-- EPC/SNMP Devices Section -->\n    \n  \n  \n  <!-- Inventory Items Section -->\n  \n</div>\n\n<!-- Scan Modal -->\n\n\n<!-- EPC Deployment Wizard -->\n\n\n<!-- EPC Edit Modal -->\n";
}

@page GET "/modules/help-desk"
page modules_help_desk_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/help-desk", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"help-desk-container\">\n  <div class=\"header\">\n    <button class=\"btn-back\">\n      ← Back to Modules\n    </button>\n    \n    <div class=\"title-section\">\n      <h1>🎧 Help Desk</h1>\n      <p class=\"subtitle\">Customer support and ticket management for Demo Tenant</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button \n        class=\"btn btn-secondary btn-reports\"\n        title=\"View Ticket Reports and Analytics\"\n      >\n        📊 Reports\n      </button>\n      <button class=\"btn btn-secondary\">\n        🔍 Customer Lookup\n      </button>\n      <button class=\"btn btn-primary\">\n        ➕ Create Ticket\n      </button>\n    </div>\n  </div>\n  \n  \n  \n  <div class=\"stats-grid\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon open\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Open Tickets</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon in-progress\">⚙️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">In Progress</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon resolved\">✅</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Resolved</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon time\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n  \n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search tickets, customers...\"\n      />\n    </div>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"open\">Open</option>\n      <option value=\"assigned\">Assigned</option>\n      <option value=\"in-progress\">In Progress</option>\n      <option value=\"waiting-parts\">Waiting Parts</option>\n      <option value=\"resolved\">Resolved</option>\n      <option value=\"closed\">Closed</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Priority</option>\n      <option value=\"critical\">Critical</option>\n      <option value=\"high\">High</option>\n      <option value=\"medium\">Medium</option>\n      <option value=\"low\">Low</option>\n    </select>\n    \n    <select class=\"select\">\n      <option value=\"all\">All Categories</option>\n      <option value=\"customer-facing\">Customer-Facing</option>\n      <option value=\"infrastructure\">Infrastructure</option>\n    </select>\n    \n    <div class=\"results-count\">\n       of 1 tickets\n    </div>\n  </div>\n  \n  \n    <div class=\"tickets-grid\">\n      \n    </div>\n  \n</div>\n\n\n\n";
}

@page GET "/modules/help-desk/reports"
page modules_help_desk_reports_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/help-desk/reports", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"reports-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Help Desk\n      </button>\n      <h1>📊 Ticket Reports & Analytics</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn btn-primary\">\n        🖨️ Print PDF\n      </button>\n    </div>\n  </div>\n\n  \n    <!-- Summary Cards -->\n    <div class=\"summary-grid\">\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">🎧</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">10</div>\n          <div class=\"card-label\">Total Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card open\">\n        <div class=\"card-icon\">📋</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Open Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card resolved\">\n        <div class=\"card-icon\">✅</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Resolved Tickets</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">⏱️</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Avg Resolution Time</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Alerts -->\n    \n\n    \n\n    <!-- Charts -->\n    <div class=\"charts-grid\">\n      <!-- Status Distribution -->\n      <div class=\"chart-card\">\n        <h3>Status Distribution</h3>\n        \n      </div>\n\n      <!-- Priority Distribution -->\n      <div class=\"chart-card\">\n        <h3>Priority Distribution</h3>\n        \n      </div>\n\n      <!-- Category Distribution -->\n      <div class=\"chart-card\">\n        <h3>Category Distribution</h3>\n        \n      </div>\n\n      <!-- Type Distribution -->\n      <div class=\"chart-card\">\n        <h3>Type Distribution</h3>\n        \n      </div>\n    </div>\n\n    <!-- Detailed Tables -->\n    <div class=\"table-section\">\n      <h3>By Status</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Priority</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Priority</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Category</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Category</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Assigned To</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Assigned To</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>SLA Compliance</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>On Time</td>\n            <td>8</td>\n            <td>%</td>\n          </tr>\n          <tr>\n            <td>Breached</td>\n            <td>2</td>\n            <td>%</td>\n          </tr>\n          <tr>\n            <td>No SLA</td>\n            <td></td>\n            <td>-</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  \n</div>";
}

