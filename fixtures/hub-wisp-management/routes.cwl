  return html "<div class=\"billing-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-content\">\n        <button class=\"back-btn\">\n          <span class=\"back-icon\">←</span>\n          Back to Dashboard\n        </button>\n        <div class=\"module-title\">\n          <h1>💳 Billing & Subscriptions</h1>\n          <p>Manage your subscription and billing information</p>\n        </div>\n        <div class=\"tenant-info\">\n          <span class=\"tenant-name\">Demo Tenant</span>\n            <span class=\"tenant-subdomain\">demo</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main Content -->\n    <div class=\"module-content\">\n      \n\n      \n        <!-- Current Subscription -->\n        <div class=\"current-subscription\">\n          <h2>Current Subscription</h2>\n          \n        </div>\n\n        <!-- Available Plans -->\n        <div class=\"plans-section\">\n          <h2>Available Plans</h2>\n          <div class=\"plans-grid\">\n            <div class=\"plan-card \">\n                \n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <li>✓ </li><li>✓ </li>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button \n                  class=\"select-plan-btn\">\n                  \n                </button>\n              </div><div class=\"plan-card \">\n                \n                <div class=\"plan-header\">\n                  <h3></h3>\n                  <div class=\"plan-price\">\n                    <span class=\"price\"></span>\n                    <span class=\"interval\">/</span>\n                  </div>\n                </div>\n                <p class=\"plan-description\"></p>\n                <ul class=\"plan-features\">\n                  <li>✓ </li><li>✓ </li><li>✓ </li>\n                </ul>\n                <div class=\"plan-limits\">\n                  <span>Up to  users</span>\n                </div>\n                <button \n                  class=\"select-plan-btn\">\n                  \n                </button>\n              </div>\n          </div>\n        </div>\n\n        <!-- Payment Methods -->\n        <div class=\"payment-methods-section\">\n          <h2>Payment Methods</h2>\n          \n        </div>\n\n        <!-- Recent Invoices -->\n        <div class=\"invoices-section\">\n          <h2>Recent Invoices</h2>\n          \n        </div>\n      \n    </div>\n\n    <!-- Edit Payment Method Modal -->\n    \n  </div>";
}

@page GET "/modules/cbrs-management"
page modules_cbrs_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/cbrs-management", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- CBRS Setup Wizard -->\n\n<!-- CBRS Device Registration Wizard -->\n<div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"CBRSDeviceRegistrationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cbrs-module\">\n  <!-- Header -->\n  <div class=\"module-header\">\n    <div class=\"header-content\">\n      <div class=\"header-left\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          Back to Dashboard\n        </a>\n        <h1 class=\"module-title\">\n          <span class=\"module-icon\">📡</span>\n          CBRS Management\n        </h1>\n        <p class=\"module-description\">Citizens Broadband Radio Service spectrum management</p>\n        \n        <div class=\"tenant-badge\">\n            <span class=\"tenant-icon\">🏢</span>\n            <span class=\"tenant-text\">Demo Tenant</span>\n          </div>\n      </div>\n      \n      <div class=\"header-actions\">\n        \n        <button class=\"btn btn-secondary\" title=\"Configure SAS providers\">\n          ⚙️ Settings\n        </button>\n        <button class=\"btn btn-primary\">\n          + Add CBSD Device\n        </button>\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n        />\n      </div>\n    </div>\n  </div>\n\n  \n  \n  <div class=\"error-banner\">\n      <span class=\"error-icon\">⚠️</span>\n      <span class=\"error-message\">\n        No tenant selected. Please return to the \n        <a href=\"/dashboard\" class=\"inline-link\">dashboard</a> \n        and select a tenant first.\n      </span>\n    </div>\n\n  <!-- Main Content -->\n  <div class=\"module-content\">\n    <!-- Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📡</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Total Devices</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">✅</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Registered</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">📊</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"></div>\n          <div class=\"stat-label\">Active Grants</div>\n        </div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-icon\">🌐</div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\"> MHz</div>\n          <div class=\"stat-label\">CBRS Band</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Map -->\n    <div class=\"map-section\">\n      <div class=\"map-header\">\n        <h3>CBSD Device Map</h3>\n        <div class=\"legend\">\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #10b981;\"></span>\n            <span>Active</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #3b82f6;\"></span>\n            <span>Registered</span>\n          </div>\n          <div class=\"legend-item\">\n            <span class=\"legend-color\" style=\"background: #6b7280;\"></span>\n            <span>Unregistered</span>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"map-container\">\n        <div class=\"arcgis-map\"></div>\n        \n        \n      </div>\n    </div>\n\n    <!-- Device List and Grant Status -->\n    <div class=\"content-grid\">\n      <div class=\"device-list-section\">\n        <h3>CBSD Devices</h3>\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"DeviceList\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>cpe-1</td><td>online</td></tr><tr><td>cpe-2</td><td>degraded</td></tr></tbody></table></div> true}\n        />\n      </div>\n      \n      \n    </div>\n  </div>\n</div>\n\n<!-- Add Device Modal -->\n\n\n<!-- Grant Request Modal -->\n\n\n<!-- Settings Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SettingsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<!-- User ID / Network Selector Modal (includes Google login) -->\n<div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"UserIDSelector\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>s1</td><td>online</td></tr></tbody></table></div> false}\n/>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<!-- Quick Tips Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

@page GET "/modules/coverage-map"
page modules_coverage_map_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { moduleKey: "coverage-map", source: "wisp-m30", apiPath: "/api/coverage", vendor: "arcgis-map", api_ok: true, itemCount: 1, tracedApiStatus: 200 };
  return html "<svelte:window />\n\n<div class=\"fullscreen-map\">\n  <!-- Full Screen Map -->\n  \n    <div class=\"cwl-map-shell\" data-cwl-map-shell=\"CoverageMapView\" aria-hidden=\"true\" role=\"img\"></div>\n  \n\n  \n\n  <!-- Floating Control Panel -->\n  <div class=\"floating-controls\">\n    <button class=\"control-btn\" title=\"Toggle Filters\">\n        🔍\n      </button>\n    <button class=\"control-btn\" title=\"Toggle Statistics\">\n        📊\n      </button>\n    <button \n      class=\"control-btn\" \n      title=\"Device Management (SNMP, TR-069, MikroTik, EPC)\"\n    >\n      📱\n    </button>\n    \n    <!-- Map Type Toggle -->\n    <div class=\"control-group\">\n      <button class=\"control-btn map-control-btn\" title=\"Toggle Map Type\">\n        🗺️\n      </button>\n      <div class=\"control-dropdown\">\n        <div class=\"dropdown-section\">\n          <div class=\"dropdown-label\">Map View</div>\n          <div class=\"basemap-switcher-inline\">\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Streets\"\n            >\n              🛣️\n            </button>\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Satellite\"\n            >\n              🛰️\n            </button>\n            <button \n              class=\"basemap-btn-inline\"\n              title=\"Topographic\"\n            >\n              🗺️\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Help Button - Fixed Position -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n  \n\n  <!-- Filters Modal -->\n  \n\n  <!-- Statistics Modal -->\n  \n\n  <!-- Messages -->\n  \n  \n  \n</div>\n\n<!-- Unified Device Management -->\n<div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"DeviceManagementPanel\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>c1</td><td>active</td></tr></tbody></table></div> }\n/>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"UnifiedDeviceDetailsModal\" aria-hidden=\"true\" role=\"dialog\"></div> }\n/>\n\n<!-- Modals -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddSiteModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddNOCModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddWarehouseModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddVehicleModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddRMAModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddSectorModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddCPEModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddBackhaulLinkModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AddInventoryModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n\n<!-- Context Menus -->\n<div class=\"cwl-map-shell\" data-cwl-map-shell=\"MapContextMenu\" aria-hidden=\"true\" role=\"img\"></div>\n\n<nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"TowerActionsMenu\" aria-hidden=\"true\"></nav>\n\n<nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"SectorActionsMenu\" aria-hidden=\"true\"></nav>\n\n<nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"BackhaulActionsMenu\" aria-hidden=\"true\"></nav>\n\n<!-- EPC Deployment Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"EPCDeploymentModal\" aria-hidden=\"true\" role=\"dialog\"></div> }\n/>\n\n<!-- HSS Registration Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HSSRegistrationModal\" aria-hidden=\"true\" role=\"dialog\"></div> }\n/>\n\n<!-- Hardware Deployment Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HardwareDeploymentModal\" aria-hidden=\"true\" role=\"dialog\"></div> }\n/>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<!-- Site Edit Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SiteEditModal\" aria-hidden=\"true\" role=\"dialog\"></div> }\n/>\n\n<!-- Global Settings Button - Removed from modules -->";
}

@page GET "/modules/customers"
page modules_customers_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"customers-page\">\n    <div class=\"page-header\">\n      <div class=\"header-content\">\n        <div class=\"header-top\">\n          <button class=\"back-btn\" title=\"Back to Module Manager\">\n            ←\n          </button>\n          <h1>👥 Customer Management</h1>\n        </div>\n        <p class=\"subtitle\">Manage your tenant's customers, service plans, and customer groups</p>\n      </div>\n      <div class=\"header-actions\">\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n          />\n          <button class=\"btn-primary\">\n            ➕ Add Customer\n          </button>\n      </div>\n    </div>\n    \n    <!-- Navigation Tabs -->\n    <div class=\"tabs\">\n      <button\n      >\n        👥 Customers\n      </button>\n      <button\n      >\n        📡 Service Plans\n      </button>\n      <button\n      >\n        📦 Customer Groups\n      </button>\n      <button\n      >\n        🌐 Portal\n      </button>\n    </div>\n    \n    \n    \n    \n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      <!-- Customers Tab -->\n        <!-- Stats Cards -->\n        <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">3</div>\n        <div class=\"stat-label\">Total Customers</div>\n      </div>\n      <div class=\"stat-card stat-active\">\n        <div class=\"stat-value\">2</div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card stat-pending\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Pending</div>\n      </div>\n      <div class=\"stat-card stat-suspended\">\n        <div class=\"stat-value\">0</div>\n        <div class=\"stat-label\">Suspended</div>\n      </div>\n    </div>\n    \n    <!-- Search and Filters -->\n    <div class=\"filters-section\">\n      <div class=\"search-bar\">\n        <input\n          type=\"text\"\n          placeholder=\"Search by name, phone, email, or customer ID...\"\n          class=\"search-input\"\n        />\n      </div>\n      \n      <div class=\"filter-controls\">\n        <select>\n          <option>All Statuses</option>\n          <option value=\"active\">Active</option>\n          <option value=\"pending\">Pending</option>\n          <option value=\"suspended\">Suspended</option>\n          <option value=\"cancelled\">Cancelled</option>\n          <option value=\"trial\">Trial</option>\n        </select>\n        \n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" />\n          Show Inactive\n        </label>\n      </div>\n    </div>\n    \n    <!-- Customer List -->\n    <div class=\"customers-list\">\n      \n        <div class=\"customer-grid\">\n          <div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> $`}</h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n                  \n                </span>\n              </div>\n              \n              <div class=\"customer-details\">\n                \n                \n                <div class=\"detail-row\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n                \n                \n                \n                \n                \n                \n                \n                \n              </div>\n              \n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a \n                  href=\"/modules/customers/portal/login\" \n                  target=\"_blank\" \n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div><div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> $`}</h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n                  \n                </span>\n              </div>\n              \n              <div class=\"customer-details\">\n                \n                \n                <div class=\"detail-row\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n                \n                \n                \n                \n                \n                \n                \n                \n              </div>\n              \n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a \n                  href=\"/modules/customers/portal/login\" \n                  target=\"_blank\" \n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div><div class=\"customer-card\">\n              <div class=\"customer-header\">\n                <div class=\"customer-name-section\">\n                  <h3> $`}</h3>\n                  <span class=\"customer-id\"></span>\n                </div>\n                <span class=\"status-badge \">\n                  \n                </span>\n              </div>\n              \n              <div class=\"customer-details\">\n                \n                \n                <div class=\"detail-row\">\n                    <span class=\"detail-icon\">📧</span>\n                    <span></span>\n                  </div>\n                \n                \n                \n                \n                \n                \n                \n                \n              </div>\n              \n              <div class=\"customer-actions\">\n                <button class=\"btn-secondary btn-sm\">\n                  ✏️ Edit\n                </button>\n                <button class=\"btn-danger btn-sm\">\n                  🗑️ Delete\n                </button>\n                <button class=\"btn-secondary btn-sm\">\n                  👁️ View\n                </button>\n                <button\n                  type=\"button\"\n                  class=\"btn-secondary btn-sm\"\n                  title=\"Voice & SIP for this customer\"\n                >\n                  📞 Voice\n                </button>\n                <a \n                  href=\"/modules/customers/portal/login\" \n                  target=\"_blank\" \n                  class=\"btn-secondary btn-sm\"\n                  title=\"Open Customer Portal\"\n                >\n                  🌐 Portal\n                </a>\n              </div>\n            </div>\n        </div>\n      \n    </div>\n      \n        <!-- Service Plans Tab -->\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"BandwidthPlans\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>p1</td><td>active</td></tr><tr><td>p2</td><td>active</td></tr></tbody></table></div>\n      \n        <!-- Customer Groups Tab -->\n        <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"GroupManagement\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>c1</td><td>active</td></tr><tr><td>c2</td><td>pending</td></tr><tr><td>c3</td><td>active</td></tr></tbody></table></div>\n    </div>\n  </div>\n  \n  \n  \n  \n\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"CustomerOnboardingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />";
}

