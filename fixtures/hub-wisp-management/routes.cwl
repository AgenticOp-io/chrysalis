@page GET "/modules/user-management"
page modules_user_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "user-management", apiPath: "/api/users", api_ok: true, api_surface: "wisp-api-native", api_resource: "users", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"user-management-container\">\n  <div class=\"header\">\n    <button class=\"btn-back\">\n      ← Back to Modules\n    </button>\n    \n    <div class=\"title-section\">\n      <h1>👥 User Management</h1>\n      <p class=\"subtitle\">\n        \n          Manage all users across all organizations\n        \n      </p>\n    </div>\n    \n    \n  </div>\n\n  \n\n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search by name or email...\"\n      />\n    </div>\n\n    <select class=\"select\">\n      <option value=\"all\">All Roles</option>\n      <option value=\"owner\">Owner</option>\n      <option value=\"admin\">Admin</option>\n      <option value=\"engineer\">Engineer</option>\n      <option value=\"installer\">Field Technician</option>\n      <option value=\"helpdesk\">Help Desk</option>\n      <option value=\"viewer\">Viewer</option>\n    </select>\n\n    <select class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"active\">Active</option>\n      <option value=\"suspended\">Suspended</option>\n      <option value=\"pending_invitation\">Pending</option>\n    </select>\n\n    <div class=\"results-count\">\n       of 2 users\n    </div>\n  </div>\n\n  \n    <div class=\"table-container\">\n      <table class=\"user-table\">\n        <thead>\n          <tr>\n            <th>User</th>\n            <th>Role</th>\n            <th>Status</th>\n            <th>Last Login</th>\n            <th>Added</th>\n            \n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n  \n</div>\n\n\n\n";
}

