  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", path: "/modules/customers/portal/dashboard", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-customers-portal-dashboard\" data-wisp-path=\"/modules/customers/portal/dashboard\" data-cwl-island=\"client\"><div class=\"dashboard\">\n    <div class=\"dashboard-header\">\n      <h1>Welcome, Alex!</h1>\n      <p class=\"subtitle\">Manage your tickets and view your service information</p>\n    </div>\n    \n    <div class=\"dashboard-stats\">\n      <div class=\"stat-card\">\n          <div class=\"stat-value\"></div>\n          <div class=\"stat-label\">Total Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"></div>\n          <div class=\"stat-label\">Open Tickets</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-value\"></div>\n          <div class=\"stat-label\">Resolved</div>\n        </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">active</div>\n        <div class=\"stat-label\">Service Status</div>\n      </div>\n    </div>\n    \n    <div class=\"dashboard-actions\">\n        <a href=\"/modules/customers/portal/tickets/new\" class=\"btn-primary\">\n          Create New Ticket\n        </a>\n        <a href=\"/modules/customers/portal/tickets\" class=\"btn-secondary\">\n          View All Tickets\n        </a>\n      </div>\n    \n    <div class=\"support-tools\">\n        <div class=\"support-card\">\n            <h3>Billing &amp; Account</h3>\n            <p>View your plan, billing cycle, balance, and next billing date.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/billing\">View Billing</a>\n            <a class=\"support-link secondary\" href=\"/modules/customers/portal/billing/settings\">Billing settings</a>\n          </div>\n        <div class=\"support-card\">\n            <h3>Service Status &amp; Outages</h3>\n            <p>Check real-time service health, scheduled maintenance, and network alerts.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/service\">View Status</a>\n          </div>\n        <div class=\"support-card\">\n            <h3>FAQ &amp; Help Center</h3>\n            <p>Browse answers to the most common account, billing, and technical questions.</p>\n            <a class=\"support-link\" href=\"/modules/customers/portal/faq\">Visit FAQ</a>\n          </div>\n        \n        \n      </div>\n    \n    <div class=\"recent-tickets\">\n        <h2>Recent Tickets</h2>\n        <div class=\"tickets-list\">\n          <div class=\"ticket-card\">\n              <div class=\"ticket-header\">\n                <span class=\"ticket-number\"></span>\n                <span \n                  class=\"ticket-status\" \n                  style=\"background: \"\n                >\n                  \n                </span>\n              </div>\n              <h3 class=\"ticket-title\"></h3>\n              <p class=\"ticket-description\"></p>\n              <div class=\"ticket-meta\">\n                <span>Priority: </span>\n                <span>Created: </span>\n              </div>\n            </div>\n        </div>\n      </div>\n    \n    <div class=\"service-info\">\n        <h2>Service Information</h2>\n        <div class=\"info-card\">\n          <div class=\"info-row\">\n            <span class=\"info-label\">Service Status:</span>\n            <span class=\"info-value\">active</span>\n          </div>\n          <div class=\"info-row\">\n              <span class=\"info-label\">Service Plan:</span>\n              <span class=\"info-value\">Residential 100</span>\n            </div>\n          \n        </div>\n      </div>\n  </div></div>";
}

