  effects: none;
  content-type "text/html; charset=utf-8";
  load { module: "monitoring", section: "overview", source: "wisp-m4", apiPath: "/api/monitoring" };
  return html "<svelte:head>\n  <title>SNMP Monitoring – WISP Management</title>\n</svelte:head>\n\n<div class=\"module-shell\">\n  <nav class=\"m4-nav\">\n  <a href=\"/modules/hss-management\">HSS</a>\n  <a href=\"/modules/monitoring\">Monitoring</a>\n</nav>\n  <header>\n    <h1>SNMP Monitoring</h1>\n    <p class=\"api-surface\">API: /api/monitoring (proxied upstream)</p>\n  </header>\n  <p class=\"section\">Section: overview</p>\n  <p class=\"extra-note\">SNMP graphs via /api/monitoring and /api/snmp.</p>\n  <p class=\"ui-hole-note\">Interactive widgets remain sidecar until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/modules/pci-resolution"
page modules_pci_resolution_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/pci-resolution", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- Full Screen Map -->\n<!-- Note: Auth check removed - Module_Manager dashboard handles authentication -->\n<div class=\"app\">\n  <!-- Map Background -->\n  <div class=\"map-fullscreen\">\n    \n  </div>\n\n  <!-- New UI Layout: Separate Positioned Elements -->\n  \n  <!-- Top Left: Brand -->\n  <div class=\"top-brand\">\n  <div class=\"brand-content\">\n    <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"brand-icon\">\n      <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n      <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n    </svg>\n    <h1 class=\"app-title\">LTE PCI Mapper</h1>\n  </div>\n</div>\n  \n  <!-- Top Right: Basemap Switcher -->\n  <div class=\"cwl-map-shell\" data-cwl-map-shell=\"BasemapSwitcher\" aria-hidden=\"true\" role=\"img\"></div>\n  \n  <!-- Right Side: PCI Status Widget -->\n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"PCIStatusWidget\" aria-hidden=\"true\"></div>\n  \n  <!-- Left Sidebar: Vertical Menu -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"VerticalMenu\" aria-hidden=\"true\"></nav> true}\n  />\n  \n  <!-- Bottom Right: Settings Gear Menu -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"SettingsMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Help Button -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n  <!-- Modular Components - Isolated and reusable -->\n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"NetworkManager\" aria-hidden=\"true\"></div> false}\n  />\n  \n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"ImportWizard\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AnalysisModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showAnalysisModal')}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"ConflictsModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showConflictsModal')}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"RecommendationsModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showRecommendationsModal')}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"OptimizationResultModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showOptimizationResultModal')}\n  />\n  \n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"CellEditor\" aria-hidden=\"true\"></div> }\n  />\n  \n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"SiteEditor\" aria-hidden=\"true\"></div> }\n  />\n  \n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ContextMenu\" aria-hidden=\"true\"></nav> false}\n  />\n  \n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"TowerManager\" aria-hidden=\"true\"></div> false}\n  />\n  \n  <!-- Export Modal -->\n  \n  \n  <!-- Help Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"ConflictResolutionWizard\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n        </div>";
}

@page GET "/modules/plan"
