  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-customers-portal-billing\" data-wisp-path=\"/modules/customers/portal/billing\" data-cwl-island=\"client\"><div class=\"billing-page\">\n    <h1>Billing &amp; Account</h1>\n    <p class=\"subtitle\">Your plan, billing cycle, and balance. <a href=\"/modules/customers/portal/billing/settings\" class=\"link-settings\">Billing settings</a></p>\n\n    \n\n    \n  </div></div>";
