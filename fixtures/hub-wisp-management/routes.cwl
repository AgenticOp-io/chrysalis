  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"modules-customers-portal-setup\" data-wisp-path=\"/modules/customers/portal-setup\" data-cwl-island=\"client\"><div class=\"portal-admin-page\">\n    <div class=\"page-header\">\n      <div class=\"header-left\">\n        <button class=\"back-btn\" title=\"Back to Modules\">\n          ← Exit to Modules\n        </button>\n      </div>\n      <div class=\"header-content\">\n        <h1>🌐 Customer Portal Management</h1>\n        <p class=\"subtitle\">Configure your customer-facing portal, content, and support features</p>\n      </div>\n      <div class=\"header-actions\">\n        <a target=\"_blank\" class=\"btn-secondary\">\n          View Portal →\n        </a>\n      </div>\n    </div>\n    \n    \n    \n    \n    \n    <!-- Tab Navigation -->\n    <div class=\"tab-navigation\">\n      <button class=\"tab-btn\">\n        🎨 Branding\n      </button>\n      <button class=\"tab-btn\">\n        ⚙️ Features\n      </button>\n      <button class=\"tab-btn\">\n        💳 Billing Portal\n      </button>\n      <button class=\"tab-btn\">\n        🚨 Alerts & Outages\n      </button>\n      <button class=\"tab-btn\">\n        ❓ FAQ\n      </button>\n      <button class=\"tab-btn\">\n        📚 Knowledge Base\n      </button>\n      <button class=\"tab-btn\">\n        💬 Live Chat\n      </button>\n    </div>\n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      <!-- Branding Tab -->\n      \n      \n      <!-- Billing Portal Tab: payment gateways & invoice customization -->\n      \n      \n      <!-- Features Tab -->\n      \n      \n      <!-- Alerts Tab -->\n      \n      \n      <!-- FAQ Tab -->\n      \n      \n      <!-- Knowledge Base Tab -->\n      \n      \n      <!-- Live Chat Tab -->\n      \n    </div>\n  </div></div>";
}

