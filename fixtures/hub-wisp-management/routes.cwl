20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7BsectorGroup.pcis.join('%2C%20')%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C!--%20List%20carriers%20--%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22carriers-list%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3ECarriers%3A%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20sectorGroup.carriers%20as%20carrier%2C%20idx%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22carrier-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22carrier-label%22%3EC%7Bidx%20%2B%201%7D%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22carrier-data%22%3EPCI%20%7Bcarrier.pci%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22carrier-data%22%3EEARFCN%20%7Bcarrier.dlEarfcn%20%7C%7C%20carrier.earfcn%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22carrier-data%22%3E%7Bcarrier.frequency%7D%20MHz%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"tower-card\">\n                <div\n                  class=\"tower-card-header\"\n                  role=\"button\"\n                  tabindex=\"0\" data-cwl-action=\"toggleExpand\" data-cwl-action-args=\"tower.eNodeB\" data-cwl-on-keydown=\"action:toggleExpand\" data-cwl-on-keydown-args=\"tower.eNodeB\"\n                >\n                  <div class=\"tower-info\">\n                    <div class=\"tower-icon\">\n                      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                        <polyline points=\"2 17 12 22 22 17\"></polyline>\n                        <polyline points=\"2 12 12 17 22 12\"></polyline>\n                      </svg>\n                    </div>\n                    <div class=\"tower-details\">\n                      <h3>Tower </h3>\n                      <div class=\"tower-meta\">\n                        <span class=\"meta-item\">\n                          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <polyline points=\"12 6 12 12 16 14\"></polyline>\n                          </svg>\n                           sector ( carriers)\n                        </span>\n                        <span class=\"meta-divider\">•</span>\n                        <span class=\"meta-item coordinates\">\n                          📍\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"tower-actions\">\n                    <button\n                      class=\"action-btn edit-btn\" data-cwl-action=\"handleEditTower\" data-cwl-action-args=\"tower\"\n                      title=\"Edit tower\"\n                    >\n                      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path>\n                        <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path>\n                      </svg>\n                    </button>\n                    <button\n                      class=\"action-btn delete-btn\" data-cwl-action=\"handleDeleteTower\" data-cwl-action-args=\"tower, e\"\n                      title=\"Delete tower\"\n                    >\n                      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <polyline points=\"3 6 5 6 21 6\"></polyline>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n                      </svg>\n                    </button>\n                    <button\n                      class=\"expand-btn\" data-cwl-action=\"toggleExpand\" data-cwl-action-args=\"tower.eNodeB\"\n                     aria-label=\"Toggle Expand\">\n                      <svg\n                        width=\"16\"\n                        height=\"16\"\n                        viewBox=\"0 0 24 24\"\n                        fill=\"none\"\n                        stroke=\"currentColor\"\n                        stroke-width=\"2\">\n                        <polyline points=\"6 9 12 15 18 9\"></polyline>\n                      </svg>\n                    </button>\n                  </div>\n                </div>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"expandedTowerId === tower.eNodeB.toString()\"><div class=\"tower-sectors\">\n                    <h4>Sectors () -  Total Carriers</h4>\n                    <div class=\"sectors-grid\">\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"tower.sectors as sectorGroup\"><div class=\"sector-card\">\n                          <div class=\"sector-header\">\n                            <span class=\"sector-id\">Sector </span>\n                            <span class=\"sector-pci\">Azimuth: °</span>\n                          </div>\n                          <div class=\"sector-details\">\n                            <div class=\"sector-row\">\n                              <span class=\"label\">Carriers:</span>\n                              <span class=\"value\"></span>\n                            </div>\n                            <div class=\"sector-row\">\n                              <span class=\"label\">PCIs:</span>\n                              <span class=\"value\"></span>\n                            </div>\n\n                            <!-- List carriers -->\n                            <div class=\"carriers-list\">\n                              <strong>Carriers:</strong>\n                              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sectorGroup.carriers as carrier, idx\"><div class=\"carrier-row\">\n                                  <span class=\"carrier-label\">C:</span>\n                                  <span class=\"carrier-data\">PCI </span>\n                                  <span class=\"carrier-data\">EARFCN </span>\n                                  <span class=\"carrier-data\"> MHz</span>\n                                </div></div>\n                            </div>\n                          </div>\n                        </div></div>\n                    </div>\n                  </div></div>\n              </div></div>\n\n            <div class=\"empty-state\" hidden aria-hidden=\"true\">\n              <svg width=\"64\" height=\"64\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                <polyline points=\"2 17 12 22 22 17\"></polyline>\n                <polyline points=\"2 12 12 17 22 12\"></polyline>\n              </svg>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"searchQuery\"><h3>No Towers Found</h3>\n                <p>Try adjusting your search terms.</p></div>\n                <h3>No Towers Yet</h3>\n                <p>Add your first cell tower to start planning your network.</p>\n                <button class=\"add-first-tower-btn\" data-cwl-toggle=\"showSiteEditor:true\" aria-label=\"Show Site Editor\">\n                  ➕ Add First Tower\n                </button>\n\n            </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n\n<!-- Site Editor Modal -->\n<div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSiteEditor\" hidden aria-hidden=\"true\"><div class=\"modal-backdrop\">\n    <div class=\"site-editor\">\n      <div class=\"editor-header\">\n        <h2>\n\n            🏗️ Edit Cell Site: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site?.name || 'Unknown'\"></span>\n\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"editor-content\">\n        <!-- Site Information -->\n        <section class=\"editor-section\">\n          <h3>Cell Site Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"siteId\">Site ID</label>\n              <input\n                type=\"text\"\n                id=\"siteId\" data-cwl-attr-disabled=\"!isNewSite\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"siteName\">Site Name</label>\n              <input\n                type=\"text\"\n                id=\"siteName\"\n                placeholder=\"Manhattan Tower A\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"eNodeB\">eNodeB</label>\n              <input\n                type=\"number\"\n                id=\"eNodeB\"\n                required\n              />\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"latitude\">Latitude</label>\n              <input\n                type=\"number\"\n                id=\"latitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"longitude\">Longitude</label>\n              <input\n                type=\"number\"\n                id=\"longitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n          </div>\n        </section>\n\n        <!-- Sectors Section -->\n        <section class=\"editor-section sectors-section\">\n          <div class=\"section-header\">\n            <h3>📡 Sectors (Transmitters on this Cell)</h3>\n            <div class=\"sector-count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length\"></span> Sector<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length !== 1 ? 's' : ''\"></span></div>\n          </div>\n\n          <div class=\"add-sector-prompt\">\n            <button type=\"button\" class=\"add-sector-btn-large\" data-cwl-action=\"addSector\" aria-label=\"Add Sector\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line>\n                <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line>\n              </svg>\n              Add New Sector\n            </button>\n            <p class=\"add-sector-hint\">Add up to 4 sectors (3-sector or 4-sector tower). Each sector can have multiple carriers.</p>\n          </div>\n\n            <div class=\"sectors-grid\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"editedSite.sectors as sector, sectorIndex\"><div class=\"sector-unit\">\n                  <!-- Sector Header with Visual Indicator -->\n                  <div class=\"sector-unit-header\">\n                    <div class=\"sector-title-section\">\n                      <div class=\"sector-icon\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                          <path d=\"M2 17l10 5 10-5\"></path>\n                          <path d=\"M2 12l10 5 10-5\"></path>\n                        </svg>\n                      </div>\n                      <div class=\"sector-title-info\">\n                        <h4>Sector </h4>\n                        <span class=\"sector-subtitle\">Azimuth: ° |  Carrier</span>\n                        <span class=\"sector-pcis\">Carrier PCIs: :$`).join(', ')}</span>\n                      </div>\n                    </div>\n                    <button\n                      type=\"button\"\n                      class=\"remove-sector-btn\" data-cwl-action=\"removeSector\" data-cwl-action-args=\"sectorIndex\"\n                      title=\"Remove this sector\"\n                    >\n                      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <polyline points=\"3 6 5 6 21 6\"></polyline>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n                      </svg>\n                    </button>\n                  </div>\n\n                  <div class=\"sector-details\">\n                    <!-- Prominent Azimuth Control -->\n                    <div class=\"azimuth-control\">\n                      <div class=\"azimuth-label\">\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <polygon points=\"3 11 22 2 13 21 11 13 3 11\"></polygon>\n                        </svg>\n                        Azimuth Direction\n                      </div>\n                      <div class=\"azimuth-input-group\">\n                        <input\n                          type=\"range\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-slider\"\n                        />\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-number\"\n                        />\n                        <span class=\"azimuth-compass\">\n                          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 337.5 || sector.azimuth < 22.5\">N</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 22.5 && sector.azimuth < 67.5\">NE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 67.5 && sector.azimuth < 112.5\">E</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 112.5 && sector.azimuth < 157.5\">SE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 157.5 && sector.azimuth < 202.5\">S</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 202.5 && sector.azimuth < 247.5\">SW</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 247.5 && sector.azimuth < 292.5\">W</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 292.5 && sector.azimuth < 337.5\">NW</div>\n                        </span>\n                      </div>\n                    </div>\n\n                    <!-- Beamwidth Control -->\n                    <div class=\"beamwidth-control\">\n                      <div class=\"beamwidth-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7v10c0 5.5 3.84 7.66 10 9 6.16-1.34 10-3.5 10-9V7l-10-5z\"></path>\n                        </svg>\n                        Beamwidth (Coverage Angle)\n                      </div>\n                      <div class=\"beamwidth-selector\">\n                        <select= class=\"beamwidth-select\">\n                          <option data-cwl-attr-value=\"33\">33° (Narrow - Directional)</option>\n                          <option data-cwl-attr-value=\"65\">65° (Standard - Macro)</option>\n                          <option data-cwl-attr-value=\"78\">78° (Wide - Coverage)</option>\n                          <option data-cwl-attr-value=\"90\">90° (Very Wide - Small Cell)</option>\n                          <option data-cwl-attr-value=\"120\">120° (Ultra Wide - Omni-like)</option>\n                        </select>\n                        <span class=\"beamwidth-visual\">°</span>\n                      </div>\n                    </div>\n\n                    <!-- Height AGL Control -->\n                    <div class=\"height-control\">\n                      <div class=\"height-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line>\n                          <polyline points=\"8 8 12 4 16 8\"></polyline>\n                          <polyline points=\"8 16 12 20 16 16\"></polyline>\n                        </svg>\n                        Height Above Ground Level\n                      </div>\n                      <div class=\"height-input-group\">\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"2000\"\n                          step=\"1\"\n                          class=\"height-input\"\n                        />\n                        <span class=\"height-unit\">feet</span>\n                      </div>\n                    </div>\n\n                    <div class=\"form-row\">\n                      <div class=\"form-group-sm\">\n                        <label>\n                          RS Power (dBm)\n                          <input\n                            type=\"number\"=\n                            min=\"-120\"\n                            max=\"30\"\n                          />\n                        </label>\n                      </div>\n\n                      <div class=\"form-group-sm\">\n                        <label>\n                          Technology\n                          <select=>\n                            <option value=\"LTE\">LTE (4G)</option>\n                          </select>\n                        </label>\n                      </div>\n                    </div>\n\n                    <div class=\"pci-note\">\n                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                        <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                      </svg>\n                      <span>Each sector transmitter can have multiple carriers. Each carrier needs its own PCI and EARFCN.</span>\n                    </div>\n\n                    <!-- Carriers for this transmitter -->\n                    <div class=\"channels-section\">\n                      <div class=\"channels-header\">\n                        <strong>📻 Carriers</strong>\n                        <span class=\"carrier-info\">Each carrier has its own EARFCN & PCI</span>\n                        <button\n                          type=\"button\"\n                          class=\"add-channel-btn-sm\" data-cwl-action=\"addChannelToSector\" data-cwl-action-args=\"sectorIndex\"\n                         aria-label=\"Add Channel To Sector\">\n                          + Add Carrier\n                        </button>\n                      </div>\n\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sector.channels as channel, channelIndex\"><div class=\"carrier-card\">\n                          <div class=\"carrier-header\">\n                            <div class=\"carrier-number\">Carrier </div>\n                            <div class=\"carrier-primary-select\">\n                              <input\n                                type=\"radio\"\n                                name=\"primary-\" data-cwl-on-change=\"action:setPrimaryChannel\" data-cwl-on-change-args=\"sectorIndex, channelIndex\"\n                                title=\"Primary carrier\"\n                                id=\"primary--\"\n                              />\n                              <label for=\"primary--\" class=\"primary-label\">\n\n                              </label>\n                            </div>\n                            <button\n                              type=\"button\"\n                              class=\"remove-channel-btn\" data-cwl-action=\"removeChannel\" data-cwl-action-args=\"sectorIndex, channelIndex\" title=\"Remove carrier\"\n                            >\n                              ×\n                            </button>\n                          </div>\n\n                          <div class=\"carrier-details\">\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"earfcn--\">EARFCN DL</label>\n                              <input\n                                type=\"number\"\n                                id=\"earfcn--\"=\n                                placeholder=\"55640\"\n                                class=\"carrier-input\"\n                                min=\"55240\"\n                                max=\"56739\"\n                                title=\"Band 48: 55240-56739\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"bw--\">Bandwidth</label>\n                              <select id=\"bw--\"= class=\"carrier-select\">\n                                <option data-cwl-attr-value=\"10\">10 MHz</option>\n                                <option data-cwl-attr-value=\"15\">15 MHz</option>\n                                <option data-cwl-attr-value=\"20\">20 MHz</option>\n                              </select>\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"pci--\">PCI</label>\n                              <input\n                                type=\"number\"\n                                id=\"pci--\"=\n                                placeholder=\"0\"\n                                class=\"carrier-input-sm\"\n                                min=\"0\"\n                                max=\"503\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <span class=\"freq-display\"> MHz</span>\n                            </div>\n                          </div>\n                        </div></div>\n                    </div>\n                  </div>\n                </div></div>\n            </div>\n\n            <div hidden aria-hidden=\"true\"><p class=\"empty-message\">\n              📍 No sectors configured yet.<br/>\n              Click \"Add New Sector\" above to create your first sector.\n            </p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"editor-footer\">\n        <button type=\"button\" class=\"cancel-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n        <button type=\"button\" class=\"save-btn\" data-cwl-action=\"handleSave\" aria-label=\"Save\">\n\n            💾 Save Changes\n\n        </button>\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- Import Wizard Modal -->\n<div data-cwl-component=\"ImportWizard\" data-cwl-lifted-component=\"ImportWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showImportWizard\" hidden aria-hidden=\"true\"><div\n    class=\"wizard-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"wizard-modal\"\n      role=\"dialog\"\n      tabindex=\"-1\"\n      aria-labelledby=\"import-wizard-modal-title\"\n    >\n      <div class=\"wizard-header\">\n        <h2 id=\"import-wizard-modal-title\">Import Data</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"wizard-body\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!importMethod\"><!-- Step 1: Choose Import Method -->\n          <div class=\"wizard-intro\">\n            <p class=\"intro-text\">Choose how you'd like to import cell data:</p>\n          </div>\n\n          <div class=\"method-grid\">\n            <button class=\"method-card\" data-cwl-action=\"selectMethod\" data-cwl-action-args=\"'csv'\" aria-label=\"Select Method\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path>\n                  <polyline points=\"14 2 14 8 20 8\"></polyline>\n                  <line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"12\"></line>\n                  <line x1=\"9\" y1=\"15\" x2=\"15\" y2=\"15\"></line>\n                </svg>\n              </div>\n              <h3>CSV File</h3>\n              <p>Upload a CSV file with cell tower data</p>\n            </button>\n\n            <button class=\"method-card\" data-cwl-action=\"selectMethod\" data-cwl-action-args=\"'kml'\" aria-label=\"Select Method\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n              </div>\n              <h3>KML File</h3>\n              <p>Import from Google Earth or GIS software</p>\n            </button>\n\n            <button class=\"method-card\" data-cwl-action=\"selectMethod\" data-cwl-action-args=\"'manual'\" aria-label=\"Select Method\">\n              <div class=\"method-icon\">\n                <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path>\n                  <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path>\n                </svg>\n              </div>\n              <h3>Manual Entry</h3>\n              <p>Add cell data manually one by one</p>\n            </button>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importMethod === 'csv'\"><!-- Step 2: CSV Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\" data-cwl-action=\"goBack\" aria-label=\"Go Back\">← Back</button>\n\n            <h3>📄 CSV Import</h3>\n            <p class=\"help-text\">Upload a CSV file with tower/cell data. Leave PCI blank for auto-assignment.</p>\n\n            <div class=\"file-upload-zone\">\n              <input\n                type=\"file\"\n                accept=\".csv\" data-cwl-on-change=\"action:handleCSVUpload\"\n                id=\"csv-upload\"\n              />\n              <label for=\"csv-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n                  <polyline points=\"17 8 12 3 7 8\"></polyline>\n                  <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n                </svg>\n                <span>Choose CSV file or drag & drop</span>\n              </label>\n            </div>\n\n            <button class=\"template-btn\" data-cwl-action=\"downloadCSVTemplate\" aria-label=\"Download CSVTemplate\">\n              📥 Download CSV Template\n            </button>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importMethod === 'kml'\"><!-- Step 2: KML Import -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\" data-cwl-action=\"goBack\" aria-label=\"Go Back\">← Back</button>\n\n            <h3>🗺️ KML Import</h3>\n            <p class=\"help-text\">Upload a KML file from Google Earth or GIS software.</p>\n\n            <div class=\"file-upload-zone\">\n              <input\n                type=\"file\"\n                accept=\".kml,.kmz\" data-cwl-on-change=\"action:handleKMLUpload\"\n                id=\"kml-upload\"\n              />\n              <label for=\"kml-upload\" class=\"upload-label\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n                <span>Choose KML/KMZ file or drag & drop</span>\n              </label>\n            </div>\n\n            <button class=\"template-btn\" data-cwl-action=\"downloadKMLTemplate\" aria-label=\"Download KMLTemplate\">\n              📥 Download KML Template\n            </button>\n\n            <div class=\"info-box\">\n              <strong>Supported Data:</strong> The KML parser will extract coordinates, name, and cell parameters from ExtendedData or description fields (PCI, eNodeB, Sector, Frequency, etc.).\n            </div>\n          </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importMethod === 'manual'\"><!-- Step 2: Manual Site Entry -->\n          <div class=\"import-content\">\n            <button class=\"back-btn\" data-cwl-action=\"goBack\" aria-label=\"Go Back\">← Back</button>\n\n            <h3>✏️ Manual Site Entry</h3>\n            <p class=\"method-description\">Add cell sites with sectors and channels</p>\n\n            <!-- Add Site Button -->\n            <div class=\"manual-add-section\">\n              <button\n                type=\"button\"\n                class=\"add-site-btn-large\" data-cwl-toggle=\"showSiteEditorInWizard:true\"\n               aria-label=\"Show Site Editor In Wizard\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                  <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                </svg>\n                Add Cell Site\n              </button>\n              <p class=\"add-hint\">Each site can have multiple sectors with different azimuths and EARFCNs</p>\n            </div>\n\n            <!-- Sites List -->\n\n              <div class=\"sites-list\">\n                <h4>Added Sites (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"manualSites.length\"></span>)</h4>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"manualSites as site, index\"><div class=\"site-preview\">\n                    <div class=\"site-preview-header\">\n                      <strong></strong>\n                      <span class=\"site-preview-meta\">eNodeB  •  Sector</span>\n                    </div>\n                    <div class=\"sector-summary\">\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"site.sectors as sector\"><span class=\"sector-badge\">\n                          Sec : ° | PCI  |  Ch\n                        </span></div>\n                    </div>\n                    <button\n                      type=\"button\"\n                      class=\"remove-site-btn\" data-cwl-action=\"removeSiteFromImport\" data-cwl-action-args=\"index\"\n                     aria-label=\"Remove Site From Import\">\n                      Remove\n                    </button>\n                  </div></div>\n              </div>\n\n              <div class=\"manual-actions\">\n                <button class=\"import-btn\" data-cwl-action=\"importManualSites\" aria-label=\"Import Manual Sites\">\n                  ✅ Import <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"manualSites.length\"></span> Site<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"manualSites.length !== 1 ? 's' : ''\"></span>\n                </button>\n              </div>\n\n          </div></div>\n      </div>\n    </div>\n  </div>\n\n<!-- Nested Site Editor for Manual Import -->\n<div data-cwl-component=\"SiteEditor\" data-cwl-lifted-component=\"SiteEditor\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSiteEditorInWizard\" hidden aria-hidden=\"true\"><div class=\"modal-backdrop\">\n    <div class=\"site-editor\">\n      <div class=\"editor-header\">\n        <h2>\n\n            🏗️ Create New Cell Site\n\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"editor-content\">\n        <!-- Site Information -->\n        <section class=\"editor-section\">\n          <h3>Cell Site Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"siteId\">Site ID</label>\n              <input\n                type=\"text\"\n                id=\"siteId\" data-cwl-attr-disabled=\"!isNewSite\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"siteName\">Site Name</label>\n              <input\n                type=\"text\"\n                id=\"siteName\"\n                placeholder=\"Manhattan Tower A\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"eNodeB\">eNodeB</label>\n              <input\n                type=\"number\"\n                id=\"eNodeB\"\n                required\n              />\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"latitude\">Latitude</label>\n              <input\n                type=\"number\"\n                id=\"latitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"longitude\">Longitude</label>\n              <input\n                type=\"number\"\n                id=\"longitude\"\n                step=\"0.000001\"\n                required\n              />\n            </div>\n          </div>\n        </section>\n\n        <!-- Sectors Section -->\n        <section class=\"editor-section sectors-section\">\n          <div class=\"section-header\">\n            <h3>📡 Sectors (Transmitters on this Cell)</h3>\n            <div class=\"sector-count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length\"></span> Sector<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editedSite.sectors.length !== 1 ? 's' : ''\"></span></div>\n          </div>\n\n          <div class=\"add-sector-prompt\">\n            <button type=\"button\" class=\"add-sector-btn-large\" data-cwl-action=\"addSector\" aria-label=\"Add Sector\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line>\n                <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line>\n              </svg>\n              Add New Sector\n            </button>\n            <p class=\"add-sector-hint\">Add up to 4 sectors (3-sector or 4-sector tower). Each sector can have multiple carriers.</p>\n          </div>\n\n            <div class=\"sectors-grid\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"editedSite.sectors as sector, sectorIndex\"><div class=\"sector-unit\">\n                  <!-- Sector Header with Visual Indicator -->\n                  <div class=\"sector-unit-header\">\n                    <div class=\"sector-title-section\">\n                      <div class=\"sector-icon\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                          <path d=\"M2 17l10 5 10-5\"></path>\n                          <path d=\"M2 12l10 5 10-5\"></path>\n                        </svg>\n                      </div>\n                      <div class=\"sector-title-info\">\n                        <h4>Sector </h4>\n                        <span class=\"sector-subtitle\">Azimuth: ° |  Carrier</span>\n                        <span class=\"sector-pcis\">Carrier PCIs: :$`).join(', ')}</span>\n                      </div>\n                    </div>\n                    <button\n                      type=\"button\"\n                      class=\"remove-sector-btn\" data-cwl-action=\"removeSector\" data-cwl-action-args=\"sectorIndex\"\n                      title=\"Remove this sector\"\n                    >\n                      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <polyline points=\"3 6 5 6 21 6\"></polyline>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n                      </svg>\n                    </button>\n                  </div>\n\n                  <div class=\"sector-details\">\n                    <!-- Prominent Azimuth Control -->\n                    <div class=\"azimuth-control\">\n                      <div class=\"azimuth-label\">\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <polygon points=\"3 11 22 2 13 21 11 13 3 11\"></polygon>\n                        </svg>\n                        Azimuth Direction\n                      </div>\n                      <div class=\"azimuth-input-group\">\n                        <input\n                          type=\"range\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-slider\"\n                        />\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"359\"\n                          class=\"azimuth-number\"\n                        />\n                        <span class=\"azimuth-compass\">\n                          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 337.5 || sector.azimuth < 22.5\">N</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 22.5 && sector.azimuth < 67.5\">NE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 67.5 && sector.azimuth < 112.5\">E</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 112.5 && sector.azimuth < 157.5\">SE</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 157.5 && sector.azimuth < 202.5\">S</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 202.5 && sector.azimuth < 247.5\">SW</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 247.5 && sector.azimuth < 292.5\">W</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sector.azimuth >= 292.5 && sector.azimuth < 337.5\">NW</div>\n                        </span>\n                      </div>\n                    </div>\n\n                    <!-- Beamwidth Control -->\n                    <div class=\"beamwidth-control\">\n                      <div class=\"beamwidth-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <path d=\"M12 2L2 7v10c0 5.5 3.84 7.66 10 9 6.16-1.34 10-3.5 10-9V7l-10-5z\"></path>\n                        </svg>\n                        Beamwidth (Coverage Angle)\n                      </div>\n                      <div class=\"beamwidth-selector\">\n                        <select= class=\"beamwidth-select\">\n                          <option data-cwl-attr-value=\"33\">33° (Narrow - Directional)</option>\n                          <option data-cwl-attr-value=\"65\">65° (Standard - Macro)</option>\n                          <option data-cwl-attr-value=\"78\">78° (Wide - Coverage)</option>\n                          <option data-cwl-attr-value=\"90\">90° (Very Wide - Small Cell)</option>\n                          <option data-cwl-attr-value=\"120\">120° (Ultra Wide - Omni-like)</option>\n                        </select>\n                        <span class=\"beamwidth-visual\">°</span>\n                      </div>\n                    </div>\n\n                    <!-- Height AGL Control -->\n                    <div class=\"height-control\">\n                      <div class=\"height-label\">\n                        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                          <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line>\n                          <polyline points=\"8 8 12 4 16 8\"></polyline>\n                          <polyline points=\"8 16 12 20 16 16\"></polyline>\n                        </svg>\n                        Height Above Ground Level\n                      </div>\n                      <div class=\"height-input-group\">\n                        <input\n                          type=\"number\"=\n                          min=\"0\"\n                          max=\"2000\"\n                          step=\"1\"\n                          class=\"height-input\"\n                        />\n                        <span class=\"height-unit\">feet</span>\n                      </div>\n                    </div>\n\n                    <div class=\"form-row\">\n                      <div class=\"form-group-sm\">\n                        <label>\n                          RS Power (dBm)\n                          <input\n                            type=\"number\"=\n                            min=\"-120\"\n                            max=\"30\"\n                          />\n                        </label>\n                      </div>\n\n                      <div class=\"form-group-sm\">\n                        <label>\n                          Technology\n                          <select=>\n                            <option value=\"LTE\">LTE (4G)</option>\n                          </select>\n                        </label>\n                      </div>\n                    </div>\n\n                    <div class=\"pci-note\">\n                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                        <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                      </svg>\n                      <span>Each sector transmitter can have multiple carriers. Each carrier needs its own PCI and EARFCN.</span>\n                    </div>\n\n                    <!-- Carriers for this transmitter -->\n                    <div class=\"channels-section\">\n                      <div class=\"channels-header\">\n                        <strong>📻 Carriers</strong>\n                        <span class=\"carrier-info\">Each carrier has its own EARFCN & PCI</span>\n                        <button\n                          type=\"button\"\n                          class=\"add-channel-btn-sm\" data-cwl-action=\"addChannelToSector\" data-cwl-action-args=\"sectorIndex\"\n                         aria-label=\"Add Channel To Sector\">\n                          + Add Carrier\n                        </button>\n                      </div>\n\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sector.channels as channel, channelIndex\"><div class=\"carrier-card\">\n                          <div class=\"carrier-header\">\n                            <div class=\"carrier-number\">Carrier </div>\n                            <div class=\"carrier-primary-select\">\n                              <input\n                                type=\"radio\"\n                                name=\"primary-\" data-cwl-on-change=\"action:setPrimaryChannel\" data-cwl-on-change-args=\"sectorIndex, channelIndex\"\n                                title=\"Primary carrier\"\n                                id=\"primary--\"\n                              />\n                              <label for=\"primary--\" class=\"primary-label\">\n\n                              </label>\n                            </div>\n                            <button\n                              type=\"button\"\n                              class=\"remove-channel-btn\" data-cwl-action=\"removeChannel\" data-cwl-action-args=\"sectorIndex, channelIndex\" title=\"Remove carrier\"\n                            >\n                              ×\n                            </button>\n                          </div>\n\n                          <div class=\"carrier-details\">\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"earfcn--\">EARFCN DL</label>\n                              <input\n                                type=\"number\"\n                                id=\"earfcn--\"=\n                                placeholder=\"55640\"\n                                class=\"carrier-input\"\n                                min=\"55240\"\n                                max=\"56739\"\n                                title=\"Band 48: 55240-56739\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"bw--\">Bandwidth</label>\n                              <select id=\"bw--\"= class=\"carrier-select\">\n                                <option data-cwl-attr-value=\"10\">10 MHz</option>\n                                <option data-cwl-attr-value=\"15\">15 MHz</option>\n                                <option data-cwl-attr-value=\"20\">20 MHz</option>\n                              </select>\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <label class=\"carrier-label-inline\" for=\"pci--\">PCI</label>\n                              <input\n                                type=\"number\"\n                                id=\"pci--\"=\n                                placeholder=\"0\"\n                                class=\"carrier-input-sm\"\n                                min=\"0\"\n                                max=\"503\"\n                              />\n                            </div>\n\n                            <div class=\"carrier-field\">\n                              <span class=\"freq-display\"> MHz</span>\n                            </div>\n                          </div>\n                        </div></div>\n                    </div>\n                  </div>\n                </div></div>\n            </div>\n\n            <div hidden aria-hidden=\"true\"><p class=\"empty-message\">\n              📍 No sectors configured yet.<br/>\n              Click \"Add New Sector\" above to create your first sector.\n            </p>\n          </div>\n        </section>\n      </div>\n\n      <div class=\"editor-footer\">\n        <button type=\"button\" class=\"cancel-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n        <button type=\"button\" class=\"save-btn\" data-cwl-action=\"handleSave\" aria-label=\"Save\">\n\n            🏗️ Create Site\n\n        </button>\n      </div>\n    </div>\n  </div></div></div></div></div></div></div>\n\n  <!-- Export Modal -->\n\n    <div\n      class=\"modal-overlay\"\n      role=\"presentation\" data-cwl-toggle=\"showExportModal:false\" data-cwl-on-keydown=\"toggle:showExportModal:false\"\n     data-cwl-shell-key=\"showExportModal\" hidden aria-hidden=\"true\">\n      <div\n        class=\"modal-container\"\n        role=\"dialog\"\n        tabindex=\"-1\"\n        aria-labelledby=\"export-modal-title\"\n      >\n        <div class=\"modal-header\">\n          <h3 id=\"export-modal-title\">📤 Export & Configuration</h3>\n          <button class=\"modal-close-btn\" data-cwl-toggle=\"showExportModal:false\" aria-label=\"Show Export Modal\">×</button>\n        </div>\n        <div class=\"modal-body\">\n          <div data-cwl-component=\"ConflictReportExport\" data-cwl-lifted-component=\"ConflictReportExport\"><div class=\"export-panel\">\n  <h3>📊 Export Options</h3>\n  <p class=\"export-subtitle\">Export conflict reports or generate Nokia base station configurations</p>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!report\"><div class=\"generate-section\">\n      <p class=\"info-text\">\n        Generate a comprehensive conflict analysis report with detailed statistics and recommendations.\n      </p>\n      <button\n        class=\"generate-button\" data-cwl-toggle=\"isGenerating:false\" data-cwl-attr-disabled=\"isGenerating || cells.length === 0\"\n       aria-label=\"Is Generating\">\n\n          📋 Generate Conflict Report\n\n      </button>\n    </div></div>\n    <div class=\"report-summary\">\n      <h4>Report Summary</h4>\n      <div class=\"summary-stats\">\n        <div class=\"stat-item\">\n          <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.totalCells\"></span></span>\n          <span class=\"stat-label\">Total Cells</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.totalConflicts\"></span></span>\n          <span class=\"stat-label\">Conflicts</span>\n        </div>\n        <div class=\"stat-item critical\">\n          <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.summary.critical\"></span></span>\n          <span class=\"stat-label\">Critical</span>\n        </div>\n        <div class=\"stat-item high\">\n          <span class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.summary.high\"></span></span>\n          <span class=\"stat-label\">High</span>\n        </div>\n      </div>\n\n      <div class=\"export-actions\">\n        <button class=\"export-button csv\" data-cwl-action=\"exportToCSV\" aria-label=\"Export To CSV\">\n          📄 Export CSV\n        </button>\n        <button class=\"export-button pdf\" data-cwl-action=\"exportToPDF\" aria-label=\"Export To PDF\">\n          📋 Export PDF\n        </button>\n      </div>\n\n      <div class=\"report-details\">\n        <p><strong>Report ID:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.reportId\"></span></p>\n        <p><strong>Generated:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.timestamp.toLocaleString()\"></span></p>\n      </div>\n    </div>\n\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"report && report.totalConflicts > 0\"><div class=\"conflict-breakdown\">\n      <h4>Conflict Breakdown</h4>\n      <div class=\"breakdown-grid\">\n        <div class=\"breakdown-item\">\n          <span class=\"breakdown-label\">Mod3 (CRS)</span>\n          <span class=\"breakdown-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.summary.mod3\"></span></span>\n        </div>\n        <div class=\"breakdown-item\">\n          <span class=\"breakdown-label\">Mod6 (PBCH)</span>\n          <span class=\"breakdown-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.summary.mod6\"></span></span>\n        </div>\n        <div class=\"breakdown-item\">\n          <span class=\"breakdown-label\">Mod30 (PRS)</span>\n          <span class=\"breakdown-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.summary.mod30\"></span></span>\n        </div>\n        <div class=\"breakdown-item\">\n          <span class=\"breakdown-label\">3-Sector</span>\n          <span class=\"breakdown-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.summary.threeSector\"></span></span>\n        </div>\n        <div class=\"breakdown-item\">\n          <span class=\"breakdown-label\">4-Sector</span>\n          <span class=\"breakdown-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"report.summary.fourSector\"></span></span>\n        </div>\n      </div>\n    </div></div>\n</div></div>\n        </div>\n      </div>\n    </div>\n\n  <!-- Help Modal -->\n  <div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showHelpModal\" hidden aria-hidden=\"true\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">PCI Resolution & Network Optimization Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n<h3>📊 PCI Resolution & Network Optimization</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Detect and resolve Physical Cell ID (PCI) conflicts in LTE networks, optimize neighbor relationships, and implement Self-Organizing Network (SON) features.\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#getting-started\">🚀 Getting Started</a></li>\n    <li><a href=\"#map-features\">🗺️ Map Features</a></li>\n    <li><a href=\"#technical-details\">📐 Technical Details</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#network-management\">📞 Network Management</a></li>\n  </ul>\n</div>\n\n<h4 id=\"key-features\">🎯 Key Features</h4>\n<ul>\n  <li><strong>PCI Conflict Detection:</strong> Automatically identifies cells with conflicting PCIs</li>\n  <li><strong>Neighbor Analysis:</strong> Analyzes cell adjacency and interference</li>\n  <li><strong>AI-Powered Recommendations:</strong> Uses Google Gemini AI for optimization suggestions</li>\n  <li><strong>Visual Network Map:</strong> Interactive ArcGIS map showing cell sites and conflicts</li>\n  <li><strong>Export Capabilities:</strong> Generate reports and Nokia configuration scripts</li>\n</ul>\n\n<h4 id=\"getting-started\">🚀 Getting Started</h4>\n\n<h4>Step 1: Import Cell Data</h4>\n<p>Click the <strong>\"📊 Manage Towers\"</strong> button to:</p>\n<ul>\n  <li>Add cell sites manually</li>\n  <li>Import from CSV files</li>\n  <li>Import from KML files (Google Earth)</li>\n</ul>\n\n<p><strong>CSV Format Example:</strong></p>\n<pre><code>eNodeB,Cell ID,PCI,Latitude,Longitude,Azimuth,Height\n12345,0,150,40.7128,-74.0060,0,30\n12345,1,151,40.7128,-74.0060,120,30\n12345,2,152,40.7128,-74.0060,240,30</code></pre>\n\n<h4>Step 2: Analyze Network</h4>\n<p>Click <strong>\"🔍 Analyze Network\"</strong> to:</p>\n<ul>\n  <li>Detect PCI conflicts (same PCI within interference range)</li>\n  <li>Calculate neighbor relationships</li>\n  <li>Identify potential interference</li>\n  <li>Generate conflict severity ratings (High/Medium/Low)</li>\n</ul>\n\n<h4>Step 3: Review Conflicts</h4>\n<p>The conflict table shows:</p>\n<ul>\n  <li><strong>Severity:</strong> High (same PCI neighbors), Medium (mod3 conflicts), Low (mod6 conflicts)</li>\n  <li><strong>Affected Cells:</strong> Which cells are involved</li>\n  <li><strong>Distance:</strong> How far apart the conflicting cells are</li>\n  <li><strong>Recommendations:</strong> Suggested PCI changes</li>\n</ul>\n\n<h4>Step 4: Get AI Recommendations</h4>\n<p>Click <strong>\"🤖 Get AI Recommendations\"</strong> for:</p>\n<ul>\n  <li>Intelligent PCI reallocation suggestions</li>\n  <li>Network-wide optimization strategies</li>\n  <li>Prioritized conflict resolution</li>\n</ul>\n\n<h4>Step 5: Optimize Network</h4>\n<p>Click <strong>\"✨ Optimize Network\"</strong> to:</p>\n<ul>\n  <li>Automatically resolve all PCI conflicts</li>\n  <li>Reassign PCIs based on neighbor relationships</li>\n  <li>Maintain existing PCIs where possible</li>\n  <li>Generate before/after comparison</li>\n</ul>\n\n<h4>Step 6: Export Results</h4>\n<p>Click <strong>\"📤 Export\"</strong> for:</p>\n<ul>\n  <li><strong>Conflict Report (PDF):</strong> Detailed analysis and recommendations</li>\n  <li><strong>CSV Export:</strong> Updated cell data with new PCIs</li>\n  <li><strong>Nokia Configuration:</strong> Ready-to-use CLI commands for Nokia eNodeBs</li>\n</ul>\n\n<h4 id=\"map-features\">🗺️ Map Features</h4>\n<ul>\n  <li><strong>Color Coding:</strong> Cells colored by PCI conflict status</li>\n  <li><strong>Click Cells:</strong> View detailed cell information</li>\n  <li><strong>Right-Click:</strong> Add sites, edit sectors, delete sectors</li>\n  <li><strong>Neighbor Lines:</strong> Shows cell adjacency relationships</li>\n  <li><strong>Basemap Options:</strong> Streets, Satellite, Hybrid, Topographic</li>\n</ul>\n\n<h4 id=\"technical-details\">📐 Technical Details</h4>\n\n<h4>PCI Conflict Rules:</h4>\n<ul>\n  <li><strong>Mod3 Conflict:</strong> PCIs with same value mod 3 (can cause confusion)</li>\n  <li><strong>Mod6 Conflict:</strong> PCIs with same value mod 6 (can cause interference)</li>\n  <li><strong>Direct Conflict:</strong> Identical PCIs within range (must be fixed)</li>\n</ul>\n\n<h4>Interference Range Calculation:</h4>\n<ul>\n  <li>Based on cell height, azimuth, and distance</li>\n  <li>Typical range: 2-5 km for interference detection</li>\n  <li>Adjustable in analysis settings</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>No conflicts detected but cells are close:</h4>\n<p>Increase the interference range in analysis settings</p>\n\n<h4>Optimization changes too many PCIs:</h4>\n<p>Review AI recommendations first and apply selectively</p>\n\n<h4>Map not loading:</h4>\n<p>Check ArcGIS API key in environment variables</p>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n<ul>\n  <li>Import all cell data before analysis</li>\n  <li>Review AI recommendations before auto-optimization</li>\n  <li>Export backup before applying PCI changes</li>\n  <li>Test PCI changes on small clusters first</li>\n  <li>Coordinate with network operations before deployment</li>\n  <li>Use Nokia export for quick configuration deployment</li>\n</ul>\n\n<h4 id=\"network-management\">📞 Network Management</h4>\n<p>Use the <strong>\"🌐 Networks\"</strong> button to:</p>\n<ul>\n  <li>Create multiple isolated networks</li>\n  <li>Switch between different deployments</li>\n  <li>Keep production and staging separate</li>\n  <li>Manage different geographical areas</li>\n</ul>\n\n      </div>\n    </div>\n  </div></div></div>\n\n  <div data-cwl-component=\"ConflictResolutionWizard\" data-cwl-lifted-component=\"ConflictResolutionWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showConflictResolutionWizard\" hidden aria-hidden=\"true\"><div data-cwl-component=\"BaseWizard\" data-cwl-lifted-component=\"BaseWizard\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showBaseWizard\" hidden aria-hidden=\"true\"><div\n    class=\"wizard-overlay\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"wizard-title\" data-cwl-action=\"handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"wizard-modal\"\n    >\n      <!-- Header -->\n      <div class=\"wizard-header\">\n        <h2 id=\"wizard-title\">📊 PCI Conflict Resolution Wizard</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n      <!-- Progress Steps -->\n\n        <nav class=\"wizard-steps\" aria-label=\"Wizard steps\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"steps as step, index\"><button\n              type=\"button\"\n              class=\"wizard-step\" data-cwl-attr-disabled=\"!allowStepNavigation || index &gt; currentStep\" data-cwl-action=\"goToStep\" data-cwl-action-args=\"index\"\n             aria-label=\"Go To Step\">\n              <span class=\"step-icon\"></span>\n              <span class=\"step-title\"></span>\n            </button></div>\n        </nav>\n\n      <!-- Content Area -->\n      <div class=\"wizard-content\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\"></div>\n\n          <div class=\"alert alert-success\" hidden aria-hidden=\"true\"></div>\n\n        <!-- Slot for step content -->\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><div class=\"wizard-panel\">\n        <h3>PCI Conflict Resolution</h3>\n        <p>This wizard will help you identify and resolve Physical Cell ID (PCI) conflicts in your LTE network.</p>\n        <div class=\"info-box\">\n          <h4>Steps:</h4>\n          <ul>\n            <li>Run analysis on your current network cells</li>\n            <li>Review detected conflicts</li>\n            <li>Apply automatic PCI optimization</li>\n            <li>Verify resolution</li>\n          </ul>\n        </div>\n        <p class=\"hint\">Make sure you have a network selected and cells loaded on the PCI Resolution page before starting.</p>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 1\"><div class=\"wizard-panel\">\n        <h3>Identify Conflicts</h3>\n        <p>Run PCI conflict analysis on the current network cells.</p>\n        <button type=\"button\" class=\"wizard-btn-primary\" data-cwl-action=\"runAnalysis\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Run Analysis\">\n          Run Analysis\n        </button>\n\n          <div hidden aria-hidden=\"true\"><p class=\"hint\">Conflicts found: <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflictCount\"></span></strong></p>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><div class=\"wizard-panel\">\n        <h3>Review Conflicts</h3>\n\n          <p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.length\"></span> conflict(s) detected.</p>\n          <div class=\"conflict-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"conflicts.slice(0, 10) as c\"><div class=\"conflict-item\">\n                <span class=\"severity \"></span>\n                 (PCI ) ↔  (PCI ) —\n              </div></div>\n          </div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"conflicts.length > 10\"><p class=\"hint\">... and <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"conflicts.length - 10\"></span> more.</p></div>\n\n          <div hidden aria-hidden=\"true\"><p class=\"success-msg\">No conflicts detected. Your PCI assignments are good.</p>\n          <button type=\"button\" class=\"wizard-btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Done</button>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 3\"><div class=\"wizard-panel\">\n        <h3>Resolution Strategy</h3>\n        <p>Choose automatic optimization to reassign PCIs and resolve conflicts.</p>\n        <button type=\"button\" class=\"wizard-btn-primary\" data-cwl-action=\"runOptimization\" data-cwl-attr-disabled=\"isLoading || conflictCount === 0\" aria-label=\"Run Optimization\">\n          Auto-optimize PCIs\n        </button>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"conflictCount === 0\"><p class=\"hint\">No conflicts to optimize. You can close the wizard.</p></div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 4\"><div class=\"wizard-panel\">\n        <h3>Preview Changes</h3>\n\n          <p>No changes to preview.</p>\n\n          <div hidden aria-hidden=\"true\"><p><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimizationResult.changes.length\"></span> PCI change(s) will be applied:</p>\n          <ul class=\"change-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"optimizationResult.changes.slice(0, 15) as ch\"><li><strong></strong>: PCI  → </li></div>\n          </ul>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"optimizationResult.changes.length > 15\"><p class=\"hint\">... and <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"optimizationResult.changes.length - 15\"></span> more.</p></div>\n        </div>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 5\"><div class=\"wizard-panel\">\n        <h3>Apply Changes</h3>\n        <p>Save the optimized PCI assignments to your network.</p>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeNetwork\"><p class=\"hint\">Network: <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"activeNetwork.name || activeNetwork.id\"></span></strong></p>\n          <button type=\"button\" class=\"wizard-btn-primary\" data-cwl-action=\"applyChanges\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Apply Changes\">\n            Apply & Save\n          </button></div>\n          <p class=\"hint\">No network selected. Select a network on the PCI Resolution page, then return here to apply.</p>\n\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 6\"><div class=\"wizard-panel\">\n        <h3>Verify Resolution</h3>\n        <p>Re-run analysis to confirm conflicts are resolved.</p>\n        <button type=\"button\" class=\"wizard-btn-primary\" data-cwl-action=\"verifyResolution\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Verify Resolution\">\n          Verify\n        </button>\n      </div></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 7\"><div class=\"wizard-panel\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"verificationConflictCount === 0\"><h3>🎉 All conflicts resolved</h3>\n          <p>PCI optimization is complete. No conflicts remain.</p></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"verificationConflictCount > 0\"><h3>Resolution complete</h3>\n          <p>-1 conflict(s) still remain. You can run the wizard again or resolve manually on the map.</p></div>\n          <h3>Wizard complete</h3>\n          <p>You can close the wizard and continue on the PCI Resolution page.</p>\n\n        <a href=\"/modules/pci-resolution\" class=\"next-step-item\">Back to PCI Resolution →</a>\n      </div></div>\n      </div>\n\n      <!-- Footer -->\n      <div class=\"wizard-footer\">\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 0 && currentStep < steps.length - 1 && currentStep !== 2\"><button class=\"wizard-btn-secondary\" data-cwl-action=\"prevStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Prev Step\">← Previous</button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><button class=\"wizard-btn-secondary\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Close\">Cancel</button></div>\n    <div class=\"footer-actions\">\n\n        <div hidden aria-hidden=\"true\"><button class=\"wizard-btn-primary\" data-cwl-action=\"nextStep\" aria-label=\"Next Step\">Next →</button>\n      </div>\n    </div></span> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"prevStep\"></span>    />\n      </div>\n    </div>\n  </div></div></div></div></div>\n\n        </div></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\" hidden aria-hidden=\"true\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/plan"
page modules_plan_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "plan" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"plan\" data-wisp-path=\"/modules/plan\" data-cwl-island=\"client\"><div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      <iframe id=\"plan-map-iframe\" class=\"plan-map-iframe\" title=\"Plan map\" src=\"/modules/coverage-map?mode=plan&hideStats=true&planMode=true\" data-cwl-island=\"shared-map\" data-cwl-map-mode=\"plan\" data-cwl-lifted-component=\"SharedMap\"></iframe>\n    </div>\n\n    <!-- Enhanced Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-primary);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\" data-cwl-nav=\"/dashboard\" title=\"Back to Dashboard\" type=\"button\">\n          ←\n        </button>\n        <h1>📋 Plan</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" data-cwl-toggle=\"showHelpModal:true\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n          <button class=\"module-control-btn\" data-cwl-toggle=\"showHardwareModal:true\" title=\"View All Hardware\">\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Hardware</span>\n        </button>\n        <button class=\"module-control-btn\" data-cwl-toggle=\"showProjectModal:true\" title=\"Project List\">\n          <span class=\"control-icon\">📁</span>\n          <span class=\"control-label\">Projects</span>\n        </button>\n        <div data-cwl-component=\"ModuleWizardMenu\" data-cwl-lifted-component=\"ModuleWizardMenu\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showModuleWizardMenu\" hidden aria-hidden=\"true\"><div class=\"module-wizard-menu\">\n    <button\n      type=\"button\"\n      class=\"wizard-trigger\" data-cwl-attr-disabled=\"disabled\" data-cwl-action=\"toggle\" data-cwl-on-blur=\"action:handleBlur\"\n      title=\"Wizards for this module\"\n      aria-haspopup=\"true\"\n    >\n      <span class=\"wizard-trigger-icon\">🧙</span>\n      <span class=\"wizard-trigger-label\">Wizards</span>\n      <span class=\"wizard-trigger-chevron\">▼</span>\n    </button>\n\n      <div class=\"wizard-dropdown\" role=\"menu\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"wizards as w\" data-cwl-each-item=\"w\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%0A%20%20%20%20%20%20%20%20%20%20%20%20role%3D%22menuitem%22%0A%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22wizard-item%22%20data-cwl-action%3D%22select%22%20data-cwl-action-args%3D%22w.id%22%0A%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Select%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20w.icon%7D%3Cspan%20class%3D%22wizard-item-icon%22%3E%7Bw.icon%7D%3C%2Fspan%3E%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22wizard-item-label%22%3E%7Bw.label%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20\"><button\n            type=\"button\"\n            role=\"menuitem\"\n            class=\"wizard-item\" data-cwl-action=\"select\" data-cwl-action-args=\"w.id\"\n           aria-label=\"Select\">\n            <div hidden aria-hidden=\"true\"><span class=\"wizard-item-icon\"></span></div>\n            <span class=\"wizard-item-label\"></span>\n          </button></div>\n      </div>\n\n  </div></div></div>\n        <button\n          class=\"module-control-btn marketing-btn\"\n            type=\"button\" data-cwl-action=\"openMarketingTools\" data-cwl-attr-title=\"isDrawingRectangle ? &quot;Click and drag on map to draw a rectangle&quot; : &quot;Draw a rectangle on the map to discover addresses&quot;\" data-cwl-attr-disabled=\"!marketingAvailable || isDiscoveringAddresses\"\n        >\n          <span class=\"control-icon\">🔍</span>\n          <span class=\"control-label\">Find Addresses</span>\n        </button>\n        <button\n          class=\"module-control-btn filter-btn\"\n          type=\"button\" data-cwl-toggle=\"showFilterPanel:flip\"\n          title=\"Toggle Layer Filters\"\n        >\n          <span class=\"control-icon\">🎛️</span>\n          <span class=\"control-label\">Layers</span>\n        </button>\n      </div>\n    </div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"contextActivePlan\"><div class=\"plan-summary\">\n        <h3>Active Plan: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"contextActivePlan.name\"></span></h3>\n        <p class=\"summary-line\">\n          Status: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"contextActivePlan.status ?? 'draft'\"></span> • <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"contextActivePlan.showOnMap === false ? 'Hidden' : 'Visible'\"></span>\n        </p>\n        <p class=\"summary-line\">\n          0 staged features • 0 production assets\n        </p>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"marketingCount > 0\"><p class=\"summary-line\">0 marketing leads</p></div>\n      </div></div>\n  </div>\n\n  <!-- Filter Panel (non-modal) -->\n\n    <div\n      class=\"filter-panel-container\"\n      role=\"dialog\"\n      aria-label=\"Layer Filters\"\n     data-cwl-shell-key=\"showFilterPanel\" hidden aria-hidden=\"true\">\n      <div data-cwl-component=\"PlanLayerFilterPanel\" data-cwl-lifted-component=\"PlanLayerFilterPanel\"><div class=\"filter-panel\">\n  <h3>🔍 Map Layers</h3>\n\n  <div class=\"filter-options\">\n    <label class=\"filter-checkbox\">\n      <input\n        type=\"checkbox\" data-cwl-on-change=\"action:toggleLayer\" data-cwl-on-change-args=\"'showMarketing'\"\n      />\n      <span class=\"filter-icon\">📍</span>\n      <span>Marketing Addresses</span>\n    </label>\n\n    <label class=\"filter-checkbox\">\n      <input\n        type=\"checkbox\" data-cwl-on-change=\"action:toggleLayer\" data-cwl-on-change-args=\"'showPlanFeatures'\"\n      />\n      <span class=\"filter-icon\">📋</span>\n      <span>Plan Features</span>\n    </label>\n\n    <label class=\"filter-checkbox\">\n      <input\n        type=\"checkbox\" data-cwl-on-change=\"action:toggleLayer\" data-cwl-on-change-args=\"'showNetworkAssets'\"\n      />\n      <span class=\"filter-icon\">📡</span>\n      <span>Network Assets</span>\n    </label>\n\n    <label class=\"filter-checkbox\">\n      <input\n        type=\"checkbox\" data-cwl-on-change=\"action:toggleLayer\" data-cwl-on-change-args=\"'showBackhaul'\"\n      />\n      <span class=\"filter-icon\">🔗</span>\n      <span>Backhaul Links</span>\n    </label>\n  </div>\n</div></div>\n    </div>\n\n  <!-- Click outside to close filter panel -->\n\n    <div\n      class=\"filter-panel-overlay\" data-cwl-toggle=\"showFilterPanel:false\"\n      role=\"presentation\"\n     data-cwl-shell-key=\"showFilterPanel\" hidden aria-hidden=\"true\"></div>\n\n  <!-- Hardware View Modal -->\n\n  <div\n    class=\"modal-overlay\"\n    role=\"presentation\"\n    aria-hidden=\"true\"\n    tabindex=\"-1\" data-cwl-action=\"handleHardwareOverlayClick\"\n   data-cwl-shell-key=\"showHardwareModal\" hidden>\n    <div\n      class=\"modal-content hardware-modal\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"All hardware\"\n      tabindex=\"0\" data-cwl-on-keydown=\"action:handleHardwareOverlayKeydown\"\n    >\n        <div class=\"modal-header\">\n          <h2>🔧 All Existing Hardware</h2>\n          <button class=\"close-btn\" data-cwl-toggle=\"showHardwareModal:false\" aria-label=\"Show Hardware Modal\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n\n            <div class=\"hardware-summary\">\n              <div class=\"summary-cards\">\n                <div class=\"summary-card\">\n                  <div class=\"card-icon\">📡</div>\n                  <div class=\"card-content\">\n                    <div class=\"card-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getHardwareByType('tower').length\"></span></div>\n                    <div class=\"card-label\">Tower Sites</div>\n                  </div>\n                </div>\n                <div class=\"summary-card\">\n                  <div class=\"card-icon\">📶</div>\n                  <div class=\"card-content\">\n                    <div class=\"card-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getHardwareByType('sector').length\"></span></div>\n                    <div class=\"card-label\">Sectors</div>\n                  </div>\n                </div>\n                <div class=\"summary-card\">\n                  <div class=\"card-icon\">📱</div>\n                  <div class=\"card-content\">\n                    <div class=\"card-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getHardwareByType('cpe').length\"></span></div>\n                    <div class=\"card-label\">CPE Devices</div>\n                  </div>\n                </div>\n                <div class=\"summary-card\">\n                  <div class=\"card-icon\">🔧</div>\n                  <div class=\"card-content\">\n                    <div class=\"card-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getHardwareByType('equipment').length\"></span></div>\n                    <div class=\"card-label\">Equipment</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"hardware-tabs\">\n              <div class=\"tab-buttons\">\n                <button class=\"tab-btn active\">By Module</button>\n                <button class=\"tab-btn\">By Type</button>\n              </div>\n\n              <div class=\"tab-content\">\n                <div class=\"module-breakdown\">\n                  <h4>📱 ACS Managed (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getHardwareByModule('acs').length\"></span>)</h4>\n                  <div class=\"hardware-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"getHardwareByModule('acs') as hardware\"><div class=\"hardware-item readonly\">\n                        <div class=\"item-icon\">📱</div>\n                        <div class=\"item-info\">\n                          <div class=\"item-name\"></div>\n                          <div class=\"item-details\"> • </div>\n                        </div>\n                        <div class=\"item-badge readonly\">Read Only</div>\n                      </div></div>\n                  </div>\n\n                  <h4>🏢 HSS Managed (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getHardwareByModule('hss').length\"></span>)</h4>\n                  <div class=\"hardware-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"getHardwareByModule('hss') as hardware\"><div class=\"hardware-item readonly\">\n                        <div class=\"item-icon\">🏢</div>\n                        <div class=\"item-info\">\n                          <div class=\"item-name\"></div>\n                          <div class=\"item-details\"> • </div>\n                        </div>\n                        <div class=\"item-badge readonly\">Read Only</div>\n                      </div></div>\n                  </div>\n\n                  <h4>📦 Inventory (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getHardwareByModule('inventory').length\"></span>)</h4>\n                  <div class=\"hardware-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"getHardwareByModule('inventory') as hardware\"><div class=\"hardware-item readonly\">\n                        <div class=\"item-icon\">📦</div>\n                        <div class=\"item-info\">\n                          <div class=\"item-name\"></div>\n                          <div class=\"item-details\"> • </div>\n                        </div>\n                        <div class=\"item-badge readonly\">Read Only</div>\n                      </div></div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"loading-state\" hidden aria-hidden=\"true\">\n              <div class=\"spinner\"></div>\n              <p>Loading hardware data...</p>\n            </div>\n\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" data-cwl-toggle=\"showHardwareModal:false\" aria-label=\"Show Hardware Modal\">Close</button>\n          <button class=\"btn-primary\" data-cwl-nav=\"/modules/inventory\">\n            View Full Inventory\n          </button>\n        </div>\n      </div>\n    </div>\n\n  <!-- Project List Modal -->\n\n    <div\n      class=\"modal-overlay\"\n      role=\"presentation\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\" data-cwl-action=\"handleProjectOverlayClick\"\n     data-cwl-shell-key=\"showProjectModal\" hidden>\n      <div\n        class=\"modal-content project-modal\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-label=\"Deployment projects\"\n        tabindex=\"0\" data-cwl-on-keydown=\"action:handleProjectOverlayKeydown\"\n      >\n        <div class=\"modal-header\">\n          <h2>📁 Deployment Projects</h2>\n          <button class=\"close-btn\" data-cwl-toggle=\"showProjectModal:false\" aria-label=\"Show Project Modal\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n          <div class=\"project-list\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"projects as project\" data-cwl-each-item=\"project\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22project-item%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20type%3D%22button%22%20class%3D%22project-content%22%20data-cwl-action%3D%22selectProject%22%20data-cwl-action-args%3D%22project%22%20aria-label%3D%22Select%20Project%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22project-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%3E%7Bproject.name%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20%7Bproject.status%7D%22%3E%7Bproject.status%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22project-description%22%3E%7Bproject.description%7D%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22project-meta%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3ECreated%3A%20%7Bnew%20Date(project.createdAt).toLocaleDateString()%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3EHardware%3A%20%7Bproject.scope.towers.length%20%2B%20project.scope.sectors.length%20%2B%20project.scope.cpeDevices.length%20%2B%20project.scope.equipment.length%7D%20items%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22project-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22action-btn%20marketing-btn%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22button%22%20data-cwl-action%3D%22downloadProjectAddressesCSV%22%20data-cwl-action-args%3D%22project%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Download%20all%20addresses%20from%20this%20project%20as%20CSV%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%93%A5%20Download%20CSV%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20%3D%3D%3D%20'draft'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%20start-btn%22%20data-cwl-action%3D%22startProject%22%20data-cwl-action-args%3D%22project%22%20title%3D%22Start%20Project%20-%20Begin%20working%20on%20this%20project%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%96%B6%EF%B8%8F%20Start%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20%3D%3D%3D%20'ready'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%20approve-btn%22%20data-cwl-action%3D%22approveProject%22%20data-cwl-action-args%3D%22project%22%20title%3D%22Approve%20Project%20-%20Mark%20as%20ready%20for%20deployment%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9C%85%20Approve%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%20reject-btn%22%20data-cwl-action%3D%22rejectProject%22%20data-cwl-action-args%3D%22project%22%20title%3D%22Reject%20Project%20-%20Send%20back%20for%20revision%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9D%8C%20Reject%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20!%3D%3D%20'authorized'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%20delete-btn%22%20data-cwl-action%3D%22deleteProject%22%20data-cwl-action-args%3D%22project%22%20title%3D%22Delete%20Project%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%97%91%EF%B8%8F%20Delete%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20%3D%3D%3D%20'active'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%20finish-btn%22%20data-cwl-action%3D%22finishProject%22%20title%3D%22Finish%20Project%20-%20Mark%20as%20ready%20for%20deployment%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9C%85%20Finish%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%20pause-btn%22%20data-cwl-action%3D%22pauseProject%22%20title%3D%22Pause%20Project%20-%20Save%20progress%20and%20pause%20work%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%8F%B8%EF%B8%8F%20Pause%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22action-btn%20cancel-btn%22%20data-cwl-action%3D%22cancelProject%22%20title%3D%22Cancel%20Project%20-%20Cancel%20this%20project%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9D%8C%20Cancel%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22active-indicator%22%20title%3D%22This%20project%20is%20currently%20active%20-%20all%20map%20changes%20will%20be%20saved%20to%20this%20project%22%3E%F0%9F%94%84%20Active%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22action-btn%20%7Bproject.showOnMap%20%3F%20'visibility-active'%20%3A%20'visibility-inactive'%7D%20%7Bproject.status%20%3D%3D%3D%20'authorized'%20%3F%20'disabled'%20%3A%20''%7D%22%20data-cwl-action%3D%22togglePlanVisibility%22%20data-cwl-action-args%3D%22project%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%7Bproject.status%20%3D%3D%3D%20'authorized'%20%3F%20%22Authorized%20projects%20are%20always%20visible%20in%20production%22%20%3A%20project.showOnMap%20%3F%20%22Hide%20on%20map%22%20%3A%20%22Show%20on%20map%22%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7Bproject.status%20%3D%3D%3D%20'authorized'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bproject.showOnMap%20%3F%20%22%F0%9F%91%81%EF%B8%8F%20Visible%22%20%3A%20%22%F0%9F%91%81%EF%B8%8F%E2%80%8D%F0%9F%97%A8%EF%B8%8F%20Hidden%22%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20%5B'ready'%2C'approved'%2C'rejected'%2C'cancelled'%5D.includes(project.status)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22action-btn%20reopen-btn%22%20data-cwl-action%3D%22reopenProject%22%20data-cwl-action-args%3D%22project%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Reopen%20this%20project%20for%20additional%20planning%20work%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%99%BB%EF%B8%8F%20Reopen%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20%3D%3D%3D%20'approved'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22action-btn%20authorize-btn%22%20data-cwl-action%3D%22authorizeProject%22%20data-cwl-action-args%3D%22project%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Authorize%20Project%20-%20Promote%20this%20project%20to%20production%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%9A%80%20Authorize%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22approved-indicator%22%20title%3D%22This%20project%20has%20been%20approved%20and%20is%20ready%20for%20deployment%22%3E%E2%9C%85%20Approved%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20%3D%3D%3D%20'authorized'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22authorized-indicator%22%20title%3D%22This%20project%20has%20been%20authorized%20and%20merged%20into%20production%22%3E%F0%9F%9A%80%20Authorized%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20%3D%3D%3D%20'rejected'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22rejected-indicator%22%20title%3D%22This%20project%20was%20rejected%20and%20needs%20revision%22%3E%E2%9D%8C%20Rejected%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20project.status%20%3D%3D%3D%20'cancelled'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22cancelled-indicator%22%20title%3D%22This%20project%20was%20cancelled%22%3E%F0%9F%9A%AB%20Cancelled%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"project-item\">\n                <button type=\"button\" class=\"project-content\" data-cwl-action=\"selectProject\" data-cwl-action-args=\"project\" aria-label=\"Select Project\">\n                  <div class=\"project-header\">\n                    <h3></h3>\n                    <span class=\"status-badge \"></span>\n                  </div>\n                  <p class=\"project-description\"></p>\n                  <div class=\"project-meta\">\n                    <span>Created: </span>\n                    <span>Hardware:  items</span>\n                  </div>\n                </button>\n\n                <div class=\"project-actions\">\n                  <button\n                    class=\"action-btn marketing-btn\"\n                    type=\"button\" data-cwl-action=\"downloadProjectAddressesCSV\" data-cwl-action-args=\"project\"\n                    title=\"Download all addresses from this project as CSV\"\n                  >\n                    📥 Download CSV\n                  </button>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status === 'draft'\"><button class=\"action-btn start-btn\" data-cwl-action=\"startProject\" data-cwl-action-args=\"project\" title=\"Start Project - Begin working on this project\">\n                      ▶️ Start\n                    </button></div>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status === 'ready'\"><button class=\"action-btn approve-btn\" data-cwl-action=\"approveProject\" data-cwl-action-args=\"project\" title=\"Approve Project - Mark as ready for deployment\">\n                      ✅ Approve\n                    </button>\n                    <button class=\"action-btn reject-btn\" data-cwl-action=\"rejectProject\" data-cwl-action-args=\"project\" title=\"Reject Project - Send back for revision\">\n                      ❌ Reject\n                    </button></div>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status !== 'authorized'\"><button class=\"action-btn delete-btn\" data-cwl-action=\"deleteProject\" data-cwl-action-args=\"project\" title=\"Delete Project\">\n                      🗑️ Delete\n                    </button></div>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status === 'active'\"><button class=\"action-btn finish-btn\" data-cwl-action=\"finishProject\" title=\"Finish Project - Mark as ready for deployment\">\n                      ✅ Finish\n                    </button>\n                    <button class=\"action-btn pause-btn\" data-cwl-action=\"pauseProject\" title=\"Pause Project - Save progress and pause work\">\n                      ⏸️ Pause\n                    </button>\n                    <button class=\"action-btn cancel-btn\" data-cwl-action=\"cancelProject\" title=\"Cancel Project - Cancel this project\">\n                      ❌ Cancel\n                    </button>\n                    <span class=\"active-indicator\" title=\"This project is currently active - all map changes will be saved to this project\">🔄 Active</span></div>\n\n                  <button\n                    class=\"action-btn  \" data-cwl-action=\"togglePlanVisibility\" data-cwl-action-args=\"project\" aria-label=\"Toggle Plan Visibility\">\n\n                  </button>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"['ready','approved','rejected','cancelled'].includes(project.status)\"><button\n                      class=\"action-btn reopen-btn\" data-cwl-action=\"reopenProject\" data-cwl-action-args=\"project\"\n                      title=\"Reopen this project for additional planning work\"\n                    >\n                      ♻️ Reopen\n                    </button></div>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status === 'approved'\"><button\n                      class=\"action-btn authorize-btn\" data-cwl-action=\"authorizeProject\" data-cwl-action-args=\"project\"\n                      title=\"Authorize Project - Promote this project to production\"\n                    >\n                      🚀 Authorize\n                    </button>\n                    <span class=\"approved-indicator\" title=\"This project has been approved and is ready for deployment\">✅ Approved</span></div>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status === 'authorized'\"><span class=\"authorized-indicator\" title=\"This project has been authorized and merged into production\">🚀 Authorized</span></div>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status === 'rejected'\"><span class=\"rejected-indicator\" title=\"This project was rejected and needs revision\">❌ Rejected</span></div>\n\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"project.status === 'cancelled'\"><span class=\"cancelled-indicator\" title=\"This project was cancelled\">🚫 Cancelled</span></div>\n                </div>\n              </div></div>\n\n              <div class=\"empty-state\" hidden aria-hidden=\"true\">\n                <div class=\"empty-icon\">📁</div>\n                <h3>No Projects Yet</h3>\n                <p>Create your first deployment project to get started.</p>\n                <button class=\"btn-primary\" data-cwl-toggle=\"showCreateProjectModal:true\" aria-label=\"Show Create Project Modal\">Create Project</button>\n              </div>\n\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" type=\"button\" data-cwl-toggle=\"showProjectModal:false\" aria-label=\"Show Project Modal\">Close</button>\n          <button class=\"btn-primary\" type=\"button\" data-cwl-toggle=\"showCreateProjectModal:true\" aria-label=\"Show Create Project Modal\">Create New Project</button>\n        </div>\n      </div>\n    </div>\n\n  <!-- Create Project Modal -->\n\n    <div\n      class=\"modal-overlay\"\n      role=\"presentation\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\" data-cwl-action=\"handleCreateProjectOverlayClick\"\n     data-cwl-shell-key=\"showCreateProjectModal\" hidden>\n      <div\n        class=\"modal-content create-modal\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-label=\"Create new project\"\n        tabindex=\"0\" data-cwl-on-keydown=\"action:handleCreateProjectOverlayKeydown\"\n      >\n        <div class=\"modal-header\">\n          <h2>➕ Create New Project</h2>\n          <button class=\"close-btn\" data-cwl-toggle=\"showCreateProjectModal:false\" aria-label=\"Show Create Project Modal\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n\n            <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n              <strong>Error:</strong>\n            </div>\n\n            <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n              <strong>Success:</strong>\n            </div>\n\n          <form data-cwl-on-submit=\"action:createProject\">\n            <div class=\"form-group\">\n              <label for=\"projectName\">Project Name *</label>\n              <input\n                id=\"projectName\"\n                type=\"text\"\n                placeholder=\"Enter project name\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"projectDescription\">Description</label>\n              <textarea\n                id=\"projectDescription\"\n                placeholder=\"Describe the project scope and objectives\"\n                rows=\"3\" data-cwl-attr-disabled=\"isLoading\"\n              ></textarea>\n            </div>\n\n            <div class=\"form-section\">\n              <h3>Project Location</h3>\n              <p style=\"font-size: 0.9rem; color: #ccc; margin-bottom: 1rem;\">\n                Enter coordinates (lat, lon), city, state, or zip code to center the map.\n                Once you zoom the map to your desired location, the project will be created at the map center.\n              </p>\n\n              <!-- Location Lookup Field -->\n              <div class=\"location-lookup-section\" style=\"margin-bottom: 1.5rem; padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 6px;\">\n                <label for=\"project-location-lookup\" style=\"display: block; margin-bottom: 0.5rem; font-weight: 600;\">\n                  <strong>📍 Location Lookup</strong>\n                  <span style=\"font-size: 0.85rem; font-weight: normal; color: #999; display: block; margin-top: 0.25rem;\">\n                    Enter coordinates (lat, lon), city, state, or zip code\n                  </span>\n                </label>\n                <div style=\"display: flex; gap: 0.5rem;\">\n                  <input\n                    id=\"project-location-lookup\"\n                    type=\"text\"\n                    placeholder=\"e.g., 40.7128, -74.0060 or New York, NY or 10001\" data-cwl-attr-disabled=\"isLoading || isLookingUpProjectLocation\" data-cwl-on-keydown=\"action:handleProjectLocationLookup\"\n                    style=\"flex: 1; padding: 0.5rem; border: 1px solid #555; border-radius: 4px; background: rgba(255,255,255,0.1); color: #fff; font-size: 0.9rem;\"\n                  />\n                  <button\n                    type=\"button\" data-cwl-action=\"handleProjectLocationLookup\" data-cwl-attr-disabled=\"!projectLocationLookup.trim() || isLoading || isLookingUpProjectLocation\"\n                    style=\"padding: 0.5rem 1rem; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.9rem; white-space: nowrap;\"\n                   aria-label=\"Project Location Lookup\">\n                    Lookup & Center Map\n                  </button>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"projectLocationLookupError\"><div style=\"margin-top: 0.5rem; padding: 0.5rem; background: rgba(255,0,0,0.2); color: #ff6b6b; border-radius: 4px; font-size: 0.85rem;\">\n                    <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"projectLocationLookupError\"></span>\n                  </div></div>\n              </div>\n\n              <div style=\"padding: 1rem; background: rgba(0,123,255,0.1); border-radius: 6px; border: 1px solid rgba(0,123,255,0.3);\">\n                <strong style=\"color: #4dabf7;\">💡 Tip:</strong>\n                <p style=\"margin: 0.5rem 0 0 0; font-size: 0.9rem; color: #ccc;\">\n                  After using the lookup, zoom and pan the map to your desired project location.\n                  The project will be created at the current map center when you click \"Create Project\".\n                </p>\n\n                  <div style=\"margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.1);\" hidden aria-hidden=\"true\">\n                    <strong style=\"color: #4dabf7;\">Current Map Center:</strong>\n                    <span style=\"color: #ccc; font-family: monospace; margin-left: 0.5rem;\">\n                      <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"latestMapExtent.center.lat.toFixed(6)\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"latestMapExtent.center.lon.toFixed(6)\"></span>\n                    </span>\n                  </div>\n\n              </div>\n            </div>\n\n            <div class=\"form-section\">\n              <h3>Marketing Coverage</h3>\n              <div class=\"form-group\">\n                <label for=\"projectRadius\">Target Radius (miles)</label>\n                <input\n                  id=\"projectRadius\"\n                  type=\"number\"\n                  min=\"0.5\"\n                  step=\"0.5\" data-cwl-attr-disabled=\"isLoading\"\n                />\n                <small>This radius is used when discovering serviceable addresses for outreach.</small>\n              </div>\n            </div>\n          </form>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" data-cwl-toggle=\"showCreateProjectModal:false\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Show Create Project Modal\">Cancel</button>\n          <button class=\"btn-primary\" data-cwl-action=\"createProject\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Create Project\">\n            Create Project\n          </button>\n        </div>\n      </div>\n    </div>\n\n  <!-- Missing Hardware Modal -->\n\n    <div\n      class=\"modal-overlay\"\n      role=\"presentation\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\" data-cwl-action=\"handleMissingHardwareOverlayClick\"\n     data-cwl-shell-key=\"showMissingHardwareModal\" hidden>\n      <div\n        class=\"modal-content missing-hardware-modal\"\n        role=\"dialog\"\n        aria-modal=\"true\" data-cwl-attr-aria-label=\"`Missing hardware analysis for $`\"\n        tabindex=\"0\" data-cwl-on-keydown=\"action:handleMissingHardwareOverlayKeydown\"\n      >\n        <div class=\"modal-header\">\n          <h2>🛒 Missing Hardware Analysis - <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedProject.name\"></span></h2>\n          <button class=\"close-btn\" data-cwl-toggle=\"showMissingHardwareModal:false\" aria-label=\"Show Missing Hardware Modal\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n          <div class=\"analysis-summary\">\n            <div class=\"summary-card\">\n              <div class=\"card-icon\">💰</div>\n              <div class=\"card-content\">\n                <div class=\"card-value\">$<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedProject.purchasePlan.totalEstimatedCost.toLocaleString()\"></span></div>\n                <div class=\"card-label\">Total Estimated Cost</div>\n              </div>\n            </div>\n            <div class=\"summary-card\">\n              <div class=\"card-icon\">📦</div>\n              <div class=\"card-content\">\n                <div class=\"card-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedProject.purchasePlan.missingHardware.length\"></span></div>\n                <div class=\"card-label\">Missing Items</div>\n              </div>\n            </div>\n            <div class=\"summary-card\">\n              <div class=\"card-icon\">⚠️</div>\n              <div class=\"card-content\">\n                <div class=\"card-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedProject.purchasePlan.missingHardware.filter(item => item.priority === 'c\"></span></div>\n                <div class=\"card-label\">Critical Items</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"missing-hardware-list\">\n\n              <div class=\"hardware-requirements\">\n                <h4>Hardware Requirements</h4>\n                <div class=\"requirements-list\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"selectedProject.hardwareRequirements.needed as requirement, index\"><div class=\"requirement-item\">\n                      <div class=\"requirement-info\">\n                        <div class=\"requirement-name\"></div>\n                        <div class=\"requirement-details\">\n                            • Qty:  •  priority\n                        </div>\n                      </div>\n                      <div class=\"requirement-cost\">$</div>\n                    </div></div>\n                </div>\n              </div>\n\n              <div class=\"missing-items\">\n                <h4>Missing Hardware</h4>\n                <div class=\"missing-list\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"selectedProject.purchasePlan.missingHardware as item\"><div class=\"missing-item\">\n                      <div class=\"item-header\">\n                        <div class=\"item-info\">\n                          <div class=\"item-name\"> </div>\n                          <div class=\"item-details\">Qty:  • $ •  priority</div>\n                        </div>\n                        <div class=\"priority-badge \"></div>\n                      </div>\n                      <div class=\"item-reason\"></div>\n                      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"item.alternatives && item.alternatives.length > 0\"><div class=\"alternatives\">\n                          <h5>Alternatives:</h5>\n                          <div class=\"alternatives-list\">\n                            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"item.alternatives as alt\"><div class=\"alternative-item\">\n                                <span class=\"alt-name\"> </span>\n                                <span class=\"alt-cost\">$</span>\n                                <span class=\"alt-availability \"></span>\n                              </div></div>\n                          </div>\n                        </div></div>\n                    </div></div>\n                </div>\n              </div>\n\n              <div class=\"empty-state\" hidden aria-hidden=\"true\">\n                <div class=\"empty-icon\">✅</div>\n                <h3>No Missing Hardware</h3>\n                <p>All required hardware is available in inventory.</p>\n                <button class=\"btn-primary\" data-cwl-action=\"analyzeMissingHardware\" aria-label=\"Analyze Missing Hardware\">Re-analyze</button>\n              </div>\n\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" data-cwl-toggle=\"showMissingHardwareModal:false\" aria-label=\"Show Missing Hardware Modal\">Close</button>\n          <button class=\"btn-secondary\" data-cwl-action=\"analyzeMissingHardware\" aria-label=\"Analyze Missing Hardware\">Re-analyze</button>\n          <button class=\"btn-primary\" data-cwl-action=\"generatePurchaseOrder\" data-cwl-attr-disabled=\"selectedProject.purchasePlan.missingHardware.length === 0\" aria-label=\"Generate Purchase Order\">\n            Generate Purchase Order\n          </button>\n        </div>\n      </div>\n    </div>\n\n  <!-- Marketing Modal (deprecated - kept for backward compatibility) -->\n\n    <div data-cwl-shell-key=\"showMarketingModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"PlanMarketingModal\" data-cwl-lifted-component=\"PlanMarketingModal\"><div class=\"marketing-backdrop\" role=\"presentation\" aria-hidden=\"false\" hidden>\n  <div\n    class=\"marketing-panel\"\n    role=\"dialog\"\n    aria-modal=\"false\" data-cwl-attr-aria-label=\"`Marketing discovery for $`\"\n    tabindex=\"0\"\n  >\n    <div class=\"modal-header\">\n      <h2>📍 Find Addresses - <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"plan.name\"></span></h2>\n      <div class=\"header-actions\">\n        <button class=\"close-btn\" type=\"button\" data-cwl-action=\"closeModal\" aria-label=\"Close marketing wizard\">\n          ✕\n        </button>\n      </div>\n    </div>\n\n    <div class=\"modal-body\">\n      <nav class=\"wizard-steps\" aria-label=\"Marketing discovery steps\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"steps as step, index\"><button\n            type=\"button\"\n            class=\"wizard-step\" data-cwl-action=\"goToStep\" data-cwl-action-args=\"index\" aria-label=\"Go To Step\">\n            <span class=\"step-index\"></span>\n            <span class=\"step-label\"></span>\n          </button></div>\n      </nav>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 0\"><section class=\"wizard-panel\">\n          <header>\n            <h3>Review & Run Discovery</h3>\n            <p>The system will: (1) Find building footprints in map view → (2) Calculate centroids → (3) Reverse geocode with ArcGIS → (4) Deduplicate → (5) Place markers</p>\n          </header>\n\n          <!-- Combined information from both steps -->\n          <div class=\"review-grid\">\n\n              <div hidden aria-hidden=\"true\">\n                <span class=\"label\">Map Center</span>\n                <span class=\"value\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(latestExtent.center.lat)\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(latestExtent.center.lon)\"></span>\n                </span>\n              </div>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"extentSpanMiles\"><div>\n                <span class=\"label\">Search Area</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"extentSpanMiles.width.toFixed(1)\"></span> × <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"extentSpanMiles.height.toFixed(1)\"></span> mi</span>\n              </div></div>\n            <div>\n              <span class=\"label\">Algorithms</span>\n              <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedAlgorithmLabels.join(', ')\"></span></span>\n            </div>\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"latestExtent?.boundingBox && extentSpanMiles\"><div class=\"extent-summary-prominent\" style=\"margin-top: 1rem;\">\n              <h4>📍 Search Area Details</h4>\n              <div class=\"extent-details\">\n                <span>\n                  <strong>Bounds:</strong> lat <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(latestExtent.boundingBox.south, 4)\"></span> → <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(latestExtent.boundingBox.north, 4)\"></span>,\n                  lon <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(latestExtent.boundingBox.west, 4)\"></span> → <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(latestExtent.boundingBox.east, 4)\"></span>\n                </span>\n                <span><strong>Span:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"extentSpanMiles.width.toFixed(1)\"></span> × <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"extentSpanMiles.height.toFixed(1)\"></span> miles</span>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"Math.max(extentSpanMiles.width, extentSpanMiles.height) > 100\"><span class=\"extent-warning\">⚠️ Large area - will be auto-constrained to 50×50 miles max</span></div>\n              </div>\n            </div></div>\n\n            <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n              <strong>Error:</strong>\n            </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"info\"><div class=\"alert alert-info\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"info\"></span>\n            </div></div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"pendingExtentChange\"><div class=\"alert alert-reminder\">\n              Map view changed since the last run. Move the map to your next target area and run discovery again to capture it.\n            </div></div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!hasMapExtent\"><div class=\"alert alert-warning\">\n              <strong>⚠️ Map extent not available.</strong> Please zoom the map to define the search area before running discovery.\n            </div></div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"summary\"><div class=\"summary-grid\">\n              <div class=\"summary-card\">\n                <span class=\"label\">Total Candidates</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"summary.totalCandidates\"></span></span>\n              </div>\n              <div class=\"summary-card\">\n                <span class=\"label\">Geocoded</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"summary.geocodedCount\"></span></span>\n              </div>\n              <div class=\"summary-card\">\n                <span class=\"label\">New This Run</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"summary.newlyAdded ?? 0\"></span></span>\n              </div>\n              <div class=\"summary-card\">\n                <span class=\"label\">Saved Total</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"summary.totalUniqueAddresses ?? getTotalSavedAddresses()\"></span></span>\n              </div>\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"getTotalRunCount()\"><div class=\"summary-card\">\n                  <span class=\"label\">Runs Completed</span>\n                  <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getTotalRunCount()\"></span></span>\n                </div></div>\n            <div class=\"summary-card\">\n                <span class=\"label\">Radius</span>\n                <span class=\"value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"summary.radiusMiles\"></span> mi</span>\n              </div>\n\n                <div class=\"summary-card\" hidden aria-hidden=\"true\">\n                  <span class=\"label\">Center</span>\n                  <span class=\"value\">\n                    <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(summary.center.lat, 4)\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"formatCoord(summary.center.lon, 4)\"></span>\n                  </span>\n                </div>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"summary.algorithmsUsed?.length\"><div class=\"summary-card full-width\">\n                <span class=\"label\">Algorithms Used</span>\n                <ul class=\"algorithm-list\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"summary.algorithmsUsed as algId\"><li></li></div>\n                </ul>\n              </div></div>\n            </div></div>\n\n          <div class=\"results\">\n            <div class=\"results-note\">\n              <p>\n                Addresses discovered in this run are saved with the plan and rendered on the coverage map as\n                marketing leads. Review them from the map or export the CSV once the run completes.\n              </p>\n              <ul>\n                <li><strong>New this run:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getNewlyAddedThisRun()\"></span></li>\n                <li><strong>Total saved (all runs):</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getTotalSavedAddresses()\"></span></li>\n                <li><strong>Geocoded this run:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"summary?.geocodedCount ?? 0\"></span></li>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"getTotalRunCount()\"><li><strong>Runs completed:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getTotalRunCount()\"></span></li></div>\n\n                  <div hidden aria-hidden=\"true\"><div data-cwl-bind=\"each\" data-cwl-hole-detail=\"Object.entries(summary.algorithmStats) as [algId, stats]\"><li>\n                      <strong>:</strong>\n                       candidates ( geocoded)\n                    </li></div>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"plan.marketing?.lastRunAt\"><li><strong>Last run:</strong> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"new Date(plan.marketing.lastRunAt).toLocaleString()\"></span></li></div>\n              </ul>\n            </div>\n          </div>\n        </section></div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" type=\"button\" data-cwl-action=\"closeModal\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Close Modal\">\n        Cancel\n      </button>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 0\"><button class=\"btn-tertiary\" type=\"button\" data-cwl-action=\"prevStep\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Prev Step\">\n          Back\n        </button></div>\n\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep < steps.length - 1\"><button class=\"btn-primary\" type=\"button\" data-cwl-action=\"nextStep\" data-cwl-attr-disabled=\"!canAdvance || isLoading\" aria-label=\"Next Step\">\n          Next\n        </button></div>\n        <div class=\"run-actions\">\n          <button class=\"btn-primary\" type=\"button\" data-cwl-action=\"discoverAddresses\" data-cwl-attr-disabled=\"!canRun || isLoading\" aria-label=\"Discover Addresses\">\n            <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isLoading ? 'Discovering…' : results.length ? 'Re-run Discovery' : 'Run Discover\"></span>\n          </button>\n          <button\n            class=\"btn-secondary\"\n            type=\"button\" data-cwl-action=\"downloadLatestCsv\" data-cwl-attr-disabled=\"isLoading || (!results.length &amp;&amp; !summary)\"\n           aria-label=\"Download Latest Csv\">\n            ⬇️ Download This Run\n          </button>\n          <button\n            class=\"btn-secondary\"\n            type=\"button\" data-cwl-action=\"downloadAllCsv\" data-cwl-attr-disabled=\"isLoading || (!getAllSavedAddresses().length &amp;&amp; !getTotalSavedAddresses())\"\n           aria-label=\"Download All Csv\">\n            ⬇️ Download All Addresses\n          </button>\n        </div>\n\n    </div>\n  </div>\n</div></div>\n  </div>\n\n  <!-- Marketing Results Popup -->\n\n    <div data-cwl-shell-key=\"showMarketingResultsPopup\" hidden aria-hidden=\"true\"><div data-cwl-component=\"PlanMarketingResultsPopup\" data-cwl-lifted-component=\"PlanMarketingResultsPopup\">n\n\n<div class=\"popup-overlay\" data-cwl-action=\"close\" data-cwl-on-keydown=\"action:close\" role=\"presentation\" tabindex=\"-1\" hidden aria-hidden=\"true\">\n  <div class=\"popup-content\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Marketing Address Discovery Results\">\n    <div class=\"popup-header\">\n      <h2>🔍 Address Discovery Results</h2>\n      <button class=\"close-btn\" data-cwl-action=\"close\" aria-label=\"Close\">✕</button>\n    </div>\n\n    <div class=\"popup-body\">\n\n        <div class=\"results-summary\">\n          <p><strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"addresses.length\"></span></strong> address<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"addresses.length !== 1 ? 'es' : ''\"></span> found</p>\n        </div>\n\n        <div class=\"results-list\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"addresses.slice(0, 100) as addr (addr.latitude + ',' + addr.longitude)\"><div class=\"result-item\">\n              <div class=\"result-address\">\n\n                  <em>No address information</em>\n\n                  <div hidden aria-hidden=\"true\"><strong></strong>\n\n                    <div hidden aria-hidden=\"true\"><br>\n                  </div>\n                </div>\n              </div>\n              <div class=\"result-location\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"addr.city || addr.state || addr.postalCode\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"[addr.city, addr.state, addr.postalCode].filter(Boolean).join(', ')\"></span></div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"addr.latitude !== undefined && addr.longitude !== undefined\"><br><small>📍 , </small></div>\n              </div>\n\n                <div class=\"result-source\" hidden aria-hidden=\"true\">\n                  <small>Source: </small>\n                </div>\n\n            </div></div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"addresses.length > 100\"><div class=\"results-more\">\n              <p>... and <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"addresses.length - 100\"></span> more address<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"addresses.length - 100 !== 1 ? 'es' : ''\"></span></p>\n            </div></div>\n        </div>\n\n        <div class=\"empty-state\" hidden aria-hidden=\"true\">\n          <p>No addresses found in the selected area.</p>\n        </div>\n\n        <div class=\"loading-state\" hidden aria-hidden=\"true\">\n          <div class=\"spinner\"></div>\n          <p>Discovering addresses...</p>\n        </div>\n\n    </div>\n\n    <div class=\"popup-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"close\" aria-label=\"Close\">Close</button>\n\n        <button class=\"btn-primary\" data-cwl-action=\"exportToCSV\" aria-label=\"Export To CSV\">\n          📥 Download CSV (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"addresses.length\"></span>)\n        </button>\n\n    </div>\n  </div>\n</div></div>\n  </div>\n\n  <!-- Add Hardware Requirement Modal -->\n\n    <div\n      class=\"modal-overlay\"\n      role=\"presentation\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\" data-cwl-action=\"handleAddRequirementOverlayClick\"\n     data-cwl-shell-key=\"showAddRequirementModal\" hidden>\n      <div\n        class=\"modal-content add-requirement-modal\"\n        role=\"dialog\"\n        aria-modal=\"true\" data-cwl-attr-aria-label=\"`Add hardware requirement for $`\"\n        tabindex=\"0\" data-cwl-on-keydown=\"action:handleAddRequirementOverlayKeydown\"\n      >\n        <div class=\"modal-header\">\n          <h2>📋 Add Hardware Requirement - <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedProject.name\"></span></h2>\n          <button class=\"close-btn\" data-cwl-toggle=\"showAddRequirementModal:false\" aria-label=\"Show Add Requirement Modal\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n          <form data-cwl-on-submit=\"action:addHardwareRequirement\">\n            <div class=\"form-group\">\n              <label for=\"category\">Category *</label>\n              <select id=\"category\" required>\n                <option>Select category...</option>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"categories as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bcategory%7D%3E%7Bcategory%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"equipmentType\">Equipment Type *</label>\n              <select id=\"equipmentType\" required>\n                <option>Select equipment type...</option>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableTypes as type\" data-cwl-each-item=\"type\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Btype%7D%3E%7Btype%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n              </select>\n            </div>\n\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"manufacturer\">Manufacturer</label>\n                <input\n                  id=\"manufacturer\"\n                  type=\"text\"\n                  placeholder=\"e.g., Ubiquiti, Cisco\"\n                />\n              </div>\n\n              <div class=\"form-group\">\n                <label for=\"model\">Model</label>\n                <input\n                  id=\"model\"\n                  type=\"text\"\n                  placeholder=\"e.g., NanoStation M5\"\n                />\n              </div>\n            </div>\n\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"quantity\">Quantity *</label>\n                <input\n                  id=\"quantity\"\n                  type=\"number\"\n                  min=\"1\"\n                  required\n                />\n              </div>\n\n              <div class=\"form-group\">\n                <label for=\"priority\">Priority *</label>\n                <select id=\"priority\" required>\n                  <option value=\"low\">Low</option>\n                  <option value=\"medium\">Medium</option>\n                  <option value=\"high\">High</option>\n                  <option value=\"critical\">Critical</option>\n                </select>\n              </div>\n            </div>\n          </form>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" data-cwl-toggle=\"showAddRequirementModal:false\" aria-label=\"Show Add Requirement Modal\">Cancel</button>\n          <button class=\"btn-primary\" data-cwl-action=\"addHardwareRequirement\" data-cwl-attr-disabled=\"!newRequirement.equipmentType.trim()\" aria-label=\"Add Hardware Requirement\">\n            Add Requirement\n          </button>\n        </div>\n      </div>\n    </div>\n\n  <!-- Planning Report Modal -->\n\n    <div\n      class=\"modal-overlay\"\n      role=\"presentation\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\" data-cwl-action=\"handleReportOverlayClick\"\n     data-cwl-shell-key=\"showReportModal\" hidden>\n      <div\n        class=\"modal-content\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-label=\"Planning reports dialog\"\n        tabindex=\"0\" data-cwl-on-keydown=\"action:handleReportOverlayKeydown\"\n      >\n        <div class=\"modal-header\">\n          <h2>📊 Planning Reports</h2>\n          <button class=\"close-btn\" data-cwl-toggle=\"showReportModal:false\" aria-label=\"Show Report Modal\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n          <div class=\"report-section\">\n            <h3>📡 Tower Sites</h3>\n            <p>Complete inventory of all tower sites with coverage analysis and capacity planning data.</p>\n            <button class=\"btn-primary\" data-cwl-nav=\"/modules/coverage-map\">\n              View Tower Sites\n            </button>\n          </div>\n\n          <div class=\"report-section\">\n            <h3>📶 Sector Analysis</h3>\n            <p>Detailed sector coverage maps, interference analysis, and optimization recommendations.</p>\n            <button class=\"btn-primary\" data-cwl-nav=\"/modules/coverage-map\">\n              View Sector Analysis\n            </button>\n          </div>\n\n          <div class=\"report-section\">\n            <h3>📱 CPE Planning</h3>\n            <p>Customer premises equipment planning, signal strength analysis, and deployment recommendations.</p>\n            <button class=\"btn-primary\" data-cwl-nav=\"/modules/coverage-map\">\n              View CPE Planning\n            </button>\n          </div>\n\n          <div class=\"report-section\">\n            <h3>🔧 Equipment Inventory</h3>\n            <p>Complete equipment inventory with maintenance schedules and replacement planning.</p>\n            <button class=\"btn-primary\" data-cwl-nav=\"/modules/inventory\">\n              View Equipment Inventory\n            </button>\n          </div>\n\n          <div class=\"report-section\">\n            <h3>📋 Work Orders</h3>\n            <p>Planning work orders, maintenance schedules, and deployment tasks.</p>\n            <button class=\"btn-primary\" data-cwl-nav=\"/modules/work-orders\">\n              View Work Orders\n            </button>\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" data-cwl-toggle=\"showReportModal:false\" aria-label=\"Show Report Modal\">Close</button>\n          <button class=\"btn-primary\" data-cwl-nav=\"/modules/coverage-map\">\n            Open Full Coverage Map\n          </button>\n        </div>\n      </div>\n    </div>\n\n  <!-- Global Settings Button - Hidden in plan mode, shown in coverage-map iframe instead -->\n\n  <!-- Help Modal -->\n  <div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showHelpModal\" hidden aria-hidden=\"true\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">Plan Module Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n<h3>📋 Plan Module</h3>\n\n<div class=\"info\">\n  <strong>Purpose:</strong> Create and manage network expansion projects. Plan new tower sites, sectors, and infrastructure before deployment. Discover marketing addresses and visualize planned network coverage.\n</div>\n\n<div class=\"toc\">\n  <h4>📑 Table of Contents</h4>\n  <ul>\n    <li><a href=\"#key-features\">🎯 Key Features</a></li>\n    <li><a href=\"#getting-started\">🚀 Getting Started</a></li>\n    <li><a href=\"#project-workflow\">📊 Project Workflow</a></li>\n    <li><a href=\"#map-features\">🗺️ Map Features</a></li>\n    <li><a href=\"#hardware-requirements\">📦 Hardware Requirements</a></li>\n    <li><a href=\"#marketing-discovery\">📈 Marketing Address Discovery</a></li>\n    <li><a href=\"#best-practices\">💡 Best Practices</a></li>\n    <li><a href=\"#troubleshooting\">🔧 Troubleshooting</a></li>\n    <li><a href=\"#next-steps\">📚 Next Steps</a></li>\n  </ul>\n</div>\n\n<h4 id=\"key-features\">🎯 Key Features</h4>\n<ul>\n  <li><strong>Project Management:</strong> Create, edit, and manage network expansion projects</li>\n  <li><strong>Marketing Address Discovery:</strong> Find potential customer addresses in target areas</li>\n  <li><strong>Hardware Planning:</strong> Plan required equipment and inventory for projects</li>\n  <li><strong>Visual Planning:</strong> Draw coverage areas and plan tower locations on map</li>\n  <li><strong>Project Workflow:</strong> Move projects from draft → ready → approved → deployed</li>\n  <li><strong>Hardware Requirements:</strong> Track equipment needed for each project</li>\n</ul>\n\n<h4 id=\"getting-started\">🚀 Getting Started</h4>\n\n<h4>Step 1: Create a New Project</h4>\n<ol>\n  <li>Click <strong>\"New Project\"</strong> button</li>\n  <li>Enter project details:\n    <ul>\n      <li><strong>Project Name</strong> - Descriptive name (e.g., \"Downtown Expansion\")</li>\n      <li><strong>Description</strong> - Project goals and scope</li>\n      <li><strong>Location</strong> - Target area address or coordinates</li>\n      <li><strong>Target Radius</strong> - Coverage area in miles (default: 5 miles)</li>\n    </ul>\n  </li>\n  <li>Click <strong>\"Create Project\"</strong></li>\n  <li>Project starts in <strong>\"Draft\"</strong> status</li>\n</ol>\n\n<h4>Step 2: Discover Marketing Addresses</h4>\n<ol>\n  <li>With a project active, click <strong>\"Discover Addresses\"</strong></li>\n  <li>Draw a rectangle on the map or use project center</li>\n  <li>System discovers potential customer addresses in the area</li>\n  <li>Review discovered addresses:\n    <ul>\n      <li>Address details and coordinates</li>\n      <li>Estimated serviceability</li>\n      <li>Distance from planned towers</li>\n    </ul>\n  </li>\n  <li>Addresses are saved to the project</li>\n</ol>\n\n<h4>Step 3: Plan Tower Sites</h4>\n<ol>\n  <li>Right-click on map where you want a tower</li>\n  <li>Select <strong>\"Add to Plan\" → \"Add Site\"</strong></li>\n  <li>Enter tower details:\n    <ul>\n      <li>Site name and type</li>\n      <li>Height and location</li>\n      <li>FCC ID (if applicable)</li>\n    </ul>\n  </li>\n  <li>Tower is linked to the active project</li>\n  <li>Repeat for all planned towers</li>\n</ol>\n\n<h4>Step 4: Plan Sectors</h4>\n<ol>\n  <li>Right-click on a planned tower</li>\n  <li>Select <strong>\"Add to Plan\" → \"Add Sector\"</strong></li>\n  <li>Configure sector parameters:\n    <ul>\n      <li>Azimuth (direction)</li>\n      <li>Beamwidth and tilt</li>\n      <li>Frequency band</li>\n      <li>Technology (LTE, CBRS, FWA)</li>\n    </ul>\n  </li>\n  <li>Sector is linked to project</li>\n</ol>\n\n<h4>Step 5: Add Hardware Requirements</h4>\n<ol>\n  <li>Click <strong>\"Hardware Requirements\"</strong> button</li>\n  <li>Click <strong>\"Add Requirement\"</strong></li>\n  <li>Enter equipment details:\n    <ul>\n      <li>Category (Radio, Antenna, Router, etc.)</li>\n      <li>Manufacturer and model</li>\n      <li>Quantity needed</li>\n      <li>Priority (Low, Medium, High, Critical)</li>\n    </ul>\n  </li>\n  <li>Save requirement</li>\n  <li>Repeat for all needed equipment</li>\n</ol>\n\n<h4>Step 6: Finalize Project</h4>\n<ol>\n  <li>Review all planned sites, sectors, and requirements</li>\n  <li>Click <strong>\"Finalize Project\"</strong></li>\n  <li>Project status changes to <strong>\"Ready\"</strong></li>\n  <li>Project moves to <strong>Deploy</strong> module for approval</li>\n</ol>\n\n<h4 id=\"project-workflow\">📊 Project Workflow</h4>\n\n<h4>Project Statuses</h4>\n<ul>\n  <li><strong>Draft:</strong> Project is being planned (Plan module only)</li>\n  <li><strong>Ready:</strong> Project is finalized and ready for approval</li>\n  <li><strong>Approved:</strong> Project approved for deployment</li>\n  <li><strong>Authorized:</strong> Project authorized to begin deployment</li>\n  <li><strong>Deployed:</strong> Project deployment completed</li>\n  <li><strong>Archived:</strong> Project completed or cancelled</li>\n</ul>\n\n<h4>Workflow Steps</h4>\n<ol>\n  <li><strong>Plan Module:</strong> Create project, plan sites, add requirements</li>\n  <li><strong>Plan Module:</strong> Finalize project (status: Ready)</li>\n  <li><strong>Deploy Module:</strong> Review and approve project</li>\n  <li><strong>Deploy Module:</strong> Authorize deployment</li>\n  <li><strong>Deploy Module:</strong> Deploy hardware and mark as deployed</li>\n</ol>\n\n<h4 id=\"map-features\">🗺️ Map Features</h4>\n\n<h4>Planning Mode</h4>\n<p>In Plan module, the map shows:</p>\n<ul>\n  <li><strong>Planned Sites:</strong> Tower sites created in this project</li>\n  <li><strong>Planned Sectors:</strong> Sectors linked to project</li>\n  <li><strong>Marketing Addresses:</strong> Discovered potential customer locations</li>\n  <li><strong>Existing Network:</strong> Current deployed infrastructure (read-only)</li>\n  <li><strong>Hardware Inventory:</strong> Available equipment for deployment</li>\n</ul>\n\n<h4>Drawing Tools</h4>\n<ul>\n  <li><strong>Rectangle Tool:</strong> Draw area for marketing address discovery</li>\n  <li><strong>Right-Click Menu:</strong> Add sites, sectors, CPE to project</li>\n  <li><strong>Layer Filters:</strong> Show/hide planned vs. deployed assets</li>\n</ul>\n\n<h4 id=\"hardware-requirements\">📦 Hardware Requirements</h4>\n\n<h4>Adding Requirements</h4>\n<p>Track equipment needed for project:</p>\n<ul>\n  <li>Radio equipment (base stations, CPE)</li>\n  <li>Antennas and mounting hardware</li>\n  <li>Routers and switches</li>\n  <li>Power systems and batteries</li>\n  <li>Cables and connectors</li>\n</ul>\n\n<h4>Requirement Priority</h4>\n<ul>\n  <li><strong>Critical:</strong> Must have before deployment starts</li>\n  <li><strong>High:</strong> Needed early in deployment</li>\n  <li><strong>Medium:</strong> Needed during deployment</li>\n  <li><strong>Low:</strong> Nice to have, can be added later</li>\n</ul>\n\n<h4>Checking Inventory</h4>\n<ol>\n  <li>View hardware requirements list</li>\n  <li>System shows available inventory</li>\n  <li>Identify missing equipment</li>\n  <li>Order or allocate equipment before deployment</li>\n</ol>\n\n<h4 id=\"marketing-discovery\">📈 Marketing Address Discovery</h4>\n\n<h4>How It Works</h4>\n<p>Uses Microsoft Footprints API to discover addresses:</p>\n<ol>\n  <li>Draw rectangle on map or use project center</li>\n  <li>System queries address database</li>\n  <li>Returns potential customer locations</li>\n  <li>Addresses saved to project for review</li>\n</ol>\n\n<h4>Using Discovered Addresses</h4>\n<ul>\n  <li>Review address list</li>\n  <li>Filter by distance from towers</li>\n  <li>Export addresses for marketing campaigns</li>\n  <li>Use for coverage planning</li>\n  <li>Prioritize high-value areas</li>\n</ul>\n\n<h4 id=\"best-practices\">💡 Best Practices</h4>\n<ul>\n  <li><strong>Start with Location:</strong> Choose target area first</li>\n  <li><strong>Discover Early:</strong> Find addresses before planning towers</li>\n  <li><strong>Plan Coverage:</strong> Ensure towers cover discovered addresses</li>\n  <li><strong>Track Requirements:</strong> Add all needed equipment</li>\n  <li><strong>Review Before Finalizing:</strong> Double-check all planned assets</li>\n  <li><strong>Coordinate with Deploy:</strong> Ensure inventory is available</li>\n</ul>\n\n<h4 id=\"troubleshooting\">🔧 Troubleshooting</h4>\n\n<h4>Can't create project:</h4>\n<ul>\n  <li>Verify you have tenant selected</li>\n  <li>Check project name is unique</li>\n  <li>Ensure location coordinates are valid</li>\n</ul>\n\n<h4>Marketing discovery not working:</h4>\n<ul>\n  <li>Verify Microsoft Footprints API is configured</li>\n  <li>Check rectangle is drawn correctly</li>\n  <li>Ensure area is not too large (max 50 miles radius)</li>\n</ul>\n\n<h4>Planned sites not showing:</h4>\n<ul>\n  <li>Verify project is active (selected)</li>\n  <li>Check layer filters show planned assets</li>\n  <li>Ensure sites are linked to project</li>\n</ul>\n\n<h4 id=\"next-steps\">📚 Next Steps</h4>\n\n<p>After finalizing your project:</p>\n<ul>\n  <li>Project moves to <strong>Deploy</strong> module for approval</li>\n  <li>Once approved, hardware can be deployed</li>\n  <li>Deployed assets appear in <strong>Monitor</strong> module</li>\n</ul>\n\n      </div>\n    </div>\n  </div></div></div>\n\n<!-- MapLayerManager: overlay/visibleProjects/projectOverlays wired. Staging CRUD (site/equipment add/edit/delete from plan) planned – see docs/PROJECT_WORKFLOW_STATUS.md --></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\" hidden aria-hidden=\"true\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div>\n<div data-cwl-component=\"HSSImportModal\" data-cwl-lifted-component=\"HSSImportModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"modal-overlay\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    tabindex=\"0\"\n    aria-label=\"HSS data import dialog\" data-cwl-action=\"handleOverlayClick\" data-cwl-on-keydown=\"action:handleOverlayKeydown\"\n   hidden aria-hidden=\"true\">\n    <div class=\"modal-content hss-import-modal\" role=\"document\">\n      <div class=\"modal-header\">\n        <h2>🏠 HSS Data Import</h2>\n        <div class=\"header-actions\">\n          <button class=\"export-btn\" data-cwl-action=\"exportToInventory\" data-cwl-attr-disabled=\"!importData\" title=\"Export to Inventory\">\n            📥 Export\n          </button>\n          <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n        </div>\n      </div>\n\n        <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"success-banner\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"modal-body\">\n\n          <!-- Tabs -->\n          <div class=\"tabs\">\n            <button\n              class=\"tab-btn\" data-cwl-set=\"activeTab:subscribers\"\n            >\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getTabIcon('subscribers')\"></span> Subscribers\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"getDataCount('subscribers') > 0\"><span class=\"count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('subscribers')\"></span></span></div>\n            </button>\n            <button\n              class=\"tab-btn\" data-cwl-set=\"activeTab:groups\"\n            >\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getTabIcon('groups')\"></span> Groups\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"getDataCount('groups') > 0\"><span class=\"count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('groups')\"></span></span></div>\n            </button>\n            <button\n              class=\"tab-btn\" data-cwl-set=\"activeTab:plans\"\n            >\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getTabIcon('plans')\"></span> Plans\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"getDataCount('plans') > 0\"><span class=\"count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('plans')\"></span></span></div>\n            </button>\n            <button\n              class=\"tab-btn\" data-cwl-set=\"activeTab:epcs\"\n            >\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getTabIcon('epcs')\"></span> EPCs\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"getDataCount('epcs') > 0\"><span class=\"count-badge\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('epcs')\"></span></span></div>\n            </button>\n          </div>\n\n          <!-- Tab Content -->\n          <div class=\"tab-content\">\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'subscribers'\">\n              <div class=\"subscribers-content\">\n                <h3>Subscribers (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('subscribers')\"></span>)</h3>\n                <p>LTE/5G subscriber profiles with IMSI, authentication keys, and QoS settings</p>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importData?.subscribers?.length > 0\"><div class=\"data-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"importData.subscribers as subscriber\"><div class=\"data-item\">\n                        <div class=\"item-header\">\n                          <strong></strong>\n                          <span class=\"status-badge\">\n\n                          </span>\n                        </div>\n                        <div class=\"item-details\">\n                          <div class=\"detail-row\">\n                            <span class=\"label\">IMSI:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">MSISDN:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">QCI:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">APN:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Bandwidth:</span>\n                            <span class=\"value\">Mbps UL / Mbps DL</span>\n                          </div>\n                        </div>\n                      </div></div>\n                  </div></div>\n                  <div class=\"no-data\">\n                    <p>No subscribers found</p>\n                  </div>\n\n              </div>\n\n            </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'groups'\" hidden aria-hidden=\"true\">\n              <div class=\"groups-content\">\n                <h3>Subscriber Groups (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('groups')\"></span>)</h3>\n                <p>Organizational groups for subscriber management</p>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importData?.groups?.length > 0\"><div class=\"data-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"importData.groups as group\"><div class=\"data-item\">\n                        <div class=\"item-header\">\n                          <strong></strong>\n                          <span class=\"count-badge\"> subscribers</span>\n                        </div>\n                        <div class=\"item-details\">\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Description:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Created:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                        </div>\n                      </div></div>\n                  </div></div>\n                  <div class=\"no-data\">\n                    <p>No groups found</p>\n                  </div>\n\n              </div>\n\n            </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'plans'\" hidden aria-hidden=\"true\">\n              <div class=\"plans-content\">\n                <h3>Bandwidth Plans (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('plans')\"></span>)</h3>\n                <p>Speed tiers and QoS parameters for subscribers</p>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importData?.plans?.length > 0\"><div class=\"data-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"importData.plans as plan\"><div class=\"data-item\">\n                        <div class=\"item-header\">\n                          <strong></strong>\n                          <span class=\"count-badge\"> subscribers</span>\n                        </div>\n                        <div class=\"item-details\">\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Speed:</span>\n                            <span class=\"value\">Mbps UL / Mbps DL</span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Data Limit:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Price:</span>\n                            <span class=\"value\">$</span>\n                          </div>\n                        </div>\n                      </div></div>\n                  </div></div>\n                  <div class=\"no-data\">\n                    <p>No bandwidth plans found</p>\n                  </div>\n\n              </div>\n\n            </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"activeTab === 'epcs'\" hidden aria-hidden=\"true\">\n              <div class=\"epcs-content\">\n                <h3>EPC Instances (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"getDataCount('epcs')\"></span>)</h3>\n                <p>Evolved Packet Core deployment instances</p>\n\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"importData?.epcs?.length > 0\"><div class=\"data-list\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"importData.epcs as epc\"><div class=\"data-item\">\n                        <div class=\"item-header\">\n                          <strong></strong>\n                          <span class=\"status-badge\">\n\n                          </span>\n                        </div>\n                        <div class=\"item-details\">\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Location:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">MCC/MNC:</span>\n                            <span class=\"value\">/</span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">TAC:</span>\n                            <span class=\"value\"></span>\n                          </div>\n                          <div class=\"detail-row\">\n                            <span class=\"label\">Contact:</span>\n                            <span class=\"value\"> ()</span>\n                          </div>\n                        </div>\n                      </div></div>\n                  </div></div>\n                  <div class=\"no-data\">\n                    <p>No EPC instances found</p>\n                  </div>\n\n              </div>\n            </div>\n          </div>\n\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/sites"
page modules_sites_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/sites" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"sites\" data-wisp-path=\"/modules/sites\" data-cwl-island=\"client\"><div class=\"sites-page\">\n    <div class=\"page-header\">\n      <div>\n        <h1>🏢 Site Management</h1>\n        <p class=\"subtitle\">Manage all network sites, towers, buildings, and facilities</p>\n      </div>\n      <div class=\"header-actions\">\n        <button class=\"btn-primary\" data-cwl-toggle=\"showEditModal:true\" aria-label=\"Show Edit Modal\">\n          ➕ Create New Site\n        </button>\n        <button class=\"btn-secondary\" data-cwl-action=\"loadSites\" title=\"Refresh\">\n          🔄 Refresh\n        </button>\n      </div>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <!-- Filters and Search -->\n    <div class=\"filters-section\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"Search sites by name, address, or city...\"\n          class=\"search-input\"\n        />\n        <span class=\"search-icon\">🔍</span>\n      </div>\n\n      <div class=\"filter-group\">\n        <label>Type:</label>\n        <select>\n          <option value=\"all\">All Types</option>\n          <option value=\"tower\">📡 Tower</option>\n          <option value=\"building\">🏢 Building</option>\n          <option value=\"noc\">🖥️ NOC</option>\n          <option value=\"warehouse\">🏭 Warehouse</option>\n          <option value=\"pole\">📡 Pole</option>\n          <option value=\"other\">📍 Other</option>\n        </select>\n      </div>\n\n      <div class=\"filter-group\">\n        <label>Status:</label>\n        <select>\n          <option value=\"all\">All Statuses</option>\n          <option value=\"active\">✅ Active</option>\n          <option value=\"inactive\">❌ Inactive</option>\n          <option value=\"maintenance\">🔧 Maintenance</option>\n          <option value=\"planned\">📅 Planned</option>\n        </select>\n      </div>\n    </div>\n\n    <!-- Summary Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sites.length\"></span></div>\n        <div class=\"stat-label\">Total Sites</div>\n      </div>\n      <div class=\"stat-card active\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sites.filter(s => s.status === 'active').length\"></span></div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sites.filter(s => s.type === 'tower').length\"></span></div>\n        <div class=\"stat-label\">Towers</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sites.filter(s => s.type === 'building').length\"></span></div>\n        <div class=\"stat-label\">Buildings</div>\n      </div>\n    </div>\n\n    <!-- Sites Table -->\n\n      <div class=\"sites-table-container\">\n        <table class=\"sites-table\">\n          <thead>\n            <tr>\n              <th>Site Name</th>\n              <th>Type</th>\n              <th>Status</th>\n              <th>Location</th>\n              <th>Contact</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredSites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22site-name%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bsite.name%20%7C%7C%20'Unnamed%20Site'%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20site.owner%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csmall%3E%7Bsite.owner%7D%3C%2Fsmall%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22type-badge%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BgetSiteTypeIcon(site.type)%7D%20%7Bsite.type%20%7C%7C%20'unknown'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-%7Bsite.status%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BgetStatusBadge(site.status)%7D%20%7Bsite.status%20%7C%7C%20'unknown'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22location-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20site.location%3F.address%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%3E%7Bsite.location.address%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20site.location%3F.city%20%7C%7C%20site.location%3F.state%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22location-secondary%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bsite.location%3F.city%7D%7Bsite.location%3F.city%20%26%26%20site.location%3F.state%20%3F%20'%2C%20'%20%3A%20''%7D%7Bsite.location%3F.state%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20site.location%3F.zipCode%7D%20%7Bsite.location.zipCode%7D%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20site.location%3F.latitude%20%26%26%20site.location%3F.longitude%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22coordinates%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bsite.location.latitude.toFixed(6)%7D%2C%20%7Bsite.location.longitude.toFixed(6)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22contact-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BgetContactInfo(site)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22action-buttons%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-icon%22%20data-cwl-action%3D%22handleEdit%22%20data-cwl-action-args%3D%22site%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Edit%20Site%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9C%8F%EF%B8%8F%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22deploy-menu%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-icon%20btn-deploy%22%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20title%3D%22Deploy%20Equipment%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%9A%80%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22deploy-dropdown%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20data-cwl-action%3D%22handleDeployEPC%22%20data-cwl-action-args%3D%22site%22%20aria-label%3D%22Deploy%20EPC%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%96%A5%EF%B8%8F%20Deploy%20EPC%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20data-cwl-action%3D%22handleDeploySector%22%20data-cwl-action-args%3D%22site%22%20aria-label%3D%22Deploy%20Sector%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%93%A1%20Deploy%20LTE%2F5G%20Sector%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20data-cwl-action%3D%22handleDeployCPE%22%20data-cwl-action-args%3D%22site%22%20aria-label%3D%22Deploy%20CPE%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%93%B1%20Deploy%20FWA%20(CPE)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20data-cwl-action%3D%22handleDeployBackhaul%22%20data-cwl-action-args%3D%22site%22%20aria-label%3D%22Deploy%20Backhaul%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%94%97%20Deploy%20Backhaul%20(Wireless%2FFiber)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                <td>\n                  <div class=\"site-name\">\n                    <strong></strong>\n\n                      <div hidden aria-hidden=\"true\"><small></small>\n                    </div>\n                  </div>\n                </td>\n                <td>\n                  <span class=\"type-badge\">\n\n                  </span>\n                </td>\n                <td>\n                  <span class=\"status-badge status-\">\n\n                  </span>\n                </td>\n                <td>\n                  <div class=\"location-info\">\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"site.location?.address\"><div></div></div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"site.location?.city || site.location?.state\"><div class=\"location-secondary\">\n\n                        <span data-cwl-bind=\"if\" data-cwl-hole-detail=\"site.location?.zipCode\"></span>\n                      </div></div>\n                    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"site.location?.latitude && site.location?.longitude\"><div class=\"coordinates\">\n                        ,\n                      </div></div>\n                  </div>\n                </td>\n                <td>\n                  <div class=\"contact-info\">\n\n                  </div>\n                </td>\n                <td>\n                  <div class=\"action-buttons\">\n                    <button\n                      class=\"btn-icon\" data-cwl-action=\"handleEdit\" data-cwl-action-args=\"site\"\n                      title=\"Edit Site\"\n                    >\n                      ✏️\n                    </button>\n                    <div class=\"deploy-menu\">\n                      <button\n                        class=\"btn-icon btn-deploy\"\n                        title=\"Deploy Equipment\"\n                      >\n                        🚀\n                      </button>\n                      <div class=\"deploy-dropdown\">\n                        <button data-cwl-action=\"handleDeployEPC\" data-cwl-action-args=\"site\" aria-label=\"Deploy EPC\">\n                          🖥️ Deploy EPC\n                        </button>\n                        <button data-cwl-action=\"handleDeploySector\" data-cwl-action-args=\"site\" aria-label=\"Deploy Sector\">\n                          📡 Deploy LTE/5G Sector\n                        </button>\n                        <button data-cwl-action=\"handleDeployCPE\" data-cwl-action-args=\"site\" aria-label=\"Deploy CPE\">\n                          📱 Deploy FWA (CPE)\n                        </button>\n                        <button data-cwl-action=\"handleDeployBackhaul\" data-cwl-action-args=\"site\" aria-label=\"Deploy Backhaul\">\n                          🔗 Deploy Backhaul (Wireless/Fiber)\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </td>\n              </tr></div>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"empty-state\" hidden aria-hidden=\"true\">\n        <p>No sites found</p>\n\n          <p class=\"help-text\">Try adjusting your search or filters</p>\n\n          <div hidden aria-hidden=\"true\"><button class=\"btn-primary\" data-cwl-toggle=\"showEditModal:true\" aria-label=\"Show Edit Modal\">\n            Create Your First Site\n          </button>\n        </div>\n      </div>\n\n  </div>\n\n  <!-- Site Edit Modal -->\n  <div data-cwl-component=\"SiteEditModal\" data-cwl-lifted-component=\"SiteEditModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showEditModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"site\">✏️ Edit Site: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"site.name\"></span></div>\n          ➕ Create New Site\n\n      </h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Find Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter address to search...\" data-cwl-on-keydown=\"action:handleSearchAddress\"\n          />\n          <button\n            class=\"btn-secondary\" data-cwl-action=\"handleSearchAddress\" data-cwl-attr-disabled=\"isSearching\"\n           aria-label=\"Search Address\">\n            Search\n          </button>\n        </div>\n        <p class=\"help-text\">Or enter GPS coordinates below</p>\n      </div>\n\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Site Name *</label>\n            <input type=\"text\" placeholder=\"Main Tower Site\" required />\n          </div>\n\n          <div class=\"form-group\" style=\"grid-column: 1 / -1;\">\n            <label>Site Types * (Select all that apply)</label>\n            <div class=\"type-checkboxes\">\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">📡</span>\n                    Tower\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🖥️</span>\n                    NOC\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🏢</span>\n                    HQ\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🏭</span>\n                    Warehouse\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🏗️</span>\n                    Building / Rooftop\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">📡</span>\n                    Pole / Monopole\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🌐</span>\n                    Internet Access Point\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">🌍</span>\n                    Internet\n                  </span>\n                </label>\n\n                <label class=\"type-checkbox\">\n                  <input\n                    type=\"checkbox\" data-cwl-on-change=\"action:removeRow\"\n                  />\n                  <span class=\"type-label\">\n                    <span class=\"type-icon\">📍</span>\n                    Other\n                  </span>\n                </label>\n\n            </div>\n            <p class=\"help-text\">Small operators can select multiple types (e.g., NOC + Tower, HQ + NOC)</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">✅ Active</option>\n              <option value=\"inactive\">❌ Inactive</option>\n              <option value=\"maintenance\">🔧 Maintenance</option>\n              <option value=\"planned\">📅 Planned</option>\n            </select>\n          </div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.types.includes('tower') || formData.types.includes('pole')\"><div class=\"form-group\">\n            <label>Height (feet)</label>\n            <input type=\"number\" placeholder=\"100\" min=\"0\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Structure Type</label>\n            <select>\n              <option>-- Select --</option>\n              <option value=\"self-supporting\">Self-Supporting</option>\n              <option value=\"guyed\">Guyed</option>\n              <option value=\"monopole\">Monopole</option>\n              <option value=\"building-mounted\">Building-Mounted</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div></div>\n\n          <div class=\"form-group\">\n            <label>Owner</label>\n            <input type=\"text\" placeholder=\"Tower Company LLC\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>FCC ID</label>\n            <input type=\"text\" placeholder=\"FCC-12345\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Location -->\n      <div class=\"section\">\n        <h3>📍 GPS Coordinates</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" required />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Street Address</label>\n          <input type=\"text\" placeholder=\"123 Tower Rd\" />\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>City</label>\n            <input type=\"text\" placeholder=\"New York\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>State</label>\n            <input type=\"text\" placeholder=\"NY\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>ZIP Code</label>\n            <input type=\"text\" placeholder=\"10001\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Country</label>\n            <input type=\"text\" placeholder=\"US\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Tower Contact (for tower/pole sites) -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.type === 'tower' || formData.type === 'pole'\"><div class=\"section\">\n        <h3>🏢 Tower Owner Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Company</label>\n            <input type=\"text\" placeholder=\"Tower Company LLC\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Contact Name</label>\n            <input type=\"text\" placeholder=\"John Doe\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@tower.com\" />\n          </div>\n        </div>\n      </div></div>\n\n      <!-- Building Contact (for building sites) -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.type === 'building'\"><div class=\"section\">\n        <h3>🏢 Building Owner Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Company</label>\n            <input type=\"text\" placeholder=\"Building Management Co\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Building Manager</label>\n            <input type=\"text\" placeholder=\"Jane Smith\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Contact Name</label>\n            <input type=\"text\" placeholder=\"John Doe\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@building.com\" />\n          </div>\n        </div>\n      </div></div>\n\n      <!-- Site Contact (for all site types) -->\n      <div class=\"section\">\n        <h3>👷 On-Site Contact</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Jane Smith\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Role</label>\n            <input type=\"text\" placeholder=\"Site Manager\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-5678\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"manager@site.com\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- General Contact (fallback) -->\n      <div class=\"section\">\n        <h3>📞 General Contact (Fallback)</h3>\n        <p class=\"help-text\">Used if no specific contact types are provided</p>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Name</label>\n            <input type=\"text\" placeholder=\"Contact Name\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-0000\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"contact@example.com\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Access Information -->\n      <div class=\"section\">\n        <h3>🔐 Site Access</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Gate Code</label>\n            <input type=\"text\" placeholder=\"1234#\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Access Hours</label>\n            <input type=\"text\" placeholder=\"24/7 or Mon-Fri 8am-5pm\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Access Instructions</label>\n          <textarea\n            placeholder=\"Call 30 minutes before arrival. Gate code required. Enter through main gate.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Safety Notes</label>\n          <textarea\n            placeholder=\"High voltage equipment. PPE required. Confined space. Lockout/tagout required.\"\n            rows=\"3\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (site ? '💾 Save Changes' : '✅ Create Site')\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n\n  <!-- EPC Deployment Modal -->\n\n    <div data-cwl-shell-key=\"showDeployModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"EPCDeploymentModal\" data-cwl-lifted-component=\"EPCDeploymentModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showDeployModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content epc-deployment-modal\">\n      <div class=\"modal-header\">\n        <h2>🚀 Server Deployment</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n      </div>\n\n        <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n        <div class=\"success-banner\" hidden aria-hidden=\"true\"></div>\n\n      <div class=\"modal-body\">\n        <!-- Step Progress Indicator -->\n        <div class=\"step-indicator\">\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"Array(totalSteps) as _, i\">\n            <div class=\"step-indicator-item\">\n              <div class=\"step-indicator-number\"></div>\n              <div class=\"step-indicator-line\"></div>\n            </div></div>\n        </div>\n\n        <!-- Step Content -->\n        <div class=\"step-content\">\n          <!-- Step 1: Deployment Type -->\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 1\"><div class=\"step-panel\">\n              <h3>Step 1: Select Deployment Type</h3>\n              <p class=\"step-description\">Choose what components to deploy on the server</p>\n              <div class=\"deployment-type-options\">\n                <label class=\"deployment-option\">\n                  <input type=\"radio\" name=\"deploymentType\" value=\"epc\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">📡</div>\n                    <div class=\"option-info\">\n                      <strong>EPC Core Only</strong>\n                      <p>Deploy Open5GS EPC components (MME, SGW, PGW, PCRF)</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"deployment-option\">\n                  <input type=\"radio\" name=\"deploymentType\" value=\"snmp\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">📊</div>\n                    <div class=\"option-info\">\n                      <strong>SNMP/Mikrotik Agent Only</strong>\n                      <p>Deploy SNMP agent and Mikrotik monitoring modules</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"deployment-option\">\n                  <input type=\"radio\" name=\"deploymentType\" value=\"both\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">🔄</div>\n                    <div class=\"option-info\">\n                      <strong>Both EPC + SNMP</strong>\n                      <p>Deploy both EPC Core and SNMP/Mikrotik monitoring agents</p>\n                    </div>\n                  </div>\n                </label>\n              </div>\n            </div>\n\n          <!-- Step 2: Site Information --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === 2\"><div class=\"step-panel\">\n              <h3>Step 2: Site Information</h3>\n              <p class=\"step-description\">Select a site to deploy the remote EPC/SNMP agent. Site selection is required to link device codes.</p>\n              <div class=\"form-section\">\n                <div class=\"form-group\">\n                  <label for=\"siteSelect\">Select Site *</label>\n\n                    <select id=\"siteSelect\" required>\n                      <option>-- Select a site --</option>\n                      <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%20%7C%7C%20site._id%7D%3E%7Bsite.name%20%7C%7C%20'Unnamed%20Site'%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n                    </select>\n\n                    <div hidden aria-hidden=\"true\"><select id=\"siteSelect\" disabled>\n                      <option>No sites available. Please create a site first.</option>\n                    </select>\n                    <p class=\"form-hint\" style=\"color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.5rem;\">\n                      You need to create a site in the Coverage Map module before deploying remotes.\n                    </p>\n                  </div>\n                    <div hidden aria-hidden=\"true\"><select id=\"siteSelect\" disabled>\n                      <option>Loading sites...</option>\n                    </select>\n                  </div>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedSiteId && selectedSite\"><div class=\"form-group\">\n                    <label>Site Name</label>\n                    <input type=\"text\" data-cwl-attr-value=\"epcConfig.siteName\" readonly />\n                  </div>\n                  <div class=\"form-group\">\n                    <label>Location</label>\n                    <input type=\"text\" data-cwl-attr-value=\"epcConfig.location.address || 'N/A'\" readonly />\n                  </div>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"epcConfig.contact.name || epcConfig.contact.email\"><div class=\"form-group\">\n                      <label>Contact</label>\n                      <input type=\"text\" data-cwl-attr-value=\"epcConfig.contact.name || 'N/A'\" readonly />\n                    </div>\n                    <div class=\"form-group\">\n                      <label>Email</label>\n                      <input type=\"text\" data-cwl-attr-value=\"epcConfig.contact.email || 'N/A'\" readonly />\n                    </div></div></div>\n                  <p class=\"form-hint\" style=\"color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.5rem;\">\n                    Select a site above to auto-fill site information.\n                  </p>\n\n              </div>\n            </div>\n\n          <!-- Step 3: EPC Network Configuration (if EPC selected) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('network')\"><div class=\"step-panel\">\n              <h3>Step 3: EPC Network Configuration</h3>\n              <p class=\"step-description\">Configure network parameters for EPC</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"mcc\">MCC *</label>\n                    <input id=\"mcc\" type=\"text\" placeholder=\"001\" required />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"mnc\">MNC *</label>\n                    <input id=\"mnc\" type=\"text\" placeholder=\"01\" required />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"tac\">TAC *</label>\n                    <input id=\"tac\" type=\"text\" placeholder=\"1\" required />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          <!-- Step 4: HSS Configuration (if EPC selected) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('hss')\"><div class=\"step-panel\">\n              <h3>Step 4: HSS Configuration</h3>\n              <p class=\"step-description\">Configure HSS connection settings</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"hssHost\">HSS Host</label>\n                    <input id=\"hssHost\" type=\"text\" placeholder=\"HSS host\" />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"hssPort\">HSS Port</label>\n                    <input id=\"hssPort\" type=\"text\" placeholder=\"3868\" />\n                  </div>\n                </div>\n                <div class=\"form-group\">\n                  <label for=\"diameterRealm\">Diameter Realm</label>\n                  <input id=\"diameterRealm\" type=\"text\" placeholder=\"example.com\" />\n                </div>\n              </div>\n            </div>\n\n          <!-- SNMP Configuration (if SNMP selected) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('snmp')\"><div class=\"step-panel\">\n              <h3>Step 1: SNMP/Mikrotik Configuration</h3>\n              <p class=\"step-description\">Configure SNMP agent and monitoring</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"snmpVersion\">SNMP Version</label>\n                    <select id=\"snmpVersion\">\n                      <option value=\"2c\">SNMPv2c (Recommended)</option>\n                      <option value=\"1\">SNMPv1</option>\n                      <option value=\"3\">SNMPv3 (Secure)</option>\n                    </select>\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"snmpCommunity\">Community String</label>\n                    <input id=\"snmpCommunity\" type=\"text\" placeholder=\"public\" />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"snmpPort\">SNMP Port</label>\n                    <input id=\"snmpPort\" type=\"number\" placeholder=\"161\" />\n                  </div>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"epcConfig.snmpConfig.version === '3'\"><div class=\"form-row\">\n                    <div class=\"form-group\">\n                      <label for=\"snmpUsername\">SNMPv3 Username</label>\n                      <input id=\"snmpUsername\" type=\"text\" placeholder=\"Enter username\" />\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"snmpAuthProtocol\">Auth Protocol</label>\n                      <select id=\"snmpAuthProtocol\">\n                        <option value=\"SHA\">SHA</option>\n                        <option value=\"MD5\">MD5</option>\n                      </select>\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"snmpAuthKey\">Auth Key</label>\n                      <input id=\"snmpAuthKey\" type=\"password\" placeholder=\"Enter auth key\" />\n                    </div>\n                  </div>\n                  <div class=\"form-row\">\n                    <div class=\"form-group\">\n                      <label for=\"snmpPrivProtocol\">Privacy Protocol</label>\n                      <select id=\"snmpPrivProtocol\">\n                        <option value=\"AES\">AES</option>\n                        <option value=\"DES\">DES</option>\n                      </select>\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"snmpPrivKey\">Privacy Key</label>\n                      <input id=\"snmpPrivKey\" type=\"password\" placeholder=\"Enter privacy key\" />\n                    </div>\n                  </div></div>\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"snmpReportingInterval\">Reporting Interval (seconds)</label>\n                    <input id=\"snmpReportingInterval\" type=\"number\" placeholder=\"60\" />\n                  </div>\n                  <div class=\"form-group\">\n                    <label for=\"snmpCloudApiUrl\">Cloud API URL</label>\n                    <input id=\"snmpCloudApiUrl\" type=\"text\" placeholder=\"https://hss.wisptools.io:3003\" />\n                  </div>\n                  <div class=\"form-group checkbox-group\">\n                    <label>\n                      <input type=\"checkbox\" />\n                      Enable SNMP Traps\n                    </label>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          <!-- APT Repository Configuration --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('apt')\"><div class=\"step-panel\">\n              <h3>Step 1: APT Repository Configuration</h3>\n              <p class=\"step-description\">Configure remote updates repository</p>\n              <div class=\"form-section\">\n                <div class=\"form-row\">\n                  <div class=\"form-group\">\n                    <label for=\"aptRepositoryUrl\">Repository URL</label>\n                    <input id=\"aptRepositoryUrl\" type=\"text\" placeholder=\"https://hss.wisptools.io/apt\" />\n                  </div>\n                  <div class=\"form-group checkbox-group\">\n                    <label>\n                      <input type=\"checkbox\" />\n                      Enable APT Repository\n                    </label>\n                  </div>\n                  <div class=\"form-group checkbox-group\">\n                    <label>\n                      <input type=\"checkbox\" />\n                      Auto-update Enabled\n                    </label>\n                  </div>\n                </div>\n\n                  <div class=\"form-row\" hidden aria-hidden=\"true\">\n                    <div class=\"form-group\">\n                      <label for=\"aptUpdateSchedule\">Update Schedule</label>\n                      <select id=\"aptUpdateSchedule\">\n                        <option value=\"hourly\">Hourly</option>\n                        <option value=\"daily\">Daily</option>\n                        <option value=\"weekly\">Weekly</option>\n                      </select>\n                    </div>\n                    <div class=\"form-group\">\n                      <label for=\"aptUpdateTime\">Update Time (HH:MM)</label>\n                      <input id=\"aptUpdateTime\" type=\"text\" placeholder=\"02:00\" pattern=\"[0-9]:[0-9]\" />\n                    </div>\n                    <div class=\"form-group checkbox-group\">\n                      <label>\n                        <input type=\"checkbox\" />\n                        Security Updates Only\n                      </label>\n                    </div>\n                  </div>\n\n              </div>\n            </div>\n\n          <!-- Review Step --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('review')\"><div class=\"step-panel\">\n              <h3>Step 1: Review Configuration</h3>\n              <p class=\"step-description\">Review your deployment configuration</p>\n              <div class=\"review-section\">\n                <div class=\"review-item\">\n                  <strong>Deployment Type:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deploymentType === 'both' ? 'EPC + SNMP' : deploymentType.toUpperCase()\"></span></span>\n                </div>\n                <div class=\"review-item\">\n                  <strong>Site Name:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.siteName\"></span></span>\n                </div>\n                <div class=\"review-item\">\n                  <strong>Device Code:</strong>\n                  <span style=\"color: #999; font-style: italic;\">Will be entered in device configuration after hardware boots</span>\n                </div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentType === 'epc' || deploymentType === 'both'\"><div class=\"review-item\">\n                    <strong>EPC Network:</strong>\n                    <span>MCC: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.networkConfig.mcc\"></span>, MNC: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.networkConfig.mnc\"></span>, TAC: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.networkConfig.tac\"></span></span>\n                  </div>\n                  <div class=\"review-item\">\n                    <strong>HSS:</strong>\n                    <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.hssConfig.hssHost\"></span>:<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.hssConfig.hssPort\"></span></span>\n                  </div></div>\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentType === 'snmp' || deploymentType === 'both'\"><div class=\"review-item\">\n                    <strong>SNMP Version:</strong>\n                    <span>SNMPv<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.snmpConfig.version\"></span></span>\n                  </div>\n                  <div class=\"review-item\">\n                    <strong>SNMP Community:</strong>\n                    <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.snmpConfig.community\"></span></span>\n                  </div></div>\n                <div class=\"review-item\">\n                  <strong>Location:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.location.address\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.location.city\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.location.state\"></span></span>\n                </div>\n                <div class=\"review-item\">\n                  <strong>Contact:</strong>\n                  <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.contact.name\"></span> (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.contact.email\"></span>)</span>\n                </div>\n\n                  <div class=\"review-item\" hidden aria-hidden=\"true\">\n                    <strong>APT Repository:</strong>\n                    <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"epcConfig.aptConfig.repositoryUrl\"></span></span>\n                  </div>\n\n              </div>\n            </div>\n\n          <!-- Final Step: Download (Script/ISO Selection) --></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep === getStepNumber('download')\"><div class=\"step-panel\">\n              <h3>Step 1: Deploy Hardware</h3>\n              <p class=\"step-description\">Choose your deployment method</p>\n              <div class=\"download-options\">\n                <label class=\"download-option\">\n                  <input type=\"radio\" name=\"deploymentOption\" value=\"link\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">🔗</div>\n                    <div class=\"option-info\">\n                      <strong>Link Existing Device</strong>\n                      <p>Enter the 8-character device code shown on your hardware's screen</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"download-option\">\n                  <input type=\"radio\" name=\"deploymentOption\" value=\"iso\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">💿</div>\n                    <div class=\"option-info\">\n                      <strong>Download ISO Image</strong>\n                      <p>Download a bootable ISO to install on new hardware</p>\n                    </div>\n                  </div>\n                </label>\n                <label class=\"download-option\">\n                  <input type=\"radio\" name=\"deploymentOption\" value=\"script\" />\n                  <div class=\"option-content\">\n                    <div class=\"option-icon\">📜</div>\n                    <div class=\"option-info\">\n                      <strong>Download Script</strong>\n                      <p>Download a bash script to run on an existing Ubuntu server</p>\n                    </div>\n                  </div>\n                </label>\n              </div>\n\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'link'\"><div class=\"device-code-entry\">\n                  <h4>Enter Device Code</h4>\n                  <p class=\"hint\">The device code is displayed on the hardware's screen after booting from the ISO.</p>\n                  <div class=\"code-input-group\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"e.g., AB12CD34\"\n                      maxlength=\"8\"\n                      class=\"device-code-input\"\n                      style=\"text-transform: uppercase; font-family: monospace; font-size: 24px; letter-spacing: 4px; text-align: center;\"\n                    />\n                  </div>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"linkedDeviceInfo\"><div class=\"link-success\">\n                      <span class=\"success-icon\">✅</span>\n                      <div>\n                        <strong>Device Linked Successfully!</strong>\n                        <p>EPC ID: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"linkedDeviceInfo.epc_id\"></span></p>\n                        <p>The device will automatically configure itself.</p>\n                      </div>\n                    </div></div>\n                </div></div>\n\n              <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'script' && deploymentScript\"><div class=\"script-preview\">\n                  <h5>Script Preview:</h5>\n                  <pre><code><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"deploymentScript.substring(0, 300)\"></span>...</code></pre>\n                </div></div>\n            </div></div>\n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"modal-actions\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep > 1\"><button class=\"btn btn-secondary\" data-cwl-action=\"prevStep\" aria-label=\"Prev Step\">\n              ← Previous\n            </button></div>\n\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"currentStep < totalSteps\"><button class=\"btn btn-primary\" data-cwl-action=\"handleNextClick\" data-cwl-attr-disabled=\"loading\" aria-label=\"Next Click\">\n\n                Next →\n\n            </button></div>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'link'\"><button class=\"btn btn-primary\" data-cwl-action=\"linkDeviceByCode\" data-cwl-attr-disabled=\"linkingDevice || !deviceCode || deviceCode.length !== 8 || linkedDeviceInfo\" aria-label=\"Link Device By Code\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"linkedDeviceInfo\">✅ Device Linked</div>\n                  🔗 Link Device\n\n              </button></div>\n              <button class=\"btn btn-primary\" data-cwl-action=\"downloadDeployment\" data-cwl-attr-disabled=\"loading || !deploymentOption\" aria-label=\"Download Deployment\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'script'\">📥 Download Script</div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"deploymentOption === 'iso'\">💿 Download ISO</div>\n                  Select an Option\n\n              </button>\n\n        </div>\n      </div>\n    </div>\n  </div></div></div>\n  </div>\n\n  <!-- Sector Deployment Modal -->\n\n    <div data-cwl-shell-key=\"showSectorModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"AddSectorModal\" data-cwl-lifted-component=\"AddSectorModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showSectorModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📶 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"sectorToEdit ? 'Edit Sector' : 'Add Sector'\"></span></h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Site Selection -->\n      <div class=\"section\">\n        <h3>📡 Tower Site</h3>\n        <div class=\"form-group\">\n          <label>Select Site *</label>\n          <select data-cwl-attr-disabled=\"!!sectorToEdit\">\n            <option>-- Select a tower site --</option>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%20(%7Bsite.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n          </select>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"sectorToEdit\"><p class=\"help-text\">⚠️ Site cannot be changed when editing</p></div>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedSiteData\"><p class=\"help-text\">\n              📍 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedSiteData.location.latitude.toFixed(4)\"></span>, <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedSiteData.location.longitude.toFixed(4)\"></span>\n            </p></div>\n        </div>\n      </div>\n\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Sector Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Sector Name *</label>\n            <input type=\"text\" placeholder=\"Alpha Sector\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Technology *</label>\n            <select data-cwl-on-change=\"action:handleTechnologyChange\">\n              <option value=\"LTE\">LTE</option>\n              <option value=\"CBRS\">CBRS</option>\n              <option value=\"FWA\">Fixed Wireless (FWA)</option>\n              <option value=\"5G\">5G NR</option>\n              <option value=\"WiFi\">WiFi</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"active\">Active</option>\n              <option value=\"inactive\">Inactive</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"planned\">Planned</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- RF Configuration -->\n      <div class=\"section\">\n        <h3>📡 RF Configuration</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Azimuth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">0° = North, 90° = East, 180° = South, 270° = West</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Beamwidth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">Typical: 65° (LTE), 90° (CBRS), 30° (FWA)</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Mechanical Tilt (degrees)</label>\n            <input type=\"number\" min=\"-90\" max=\"90\" />\n            <p class=\"help-text\">Downtilt angle (negative = down)</p>\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Band / Frequency Name</label>\n            <input type=\"text\" placeholder=\"Band 71 (600MHz)\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Center Frequency (MHz)</label>\n            <input type=\"number\" placeholder=\"617\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Bandwidth (MHz)</label>\n            <input type=\"number\" placeholder=\"10\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Equipment -->\n      <div class=\"section\">\n        <h3>📻 Equipment Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Antenna Manufacturer</label>\n            <input type=\"text\" placeholder=\"Commscope\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Antenna Model</label>\n            <input type=\"text\" placeholder=\"SBNHH-1D65C\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Antenna Serial Number</label>\n            <input type=\"text\" placeholder=\"SN123456\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Radio Manufacturer</label>\n            <input type=\"text\" placeholder=\"Nokia\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Radio Model</label>\n            <input type=\"text\" placeholder=\"AEQE\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Radio Serial Number</label>\n            <input type=\"text\" placeholder=\"RN789012\" />\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button\n        class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\"\n       aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (sectorToEdit ? '✅ Save Changes' : '✅ Create Sector')\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n  </div>\n\n  <!-- CPE/FWA Deployment Modal -->\n\n    <div data-cwl-shell-key=\"showCPEModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"AddCPEModal\" data-cwl-lifted-component=\"AddCPEModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showCPEModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>📱 Add CPE Device</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div class=\"modal-body\">\n      <!-- Address Search -->\n      <div class=\"section\">\n        <h3>🔍 Customer Location</h3>\n        <div class=\"search-group\">\n          <input\n            type=\"text\"\n            placeholder=\"Enter customer address...\" data-cwl-on-keydown=\"action:handleSearchAddress\"\n          />\n          <button class=\"btn-secondary\" data-cwl-action=\"handleSearchAddress\" data-cwl-attr-disabled=\"isSearching\" aria-label=\"Search Address\">\n            Search\n          </button>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Latitude *</label>\n            <input type=\"number\" step=\"0.000001\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Longitude *</label>\n            <input type=\"number\" step=\"0.000001\" />\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Address</label>\n          <input type=\"text\" placeholder=\"123 Main St, City, State\" />\n        </div>\n      </div>\n\n      <!-- Basic Info -->\n      <div class=\"section\">\n        <h3>📋 Equipment Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Device Name *</label>\n            <input type=\"text\" placeholder=\"Smith Residence FWA\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Manufacturer *</label>\n            <input type=\"text\" placeholder=\"Telrad\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Model *</label>\n            <input type=\"text\" placeholder=\"CPE7000\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Serial Number *</label>\n            <input type=\"text\" placeholder=\"CPE-123456\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>MAC Address</label>\n            <input type=\"text\" placeholder=\"00:11:22:33:44:55\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Installation -->\n      <div class=\"section\">\n        <h3>📡 Installation Details</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Pointing Azimuth (degrees) *</label>\n            <input type=\"number\" min=\"0\" max=\"360\" />\n            <p class=\"help-text\">Direction CPE antenna is pointed</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Beamwidth (degrees)</label>\n            <input type=\"number\" />\n            <p class=\"help-text\">Default: 30° for FWA CPE</p>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Height Above Ground (feet)</label>\n            <input type=\"number\" placeholder=\"25\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Technology</label>\n            <select>\n              <option value=\"FWA\">Fixed Wireless (FWA)</option>\n              <option value=\"LTE\">LTE</option>\n              <option value=\"CBRS\">CBRS</option>\n              <option value=\"5G\">5G NR</option>\n              <option value=\"WiFi\">WiFi</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Band / Frequency</label>\n            <input type=\"text\" placeholder=\"5GHz\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Connected to Site</label>\n            <select>\n              <option>None / Unknown</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option></option></div>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <!-- Subscriber Info -->\n      <div class=\"section\">\n        <h3>👤 Subscriber Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Subscriber Name</label>\n            <input type=\"text\" placeholder=\"John Smith\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Phone</label>\n            <input type=\"tel\" placeholder=\"555-1234\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Email</label>\n            <input type=\"email\" placeholder=\"customer@example.com\" />\n          </div>\n        </div>\n\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Account Number</label>\n            <input type=\"text\" placeholder=\"ACCT-1001\" />\n          </div>\n\n          <div class=\"form-group\">\n            <label>Service Type</label>\n            <select>\n              <option value=\"residential\">Residential</option>\n              <option value=\"business\">Business</option>\n              <option value=\"temporary\">Temporary</option>\n            </select>\n          </div>\n\n          <div class=\"form-group\">\n            <label>Status</label>\n            <select>\n              <option value=\"online\">Online</option>\n              <option value=\"offline\">Offline</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"inventory\">Inventory</option>\n            </select>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n        ✅ Create CPE\n      </button>\n    </div>\n  </div>\n</div></div></div>\n  </div>\n\n  <!-- Backhaul Deployment Modal -->\n\n    <div data-cwl-shell-key=\"showBackhaulModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"AddBackhaulLinkModal\" data-cwl-lifted-component=\"AddBackhaulLinkModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showBackhaulModal\" hidden aria-hidden=\"true\"><div class=\"modal-overlay\" data-cwl-action=\"handleClose\" hidden aria-hidden=\"true\">\n  <div class=\"modal-content\">\n    <div class=\"modal-header\">\n      <h2>🔗 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"backhaulToEdit ? 'Edit Backhaul Link' : 'Add Backhaul Link'\"></span></h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <div class=\"error-banner\" hidden aria-hidden=\"true\"></div>\n\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!canCreateBackhaul\"><div class=\"warning-banner\">\n        ⚠️ Need at least 2 sites to create backhaul. Add more tower sites or NOC first.\n      </div></div>\n\n    <div class=\"modal-body\">\n      <!-- Link Endpoints -->\n      <div class=\"section\">\n        <h3>🔗 Link Endpoints</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>From Site (A) *</label>\n            <select data-cwl-attr-disabled=\"!canCreateBackhaul || !!backhaulToEdit\">\n              <option>-- Select site --</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"sites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%20(%7Bsite.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n            </select>\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"backhaulToEdit\"><p class=\"help-text\">⚠️ Sites cannot be changed when editing</p></div>\n          </div>\n\n          <div class=\"form-group\">\n            <label>To Site (B) *</label>\n            <select data-cwl-attr-disabled=\"!canCreateBackhaul || !!backhaulToEdit\">\n              <option>-- Select site --</option>\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"availableToSites as site\" data-cwl-each-item=\"site\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%7Bsite.id%7D%3E%7Bsite.name%7D%20(%7Bsite.type%7D)%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><option> ()</option></div>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Link Name *</label>\n          <input\n            type=\"text\"\n            placeholder=\"↔\" data-cwl-attr-disabled=\"!canCreateBackhaul\"\n          />\n        </div>\n      </div>\n\n      <!-- Backhaul Type -->\n      <div class=\"section\">\n        <h3>📡 Backhaul Type</h3>\n        <div class=\"form-group\">\n          <select data-cwl-attr-disabled=\"!canCreateBackhaul\">\n            <option value=\"fiber\">🌐 Fiber Optic</option>\n            <option value=\"fixed-wireless-licensed\">📡 Fixed Wireless (Licensed Spectrum)</option>\n            <option value=\"fixed-wireless-unlicensed\">📡 Fixed Wireless (Unlicensed WiFi/60GHz)</option>\n          </select>\n        </div>\n      </div>\n\n      <!-- Wireless Configuration -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isWireless && canCreateBackhaul\"><div class=\"section wireless-section\">\n          <h3>📡 Fixed Wireless Configuration</h3>\n\n          <!-- Site A Configuration -->\n          <div class=\"site-config\">\n            <h4>📍 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"fromSiteName\"></span> (Site A)</h4>\n            <div class=\"form-grid\">\n              <div class=\"form-group\">\n                <label>Azimuth (auto-calculated)</label>\n                <input type=\"number\" min=\"0\" max=\"360\" />\n                <p class=\"help-text\">Pointing toward <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"toSiteName\"></span></p>\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Height (feet)</label>\n                <input type=\"number\" placeholder=\"150\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Gain (dBi)</label>\n                <input type=\"number\" placeholder=\"23\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>TX Power (dBm)</label>\n                <input type=\"number\" placeholder=\"20\" />\n              </div>\n            </div>\n          </div>\n\n          <!-- Site B Configuration -->\n          <div class=\"site-config\">\n            <h4>📍 <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"toSiteName\"></span> (Site B)</h4>\n            <div class=\"form-grid\">\n              <div class=\"form-group\">\n                <label>Azimuth (auto-calculated)</label>\n                <input type=\"number\" min=\"0\" max=\"360\" />\n                <p class=\"help-text\">Pointing toward <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"fromSiteName\"></span></p>\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Height (feet)</label>\n                <input type=\"number\" placeholder=\"150\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>Antenna Gain (dBi)</label>\n                <input type=\"number\" placeholder=\"23\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>TX Power (dBm)</label>\n                <input type=\"number\" placeholder=\"20\" />\n              </div>\n            </div>\n          </div>\n\n          <!-- RF Parameters -->\n          <h4>📻 RF Parameters</h4>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Frequency (MHz) *</label>\n              <input type=\"number\" placeholder=\"5800\" />\n              <p class=\"help-text\">\n                <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.backhaulType === 'fixed-wireless-unlicensed'\">WiFi: 5150-5850 | 60GHz: 57000-71000</div>\n                  Licensed: 6, 11, 18, 23, 80 GHz\n\n              </p>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Channel Bandwidth (MHz)</label>\n              <input type=\"number\" placeholder=\"80\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Beamwidth (degrees)</label>\n              <input type=\"number\" placeholder=\"10\" />\n              <p class=\"help-text\">Antenna beamwidth (5-15° typical)</p>\n            </div>\n          </div>\n\n          <!-- Licensed Spectrum -->\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"formData.backhaulType === 'fixed-wireless-licensed'\"><div class=\"license-section\">\n              <h4>📜 FCC Licensing Information</h4>\n              <p class=\"section-help\">Required FCC licensing details for licensed wireless backhaul links</p>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>License Type *</label>\n                  <select>\n                    <option>-- Select --</option>\n                    <option value=\"point-to-point\">Point-to-Point</option>\n                    <option value=\"point-to-multipoint\">Point-to-Multipoint</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>FCC Call Sign *</label>\n                  <input type=\"text\" placeholder=\"WXYZ123\" />\n                  <p class=\"help-text\">FCC-assigned call sign</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>FCC License Number</label>\n                  <input type=\"text\" placeholder=\"Additional license identifier\" />\n                  <p class=\"help-text\">Additional license number if different from call sign</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>FCC File Number</label>\n                  <input type=\"text\" placeholder=\"0000123456\" />\n                  <p class=\"help-text\">FCC application/file number</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>License Status</label>\n                  <select>\n                    <option value=\"active\">✅ Active</option>\n                    <option value=\"pending\">⏳ Pending</option>\n                    <option value=\"expired\">❌ Expired</option>\n                    <option value=\"suspended\">⚠️ Suspended</option>\n                    <option value=\"revoked\">🚫 Revoked</option>\n                  </select>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Part Number</label>\n                  <select>\n                    <option>-- Select --</option>\n                    <option value=\"Part 101\">Part 101 - Fixed Microwave Services</option>\n                    <option value=\"Part 90\">Part 90 - Private Land Mobile Radio</option>\n                    <option value=\"Part 22\">Part 22 - Public Mobile Services</option>\n                    <option value=\"Part 24\">Part 24 - Personal Communications Services</option>\n                    <option value=\"Part 27\">Part 27 - Miscellaneous Wireless Services</option>\n                    <option value=\"Part 94\">Part 94 - Private Operational-Fixed Microwave Service</option>\n                    <option value=\"Part 97\">Part 97 - Amateur Radio Service</option>\n                  </select>\n                </div>\n              </div>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>Frequency Band</label>\n                  <input type=\"text\" placeholder=\"6 GHz, 11 GHz, 18 GHz, 23 GHz, 80 GHz\" />\n                  <p class=\"help-text\">Authorized frequency band (e.g., \"6 GHz\", \"18-23 GHz\")</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Authorized Bandwidth</label>\n                  <input type=\"text\" placeholder=\"50 MHz, 100 MHz\" />\n                  <p class=\"help-text\">Total authorized bandwidth for this license</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Emission Designator</label>\n                  <input type=\"text\" placeholder=\"8K00F1D\" />\n                  <p class=\"help-text\">FCC emission designator code</p>\n                </div>\n              </div>\n\n              <div class=\"form-group\">\n                <label>License Holder Name *</label>\n                <input type=\"text\" placeholder=\"Company Name\" />\n              </div>\n\n              <div class=\"form-group\">\n                <label>License Holder Address</label>\n                <textarea\n                  placeholder=\"123 Business St, City, State ZIP\"\n                  rows=\"2\"\n                ></textarea>\n                <p class=\"help-text\">Full address of license holder as registered with FCC</p>\n              </div>\n\n              <div class=\"form-grid\">\n                <div class=\"form-group\">\n                  <label>License Expiration Date</label>\n                  <input type=\"date\" />\n                  <p class=\"help-text\">When the license expires</p>\n                </div>\n\n                <div class=\"form-group\">\n                  <label>Renewal Date</label>\n                  <input type=\"date\" />\n                  <p class=\"help-text\">Recommended renewal date (before expiration)</p>\n                </div>\n              </div>\n            </div></div>\n        </div></div>\n\n      <!-- Fiber Configuration -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isFiber && canCreateBackhaul\"><div class=\"section fiber-section\">\n          <h3>🌐 Fiber Optic Details</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Provider *</label>\n              <input type=\"text\" placeholder=\"AT&T, Verizon, Zayo\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Circuit ID</label>\n              <input type=\"text\" placeholder=\"CIRCUIT-123456\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Speed</label>\n              <select>\n                <option value=\"100M\">100 Mbps</option>\n                <option value=\"1G\">1 Gbps</option>\n                <option value=\"10G\">10 Gbps</option>\n                <option value=\"100G\">100 Gbps</option>\n              </select>\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Handoff Type</label>\n              <select>\n                <option value=\"single-mode\">Single-Mode Fiber</option>\n                <option value=\"multi-mode\">Multi-Mode Fiber</option>\n                <option value=\"ethernet\">Ethernet</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Connector</label>\n              <select>\n                <option value=\"LC\">LC</option>\n                <option value=\"SC\">SC</option>\n                <option value=\"ST\">ST</option>\n                <option value=\"RJ45\">RJ45</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Fiber Count</label>\n              <input type=\"number\" placeholder=\"2\" />\n            </div>\n          </div>\n        </div></div>\n\n      <!-- Common Fields -->\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"canCreateBackhaul\"><div class=\"section\">\n          <h3>⚙️ Link Details</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Capacity (Mbps) *</label>\n              <input type=\"number\" placeholder=\"1000\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Equipment Manufacturer</label>\n              <input type=\"text\" placeholder=\"Cisco, Ubiquiti\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Equipment Model</label>\n              <input type=\"text\" placeholder=\"ASR9000, AirFiber60\" />\n            </div>\n          </div>\n\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label>Monthly Cost ($)</label>\n              <input type=\"number\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Contract (months)</label>\n              <input type=\"number\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Status</label>\n              <select>\n                <option value=\"active\">Active</option>\n                <option value=\"inactive\">Inactive</option>\n                <option value=\"maintenance\">Maintenance</option>\n                <option value=\"planned\">Planned</option>\n              </select>\n            </div>\n          </div>\n        </div></div>\n    </div>\n\n    <div class=\"modal-footer\">\n      <button class=\"btn-secondary\" data-cwl-action=\"handleClose\" aria-label=\"Close\">Cancel</button>\n      <button class=\"btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving || !canCreateBackhaul\" aria-label=\"Save\">\n        <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"isSaving ? 'Saving...' : (backhaulToEdit ? '✅ Save Changes' : '✅ Create Backhaul\"></span>\n      </button>\n    </div>\n  </div>\n</div></div></div>\n  </div>\n\n  <!-- Tips Modal -->\n  <div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\"><div class=\"cwl-self-gated-shell\" data-cwl-shell-key=\"showTipsModal\" hidden aria-hidden=\"true\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div></div></div>";
}

@page GET "/modules/tenant-management"
page modules_tenant_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "tenant-management" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"tenant-management\" data-wisp-path=\"/modules/tenant-management\" data-cwl-island=\"client\"><div class=\"tenant-management-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\" data-cwl-nav=\"/dashboard\">\n        ← Back to Dashboard\n      </button>\n      <h1>🏢 Tenant Management</h1>\n      <p class=\"subtitle\">Manage all organizations and customer accounts</p>\n      <div class=\"admin-badge\">\n        <span>🔐</span>\n        <span>Platform Admin Access</span>\n      </div>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\" data-cwl-nav=\"/modules/tenant-management/cbrs-platform\">\n        🔑 CBRS Platform Keys\n      </button>\n      <button class=\"btn-primary\" data-cwl-toggle=\"showCreateForm:flip\" aria-label=\"Show Create Form\">\n        ➕ Create New Tenant\n      </button>\n    </div>\n  </div>\n\n    <div class=\"error-message\" hidden aria-hidden=\"true\">\n      <span class=\"error-icon\">⚠️</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"success-message\" hidden aria-hidden=\"true\">\n      <span class=\"success-icon\">✅</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"success:\">✕</button>\n    </div>\n\n  <!-- Create Tenant Form -->\n\n    <div class=\"create-form\" data-cwl-shell-key=\"showCreateForm\" hidden aria-hidden=\"true\">\n      <h2>Create New Tenant</h2>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label for=\"tenant-name\">Tenant Name *</label>\n          <input\n            id=\"tenant-name\"\n            type=\"text\" data-cwl-on-input=\"action:generateSubdomain\"\n            placeholder=\"e.g., acme-wireless\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"display-name\">Display Name *</label>\n          <input\n            id=\"display-name\"\n            type=\"text\"\n            placeholder=\"e.g., Acme Wireless ISP\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"contact-email\">Contact Email *</label>\n          <input\n            id=\"contact-email\"\n            type=\"email\"\n            placeholder=\"admin@acme.com\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"subdomain\">Subdomain</label>\n          <input\n            id=\"subdomain\"\n            type=\"text\"\n            placeholder=\"acme-wireless-abc123\"\n          />\n          <p class=\"help-text\">Used for CWMP URL: /cwmp/<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"newTenantSubdomain || 'subdomain'\"></span></p>\n        </div>\n      </div>\n\n      <div class=\"form-actions\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showCreateForm:false\" aria-label=\"Show Create Form\">\n          Cancel\n        </button>\n        <button class=\"btn-primary\" data-cwl-action=\"handleCreateTenant\" aria-label=\"Create Tenant\">\n          Create Tenant\n        </button>\n      </div>\n    </div>\n\n  <!-- Tenants List -->\n  <div class=\"tenants-section\">\n    <h2>All Tenants (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenants.length\"></span>)</h2>\n\n      <div class=\"tenants-grid\">\n        <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"tenants as tenant\" data-cwl-each-item=\"tenant\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-card%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-icon%22%3E%F0%9F%8F%A2%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-status%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22status-badge%20status-%7Btenant.status%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Btenant.status%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ch3%20class%3D%22tenant-name%22%3E%7Btenant.displayName%7D%3C%2Fh3%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%20class%3D%22tenant-id%22%3E%7Btenant.subdomain%7D%3C%2Fp%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22info-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3EContact%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Btenant.contactEmail%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22info-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3ECreated%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%22%3E%7Bnew%20Date(tenant.createdAt).toLocaleDateString()%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22info-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22label%22%3ECWMP%20URL%3A%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22value%20url%22%3E%7Btenant.cwmpUrl%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-stats%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22stat%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22stat-value%22%3E%7BgetTenantStats(tenant).users%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22stat-label%22%3EUsers%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22stat%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22stat-value%22%3E%7BgetTenantStats(tenant).devices%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22stat-label%22%3EDevices%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22tenant-actions%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-small%22%20data-cwl-action%3D%22handleEditTenant%22%20data-cwl-action-args%3D%22tenant%22%20aria-label%3D%22Edit%20Tenant%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9A%99%EF%B8%8F%20Manage%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-small%22%20data-cwl-nav%3D%22%2Ftenant-admin%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%93%8A%20Settings%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-small%20btn-danger%22%20data-cwl-action%3D%22handleDeleteClick%22%20data-cwl-action-args%3D%22tenant%22%20aria-label%3D%22Delete%20Click%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%F0%9F%97%91%EF%B8%8F%20Delete%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20\"><div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <div class=\"tenant-icon\">🏢</div>\n              <div class=\"tenant-status\">\n                <span class=\"status-badge status-\">\n\n                </span>\n              </div>\n            </div>\n\n            <h3 class=\"tenant-name\"></h3>\n            <p class=\"tenant-id\"></p>\n\n            <div class=\"tenant-info\">\n              <div class=\"info-row\">\n                <span class=\"label\">Contact:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">CWMP URL:</span>\n                <span class=\"value url\"></span>\n              </div>\n            </div>\n\n            <div class=\"tenant-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Users</span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Devices</span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-small\" data-cwl-action=\"handleEditTenant\" data-cwl-action-args=\"tenant\" aria-label=\"Edit Tenant\">\n                ⚙️ Manage\n              </button>\n              <button class=\"btn-small\">\n                📊 Settings\n              </button>\n              <button class=\"btn-small btn-danger\" data-cwl-action=\"handleDeleteClick\" data-cwl-action-args=\"tenant\" aria-label=\"Delete Click\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div></div>\n      </div>\n\n      <div class=\"empty-state\" hidden aria-hidden=\"true\">\n        <span class=\"empty-icon\">📦</span>\n        <h3>No Tenants Yet</h3>\n        <p>Create your first tenant to get started</p>\n      </div>\n\n      <div class=\"loading\" hidden aria-hidden=\"true\">\n        <div class=\"spinner\"></div>\n        <p>Loading tenants...</p>\n      </div>\n\n  </div>\n</div>\n\n<!-- Edit Tenant Modal -->\n\n  <div\n    class=\"modal-overlay\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    tabindex=\"0\"\n    aria-label=\"Tenant details dialog\" data-cwl-action=\"handleEditBackdropClick\" data-cwl-on-keydown=\"action:handleEditBackdropKeydown\"\n   data-cwl-shell-key=\"showEditModal\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content\" role=\"document\">\n      <div class=\"modal-header\">\n        <h2>Manage Tenant: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.displayName\"></span></h2>\n        <button class=\"close-btn\" data-cwl-toggle=\"showEditModal:false\" aria-label=\"Show Edit Modal\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n        <div class=\"info-section\">\n          <h3>Tenant Information</h3>\n          <div class=\"info-grid\">\n            <div class=\"info-item\">\n              <strong>Tenant ID:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.id\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <strong>Subdomain:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.subdomain\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <strong>Status:</strong>\n              <span class=\"status-badge status-\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.status\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <strong>Contact Email:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.contactEmail\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <strong>CWMP URL:</strong>\n              <code class=\"cwmp-url\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.cwmpUrl\"></span></code>\n            </div>\n            <div class=\"info-item\">\n              <strong>Created:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"new Date(selectedTenant.createdAt).toLocaleString()\"></span></span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"info-section\">\n          <h3>Settings</h3>\n          <div class=\"info-grid\">\n            <div class=\"info-item\">\n              <strong>Max Devices:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.limits.maxDevices\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <strong>Max Users:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.limits.maxUsers\"></span></span>\n            </div>\n            <div class=\"info-item\">\n              <strong>Storage Quota:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.limits.storageQuotaMB\"></span> MB</span>\n            </div>\n            <div class=\"info-item\">\n              <strong>Inform Interval:</strong>\n              <span><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"selectedTenant.settings.informInterval\"></span>s</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"info-section\">\n          <h3>Quick Actions</h3>\n          <div class=\"quick-actions\">\n            <button class=\"btn-action\" data-cwl-action=\"handleOpenSettings\" aria-label=\"Open Settings\">\n              ⚙️ Open Tenant Settings\n            </button>\n            <button class=\"btn-action\" data-cwl-action=\"handleViewDevices\" aria-label=\"View Devices\">\n              📡 View Devices\n            </button>\n            <button class=\"btn-action\" data-cwl-action=\"handleManageUsers\" aria-label=\"Manage Users\">\n              👥 Manage Users\n            </button>\n          </div>\n        </div>\n\n        <div class=\"info-section danger-zone\">\n          <h3>⚠️ Danger Zone</h3>\n          <p class=\"danger-description\">\n            Deleting a tenant is permanent and cannot be undone. All associated data will be removed.\n          </p>\n          <button class=\"btn-danger-action\" data-cwl-action=\"handleDeleteClick\" data-cwl-action-args=\"selectedTenant\" aria-label=\"Delete Click\">\n            🗑️ Delete Tenant\n          </button>\n        </div>\n      </div>\n\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showEditModal:false\" aria-label=\"Show Edit Modal\">\n          Close\n        </button>\n      </div>\n    </div>\n  </div>\n\n<!-- Delete Confirmation Dialog -->\n\n  <div\n    class=\"modal-overlay\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    tabindex=\"0\"\n    aria-label=\"Confirm tenant deletion dialog\" data-cwl-action=\"handleDeleteBackdropClick\" data-cwl-on-keydown=\"action:handleDeleteBackdropKeydown\"\n   data-cwl-shell-key=\"showDeleteConfirm\" hidden aria-hidden=\"true\">\n    <div class=\"modal-content delete-confirm-modal\" role=\"document\">\n      <div class=\"modal-header danger\">\n        <h2>⚠️ Confirm Deletion</h2>\n        <button class=\"close-btn\" data-cwl-toggle=\"showDeleteConfirm:false\" aria-label=\"Show Delete Confirm\">✕</button>\n      </div>\n\n      <div class=\"modal-body\">\n        <div class=\"warning-box\">\n          <div class=\"warning-icon\">🚨</div>\n          <div class=\"warning-content\">\n            <h3>This action cannot be undone!</h3>\n            <p>You are about to permanently delete:</p>\n            <div class=\"tenant-to-delete\">\n              <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenantToDelete.displayName\"></span></strong>\n              <span class=\"subdomain\">(<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenantToDelete.subdomain\"></span>)</span>\n            </div>\n            <p class=\"consequences\">This will remove:</p>\n            <ul class=\"deletion-list\">\n              <li>✗ The tenant organization</li>\n              <li>✗ All user associations</li>\n              <li>✗ All pending invitations</li>\n              <li>✗ Access to tenant configurations</li>\n            </ul>\n            <p class=\"note\">\n              <strong>Note:</strong> Users who owned this tenant will be able to create a new organization.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"confirm-input\">\n          <p>Type the tenant name <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tenantToDelete.displayName\"></span></strong> to confirm:</p>\n          <input\n            type=\"text\"\n            placeholder=\"Enter tenant name to confirm\"\n            id=\"deleteConfirmInput\"\n          />\n        </div>\n      </div>\n\n      <div class=\"modal-footer\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showDeleteConfirm:false\" data-cwl-attr-disabled=\"isDeleting\" aria-label=\"Show Delete Confirm\">\n          Cancel\n        </button>\n        <button\n          class=\"btn-danger\" data-cwl-action=\"confirmDelete\" data-cwl-attr-disabled=\"isDeleting\"\n         aria-label=\"Confirm Delete\">\n          Delete Tenant\n        </button>\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\" data-cwl-orphan-modal=\"1\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\" hidden aria-hidden=\"true\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/tenant-management/cbrs-platform"
page modules_tenant_management_cbrs_platform_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/tenant-management/cbrs-platform" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"tenant-management\" data-wisp-path=\"/modules/tenant-management/cbrs-platform\" data-cwl-island=\"client\"><div class=\"admin-page\">\n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <a href=\"/dashboard\" class=\"back-link\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n        </svg>\n        ← Back to Dashboard\n      </a>\n\n      <div class=\"header-title\">\n        <h1>🔑 CBRS Platform Configuration</h1>\n        <p class=\"subtitle\">Configure shared SAS API keys for all tenants</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"page-content\">\n\n      <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n        <span class=\"alert-icon\">⚠️</span>\n        <span class=\"alert-message\"></span>\n        <button class=\"alert-close\" data-cwl-set=\"error:\">✕</button>\n      </div>\n\n      <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n        <span class=\"alert-icon\">✅</span>\n        <span class=\"alert-message\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"successMessage\"></span></span>\n        <button class=\"alert-close\" data-cwl-set=\"successMessage:\">✕</button>\n      </div>\n\n    <div class=\"info-card\">\n      <div class=\"info-icon\">💡</div>\n      <div class=\"info-content\">\n        <h3>About Shared Platform Mode</h3>\n        <p>\n          Configure your platform's shared SAS API keys here. Tenants who choose \"Shared Platform\" mode\n          will use these keys with their own unique User ID / Customer ID for tenant isolation.\n        </p>\n        <p class=\"info-secondary\">\n          This allows you to share one SAS subscription across all tenants, significantly reducing costs\n          while maintaining proper tenant isolation through User IDs and Customer IDs.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"config-card\">\n      <div class=\"card-header\">\n        <h2>🔵 Google SAS Configuration</h2>\n        <span class=\"status-badge\">Platform-wide</span>\n      </div>\n\n      <form data-cwl-on-submit=\"action:handleSave\">\n        <div class=\"form-group\">\n          <label>\n            API Endpoint\n            <span class=\"required\">*</span>\n          </label>\n          <input\n            type=\"text\"\n            placeholder=\"https://sas.googleapis.com/v1\"\n            required\n          />\n          <span class=\"form-hint\">Google SAS API endpoint URL</span>\n        </div>\n\n        <div class=\"form-group\">\n          <label>\n            Platform API Key\n            <span class=\"required\">*</span>\n          </label>\n          <input\n            type=\"password\"\n            placeholder=\"Enter your Google SAS API key\"\n            required\n          />\n          <span class=\"form-hint\">\n            This API key will be shared by all tenants using \"Shared Platform\" mode.\n            Each tenant will have their own Google User ID for isolation.\n          </span>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Certificate Path (Optional)</label>\n          <input\n            type=\"text\"\n            placeholder=\"/path/to/certificate.pem\"\n          />\n          <span class=\"form-hint\">Path to client certificate for mutual TLS (if required)</span>\n        </div>\n      </form>\n    </div>\n\n    <div class=\"config-card\">\n      <div class=\"card-header\">\n        <h2>🟢 Federated Wireless Configuration</h2>\n        <span class=\"status-badge\">Platform-wide</span>\n      </div>\n\n      <form data-cwl-on-submit=\"action:handleSave\">\n        <div class=\"form-group\">\n          <label>\n            API Endpoint\n            <span class=\"required\">*</span>\n          </label>\n          <input\n            type=\"text\"\n            placeholder=\"https://sas.federatedwireless.com/api/v1\"\n            required\n          />\n          <span class=\"form-hint\">Federated Wireless SAS API endpoint URL</span>\n        </div>\n\n        <div class=\"form-group\">\n          <label>\n            Platform API Key\n            <span class=\"required\">*</span>\n          </label>\n          <input\n            type=\"password\"\n            placeholder=\"Enter your Federated Wireless API key\"\n            required\n          />\n          <span class=\"form-hint\">\n            This API key will be shared by all tenants using \"Shared Platform\" mode.\n            Each tenant will have their own Customer ID for isolation.\n          </span>\n        </div>\n\n        <div class=\"form-group\">\n          <label>Certificate Path (Optional)</label>\n          <input\n            type=\"text\"\n            placeholder=\"/path/to/certificate.pem\"\n          />\n          <span class=\"form-hint\">Path to client certificate (if required)</span>\n        </div>\n      </form>\n    </div>\n\n      <div class=\"test-result\" data-cwl-shell-key=\"showTestResult\" hidden aria-hidden=\"true\">\n\n      </div>\n\n    <div class=\"security-warning\">\n      <div class=\"warning-icon\">🔒</div>\n      <div class=\"warning-content\">\n        <strong>Security Notice:</strong> These API keys are shared across all tenants in \"Shared Platform\" mode.\n        Store them securely and never expose them in client-side code. All SAS API calls should go through\n        your backend (Firebase Functions) to keep these keys protected.\n      </div>\n    </div>\n\n    <div class=\"action-bar\">\n      <button type=\"button\" class=\"btn btn-secondary\" data-cwl-toggle=\"showTestResult:true\" aria-label=\"Show Test Result\">\n        🧪 Test Configuration\n      </button>\n      <button type=\"button\" class=\"btn btn-primary\" data-cwl-action=\"handleSave\" data-cwl-attr-disabled=\"isSaving\" aria-label=\"Save\">\n\n          💾 Save Platform Configuration\n\n          <div hidden aria-hidden=\"true\"><span class=\"spinner\"></span>\n          Saving...\n        </div>\n      </button>\n    </div>\n  </div>\n</div></div>";
}

@page GET "/modules/tenant-management/users"
page modules_tenant_management_users_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/tenant-management/users" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"tenant-management\" data-wisp-path=\"/modules/tenant-management/users\" data-cwl-island=\"client\"><div class=\"users-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\" data-cwl-nav=\"/tenant-admin\">\n        ← Back to Tenant Settings\n      </button>\n      <h1>👥 User Management</h1>\n      <p class=\"subtitle\"></p>\n    </div>\n\n    <div class=\"header-buttons\">\n      <button class=\"btn-primary\" data-cwl-toggle=\"showAddUserForm:flip\" aria-label=\"Show Add User Form\">\n        ➕ Add User\n      </button>\n    </div>\n  </div>\n\n    <div class=\"error-message\" hidden aria-hidden=\"true\">\n      <span>⚠️</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"success-message\" hidden aria-hidden=\"true\">\n      <span>✅</span>\n      <span></span>\n      <button class=\"dismiss-btn\" data-cwl-set=\"success:\">✕</button>\n    </div>\n\n    <div class=\"invite-form\" data-cwl-shell-key=\"showAddUserForm\" hidden aria-hidden=\"true\">\n      <h2>Add User to Organization</h2>\n      <p class=\"form-subtitle\">Add an existing user or create a placeholder for a future user</p>\n\n      <div class=\"form-group\">\n        <label for=\"user-email\">Email Address</label>\n        <input\n          id=\"user-email\"\n          type=\"email\"\n          placeholder=\"user@example.com\"\n        />\n        <p class=\"help-text\">User will be granted access to this organization</p>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"user-role\">Role</label>\n        <select id=\"user-role\">\n\n            <option value=owner data-cwl-attr-disabled=\"&quot;owner&quot; === 'owner' &amp;&amp; users.some(u =&gt; u.role === 'owner')\">\n              Owner - Full control (only one per tenant)\n            </option>\n\n            <option value=admin data-cwl-attr-disabled=\"&quot;admin&quot; === 'owner' &amp;&amp; users.some(u =&gt; u.role === 'owner')\">\n              Admin - Full access except owner rights\n            </option>\n\n            <option value=operator data-cwl-attr-disabled=\"&quot;operator&quot; === 'owner' &amp;&amp; users.some(u =&gt; u.role === 'owner')\">\n              Operator - Can manage devices and view reports\n            </option>\n\n            <option value=viewer data-cwl-attr-disabled=\"&quot;viewer&quot; === 'owner' &amp;&amp; users.some(u =&gt; u.role === 'owner')\">\n              Viewer - Read-only access\n            </option>\n\n        </select>\n        <p class=\"help-text\">Determines what this user can do in the organization</p>\n      </div>\n\n      <div class=\"form-actions\">\n        <button class=\"btn-secondary\" data-cwl-toggle=\"showAddUserForm:false\" aria-label=\"Show Add User Form\">\n          Cancel\n        </button>\n        <button class=\"btn-primary\" data-cwl-action=\"handleAddUser\" data-cwl-attr-disabled=\"isAdding\" aria-label=\"Add User\">\n          Add User\n        </button>\n      </div>\n    </div>\n\n  <div class=\"users-section\">\n    <h2>Organization Users (<span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"users.length\"></span>)</h2>\n\n      <div class=\"users-table\">\n        <table>\n          <thead>\n            <tr>\n              <th>User</th>\n              <th>Role</th>\n              <th>Added</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"users as user\" data-cwl-each-item=\"user\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-cell%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22user-icon%22%3E%F0%9F%91%A4%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3E%7Buser.userId%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cselect%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20value%3D%7Buser.role%7D%20data-cwl-on-change%3D%22action%3AhandleChangeRole%22%20data-cwl-on-change-args%3D%22user.userId%2C%20e.currentTarget.value%20as%20TenantRole%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20disabled%3D%7Buser.role%20%3D%3D%3D%20'owner'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%22owner%22%20disabled%3D%7Buser.role%20!%3D%3D%20'owner'%7D%3EOwner%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%22admin%22%3EAdmin%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%22operator%22%3EOperator%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Coption%20value%3D%22viewer%22%3EViewer%3C%2Foption%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fselect%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bnew%20Date(user.createdAt).toLocaleDateString()%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20user.role%20!%3D%3D%20'owner'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20class%3D%22btn-danger-small%22%20data-cwl-action%3D%22handleRemoveUser%22%20data-cwl-action-args%3D%22user.userId%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20aria-label%3D%22Remove%20User%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20Remove%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22owner-badge%22%3EOwner%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><tr>\n                <td>\n                  <div class=\"user-cell\">\n                    <span class=\"user-icon\">👤</span>\n                    <span></span>\n                  </div>\n                </td>\n                <td>\n                  <select data-cwl-on-change=\"action:handleChangeRole\" data-cwl-on-change-args=\"user.userId, e.currentTarget.value as TenantRole\">\n                    <option value=\"owner\">Owner</option>\n                    <option value=\"admin\">Admin</option>\n                    <option value=\"operator\">Operator</option>\n                    <option value=\"viewer\">Viewer</option>\n                  </select>\n                </td>\n                <td>\n\n                </td>\n                <td>\n                  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"user.role !== 'owner'\"><button\n                      class=\"btn-danger-small\" data-cwl-action=\"handleRemoveUser\" data-cwl-action-args=\"user.userId\"\n                     aria-label=\"Remove User\">\n                      Remove\n                    </button></div>\n                    <span class=\"owner-badge\">Owner</span>\n\n                </td>\n              </tr></div>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"empty-state\" hidden aria-hidden=\"true\">\n        <span class=\"empty-icon\">👥</span>\n        <h3>No Users Yet</h3>\n        <p>Invite users to collaborate in your organization</p>\n      </div>\n\n      <div class=\"loading\" hidden aria-hidden=\"true\">\n        <div class=\"spinner\"></div>\n        <p>Loading users...</p>\n      </div>\n\n  </div>\n</div></div>";
}

@page GET "/modules/user-management"
page modules_user_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", moduleSupport: "user-management" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"user-management\" data-wisp-path=\"/modules/user-management\" data-cwl-island=\"client\"><div class=\"user-management-container\">\n  <div class=\"header\">\n    <button class=\"btn-back\" data-cwl-nav=\"/dashboard\" type=\"button\">\n      ← Back to Modules\n    </button>\n\n    <div class=\"title-section\">\n      <h1>👥 User Management</h1>\n      <p class=\"subtitle\">\n\n          Manage all users across all organizations\n\n      </p>\n    </div>\n\n      <div class=\"header-actions\">\n        <button class=\"btn btn-secondary\" data-cwl-nav=\"/modules/user-management/roles\">\n          <span>👥</span>\n          Role Management\n        </button>\n        <button class=\"btn btn-secondary\" data-cwl-nav=\"/modules/user-management/permissions\">\n          <span>🔐</span>\n          User Permissions\n        </button>\n        <button class=\"btn btn-primary\" data-cwl-toggle=\"showInviteModal:true\" aria-label=\"Show Invite Modal\">\n          <span>➕</span>\n          Add User\n        </button>\n      </div>\n\n  </div>\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      <span>❌</span>\n      <span></span>\n      <button data-cwl-set=\"error:\">✕</button>\n    </div>\n\n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search by name or email...\" data-cwl-on-input=\"action:handleSearch\"\n      />\n    </div>\n\n    <select data-cwl-on-change=\"action:handleRoleFilterChange\" class=\"select\">\n      <option value=\"all\">All Roles</option>\n      <option value=\"owner\">Owner</option>\n      <option value=\"admin\">Admin</option>\n      <option value=\"engineer\">Engineer</option>\n      <option value=\"installer\">Field Technician</option>\n      <option value=\"helpdesk\">Help Desk</option>\n      <option value=\"viewer\">Viewer</option>\n    </select>\n\n    <select data-cwl-on-change=\"action:handleStatusFilterChange\" class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"active\">Active</option>\n      <option value=\"suspended\">Suspended</option>\n      <option value=\"pending_invitation\">Pending</option>\n    </select>\n\n    <div class=\"results-count\">\n      <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"filteredUsers.length\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"users.length\"></span> users\n    </div>\n  </div>\n\n    <div class=\"table-container\">\n      <table class=\"user-table\">\n        <thead>\n          <tr>\n            <th>User</th>\n            <th>Role</th>\n            <th>Status</th>\n            <th>Last Login</th>\n            <th>Added</th>\n\n              <th>Actions</th>\n\n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"filteredUsers as user (user.uid)\" data-cwl-each-item=\"user\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%3Ctr%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-cell%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20user.photoURL%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cimg%20src%3D%7Buser.photoURL%7D%20alt%3D%7Buser.displayName%7D%20class%3D%22user-avatar%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%3Aelse%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-avatar-placeholder%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Buser.displayName%3F.charAt(0)%20%7C%7C%20user.email.charAt(0).toUpperCase()%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-info%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-name%22%3E%7Buser.displayName%20%7C%7C%20'No%20name'%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22user-email%22%3E%7Buser.email%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7BgetRoleBadgeClass(user.role)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BROLE_NAMES%5Buser.role%5D%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22badge%20%7BgetStatusBadgeClass(user.status)%7D%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Buser.status.replace('_'%2C%20'%20')%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22time-cell%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatTimeAgo(user.lastLoginAt)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%20class%3D%22time-cell%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BformatTimeAgo(user.addedAt)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23if%20canManageUsers%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn%20btn-sm%20btn-ghost%22%20data-cwl-action%3D%22openEditModal%22%20data-cwl-action-args%3D%22user%22%20aria-label%3D%22Open%20Edit%20Modal%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%E2%9C%8F%EF%B8%8F%20Edit%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftd%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Fif%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Ftr%3E%0A%20%20%20%20%20%20%20%20%20%20\"><tr>\n              <td>\n                <div class=\"user-cell\">\n\n                    <div class=\"user-avatar-placeholder\">\n\n                    </div>\n\n                    <div hidden aria-hidden=\"true\"><img class=\"user-avatar\" />\n                  </div>\n                  <div class=\"user-info\">\n                    <div class=\"user-name\"></div>\n                    <div class=\"user-email\"></div>\n                  </div>\n                </div>\n              </td>\n              <td>\n                <span class=\"badge \">\n\n                </span>\n              </td>\n              <td>\n                <span class=\"badge \">\n\n                </span>\n              </td>\n              <td class=\"time-cell\">\n\n              </td>\n              <td class=\"time-cell\">\n\n              </td>\n\n                <td>\n                  <button class=\"btn btn-sm btn-ghost\" data-cwl-action=\"openEditModal\" data-cwl-action-args=\"user\" aria-label=\"Open Edit Modal\">\n                    ✏️ Edit\n                  </button>\n                </td>\n\n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"empty-state\" hidden aria-hidden=\"true\">\n      <span class=\"empty-icon\">👤</span>\n      <h3>No users found</h3>\n      <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"searchQuery || roleFilter !== 'all' || statusFilter !== 'all'\"><p>Try adjusting your filters</p>\n        <button class=\"btn btn-secondary\" data-cwl-action=\"applyFilters\" aria-label=\"Apply Filters\">\n          Clear Filters\n        </button></div>\n        <p>Invite your first user to get started</p>\n        <button class=\"btn btn-primary\" data-cwl-toggle=\"showInviteModal:true\" aria-label=\"Show Invite Modal\">\n          Invite User\n        </button>\n\n    </div>\n\n</div>\n\n  <div data-cwl-shell-key=\"showInviteModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"InviteUserModal\" data-cwl-lifted-component=\"InviteUserModal\"><div\n  class=\"modal-backdrop\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  tabindex=\"0\"\n  aria-label=\"Add user dialog\" data-cwl-action=\"handleBackdropClick\" data-cwl-on-keydown=\"action:handleBackdropKeydown\"\n>\n  <div class=\"modal-content\" role=\"document\">\n    <div class=\"modal-header\">\n      <h2>➕ Add Team Member</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"loading\" aria-label=\"Close\">✕</button>\n    </div>\n\n      <form data-cwl-on-submit=\"action:handleSubmit\">\n\n          <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n            <span>❌</span>\n            <span></span>\n          </div>\n\n        <div class=\"form-group\">\n          <label for=\"email\">Email Address *</label>\n          <input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"user@example.com\"\n            required data-cwl-attr-disabled=\"loading\"\n          />\n          <p class=\"hint\">They'll receive login instructions at this email</p>\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"displayName\">Display Name (optional)</label>\n          <input\n            id=\"displayName\"\n            type=\"text\"\n            placeholder=\"John Smith\" data-cwl-attr-disabled=\"loading\"\n          />\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"role\">Role *</label>\n          <select id=\"role\" data-cwl-attr-disabled=\"loading\">\n\n              <option value=\"admin\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['admin']\"></span>\n              </option>\n\n              <option value=\"engineer\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['engineer']\"></span>\n              </option>\n\n              <option value=\"installer\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['installer']\"></span>\n              </option>\n\n              <option value=\"helpdesk\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['helpdesk']\"></span>\n              </option>\n\n              <option value=\"support\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['support']\"></span>\n              </option>\n\n              <option value=\"viewer\">\n                <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['viewer']\"></span>\n              </option>\n\n          </select>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"role\"><p class=\"role-description\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_DESCRIPTIONS[role]\"></span></p></div>\n        </div>\n\n        <div class=\"info-box\">\n          <span class=\"info-icon\">ℹ️</span>\n          <div class=\"info-content\">\n            <p><strong>What happens next:</strong></p>\n            <ul>\n              <li>User receives a welcome email at <strong>wisptools.io</strong></li>\n              <li>They can sign in with Google or create a password</li>\n              <li>Once signed in, they'll have access to your organization</li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"modal-actions\">\n          <button type=\"button\" class=\"btn btn-secondary\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"loading\" aria-label=\"Close\">\n            Cancel\n          </button>\n          <button type=\"submit\" class=\"btn btn-primary\" data-cwl-attr-disabled=\"loading\">\n\n              Add User\n\n          </button>\n        </div>\n      </form>\n\n      <div class=\"success-message\" hidden aria-hidden=\"true\">\n        <span class=\"success-icon\">✅</span>\n        <h3>User Added!</h3>\n        <p>\n          <strong></strong> has been added to your team.\n        </p>\n        <p class=\"email-note\">\n          📧 A welcome email with login instructions has been sent.\n        </p>\n      </div>\n\n  </div>\n</div></div>\n</div>\n\n  <div data-cwl-shell-key=\"showEditModal\" hidden aria-hidden=\"true\"><div data-cwl-component=\"EditUserModal\" data-cwl-lifted-component=\"EditUserModal\"><div\n  class=\"modal-backdrop\"\n  role=\"presentation\"\n  aria-hidden=\"true\"\n  tabindex=\"-1\" data-cwl-action=\"handleBackdropClick\"\n>\n  <div\n    class=\"modal-content\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"Edit user dialog\"\n    tabindex=\"0\" data-cwl-on-keydown=\"action:handleBackdropKeydown\"\n  >\n    <div class=\"modal-header\">\n      <h2>Edit User</h2>\n      <button class=\"close-btn\" data-cwl-action=\"handleClose\" data-cwl-attr-disabled=\"loading\" aria-label=\"Close\">✕</button>\n    </div>\n\n    <div class=\"modal-body\">\n\n        <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n          <span>❌</span>\n          <span></span>\n        </div>\n\n      <div class=\"user-info-section\">\n        <div class=\"user-avatar-large\">\n\n            <div class=\"avatar-placeholder\">\n              <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.displayName?.charAt(0) || user.email.charAt(0).toUpperCase()\"></span>\n            </div>\n\n            <div hidden aria-hidden=\"true\"><img />\n          </div>\n        </div>\n        <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.displayName || 'No name'\"></span></h3>\n        <p class=\"user-email\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.email\"></span></p>\n        <span class=\"status-badge status-\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.status.replace('_', ' ')\"></span></span>\n      </div>\n\n        <div class=\"form-section\">\n          <label for=\"role\">Role</label>\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"isOwner\"><div class=\"role-locked\">\n              <span class=\"lock-icon\">🔒</span>\n              <div>\n                <div class=\"role-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES.owner\"></span></div>\n                <div class=\"role-hint\">Owner role cannot be changed</div>\n              </div>\n            </div></div>\n            <select\n              id=\"role\" data-cwl-attr-disabled=\"loading\"\n            >\n\n                <option value=\"admin\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['admin']\"></span>\n                </option>\n\n                <option value=\"engineer\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['engineer']\"></span>\n                </option>\n\n                <option value=\"installer\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['installer']\"></span>\n                </option>\n\n                <option value=\"helpdesk\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['helpdesk']\"></span>\n                </option>\n\n                <option value=\"support\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['support']\"></span>\n                </option>\n\n                <option value=\"viewer\">\n                  <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['viewer']\"></span>\n                </option>\n\n            </select>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedRole !== user.role\"><button class=\"btn btn-primary btn-sm mt-2\" data-cwl-action=\"handleUpdateRole\" data-cwl-attr-disabled=\"loading\" aria-label=\"Update Role\">\n\n                  Update Role\n\n              </button></div>\n\n        </div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"!isOwner\"><div class=\"actions-section\">\n            <h4>Actions</h4>\n\n            <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"user.status === 'active'\"><button class=\"btn btn-warning btn-block\" data-cwl-action=\"handleSuspend\" data-cwl-attr-disabled=\"loading\" aria-label=\"Suspend\">\n                🚫 Suspend User\n              </button></div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"user.status === 'suspended'\"><button class=\"btn btn-success btn-block\" data-cwl-action=\"handleActivate\" data-cwl-attr-disabled=\"loading\" aria-label=\"Activate\">\n                ✅ Activate User\n              </button></div>\n\n            <button class=\"btn btn-danger btn-block\" data-cwl-toggle=\"showDeleteConfirm:true\" data-cwl-attr-disabled=\"loading\" aria-label=\"Show Delete Confirm\">\n              🗑️ Remove from Organization\n            </button>\n          </div></div>\n\n        <div class=\"confirm-delete\" data-cwl-shell-key=\"showDeleteConfirm\" hidden aria-hidden=\"true\">\n          <span class=\"warning-icon\">⚠️</span>\n          <h3>Remove User?</h3>\n          <p>Are you sure you want to remove <strong><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"user.email\"></span></strong> from this organization?</p>\n          <p class=\"warning-text\">This action cannot be undone.</p>\n\n          <div class=\"confirm-actions\">\n            <button class=\"btn btn-secondary\" data-cwl-toggle=\"showDeleteConfirm:false\" data-cwl-attr-disabled=\"loading\" aria-label=\"Show Delete Confirm\">\n              Cancel\n            </button>\n            <button class=\"btn btn-danger\" data-cwl-action=\"handleDelete\" data-cwl-attr-disabled=\"loading\" aria-label=\"Delete\">\n\n                Yes, Remove User\n\n            </button>\n          </div>\n        </div>\n\n    </div>\n  </div>\n</div></div>\n</div></div>\n<div data-cwl-component=\"HelpModal\" data-cwl-lifted-component=\"HelpModal\" data-cwl-orphan-modal=\"1\"><div class=\"help-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\" hidden aria-hidden=\"true\">\n    <div class=\"help-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"help-modal-title\">\n      <div class=\"help-header\">\n        <h2 id=\"help-modal-title\">Help</h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"help-body\">\n\n      </div>\n    </div>\n  </div></div>\n<div data-cwl-component=\"TipsModal\" data-cwl-lifted-component=\"TipsModal\" data-cwl-orphan-modal=\"1\"><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"show && currentTip\" hidden aria-hidden=\"true\"><div class=\"tips-overlay\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\">\n    <div class=\"tips-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tips-modal-title\">\n      <div class=\"tips-header\">\n        <div class=\"tips-title-section\">\n\n            <div hidden aria-hidden=\"true\"><span class=\"tip-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.icon\"></span></span>\n          </div>\n          <h2 id=\"tips-modal-title\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTip.title\"></span></h2>\n        </div>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"tips-body\">\n        <div class=\"tip-content\">\n\n        </div>\n      </div>\n\n      <div class=\"tips-footer\">\n        <div class=\"tips-footer-left\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"tips.length > 1\"><div class=\"tip-nav\">\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goPrev\" aria-label=\"Previous tip\">←</button>\n              <span class=\"tip-counter\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"currentTipIndex + 1\"></span> of <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"tips.length\"></span></span>\n              <button type=\"button\" class=\"nav-btn\" data-cwl-action=\"goNext\" aria-label=\"Next tip\">→</button>\n            </div></div>\n          <label class=\"dont-show-again\">\n            <input type=\"checkbox\" />\n            <span>Don't show again</span>\n          </label>\n        </div>\n        <button class=\"close-button\" data-cwl-action=\"handleClose\" type=\"button\" aria-label=\"Close\">Close</button>\n      </div>\n    </div>\n  </div></div></div>\n<div data-cwl-component=\"AuthModal\" data-cwl-lifted-component=\"AuthModal\" data-cwl-orphan-modal=\"1\"><div\n    class=\"auth-overlay\"\n    role=\"presentation\" data-cwl-action=\"handleClose\" data-cwl-on-keydown=\"action:handleClose\"\n   hidden aria-hidden=\"true\">\n    <div\n      class=\"auth-modal\"\n      role=\"dialog\"\n      aria-labelledby=\"auth-modal-title\"\n    >\n      <div class=\"auth-header\">\n        <h2 id=\"auth-modal-title\">\n          <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n            Sign In to PCI Mapper\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n            Create Account\n          </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n            Reset Password\n          </div>\n        </h2>\n        <button class=\"close-btn\" data-cwl-action=\"handleClose\" aria-label=\"Close\">×</button>\n      </div>\n\n      <div class=\"auth-body\">\n\n          <div class=\"error-message\" hidden aria-hidden=\"true\"></div>\n\n        <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signin'\">\n          <form data-cwl-on-submit=\"action:handleSignIn\">\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"••••••••\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Sign In\n            </button>\n          </form>\n\n          <div class=\"divider\">or</div>\n\n          <button class=\"auth-btn google\" data-cwl-action=\"handleGoogleSignIn\" data-cwl-attr-disabled=\"isLoading\" aria-label=\"Google Sign In\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n              <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"/>\n              <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"/>\n              <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"/>\n              <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"/>\n            </svg>\n            Continue with Google\n          </button>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'reset'\" aria-label=\"Switch Mode\">\n              Forgot password?\n            </button>\n            <span>•</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signup'\" aria-label=\"Switch Mode\">\n              Create account\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === 'signup'\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handleSignUp\">\n            <div class=\"form-group\">\n              <label for=\"displayName\">Display Name (Optional)</label>\n              <input\n                type=\"text\"\n                id=\"displayName\"\n                placeholder=\"John Doe\" data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"password\">Password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                placeholder=\"At least 6 characters\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"confirmPassword\">Confirm Password</label>\n              <input\n                type=\"password\"\n                id=\"confirmPassword\"\n                placeholder=\"Re-enter password\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Create Account\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <span>Already have an account?</span>\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Sign in\n            </button>\n          </div>\n        </div><div data-cwl-bind=\"if\" data-cwl-hole-detail=\"mode === '__fallback'\" data-cwl-state-fallback=\"mode\" hidden aria-hidden=\"true\">\n          <form data-cwl-on-submit=\"action:handlePasswordReset\">\n            <p class=\"reset-info\">Enter your email and we'll send you a reset link.</p>\n\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                placeholder=\"your@email.com\"\n                required data-cwl-attr-disabled=\"isLoading\"\n              />\n            </div>\n\n            <button type=\"submit\" class=\"auth-btn primary\" data-cwl-attr-disabled=\"isLoading\">\n              Send Reset Link\n            </button>\n          </form>\n\n          <div class=\"auth-footer\">\n            <button class=\"link-btn\" data-cwl-action=\"switchMode\" data-cwl-action-args=\"'signin'\" aria-label=\"Switch Mode\">\n              Back to sign in\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div></div>";
}

@page GET "/modules/user-management/permissions"
page modules_user_management_permissions_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/user-management/permissions" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"user-management\" data-wisp-path=\"/modules/user-management/permissions\" data-cwl-island=\"client\"><div class=\"permissions-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"btn-back\" data-cwl-nav=\"/modules/user-management\" type=\"button\">\n        ← Back\n      </button>\n      <div>\n        <h1>🔐 FCAPS Permission Management</h1>\n        <p class=\"subtitle\">Manage Fault, Configuration, Accounting, Performance, and Security permissions</p>\n      </div>\n    </div>\n  </div>\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      <span>❌ </span>\n      <button data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n      <span>✅ </span>\n      <button data-cwl-set=\"success:\">✕</button>\n    </div>\n\n  <!-- Permission Type Selector -->\n  <div class=\"permission-type-selector\">\n    <button\n      class=\"type-btn\" data-cwl-action=\"handlePermissionTypeChange\"\n     aria-label=\"Permission Type Change\">\n      👥 Role Permissions\n    </button>\n    <button\n      class=\"type-btn\" data-cwl-action=\"handlePermissionTypeChange\"\n     aria-label=\"Permission Type Change\">\n      👤 User Permissions\n    </button>\n  </div>\n\n    <!-- Role Permissions -->\n    <div class=\"permissions-section\">\n      <div class=\"section-header\">\n        <h2>Role Permissions</h2>\n        <select data-cwl-on-change=\"action:handleRoleChange\">\n\n            <option value=\"admin\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'admin'.charAt(0).toUpperCase() + 'admin'.slice(1)\"></span></option>\n\n            <option value=\"engineer\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'engineer'.charAt(0).toUpperCase() + 'engineer'.slice(1)\"></span></option>\n\n            <option value=\"installer\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'installer'.charAt(0).toUpperCase() + 'installer'.slice(1)\"></span></option>\n\n            <option value=\"helpdesk\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'helpdesk'.charAt(0).toUpperCase() + 'helpdesk'.slice(1)\"></span></option>\n\n            <option value=\"support\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'support'.charAt(0).toUpperCase() + 'support'.slice(1)\"></span></option>\n\n            <option value=\"sales\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'sales'.charAt(0).toUpperCase() + 'sales'.slice(1)\"></span></option>\n\n            <option value=\"viewer\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'viewer'.charAt(0).toUpperCase() + 'viewer'.slice(1)\"></span></option>\n\n        </select>\n      </div>\n\n      <div class=\"modules-grid\">\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Inventory</h3>\n              <p class=\"module-description\">Hardware inventory management</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;inventory&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Customers</h3>\n              <p class=\"module-description\">Customer and subscriber management</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;customers&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Plans/Projects</h3>\n              <p class=\"module-description\">Deployment planning and projects</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;plans&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Network</h3>\n              <p class=\"module-description\">Network sites and equipment</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;network&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Work Orders</h3>\n              <p class=\"module-description\">Work order and ticket management</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;work-orders&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Monitoring</h3>\n              <p class=\"module-description\">System monitoring and alerts</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;monitoring&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Billing</h3>\n              <p class=\"module-description\">Billing and accounting</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;billing&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>User Management</h3>\n              <p class=\"module-description\">User and role management</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;users&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3>Tenant Settings</h3>\n              <p class=\"module-description\">Tenant configuration</p>\n            </div>\n\n            <div class=\"fcaps-permissions\">\n              <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstrong%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fstrong%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-badge%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n\n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n\n            <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;tenants&quot;\" aria-label=\"Edit Permissions\">\n              ✏️ Edit\n            </button>\n          </div>\n\n      </div>\n    </div>\n\n  <!-- Edit Permission Modal -->\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"editingModule && editingPermissions\"><div class=\"modal-overlay\" data-cwl-action=\"cancelEdit\" hidden aria-hidden=\"true\">\n      <div class=\"modal-content\">\n        <div class=\"modal-header\">\n          <h3>Edit Permissions: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"editingModule\"></span></h3>\n          <button class=\"close-btn\" data-cwl-action=\"cancelEdit\" aria-label=\"Cancel Edit\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n          <div class=\"fcaps-edit-grid\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-edit-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations-checkboxes%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Clabel%20class%3D%22checkbox-label%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cinput%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22checkbox%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20checked%3D%7BeditingPermissions%5Bcategory%5D%5Bop%5D%7D%20data-cwl-on-change%3D%22action%3AtogglePermission%22%20data-cwl-on-change-args%3D%22category%2C%20op%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%3E%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Flabel%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-edit-category\">\n                <h4></h4>\n                <div class=\"operations-checkboxes\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\"><label class=\"checkbox-label\">\n                      <input\n                        type=\"checkbox\" data-cwl-on-change=\"action:togglePermission\" data-cwl-on-change-args=\"category, op\"\n                      />\n                      <span></span>\n                    </label></div>\n                </div>\n              </div></div>\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" data-cwl-action=\"cancelEdit\" aria-label=\"Cancel Edit\">Cancel</button>\n          <button class=\"btn-primary\" data-cwl-action=\"savePermissions\" data-cwl-attr-disabled=\"loading\" aria-label=\"Save Permissions\">\n            Save Permissions\n          </button>\n        </div>\n      </div>\n    </div></div>\n</div></div>";
}

@page GET "/modules/user-management/roles"
page modules_user_management_roles_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "origin-convert-all", httpPath: "/modules/user-management/roles" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"user-management\" data-wisp-path=\"/modules/user-management/roles\" data-cwl-island=\"client\"><div class=\"role-management-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"btn-back\" data-cwl-nav=\"/modules/user-management\" type=\"button\">\n        ← Back\n      </button>\n      <div>\n        <h1>👥 Role Management</h1>\n        <p class=\"subtitle\">Define FCAPS permissions (Fault, Configuration, Accounting, Performance, Security) for each role</p>\n      </div>\n    </div>\n  </div>\n\n    <div class=\"alert alert-error\" hidden aria-hidden=\"true\">\n      <span>❌ </span>\n      <button data-cwl-set=\"error:\">✕</button>\n    </div>\n\n    <div class=\"alert alert-success\" hidden aria-hidden=\"true\">\n      <span>✅ </span>\n      <button data-cwl-set=\"success:\">✕</button>\n    </div>\n\n  <!-- Role Selector -->\n  <div class=\"role-selector-section\">\n    <h2>Select Role</h2>\n    <div class=\"role-tabs\">\n\n        <button\n          class=\"role-tab\"\n          style=\"border-color:\" data-cwl-action=\"handleRoleChange\"\n         aria-label=\"Role Change\">\n          <span class=\"role-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'admin' === 'admin' ? '👑' : 'admin' === 'engineer' ? '⚙️' : 'admin' === 'instal\"></span></span>\n          <span class=\"role-name\">Admin</span>\n        </button>\n\n        <button\n          class=\"role-tab\"\n          style=\"border-color:\" data-cwl-action=\"handleRoleChange\"\n         aria-label=\"Role Change\">\n          <span class=\"role-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'engineer' === 'admin' ? '👑' : 'engineer' === 'engineer' ? '⚙️' : 'engineer' ==\"></span></span>\n          <span class=\"role-name\">Engineer</span>\n        </button>\n\n        <button\n          class=\"role-tab\"\n          style=\"border-color:\" data-cwl-action=\"handleRoleChange\"\n         aria-label=\"Role Change\">\n          <span class=\"role-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'installer' === 'admin' ? '👑' : 'installer' === 'engineer' ? '⚙️' : 'installer'\"></span></span>\n          <span class=\"role-name\">Field Technician</span>\n        </button>\n\n        <button\n          class=\"role-tab\"\n          style=\"border-color:\" data-cwl-action=\"handleRoleChange\"\n         aria-label=\"Role Change\">\n          <span class=\"role-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'helpdesk' === 'admin' ? '👑' : 'helpdesk' === 'engineer' ? '⚙️' : 'helpdesk' ==\"></span></span>\n          <span class=\"role-name\">Help Desk</span>\n        </button>\n\n        <button\n          class=\"role-tab\"\n          style=\"border-color:\" data-cwl-action=\"handleRoleChange\"\n         aria-label=\"Role Change\">\n          <span class=\"role-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'support' === 'admin' ? '👑' : 'support' === 'engineer' ? '⚙️' : 'support' === '\"></span></span>\n          <span class=\"role-name\">Customer Support</span>\n        </button>\n\n        <button\n          class=\"role-tab\"\n          style=\"border-color:\" data-cwl-action=\"handleRoleChange\"\n         aria-label=\"Role Change\">\n          <span class=\"role-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'sales' === 'admin' ? '👑' : 'sales' === 'engineer' ? '⚙️' : 'sales' === 'instal\"></span></span>\n          <span class=\"role-name\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES['sales']\"></span></span>\n        </button>\n\n        <button\n          class=\"role-tab\"\n          style=\"border-color:\" data-cwl-action=\"handleRoleChange\"\n         aria-label=\"Role Change\">\n          <span class=\"role-icon\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"'viewer' === 'admin' ? '👑' : 'viewer' === 'engineer' ? '⚙️' : 'viewer' === 'ins\"></span></span>\n          <span class=\"role-name\">Viewer</span>\n        </button>\n\n    </div>\n    <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"selectedRole\"><p class=\"role-description\"><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_DESCRIPTIONS[selectedRole]\"></span></p></div>\n  </div>\n\n  <!-- FCAPS Legend -->\n  <div class=\"fcaps-legend\">\n    <h3>FCAPS Categories:</h3>\n    <div class=\"legend-items\">\n      <div class=\"legend-item\">\n        <strong>F</strong> - <span>Fault:</span> Monitoring, alarms, error handling\n      </div>\n      <div class=\"legend-item\">\n        <strong>C</strong> - <span>Configuration:</span> Settings, changes, management\n      </div>\n      <div class=\"legend-item\">\n        <strong>A</strong> - <span>Accounting:</span> Billing, usage tracking\n      </div>\n      <div class=\"legend-item\">\n        <strong>P</strong> - <span>Performance:</span> Metrics, analytics, monitoring\n      </div>\n      <div class=\"legend-item\">\n        <strong>S</strong> - <span>Security:</span> Access control, authentication\n      </div>\n    </div>\n    <div class=\"operations-legend\">\n      <strong>Operations:</strong> <span class=\"badge\">R</span> = Read, <span class=\"badge\">W</span> = Write, <span class=\"badge\">D</span> = Delete\n    </div>\n  </div>\n\n  <!-- Modules Grid -->\n  <div class=\"modules-section\">\n    <h2>Module Permissions for <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES[selectedRole]\"></span></h2>\n    <div class=\"modules-grid\">\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">📦</span>\n            <div>\n              <h3>Inventory</h3>\n              <p class=\"module-description\">Hardware inventory management</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;inventory&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">👥</span>\n            <div>\n              <h3>Customers</h3>\n              <p class=\"module-description\">Customer and subscriber management</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;customers&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">🗺️</span>\n            <div>\n              <h3>Plans/Projects</h3>\n              <p class=\"module-description\">Deployment planning and projects</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;plans&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">📡</span>\n            <div>\n              <h3>Network</h3>\n              <p class=\"module-description\">Network sites and equipment</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;network&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">📋</span>\n            <div>\n              <h3>Work Orders</h3>\n              <p class=\"module-description\">Work order and ticket management</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;work-orders&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">📊</span>\n            <div>\n              <h3>Monitoring</h3>\n              <p class=\"module-description\">System monitoring and alerts</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;monitoring&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">💳</span>\n            <div>\n              <h3>Billing</h3>\n              <p class=\"module-description\">Billing and accounting</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;billing&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">👤</span>\n            <div>\n              <h3>User Management</h3>\n              <p class=\"module-description\">User and role management</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;users&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\">⚙️</span>\n            <div>\n              <h3>Tenant Settings</h3>\n              <p class=\"module-description\">Tenant configuration</p>\n            </div>\n          </div>\n\n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22matrix-row%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-label%22%3E%7Bcategory.charAt(0).toUpperCase()%7D%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%40const%20hasPerm%20%3D%20hasPermission(modulePerm%2C%20category%2C%20op)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22permission-cell%22%20class%3Aenabled%3D%7BhasPerm%7D%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7BhasPerm%20%3F%20'%E2%9C%93'%20%3A%20'%E2%9C%97'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n\n                  </div></div>\n              </div></div>\n          </div>\n\n          <button class=\"btn-edit\" data-cwl-action=\"editPermissions\" data-cwl-action-args=\"&quot;tenants&quot;\" aria-label=\"Edit Permissions\">\n            ✏️ Edit Permissions\n          </button>\n        </div>\n\n    </div>\n  </div>\n\n  <!-- Edit Permission Modal -->\n  <div data-cwl-bind=\"if\" data-cwl-hole-detail=\"editingModule && editingPermissions\">\n    <div class=\"modal-overlay\" data-cwl-action=\"cancelEdit\" hidden aria-hidden=\"true\">\n      <div class=\"modal-content\">\n        <div class=\"modal-header\">\n          <div>\n            <h3><span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"module?.icon\"></span> <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"module?.name\"></span></h3>\n            <p class=\"modal-subtitle\">Role: <span data-cwl-bind=\"interp\" data-cwl-hole-detail=\"ROLE_NAMES[selectedRole]\"></span></p>\n          </div>\n          <button class=\"close-btn\" data-cwl-action=\"cancelEdit\" aria-label=\"Cancel Edit\">✕</button>\n        </div>\n\n        <div class=\"modal-body\">\n          <div class=\"quick-actions\">\n            <button class=\"btn-quick\" data-cwl-action=\"toggleAllPermissions\" data-cwl-action-args=\"true\" aria-label=\"Toggle All Permissions\">\n              ✅ Grant All\n            </button>\n            <button class=\"btn-quick\" data-cwl-action=\"toggleAllPermissions\" data-cwl-action-args=\"false\" aria-label=\"Toggle All Permissions\">\n              ❌ Revoke All\n            </button>\n          </div>\n\n          <div class=\"fcaps-edit-grid\">\n            <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\" data-cwl-each-item=\"category\" data-cwl-each-tpl=\"%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22fcaps-edit-category%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-header-edit%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ch4%3E%7Bcategory.charAt(0).toUpperCase()%20%2B%20category.slice(1)%7D%3C%2Fh4%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22category-toggle%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-toggle%22%20data-cwl-action%3D%22toggleCategory%22%20data-cwl-action-args%3D%22category%2C%20true%22%20aria-label%3D%22Toggle%20Category%22%3EAll%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cbutton%20class%3D%22btn-toggle%22%20data-cwl-action%3D%22toggleCategory%22%20data-cwl-action-args%3D%22category%2C%20false%22%20aria-label%3D%22Toggle%20Category%22%3ENone%3C%2Fbutton%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22operations-checkboxes%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%23each%20FCAPS_OPERATIONS%20as%20op%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Clabel%20class%3D%22checkbox-label%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cinput%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20type%3D%22checkbox%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20checked%3D%7BeditingPermissions%5Bcategory%5D%5Bop%5D%7D%20data-cwl-on-change%3D%22action%3AtogglePermission%22%20data-cwl-on-change-args%3D%22category%2C%20op%22%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cspan%20class%3D%22operation-name%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop%20%3D%3D%3D%20'read'%20%3F%20'%F0%9F%93%96'%20%3A%20op%20%3D%3D%3D%20'write'%20%3F%20'%E2%9C%8F%EF%B8%8F'%20%3A%20'%F0%9F%97%91%EF%B8%8F'%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7Bop.charAt(0).toUpperCase()%20%2B%20op.slice(1)%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fspan%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Flabel%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%7B%2Feach%7D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20\"><div class=\"fcaps-edit-category\">\n                <div class=\"category-header-edit\">\n                  <h4></h4>\n                  <div class=\"category-toggle\">\n                    <button class=\"btn-toggle\" data-cwl-action=\"toggleCategory\" data-cwl-action-args=\"category, true\" aria-label=\"Toggle Category\">All</button>\n                    <button class=\"btn-toggle\" data-cwl-action=\"toggleCategory\" data-cwl-action-args=\"category, false\" aria-label=\"Toggle Category\">None</button>\n                  </div>\n                </div>\n                <div class=\"operations-checkboxes\">\n                  <div data-cwl-bind=\"each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\"><label class=\"checkbox-label\">\n                      <input\n                        type=\"checkbox\" data-cwl-on-change=\"action:togglePermission\" data-cwl-on-change-args=\"category, op\"\n                      />\n                      <span class=\"operation-name\">\n\n                      </span>\n                    </label></div>\n                </div>\n              </div></div>\n          </div>\n        </div>\n\n        <div class=\"modal-footer\">\n          <button class=\"btn-secondary\" data-cwl-action=\"cancelEdit\" aria-label=\"Cancel Edit\">Cancel</button>\n          <button class=\"btn-primary\" data-cwl-action=\"savePermissions\" data-cwl-attr-disabled=\"loading\" aria-label=\"Save Permissions\">\n            Save Permissions\n          </button>\n        </div>\n      </div>\n    </div></div>\n</div></div>";
}

