  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/customers/portal/login", apiPath: "/api/customers", api_ok: true, api_surface: "wisp-api-native", api_resource: "customers", api_op: "list", tracedApiStatus: 200 };
