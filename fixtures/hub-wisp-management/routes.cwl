@page GET "/modules/acs-cpe-management/graphs"
page modules_acs_cpe_management_graphs_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/graphs", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"graphs-page\">\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Page Header -->\n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <h1 class=\"page-title\">\n        <span class=\"page-icon\">📊</span>\n        Multi-Device Graphs\n      </h1>\n      <p class=\"page-description\">\n        Compare TR-069 metrics across multiple CPE devices\n      </p>\n    </div>\n    <div class=\"header-actions\">\n      <div class=\"time-range-selector\">\n        <button class=\"time-btn\">1H</button>\n        <button class=\"time-btn\">6H</button>\n        <button class=\"time-btn\">24H</button>\n        <button class=\"time-btn\">7D</button>\n      </div>\n      <button class=\"btn btn-secondary\">\n        ▶️ Auto-Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        \n          🔄\n        \n        Refresh\n      </button>\n    </div>\n  </div>\n\n  <!-- Device Selector -->\n  <div class=\"device-selector-bar\">\n    <div class=\"selector-header\">\n      <h3>Select Devices (0 selected)</h3>\n      <div class=\"selector-actions\">\n        <button class=\"btn-link\">Select All</button>\n        <button class=\"btn-link\">Deselect All</button>\n      </div>\n    </div>\n    <div class=\"device-chips\">\n      <button\n          class=\"device-chip\">\n          <span class=\"chip-status\"></span>\n          <span class=\"chip-label\"> - </span>\n        </button><button\n          class=\"device-chip\">\n          <span class=\"chip-status\"></span>\n          <span class=\"chip-label\"> - </span>\n        </button>\n    </div>\n  </div>\n\n  <!-- Graphs Content -->\n  <div class=\"content\">\n    \n      \n    \n  </div>\n</div>";
}

@page GET "/modules/acs-cpe-management/monitoring"
page modules_acs_cpe_management_monitoring_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/acs-cpe-management/monitoring", apiPath: "/api/snmp", api_ok: true, api_surface: "wisp-api-native", api_resource: "snmp-monitoring", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"monitoring-page\">\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"MainMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Page Header -->\n  <div class=\"page-header\">\n    <div class=\"header-content\">\n      <div class=\"header-top\">\n        <a href=\"/dashboard\" class=\"back-button\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n          </svg>\n          ← Back to Dashboard\n        </a>\n      </div>\n      <h1 class=\"page-title\">\n        <span class=\"page-icon\">📈</span>\n        CPE Device Monitoring (TR-069)\n      </h1>\n      <p class=\"page-description\">\n        \n      </p>\n    </div>\n    <div class=\"header-actions\">\n      <!-- Device Selector -->\n      <div class=\"device-selector\">\n        <label for=\"device-select\" class=\"selector-label\">Select CPE:</label>\n        <select \n          id=\"device-select\"\n          class=\"device-select\"\n        >\n          <option>\n               -  ()\n            </option><option>\n               -  ()\n            </option>\n        </select>\n      </div>\n      <div class=\"time-range-selector\">\n        <button \n          class=\"time-btn\"\n        >\n          1H\n        </button>\n        <button \n          class=\"time-btn\"\n        >\n          6H\n        </button>\n        <button \n          class=\"time-btn\"\n        >\n          24H\n        </button>\n        <button \n          class=\"time-btn\"\n        >\n          7D\n        </button>\n      </div>\n      <button \n        class=\"btn btn-secondary\"\n      >\n        <span class=\"btn-icon\">▶️</span>\n        Auto-Refresh OFF\n      </button>\n      <button class=\"btn btn-primary\">\n        \n          <span class=\"btn-icon\">🔄</span>\n        \n        Refresh\n      </button>\n    </div>\n  </div>\n\n  \n\n  <div class=\"content\">\n    \n      <!-- KPI Cards -->\n      <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"LTEKPICards\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>rssi</td><td>-72</td></tr><tr><td>sinr</td><td>18</td></tr><tr><td>uptimeHours</td><td>120</td></tr></tbody></table></div>\n\n      <!-- TR-069 Cellular Parameters Section -->\n      <div class=\"section-header\">\n        <h2>TR-069 Cellular Interface Metrics - No Device Selected</h2>\n        <p class=\"section-description\">\n          Real-time monitoring of Device.Cellular.Interface parameters from selected CPE device\n        </p>\n      </div>\n\n      <!-- Charts Grid -->\n      <div class=\"charts-grid\">\n        <div class=\"cwl-chart-shell\" data-cwl-chart-shell=\"TR069RSSIChart\" aria-hidden=\"true\" role=\"img\"></div>\n        <div class=\"cwl-chart-shell\" data-cwl-chart-shell=\"LTESignalChart\" aria-hidden=\"true\" role=\"img\"></div>\n        <div class=\"cwl-chart-shell\" data-cwl-chart-shell=\"TR069SINRChart\" aria-hidden=\"true\" role=\"img\"></div>\n        <div class=\"cwl-chart-shell\" data-cwl-chart-shell=\"TR069PCIChart\" aria-hidden=\"true\" role=\"img\"></div>\n        <div class=\"cwl-chart-shell\" data-cwl-chart-shell=\"TR069EARFCNChart\" aria-hidden=\"true\" role=\"img\"></div>\n        <div class=\"cwl-chart-shell\" data-cwl-chart-shell=\"TR069UptimeChart\" aria-hidden=\"true\" role=\"img\"></div>\n      </div>\n\n      <!-- Network Health Summary -->\n      <div class=\"health-summary\">\n        <h2>TR-069 Network Summary</h2>\n        <div class=\"summary-grid\">\n          <div class=\"summary-item\">\n            <span class=\"summary-label\">Average RSSI:</span>\n            <span class=\"summary-value\"> dBm</span>\n          </div>\n          <div class=\"summary-item\">\n            <span class=\"summary-label\">Average RSRP:</span>\n            <span class=\"summary-value\"> dBm</span>\n          </div>\n          <div class=\"summary-item\">\n            <span class=\"summary-label\">Average SINR:</span>\n            <span class=\"summary-value\"> dB</span>\n          </div>\n          <div class=\"summary-item\">\n            <span class=\"summary-label\">Current PCI:</span>\n            <span class=\"summary-value\"></span>\n          </div>\n          <div class=\"summary-item\">\n            <span class=\"summary-label\">Current EARFCN:</span>\n            <span class=\"summary-value\"></span>\n          </div>\n          <div class=\"summary-item\">\n            <span class=\"summary-label\">Connection Status:</span>\n            <span class=\"summary-value\"></span>\n          </div>\n        </div>\n        \n        <div class=\"tr069-info\">\n          <h3>📋 TR-069 Parameter Paths</h3>\n          <div class=\"path-grid\">\n            <code>Device.Cellular.Interface.1.RSSI</code>\n            <code>Device.Cellular.Interface.1.RSRP</code>\n            <code>Device.Cellular.Interface.1.RSRQ</code>\n            <code>Device.Cellular.Interface.1.SINR</code>\n            <code>Device.Cellular.Interface.1.X_VENDOR_PhysicalCellID</code>\n            <code>Device.Cellular.Interface.1.X_VENDOR_EARFCN</code>\n            <code>Device.DeviceInfo.UpTime</code>\n          </div>\n        </div>\n      </div>\n    \n  </div>\n</div>";
}

