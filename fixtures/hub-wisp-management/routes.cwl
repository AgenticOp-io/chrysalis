@page GET "/modules/tenant-management/users"
page modules_tenant_management_users_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/tenant-management/users", apiPath: "/api/tenants", api_ok: true, api_surface: "wisp-api-native", api_resource: "tenants", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"users-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to Tenant Settings\n      </button>\n      <h1>👥 User Management</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-buttons\">\n      <button class=\"btn-primary\">\n        ➕ Add User\n      </button>\n    </div>\n  </div>\n\n  \n\n  \n\n  \n\n  <div class=\"users-section\">\n    <h2>Organization Users (<span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"users.length\"></span>)</h2>\n\n    \n      <div class=\"users-table\">\n        <table>\n          <thead>\n            <tr>\n              <th>User</th>\n              <th>Role</th>\n              <th>Added</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"users as user\"><tr>\n                <td>\n                  <div class=\"user-cell\">\n                    <span class=\"user-icon\">👤</span>\n                    <span></span>\n                  </div>\n                </td>\n                <td>\n                  <select>\n                    <option value=\"owner\">Owner</option>\n                    <option value=\"admin\">Admin</option>\n                    <option value=\"operator\">Operator</option>\n                    <option value=\"viewer\">Viewer</option>\n                  </select>\n                </td>\n                <td>\n                  \n                </td>\n                <td>\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"user.role !== 'owner'\"><button \n                      class=\"btn-danger-small\"\n                    >\n                      Remove\n                    </button></div>\n                </td>\n              </tr></div>\n          </tbody>\n        </table>\n      </div>\n    \n  </div>\n</div>";
}

@page GET "/modules/user-management"
page modules_user_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/user-management", apiPath: "/api/users", api_ok: true, api_surface: "wisp-api-native", api_resource: "users", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"user-management-container\">\n  <div class=\"header\">\n    <button class=\"btn-back\">\n      ← Back to Modules\n    </button>\n    \n    <div class=\"title-section\">\n      <h1>👥 User Management</h1>\n      <p class=\"subtitle\">\n        \n          Manage all users across all organizations\n        \n      </p>\n    </div>\n    \n    \n  </div>\n\n  \n\n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search by name or email...\"\n      />\n    </div>\n\n    <select class=\"select\">\n      <option value=\"all\">All Roles</option>\n      <option value=\"owner\">Owner</option>\n      <option value=\"admin\">Admin</option>\n      <option value=\"engineer\">Engineer</option>\n      <option value=\"installer\">Field Technician</option>\n      <option value=\"helpdesk\">Help Desk</option>\n      <option value=\"viewer\">Viewer</option>\n    </select>\n\n    <select class=\"select\">\n      <option value=\"all\">All Status</option>\n      <option value=\"active\">Active</option>\n      <option value=\"suspended\">Suspended</option>\n      <option value=\"pending_invitation\">Pending</option>\n    </select>\n\n    <div class=\"results-count\">\n      <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"filteredUsers.length\"></span> of 2 users\n    </div>\n  </div>\n\n  \n    <div class=\"table-container\">\n      <table class=\"user-table\">\n        <thead>\n          <tr>\n            <th>User</th>\n            <th>Role</th>\n            <th>Status</th>\n            <th>Last Login</th>\n            <th>Added</th>\n            \n          </tr>\n        </thead>\n        <tbody>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"filteredUsers as user (user.uid)\"><tr>\n              <td>\n                <div class=\"user-cell\">\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"user.photoURL\"><img class=\"user-avatar\" /></div>\n                  <div class=\"user-info\">\n                    <div class=\"user-name\"></div>\n                    <div class=\"user-email\"></div>\n                  </div>\n                </div>\n              </td>\n              <td>\n                <span class=\"badge \">\n                  \n                </span>\n              </td>\n              <td>\n                <span class=\"badge \">\n                  \n                </span>\n              </td>\n              <td class=\"time-cell\">\n                \n              </td>\n              <td class=\"time-cell\">\n                \n              </td>\n              \n            </tr></div>\n        </tbody>\n      </table>\n    </div>\n  \n</div>\n\n\n\n";
}

@page GET "/modules/user-management/permissions"
page modules_user_management_permissions_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/user-management/permissions", apiPath: "/api/users", api_ok: true, api_surface: "wisp-api-native", api_resource: "users", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"permissions-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"btn-back\">\n        ← Back\n      </button>\n      <div>\n        <h1>🔐 FCAPS Permission Management</h1>\n        <p class=\"subtitle\">Manage Fault, Configuration, Accounting, Performance, and Security permissions</p>\n      </div>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Permission Type Selector -->\n  <div class=\"permission-type-selector\">\n    <button\n      class=\"type-btn\"\n    >\n      👥 Role Permissions\n    </button>\n    <button\n      class=\"type-btn\"\n    >\n      👤 User Permissions\n    </button>\n  </div>\n\n  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"permissionType === 'role'\"><!-- Role Permissions -->\n    <div class=\"permissions-section\">\n      <div class=\"section-header\">\n        <h2>Role Permissions</h2>\n        <select>\n          <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"ROLES as role\"><option></option></div>\n        </select>\n      </div>\n\n      <div class=\"modules-grid\">\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"MODULES as module\">\n          <div class=\"module-card\">\n            <div class=\"module-header\">\n              <h3></h3>\n              <p class=\"module-description\"></p>\n            </div>\n            \n            <div class=\"fcaps-permissions\">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\"><div class=\"fcaps-category\">\n                  <div class=\"category-header\">\n                    <strong></strong>\n                  </div>\n                  <div class=\"operations\">\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                      <span class=\"operation-badge\">\n                        \n                      </span></div>\n                  </div>\n                </div></div>\n            </div>\n            \n            <button class=\"btn-edit\">\n              ✏️ Edit\n            </button>\n          </div></div>\n      </div>\n    </div></div>\n\n  <!-- Edit Permission Modal -->\n  \n</div>";
}

@page GET "/modules/user-management/roles"
page modules_user_management_roles_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/user-management/roles", apiPath: "/api/users", api_ok: true, api_surface: "wisp-api-native", api_resource: "users", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"role-management-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"btn-back\">\n        ← Back\n      </button>\n      <div>\n        <h1>👥 Role Management</h1>\n        <p class=\"subtitle\">Define FCAPS permissions (Fault, Configuration, Accounting, Performance, Security) for each role</p>\n      </div>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Role Selector -->\n  <div class=\"role-selector-section\">\n    <h2>Select Role</h2>\n    <div class=\"role-tabs\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"EDITABLE_ROLES as role\"><button\n          class=\"role-tab\" style=\"border-color: \"\n        >\n          <span class=\"role-icon\"></span>\n          <span class=\"role-name\"></span>\n        </button></div>\n    </div>\n    \n  </div>\n\n  <!-- FCAPS Legend -->\n  <div class=\"fcaps-legend\">\n    <h3>FCAPS Categories:</h3>\n    <div class=\"legend-items\">\n      <div class=\"legend-item\">\n        <strong>F</strong> - <span>Fault:</span> Monitoring, alarms, error handling\n      </div>\n      <div class=\"legend-item\">\n        <strong>C</strong> - <span>Configuration:</span> Settings, changes, management\n      </div>\n      <div class=\"legend-item\">\n        <strong>A</strong> - <span>Accounting:</span> Billing, usage tracking\n      </div>\n      <div class=\"legend-item\">\n        <strong>P</strong> - <span>Performance:</span> Metrics, analytics, monitoring\n      </div>\n      <div class=\"legend-item\">\n        <strong>S</strong> - <span>Security:</span> Access control, authentication\n      </div>\n    </div>\n    <div class=\"operations-legend\">\n      <strong>Operations:</strong> <span class=\"badge\">R</span> = Read, <span class=\"badge\">W</span> = Write, <span class=\"badge\">D</span> = Delete\n    </div>\n  </div>\n\n  <!-- Modules Grid -->\n  <div class=\"modules-section\">\n    <h2>Module Permissions for <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"ROLE_NAMES[selectedRole]\"></span></h2>\n    <div class=\"modules-grid\">\n      <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"MODULES as module\">\n        <div class=\"module-card\">\n          <div class=\"module-header\">\n            <span class=\"module-icon\"></span>\n            <div>\n              <h3></h3>\n              <p class=\"module-description\"></p>\n            </div>\n          </div>\n          \n          <div class=\"fcaps-matrix\">\n            <div class=\"matrix-header\">\n              <div class=\"category-col\"></div>\n              <div class=\"operation-col\">R</div>\n              <div class=\"operation-col\">W</div>\n              <div class=\"operation-col\">D</div>\n            </div>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"FCAPS_CATEGORIES as category\"><div class=\"matrix-row\">\n                <div class=\"category-label\"></div>\n                <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"FCAPS_OPERATIONS as op\">\n                  <div class=\"permission-cell\">\n                    \n                  </div></div>\n              </div></div>\n          </div>\n          \n          <button class=\"btn-edit\">\n            ✏️ Edit Permissions\n          </button>\n        </div></div>\n    </div>\n  </div>\n\n  <!-- Edit Permission Modal -->\n  \n</div>";
}

@page GET "/modules/voice-telephony"
page modules_voice_telephony_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/voice-telephony", apiPath: "/api/voice", api_ok: true, api_surface: "wisp-api-native", api_resource: "voice", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"voice-page\">\\r\n    <header class=\"page-head\">\\r\n      <div class=\"page-head-row\">\\r\n        <h1>Voice / SIP & UC</h1>\\r\n        <div class=\"page-toolbar\">\\r\n          <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav>\\r\n          <button type=\"button\" class=\"btn tips-btn\">Tips</button>\\r\n        </div>\\r\n      </div>\\r\n      <p class=\"sub\">\\r\n        Tenant-scoped numbers, carrier accounts, E911, and porting. Webhook ingress:\\r\n        <code>POST /api/voice/webhooks/:provider</code> (HMAC when <code>VOICE_WEBHOOK_SECRET</code> is set).\\r\n        Customer records link via <code>customerId</code> (same id as Customers module).\\r\n      </p>\\r\n    </header>\\r\n\\r\n    <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> (showTipsModal = false)} />\\r\n\\r\n    \\r\n\\r\n    \\r\n\\r\n    <nav class=\"tabs\">\\r\n      <button type=\"button\">Overview</button>\\r\n      <button type=\"button\">Provider accounts</button>\\r\n      <button type=\"button\">Numbers</button>\\r\n      <button type=\"button\">Port orders</button>\\r\n      <button type=\"button\">Service locations</button>\\r\n    </nav>\\r\n\\r\n    \\r\n      <section class=\"panel\">\\r\n        <div class=\"row\">\\r\n          <h2>Service locations (E911 / geocode)</h2>\\r\n          <button type=\"button\" class=\"btn primary\">Add location</button>\\r\n        </div>\\r\n        <p class=\"muted small\">\\r\n          Use the same <code>customerId</code> as the Customers module to tie addresses together. Coverage Map opens centered on\\r\n          coordinates when available.\\r\n        </p>\\r\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"locations.length === 0\"><p class=\"muted\">No service locations yet. Add one above.</p></div>\\r\n      </section>\\r\n    \\r\n  </div>\\r\n\\r\n  \\r\n\\r\n  \\r\n\\r\n  \\r\n\\r\n  ";
}

@page GET "/modules/work-orders"
page modules_work_orders_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/work-orders", apiPath: "/api/work-orders", api_ok: true, api_surface: "wisp-api-native", api_resource: "work-orders", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"work-orders-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📋 Work Orders & Tickets</h1>\n      <p class=\"subtitle\">Field operations and trouble ticket management</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn-secondary\">\n        ➕ Quick Create\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> true}\n      />\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📋</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">2</div>\n        <div class=\"stat-label\">Total Tickets</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🔓</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.totalOpen\"></span></div>\n        <div class=\"stat-label\">Open</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⚡</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrders.filter(wo => wo.priority === 'critical' || wo.priority === 'high').le\"></span>\n        </div>\n        <div class=\"stat-label\">High Priority</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">⏱️</div>\n      <div class=\"stat-content\">\n        <div class=\"stat-value\">\n          <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"stats.avgResolutionTime ? Math.round(stats.avgResolutionTime) : 0\"></span>h\n        </div>\n        <div class=\"stat-label\">Avg Resolution</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Priorities</option>\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"priorities as priority\"><option></option></div>\n      </select>\n      \n      <select>\n        <option>All Types</option>\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"types as type\"><option></option></div>\n      </select>\n      \n      <button class=\"btn-secondary\">\n        Clear Filters\n      </button>\n    </div>\n  </div>\n  \n  <!-- Work Orders List -->\n  \n    <div class=\"work-orders-grid\">\n      <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"WorkOrderCard\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>wo-1</td><td>open</td></tr><tr><td>wo-2</td><td>scheduled</td></tr></tbody></table></div> goto(`/modules/work-orders/$`)}/><div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"WorkOrderCard\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>wo-1</td><td>open</td></tr><tr><td>wo-2</td><td>scheduled</td></tr></tbody></table></div> goto(`/modules/work-orders/$`)}/>\n      \n      \n    </div>\n  \n  \n  <!-- Create Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"CreateWorkOrderModal\" aria-hidden=\"true\" role=\"dialog\"></div>\n  \n  <!-- Work Order Creation Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"WorkOrderCreationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showWorkOrderWizard = false;\n      loadData(); // Refresh work orders after crea\"></span>}\n  />\n</div>";
}

@page GET "/modules/work-orders/:id"
page modules_work_orders_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/work-orders/:id", apiPath: "/api/work-orders", api_ok: true, api_surface: "wisp-api-native", api_resource: "work-orders", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"work-order-details\">\n  <div class=\"page-header\">\n    <button class=\"back-button\">\n      ← Back to Work Orders\n    </button>\n    \n    \n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  \n    <div class=\"content-grid\">\n      <!-- Main Content -->\n      <div class=\"main-column\">\n        <!-- Description -->\n        <div class=\"card\">\n          <h3>📋 Description</h3>\n          <p class=\"description\">No description provided</p>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.symptoms\"><h4>Symptoms:</h4>\n            <p class=\"symptoms\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.symptoms\"></span></p></div>\n        </div>\n        \n        <!-- Location -->\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.location\"><div class=\"card\">\n            <h3>📍 Location</h3>\n            <div class=\"info-grid\">\n              <div class=\"info-item\">\n                <span class=\"info-label\">Type:</span>\n                <span class=\"info-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.location.type\"></span></span>\n              </div>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.location.siteName\"><div class=\"info-item\">\n                  <span class=\"info-label\">Site:</span>\n                  <span class=\"info-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.location.siteName\"></span></span>\n                </div></div>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.location.address\"><div class=\"info-item\">\n                  <span class=\"info-label\">Address:</span>\n                  <span class=\"info-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.location.address\"></span></span>\n                </div></div>\n            </div>\n          </div></div>\n        \n        <!-- Customer Info -->\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.customerReported && workOrder.customerContact\"><div class=\"card\">\n            <h3>👤 Customer Information</h3>\n            <div class=\"info-grid\">\n              <div class=\"info-item\">\n                <span class=\"info-label\">Name:</span>\n                <span class=\"info-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.customerContact.name\"></span></span>\n              </div>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.customerContact.phone\"><div class=\"info-item\">\n                  <span class=\"info-label\">Phone:</span>\n                  <span class=\"info-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.customerContact.phone\"></span></span>\n                </div></div>\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.customerContact.email\"><div class=\"info-item\">\n                  <span class=\"info-label\">Email:</span>\n                  <span class=\"info-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.customerContact.email\"></span></span>\n                </div></div>\n            </div>\n          </div></div>\n        \n        <!-- Resolution -->\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.resolution\"><div class=\"card\">\n            <h3>✅ Resolution</h3>\n            <p class=\"resolution\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.resolution\"></span></p>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.rootCause\"><h4>Root Cause:</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.rootCause\"></span></p></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.preventiveMeasures\"><h4>Preventive Measures:</h4>\n              <p><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.preventiveMeasures\"></span></p></div>\n          </div></div>\n        \n        <!-- Work Log -->\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.workPerformed && workOrder.workPerformed.length > 0\"><div class=\"card\">\n            <h3>📝 Work Log</h3>\n            <div class=\"work-log\">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"workOrder.workPerformed as entry\"><div class=\"log-entry\">\n                  <div class=\"log-header\">\n                    <span class=\"log-time\"></span>\n                    <span class=\"log-user\"></span>\n                  </div>\n                  <p class=\"log-action\"></p>\n                  <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"entry.notes\"><p class=\"log-notes\"></p></div>\n                </div></div>\n            </div>\n          </div></div>\n      </div>\n      \n      <!-- Sidebar -->\n      <div class=\"sidebar-column\">\n        <!-- Actions -->\n        <div class=\"card actions-card\">\n          <h3>⚡ Quick Actions</h3>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.status === 'open' || workOrder.status === 'assigned'\"><button \n              class=\"action-btn start-btn\"\n            >\n              ▶️ Start Work\n            </button></div>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.status === 'in-progress'\"><button \n              class=\"action-btn complete-btn\"\n            >\n              ✅ Mark Complete\n            </button></div>\n          \n          <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.status === 'resolved'\"><button \n              class=\"action-btn\"\n            >\n              🔒 Close Ticket\n            </button></div>\n          \n          <button \n            class=\"action-btn secondary-btn\"\n          >\n            ✏️ Edit Details\n          </button>\n        </div>\n        \n        <!-- Details -->\n        <div class=\"card\">\n          <h3>ℹ️ Details</h3>\n          \n          <div class=\"detail-list\">\n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Type:</span>\n              <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.type\"></span></span>\n            </div>\n            \n            <div class=\"detail-item\">\n              <span class=\"detail-label\">Created:</span>\n              <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.createdAt)\"></span></span>\n            </div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.createdByName\"><div class=\"detail-item\">\n                <span class=\"detail-label\">Created By:</span>\n                <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.createdByName\"></span></span>\n              </div></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.assignedToName\"><div class=\"detail-item\">\n                <span class=\"detail-label\">Assigned To:</span>\n                <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.assignedToName\"></span></span>\n              </div></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.scheduledDate\"><div class=\"detail-item\">\n                <span class=\"detail-label\">Scheduled:</span>\n                <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.scheduledDate)\"></span></span>\n              </div></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.estimatedDuration\"><div class=\"detail-item\">\n                <span class=\"detail-label\">Est. Duration:</span>\n                <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"workOrder.estimatedDuration\"></span> min</span>\n              </div></div>\n          </div>\n        </div>\n        \n        <!-- SLA -->\n        <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.sla\"><div class=\"card\">\n            <h3>⏱️ SLA</h3>\n            \n            <div class=\"detail-list\">\n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.sla.responseDeadline\"><div class=\"detail-item\">\n                  <span class=\"detail-label\">Response By:</span>\n                  <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.sla.responseDeadline)\"></span></span>\n                </div></div>\n              \n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.sla.resolutionDeadline\"><div class=\"detail-item\">\n                  <span class=\"detail-label\">Resolve By:</span>\n                  <span class=\"detail-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.sla.resolutionDeadline)\"></span></span>\n                </div></div>\n              \n              <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.sla.breached\"><div class=\"sla-warning\">\n                  ⚠️ SLA Breached\n                </div></div>\n            </div>\n          </div></div>\n        \n        <!-- Timeline -->\n        <div class=\"card\">\n          <h3>📅 Timeline</h3>\n          \n          <div class=\"timeline\">\n            <div class=\"timeline-item\">\n              <span class=\"timeline-icon\">📝</span>\n              <div class=\"timeline-content\">\n                <span class=\"timeline-label\">Created</span>\n                <span class=\"timeline-time\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.createdAt)\"></span></span>\n              </div>\n            </div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.assignedAt\"><div class=\"timeline-item\">\n                <span class=\"timeline-icon\">👤</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Assigned</span>\n                  <span class=\"timeline-time\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.assignedAt)\"></span></span>\n                </div>\n              </div></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.startedAt\"><div class=\"timeline-item\">\n                <span class=\"timeline-icon\">▶️</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Started</span>\n                  <span class=\"timeline-time\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.startedAt)\"></span></span>\n                </div>\n              </div></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.completedAt\"><div class=\"timeline-item\">\n                <span class=\"timeline-icon\">✅</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Completed</span>\n                  <span class=\"timeline-time\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.completedAt)\"></span></span>\n                </div>\n              </div></div>\n            \n            <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"workOrder.closedAt\"><div class=\"timeline-item\">\n                <span class=\"timeline-icon\">🔒</span>\n                <div class=\"timeline-content\">\n                  <span class=\"timeline-label\">Closed</span>\n                  <span class=\"timeline-time\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"formatDateTime(workOrder.closedAt)\"></span></span>\n                </div>\n              </div></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  \n</div>";
}

@page GET "/oauth/google/callback"
page oauth_google_callback_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/oauth/google/callback" };
  return html "<div class=\"callback-page\">\n  <div class=\"callback-card\">\n    <div class=\"callback-icon\">\n      \n        🔄\n      \n    </div>\n    \n    <h2><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"status\"></span></h2>\n    \n    \n      <div class=\"loading-spinner\"></div>\n    \n  </div>\n</div>";
}

