# Chrysalis Web Language — hub emit from svelte
module hub;

@page GET "/"
page root_page {
  effects: none;
  content-type "text/html; charset=utf-8";
  return html "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta http-equiv=\"refresh\" content=\"0;url=/login\"><title>Checking authentication…</title></head><body><p>Checking authentication…</p><script>location.replace(\"/login\");</script><noscript><a href=\"/login\">Continue</a></noscript></body></html>";
}

@page GET "/admin/billing"
page admin_billing_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { adminArea: "billing", source: "wisp-m2", apiPrefix: "/api/admin" };
  return html "<svelte:head>\n  <title>Billing – WISP Admin</title>\n</svelte:head>\n\n<div class=\"admin-shell\">\n  <nav class=\"admin-nav\">\n  <a href=\"/admin/management\">Management</a>\n  <a href=\"/admin/billing\">Billing</a>\n  <a href=\"/admin/system-management\">System</a>\n  <a href=\"/admin/tenant-management\">Tenants</a>\n  <a href=\"/dashboard\">← Dashboard</a>\n</nav>\n  <header>\n    <h1>Billing</h1>\n    <p class=\"admin-area\">Area: billing</p>\n    <p class=\"api-surface\">API: /api/admin (proxied upstream)</p>\n  </header>\n  <p class=\"ui-hole-note\">Interactive admin widgets remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/admin/management"
page admin_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { adminArea: "management", source: "wisp-m2", apiPrefix: "/api/admin" };
  return html "<svelte:head>\n  <title>Management – WISP Admin</title>\n</svelte:head>\n\n<div class=\"admin-shell\">\n  <nav class=\"admin-nav\">\n  <a href=\"/admin/management\">Management</a>\n  <a href=\"/admin/billing\">Billing</a>\n  <a href=\"/admin/system-management\">System</a>\n  <a href=\"/admin/tenant-management\">Tenants</a>\n  <a href=\"/dashboard\">← Dashboard</a>\n</nav>\n  <header>\n    <h1>Management</h1>\n    <p class=\"admin-area\">Area: management</p>\n    <p class=\"api-surface\">API: /api/admin (proxied upstream)</p>\n  </header>\n  <p class=\"ui-hole-note\">Interactive admin widgets remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/admin/system-management"
page admin_system_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { adminArea: "system-management", source: "wisp-m2", apiPrefix: "/api/admin" };
  return html "<svelte:head>\n  <title>System Management – WISP Admin</title>\n</svelte:head>\n\n<div class=\"admin-shell\">\n  <nav class=\"admin-nav\">\n  <a href=\"/admin/management\">Management</a>\n  <a href=\"/admin/billing\">Billing</a>\n  <a href=\"/admin/system-management\">System</a>\n  <a href=\"/admin/tenant-management\">Tenants</a>\n  <a href=\"/dashboard\">← Dashboard</a>\n</nav>\n  <header>\n    <h1>System Management</h1>\n    <p class=\"admin-area\">Area: system-management</p>\n    <p class=\"api-surface\">API: /api/admin (proxied upstream)</p>\n  </header>\n  <p class=\"ui-hole-note\">Interactive admin widgets remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/admin/tenant-management"
page admin_tenant_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { adminArea: "tenant-management", source: "wisp-m2", apiPrefix: "/api/admin" };
  return html "<svelte:head>\n  <title>Tenant Management – WISP Admin</title>\n</svelte:head>\n\n<div class=\"admin-shell\">\n  <nav class=\"admin-nav\">\n  <a href=\"/admin/management\">Management</a>\n  <a href=\"/admin/billing\">Billing</a>\n  <a href=\"/admin/system-management\">System</a>\n  <a href=\"/admin/tenant-management\">Tenants</a>\n  <a href=\"/dashboard\">← Dashboard</a>\n</nav>\n  <header>\n    <h1>Tenant Management</h1>\n    <p class=\"admin-area\">Area: tenant-management</p>\n    <p class=\"api-surface\">API: /api/admin (proxied upstream)</p>\n  </header>\n  <p class=\"ui-hole-note\">Interactive admin widgets remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/admin/tenants/:tenantId/modules"
page admin_tenants_tenantId_modules_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { adminArea: "tenant-modules", source: "wisp-m2", apiPrefix: "/api/admin" };
  return html "<svelte:head>\n  <title>Tenant Modules – WISP Admin</title>\n</svelte:head>\n\n<div class=\"admin-shell\">\n  <nav class=\"admin-nav\">\n  <a href=\"/admin/management\">Management</a>\n  <a href=\"/admin/billing\">Billing</a>\n  <a href=\"/admin/system-management\">System</a>\n  <a href=\"/admin/tenant-management\">Tenants</a>\n  <a href=\"/dashboard\">← Dashboard</a>\n</nav>\n  <header>\n    <h1>Tenant Modules</h1>\n    <p class=\"admin-area\">Area: tenant-modules</p>\n    <p class=\"api-surface\">API: /api/admin (proxied upstream)</p>\n  </header>\n  <p class=\"ui-hole-note\">Interactive admin widgets remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/auth/google/callback"
page auth_google_callback_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/auth/google/callback" };
  return html "<div class=\"callback-page\">\\r\n  <div class=\"callback-card\">\\r\n    <div class=\"callback-icon\">\\r\n      \\r\n        🔄\\r\n      \\r\n    </div>\\r\n    \\r\n    <h2>active</h2>\\r\n    \\r\n    \\r\n      <div class=\"loading-spinner\"></div>\\r\n    \\r\n  </div>\\r\n</div>";
}

@page GET "/dashboard"
page dashboard_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { tenantLabel: "WISP Tenant", source: "wisp-m1", moduleCount: 6 };
  return html "<svelte:head>\n  <title>Dashboard – WISP Management</title>\n</svelte:head>\n\n<div class=\"dashboard-shell\">\n  <header>\n    <h1>Dashboard</h1>\n    <p class=\"tenant\">Tenant: tenantLabel</p>\n  </header>\n  <section class=\"modules\">\n    <h2>Modules</h2>\n    <ul>\n      <li><a href=\"/modules/plan\">Plan</a> – coverage and site planning</li>\n      <li><a href=\"/modules/deploy\">Deploy</a> – rollouts and work orders</li>\n      <li><a href=\"/modules/monitor\">Monitor</a> – SNMP and performance</li>\n      <li><a href=\"/modules/maintain\">Maintain</a> – tickets and maintenance</li>\n      <li><a href=\"/modules/customers\">Customers</a> – CRM and portal</li>\n      <li><a href=\"/modules/hardware\">Hardware</a> – inventory and RMA</li>\n    </ul>\n  </section>\n  <section class=\"wizards\">\n    <p><a href=\"/wizards\">Wizards</a> – guided flows</p>\n  </section>\n  <p class=\"ui-hole-note\">Interactive widgets (tenant guard, notifications, module cards, settings) remain <code>hub-svelte:page-component</code> until CWL UI RFC-0012.</p>\n</div>";
}

@page GET "/debug-tenants"
page debug_tenants_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/debug-tenants" };
  return html "<div class=\"debug-container\">\n  <h1>Tenant Debug Information</h1>\n  \n  <div class=\"debug-section\">\n    <h2>Authentication Status</h2>\n    <p><strong>Is Authenticated:</strong> true</p>\n    <p><strong>User Email:</strong> demo@wisptools.io</p>\n    <p><strong>User UID:</strong> u1</p>\n  </div>\n\n  <div class=\"debug-section\">\n    <h2>Tenant Store State</h2>\n    <pre>{\"id\":\"t1\"}</pre>\n  </div>\n\n  <div class=\"debug-section\">\n    <h2>User Tenants (Direct API Call)</h2>\n    <p><strong>Count:</strong> 1</p>\n    <pre>[{\"id\":\"t1\"}]</pre>\n  </div>\n\n  \n</div>";
}

@page GET "/demo"
page demo_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/demo" };
  return html "<div class=\"wrap\">\n    <header class=\"hero\">\n      <h1>Demo walkthrough</h1>\n      <p class=\"lead\">\n        Seeded records use prefixes <code>CUST-DEMO-*</code>, <code>TKT-DEMO-*</code>,\n        <code>INC-DEMO-*</code>, <code>DEMO-SN-*</code>. Prefer editing and resolving over deleting.\n        Use one pre-provisioned demo login — see the operator runbook in the repo.\n      </p>\n      <p class=\"tenant\">\n          Organization: <strong>Demo Tenant</strong>\n          <span class=\"muted\">(t1)</span>\n        </p>\n    </header>\n\n    <div class=\"grid\">\n      <a class=\"card\">\n          <h2></h2>\n          <p></p>\n          \n        </a>\n    </div>\n\n    <section class=\"doc\">\n      <h2>Documentation (repository)</h2>\n      <ul>\n        <li>\n          Demo visitor (IP login, limits, purge on logout):\n          <code>docs/deployment/DEMO_VISITOR.md</code>\n        </li>\n        <li>\n          Operator runbook (logins, isolation, feature matrix, reset policy):\n          <code>docs/deployment/DEMO_RUNBOOK.md</code>\n        </li>\n        <li>\n          Seed &amp; env:\n          <code>scripts/demo/README.md</code>\n        </li>\n        <li>\n          Deploy:\n          <code>docs/deployment/DEMO_SITE.md</code>\n        </li>\n      </ul>\n    </section>\n  </div>";
}

@page GET "/docs"
page docs_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/docs" };
  return html "<div class=\"wisp-docs-shell wisp-demo-content\" data-wisp-page=\"docs\" data-wisp-path=\"/docs\" data-cwl-island=\"client\" data-wisp-layout=\"docs\">\n  <header class=\"wisp-docs-topbar\">\n    <nav class=\"wisp-docs-crumb\" aria-label=\"Documentation\">\n      <a href=\"/dashboard\">Dashboard</a>\n      <span aria-hidden=\"true\">/</span>\n      <a href=\"/help\">Help</a>\n      <span aria-hidden=\"true\">/</span>\n      <span>Docs</span>\n    </nav>\n  </header>\n  <main class=\"wisp-docs-main\">\n    <div class=\"wisp-docs-body\">\n  <section class=\"wisp-docs-hero\">\n    <p class=\"wisp-docs-eyebrow\">Documentation</p>\n    <h2>Operator documentation</h2>\n    <p class=\"wisp-docs-lead\">Migration OS, CLI, Translation Hub, governance, and WISP showcase programs.</p>\n    <p class=\"wisp-docs-inline-links\"><a href=\"/help\">Help home</a> · <a href=\"/dashboard\">Dashboard</a></p>\n  </section>\n  <section class=\"wisp-docs-section\">\n    <h3 class=\"wisp-docs-section-title\">Topics on this demo</h3>\n    <div class=\"wisp-docs-quick-grid\">\n  <a class=\"wisp-docs-quick-card\" href=\"/docs/getting-started\">\n    <span class=\"wisp-docs-quick-label\">Getting started</span>\n    <span class=\"wisp-docs-quick-desc\">Install Chrysalis and run your first verify loop</span>\n  </a>\n  <a class=\"wisp-docs-quick-card\" href=\"/docs/deployment\">\n    <span class=\"wisp-docs-quick-label\">Deployment</span>\n    <span class=\"wisp-docs-quick-desc\">GCE hub deploy, WISP chimera, operator refresh</span>\n  </a>\n  <a class=\"wisp-docs-quick-card\" href=\"/docs/reference/project-status\">\n    <span class=\"wisp-docs-quick-label\">Project status</span>\n    <span class=\"wisp-docs-quick-desc\">Maintenance queue and honest product gaps</span>\n  </a>\n  <a class=\"wisp-docs-quick-card\" href=\"https://hub.agenticop.io/#/guide?doc=migration-os\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"wisp-docs-quick-label\">Migration OS</span>\n    <span class=\"wisp-docs-quick-desc\">Primary operator entry on the Translation Hub</span>\n  </a>\n</div>\n  </section>\n  <section class=\"wisp-docs-section\">\n    <h3 class=\"wisp-docs-section-title\">Full library</h3>\n    <div class=\"wisp-docs-library\">\n<div class=\"wisp-docs-library-head\">\n<p class=\"wisp-docs-library-lead\">Browse on this page or open the full reader on the Translation Hub.</p>\n<a class=\"wisp-docs-hub-cta\" href=\"https://hub.agenticop.io/#/guide\" target=\"_blank\" rel=\"noopener\">Open full library in Translation Hub</a>\n</div>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Migration OS</span><span class=\"wisp-docs-count\">15</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=migration-os\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Migration OS</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=site-to-cwl-llm\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Site → CWL → LLM</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=site-port-federation\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Verified Migration Federation</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=migration-evidence\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Migration Evidence POC</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=intelligence-shorthand\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Intelligence Shorthand</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=intelligence-shorthand-protocol\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">IS runtime protocol</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=open-web-llm\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Open web-LLM program</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=open-web-llm-poc\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Web-LLM agent POC</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=llm-assisted-convert\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">LLM-assisted convert</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=llm-convert-full\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">LLM convert full program</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=full-matrix-oracle\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Full matrix oracle</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=web-llm-training\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Web-LLM training recipe</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=web-verify-benchmark\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Web Verify Benchmark (WVB)</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=cwl\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">CWL overview</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=cwl-rfc\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">CWL RFC index</span><span class=\"wisp-docs-card-meta\">Migration OS</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Hub</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=hub-install\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Demo install &amp; walkthrough</span><span class=\"wisp-docs-card-meta\">Hub</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=hub-connectivity\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">SSH &amp; connectivity</span><span class=\"wisp-docs-card-meta\">Hub</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=hub-server-install\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Hub server install</span><span class=\"wisp-docs-card-meta\">Hub</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Engine &amp; CLI</span><span class=\"wisp-docs-count\">11</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=whitepaper\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Whitepaper</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=use-cases\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Use cases</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=installation\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Installation</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=user-guide\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">User guide (CLI)</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=how-to\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">How-to cookbook</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=operations\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Operations</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=deployment\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Deployment</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=administration\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Administration</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=gce-local-verify\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">GCE test runner</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=gce-gpu-lab\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">GCE GPU lab</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=windows-compat\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Windows vs Linux</span><span class=\"wisp-docs-card-meta\">Engine &amp; CLI</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Governance</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=strategic-plan\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Strategic plan (locked)</span><span class=\"wisp-docs-card-meta\">Governance</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=paused-and-maintenance\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Paused &amp; maintenance index</span><span class=\"wisp-docs-card-meta\">Governance</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=roadmap\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Roadmap (active)</span><span class=\"wisp-docs-card-meta\">Governance</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>WISP showcase</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=wisp-cwl-fullstack\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WISP CWL fullstack program</span><span class=\"wisp-docs-card-meta\">WISP showcase</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=wisp-cwl-ui-parity\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WISP CWL UI parity</span><span class=\"wisp-docs-card-meta\">WISP showcase</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=wisp-production\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WISP production completion</span><span class=\"wisp-docs-card-meta\">WISP showcase</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Hub &amp; commercial</span><span class=\"wisp-docs-count\">4</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=commercial\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Commercial offering</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=agenticop\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">AgenticOp practice</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=github-project\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">GitHub Project</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=multi-repo-workspace\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Multi-repo workspace</span><span class=\"wisp-docs-card-meta\">Hub &amp; commercial</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Architecture</span><span class=\"wisp-docs-count\">4</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=design\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">DESIGN.md</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=agents\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">AGENTS.md</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=roadmap-archive\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Roadmap archive</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=docs-index\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Documentation index</span><span class=\"wisp-docs-card-meta\">Architecture</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Archive</span><span class=\"wisp-docs-count\">4</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=archive-index\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Archive index</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=strategic-plan-shipped-log\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Strategic plan ship log</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=cwl-fullstack-build-log\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">CWL full-stack build log</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=master-program\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">WPTP master program</span><span class=\"wisp-docs-card-meta\">Archive</span></a>\n</div></details>\n<details class=\"wisp-docs-category\" open>\n<summary><span>Community</span><span class=\"wisp-docs-count\">3</span></summary>\n<div class=\"wisp-docs-grid\">\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=code-of-conduct\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Code of conduct</span><span class=\"wisp-docs-card-meta\">Community</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=contributing\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Contributing</span><span class=\"wisp-docs-card-meta\">Community</span></a>\n<a class=\"wisp-docs-card\" href=\"https://hub.agenticop.io/#/guide?doc=security\" target=\"_blank\" rel=\"noopener\"><span class=\"wisp-docs-card-title\">Security</span><span class=\"wisp-docs-card-meta\">Community</span></a>\n</div></details>\n</div>\n  </section>\n</div>\n  </main>\n</div>";
}

@page GET "/docs/deployment"
page docs_deployment_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m32", path: "/docs/deployment" };
  return html "<div class=\"wisp-docs-shell wisp-demo-content\" data-wisp-page=\"docs_deployment\" data-wisp-path=\"/docs/deployment\" data-cwl-island=\"client\" data-wisp-layout=\"docs\">\n  <header class=\"wisp-docs-topbar\">\n    <nav class=\"wisp-docs-crumb\" aria-label=\"Documentation\">\n      <a href=\"/dashboard\">Dashboard</a>\n      <span aria-hidden=\"true\">/</span>\n      <a href=\"/help\">Help</a>\n      <span aria-hidden=\"true\">/</span>\n      <span>Deployment</span>\n    </nav>\n  </header>\n  <main class=\"wisp-docs-main\">\n    <div class=\"wisp-docs-body wisp-docs-body-article\">\n  <section class=\"wisp-docs-hero wisp-docs-hero-compact\">\n    <p class=\"wisp-docs-eyebrow\"><a href=\"/docs\">Documentation</a></p>\n    <h2>Deployment</h2>\n    <p class=\"wisp-docs-lead\">CI patterns, GCE hub deploy (<code>deploy:hub-demo</code>), WISP chimera (<code>wisp:deploy:gce</code>), and production dual-stack routing.</p>\n  </section>\n  <section class=\"wisp-docs-section\">\n    <a class=\"wisp-docs-hub-cta\" href=\"https://hub.agenticop.io/#/guide?doc=deployment\" target=\"_blank\" rel=\"noopener\">Read full guide on Translation Hub</a>\n    <p class=\"wisp-docs-inline-links\"><a href=\"/docs\">← Documentation home</a> · <a href=\"/help\">Help</a></p>\n  </section>\n</div>\n  </main>\n</div>";
}

