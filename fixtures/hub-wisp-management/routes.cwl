  return html "<div class=\"hss-management\">\n  <!-- Header -->\n  <div class=\"header\">\n    <div class=\"header-content\">\n      <div class=\"header-main\">\n        <div class=\"header-row\">\n          <button class=\"back-button\">\n            ← Back to Dashboard\n          </button>\n          <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n          />\n        </div>\n        <div>\n          <h1>🔐 HSS & Subscriber Management</h1>\n          <p class=\"subtitle\">Home Subscriber Server - Authentication & User Management</p>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Help Button - Fixed Position -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n  \n  \n    <!-- Navigation Tabs -->\n    <div class=\"tabs\">\n      <button\n      >\n        📊 Dashboard\n      </button>\n      <button\n      >\n        📦 Groups\n      </button>\n      <button\n      >\n        🚀 Bandwidth Plans\n      </button>\n      <button\n      >\n        🌐 MME Connections\n      </button>\n      <button\n      >\n        📥 Bulk Import\n      </button>\n      <button\n      >\n        🌐 Remote EPCs\n      </button>\n    </div>\n    \n    <!-- Tab Content -->\n    <div class=\"tab-content\">\n      \n    </div>\n  \n  \n  <!-- Help Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n  <!-- Subscriber Creation Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"SubscriberCreationWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"BandwidthPlanWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"SubscriberGroupWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n</div>";
}

@page GET "/modules/inventory"
page modules_inventory_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"inventory-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n        <button class=\"back-button\">\n        ← Back to Dashboard\n      </button>\n      <h1>📦 Inventory Management</h1>\n      <p class=\"subtitle\">Centralized asset tracking and management</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\"}>\n        🔍 Scan Lookup\n      </button>\n      <button class=\"btn-secondary\"}>\n        📥 Scan Check In\n      </button>\n      <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> }\n      />\n      <button class=\"btn-secondary\"}>\n        📤 Scan Check Out\n      </button>\n      <button class=\"btn-secondary\">\n        🔍 Manual Lookup\n      </button>\n      <button class=\"btn-secondary\">\n        📦 Bundles\n      </button>\n      <button class=\"btn-secondary\">\n        📊 View Reports\n      </button>\n      <button class=\"btn-secondary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn-primary\">\n        ➕ Add Item\n      </button>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Stats Bar -->\n  <div class=\"stats-bar\">\n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">📦</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Items</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">✅</div>\n      <div>\n        <div class=\"stat-value\">\n          12\n        </div>\n        <div class=\"stat-label\">Available</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">🚀</div>\n      <div>\n        <div class=\"stat-value\">\n          \n        </div>\n        <div class=\"stat-label\">Deployed</div>\n      </div>\n    </div>\n    \n    <div class=\"stat-card\">\n      <div class=\"stat-icon\">💰</div>\n      <div>\n        <div class=\"stat-value\"></div>\n        <div class=\"stat-label\">Total Value</div>\n      </div>\n    </div>\n  </div>\n  \n  <!-- Filters -->\n  <div class=\"filters-section\">\n    <div class=\"filters-row\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"🔍 Search by serial number, model, manufacturer...\"\n        />\n      </div>\n      \n      <select>\n        <option>All Categories</option>\n        <option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Statuses</option>\n        <option></option><option></option><option></option><option></option><option></option>\n      </select>\n      \n      <select>\n        <option>All Locations</option>\n        \n      </select>\n      \n      <button class=\"btn-primary\">Apply</button>\n      <button class=\"btn-secondary\">Clear</button>\n    </div>\n  </div>\n  \n  <!-- Loading State -->\n  \n    <!-- Inventory Table -->\n    <div class=\"table-container\">\n      <table class=\"inventory-table\">\n        <thead>\n          <tr>\n            <th>Asset Tag</th>\n            <th>Category</th>\n            <th>Type</th>\n            <th>Manufacturer</th>\n            <th>Model</th>\n            <th>Serial Number</th>\n            <th>Status</th>\n            <th>Condition</th>\n            <th>Location</th>\n            <th>Last Updated</th>\n            <th>Actions</th>\n          </tr>\n        </thead>\n        <tbody>\n          \n        </tbody>\n      </table>\n    </div>\n    \n    <!-- Pagination -->\n    <div class=\"pagination\">\n        <button \n          class=\"btn-secondary\"\n        >\n          ← Previous\n        </button>\n        \n        <span class=\"pagination-info\">\n          Page 1 of 2 \n          (24 items)\n        </span>\n        \n        <button \n          class=\"btn-secondary\"\n        >\n          Next →\n        </button>\n      </div>\n  \n  \n  <!-- Manual Barcode Entry Modal -->\n  \n\n  <!-- Asset Tag Viewer -->\n  \n  \n  <!-- Scan Modal -->\n  \n  \n  <!-- Check-in Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"InventoryCheckInWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n  <!-- RMA Tracking Wizard -->\n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"RMATrackingWizard\" aria-hidden=\"true\" role=\"dialog\"></div> }\n  />\n</div>\n\n<!-- Help Button - Fixed Position -->\n<button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n    <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n    <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n  </svg>\n</button>\n\n<!-- Help Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>\n\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n/>";
}

@page GET "/modules/inventory/:id"
page modules_inventory_id_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/:id", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"item-detail-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Inventory\n      </button>\n      <h1>📦 Equipment Details</h1>\n      \n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        📱 View QR Code\n      </button>\n      <button class=\"btn btn-secondary\">\n        🖨️ Print Tag\n      </button>\n      <button class=\"btn btn-primary\">\n        ✏️ Edit\n      </button>\n      <button class=\"btn btn-primary\">\n        📦 Transfer\n      </button>\n    </div>\n  </div>\n\n  \n    <div class=\"content-grid\">\n      <!-- Basic Information -->\n      <div class=\"info-card\">\n        <h3>📋 Basic Information</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Asset Tag</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Serial Number</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Category</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Equipment Type</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Manufacturer</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Model</label>\n            <span class=\"value\">N/A</span>\n          </div>\n          <div class=\"info-item\">\n            <label>Status</label>\n            <span class=\"status-badge\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Condition</label>\n            <span class=\"condition-badge\"></span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Current Location -->\n      <div class=\"info-card\">\n        <h3>📍 Current Location</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Location Type</label>\n            <span class=\"value\"></span>\n          </div>\n          \n          \n          \n        </div>\n      </div>\n\n      <!-- Purchase Information -->\n      \n\n      <!-- Warranty Information -->\n      \n\n      <!-- Technical Specifications -->\n      \n\n      <!-- Module Integration -->\n      \n\n      <!-- Notes -->\n      \n\n      <!-- Metadata -->\n      <div class=\"info-card full-width\">\n        <h3>📊 Metadata</h3>\n        <div class=\"info-grid\">\n          <div class=\"info-item\">\n            <label>Created</label>\n            <span class=\"value\"></span>\n          </div>\n          <div class=\"info-item\">\n            <label>Last Updated</label>\n            <span class=\"value\"></span>\n          </div>\n        </div>\n      </div>\n    </div>\n  \n</div>\n\n<!-- QR Code Modal -->\n";
}

@page GET "/modules/inventory/:id/edit"
page modules_inventory_id_edit_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/:id/edit", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"edit-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Details\n      </button>\n      <h1>✏️ Edit Equipment</h1>\n      \n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        Cancel\n      </button>\n      <button class=\"btn btn-primary\">\n        Save Changes\n      </button>\n    </div>\n  </div>\n\n  \n    <form on:submit|preventDefault= class=\"edit-form\">\n      <div class=\"form-sections\">\n        <!-- Basic Information -->\n        <div class=\"form-section\">\n          <h3>📋 Basic Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"assetTag\">Asset Tag</label>\n              <input \n                id=\"assetTag\"\n                type=\"text\" \n                placeholder=\"Enter asset tag\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"serialNumber\">Serial Number *</label>\n              <input \n                id=\"serialNumber\"\n                type=\"text\" \n                placeholder=\"Enter serial number\"\n                required\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"category\">Category *</label>\n              <select id=\"category\" required>\n                <option>Select category...</option>\n                <option value=\"radio\">Radio Equipment</option>\n                <option value=\"antenna\">Antenna</option>\n                <option value=\"cpe\">CPE Device</option>\n                <option value=\"backhaul\">Backhaul Equipment</option>\n                <option value=\"power\">Power Equipment</option>\n                <option value=\"network\">Network Equipment</option>\n                <option value=\"test\">Test Equipment</option>\n                <option value=\"other\">Other</option>\n              </select>\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"equipmentType\">Equipment Type *</label>\n              <input \n                id=\"equipmentType\"\n                type=\"text\" \n                placeholder=\"e.g., Sector Antenna, CPE Router\"\n                required\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"manufacturer\">Manufacturer</label>\n              <input \n                id=\"manufacturer\"\n                type=\"text\" \n                placeholder=\"Enter manufacturer\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"model\">Model</label>\n              <input \n                id=\"model\"\n                type=\"text\" \n                placeholder=\"Enter model\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"status\">Status *</label>\n              <select id=\"status\" required>\n                <option value=\"available\">Available</option>\n                <option value=\"deployed\">Deployed</option>\n                <option value=\"reserved\">Reserved</option>\n                <option value=\"in-transit\">In Transit</option>\n                <option value=\"maintenance\">Maintenance</option>\n                <option value=\"rma\">RMA</option>\n                <option value=\"retired\">Retired</option>\n                <option value=\"lost\">Lost</option>\n                <option value=\"sold\">Sold</option>\n              </select>\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"condition\">Condition *</label>\n              <select id=\"condition\" required>\n                <option value=\"new\">New</option>\n                <option value=\"excellent\">Excellent</option>\n                <option value=\"good\">Good</option>\n                <option value=\"fair\">Fair</option>\n                <option value=\"poor\">Poor</option>\n                <option value=\"damaged\">Damaged</option>\n                <option value=\"refurbished\">Refurbished</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <!-- Current Location (optional; assign during deploy if unassigned) -->\n        <div class=\"form-section\">\n          <h3>📍 Current Location</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"locationType\">Location Type</label>\n              <select id=\"locationType\">\n                <option value=\"unassigned\">Unassigned (assign during deploy)</option>\n                <option value=\"warehouse\">Warehouse</option>\n                <option value=\"tower\">Tower Site</option>\n                <option value=\"noc\">NOC</option>\n                <option value=\"vehicle\">Vehicle</option>\n                <option value=\"customer\">Customer Site</option>\n                <option value=\"rma\">RMA</option>\n                <option value=\"vendor\">Vendor</option>\n                <option value=\"other\">Other</option>\n              </select>\n            </div>\n            \n            \n          </div>\n        </div>\n\n        <!-- Purchase Information -->\n        <div class=\"form-section\">\n          <h3>💰 Purchase Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"vendor\">Vendor</label>\n              <input \n                id=\"vendor\"\n                type=\"text\" \n                placeholder=\"Enter vendor name\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchaseDate\">Purchase Date</label>\n              <input \n                id=\"purchaseDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchasePrice\">Purchase Price</label>\n              <input \n                id=\"purchasePrice\"\n                type=\"number\" \n                step=\"0.01\" \n                placeholder=\"0.00\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"purchaseOrderNumber\">PO Number</label>\n              <input \n                id=\"purchaseOrderNumber\"\n                type=\"text\" \n                placeholder=\"Enter PO number\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Warranty Information -->\n        <div class=\"form-section\">\n          <h3>🛡️ Warranty Information</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"warrantyProvider\">Provider</label>\n              <input \n                id=\"warrantyProvider\"\n                type=\"text\" \n                placeholder=\"Enter warranty provider\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyStartDate\">Start Date</label>\n              <input \n                id=\"warrantyStartDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyEndDate\">End Date</label>\n              <input \n                id=\"warrantyEndDate\"\n                type=\"date\" \n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"warrantyType\">Type</label>\n              <input \n                id=\"warrantyType\"\n                type=\"text\" \n                placeholder=\"e.g., Manufacturer, Extended\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Technical Specifications -->\n        <div class=\"form-section\">\n          <h3>⚙️ Technical Specifications</h3>\n          <div class=\"form-grid\">\n            <div class=\"form-group\">\n              <label for=\"powerRequirements\">Power Requirements</label>\n              <input \n                id=\"powerRequirements\"\n                type=\"text\" \n                placeholder=\"e.g., 24V DC, 2A\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"ipAddress\">IP Address</label>\n              <input \n                id=\"ipAddress\"\n                type=\"text\" \n                placeholder=\"192.168.1.100\"\n              />\n            </div>\n            \n            <div class=\"form-group\">\n              <label for=\"managementUrl\">Management URL</label>\n              <input \n                id=\"managementUrl\"\n                type=\"url\" \n                placeholder=\"http://192.168.1.100\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Notes -->\n        <div class=\"form-section\">\n          <h3>📝 Notes</h3>\n          <div class=\"form-group\">\n            <label for=\"notes\">Additional Notes</label>\n            <textarea \n              id=\"notes\" \n              placeholder=\"Enter any additional notes or comments...\"\n              rows=\"4\"\n            ></textarea>\n          </div>\n        </div>\n      </div>\n    </form>\n  \n</div>";
}

@page GET "/modules/inventory/add"
page modules_inventory_add_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/add", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"add-inventory-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Inventory\n      </button>\n      <h1>➕ Add Inventory Item</h1>\n    </div>\n  </div>\n  \n  \n  \n  <div class=\"form-container\">\n    <form on:submit|preventDefault=>\n      \n      <!-- Classification -->\n      <div class=\"section\">\n        <h3>🏷️ Equipment Classification</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Category *</label>\n            <select required>\n              <option></option><option></option><option></option><option></option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Equipment Type *</label>\n            <select required>\n              <option>-- Select Type --</option>\n              <option></option><option></option><option></option><option></option>\n              <option value=\"Other/Custom\">Other/Custom</option>\n            </select>\n          </div>\n        </div>\n        \n        \n      </div>\n      \n      <!-- Manufacturer Info -->\n      <div class=\"section\">\n        <h3>🏭 Manufacturer Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Manufacturer</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Model</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Part Number</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Serial Number *</label>\n            <input type=\"text\" required />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Firmware Version</label>\n          <input type=\"text\" />\n        </div>\n      </div>\n      \n      <!-- Location (optional; assign during deploy if left unassigned) -->\n      <div class=\"section\">\n        <h3>📍 Location</h3>\n        <p class=\"help-text\" style=\"margin-bottom: 1rem;\">Optional. Leave unassigned to assign a location during the deploy step.</p>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Location Type</label>\n            <select>\n              <option value=\"unassigned\">Unassigned (assign during deploy)</option>\n              <option value=\"warehouse\">Warehouse</option>\n              <option value=\"tower\">Tower Site</option>\n              <option value=\"noc\">NOC</option>\n              <option value=\"vehicle\">Service Vehicle</option>\n              <option value=\"rma\">RMA/Repair Center</option>\n              <option value=\"customer\">Customer Premises</option>\n              <option value=\"other\">Other</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n              <label>Select Location</label>\n              <select>\n                <option>-- Select from map --</option>\n                \n              </select>\n              \n            </div>\n        </div>\n        \n        <!-- Specific location details based on type -->\n        \n        \n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Status *</label>\n            <select required>\n              <option value=\"available\">Available</option>\n              <option value=\"deployed\">Deployed</option>\n              <option value=\"reserved\">Reserved</option>\n              <option value=\"maintenance\">Maintenance</option>\n              <option value=\"rma\">RMA</option>\n              <option value=\"retired\">Retired</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Condition *</label>\n            <select required>\n              <option value=\"new\">New</option>\n              <option value=\"excellent\">Excellent</option>\n              <option value=\"good\">Good</option>\n              <option value=\"fair\">Fair</option>\n              <option value=\"poor\">Poor</option>\n              <option value=\"refurbished\">Refurbished</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <!-- Purchase Info -->\n      <div class=\"section\">\n        <h3>💰 Purchase Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Vendor</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Purchase Date</label>\n            <input type=\"date\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Purchase Price ($)</label>\n            <input type=\"number\" step=\"0.01\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>PO Number</label>\n            <input type=\"text\" />\n          </div>\n        </div>\n        \n        <div class=\"form-group\">\n          <label>Book Value ($)</label>\n          <input type=\"number\" step=\"0.01\" />\n        </div>\n      </div>\n      \n      <!-- Warranty -->\n      <div class=\"section\">\n        <h3>🛡️ Warranty Information</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Warranty Provider</label>\n            <input type=\"text\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>Start Date</label>\n            <input type=\"date\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>End Date</label>\n            <input type=\"date\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Technical Details -->\n      <div class=\"section\">\n        <h3>⚙️ Technical Specifications</h3>\n        <div class=\"form-grid\">\n          <div class=\"form-group\">\n            <label>Power Requirements</label>\n            <input type=\"text\" placeholder=\"48V DC, 100-240V AC\" />\n          </div>\n          \n          <div class=\"form-group\">\n            <label>IP Address</label>\n            <input type=\"text\" placeholder=\"192.168.1.100\" />\n          </div>\n        </div>\n      </div>\n      \n      <!-- Notes -->\n      <div class=\"section\">\n        <h3>📝 Additional Notes</h3>\n        <div class=\"form-group\">\n          <textarea rows=\"4\" placeholder=\"Configuration notes, special instructions...\"></textarea>\n        </div>\n      </div>\n      \n      <!-- Actions -->\n      <div class=\"form-actions\">\n        <button type=\"button\" class=\"btn-secondary\">\n          Cancel\n        </button>\n        <button type=\"submit\" class=\"btn-primary\">\n          ✅ Add to Inventory\n        </button>\n      </div>\n    </form>\n  </div>\n</div>";
}

@page GET "/modules/inventory/bundles"
page modules_inventory_bundles_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/bundles", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"bundles-page\">\n  <!-- Header -->\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-button\">\n        ← Back to Inventory\n      </button>\n      <h1>📦 Hardware Bundles</h1>\n      <p class=\"subtitle\">Create and manage hardware bundles for easy planning and deployment</p>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-primary\">\n        ➕ Create Bundle\n      </button>\n    </div>\n  </div>\n  \n  <!-- Alerts -->\n  \n  \n  \n  \n  <!-- Filters -->\n  <div class=\"filters\">\n    <div class=\"search-box\">\n      <span class=\"search-icon\">🔍</span>\n      <input\n        type=\"text\"\n        placeholder=\"Search bundles...\"\n      />\n    </div>\n    \n    <select>\n      \n    </select>\n    \n    <select>\n      <option></option><option></option><option></option><option></option><option></option>\n    </select>\n    \n    <div class=\"results-count\">\n       of 24 bundles\n    </div>\n  </div>\n  \n  <!-- Bundles List -->\n  \n    <div class=\"bundles-grid\">\n      \n    </div>\n    \n    <!-- Pagination -->\n    <div class=\"pagination\">\n        <button \n          class=\"btn-page\"\n        >\n          ← Previous\n        </button>\n        <span class=\"pagination-info\">\n          Page 1 of 2\n        </span>\n        <button \n          class=\"btn-page\"\n        >\n          Next →\n        </button>\n      </div>\n  \n</div>\n\n<!-- Modals -->\n\n";
}

@page GET "/modules/inventory/reports"
page modules_inventory_reports_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/inventory/reports", apiPath: "/api/inventory", api_ok: true, api_surface: "wisp-api-native", api_resource: "inventory", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"reports-page\">\n  <div class=\"page-header\">\n    <div class=\"header-left\">\n      <button class=\"back-btn\">\n        ← Back to Inventory\n      </button>\n      <h1>📊 Inventory Reports & Analytics</h1>\n      <p class=\"subtitle\">Demo Tenant</p>\n    </div>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-secondary\">\n        🔄 Refresh\n      </button>\n      <button class=\"btn btn-primary\">\n        📥 Export CSV\n      </button>\n      <button class=\"btn btn-primary\">\n        🖨️ Print PDF\n      </button>\n    </div>\n  </div>\n\n  \n    <!-- Summary Cards -->\n    <div class=\"summary-grid\">\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">📦</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">10</div>\n          <div class=\"card-label\">Total Items</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">💰</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\">$</div>\n          <div class=\"card-label\">Total Value</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">📍</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Locations</div>\n        </div>\n      </div>\n\n      <div class=\"summary-card\">\n        <div class=\"card-icon\">🏭</div>\n        <div class=\"card-content\">\n          <div class=\"card-value\"></div>\n          <div class=\"card-label\">Manufacturers</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Alerts -->\n    \n\n    <!-- Charts -->\n    <div class=\"charts-grid\">\n      <!-- Status Distribution -->\n      <div class=\"chart-card\">\n        <h3>Status Distribution</h3>\n        \n      </div>\n\n      <!-- Category Distribution -->\n      <div class=\"chart-card\">\n        <h3>Category Distribution</h3>\n        \n      </div>\n\n      <!-- Location Distribution -->\n      <div class=\"chart-card full-width\">\n        <h3>Location Distribution</h3>\n        \n      </div>\n    </div>\n\n    <!-- Detailed Tables -->\n    <div class=\"table-section\">\n      <h3>By Status</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Status</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td><strong></strong></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"table-section\">\n      <h3>By Category</h3>\n      <table>\n        <thead>\n          <tr>\n            <th>Category</th>\n            <th>Count</th>\n            <th>Percentage</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr><tr>\n              <td></td>\n              <td></td>\n              <td>%</td>\n            </tr>\n        </tbody>\n      </table>\n    </div>\n  \n</div>";
}

@page GET "/modules/maintain"
page modules_maintain_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/maintain", apiPath: "/api/maintain", api_ok: true, api_surface: "wisp-api-native", api_resource: "maintain", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"maintain-module\">\n    <!-- Header -->\n    <div class=\"module-header\">\n      <div class=\"header-top\">\n        <button class=\"back-btn\">\n          <span>←</span> Back\n        </button>\n        <h1>Maintain Module</h1>\n        <div class=\"header-actions\">\n          <button \n            class=\"btn btn-secondary btn-reports\"\n            title=\"View Ticket Reports and Analytics\"\n          >\n            Reports\n          </button>\n          \n        </div>\n      </div>\n      \n      <!-- Tabs -->\n      <div class=\"tabs\">\n        <button \n          class=\"tab\">\n          Help Desk\n        </button>\n        <button \n          class=\"tab\">\n          Tickets\n        </button>\n        <button \n          class=\"tab\">\n          Maintenance\n        </button>\n        <button \n          class=\"tab\">\n          Customers\n        </button>\n        <button \n          class=\"tab\">\n          Incidents\n        </button>\n      </div>\n    </div>\n    \n    <!-- Content -->\n    <div class=\"module-content\">\n      \n    </div>\n  </div>\n  \n  <!-- Modals -->\n  \n  \n  \n  \n  \n  \n  \n\n  <!-- Tips Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />";
