@page GET "/modules/monitoring"
page modules_monitoring_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/monitoring", apiPath: "/api/monitoring/graphs", api_ok: true, api_surface: "wisp-api-native", api_resource: "monitoring-graphs", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- Monitoring Setup Wizard -->\n  \n\n  <div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      \n        \n      \n    </div>\n\n    <!-- Floating Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-success);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\" title=\"Back to Modules\">\n          ←\n        </button>\n        <h1>🗺️ Monitor</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> true}\n        />\n        <button class=\"module-control-btn\" title=\"Configuration\">\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Config</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"Geographic View\"\n        >\n          <span class=\"control-icon\">🗺️</span>\n          <span class=\"control-label\">Geographic</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"Topology View\"\n        >\n          <span class=\"control-icon\">🕸️</span>\n          <span class=\"control-label\">Topology</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"EPC Devices\"\n        >\n          <span class=\"control-icon\">📡</span>\n          <span class=\"control-label\">EPC (1)</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"SNMP Graphs\"\n        >\n          <span class=\"control-icon\">📈</span>\n          <span class=\"control-label\">Graphs</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"Mikrotik Devices\"\n        >\n          <span class=\"control-icon\">🖥️</span>\n          <span class=\"control-label\">Mikrotik</span>\n        </button>\n        <button \n          class=\"module-control-btn\"\n          title=\"ACS CPE Management\"\n        >\n          <span class=\"control-icon\">📡</span>\n          <span class=\"control-label\">ACS CPE</span>\n        </button>\n      </div>\n    </div>\n  </div>\n  \n  <!-- SNMP Graphs View -->\n  \n  \n  <!-- Mikrotik Devices View -->\n  \n  \n  <!-- ACS CPE Management View -->\n  \n  \n  <!-- EPC Devices View -->\n  \n\n<!-- Mikrotik Credentials Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"MikrotikCredentialsModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showMikrotikCredentialsModal = false; null;\"></span>}\n/>\n\n  <!-- Help Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n  <!-- Tips Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<!-- SNMP Configuration Modal -->\n<div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"SNMPConfigurationPanel\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>rssi</td><td>ok</td></tr></tbody></table></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showSNMPConfig = false;\n    loadNetworkDevices();\n    loadSNMPData();\"></span>}\n/>\n\n<!-- EPC Deployment Modal -->\n<div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"EPCDeploymentModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showEPCDeploymentModal = false; null;\"></span>}\n/>\n\n<!-- Alert Details Modal -->\n\n\n<!-- Create Ticket from Alert Modal -->\n\n\n<!-- Monitoring Site Details Modal (right-click on sites) -->\n<!-- Monitoring Site Details Modal (right-click on sites) -->\n";
}

@page GET "/modules/pci-resolution"
page modules_pci_resolution_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/pci-resolution", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<!-- Full Screen Map -->\n<!-- Note: Auth check removed - Module_Manager dashboard handles authentication -->\n<div class=\"app\">\n  <!-- Map Background -->\n  <div class=\"map-fullscreen\">\n    \n  </div>\n\n  <!-- New UI Layout: Separate Positioned Elements -->\n  \n  <!-- Top Left: Brand -->\n  <div class=\"top-brand\">\n  <div class=\"brand-content\">\n    <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"brand-icon\">\n      <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n      <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n    </svg>\n    <h1 class=\"app-title\">LTE PCI Mapper</h1>\n  </div>\n</div>\n  \n  <!-- Top Right: Basemap Switcher -->\n  <div class=\"cwl-map-shell\" data-cwl-map-shell=\"BasemapSwitcher\" aria-hidden=\"true\" role=\"img\"></div>\n  \n  <!-- Right Side: PCI Status Widget -->\n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"PCIStatusWidget\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>s1</td><td>online</td></tr></tbody></table></div>\n  \n  <!-- Left Sidebar: Vertical Menu -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"VerticalMenu\" aria-hidden=\"true\"></nav> true}\n  />\n  \n  <!-- Bottom Right: Settings Gear Menu -->\n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"SettingsMenu\" aria-hidden=\"true\"></nav>\n  \n  <!-- Help Button -->\n  <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n      <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n    </svg>\n  </button>\n\n  <!-- Modular Components - Isolated and reusable -->\n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"NetworkManager\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>s1</td><td>online</td></tr></tbody></table></div> false}\n  />\n  \n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"ImportWizard\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"AnalysisModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showAnalysisModal')}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"ConflictsModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showConflictsModal')}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"RecommendationsModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showRecommendationsModal')}\n  />\n  \n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"OptimizationResultModal\" aria-hidden=\"true\" role=\"dialog\"></div> uiActions.closeModal('showOptimizationResultModal')}\n  />\n  \n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"CellEditor\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>s1</td><td>online</td></tr></tbody></table></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showCellEditor = false; null; f\"></span>}\n  />\n  \n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"SiteEditor\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>s1</td><td>online</td></tr></tbody></table></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showSiteEditor = false; null; f\"></span>}\n  />\n  \n  <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ContextMenu\" aria-hidden=\"true\"></nav> false}\n  />\n  \n  <div class=\"cwl-widget-shell\" data-cwl-widget-shell=\"TowerManager\" data-cwl-hydrated=\"1\"><table class=\"cwl-widget-summary\"><tbody><tr><td>tw-1</td><td>online</td></tr></tbody></table></div> false}\n  />\n  \n  <!-- Export Modal -->\n  \n  \n  <!-- Help Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n  <div class=\"cwl-wizard-shell\" data-cwl-wizard-shell=\"ConflictResolutionWizard\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n  \n        </div>";
}

@page GET "/modules/plan"
page modules_plan_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { moduleKey: "plan", source: "wisp-m30", apiPath: "/api/plans", api_ok: true, api_surface: "wisp-api-native", api_resource: "plans", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"app\">\n    <!-- Full Screen Map -->\n    <div class=\"map-fullscreen\">\n      <div class=\"cwl-map-shell\" data-cwl-map-shell=\"SharedMap\" aria-hidden=\"true\" role=\"img\"></div>\n    </div>\n\n    <!-- Enhanced Header Overlay -->\n    <div class=\"module-header-overlay\" style=\"background: var(--gradient-primary);\">\n      <div class=\"module-header-left\">\n        <button class=\"module-back-btn\" title=\"Back to Dashboard\">\n          ←\n        </button>\n        <h1>📋 Plan</h1>\n      </div>\n      <div class=\"module-header-controls\">\n        <button class=\"help-button\" aria-label=\"Open Help\" title=\"Help\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n            <path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path>\n            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>\n          </svg>\n        </button>\n          <button class=\"module-control-btn\" title=\"View All Hardware\">\n          <span class=\"control-icon\">🔧</span>\n          <span class=\"control-label\">Hardware</span>\n        </button>\n        <button class=\"module-control-btn\" title=\"Project List\">\n          <span class=\"control-icon\">📁</span>\n          <span class=\"control-label\">Projects</span>\n        </button>\n        <nav class=\"cwl-nav-shell\" data-cwl-nav-shell=\"ModuleWizardMenu\" aria-hidden=\"true\"></nav> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"if (e.detail?.id === 'marketing-discovery') {\n              openMarketingWizard(\"></span>}\n        />\n        <button\n          class=\"module-control-btn marketing-btn\"\n            type=\"button\"\n        >\n          <span class=\"control-icon\">🔍</span>\n          <span class=\"control-label\">Find Addresses</span>\n        </button>\n        <button \n          class=\"module-control-btn filter-btn\"\n          type=\"button\"}\n          title=\"Toggle Layer Filters\"\n        >\n          <span class=\"control-icon\">🎛️</span>\n          <span class=\"control-label\">Layers</span>\n        </button>\n      </div>\n    </div>\n\n    \n  </div>\n\n  <!-- Filter Panel (non-modal) -->\n  \n  \n  <!-- Click outside to close filter panel -->\n  \n\n  <!-- Hardware View Modal -->\n\n\n  <!-- Project List Modal -->\n  \n\n  <!-- Create Project Modal -->\n\n\n  <!-- Missing Hardware Modal -->\n\n\n  <!-- Marketing Modal (deprecated - kept for backward compatibility) -->\n  \n\n  <!-- Marketing Results Popup -->\n  \n\n  <!-- Add Hardware Requirement Modal -->\n\n\n  <!-- Planning Report Modal -->\n\n  \n  <!-- Global Settings Button - Hidden in plan mode, shown in coverage-map iframe instead -->\n\n  <!-- Help Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"HelpModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />\n\n<!-- MapLayerManager: overlay/visibleProjects/projectOverlays wired. Staging CRUD (site/equipment add/edit/delete from plan) planned – see docs/PROJECT_WORKFLOW_STATUS.md -->";
}

@page GET "/modules/sites"
page modules_sites_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/sites", apiPath: "/api/network", api_ok: true, api_surface: "wisp-api-native", api_resource: "network", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"sites-page\">\n    <div class=\"page-header\">\n      <div>\n        <h1>🏢 Site Management</h1>\n        <p class=\"subtitle\">Manage all network sites, towers, buildings, and facilities</p>\n      </div>\n      <div class=\"header-actions\">\n        <button class=\"btn-primary\">\n          ➕ Create New Site\n        </button>\n        <button class=\"btn-secondary\" title=\"Refresh\">\n          🔄 Refresh\n        </button>\n      </div>\n    </div>\n    \n    \n    \n    <!-- Filters and Search -->\n    <div class=\"filters-section\">\n      <div class=\"search-box\">\n        <input\n          type=\"text\"\n          placeholder=\"Search sites by name, address, or city...\"\n          class=\"search-input\"\n        />\n        <span class=\"search-icon\">🔍</span>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Type:</label>\n        <select>\n          <option value=\"all\">All Types</option>\n          <option value=\"tower\">📡 Tower</option>\n          <option value=\"building\">🏢 Building</option>\n          <option value=\"noc\">🖥️ NOC</option>\n          <option value=\"warehouse\">🏭 Warehouse</option>\n          <option value=\"pole\">📡 Pole</option>\n          <option value=\"other\">📍 Other</option>\n        </select>\n      </div>\n      \n      <div class=\"filter-group\">\n        <label>Status:</label>\n        <select>\n          <option value=\"all\">All Statuses</option>\n          <option value=\"active\">✅ Active</option>\n          <option value=\"inactive\">❌ Inactive</option>\n          <option value=\"maintenance\">🔧 Maintenance</option>\n          <option value=\"planned\">📅 Planned</option>\n        </select>\n      </div>\n    </div>\n    \n    <!-- Summary Stats -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-value\">1</div>\n        <div class=\"stat-label\">Total Sites</div>\n      </div>\n      <div class=\"stat-card active\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"sites.filter(s => s.status === 'active').length\"></span></div>\n        <div class=\"stat-label\">Active</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"sites.filter(s => s.type === 'tower').length\"></span></div>\n        <div class=\"stat-label\">Towers</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-value\"><span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"sites.filter(s => s.type === 'building').length\"></span></div>\n        <div class=\"stat-label\">Buildings</div>\n      </div>\n    </div>\n    \n    <!-- Sites Table -->\n    \n      <div class=\"sites-table-container\">\n        <table class=\"sites-table\">\n          <thead>\n            <tr>\n              <th>Site Name</th>\n              <th>Type</th>\n              <th>Status</th>\n              <th>Location</th>\n              <th>Contact</th>\n              <th>Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            <div data-cwl-hole=\"legacy:markup-lift-svelte-each\" data-cwl-hole-detail=\"filteredSites as site\"><tr>\n                <td>\n                  <div class=\"site-name\">\n                    <strong></strong>\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"site.owner\"><small></small></div>\n                  </div>\n                </td>\n                <td>\n                  <span class=\"type-badge\">\n                     \n                  </span>\n                </td>\n                <td>\n                  <span class=\"status-badge status-\">\n                     \n                  </span>\n                </td>\n                <td>\n                  <div class=\"location-info\">\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"site.location?.address\"><div></div></div>\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"site.location?.city || site.location?.state\"><div class=\"location-secondary\">\n                        \n                        <span data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"site.location?.zipCode\"></span>\n                      </div></div>\n                    <div data-cwl-hole=\"legacy:markup-lift-svelte-if\" data-cwl-hole-detail=\"site.location?.latitude && site.location?.longitude\"><div class=\"coordinates\">\n                        , \n                      </div></div>\n                  </div>\n                </td>\n                <td>\n                  <div class=\"contact-info\">\n                    \n                  </div>\n                </td>\n                <td>\n                  <div class=\"action-buttons\">\n                    <button \n                      class=\"btn-icon\"\n                      title=\"Edit Site\"\n                    >\n                      ✏️\n                    </button>\n                    <div class=\"deploy-menu\">\n                      <button \n                        class=\"btn-icon btn-deploy\" \n                        title=\"Deploy Equipment\"\n                      >\n                        🚀\n                      </button>\n                      <div class=\"deploy-dropdown\">\n                        <button>\n                          🖥️ Deploy EPC\n                        </button>\n                        <button>\n                          📡 Deploy LTE/5G Sector\n                        </button>\n                        <button>\n                          📱 Deploy FWA (CPE)\n                        </button>\n                        <button>\n                          🔗 Deploy Backhaul (Wireless/Fiber)\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </td>\n              </tr></div>\n          </tbody>\n        </table>\n      </div>\n    \n  </div>\n  \n  <!-- Site Edit Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"SiteEditModal\" aria-hidden=\"true\" role=\"dialog\"></div> <span data-cwl-hole=\"legacy:markup-lift-svelte-interp\" data-cwl-hole-detail=\"showEditModal = false; null;\"></span>}\n  />\n  \n  <!-- EPC Deployment Modal -->\n  \n  \n  <!-- Sector Deployment Modal -->\n  \n  \n  <!-- CPE/FWA Deployment Modal -->\n  \n  \n  <!-- Backhaul Deployment Modal -->\n  \n\n  <!-- Tips Modal -->\n  <div class=\"cwl-modal-shell\" data-cwl-modal-shell=\"TipsModal\" aria-hidden=\"true\" role=\"dialog\"></div> false}\n  />";
}

@page GET "/modules/tenant-management"
page modules_tenant_management_page {
  effects: session.read;
  content-type "text/html; charset=utf-8";
  load { source: "wisp-m31", path: "/modules/tenant-management", apiPath: "/api/tenants", api_ok: true, api_surface: "wisp-api-native", api_resource: "tenants", api_op: "list", tracedApiStatus: 200 };
  return html "<div class=\"tenant-management-page\">\n  <div class=\"page-header\">\n    <div>\n      <button class=\"back-btn\">\n        ← Back to Dashboard\n      </button>\n      <h1>🏢 Tenant Management</h1>\n      <p class=\"subtitle\">Manage all organizations and customer accounts</p>\n      <div class=\"admin-badge\">\n        <span>🔐</span>\n        <span>Platform Admin Access</span>\n      </div>\n    </div>\n    \n    <div class=\"header-actions\">\n      <button class=\"btn-secondary\">\n        🔑 CBRS Platform Keys\n      </button>\n      <button class=\"btn-primary\">\n        ➕ Create New Tenant\n      </button>\n    </div>\n  </div>\n\n  \n\n  \n\n  <!-- Create Tenant Form -->\n  \n\n  <!-- Tenants List -->\n  <div class=\"tenants-section\">\n    <h2>All Tenants (2)</h2>\n    \n    \n      <div class=\"tenants-grid\">\n        <div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <div class=\"tenant-icon\">🏢</div>\n              <div class=\"tenant-status\">\n                <span class=\"status-badge status-\">\n                  \n                </span>\n              </div>\n            </div>\n\n            <h3 class=\"tenant-name\"></h3>\n            <p class=\"tenant-id\"></p>\n\n            <div class=\"tenant-info\">\n              <div class=\"info-row\">\n                <span class=\"label\">Contact:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">CWMP URL:</span>\n                <span class=\"value url\"></span>\n              </div>\n            </div>\n\n            <div class=\"tenant-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Users</span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Devices</span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-small\">\n                ⚙️ Manage\n              </button>\n              <button class=\"btn-small\">\n                📊 Settings\n              </button>\n              <button class=\"btn-small btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div><div class=\"tenant-card\">\n            <div class=\"tenant-header\">\n              <div class=\"tenant-icon\">🏢</div>\n              <div class=\"tenant-status\">\n                <span class=\"status-badge status-\">\n                  \n                </span>\n              </div>\n            </div>\n\n            <h3 class=\"tenant-name\"></h3>\n            <p class=\"tenant-id\"></p>\n\n            <div class=\"tenant-info\">\n              <div class=\"info-row\">\n                <span class=\"label\">Contact:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">Created:</span>\n                <span class=\"value\"></span>\n              </div>\n              <div class=\"info-row\">\n                <span class=\"label\">CWMP URL:</span>\n                <span class=\"value url\"></span>\n              </div>\n            </div>\n\n            <div class=\"tenant-stats\">\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Users</span>\n              </div>\n              <div class=\"stat\">\n                <span class=\"stat-value\"></span>\n                <span class=\"stat-label\">Devices</span>\n              </div>\n            </div>\n\n            <div class=\"tenant-actions\">\n              <button class=\"btn-small\">\n                ⚙️ Manage\n              </button>\n              <button class=\"btn-small\">\n                📊 Settings\n              </button>\n              <button class=\"btn-small btn-danger\">\n                🗑️ Delete\n              </button>\n            </div>\n          </div>\n      </div>\n    \n  </div>\n</div>\n\n<!-- Edit Tenant Modal -->\n\n\n<!-- Delete Confirmation Dialog -->\n";
}

