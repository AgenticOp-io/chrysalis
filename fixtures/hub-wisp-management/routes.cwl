  load { source: "origin-convert-all", path: "/docs/reference/project-status" };
  return html "<div class=\"wisp-app-surface\" data-wisp-page=\"docs-reference-project-status\" data-wisp-path=\"/docs/reference/project-status\" data-cwl-island=\"client\"><article class=\"doc-article\">\n  <h1>On track</h1>\n  <p class=\"intro\">This page summarizes where the project stands and what to work on next. For the full lists, see the markdown files in the repository <code>docs/</code> folder.</p>\n  <div class=\"doc-body\">\n    \n  </div>\n</article></div>";
