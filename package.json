{
  "name": "chrysalis-root",
  "version": "0.0.0",
  "private": true,
  "description": "Chrysalis — a web framework you can grow inside a legacy PHP app until it consumes it.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:golden": "pnpm build && node scripts/update-golden-snapshots.mjs",
    "verify:e2e": "node scripts/verify-tiny-blog.mjs",
    "verify:flagship": "node scripts/verify-flagship-laravel-min.mjs",
    "ci-gates": "node scripts/ci-gates.mjs",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
