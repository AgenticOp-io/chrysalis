{
  "name": "chrysalis-root",
  "version": "2.0.2",
  "private": true,
  "description": "Chrysalis — a web framework you can grow inside a legacy PHP app until it consumes it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgenticOp-io/chrysalis.git"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "migration-debt": "node scripts/migration-debt.mjs",
    "migration-debt:gate:ingest": "node scripts/migration-debt.mjs --project fixtures/tiny-blog --max-holes 0 && node scripts/migration-debt.mjs --project fixtures/mysqli-probe --max-holes 5 && node scripts/migration-debt.mjs --project fixtures/db-query-unknown-receiver-probe --max-holes 1 && node scripts/migration-debt.mjs --project fixtures/laravel-shaped-db-factory-probe --max-holes 0",
    "migration-debt:gate:post-verify": "node scripts/migration-debt.mjs --project fixtures/tiny-blog --traces traces --report reports/verify --max-holes 0 --min-correctness 1",
    "vendor:parser-bridge": "node scripts/parser-bridge-composer-install.mjs",
    "pretest": "node scripts/ensure-parser-bridge-vendor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:oracle-php-redactor": "php packages/oracle-php/tests/redactor_sql_rows_test.php && php packages/oracle-php/tests/redactor_sql_params_test.php",
    "test:oracle-php-session-redis": "php packages/oracle-php/tests/redis_session_bridge_smoke.php",
    "ci:emit-check": "node scripts/run-e2e.mjs && npm install --no-audit --no-fund --prefix generated/tiny-blog && npx tsc --noEmit -p generated/tiny-blog/tsconfig.json && node scripts/emit-tiny-blog-fastify.mjs && npm install --no-audit --no-fund --prefix generated/tiny-blog-fastify && npx tsc --noEmit -p generated/tiny-blog-fastify/tsconfig.json",
    "ci:insight": "node packages/cli/dist/bin.js insight fixtures/tiny-n1 --out reports/insight/tiny-n1.json --json && node scripts/ci-gates.mjs tiny-n1-insight",
    "update:golden": "pnpm build && node scripts/update-golden-snapshots.mjs",
    "verify:e2e": "node scripts/verify-tiny-blog.mjs",
    "verify:flagship": "node scripts/verify-flagship-laravel-min.mjs",
    "verify:laravel-full": "node scripts/verify-flagship-laravel-full.mjs",
    "verify:laravel-full:stress": "node scripts/verify-flagship-laravel-full.mjs --stress-runs=3",
    "verify:laravel-full:seed-matrix": "node scripts/verify-flagship-laravel-full.mjs --seed-variants=baseline,empty,ten",
    "verify:laravel-full:5nines": "node scripts/verify-flagship-laravel-full.mjs --seed-variants=baseline,empty,ten --stress-runs=3 && node scripts/ci-gates.mjs confidence-5nines && node scripts/ci-gates.mjs confidence-trend",
    "status:laravel-full": "node scripts/status-flagship-laravel-full.mjs",
    "status:laravel-min": "node scripts/status-flagship-laravel-min.mjs",
    "release-gate:migration-sidecars": "node scripts/ci-gates.mjs migration-sidecar-floors-release",
    "release-gate:session-bridge": "node scripts/ci-gates.mjs session-bridge-release",
    "scaffold:laravel-full": "node scripts/scaffold-flagship-laravel.mjs",
    "scaffold:laravel-full:breeze": "node scripts/scaffold-flagship-laravel.mjs --with-breeze",
    "ci-gates": "node scripts/ci-gates.mjs",
    "ci:verify-dual-summary": "node scripts/ci-gates.mjs verify-dual-summary",
    "ci:verify-merged-summary": "node scripts/ci-gates.mjs verify-merged-summary",
    "ci:corpus-merge-summary": "node scripts/ci-gates.mjs corpus-merge-summary",
    "ci:tiny-n1-insight": "node scripts/ci-gates.mjs tiny-n1-insight",
    "ci:rewrite-pre-xss": "node scripts/ci-gates.mjs rewrite-pre-xss",
    "ci:confidence-5nines": "node scripts/ci-gates.mjs confidence-5nines",
    "ci:confidence-trend": "node scripts/ci-gates.mjs confidence-trend",
    "ci:confidence-trend-ready": "node scripts/ci-gates.mjs confidence-trend-ready",
    "ci:migration-sidecar-floors": "node scripts/ci-gates.mjs migration-sidecar-floors",
    "ci:emit-layout-floors": "node scripts/ci-gates.mjs emit-layout-floors",
    "license:sign": "node scripts/sign-license.mjs",
    "release:artifacts": "node scripts/make-release-artifacts.mjs",
    "fleet:export-status-uplink": "node scripts/export-fleet-status-uplink.mjs",
    "corpus:rotate-archive": "node scripts/corpus-rotate-archive.mjs",
    "ci:chimera-lb-smoke": "vitest run packages/runtime-chimera/tests/proxy-lb-round-robin.test.ts",
    "ci:chimera-operator-snapshot": "vitest run packages/runtime-chimera/tests/chimera-operator-snapshot.test.ts packages/runtime-chimera/tests/chimera-operator-snapshot-batch.test.ts packages/emit-shared/tests/chrysalis-route-paths.test.ts packages/emit-shared/tests/emit-handler-fingerprints.test.ts",
    "ci:verify-summary-batch": "vitest run packages/verify/tests/verify-summary-batch.test.ts",
    "github:project-bootstrap": "node scripts/bootstrap-github-project.mjs",
    "github:project-bootstrap:master": "node scripts/bootstrap-github-project.mjs --preset=master",
    "export:webir-bundle": "node scripts/export-webir-bundle.mjs",
    "export:webir-bundle:tiny-blog": "node scripts/export-webir-bundle.mjs --in packages/ingest/tests/golden/tiny-blog.webir.json --out reports/ci/tiny-blog.webir.bundle.json",
    "wptp:d3-silver-harness": "node --import tsx scripts/wptp-d3-silver-harness.mjs",
    "wptp:d4-nextjs-harness": "node --import tsx scripts/wptp-d4-nextjs-harness.mjs",
    "wptp:silver-nextjs-harness": "node --import tsx scripts/wptp-silver-nextjs-harness.mjs",
    "wptp:d7-audit": "node scripts/wptp-d7-audit.mjs",
    "emit:webir-bundle-hono": "node scripts/emit-webir-bundle-hono.mjs",
    "clean": "pnpm -r clean",
    "sync:agenticop-site": "node scripts/sync-agenticop-site-content.mjs && node scripts/rebuild-agenticop-site-css.mjs",
    "deploy:agenticop-site": "pnpm run sync:agenticop-site && firebase deploy --only hosting",
    "advisor:package": "node scripts/make-advisor-package.mjs",
    "test:cli-shims": "node scripts/test-cli-shims.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vite": "6.4.2",
    "firebase-tools": "^14.11.0",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "7.6.0",
      "tar": "7.5.8"
    }
  }
}
