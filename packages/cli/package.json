    "@chrysalis/emit-hono": "workspace:*",
    "@chrysalis/oracle": "workspace:*",
    "@chrysalis/verify": "workspace:*",
    "@chrysalis/archaeology": "workspace:*",
    "@chrysalis/runtime-chimera": "workspace:*",
    "@chrysalis/insight": "workspace:*",
