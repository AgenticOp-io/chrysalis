# Chrysalis Translation Hub — nginx vhost (locked edge — DESIGN D6396)
#
# Install on chrysalis-test-vm as:
#   /etc/nginx/sites-available/chrysalis-hub
# Enable:
#   sudo ln -sf /etc/nginx/sites-available/chrysalis-hub /etc/nginx/sites-enabled/
#
# DO NOT modify FDE nginx sites on this shared VM:
#   fragility-default-ip, fragility-public
# DO NOT bind or proxy port 8765 (FDE runner).
# DO NOT claim default_server on :80 (FDE owns that).
#
# Upstream: hub process on 127.0.0.1:19090
#   CHRYSALIS_OPERATOR_BIND=127.0.0.1  (after this vhost works)
#
# DNS (A → VM external IP, currently 34.61.255.147):
#   hub.agenticop.io
#   chrysalis.agenticop.io
#
# ACME webroot: /var/www/chrysalis/acme
# Certbot (once DNS propagates):
#   sudo mkdir -p /var/www/chrysalis/acme
#   sudo certbot certonly --webroot -w /var/www/chrysalis/acme \
#     -d hub.agenticop.io -d chrysalis.agenticop.io \
#     --non-interactive --agree-tos -m admin@agenticop.io
#
# Then enable the TLS server block below (uncomment / swap listen 80 → redirect).
# Operator path: docs/HUB-DEMO-INSTALL.md § Public HTTPS · scripts/gce-hub-nginx-tls.sh

# --- HTTP: ACME + temporary proxy (before certs) / redirect (after certs) ---
server {
    listen 80;
    listen [::]:80;
    server_name hub.agenticop.io chrysalis.agenticop.io;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/chrysalis/acme;
        default_type "text/plain";
    }

    # After TLS is live, replace the proxy location with:
    #   return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:19090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 512m;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;
    }
}

# --- HTTPS (enable after certbot certonly succeeds) ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hub.agenticop.io chrysalis.agenticop.io;

    ssl_certificate     /etc/letsencrypt/live/hub.agenticop.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hub.agenticop.io/privkey.pem;
    # Optional (created by some certbot installs):
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:19090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 512m;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;
    }
}
